-- Falas do Pokemon Crystal em portugues brasileiro.
--
-- Chave = rotulo nomeado da desmontagem (MomGivesPokegearText) ou, quando o
-- extrator nao resolve rotulo, TEXT_S<banco>_<endereco> -- o formato que o
-- Gen2Recomped usa em data/generated/text.lua.
--
-- Este catalogo e SO do Crystal.  A versao do Gold vive noutro repositorio
-- (LordSangreal/versaodourada) porque centenas de rotulos existem nos dois
-- jogos com texto diferente -- um catalogo unico mostrava a fala do Gold
-- dentro do Crystal.
return {
  ["AcademyBlackboardText"] = "La pizarra indica\ncómo cambiar el estado de POKéMON\nen combate.",
  ["AcademyBurnText"] = "Las quemaduras\nconsumen PS, reducen\fel poder del\nataque y permanecen\ftras el combate.\nUsa ANTIQUEMAR\fcomo cura.\n",
  ["AcademyEarlIntroText"] = "¡Soy yo, PRIMO!\f¡Fantásticos\nson los POKéMON!\f¡A ti yo te\nense- ñaré\va ser mejor!\f¿Quieres\nsaber cómo\vganar?",
  ["AcademyEarlNoMoreToTeachText"] = "¡Oh! ¡Muy inteli-\ngente eres! ¡Nada\vmás quieres saber!\f¡Genial en POKéMON\ndebes de ser!",
  ["AcademyEarlTeachHowToRaiseWellText"] = "¡Bien! ¡A ti yo te\nenseñaré! Si un\fPOKéMON sale al\ncombate, aunque\fbrevemente, gana\npuntos EXP. ¡Pon\farriba los POKéMON\ndébiles, y cámbialos\frápido en el combate!\n¡Así se harán\fmás fuertes\nlos POKéMON\vdébiles!",
  ["AcademyEarlTeachHowToWinText"] = "¡Bien! ¡A ti yo\nte enseñaré! ¡En\fcombate, los primeros\nPOKéMON salen\vantes! ¡Quizá\fsea más fácil\nsi cambias el\vorden! ¿Quieres\fque te cuente\nmás cosas?",
  ["AcademyEarlTeachMoreText"] = "¿Quieres saber cómo\neducar bien a\vlos POKéMON?",
  ["AcademyFreezeText"] = "Si tu POKéMON está\ncongelado, no podrá\vhacer nada. Seguirá\fcongelado tras\nel combate. Descongélalo\fcon ANTIHIELO.\n",
  ["AcademyNotebookText"] = "Es el cuaderno de\neste niño… Captura\fPOKéMON usando POKé\nBALL. Tu equipo\fpuede tener hasta\nseis. ¿Sigues\fleyendo?",
  ["AcademyNotebookText1"] = "Antes de lanzar la\nPOKé BALL, debes debilitarlo.\vAtrapar un POKéMON\fquemado o envene-\nnado es mucho\vmás fácil. ¿Sigues\fleyendo?",
  ["AcademyNotebookText2"] = "Algunos ataques\ncausan confusión.\fUn POKéMON confuso\npuede atacarse a\vsí mismo. Retirarlo\fdel combate, eliminará\nsu confusión.\v¿Sigues leyendo?\f",
  ["AcademyNotebookText3"] = "Quienes atrapan\nPOKéMON y úsalos para luchar hijo\nentrenadores. Tu misión es ir a\nGIMNASIOS y vencer a otros\nentrenadores.\fdia siguiente\nEs… ¡espera!\fNiño: Eh, eh… No está escrito.\nnada malo…",
  ["AcademyParalysisText"] = "La parálisis baja\nla VELOCIDAD y puede\vimpedir el movimiento.\vPermanece tras\fel combate, así\nque usa ANTIPARALIZ.\v",
  ["AcademyPoisonText"] = "Si un POKéMON es\nenvenenado, perderá\vPS. El envenenamiento\fcontinúa tras el\ncombate y al caminar\fseguirá perdiendo\nPS. Para curarlo,\fusa ANTÍDOTO.\n",
  ["AcademySleepText"] = "Si tu POKéMON se queda\ndormido no podrá realizar\vningún movimiento.\fUn POKéMON dormido\nno se despierta\vtras el combate.\fDespiértalo con\nDESPERTAR.",
  ["AideText_AfterTheft"] = "(Suspiro…) El POKéMON\nrobado… Me pregunto\fcómo estará. Dicen\nque los POKéMON\feducados por\nmalas personas\fse vuelven\nmalos.",
  ["AideText_AlwaysBusy"] = "Sólo somos dos, así\nque siempre estamos\vocupados.",
  ["AideText_ExplainBalls"] = "Atrapa POKéMON\npara completar\vtu POKéDEX. Atrapa\fPOKéMON salvajes\nusando las\vPOKé BALL.",
  ["AideText_GiveYouBalls"] = "¡{PLAYER}! ¡Úsalas\fen tu aventura\nPOKéDEX!",
  ["AideText_GiveYouPotion"] = "{PLAYER}, quiero\nque tengas esto\vpor el recado.",
  ["AideText_TheftTestimony"] = "Oímos un ruido muy\nfuerte… Y cuando\fsalimos a mirar,\nalguien nos robó\vun POKéMON. ¡Es\fhorrible que alguien\nhiciera eso! (Suspiro…)\vEl POKéMON robado…\fMe pregunto\ncómo estará.\fDicen que los\nPOKéMON educados\fpor malas\npersonas\fse vuelven\nmalos.",
  ["AmphyBreathingLaboredText"] = "Apenas puede\nrespirar…",
  ["ArthurGaveGiftText"] = "JOSUÉ: Debería usarlo\nun POKéMON con\fhabilidades de\ntipo roca. Mejora\flos ataques de\ntipo roca.",
  ["ArthurGivesGiftText"] = "Toma. Coge\nesto.",
  ["ArthurNotThursdayText"] = "JOSUÉ: Hoy no\nes jueves. ¡Qué\vdesilusión!",
  ["ArthurThursdayText"] = "JOSUÉ: Soy JOSUÉ,\npor jueves. Soy\fel cuarto de siete\nhermanos.",
  ["AzaleaGymGuideText"] = "¡Hola, valiente!\fANTÓN es joven,\npero conoce muy bien\na los POKéMON bicho.\fSin mis consejos te\nresultaría más duro.\fVeamos… A los POKéMON\nbicho no les va el fuego.\fY los ataques de tipo\nvolador son muy\vefectivos.",
  ["AzaleaGymGuideWinText"] = "¡Eso es todo! ha sido un\ngran encuentro entre jóvenes con\ntalento.\fCon gente como tú,\nEl futuro de POKéMON será\nmaravilloso!",
  ["AzaleaGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE PUEBLO\vAZALEA: ANTÓN La\fenciclopedia andante\nde los POKéMON\vbicho",
  ["AzaleaMartBugCatcherText"] = "Mejor una SÚPER\nBALL para capturar\vPOKéMON que una\vPOKé BALL. Pero,\fa veces, las\nde CÉSAR son\vmejores.",
  ["AzaleaMartCooltrainerMText"] = "Aquí no hay SÚPER\nBALL. Tendrás que\fconformarte con\nlas POKé BALL. ¡Ojalá\fme pudiera fabricar\nCÉSAR alguna\vBALL!",
  ["AzaleaPokecenter1FFishingGuruText"] = "El PC de BILL puede\nalmacenar hasta 20\vPOKéMON por CAJA.",
  ["AzaleaPokecenter1FGentlemanText"] = "¿Tus POKéMON saben\nmovimientos MO? Se\fpueden usar estos\nmovimientos aunque\fel POKéMON esté\ndebilitado.",
  ["AzaleaPokecenter1FPokefanFText"] = "¿Sabes algo sobre\nlos BONGURI? Abre\funo, vacíalo y\nrellénalo con un\faparato especial.\nAsí podrás atrapar\fPOKéMON. Antes\nde que se inventaran\flas POKé BALL,\ntodos usaban\fBONGURI.\n",
  ["AzaleaPokecenter1FUnusedText"] = "BILL creó el Sistema\nde Almacenamiento\fen PC de los POKéMON.\nEl PC de BILL\falmacena hasta\n20 POKéMON\vpor CAJA.",
  ["AzaleaTownGrampsTextAfter"] = "Los SLOWPOKE han\nvuelto. Conociéndolos,\fquizá han estado\nremoloneando\fen algún\nlugar.",
  ["AzaleaTownGrampsTextBefore"] = "Los SLOWPOKE han\ndesaparecido del\vpueblo… Dicen\fque venden sus\nCOLAS en algún\vlugar.",
  ["AzaleaTownIlexForestSignText"] = "EL ENCINAR\fEntra por\nla puerta",
  ["AzaleaTownKurtText1"] = "¡El ENCINAR\nestá inquieto!\f¿Qué está\npasando?",
  ["AzaleaTownKurtText2"] = "¡{PLAYER}, aquí\ntienes tu\vGS BALL!",
  ["AzaleaTownKurtText3"] = "¿Puedes ir a ver por\nqué el ENCINAR está\vtan inquieto?",
  ["AzaleaTownRivalAfterText"] = "Odio a los débiles.\fYa sean POKéMON\no entrenadores.\vDa igual quién o\vqué. Seré fuerte\fy acabaré con los\nenclenques. Eso\vtambién va por el\fTEAM ROCKET. Son\nfuertes cuando\festán en grupo,\npero si están solos,\fson unos cobardes.\n¡Cuánto les odio!\f¡Fuera de mi\fvista! ¡Eres\ntan insignificante\fcomo el\nresto!",
  ["AzaleaTownRivalBeforeText"] = "Dime una cosa…\n¿Es cierto que\fel TEAM ROCKET\nha vuelto? ¿Qué?\v¿Los has derrotado?\f¡Anda! ¡No\nme mientas!\v¿Bromeas?\fPues a ver\nqué tal\veres.",
  ["AzaleaTownRivalLossText"] = "¡Ja! Sabía que\nmentías.",
  ["AzaleaTownRivalWinText"] = "¡Vaya! ¡Inútiles\nPOKéMON! ¡Escúchame!\f¡Has ganado\nporque mis\fPOKéMON eran\ndébiles!",
  ["AzaleaTownRocket1Text"] = "Entrar ahí es muy\npeligroso, por eso\vestoy de guardia.\f¿A que soy un buen\nsamaritano?",
  ["AzaleaTownRocket2Text"] = "¿Sabes algo sobre\nlas COLASLOWPOKE?\v¡Dicen que son muy\fsabrosas! ¿Te gusta\nsaberlo?",
  ["AzaleaTownSignText"] = "PUEBLO AZALEA Donde\nla gente y los POKéMON\fviven en feliz\narmonía",
  ["AzaleaTownSlowpokeText1"] = "SLOWPOKE: … <……>\f<……> <……>",
  ["AzaleaTownSlowpokeText2"] = "(Bostezo)<……>",
  ["AzaleaTownTeacherText"] = "¿Viste a CÉSAR\npara que te diera\valgunas BALL?\fMuchas personas\nlo hacen.",
  ["AzaleaTownYoungsterText"] = "Ataja de PUEBLO\nAZALEA y llegará a ENCINAR. Pero estos árboles\nimpidiéndote pasar.\fLos POKÉMON\nCARBONERO PUEDE CORTAR\nárboles.",
  ["BattleTowerOutsideBeautyText"] = "Solo puedes usar\ntres POKéMON.\fEs muy difícil\ndecidir cuáles\vtres llevar al\vcombate…",
  ["BattleTowerOutsideBeautyText_NotYetOpen"] = "¿Qué harán aquí?\fSi el nombre sirve\nde pista, creo que\nes para combates\nPOKéMON.",
  ["BattleTowerOutsideSailorText"] = "Je, je… Me escapé\ndel trabajo. ¡No\fpuedo achicar agua\nhasta que haya ganado!\vTengo que ganarlo\ftodo. ¡Debo\nganarlo!",
  ["BattleTowerOutsideSailorText_Mobile"] = "Jejeje… Me escapé\ndel trabajo\vpara venir.\v¡No abandonaré\fhasta que\nconsiga ser\vLÍDER!",
  ["BattleTowerOutsideSignText"] = "TORRE BATALLA ¡Acepta\fel desafío definitivo!\n",
  ["BattleTowerOutsideText_DoorsClosed"] = "La TORRE BATALLA\nestá cerrada…\v",
  ["BattleTowerOutsideText_DoorsOpen"] = "¡Está abierta!",
  ["BattleTowerOutsideYoungsterText"] = "¡Guau, la TORRE BATALLA\nes enorme! ¡Debe\fde haber muchas\nclases de  POKéMON\vdentro!",
  ["BattleTowerOutsideYoungsterText_Mobile"] = "¡Guau, la TORRE\nBATALLA es enorme!\fHabiendo tanto\nentrenador ahí\fdentro, también\ndebe de haber\funa gran variedad\nde POKéMON.\v",
  ["BattleTowerOutsideYoungsterText_NotYetOpen"] = "¡Guau, la TORRE\nes inmensa! Me\fduele el cuello\nde alzar la\vvista.",
  ["BeautyCassieAfterBattleText"] = "Lo mejor para curar\nlas penas es hacer\vun viaje en\vbarco. Pero\flos viajes en\nFERRY son muy\vcortos.",
  ["BeautyCassieBeatenText"] = "Estoy desolada…",
  ["BeautyCassieSeenText"] = "Intento olvidar\na mis enemigos.\v¡Luchemos!",
  ["BeautyJuliaAfterBattleText"] = "¿Cómo podré llegar\na ser tan elegante\vcomo ERIKA?",
  ["BeautyJuliaSeenText"] = "¿Estabas mirando\nestas flores\vo a mí?",
  ["BeautySamanthaAfterBattleText"] = "Le había enseñado\na MEOWTH todo tipo\vde ataques…",
  ["BeautySamanthaBeatenText"] = "¡No! ¡Oh, MEOWTH,\nlo siento mucho!",
  ["BeautySamanthaSeenText"] = "¡Hazlo lo mejor\nque puedas o acabaré\vcontigo!",
  ["BeautyValerieAfterBattleText"] = "Cuando veo\nPOKéMON\vme tranquilizo.\v",
  ["BeautyValerieBeatenText"] = "Encantada de haber visto\na tus POKéMON.",
  ["BeautyValerieSeenText"] = "¡Hola! ¡Tienes\nbuen aspecto! ¿Me\fdejas ver a tus\nPOKéMON?",
  ["BeautyVictoriaAfterBattleText"] = "¡Uau! ¡Debes de valer\nmucho para haberme ganado!\v¡Sigue así!",
  ["BeautyVictoriaBeatenText"] = "Veamos… ¡Uups!\n¿Ya está?",
  ["BeautyVictoriaSeenText"] = "¡Tienes gracia!\n¡Me gustas!\f¡Pero no me\nrendiré!",
  ["BenText"] = "NARDO: ¿Escuchas\nnuestra música?",
  ["BikeShopPhoneCallerText"] = "¡Hola, {PLAYER}! ¡Las\nventas de BICICLETAS han\fsubido como la espuma!\nSe lo debemos todo a\fla publicidad que nos\nhas dado montando de\faquí para allá en nuestra\nBICICLETA. Como muestra\fde agradecimiento,\npor favor, quédate\fcon la BICICLETA. ¡Gracias\nde nuevo!",
  ["BikerCharlesAfterBattleText"] = "¡Conducir de forma imprudente\ncausa accidentes!\v¡Ten cuidado!",
  ["BikerCharlesBeatenText"] = "¡Arrrg! ¡Chocar\ny arder!",
  ["BikerCharlesSeenText"] = "¡Somos estrellas\nde la carretera!",
  ["BikerDwayneAfterBattleText"] = "¡Viva la FEDERACIÓN\nPOKéMON de\vKANTO!",
  ["BikerGlennAfterBattleText"] = "Montar sin manos en\nel CAMINO de BICIS\ves muy guay.",
  ["BikerGlennBeatenText"] = "¡Vaya! ¡Qué\nvitalidad!",
  ["BikerGlennSeenText"] = "¡Eh! ¿Un combate\nrapidito?",
  ["BikerHarrisAfterBattleText"] = "Destruido por alguien\nde JOHTO…",
  ["BikerHarrisSeenText"] = "La policía ha cerrado\nla VÍA SUBTERRÁNEA.\f¡Qué fastidio!\n",
  ["BikerJoelAfterBattleText"] = "Soy guay, pero estoy\ndébil. Por eso\vno lo parezco.\fDebería entrenar\nmucho más…",
  ["BikerJoelBeatenText"] = "Pero tú no pareces\nguay…",
  ["BikerJoelSeenText"] = "¡Uau! ¡Qué BICI\nmás guay!",
  ["BikerRileyAfterBattleText"] = "¡No te pases, que\nesto no es JOHTO!",
  ["BikerZekeAfterBattleText"] = "Intentaremos no molestar\na nadie a partir\vde ahora.",
  ["BikerZekeSeenText"] = "Somos la FEDERACIÓN\nPOKéMON de\vKANTO. ¡Allá\vvamos!",
  ["BillEeveeMayEvolveText"] = "BILL: ELM dice que\nEEVEE evoluciona\fen formas nuevas\ny desconocidas.",
  ["BillImCountingOnYouText"] = "BILL: ¡Sabía que\naceptarías! ¡Vamos!\f¡Tú sí que vales!\nBueno, cuento\fcontigo.\n¡Cuídalo\vbien!",
  ["BillNoEeveeText"] = "¡Oh…! ¿Qué podemos\nhacer ahora?",
  ["BillPartyFullText"] = "No, espera. No\npuedes llevar\vmás POKéMON.",
  ["BillPhoneDayGreetingText"] = "¿Qué tal? Éste es\fel SERVI- CIO de ADMÓN.\ndel SISTEMA de ALMACE-\fNAMIENTO de los\nPOKéMON.",
  ["BillPhoneFullText"] = "¡Gracias por esperar!\n¡ {PLAYER}, tu CAJA está llena!\nTendrás que cambiar tu CAJA\nsi quieres preguntar más\nPOKÉMON.",
  ["BillPhoneGenericText"] = "¿Quién llama?\f{PLAYER},\n¿no? Un segundo…\f<……>\n<……>",
  ["BillPhoneMornGreetingText"] = "¡Buenos días! Éste\fes el SERVI- CIO de\nADMÓN. del SISTEMA\fde ALMACE- NAMIENTO\nde los POKéMON.",
  ["BillPhoneNewlyFullText"] = "Hola. ¿{PLAYER}?\n¡Soy yo, BILL! Gracias por usar mi SISTEMA\nde ALMACENAMIENTO.\fEl último POKéMON\nque enviaste ha llenando la CAJA.\ftendrás que cambiar\nde CAJA si quieres coleccionar más POKéMON.\n¡Vamos!",
  ["BillPhoneNiteGreetingText"] = "¡Buenas noches! Éste\fes el SERVI- CIO de\nADMÓN. del SISTEMA\fde ALMACE- NAMIENTO\nde los POKéMON.",
  ["BillPopWontWorkText"] = "BILL: Mi padre\nno trabaja. Lo\vúnico que hace\ves holgazanear.\fEs que no da\nni golpe…",
  ["BillTakeThisEeveeText"] = "BILL: ¡Hola, {PLAYER}!\nHaznos un favor\vy acepta este EEVEE.\fApareció cuando\najustaba la CÁPSULA\vDEL TIEMPO. Alguien\ftiene que cuidarlo\ny a mí no me\fgusta salir.\n¿Puedo confiar\fen ti para jugar\ncon él, {PLAYER}?\v",
  ["BillsGrandpaAskToSeeMonText"] = "Si tienes ese\nPOKéMON, ¿me\vdejas verlo?",
  ["BillsGrandpaComeAgainText"] = "Vuelve cuando\nquieras.",
  ["BillsGrandpaExcitedToSeeText"] = "¿Me lo dejas ver?\n¡Qué amable eres!",
  ["BillsGrandpaGrowlitheText"] = "BILL me habló de\nun POKéMON que\fes muy fiel a\nsu entrenador.\fSe supone que\nRUGE bien.",
  ["BillsGrandpaIntroText"] = "¿Conoces a BILL?\nEs mi nieto. Está\fen JOHTO trabajando\ncon los PC.\fYo le cuido\nla casa.",
  ["BillsGrandpaLickitungText"] = "Mi nieto BILL me dijo\nque había un POKéMON\fcon una lengua\nmuy larga.",
  ["BillsGrandpaOddishText"] = "Mi nieto mencionó\na un POKéMON verde\fy redondo al que\nle crecen hojas\ven la cabeza.",
  ["BillsGrandpaPichuText"] = "¿Conoces a ese\nPOKéMON tan popular?\vEl POKéMON de\fcuerpo amarillo\ny mejillas\vrojas. Me\fgustaría verlo\nantes de\fque evolucione.\n",
  ["BillsGrandpaShownAllThePokemonText"] = "Gracias por mostrarme\ntantos POKéMON\vtan bonitos. Me\fhe divertido mucho.\nMe alegro de\fhaber vivido\ntantos años.",
  ["BillsGrandpaStaryuText"] = "¿Conoces a un POKéMON\nde mar que tiene\funa esfera roja\nen el cuerpo?\fYa sabes, ése\nque tiene forma\vde estrella.\fDicen que sale\npor la noche.\fMe encantaría\nverlo.",
  ["BillsGrandpaTokenOfAppreciationText"] = "¡Gracias! Toma\festo como agradecimiento.\n",
  ["BillsGrandpaVulpixText"] = "He oído hablar\nde un POKéMON que\vtiene seis colas.\fMe gustaría abrazar\na un POKéMON\vasí.",
  ["BillsGrandpaWrongPokemonText"] = "¿Mmm? Ése no\fes el POKéMON\ndel que me\vhablaron.",
  ["BillsGrandpaYouDontHaveItTextText"] = "¿No lo tienes?\n¡Qué pena…!",
  ["BillsHouseSignText"] = "CASA DEL MAR CASA DE\nBILL CASA DE BILL",
  ["BillsMomText_AfterEcruteak"] = "Mi marido era conocido\ncomo un #MANÍACO.\vBILL ha debido de\fseguir los pasos\nde su padre.",
  ["BillsMomText_BeforeEcruteak"] = "Anda, ¿coleccionas POKéMON?\nMi hijo BILL es todo un\vexperto. Le han llamado\fdel CENTRO POKéMON de\nCIUDAD IRIS. Mi marido\ffue al CASINO sin que\nle llamara nadie…",
  ["BillsOlderSisterText"] = "Mi abuelo está en\nla casa de mi hermano\vBILL, en CIUDAD\nCELESTE.",
  ["BillsOlderSistersHouseYoungsterText"] = "He visto unos POKéMON\nextraños y lentos\ven la RUTA CICLISMO.",
  ["BillsYoungerSisterPhoneFullText"] = "Ya no puedes\nanotar más números.",
  ["BillsYoungerSisterRefusedNumberText"] = "Mi hermano creó\nel sistema de\valmacenamiento de POKéMON\fen el PC.\nIba a darte el\vnúmero de BILL…",
  ["BillsYoungerSisterStorageSystemText"] = "Mi hermano mayor,\nBILL, creó el\nsistema de\nalmacenamiento de POKéMON.",
  ["BillsYoungerSisterUsefulNumberText"] = "¿Eres entrenador?\fTengo un número de\nteléfono\vque te será útil.",
  ["BirdKeeperAbeAfterBattleText"] = "Qué patético resulta\nperder contra entrena-\vdores novatos…",
  ["BirdKeeperAbeBeatenText"] = "¡No puede ser\ncierto!",
  ["BirdKeeperAbeSeenText"] = "¡Demuéstrame que vales\nlo suficien- te para luchar\vcontra PEGASO!",
  ["BirdKeeperBobAfterBattleText"] = "Si no tienes\nuna BICI, no\fpodrás usar\nel atajo.",
  ["BirdKeeperBobSeenText"] = "El CAMINO de BICIS\nes un atajo a CIUDAD\vAZULONA.",
  ["BirdKeeperBorisAfterBattleText"] = "Siendo tan fuerte,\ndebe de ser muy divertido\vluchar.",
  ["BirdKeeperBorisSeenText"] = "Si estás buscando\nPOKéMON, mira en\flas zonas de\nhierba alta.",
  ["BirdKeeperBretAfterBattleText"] = "Los POKéMON son felices\nsi los pones guapos.",
  ["BirdKeeperBretBeatenText"] = "¡Vaya! ¡No soy lo\nbastante bueno!",
  ["BirdKeeperBretSeenText"] = "Mira mis POKéMON.\nFíjate en\vsu color\fy en su plumaje.\n",
  ["BirdKeeperBryanAfterBattleText"] = "Algunos POKéMON huyen\nenseguida. Intenta\fatraparlos con la\nRAPID BALL de CÉSAR.\vCuando encuentro\fun BONGURI BLA,\nse lo llevo a\vCÉSAR. Él lo convierte\fen una POKé\nBALL.",
  ["BirdKeeperBryanBeatenText"] = "¡Vaya! ¡No lo bastante\nrápido!",
  ["BirdKeeperBryanSeenText"] = "¿Qué tipo de POKé\nBALL usas?",
  ["BirdKeeperDenisAfterBattleText"] = "Mi POKéMON aprendió\nVUELO en CIUDAD\vORQUÍDEA. Y como\fsoy un perdedor,\ncruzaré el mar\vVOLANDO…",
  ["BirdKeeperDenisBeatenText"] = "¡Uups…! ¡Se estrellaron!",
  ["BirdKeeperDenisSeenText"] = "Estamos a gran altura\naquí. Mis POKéMON\fpájaro están\nen forma.",
  ["BirdKeeperHankAfterBattleText"] = "Si tienes un POKéMON\nque desees mejorar,\vponlo en primer\flugar y cámbialo\nnada más empezar.\vAsí es como\fhay que hacerlo.\n",
  ["BirdKeeperHankBeatenText"] = "¡Argh! He perdido\nesta vez…",
  ["BirdKeeperJose2AfterBattleText"] = "Los ORNITÓLOGOS imitan\nel canto de los\fpájaros para controlar\nPOKéMON.",
  ["BirdKeeperJose2SeenText"] = "¡Far! ¡Far!\n¡Feeetch!",
  ["BirdKeeperPerryAfterBattleText"] = "Tus POKéMON están\nmuy bien entrenados.\v",
  ["BirdKeeperPerryBeatenText"] = "Me venciste con\ntu velocidad…",
  ["BirdKeeperPerrySeenText"] = "La agilidad es la\nclave de los POKéMON\vpájaro.",
  ["BirdKeeperPeterAfterText"] = "Debería volver\na entrenarme en\vel GIMNASIO de\vCIUDAD MALVA.",
  ["BirdKeeperPeterBeatenText"] = "Conozco mis debilidades.\n",
  ["BirdKeeperPeterSeenText"] = "¡Esa MEDALLA! ¡Es\nde CIUDAD MALVA! ¿Ganaste\fa PEGASO?",
  ["BirdKeeperRodAfterBattleText"] = "la destreza de\n¡PEGASO es real!\fNo confíes en ti mismo\npor haberme derrotado!",
  ["BirdKeeperRodSeenText"] = "¡La clave está en\ntener valor! Éstos\fse entrenan noche\ny día para convertirse\fen maestros\nPOKéMON. ¡Adelante!\f",
  ["BirdKeeperRoyAfterBattleText"] = "¿Tienes POKéMON\nque conozcan la\fMO VUELO? ¿Sí?\n¡Qué envidia!",
  ["BirdKeeperRoyBeatenText"] = "Puedo soñar, pero nunca\npodré volar.",
  ["BirdKeeperRoySeenText"] = "Mi sueño es volar\ncon mi querido POKéMON\vpájaro.",
  ["BirdKeeperTheoAfterBattleText"] = "¿Cómo diablos\nse sube? Quiero\fvisitar al POKéMON\nenfermo, pero\fno puedo\nsubir…",
  ["BirdKeeperTheoBeatenText"] = "Te preocupas\nde verdad…",
  ["BirdKeeperTobyAfterBattleText"] = "lo pienso\nen CIUDAD ORQUÍDEA y enseñándome a volar\nPOKÉMON.",
  ["BirdKeeperTobyBeatenText"] = "¡Me apetece salir\nvolando ahora!",
  ["BirdKeeperVance1BeatenText"] = "¡Uauu! Eres el\nno va más.",
  ["BirdKeeperVance1SeenText"] = "¿Sabes algo sobre\nel POKéMON pájaro\vlegendario?",
  ["BirdKeeperVanceLegendaryBirdsText"] = "ARTICUNO, ZAPDOS\ny MOLTRES son los\fPOKéMON pájaro legendarios,\naunque dicen\fque hay otros\npájaros legendarios.\v",
  ["BlackBeltText_VoicesInMyHead"] = "¡Auu! ¿Estás en\nmi cabeza! ¿Como?\festoy escuchando\nla radio!",
  ["BlackBeltText_WeirdRadio"] = "¿Mi radio está rota?\nSólo recibo esta\vrara señal.",
  ["BlackbeltKenjiAfterBattleText"] = "Esto requiere medidas\nextremas. Debo ir\fa los mon- tes y\nentrenarme allí,\ven soledad.",
  ["BlackbeltLaoAfterText"] = "Los POKéMON de\nlucha temen a los\vpsíquicos…",
  ["BlackbeltLaoBeatenText"] = "¡Es increíble!",
  ["BlackbeltLaoSeenText"] = "¡Los expertos en artes marciales\nno tememos a nada!",
  ["BlackbeltLungAfterText"] = "¡Mis POKéMON\nhan perdido!\vHas herido mi\vorgullo.",
  ["BlackbeltLungBeatenText"] = "¡Me has aplastado!",
  ["BlackbeltLungSeenText"] = "¡Mis furiosos puños\ndestrozarán a\vtus POKéMON!",
  ["BlackbeltNobAfterText"] = "¡He perdido! ¡No\nsé qué decir!",
  ["BlackbeltNobSeenText"] = "Las palabras no sirven.\n¡Deja que tus puños puedan usarlo!",
  ["BlackbeltWaiAfterBattleText"] = "No pude encontrar\nal REY del KARATE\ven JOHTO. Dicen\fque se está entrenando\nen alguna\vcueva.",
  ["BlackbeltWaiBeatenText"] = "¡Bailemos el Rock\nand Roll!",
  ["BlackbeltWaiSeenText"] = "¡Fortalezco mis\npiernas nadando\fen la estela\ndel barco!",
  ["BlackbeltYoshiAfterText"] = "¡Parece que tú y\ntus POKéMON estáis\vmuy unidos!",
  ["BlackbeltYoshiBeatenText"] = "¡No puede ser!",
  ["BlackbeltYoshiSeenText"] = "A mis POKéMON y a\nmí nos une una gran\vamistad. ¡Nuestro\fvínculo nunca\nse romperá!",
  ["BlackthornCitySignText"] = "CIUDAD ENDRINO\nUn tranquilo\frefugio de\nmontaña",
  ["BlackthornCityTrainerTipsText"] = "PISTAS ENTRENADOR\fTodo POKéMON que\nvaya equipado con\funa BAYA MILAGRO\nse curará a sí mismo\ven combate",
  ["BlackthornCooltrainerF1Text"] = "¿Quieres que tus\nPOKéMON olviden algún\vmovimiento?",
  ["BlackthornCooltrainerF2Text"] = "¡Uau! ¿Has venido\npor la RUTA\vHELADA? ¡Debes\fde ser genial!\n",
  ["BlackthornDragonSpeechHouseDratiniText"] = "DRATINI: ¡Draa!",
  ["BlackthornDragonSpeechHouseGrannyText"] = "En CIUDAD ENDRINO\nvive un clan que\vpuede controlar\va los dragones a\vsu antojo. Por ello,\fhay muchas leyendas\nacerca de dragones\ven esta\vciudad.",
  ["BlackthornGrampsGrantsEntryText"] = "Si DÉBORA lo permite,\nsu abuelo, nuestro\fMAESTRO, también.\nPuedes entrar.",
  ["BlackthornGrampsRefusesEntryText"] = "No. Sólo los elegidos\npueden entrenarse\faquí. Por favor,\nvete.",
  ["BlackthornGym2FBoulderFellText"] = "¡La piedra cayó\npor el agujero!",
  ["BlackthornGymClairText_DescribeTM24"] = "Esta MT contiene\nDRAGOALIENTO. No,\fno tiene nada que\nver con mi aliento.\vSi no la quieres,\fno es necesario\nque la aceptes.\v",
  ["BlackthornGymClairText_League"] = "¿Qué pasa? ¿No\fvas a la LIGA\nPOKéMON? ¿Sabes\vcómo ir hasta\fallí? Desde aquí,\nve a PUEBLO PRIMAVERA.\fVe hacia el\nEste, con SURF,\va la LIGA POKéMON.\fLa ruta es muy\ndura. ¡No te\fatrevas a perder\nen la LIGA\fPOKéMON! ¡Si\nlo haces,\vme sentará\fmuy mal haber\nperdido contigo!\fHaz todo\nlo que\fpuedas.\n",
  ["BlackthornGymClairText_YouKeptMeWaiting"] = "¡Me has hecho\nesperar!\f¡Ven! ¡Coge\nesto!",
  ["BlackthornGymGuideText"] = "¡Eh!\n¡FUTURO\fCAMPEÓN!\n¡Ya casi hemos\nllegado! ¡Puedes\ncontar conmigo!\nDÉBORA usa dragones\vmíticos y sagrados\vde tipo dragón.\fNo podrás\nhacerles daño\ffácilmente.\nPero recuerda que\vson débiles\ncontra el hielo.",
  ["BlackthornGymGuideWinText"] = "¡Has sido increíble\nal vencer a DÉBORA!\fSolo queda el reto\nde la LIGA POKéMON.\v¡Estás en el\vcamino de\nconvertirte en\vCAMPEÓN POKéMON!",
  ["BlackthornGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vENDRINO: DÉBORA\vLa gran experta\fen POKéMON\ndragón",
  ["BlackthornMartBlackBeltText"] = "MÁX. REPEL evita\nque se acerquen\vPOKéMON débiles.\fEs el repelente\nmás duradero\vde todos.",
  ["BlackthornMartCooltrainerMText"] = "No puedes comprar\nMÁX. REVIVIR, pero\féste reanima a un\nPOKéMON debilitado.\fAtención: No restaura\nlos PP o PUNTOS\fde PODER de los\nmovimientos.",
  ["BlackthornPokecenter1FGentlemanText"] = "En el corazón de\nla remota MESETA\vAÑIL se celebra la\vLIGA POKéMON. Dicen\fque allí se reúnen\nlos mejores entrenadores\fde todo el\npaís.",
  ["BlackthornPokecenter1FTwinText"] = "Tenía un movimiento\nque quería enseñar\fa mi POKéMON.\nAsí que usé el\fQUITA-MOVIMIENTOS\ny eliminé\vuna MO.",
  ["BlackthornYoungsterText"] = "Todos los expertos\nen dragones vienen\vde CIUDAD\vENDRINO.",
  ["BlaineAfterBattleText"] = "BLAINE: Esta vez\nhe perdido, pero\fla próxima te ganaré.\nCuando reconstruya\fmi GIMNASIO de\nI. CANELA, tendremos\fla revancha.\n",
  ["BlaineFightDoneText"] = "BLAINE: Mis POKéMON\nde fuego serán\fmás fuertes. ¡Ya\nlo verás!",
  ["BlaineIntroText"] = "BLAINE: ¡Buaaa!\fMi GIMNASIO de ISLA\nCANELA se ha quemado.\fEl volcán nos ha\ndejado sin casa\fa mis POKéMON comefuego\ny a mí. ¡Buaaaa!\fPero sigo haciendo\fmi trabajo de\nLÍDER de GIMNASIO\fen esta cueva.\nSi me vences,\fte daré una\nMEDALLA. ¡Ja!\vEspero que\ftengas ANTIQUEMAR.\n",
  ["BlaineWinLossText"] = "BLAINE: Increíble.\nMe consumí… ¡Has\fganado la MEDALLA\nVOLCÁN!",
  ["BluesHouseSignText"] = "CASA DE AZUL",
  ["BoarderBradAfterBattleText"] = "Este GIMNASIO es genial.\n¡Me encanta patinar\vcon mis POKéMON!",
  ["BoarderBradBeatenText"] = "¿Ves lo serios\nque somos?",
  ["BoarderBradSeenText"] = "Este GIMNASIO tiene\nun suelo resbaladizo.\f¿A que es divertido?\n¡Pero oye,\faquí no estamos\njugando!\v",
  ["BoarderDouglasAfterBattleText"] = "El secreto del poder\nde FREDO… Medita todos\flos días bajo una\ncascada para fortalecer\fel cuerpo y\nla mente.",
  ["BoarderDouglasBeatenText"] = "Te contaré el secreto\nde FREDO.",
  ["BoarderDouglasSeenText"] = "Conozco el secreto\nde FREDO.",
  ["BoarderRonaldAfterBattleText"] = "Hay un movimiento\nque se puede usar\fcuando el POKéMON\nestá congelado.",
  ["BoarderRonaldBeatenText"] = "Maldición. No pude\nhacer nada.",
  ["BoarderRonaldSeenText"] = "¡Congelaré a tus\nPOKéMON! ¡No podrás\vhacer nada!",
  ["BorrowedABicycleText"] = "{PLAYER} tomó prestada\nuna BICI.",
  ["BridgetWhitneyCriesText"] = "¡Oh, no! Has hecho\nllorar a BLANCA.\f¡No te preocupes!\nPronto dejará de\fllorar. Siempre llora\nsi pierde.",
  ["BrockBoulderBadgeText"] = "BROCK: {PLAYER},\ngracias. Me ha\fgustado el combate\naunque estoy algo\vmolesto. La MEDALLA\fROCA hará que\ntus POKéMON\fsean más\nfuertes.",
  ["BrockFightDoneText"] = "BROCK: El mundo\nes enorme. Hay muchos\fentrenadores tan\nfuertes como tú.\fEspera y verás.\nYo también me\vvoy a hacer\vmás fuerte.",
  ["BrockIntroText"] = "BROCK: ¡Uau! No\ntodos los días nos\fdesafía alguien\nde JOHTO. Soy BROCK,\fLÍDER del GIM.\nde C. PLATEADA\fy experto en POKéMON\nroca. Mis POKéMON\fson insensibles\na la mayoría\fde ataques físicos.\nTe será muy\fdifícil hacerles\ndaño. ¡Venga!\f",
  ["BrockWinLossText"] = "BROCK: Mi dura defensa\nno soportó los\vataques de tus\vPOKéMON… Eres\fmás fuerte de\nlo que pensaba…\fToma. Coge esta\nMEDALLA.",
  ["BrunoScript_BrunoBeatenText"] = "¿Qué? ¿Cómo hemos\npodido perder?",
  ["BrunoScript_BrunoBeforeText"] = "Soy BRUNO, del.\nALTO MANDO. siempre entro\nmáximo porque confío en nuestro potencial. Por eso somos tan\nfuerte. ¿Resistirás nuestro poder?\n¿Mmm? No veo que tengas miedo.\nPareces atrevido.\f¡Perfecto! vamos,\n ¿{PLAYER}? te duplicaras\nante nuestro inmenso\npoder! ¡Ja, ja!",
  ["BrunoScript_BrunoDefeatText"] = "Como he perdido,\nno tengo derecho\va decir nada… ¡Enfréntate\fal siguiente\ndesafío!",
  ["BugCatcherAlAfterBattleText"] = "Son geniales,\npero la mayoría\fde las chicas\nodian los POKéMON\vbicho. No sé\fpor qué…",
  ["BugCatcherAlBeatenText"] = "Has demostrado lo\nfuerte que eres…",
  ["BugCatcherAlSeenText"] = "¡Los POKéMON bicho\nson buenos y muy\ffuertes! ¡Te lo\ndemostraré!",
  ["BugCatcherArnieAfterBattleText"] = "Mi VENONAT lo consiguió\nPARQUE Concurso de Captura de Animales\nNACIONAL.",
  ["BugCatcherArnieBeatenText"] = "¿Eh? No debería\nhaber perdido…",
  ["BugCatcherArnieSeenText"] = "Iré a cualquier\nlugar donde haya\vPOKéMON bicho.",
  ["BugCatcherBennyAfterBattleText"] = "Los POKéMON se hacen\nmás fuertes si\vevolucionan.",
  ["BugCatcherBennyBeatenText"] = "¡No se trata sólo\nde evolucionar!",
  ["BugCatcherBennySeenText"] = "Los POKéMON bicho\nevolucionan pronto\fy se hacen fuertes\nmucho antes.",
  ["BugCatcherDonAfterText"] = "Me quedé sin POKé\nBALL mientras atrapaba\vPOKéMON. Debería\fhaber comprado\nmás…",
  ["BugCatcherDonBeatenText"] = "¡Arg! ¡Eres\nmuy fuerte!",
  ["BugCatcherDonSeenText"] = "¡En lugar de un POKéMON\nbicho, he encontrado a alguien\vque los entrena!",
  ["BugCatcherDougAfterBattleText"] = "Los POKéMON bicho\nparecen muñecos\fde goma cuando\nles aprietas\vla tripa. ¡Me\fencanta tocarlos!\n",
  ["BugCatcherDougSeenText"] = "¿Por qué a las chicas no les\ngustan los POKéMON bicho?",
  ["BugCatcherEdAfterBattleText"] = "Seguro que\nte pican si\vte bañas.",
  ["BugCatcherEdBeatenText"] = "¡Au, au, au!",
  ["BugCatcherEdSeenText"] = "Si caminas por la\nhierba alta con pantalones\fcortos, ¿no\nte arañas?",
  ["BugCatcherJoshAfterBattleText"] = "Supongo que debería\nenseñarles mejores\vataques…",
  ["BugCatcherJoshSeenText"] = "¿Has salvado a los\nSLOWPOKE? ¡Uauu!\v¡Eres muy fuerte!\f¡Pero mis POKéMON\nentrenados también\vlo son!",
  ["BugCatcherKenAfterBattleText"] = "Encontrarás muchos\nPOKéMON en los árboles\vde JOHTO.",
  ["BugCatcherKenBeatenText"] = "Ooooh, guau.\n¡Qué fuerte!",
  ["BugCatcherKenSeenText"] = "¡Voy a ver a mi abuela\npara que me atrape unos\vcuantos bichos!",
  ["BugCatcherRobAfterBattleText"] = "Voy a buscar POKéMON\nbicho más\vfuertes.",
  ["BugCatcherWade1AfterText"] = "Puedes atrapar\nPOKéMON aunque\fya lleves seis\ncontigo. Si atrapas\falguno más,\nserá enviado\va la CAJA.",
  ["BugCatcherWade1SeenText"] = "He atrapado un\nmontón de POKéMON.\v¡Luchemos!",
  ["BugCatchingContestExplanationText"] = "El concurso de captura\nde Bichos celebra los martes, jueves y\nSábados. Sólo ganarás un premio por participar\ncipar. Además, ¿puedes quedarte con él?\nAnimal POKéMON que tienes al final.\ndel concurso.",
  ["BugCatchingContestant10AText"] = "KOLDO: Soy un gran\nestudiante de animales POKéMON.\festoy a salvo\npara ganar.",
  ["BugCatchingContestant10BStillCompetingText"] = "KOLDO: Estudió\nmucho pero no vale la pena\npara ganar.",
  ["BugCatchingContestant10BText"] = "KOLDO: ¿Me das\nalgún consejo?\fQuiero estudiar\ntu estilo.",
  ["BugCatchingContestant1AText"] = "RAFA: ¡Voy a\nganar! No me\vmolestes.",
  ["BugCatchingContestant1BStillCompetingText"] = "RAFA: La suerte\ncuenta mucho.\fNunca se sabe\nqué POKéMON va\va aparecer.",
  ["BugCatchingContestant1BText"] = "RAFA: ¡Uau! Me\nhas vencido.\vNo está mal.",
  ["BugCatchingContestant2AText"] = "SAM: Mi PARASECT\nduerme a los #-\vMON con ESPORA.",
  ["BugCatchingContestant2BStillCompetingText"] = "SAM: A lo mejor es que has ganado\nporque tus POKéMON son grandes…",
  ["BugCatchingContestant2BText"] = "SAM: Te envidio.\nEsta vez no lo\vhe conseguido.",
  ["BugCatchingContestant3AText"] = "NANO: Entreno a\nPOKéMON rápidos\vpara luchar.",
  ["BugCatchingContestant3BStillCompetingText"] = "NANO: Quizá ganes\nmás puntos por un\fPOKéMON de un color\ninusual.",
  ["BugCatchingContestant3BText"] = "NANO: ¡Eso es! Voy\nentrenando mejor a mis POKéMON.",
  ["BugCatchingContestant4AText"] = "GUILLE: No\nme importa\vganar. Sólo\fbusco POKéMON\nraros.",
  ["BugCatchingContestant4BStillCompetingText"] = "GUILLE: Me alegra\nhaber atrapado\fel POKéMON que\nquería.",
  ["BugCatchingContestant4BText"] = "GUILLE: ¿Ganaste?\n¿Qué has atrapado?\v",
  ["BugCatchingContestant5AText"] = "TINO: ¡Ssh! Vas\na asustar a SCYTHER.\fHablaré contigo\ndespués.",
  ["BugCatchingContestant5BStillCompetingText"] = "TINO: He atrapado\nun SCYTHER, pero\vhe perdido.",
  ["BugCatchingContestant5BText"] = "TINO: Enhorabuena.\n¡Te has ganado\vmi respeto!",
  ["BugCatchingContestant6AText"] = "BENITO: Debilita\na los POKéMON bicho\fy lánzales una\nPARQUE BALL.",
  ["BugCatchingContestant6BStillCompetingText"] = "BENITO: Es más fácil\nganar con un POKéMON\fbicho de nivel\nalto. Pero creo\fque también\ncuentan otros\vaspectos.",
  ["BugCatchingContestant6BText"] = "BENITO: El POKéMON\nque has atrapado…\ves impresionante.",
  ["BugCatchingContestant7AText"] = "CINDY: Me gustan\nlos POKéMON bicho.\fSeguro que a\nti también.",
  ["BugCatchingContestant7BStillCompetingText"] = "CINDY: ¡Adoro los\nPOKéMON bicho!",
  ["BugCatchingContestant7BText"] = "CINDY: ¿Ganaste?\n¡Qué bien! ¿Te\fapetece buscar\nPOKéMON bicho\vconmigo?",
  ["BugCatchingContestant8AText"] = "KAI: Colecciono\nPOKéMON bicho desde\fque era sólo un\nniño. ¡Es imposible\fque pueda\nperder!",
  ["BugCatchingContestant8BStillCompetingText"] = "KAI: ¡Dicen que alguien\nha ganado con\vun CATERPIE!",
  ["BugCatchingContestant8BText"] = "KAI: ¡No…! No me\npuedo creer que\vhaya perdido.",
  ["BugCatchingContestant9AText"] = "SAMUEL: Si tienes\ntiempo para conversar,\fbusca POKéMON\nbicho.",
  ["BugCatchingContestant9BStillCompetingText"] = "SAMUEL: Vaya, creí\nque obtendría\vmás puntos…",
  ["BugCatchingContestant9BText"] = "SAMUEL: La próxima\nvez ganaré yo.",
  ["BugContestPrizeNoRoomText"] = "¡Oh! Tu MOCHILA\nestá llena. Te\fguardaremos\nesto. Vuelve\fcuando tengas\nsitio.",
  ["BugsyText_BugMonsAreDeep"] = "Los POKéMON bicho\nson muy complejos.\fQuedan muchos misterios\npor resolver. Estudia\fa fondo tus\nfavoritos.",
  ["BugsyText_FuryCutterSpeech"] = "MT49 contiene CORTEFURIA.\nSi no fallas,\fse hace cada vez\nmás fuerte. Cuanto\vmás dure el\fcombate, más\nfuerte será.\v¿No es genial?\f¡Lo descubrí\nyo!",
  ["BugsyText_HiveBadgeSpeech"] = "¿Conoces las ventajas\nde la MEDALLA COLMENA?\vSi la tienes, los\fPOKéMON hasta\nN.30 te obedecerán.\vY los POKéMON\fque sepan CORTE\npodrán usarlo\ffuera del combate.\nMira, también\fte daré\nesto.",
  ["BugsyText_INeverLose"] = "¡Soy ANTÓN! Soy\ninvencible con\flos POKéMON bicho.\n¡Mis estudios\fme van a convertir\nen una autoridad\fen los POKéMON\nbicho! Te\fenseñaré lo\nque he aprendido.\v",
  ["BugsyText_ResearchIncomplete"] = "¡Uauu, increíble!\n¡No hay POKéMON que\vse te resista! Mi\finvestigación aún\nno ha acabado. Vale,\ftú ganas. Toma\nesta MEDALLA.",
  ["BurglarCoreyAfterBattleText"] = "He encontrado una\nmoneda muy bonita.\fAlguien debe de haberla\nperdido…",
  ["BurglarCoreyBeatenText"] = "¡Qué mala suerte!\n¡He perdido!",
  ["BurglarDuncanAfterBattleText"] = "¡Robar y vender!\n¡La base de todo\vacto criminal!",
  ["BurglarDuncanSeenText"] = "¡Paga tus\ndeudas!",
  ["BurglarEddieAfterBattleText"] = "¿Al ALMACÉN SUBTERRÁNEO?\n¿Para qué\fquieres ir\nahí? Ahí abajo\fno hay\nnada.",
  ["BurglarEddieSeenText"] = "Abandonaron este\nproyecto antes\vde terminarlo.\fEstoy buscando\nrestos.",
  ["BurnedTower1FEusineIntroText"] = "EUSINE: Me llamo\nEUSINE. Estoy tras\fla pista de un POKéMON\nllamado SUICUNE.\v¿Y tú eres…? ¿{PLAYER}?\f¡Encantado de conocerte!\fHe oído rumores\nde que SUICUNE\festá en TORRE\nQUEMADA, así\fque he venido\na mirar. ¿Pero\vdónde puede\festar exactamente?\n",
  ["BurnedTower1FEusineText"] = "EUSINE: He oído rumores\nde que SUICUNE está\fen TORRE QUEMADA,\nasí que he venido\va mirar. ¿Pero dónde\fpuede estar exactamente?\n",
  ["BurnedTower1FMortyText"] = "MORTI: El LÍDER de\nGIMNASIO de CIUDAD\fIRIS tenía que estudiar\nlo que se dice de\flos POKéMON legenda-\nrios: SUICUNE, ENTEI\fy RAIKOU. EUSINE\festá aquí, así que\nhe decidi- do\finvestigar la\nTORRE con él.",
  ["BurnedTowerB1FEusineText"] = "EUSINE: También\nexcavé un hoyo aquí…\v¡Me quedé impresionado!\f¡SUICUNE salió\fcorriendo como\nun rayo, ante mis\vpropios ojos! Tras\vdiez años de perseguir\fa SUICUNE, por\nfin he podido verle.\f¡Estaba alucinado!\n¡{PLAYER}, todo\fte lo debo a ti!\f¡Gracias! He\noído que los\fPOKéMON legenda-\frios de CIUDAD\nIRIS probaron\fa ciertos humanos\npermitiéndoles\facercarse.\nVoy a seguir\fa SUICUNE.\n¡{PLAYER},\fnos veremos\nde nuevo!\f¡Adiós!",
  ["BurnedTowerRival_AfterText1"] = "…Bah, qué más da.\fNunca ibas a\ncapturar un\nPOKéMON legendario\nde todos modos.",
  ["BurnedTowerRival_BeforeText"] = "…… …… ……\f…Ah, eres tú.\fHe venido a buscar\nlos POKéMON legendarios\fque dicen que\nviven aquí.\f¡Pero aquí no hay nada!\f¿Nada después de\nhaber venido hasta\neste agujero?\f¡Ni hablar!\f¡Todo es culpa tuya!",
  ["BurnedTowerRival_LossText"] = "…¡Mmm!\fPor eso odio pelear\ncontra los inútiles.\fes una perdida\nde tiempo.",
  ["BurnedTowerRival_WinText"] = "…¡Mmm!\fPor eso odio pelear\ncontra los inútiles.\fNo asumas a nadie\nrecto.",
  ["BurnedTowerSignText"] = "TORRE QUEMADA\fDestruida por\nun misterioso\vincendio ¡Atención!\f¡Peligro!\n",
  ["CableClubFriendScript.FriendReadyText"] = "Tu amigo\nestá preparado.",
  ["CameraGrunt1BeatenText"] = "¡Vaya…! Fallé…",
  ["CameraGrunt1SeenText"] = "¡Oye! ¿Y tú cómo has\nentrado aquí?",
  ["CameraGrunt2BeatenText"] = "En las estatuas de los\nPOKéMON hay cámaras\vde vigilancia. Seguiremos\fapareciendo hasta\nque pulses un botón\vsecreto.",
  ["CameraGrunt2SeenText"] = "¡Me toca a mí! ¡No\npuedes huir!",
  ["CamperBarryAfterText"] = "¡Eh, tú! ¿No\nera bueno mi\vdisfraz?",
  ["CamperBarryBeatenText"] = "¿A que era bueno\nmi disfraz?",
  ["CamperBarryBeforeText"] = "¡Uajajaja! Acertaste,\fjoven. ¡Yo soy\nSACHIKO!",
  ["CamperDeanAfterBattleText"] = "Hirieron a mis POKéMON\nantes de entrar\fal TÚNEL ROCA.\nSerá mejor que\flos lleve ahora\nmismo a un CENTRO\vPOKéMON.",
  ["CamperDeanBeatenText"] = "¡Uau! Peligro.",
  ["CamperElliotAfterBattleText"] = "Me humillaste\ndelante de\vmi novia…",
  ["CamperElliotBeatenText"] = "Ojalá hubieras\nperdido tú…",
  ["CamperElliotSeenText"] = "Le voy a demostrar\na mi novia lo bueno\vque soy.",
  ["CamperIvanAfterBattleText"] = "La música de la radio\ncambia el ánimo de los\vPOKéMON salvajes.",
  ["CamperJerryAfterBattleText"] = "¡Eh, tú! ¡Joven\nde JOHTO! BROCK\ves muy duro.\fTe castigará\nsi no le\ftomas en\nserio.",
  ["CamperJerryBeatenText"] = "Tengo que ganar\nestos combates…",
  ["CamperJerrySeenText"] = "Los entrenadores\nde este GIMNASIO\vusan POKéMON roca.\fÉstos tienen mayor\nDEFENSA. Los combates\fpueden durar\nmucho rato. ¿Te\fsientes con\nfuerzas?",
  ["CamperLloydAfterBattleText"] = "Hice lo que pude.\nNo me arrepiento.",
  ["CamperLloydSeenText"] = "Yo soy el quinto.\n¡Te machacaré!",
  ["CamperRolandAfterText"] = "Si no quieres luchar,\nevita el contacto\vvisual.",
  ["CamperRolandBeatenText"] = "¡Mmmm! ¡Qué\ndecepción!",
  ["CamperRolandSeenText"] = "Esa mirada…\nMe intriga.",
  ["CamperSidAfterBattleText"] = "Perdón. No estabas\ntirando basura. Me\vhe equivocado.",
  ["CamperSidBeatenText"] = "Sólo estaba diciendo\nque…",
  ["CamperSidSeenText"] = "¡Eh, tú! ¡No tires\nbasura!",
  ["CamperSpencerAfterBattleText"] = "¿Qué ocurre en el\nLAGO DE LA FURIA?\fTeníamos pensado\nacampar aquí.",
  ["CamperSpencerBeatenText"] = "Perder no es nada\ndivertido…",
  ["CamperSpencerSeenText"] = "Puedo hacer muchas cosas\ncon mis POKéMON. ¡Es\vmuy divertido!",
  ["CamperTedAfterBattleText"] = "Hice lo que pude pero\nno sirvió. No hay\fexcusa que valga.\nHe perdido.",
  ["CamperTedSeenText"] = "¡Yo también entreno\nPOKéMON! ¿Quieres\fluchar contra\nmí?",
  ["CamperTodd1AfterText"] = "Quizá deba llevar\na un POKéMON a la\vGUARDERÍA, o quizá\vusar objetos…",
  ["CamperTodd1BeatenText"] = "¿He fallado en mi\nentrenamiento?",
  ["CamperTodd1SeenText"] = "Confío en mi capacidad\npara criar POKéMON.\v¿Quieres\fverlo?",
  ["CarefulSwimmingSignText"] = "Por favor, ten cuidado\nsi vas nadando\vhasta las ISLAS\vESPUMA POLICÍA\fC. FUCSIA",
  ["CatchingTutorialBoxFullText"] = "Los POKéMON se esconden\nen la hierba.\fNadie sabe cuándo\nsalen…",
  ["CatchingTutorialDebriefText"] = "Así es como se hace.\nSi los POKéMON\festán débiles,\nson más fáciles\vde atrapar.",
  ["CatchingTutorialDeclinedText"] = "¡Ah! ¡Muy bien!\fPero si quieres\natrapar POKéMON,\ftendrás que caminar\nmucho.",
  ["CatchingTutorialIntroText"] = "Te he visto un\npar de veces. ¿Cuántos\fPOKéMON has cogido?\n¿Quieres que\fte enseñe cómo\natrapar POKéMON?\v",
  ["CatchingTutorialRepeatText"] = "¿Qué? ¿Quieres que\nte enseñe a atrapar\vPOKéMON?",
  ["CeladonCityDeptStoreSignText"] = "¡Encuentra lo que necesitas\nen el CENTRO COMERCIAL\vde CIUDAD AZULONA!",
  ["CeladonCityFisherText"] = "Este POLIWRATH es mi\ncompañero. Me pregunto\fsi algún día evolucionará\nen una rana\vPOKéMON.",
  ["CeladonCityGameCornerSignText"] = "CASINO DE CIUDAD\nAZULONA: Zona de\vjuego para todos",
  ["CeladonCityGramps1Text"] = "Últimamente han\naparecido GRIMER.\f¿Ves esa charca\nque hay delante\fde la casa? Ahí\nviven GRIMER. ¿De\fdónde han venido?\nEs un grave\vproblema…",
  ["CeladonCityGramps2Text"] = "¡Bravo! ¡Este\nGIMNASIO es genial!\f¡Es sólo para\nchicas!",
  ["CeladonCityLassText"] = "Mirar al suelo\nmientras\fcamino me\nmarea.",
  ["CeladonCityLassText_Mobile"] = "¡Me encanta estar\nrodeada de grandes\vedificios! ¿No\fes cierto que\nel CENTRO POKéMON\fde TRIGAL es\nahora mucho más\vgrande? ¡Está\ftan cuidado!\nOjalá tuviéramos\vun lugar\figual en\nKANTO…",
  ["CeladonCityMansionSignText"] = "MANSIÓN AZULONA",
  ["CeladonCitySignText"] = "CIUDAD AZULONA La\fciudad de los sueños\nde arco iris",
  ["CeladonCityTeacher1Text"] = "Volví a perder en\nlas tragaperras.\fLas chicas también\njugamos a las tragaperras.\fPrueba tú\ntambién.",
  ["CeladonCityTeacher2Text"] = "El C. COMERCIAL de\nCIUDAD AZULONA dispone\fde los mejores artículos.\nSi no encuentras\falgo aquí, no\nlo encontrarás\fen ningún otro\nsitio. ¡Vaya…!\fParezco una\nvendedora.",
  ["CeladonCityTrainerTipsText"] = "PISTAS ENTRENADOR\fPROTEC. ESP protege\na los POKéMON de\fATAQUES ESPECIALES\ncomo fuego y agua.\v¡Consigue los objetos\fen el CENTRO COMERCIAL\nde CIUDAD\vAZULONA!",
  ["CeladonCityYoungster1Text"] = "¿Te cuento un secreto?\nLa MANSIÓN AZULONA\ftiene una puerta\ntrasera secreta.\v",
  ["CeladonCityYoungster2Text"] = "Hay un concurso\nde tragones en\vel restaurante.\fSólo verlo hace\nque me sienta\vlleno…",
  ["CeladonDeptStore1FDirectoryText"] = "PB: INFORMACIÓN\nP1: TIENDA\fDE     ENTRENADORES\nP2: TIENDA\fDE MT P3:\fREGALOS\fP4: FARMACIA\fP5: AZOTEA\n",
  ["CeladonDeptStore1FGentlemanText"] = "Este C. COMERCIAL\npertenece a la misma\fcadena que el\nde C. TRIGAL.\fLos dos fueron\nrenovados al mismo\vtiempo.",
  ["CeladonDeptStore1FReceptionistText"] = "¡Hola! ¡Éste es el\nCENTRO COMERCIAL\vde CIUDAD AZULONA!\fEl directorio está\nen la pared.",
  ["CeladonDeptStore1FTeacherText"] = "Es la primera\nvez que vengo.\fEs muy grande…\fMe da miedo\nperderme.",
  ["CeladonDeptStore2FDirectoryText"] = "¡Objetos de máxima calidad\npara entrenadores!\fP1: TIENDA DE\n  ENTRENADORES",
  ["CeladonDeptStore2FPokefanMText"] = "Hace poco que soy\nentrenador. Mi hijo\fme animó a serlo.\nEstoy impresionado\fpor la cantidad\nde objetos útiles\vque hay.",
  ["CeladonDeptStore2FYoungsterText"] = "A mi padre le está\ncostando aprender\flos nombres de los\nobjetos y cómo se\fsupone que debe\nutilizarlos…",
  ["CeladonDeptStore3FDirectoryText"] = "P2: TIENDA DE MT\f¡Fortalece a\ntus POKéMON!",
  ["CeladonDeptStore3FGameboyKid1Text"] = "¡Oh, oh! Cambié\nmis POKéMON sin\fquitarles la\nMEJORA.",
  ["CeladonDeptStore3FGameboyKid2Text"] = "¡Sí! ¡Ya tengo un\nPORYGON! Se me dan\fmuy mal las tragaperras.\n¡Jamás ganaría\fbastantes fichas!\n¿Ehh…? ¡El PORYGON\fque he cambiado\fse ha convertido\nen otro POKéMON!\v",
  ["CeladonDeptStore3FSuperNerdText"] = "En la TIENDA DE MT hay\nmovimientos raros.",
  ["CeladonDeptStore3FYoungsterText"] = "No sé en qué\nPOKéMON debería\futilizar\nesta MT…",
  ["CeladonDeptStore4FDirectoryText"] = "¡Dilo con un\nregalo! P3:\fREGALOS",
  ["CeladonDeptStore4FSuperNerdText"] = "He venido a por\nuna CARTA SURF\vpara mi novia.",
  ["CeladonDeptStore4FYoungsterText"] = "Éste es el único\nlugar en el que\fencontrarás CARTAS\nAMOR.",
  ["CeladonDeptStore5FDirectoryText"] = "P4: FARMACIA",
  ["CeladonDeptStore5FGentlemanText"] = "Quiero comprar objetos\nque aumenten las\fhabilidades de mis\nPOKéMON. ¡Pero no\vtengo dinero!",
  ["CeladonDeptStore5FSailorText"] = "Quiero MÁS PP, para\naumentar los PP de\flos movi- mientos.\n¡Pero no se vende!",
  ["CeladonDeptStore5FTeacherText"] = "Si usas objetos en\ntus POKéMON, se pondrán\vcontentos. Aunque\fhay algunos que\nno les gustan.",
  ["CeladonDeptStore6FDirectoryText"] = "P5: AZOTEA EXPENDEDORAS\n",
  ["CeladonDeptStore6FSuperNerdText"] = "Una máquina expen-\ndedora con una\vruleta de premios…\fNunca verás\nnada igual.",
  ["CeladonDeptStore6FYoungsterText"] = "¡Auu! ¡Aquí no\nhay juegos! Quería\fjugar…",
  ["CeladonGameCornerFisherFullCoinCaseText"] = "Oye, tu MONEDERO\nestá lleno, joven.\fDebes de haber\nestado en\vracha.",
  ["CeladonGameCornerFisherNoCoinCaseText"] = "Oye, pero si no tienes\nMONEDERO. ¿Cómo\fpiensas que te\npuedo dar las fichas,\vjoven?",
  ["CeladonGameCornerFisherText1"] = "¡Muajajaja! ¡Las\ffichas no dejan\nde salir! ¿Mm?\f¿Qué? ¿Quieres\njugar? ¡Compartiré\fmi suerte\ncontigo!",
  ["CeladonGameCornerFisherText2"] = "¡Bien! ¡Me\fgusta hacer\nfavores\fa la gente!\n",
  ["CeladonGameCornerFishingGuruText"] = "Creo que esta máquina\nestá repleta de fichas…\vLas posibilidades\fde ganar varían según\nla máquina.",
  ["CeladonGameCornerGrampsText"] = "¡Mmm…! Seguro que\nla línea de PIKACHU\fes gana- dora.\n¿Qué hago?",
  ["CeladonGameCornerLighterText"] = "Aquí hay un\nencendedor.",
  ["CeladonGameCornerPokefanMText"] = "Todas las tragaperras\nson de última\vgeneración.",
  ["CeladonGameCornerPoster1Text"] = "¡Eh! Debajo\fde este póster…\n¡No hay\fnada!",
  ["CeladonGameCornerPoster2Text"] = "¡Eh! Debajo\fde este póster…\n¡No hay\fnada!",
  ["CeladonGameCornerPrizeRoomGentlemanText"] = "Quería un PORYGON,\npero sólo tenía\v100 fichas…",
  ["CeladonGameCornerPrizeRoomPharmacistText"] = "¡Uauu…! Debo permanecer\ftranquilo… No\npuedo perder\fla cabeza o lo\necharé todo\va perder…",
  ["CeladonGameCornerReceptionistText"] = "¡Hola! Al lado\fpuedes cambiar\ntus fichas por\ffabulosos\npremios.",
  ["CeladonGameCornerSodaCanText"] = "¡Un refresco!\nAlguien se lo\fhabrá dejado…\n¿Uh? ¡Está\fvacío!",
  ["CeladonGameCornerTeacherText"] = "Quiero jugar en\nesta máquina.\fAyer me desplumó,\nasí que hoy\fsol- tará las\nfichas.",
  ["CeladonGymGuideText"] = "¡Eh! ¡FUTURO\nCAMPEÓN!\f¿También juegas en\nlas máquinas?\fEstoy intentando\nreunir monedas\vpara conseguir un\nPOKéMON como premio.\fPero aún no tengo…",
  ["CeladonGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vAZULONA: ERIKA La\fprincesa amante de\nla naturaleza",
  ["CeladonMansion2FComputerText"] = "{PLAYER} encendió\nel PC. … Alguien\festaba escribiendo\fun e-mail. Espero\nque vengas\va KANTO. Te\fsorprenderás\nde cuánto han\fcambiado las\ncosas por\faquí. También\nverás muchos\fPOKéMON que\nno son nativos\fde JOHTO.\nAl PRODUCTOR\f…\f",
  ["CeladonMansion2FMeetingRoomSignText"] = "SALA DE REUNIONES\nDE GAME FREAK",
  ["CeladonMansion3FDevRoomSignText"] = "SALA DE DESARROLLO\nDE GAME FREAK",
  ["CeladonMansion3FDrawingText"] = "Es un dibujo detallado\nde una chica\vguapa.",
  ["CeladonMansion3FGameProgramText"] = "Es el programa del\njuego. ¡No lo toques!\f¡Podrías estropearlo!\n",
  ["CeladonMansion3FReferenceMaterialText"] = "Está lleno de material\nde referencia:\vhasta un #\vMUÑECO.",
  ["CeladonMansionManagerText"] = "Mis queridos POKéMON\nme hacen compañía,\fasí que nunca estoy\nsola. MEOWTH\fhasta trae dinero\na casa.",
  ["CeladonMansionManagersSuiteSignText"] = "DESPACHO DEL JEFE DE\nMANSIÓN AZULONA",
  ["CeladonMansionRoofFisherText"] = "Las alturas… ¡me\ngustan tanto…! ¡Me\fatrevería a decir\nque la única cosa\fque ama las alturas\ncomo yo es\vel humo!",
  ["CeladonMansionRoofGraffitiText"] = "Hay un graffiti\nen la pared… ¡{PLAYER}\fañadió un\nbigote!",
  ["CeladonMansionRoofHousePharmacistCurseText"] = "MT03 es MALDICIÓN.\fEs un movimiento terrible\nque redu- ce poco\fa poco los PS de\nla víctima.",
  ["CeladonMansionRoofHousePharmacistIntroText"] = "Te contaré una historia\nde miedo.",
  ["CeladonMansionRoofHousePharmacistNotNightText"] = "Pero no te dará\ntanto miedo si\faún es de día.\nVuelve cuando\fanochezca,\n¿vale?",
  ["CeladonMansionRoofHousePharmacistStoryText"] = "Érase una vez un\nniño pequeño al\fque le regalaron\nuna BICICLETA…\fQuería probarla\nenseguida… Se lo\festaba pasando\ntan bien que olvidó\fque anochecía…\nDe vuelta a casa,\fen plena noche,\n¡la bici empezó\fa frenarse! ¡Cada\nvez era más difícil\fpedalear! Y cuando\ndejó de pedalear,\f¡la bici empezó\na moverse hacia\fatrás! Era como\nsi la bici tuviera\fvida y quisiera\nllevár- selo\fcon ella. …\n<……> (¡CHILLIDO!)\f¡Y el niño siguió\fsubiendo por\fel CAMINO de\fBICIS! ¡Ba-dum!\n¡Ba-dum, ba-dum!\vPor haberme\fescuchado,\n¡aquí\ftienes\nesta MT03!\v",
  ["CeladonPokecenter1FCooltrainerFText"] = "ERIKA es experta\nen POKéMON planta.\fSi no tienes\ncuidado, acabará\vcontigo.",
  ["CeladonPokecenter1FPharmacistText"] = "El equipo cohete\nestá escondido en su ático\nCASINO. Esperar.\feso fue todo\ntres años.",
  ["CeladonPrizeRoom_AskWhichPrizeText"] = "¿Qué premio\nquieres?",
  ["CeladonPrizeRoom_ComeAgainText"] = "¡Vuelve cuando\ntengas fichas!",
  ["CeladonPrizeRoom_HereYouGoText"] = "¡Aquí tienes!",
  ["CeladonPrizeRoom_NoCoinCaseText"] = "¡Vaya! No tienes\nMONEDERO.",
  ["CeladonPrizeRoom_NotEnoughCoinsText"] = "No tienes bastantes\nfichas.",
  ["CeladonPrizeRoom_NotEnoughRoomText"] = "No tienes espacio\nsuficiente.",
  ["CeladonPrizeRoom_PrizeVendorIntroText"] = "¡Hola! ¡Aquí te\fcambiamos tus fichas\npor premios\vfabulosos!",
  ["CeladonVendingNoMoneyText"] = "¡Uups, no tienes bastantes\nfichas!",
  ["CeladonVendingNoSpaceText"] = "No hay sitio para\nnada más…",
  ["CeladonVendingText"] = "¡Una máquina\nexpendedora!",
  ["CelebrityText1"] = "¡Pues vaya! Me encontraste.\nPor favor, no\fse lo digas a\nnadie. Te daré\festo si me guardas\nel secreto.\v¿Vale?",
  ["CelebrityText2"] = "Es muy duro ser\nfamoso. Todo el\fmundo me persigue.\nSólo quiero\fque me dejen\nen paz…",
  ["CeruleanBikeShopSignText"] = "Aquí hay una nota…\nLa TIENDA DE\fBICIS se ha trasladado\na CIUDAD\vTRIGAL, en\vJOHTO…",
  ["CeruleanCapeSignText"] = "Hacia el CABO\nCELESTE",
  ["CeruleanCityCooltrainerFText1"] = "¡Mi SLOWBRO y yo\nformamos un equipo\vimpresionante!",
  ["CeruleanCityCooltrainerFText2"] = "¡SLOWBRO, enséñame\ntu CONFUSIÓN!",
  ["CeruleanCityCooltrainerMText1"] = "¿La CENTRAL ENERGÍA de\nKANTO? Está al final de\fla RUTA 9, el camino que\nhay al este de aquí. Creo\fque hubo algún tipo\nde accidente allí.",
  ["CeruleanCityCooltrainerMText2"] = "¿Vas a atrapar\ntodos los tipos\vde POKéMON? Parece\fun gran desafío,\npero será divertido.\v",
  ["CeruleanCityFisherRocketTipText"] = "Vi a ese tipo sospechoso\nde camino al CABO de\vCIUDAD CELESTE.",
  ["CeruleanCityFisherText"] = "Soy un gran segui- dor de\nMISTY, la LÍDER de GIMNASIO\vde CIUDAD CELESTE.",
  ["CeruleanCitySignText"] = "CIUDAD CELESTE Una\fmisteriosa aura azulada\nla rodea",
  ["CeruleanCitySuperNerdText"] = "El CABO que está al\nnorte es ideal para\funa cita a ciegas.\n¡Es tan romántico!",
  ["CeruleanCityYoungsterText1"] = "Antes había una\ncueva aquí que\ftenía POKéMON\nrealmente\vfuertes.",
  ["CeruleanCityYoungsterText2"] = "¡Caray! Mi BUSCAOBJETOS\fresponde…\n",
  ["CeruleanGymBadgeSpeechHousePokefanMText"] = "¿Coleccionas las MEDALLAS\nDE KANTO?",
  ["CeruleanGymGruntBigMistakeText"] = "¡Oh, no! ¡Tú verme!\n¡Yo cometer\vgran error!",
  ["CeruleanGymGruntByeText"] = "¡Oye! Tú olvidar\nque me has visto,\f¿vale? Tú ver, oír\ny saber nada, ¿de\facuerdo? ¡Adiós,\njoven! ¡Hasta\fla vista!",
  ["CeruleanGymGruntIntroText"] = "¡Uups! ¡Yo sentir!\nTú no hacer daño,\v¿de acuerdo? Yo\fmuy ocupado. No\ntener tiempo para\vhablar contigo.\vNo poder verme\vnadie.",
  ["CeruleanGymGuideText"] = "¡Eh, futuro\nCAMPEÓN!\fComo MISTY se ha\nido, ¡yo también\nvoy a divertirme!\fJe, je, je.",
  ["CeruleanGymGuideWinText"] = "¡Guau, has demostrado\nlo fuerte que eres!\fComo siempre, ha sido\nun gran\vcombate.",
  ["CeruleanPokecenter1FGymGuideText"] = "El MAGNETOTREN\nsupera los 540 km/h. ir de\nKANTO a JOHTO en muy poco tiempo.\festo es sobre\nJOHTO para ti.",
  ["CeruleanGymNote2Text"] = "Como MISTY ha salido, nosotros\ntampoco estaremos.\vLos ENTRENADORES",
  ["CeruleanGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vCELESTE: MISTY\fLa sirena poco\nfemenina",
  ["CeruleanLockedDoorText"] = "Está cerrado…",
  ["CeruleanMart_CooltrainerFText"] = "MISTY es casi la única\npersona de la ciudad\fcapaz de vencer a\nlos ENTRENADORES\vde CABO CELESTE.",
  ["CeruleanMart_CooltrainerMText"] = "Encontrarás muchos\nentrenadores de\fcamino hacia CABO\nCELESTE. Quieren\fsaber cómo son\nen comparación\fcon otros entrenadores.\n",
  ["CeruleanPokecenter1FGymGuideText"] = "El MAGNETOTREN\nsupera los 540 km/h. ir de\nKANTO a JOHTO en muy poco tiempo.\festo es sobre\nJOHTO para ti.",
  ["CeruleanPokecenter1FSuperNerdText"] = "En los combates\nyo prefiero usar\vPOKéMON que he\ventrenado, aunque\fsean más débiles\nque los POKéMON\frecién capturados.\n",
  ["CeruleanPokecenter1FSuperNerdText_Mobile"] = "¿Combates por teléfono\nmóvil? Si el tiempo\fse acaba durante\nla lucha, la espera\fpara ver al ganador\nes desesperante.\v",
  ["CeruleanPoliceSignText"] = "Aquí hay una nota…\n¡Acaba con los\fladrones y haz\nque la ciudad sea\fmás grata y alegre!\nPOLICÍA C.\fCELESTE",
  ["CeruleanPoliceStationFishingGuruText"] = "Dicen que hay\nun tipo sospechoso\vmerodeando. Si\fresulta ser\nel ladrón, le\vdetendré.",
  ["CeruleanPoliceStationPokefanFText"] = "Ya nos atracaron\nantes.",
  ["CeruleanTradeSpeechHouseGrampsText"] = "Soy tan feliz…",
  ["CeruleanTradeSpeechHouseGrannyText"] = "Mi marido vive\nfeliz con los POKéMON\vque ha intercambiado.\v",
  ["CharcoalKilnApprenticeText1"] = "¿Adónde han ido\nlos SLOWPOKE?\f¿Están jugando\nfuera?",
  ["CharcoalKilnApprenticeText2"] = "Lo siento. Olvidé\ndarte las gracias.\fÉste es el CARBÓN\nque he fabricado.\fA los POKéMON de\nfuego les gustará\vllevarlo.",
  ["CharcoalKilnApprenticeText3"] = "Los SLOWPOKE han\nvuelto, hasta\vFARFETCH'D. ¡Eres\flo mejor, de\nverdad!",
  ["CharcoalKilnBossText1"] = "Todos los SLOWPOKE\ndel pueblo han desaparecido.\vQuizá el guardián\fdel ENCINAR esté\nenfadado… Puede\vser un mal\fpresagio. Será\nmejor no\vsalir.",
  ["CharcoalKilnBossText2"] = "Los SLOWPOKE han\nvuelto… Pero mi\fAPRENDIZ no ha\nvuelto del ENCINAR.\v¿Dónde demonios\festá ese\nvago?",
  ["CharcoalKilnBossText3"] = "¿Expulsaste al\nTEAM ROCKET y fuiste\fsolo al ENCINAR?\n¡Qué valiente!\fMe gustas.\nEntrena con\vnosotros.",
  ["CharcoalKilnSignText"] = "CASA DEL CARBONERO",
  ["ChefText_Eatathon"] = "¡Hola! Estamos celebrando un concurso de tragones.\nLo siento. Ahora no podemos\natenderte.",
  ["CherrygroveCitySignText"] = "CIUDAD CEREZO La\nciudad de las\fflores bonitas\ny fragantes",
  ["CherrygroveEvolutionSpeechHouseLassText"] = "¿Se transforman?\f¡Alucinaría si\nlo viera!",
  ["CherrygroveEvolutionSpeechHouseYoungsterText"] = "Luchando, los POKéMON\nganan experiencia\fy se transforman.\n",
  ["CherrygroveGymSpeechHouseBugCatcherText"] = "¡Cuando sea mayor,\nvoy a ser un LÍDER\vde GIMNASIO! ¡Hago\fluchar a mis POKéMON\ncontra los de mi\famigo para fortalecerlos!\n",
  ["CherrygroveGymSpeechHousePokefanMText"] = "¿Quieres saber\nsi vales o no\fcon los POKéMON?\nPues vete a los\fGIMNASIOS POKéMON\nde JOHTO y\fgana muchas\nMEDALLAS.",
  ["CherrygroveMartCooltrainerMText"] = "¡Se han quedado\nsin POKé BALL!\f¿Cuándo conseguirán\nmás?",
  ["CherrygroveMartCooltrainerMText_PokeBallsInStock"] = "¡Tengo POKé BALL de\nreserva! ¡Puedo atrapar\vPOKéMON!",
  ["CherrygroveMartYoungsterText"] = "Cuando iba por la\nhierba, un POKéMON\fbicho envenenó a\nmis POKéMON. Yo seguí\fandando, pero mi\nPOKéMON se debilitó.\vDeberías llevar\fun ANTÍDOTO\ncontigo.",
  ["CherrygrovePokecenter1FFisherText"] = "¡Es genial! Puedo\nguardar a todos los\fPOKéMON que quiera,\n¡y gratis!",
  ["CherrygrovePokecenter1FGentlemanText"] = "Ese PC puede ser\nusado por todo\ventrenador.",
  ["CherrygrovePokecenter1FTeacherText"] = "Se construyó un CENTRO\nde COMUNICACIÓN\vaquí arriba. Pero\ftodavía lo están\nterminando.",
  ["CherrygrovePokecenter1FTeacherText_CommCenterOpen"] = "Se construyó un CENTRO\nde COMUNICACIÓN\vaquí arriba. ¡Ya\fintercambié POKéMON\nen él!",
  ["CherrygroveRivalText_Seen"] = "<……> <……> <……> Tienes\fun POKéMON en el\nLABORATORIO. Qué\fdesperdicio. Alguien\ncomo tú. <……> <……>\f<……> ¿No escuchas\flo que te digo?\nBueno, yo también\ftengo un buen\nPOKéMON. ¡Te\fenseñaré de lo\nque hablo!",
  ["CherrygroveRivalText_YouLost"] = "<……> <……> <……>\fMe llamo ¿¿??.\fVoy a ser el\nmejor entrenador\vde POKéMON\vdel mundo.",
  ["CherrygroveRivalText_YouWon"] = "<……> <……> <……>\fMe llamo ¿¿??.\fVoy a ser el\nmayor entrenador\vde POKéMON\vdel mundo.",
  ["CherrygroveTeacherText_HaveMapCard"] = "Cuando vas con los\nPOKéMON, cualquier\vsitio está bien.",
  ["CherrygroveTeacherText_NoMapCard"] = "¿Has hablado con el\nanciano que está cerca\vdel CENTRO POKéMON?\fTe dará un MAPA\nde JOHTO para\vtu POKéGEAR.",
  ["CherrygroveYoungsterText_HavePokedex"] = "He luchado contra\nlos entrenadores\vdel camino. Mis POKéMON\fhan perdido. ¡Están\nfatal! Los llevaré\fal CENTRO\nPOKéMON.",
  ["CherrygroveYoungsterText_NoPokedex"] = "La casa del SR.\nPOKéMON está más\vadelante.",
  ["ChoseStarterText"] = "ELM: ¡Yo también\ncreo que es un POKéMON\vgenial!",
  ["ChuckAfterText"] = "¡UAJAJAA! ¡Ha sido\nmuy divertido! ¡Pero\funa derrota es una\nderrota! ¡Desde\fahora, voy a entrenarme\n24 horas\val día!",
  ["ChuckExplainBadgeText"] = "Con MED. TORMENTA,\nte obedecerán los\fPOKéMON hasta\nel nivel 70. Y\fpermitirá a tus\nPOKéMON usar\fVUELO cuando\nno estén luchando.\f¡Toma esto\ntambién!",
  ["ChuckExplainTMText"] = "Se trata de PUÑODINÁMICO.\n¡No siempre\fgolpea pero\ncuando lo hace\fproduce confusión!\n",
  ["ChuckIntroText1"] = "¡UAUUUU! ¡Has llegado\fhasta aquí! ¡Que\nsepas que soy\fmuy fuerte! ¡Mis\nPOKéMON aplastarán\fpiedras y\nromperán huesos!\v¡Atención!\f",
  ["ChuckIntroText2"] = "ANÍBAL: ¡Urgg!\n¡Urgg…! ¡Oooarrg!\f",
  ["ChuckIntroText3"] = "¿Qué? Ahora tienes\nmiedo, ¿no? ¿Qué?\f¿No tiene nada\nque ver con\flos POKéMON?\n¡Es cierto!\fVenga. ¡Luchemos!\n",
  ["ChuckLossText"] = "¿Qué? ¿Cómo? ¿He\nperdido? ¡Muy\fbien! ¡Te mereces\nla MEDALLA\vTORMENTA!",
  ["ChucksWifeBeatChuckText"] = "Pero no puedes usar\nVUELO sin la MEDALLA\vde esta ciudad.\fSi vences al LÍDER\nde este GIMNASIO,\vven a verme.\fTe daré un bonito\nregalo.",
  ["ChucksWifeChubbyText"] = "Mi marido perdió\ncontra ti. Debería\ventrenarse más.\fMenos mal, porque\nya estaba engordando.\v",
  ["ChucksWifeEasierToFlyText"] = "¿Has cruzado el\nmar para llegar\fhasta aquí? ¡Habrá\nsido duro! Todo\fsería mucho más\nfácil si tus\fPOKéMON supieran\nVUELO…",
  ["ChucksWifeFlySpeechText"] = "Enseña VUELO a\ntus POKéMON. En\fun instante podrás\nVOLAR a cualquier\flugar al\nque ya hayas\vido.",
  ["ChucksWifeGiveHMText"] = "¡Es la MEDALLA\nde CIUDAD ORQUÍDEA!\f¡Toma esta\nMO!",
  ["CianwoodCityLassText"] = "ANÍBAL, el LÍDER\ndel GIMNASIO, pelea\fcon sus POKéMON\nde lucha.",
  ["CianwoodCityPokefanMText"] = "Las piedras del\nnorte del pueblo\vse pueden romper.\fQuizá escondan\nalgo. Tus POKéMON\fpueden usar el\nGOLPE ROCA para\vromperlas.",
  ["CianwoodCitySignText"] = "CIUDAD ORQUÍDEA Un\fpuerto rodeado de\nagitadas aguas",
  ["CianwoodCityUnusedText"] = "De aquí a CIUDAD\nOLIVO hay varias\vislas. Dicen que\fahí vive una\ncriatura mítica\vmarina.",
  ["CianwoodCityYoungsterText"] = "Si usas VUELO,\npodrás volver\fa CIUDAD OLIVO\nenseguida.",
  ["CianwoodGymGuideText"] = "Los entrenadores del\nGIMNASIO de aquí son\vunos brutos.\fSi me quedo aquí,\npueden venir\va por mí.\fUn consejo: el\nLÍDER del\fGIMNASIO usa\nPOKéMON de tipo\nlucha.\fConfúndelos con\nPOKéMON\vpsíquicos.\fAcaba con ellos\nantes de que usen\nsu fuerza física.",
  ["CianwoodGymGuideWinText"] = "¡{PLAYER}! ¡Has\nganado! ¡Se te nota\ven la cara!",
  ["CianwoodGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\fORQUÍDEA: ANÍBAL\fSus puños hablan\npor él",
  ["CianwoodLugiaSpeechHouseLassText"] = "Dicen que sólo\npuedes verla si\ftienes un ALA PLATEADA.\nDebe de tener\fla misma esencia\nque la criatura.\v",
  ["CianwoodLugiaSpeechHouseTeacherText"] = "¿Vienes de CIUDAD\nOLIVO? ¿Te acuerdas\fde las cuatro\nislas del camino?\vDicen que en\fellas se esconde\nuna mítica\vcriatura\vmarina.",
  ["CianwoodLugiaSpeechHouseTwinText"] = "He oído que los remolinos que hay alrededor\nde las islas son causados por una criatura\fmarina. Necesitarás una habilidad\nespecial para sortearlos.",
  ["CianwoodPharmacySignText"] = "500 años de\ntradición FARMACIA\fDE CIUDAD\nORQUÍDEA\fAceptamos\npedidos",
  ["CianwoodPhotoStudioFishingGuruText_No"] = "¡Oh! ¡Qué mal!\nPensaba que sería\fun maravilloso\nrecuerdo…",
  ["CianwoodPhotoStudioFishingGuruText_Question"] = "Tienes unos #-\nMON magníficos.\v¿Quieres una\ffoto de recuerdo?\n",
  ["CianwoodPhotoStudioFishingGuruText_Yes"] = "¡Vale! ¡Sonríe!",
  ["CianwoodPhotoStudioSignText"] = "ESTUD. FOTOGRÁFICO\nDE CIUDAD ORQUÍDEA\f¡Hazte una foto\nde recuerdo!",
  ["CianwoodPokecenter1FLassText"] = "¿Conoces al\n#MANÍACO? Siempre\festá presumiendo\nde sus raros\vPOKéMON.\v",
  ["CianwoodPokecenter1FSuperNerdText"] = "Me encanta fardar\nde los POKéMON\fque he mejorado.\n¿A ti no? ¡Voy\fa enfrentarme\na otros entrenado-\fres para mostrar\nmis POKéMON!\v",
  ["CianwoodPokecenter1FUnusedText1"] = "¿No te gusta mos-\ntrar tus POKéMON\fa tus amigos?\nOjalá pudiera\fmostrarle mis\nPOKéMON a mi\famigo que vive\nen MALVA.",
  ["CianwoodPokecenter1FUnusedText2"] = "He luchado con\nmi amigo de MALVA\fusando un ADAPTA-\nDOR de MÓVIL.\fVoy perdiendo\n5 a 7 contra\vél. ¡Tengo\vque ganar!",
  ["CinnabarGymSignText"] = "¿Qué pone en este\nletrero? LÍDER DEL\fGIMNASIO de ISLA\nCANELA: BLAINE",
  ["CinnabarIslandBlueText"] = "¿Quién eres tú?\fEs evidente que\nentrenas POKéMON…\vMe llamo AZUL.\fY una vez fui el\fCAMPEÓN, pero sólo\ndurante poco tiempo…\fEl entrometido\nde ROJO me ganó…\f¡Pero qué más da!\n¿Y tú qué quieres?\f¿Has venido a\ndesafiarme? Lo\fsiento, pero no,\nahora no tengo\fganas de luchar.\nEcha un vistazo\fa tu alrededor…\nUn volcán entra\fen erupción y\nuna ciudad entera\fdesaparece. En\nPOKéMON se puede\fganar o perder,\npero si se tuercen\flas cosas se\npuede perder\fenseguida. …\nAsí son las cosas…\fSin embargo,\nsigo siendo\fentrenador.\fY encontrarme\ncon un rival\ffuerte me anima\na luchar. Si\fquieres luchar\ncontra mí,\vven al GIMNASIO\fde la CIUDAD\nVERDE. Y\vaceptaré\ftu desafío…\n",
  ["CinnabarIslandGymSignText"] = "Aquí hay una\nnota… El GIMNASIO\fDE ISLA CANELA\nse ha trasladado\va ISLAS\vESPUMA.\fBLAINE",
  ["CinnabarIslandSignText"] = "ISLA CANELA La abrasadora\fisla del ardiente\ndeseo",
  ["CinnabarPokecenter1FCooltrainerFText"] = "Parece que BLAINE,\ndel GIMNASIO de\fISLA CANELA,\nvive solo en\fla cueva de ISLAS\nESPUMA…",
  ["CinnabarPokecenter1FFisherText"] = "El volcán hizo\nerupción hace\vun año.",
  ["ClairIntroText"] = "Soy Débora. soja\nEl mejor maestro de dragones del mundo.\fpuedo enfrentarme a mi mismo\nhasta en el ALTO MANDO de la LIGA\nPOKÉMON. Todavía quieres enfrentarlo\na mi? Bueno… ¡Adelante!\fComo LÍDER\nde GIMNASIO, utilice todos\nmi fuerza contra mi\noponente!",
  ["ClairText_DescribeDragonbreathDragonDen"] = "Esta MT contiene\nDRAGOALIENTO. No,\fno tiene nada que\nver con mi aliento.\vSi no la quieres,\fno es necesario\nque la aceptes.\v",
  ["ClairText_GiveDragonbreathDragonDen"] = "DÉBORA: Siento\ntodo esto. Toma\festo en señal\nde disculpa.",
  ["ClairText_GoToDragonsDen"] = "Me niego a aceptarlo.\nHe podido perder,\fpero todavía\nno podrás con\fla LIGA POKéMON.\nYa sé. Deberías\fenfrentarte\nal desafío\vdragón. Tras\feste GIMNASIO\nexiste un\vlugar llamado\fGUARIDA DRAGÓN.\nHay un pequeño\fsantuario\nen su centro.\fVe allí.\n¡Si pruebas\ftu valía,\nreconoceré\fque te\nmereces\vla MEDALLA\vdel\fGIMNASIO!\n\v",
  ["ClairWinText"] = "¿He perdido? No\fpuedo creerlo. Ha\ndebido de haber\valgún error…",
  ["CoinVendor_Buy500CoinsText"] = "¡Gracias! Aquí tienes\n500 fichas.",
  ["CoinVendor_Buy50CoinsText"] = "¡Gracias! Aquí tienes\n50 fichas.",
  ["CoinVendor_CancelText"] = "¿No quieres fichas? Vuelve\ncuando quieras.",
  ["CoinVendor_CoinCaseFullText"] = "¡Uups! Tu MONEDERO\nestá lleno.",
  ["CoinVendor_IntroText"] = "¿Necesitas fichas\nde juego? 50\ffichas por 1000¥.\n¿Quieres\vcomprar?",
  ["CoinVendor_NoCoinCaseText"] = "¿Necesitas fichas\nde juego? ¡Oh!\fNo tienes un\nMONEDERO para\vtus fichas.",
  ["CoinVendor_NotEnoughMoneyText"] = "No tienes bastante\ndinero.",
  ["CoinVendor_WelcomeText"] = "Bienvenidos\nal CASINO.",
  ["ComeHomeForDSTText"] = "Vuelve a casa\npara cambiar\fde hora el reloj.\nPor cierto…\f¿Sabes cómo\nusar el TELÉFONO?\v",
  ["ContestResults_ConsolationPrizeText"] = "¡Todos los demás reciben\nuna BAYA como\vconsolación!",
  ["ContestResults_DidNotWinText"] = "A ver si mejoras\nla próxima vez.",
  ["ContestResults_JoinUsNextTimeText"] = "¡Participa en el próximo\nconcurso!",
  ["ContestResults_PartyFullText"] = "¡Equipo completo!\nEl POKéMON fue enviado a tu CAJA en\nLa computadora de BILL.",
  ["ContestResults_ReadyToJudgeText"] = "Vamos a evaluar\na tus POKéMON.\v<……> <……>\f¡Hemos\nelegido\fa los ganadores!\nAquí\fvan…\n",
  ["ContestResults_ReturnPartyText"] = "Aquí tienes los\nPOKéMON que\fte estábamos\ncuidando.",
  ["CooltrainerfBeth1BeatenText"] = "Los POKéMON\nno son armas\vde guerra.",
  ["CooltrainerfBeth1SeenText"] = "He perdido contra\n<RIVAL>. Era realmente\ffuerte, pero…\nParecía como\fsi tuviera que\nganar a toda\vcosta. Me dieron\fpena sus\nPOKéMON.",
  ["CooltrainerfBethAfterText"] = "Los POKéMON son valiosos\namigos para toda\vla vida.",
  ["CooltrainerfCarolAfterBattleText"] = "¡Te ganaré un\ndía de éstos!",
  ["CooltrainerfCarolBeatenText"] = "¿En qué somos tan\ndiferentes?",
  ["CooltrainerfCarolSeenText"] = "¡Me entreno para\nser la CAMPEONA!",
  ["CooltrainerfCybilAfterBattleText"] = "Todos mejoramos\nluchando muchas\vveces. He luchado\fmucho para llegar\na ser lo que\fsoy hoy: una\ncampeona.",
  ["CooltrainerfCybilBeatenText"] = "¡No! Esto no servirá\npara nada.",
  ["CooltrainerfCybilSeenText"] = "Pareces fuerte. Los\fbuenos entrenadores\nsiempre buscan buenos\vrivales.",
  ["CooltrainerfEmmaAfterBattleText"] = "Cada semana viene\nun POKéMON hasta\vla orilla. Quería\fver a ese\nPOKéMON…",
  ["CooltrainerfEmmaBeatenText"] = "¡Preferiría cuidar\nde mis niños!",
  ["CooltrainerfEmmaSeenText"] = "Si los POKéMON que\nMe gustó, estaba ahí, lo haría sin pensarlo.\feso seria bueno\nentrenador.",
  ["CooltrainerfFranAfterBattleText"] = "Oh, oh… DÉBORA se\nva a enfadar…",
  ["CooltrainerfFranBeatenText"] = "Auuuu… Perdí…",
  ["CooltrainerfFranSeenText"] = "¡No puedo permitir\nque alguien como\vtú pase de aquí!\f¡DÉBORA se enfa-\ndará si te dejo!",
  ["CooltrainerfGwenAfterBattleText"] = "Seguiré entrenándome\nhasta que\vmejore.",
  ["CooltrainerfGwenBeatenText"] = "No, eres demasiado\npara mí.",
  ["CooltrainerfGwenSeenText"] = "Estoy entrenando.\n¿Quieres luchar?",
  ["CooltrainerfIreneAfterText1"] = "MAR: ¡Mi hermana\nLISA te lo hará\vpagar!",
  ["CooltrainerfIreneAfterText2"] = "MAR: ¿No te parece\nuna playa genial?\f¡Es nuestro pequeño\nrefugio!",
  ["CooltrainerfIreneBeatenText"] = "MAR: ¡Ohhh! ¡Demasiado\nfuerte!",
  ["CooltrainerfIreneSeenText"] = "MAR: ¡Kiaaa! ¡Nos\nhan encontrado!",
  ["CooltrainerfJennAfterText1"] = "ILDA: ¡No te pases!\n¡Mi hermana LISA\ves fuerte!",
  ["CooltrainerfJennAfterText2"] = "ILDA: El sol\nfortalece tu\vcuerpo.",
  ["CooltrainerfJennBeatenText"] = "ILDA: ¡Lo siento\nmucho, MAR!",
  ["CooltrainerfJennSeenText"] = "ILDA: ¡No puedes\nvencer a MAR e\virte sin más!",
  ["CooltrainerfJoyceAfterBattleText"] = "Como había vencido\na ocho LÍDERES de\fGIMNASIO, me confié\ndemasiado. Tendré\fque esforzarme\nmás.",
  ["CooltrainerfJoyceBeatenText"] = "¡No! ¡No puedo\ncreerlo!",
  ["CooltrainerfJoyceSeenText"] = "Si has llegado tan\nlejos, debes de\vser el no va más.\f¡Voy a dar todo\nlo que tengo en\veste combate!",
  ["CooltrainerfKateAfterText"] = "LISA: Sentimos haberte\natacado. Pensábamos\fque aquí nadie\nnos encontraría.\f¡Nos has sorprendido!\n",
  ["CooltrainerfKateBeatenText"] = "LISA: ¡He perdido!\n¡Increíble!",
  ["CooltrainerfKateOfferSoftSandText"] = "LISA: Eres muy\nfuerte. No pude\vhacer nada.\fToma. Te lo\nmereces.",
  ["CooltrainerfKateSeenText"] = "LISA: ¡Seguro que te\nhas portado mal con\vmis hermanas!",
  ["CooltrainerfKellyAfterBattleText"] = "No soy partidaria\nde los ataques demasiado\vfuertes. Quiero\fganar, pero no\nquiero herir a\vlos POKéMON.",
  ["CooltrainerfKellySeenText"] = "¿Cuál es tu estrategia?\nEs de tontos usar\fmovimientos fuer-\ntes de forma indiscriminada.\v",
  ["CooltrainerfLoisAfterBattleText"] = "Pensándolo bien,\ncreo que vi un BUTTERFREE\vrosa.",
  ["CooltrainerfLoisSeenText"] = "¿Qué ocurrió con\nel GYARADOS rojo?\f¿Se ha ido? ¡Maldición!\f¿He venido\npara nada?\fYa sé. ¡Luchemos!\n",
  ["CooltrainerfLolaAfterBattleText"] = "Los dragones son débiles\ncontra los movimientos\vdel tipo dragón.",
  ["CooltrainerfLolaSeenText"] = "Los dragones son\nPOKéMON sagrados.\fEstán llenos de\nenergía vital.\fSi no mantienes\nla seriedad, no\fpodrás acabar\ncon ellos.",
  ["CooltrainerfMeganAfterBattleText"] = "Estoy investigando los\nPOKéMON antes y después\vde que evolucionen.\fLos POKéMON se hacen\nmás fuertes al evolucionar.\vPero aprenderán nuevos\fmovimientos mucho\nmás despacio\vque antes.",
  ["CooltrainerfMeganBeatenText"] = "¡Oh! ¡Eres muy\nfuerte!",
  ["CooltrainerfMeganSeenText"] = "Es raro que venga\nalguien por aquí.\f¿Te entrenas sin\ncompañía?",
  ["CooltrainerfQuinnAfterBattleText"] = "Eres fuerte. Seguro\fque te has entrenado\nmucho.",
  ["CooltrainerfQuinnSeenText"] = "¡Estás ahí! ¿Quieres\nluchar?",
  ["CooltrainerfReenaAfterBattleText"] = "Eres muy joven,\npero tampoco\fse te puede\nsubestimar.",
  ["CooltrainerfReenaBeatenText"] = "¡Oh! ¡Qué fuerte\neres!",
  ["CooltrainerfReenaSeenText"] = "No deberías subestimar\na los POKéMON\fsalvajes de\nesta zona.",
  ["CooltrainermAaronAfterBattleText"] = "Los POKéMON y su\nentrenador se hacen\fmás fuertes cuanto\nmás luchan.",
  ["CooltrainermAaronBeatenText"] = "¡Uauu…! Buen\ncombate.",
  ["CooltrainermAaronSeenText"] = "Si un entrenador\nse encuentra con\fotro entrenador,\ndebe desafiarle.\fÉse es nuestro\ndestino.",
  ["CooltrainermAllenAfterBattleText"] = "¡Uauu! Tienes muchas\nMEDALLAS. No me\fextraña que seas\ntan fuerte. Me pregunto\fsi MORTI, de GIMNASIO\nIRIS, estará\faún entrenándose.\nÉl sí que\fme dio una\npaliza.",
  ["CooltrainermAllenBeatenText"] = "¡Vaya! Ha sido una\nauténtica derrota.",
  ["CooltrainermAllenSeenText"] = "Con sólo mirarte\nsé cuál es tu nivel.\vYo soy bueno\fcon los POKéMON\ny veo que tú\vtambién.",
  ["CooltrainermBlakeAfterBattleText"] = "Si continúas por\neste duro camino,\f¡conocerás la\nverdad! Lo siento,\fpero me apetecía\ndecir algo\vchulo.",
  ["CooltrainermBlakeSeenText"] = "Pareces muy fuerte.\n¡Déjame luchar\vcontigo!",
  ["CooltrainermBrianAfterBattleText"] = "Un buen entrenador puede\nreconocer a otros buenos\ventrenadores.",
  ["CooltrainermBrianBeatenText"] = "¡Tal como pensaba!",
  ["CooltrainermBrianSeenText"] = "¿Mmm? Sabes cómo entrenar,\n¿verdad?",
  ["CooltrainermCodyAfterBattleText"] = "Los miembros del clan\nde los drago- nes sólo\fpueden usar POKéMON del\ntipo dragón si el MAESTRO\vse lo permite.",
  ["CooltrainermCodyBeatenText"] = "¡Maldición! ¡Ojalá\ntuviera un\vdragón!",
  ["CooltrainermGaven3BeatenText"] = "¡La vida es aún\nmás dura!",
  ["CooltrainermGaven3SeenText"] = "Es en estos duros\ncombates donde ganas\vmás poder.",
  ["CooltrainermGavenAfterText"] = "Para llegar a la\nLIGA POKéMON, hay\fque pasar por la\nCALLE VICTORIA.\fPero la CALLE\nVICTORIA es dura.\f¡No va allí\ncasi nadie!",
  ["CooltrainermJakeAfterBattleText"] = "Va a ser difícil\nganar en la LIGA.\vTengo que entre-\fnarme mucho más.\nDicen que el\fALTO MANDO es\nmás duro que\flos LÍDERES de\nGIMNASIO.",
  ["CooltrainermKevinAfterBattleText"] = "¡Ha sido fantástico!\nTus POKéMON\fy tú sois\nrealmente\vbuenos.",
  ["CooltrainermKevinBeatenText"] = "¡Nunca había visto\nnada igual!",
  ["CooltrainermKevinNuggetText"] = "Tuviste que luchar\nuna vez más,\fpero ganaste.\nComo te prometí,\fel premio\nes tuyo.",
  ["CooltrainermKevinSeenText"] = "Pero después de\nverte luchar, me\fgustaría saber\ncómo me iría a\fmí. Déjame luchar\ncontra ti.",
  ["CooltrainermMikeAfterBattleText"] = "Ahora sé cuál es\nmi punto débil.\f¡Gracias por\nenseñármelo!",
  ["CooltrainermMikeSeenText"] = "¿Mis posibilidades\nde perder? ¡Ni el\vuno por ciento!",
  ["CooltrainermNickAfterBattleText"] = "El estilo de\ntus POKéMON es\vsorprendente.\f¡Seguirás mejorando!\n",
  ["CooltrainermNickBeatenText"] = "¡Tu estilo es\ndeslumbrante!",
  ["CooltrainermPaulAfterBattleText"] = "¿LANCE te dijo\nque quería verte\vde nuevo? ¡Ni\fpor asomo!",
  ["CooltrainermPaulBeatenText"] = "¿Han perdido mis\nPOKéMON dragón?",
  ["CooltrainermPaulSeenText"] = "¿Tu primer combate\ncontra dragones?\f¡Te mostraré lo fuertes\nque son!",
  ["CooltrainermRyanAfterBattleText"] = "Veo que estás educando\na tus POKéMON con\vcariño. El vínculo\fque os une os salvará\nen las situaciones\vdifíciles.",
  ["CooltrainermRyanBeatenText"] = "Te has ganado\nmi respeto.",
  ["CooltrainermRyanSeenText"] = "¿Qué piensas sobre\nla educación de\vlos POKéMON?",
  ["CooltrainermSeanAfterBattleText"] = "Los entrenadores\nde JOHTO pueden\fluchar contra\nlos LÍDERES\vde KANTO.",
  ["CooltrainermSeanBeatenText"] = "¡Quería ganar!",
  ["CopycatText_ExplainPass"] = "COPIONA: Ése es el\nPASE para el MAGNETOTRÉN.\vLa empresa de ferrocarriles\fme lo dio cuando\nderribaron nuestra\fcasa para edificar\nla ESTACIÓN.\v",
  ["CopycatText_GiveDoll"] = "COPIONA: ¡Sí! ¡Ése\nes mi # MUÑECO CLEFAIRY!\v¿Ves el descosido\fque tiene en\nla pata derecha?\f¡Ésa es la\nprueba!",
  ["CopycatText_GivePass"] = "Está bien. ¡Aquí tienes\nel PASE del MAGNETOTRÉN\vque te prometí!",
  ["CopycatText_ItsAScream"] = "COPIONA: ¿Apuestas\nalgo? ¡Es genial!",
  ["CopycatText_Male_1"] = "{PLAYER}: ¿Te gustan\nlos POKéMON? {PLAYER}:\fNo, yo sólo preguntaba.\n{PLAYER}: ¿Eh?\f¡Qué rara\neres!",
  ["CopycatText_Male_2"] = "{PLAYER}: ¡Hola!\nOí que habías perdido\ftu # MUÑECO favorito.\n{PLAYER}: Si lo\fencuentro, ¿me\ndarás un PASE\vpara el tren?\f{PLAYER}: Iré\na buscarlo para\fti. ¿Crees que\nlo perdiste\ven CIUDAD\vCARMÍN?",
  ["CopycatText_Male_3"] = "{PLAYER}: ¡Hola! Muchas\ngracias por el PASE\vde tren. {PLAYER}:\f¿Perdona? {PLAYER}:\f¿Tanto te divierte\nimitar todo lo\vque hago?",
  ["CopycatText_QuickMimicking"] = "COPIONA: ¿Cómo?\n¿Que no imite? ¡Pero\fsi es mi hobby\nfavorito!",
  ["CopycatText_Worried"] = "COPIONA: ¿Perdona?\f¿No tendría que\ndecirte yo lo que\vdebes hacer? Estoy\fpreocupada. ¿Y\nsi alguien lo\vencuentra?",
  ["CopycatsDodrioText2"] = "Espejito, espeji-\nto… ¿Quién es\fla más guapa\nde todas?",
  ["CopycatsHouse1FPokefanFText"] = "mi hija es muy\nintrovertido… tengo muy pocos\namigos.",
  ["CopycatsHouse1FPokefanFText_ReturnedMachinePart"] = "Acaba de perder\nel # MUÑECO que\fle regaló un niño\nhace tres años.\fDesde entonces,\nimita a la gente\vmucho mejor…",
  ["CopycatsHouse1FPokefanMText"] = "mi hija\nLe gusta imitarnos.\nY por eso la llaman\nCOPIAR.",
  ["CopycatsHouse2FDollText"] = "¡Qué POKéMON\nmás raro! Es\fun muñeco…",
  ["CyclingRoadSignText"] = "CAMINO de BICIS\f¡Cuesta abajo\npor la costa!",
  ["DaisyAllDoneText"] = "DALIA: ¡Ya está!\n¡Listo! ¿Qué?\f¿Tiene buen aspecto\no no? ¡Qué\fPOKéMON más\nmono!",
  ["DaisyAlreadyGroomedText"] = "DALIA: Siempre\ntomo té a esta\fhora. Ven cuando\nquieras.",
  ["DaisyAlrightText"] = "DALIA: Vale, haré\nque mejore su aspecto\venseguida.",
  ["DaisyCantGroomEggText"] = "DALIA: Lo siento.\nNo puedo limpiar\vun HUEVO.",
  ["DaisyHelloText"] = "DALIA: ¡Hola! Mi\nhermano es LÍDER\fdel GIMNASIO de\nCIUDAD VERDE.\vPero sale tanto\fde la ciudad\nque trae problemas\fa los entrenadores.\n",
  ["DaisyOfferGroomingText"] = "DALIA: ¡Llegas\na tiempo! Iba\va tomar un té.\f¿Quieres tomarte\nuno? Tus POKéMON\festán un poco\nsucios. ¿Quieres\fque limpie\na uno?",
  ["DaisyRefusedText"] = "DALIA: ¿No quieres\nque limpie a un POKéMON?\fVale, tan sólo\ntomaremos té.",
  ["DaisyWhichMonText"] = "DALIA: ¿Qué POKéMON\nlimpio?",
  ["DanceTheaterCooltrainerMText"] = "Ese hombre vive\ncon su RHYDON.\fDice que quiere un\nPOKéMON que sepa\vSURF y bailar.\f¿Querrá hacer un\nPOKéMON de\vnado\vsincronizado?",
  ["DanceTheaterFancyPanelText"] = "Es un elegante panel\ndecorado\vcon flores.",
  ["DanceTheaterGrannyText"] = "Las CHICAS KIMONO\nson tan bonitas…\fPero siguen un\nentrenamiento\vriguroso.\fTambién tienen que\naprender modales\fantes de aparecer\nen público.\fPero si amas algo,\ntodo es\vposible.",
  ["DarkCaveBlackthornEntrancePharmacistText1"] = "¡Uauu! ¡Me has\nasustado! Tenía\fpuestas las GAFAS\nDE SOL y no me\fdi cuenta de tu\npresencia. ¿Que\fqué estoy haciendo\naquí? No te preocupes\fpor eso. Te\ndaré unas GAFAS\fDE SOL si olvidas\nque me has\vvisto,\v¿vale?",
  ["DarkCaveBlackthornEntrancePharmacistText2"] = "Las GAFAS DE SOL aumentan\nel poder de los movimientos\vde tipo siniestro.",
  ["DarkCaveSignText"] = "CUEVA OSCURA",
  ["DayCareManOutside.FoundAnEggText"] = "¡Ah, eres tú!\fEstábamos\ncriando a tu\fPOKéMON y, ¡vaya,\nqué sorpresa!\f¡Tu POKéMON tenía\nun HUEVO!\fNo sabemos cómo\nllegó ahí, pero\flo tenía tu\nPOKéMON. ¿Lo quieres?",
  ["DayCareManOutside.IllKeepItThanksText"] = "Tudo bem, vou\nficar com ele.\vValeu!",
  ["DayCareManOutside.NoRoomForEggText"] = "No tienes\nespacio en el equipo.\vVuelve más tarde.",
  ["DayCareManOutside.NotYetText"] = "Aún no…",
  ["DayCareManOutside.ReceivedEggText"] = "{PLAYER} recebeu\no EGG!",
  ["DayCareManOutside.TakeGoodCareOfEggText"] = "Cuide bem\ndele.",
  ["DayCareManText_GiveOddEgg"] = "Soy el ENCARGADO\nde la GUARDERÍA.\f¿Sabes algo acerca\nde los HUEVOS?\fHe estado cuidando\nPOKéMON junto\vcon mi esposa.\f¡Y hemos consegui-\ndo un HUEVO!\f¿A que es increíble?\n¿Qué? ¿Te gusta\feste HUEVO?\n¡Entonces,\fquédatelo!\n",
  ["DayCareMonCompatibilityText.BreedAppearsToCareForText"] = "Parece gostar\nde {RAM:D073}.",
  ["DayCareMonCompatibilityText.BreedBrimmingWithEnergyText"] = "Está\ntransbordando de\venergia.",
  ["DayCareMonCompatibilityText.BreedFriendlyText"] = "Se lleva bien con\n{RAM:D073}.",
  ["DayCareMonCompatibilityText.BreedNoInterestText"] = "No muestra interés\npor {RAM:D073}.",
  ["DayCareMonCompatibilityText.BreedShowsInterestText"] = "Mostra interesse\nem {RAM:D073}.",
  ["DayCareSignText"] = "GUARDERÍA ¡Déjanos\fcriar a tu POKéMON\npor ti!",
  ["DayCareText_ComeAgain"] = "Vuelve cuando quieras.",
  ["DayCareText_DescribeOddEgg"] = "Encuéntralo ahora\nCuida el POKéMON de alguien. pero\nel entrenador no lo quería\nHUEVO, nada más salir\npor aquí.",
  ["DayCareText_GotOddEgg"] = "¡{PLAYER} recibió\nel HUEVO RARO!",
  ["DayCareText_PartyFull"] = "No tienes sitio\npara esto.",
  ["DayOfWeekSiblingsHousePokedexText1"] = "Aquí hay algo\nescrito. ¿Quieres\fleerlo?",
  ["DayOfWeekSiblingsHousePokedexText2"] = "A mis hermanos\ny hermanas: Nos\fenorgullece ayudar\na los entrenadores\vPOKéMON. Cuando\fhabléis con los\nentrenadores,\vdadles algo\fútil. Besos,\nLUNA ¿Sigues\fleyendo?",
  ["DayOfWeekSiblingsHousePokedexText3"] = "Lunes, LUNA\nRUTA 40 Martes,\fMARTA RUTA 29\nMiércoles, MIGUEL\fLAGO DE LA\nFURIA Jueves,\fJOSUÉ RUTA\n36 Viernes,\fVICKI RUTA\n32 Sábado,\fSABINO CIUDAD\nENDRINO Domingo,\vDOMINGO\fRUTA\n37",
  ["DecorationDesc_TownMapPoster.LookTownMapText"] = "Es el MAPA del PUEBLO.",
  ["DidntChooseStarterText"] = "ELM: Piénsalo\ncon cuidado. Tu\fcompañero es\nimportante.",
  ["DifficultBookshelfText"] = "Está llena de libros\ncomplejos.",
  ["DiglettsCavePokefanMText"] = "Salieron del suelo\nun montón de\fDIGLETT. ¡Qué\nsusto!",
  ["DirectorAfterText"] = "Te ruego que me\nayudes. ¡Quién\fsabe lo que harían\nsi se apoderaran\fde la emisora!\n¡Podrían hasta\fcontrolar a los\nPOKéMON usando\funa señal especial!\nSólo tú puedes\fayudarme. Salva\nla TORRE RADIO…\f¡Y a todos\nlos POKéMON\fdel mundo!\n",
  ["DirectorCardKeyText"] = "DIRECTOR: Úsala para\nabrir las puertas\vde la P2.",
  ["DirectorIntroText"] = "DIRECTOR: ¿Quién?\n¿Qué? ¿Has venido\va rescatarme? ¡Gracias!\fLa TORRE RADIO.\f¿Qué está pasando\fahí dentro? ¿Invadida\npor el TEAM\fROCKET? Mira.\nToma esta\fLLAVE MAGNÉTICA.\n",
  ["DontKnowTheInstructionsText"] = "Te leeré las instrucciones.\nEnciende el\fPOKéGEAR y\nelige el TELÉFONO.\v",
  ["DontLitterSignText"] = "PLAZA MT. MOON No\ntirar basura",
  ["DontWantGoodRodText"] = "¿Quééé? ¿¡No te\ngusta pescar!? ¡Incomprensible!\v",
  ["DontWantSuperRodText"] = "¿Eh? ¿Me engañan\nmis ojos?",
  ["DragonDensSignText"] = "HACIA LA GUARIDA\nDRAGÓN",
  ["DragonShrineClairThatCantBeText"] = "¡No es posible!",
  ["DragonShrineClairYouPassedText"] = "¿Qué tal te fue?\fCreo que no hace\nfalta preguntar…\f¿Fallaste? <……><……><……><……><……><……>\f¿Qué…? ¿Lo\fconseguiste?\n",
  ["DragonShrineClairYoureLyingText"] = "¡Estás mintiendo!\n¡Ni siquiera yo\fhe conseguido la\naprobación!",
  ["DragonShrineClairsGrandfatherText"] = "Parece que DÉBORA\nha aprendido de ti\funa lección inestimable.\nTe lo agradezco\fcomo abuelo suyo\nque soy.",
  ["DragonShrineComeAgainText"] = "Ven de nuevo, si\nasí lo deseas.",
  ["DragonShrineElder2Text"] = "Ha pasado bastante tiempo\ndesde la última vez que\fun entrenador obtuvo\nla aprobación de nuestro\vMAESTRO. De hecho, nadie\flo ha conseguido desde\nque el Maes- tro\vLANCE la ganó.",
  ["DragonShrineElder3Text"] = "¿Conoces al joven\nMaestro LANCE?\vSe parece bastante\fa nuestro\nMAESTRO cuando\vera joven.\vLo llevan\fen la sangre.\n",
  ["DragonShrineElderGreetingText"] = "Mmm… Encantado\nde verte. No necesitas\fexplicarme por\nqué has venido.\vDÉBORA te envía,\f¿verdad? Esa\nchica es muy\ftraviesa… Lo\nsiento, pero\fdebo probarte.\nNo te preocupes.\vSólo deberás\fcontestar\nunas pocas\vpreguntas.\f¿Ya?",
  ["DragonShrineElderScoldsClairText"] = "DÉBORA… Medita\facerca de\nlo que tiene\fy tú careces…\n",
  ["DragonShrineHereRisingBadgeText"] = "Toma. Ésta es la MEDALLA\nDRAGÓN… ¡Deprisa!\f¡Cógela!",
  ["DragonShrineIUnderstandText"] = "En… entiendo…",
  ["DragonShrineMustIInformLanceText"] = "¡DÉBORA! ¡Esta\fpersona es admirable\nen todos los\vsentidos! ¡Admite\vla derrota\fy dale la MEDALLA\nDRAGÓN! ¿O\vdebo informar\fa LANCE\nde esto…?\v",
  ["DragonShrinePartyFullText"] = "¿Mmm? Tu equipo\nPOKéMON está\vlleno.",
  ["DragonShrinePassedTestText"] = "Mmm… Ya veo… Cuidas\fmucho de los POKéMON.\nMuy encomiable.\v¡La convicción\fes lo más importante!\f{PLAYER}, no\npier- das\fla confianza.\nLa necesitarás\fen la LIGA\nPOKéMON.\v",
  ["DragonShrinePlayerReceivedDratiniText"] = "¡{PLAYER} recibió\na DRATINI!",
  ["DragonShrinePlayerReceivedRisingBadgeText"] = "{PLAYER} recibió la\nMEDALLA DRAGÓN.",
  ["DragonShrineQuestion1Text"] = "¿Qué son los\n#- MON para\vti?",
  ["DragonShrineQuestion2Text"] = "¿Qué te ayuda a vencer\ncombates?",
  ["DragonShrineQuestion3Text"] = "¿Contra qué clase\nde entrenador prefieres\vluchar?",
  ["DragonShrineQuestion4Text"] = "¿Qué es lo más importante\npara mejorar\vPOKéMON?",
  ["DragonShrineQuestion5Text"] = "POKéMON fuertes.\nPOKéMON débiles.\f¿Cuáles son más\nimportantes?",
  ["DragonShrineRightAnswerText"] = "Oh, ya entiendo…",
  ["DragonShrineRisingBadgeExplanationText"] = "La MEDALLA DRAGÓN\npermite que tus\fPOKéMON puedan\nusar el movimiento\vpara subir cascadas.\fAdemás, todos\nlos POKéMON\fte reconocerán\ny obe- decerán\fcualquier\norden sin\fhacer preguntas.\n",
  ["DragonShrineRivalIsInTrainingText"] = "Aquí entrena un\nchico de tu edad.\fSe parece a DÉBORA\ncuando era joven.\fEs un poco\vpreocupante…",
  ["DragonShrineSignpostText"] = "SANTUARIO DRAGÓN\fErigido en honor\nde los POKéMON\fdragón de la GUARIDA\nDRAGÓN",
  ["DragonShrineSpeechlessText"] = "<……><……><……><……><……><……>",
  ["DragonShrineSymbolicDragonText"] = "Los POKéMON dragón\nson el símbolo\vde nuestro clan.\fHas demostrado\nque podemos\vdarte uno.",
  ["DragonShrineTakeThisDratiniText"] = "Mmmm… Encantado\nde verte. Tu llegada\fes más que afortunada.\nTengo algo para\fti. Coge este\nDRATINI como\fprueba de\nque reconozco\ftu esfuerzo.\n",
  ["DragonShrineWrongAnswerText1"] = "¿Eh? No lo he\nentendido…",
  ["DragonShrineWrongAnswerText2"] = "¿Qué has\ndicho?",
  ["EarlsPokemonAcademyGameboyKid1Text"] = "He cambiado a mis\nmejores POKéMON con\vmi compañero.",
  ["EarlsPokemonAcademyGameboyKid2Text"] = "¡El POKéMON que he\nconseguido va equipado\vcon algo!",
  ["EarlsPokemonAcademySignText"] = "ACADEMIA POKéMON\nDE PRIMO",
  ["EarlsPokemonAcademyYoungster1Text"] = "Estoy tomando apuntes\nde lo que dice el\vprofesor. Y debería\fcopiar también\nlo escrito en\vla pizarra.",
  ["EarlsPokemonAcademyYoungster2Text"] = "Si un POKéMON va equipado\ncon una BAYA, se curará\vél solo en combate.\fLos POKéMON pueden\nir equipados con\vmuchos objetos…\fEs muy duro tomar\napuntes…",
  ["EatathonContestPosterText"] = "¡Concurso de trágones!\n¡Sin tiempo! ¡Una lucha sin fin!\nEl alcalde podrá comer\ngratis!",
  ["EcruteakCityFisherText"] = "He oído un rumor\nsobre el FARO de\vC. OLIVO. El POKéMON\fque usan como\nluz ha caído\fenfermo. Parece\nque tienen\vproblemas.",
  ["EcruteakCityFisherText_JasmineReturned"] = "El POKéMON de FARO\nOLIVO se ha curado.\vLos barcos pueden\fvolver a navegar\nseguros de\vnoche.",
  ["EcruteakCityGramps1Text"] = "En CIUDAD IRIS había\ndos torres: una\fen el Este y otra\nen el Oeste.",
  ["EcruteakCityGramps2Text"] = "¡Ah, tú! ¿Has aprendido?\n¿Bailando como las CHICAS KIMONO?\nSi vas a tu TEATRO DE DANZA, una\nUn viejo raro te dará algo.\nhermoso. Eso es lo que me dicen.",
  ["EcruteakCityGramps3Text"] = "Hace mucho, mucho\ntiempo… Esta torre\fardió por el fuego.\nTres POKéMON descono-\fcidos perecieron\nen ella. Un POKéMON\fcon los colores\ndel arco iris\fbajó del cielo\ny los resucitó…\fEs una leyenda\nque ha ido pasando\fde LÍDER a\nLÍDER en el\vGIMNASIO IRIS.\f¿Yo? Yo sólo\fsoy un entrenador.\n¡Jo,\vjo,\vjo!",
  ["EcruteakCityLass1Text"] = "Voy a practicar\nen el TEATRO de\fDANZA. ¿Vienes\nconmigo?",
  ["EcruteakCityLass2Text"] = "La torre que había\naquí… Mi abuela\fme dijo que\nera mucho\vmás alta.",
  ["EcruteakCityLass2Text_ReleasedBeasts"] = "Tres POKéMON\nhuyeron en\vtres direcciones.\v¿Qué eran?\v",
  ["EcruteakCitySignText"] = "CIUDAD IRIS Una\nciudad donde conviven\fel pasado y\nel presente",
  ["EcruteakCityYoungsterText"] = "Los POKéMON están causando\nestragos en el LAGO\fDE LA FURIA. Me\ngustaría verlo.",
  ["EcruteakDanceTheaterSignText"] = "TEATRO DE DANZA\nDE CIUDAD IRIS",
  ["EcruteakGymClosedText"] = "MORTI, el LÍDER de\nGIMNASIO, no está.\fLo siento, pero tendrás\nque irte. Jo,\fjo, jo, jo.",
  ["EcruteakGymGuideText"] = "Los entrenadores de\naquí tienen motivos\vsecretos.\fSi ganas, quizá te\ncuenten secretos\fprofundos de\nCIUDAD IRIS.",
  ["EcruteakGymGuideWinText"] = "¡Uf, {PLAYER}! ¡Has\nestado genial!\f¡Yo estaba\nencogido en una\vesquina del miedo!",
  ["EcruteakGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vIRIS: MORTI El\fmístico adivino\ndel futuro",
  ["EcruteakHistoryBookText"] = "HISTORIA de CIUDAD\nIRIS ¿Quieres\fleerla?",
  ["EcruteakItemfinderAdventureText"] = "¡Ah! ¿Vas de\naventura con\vtus POKéMON?\f¿Y qué es una\naventura sin\vun tesoro?\f¿Tengo razón\no no?",
  ["EcruteakItemfinderToEachHisOwnText"] = "¡Oh! A cada uno lo\nsuyo, supongo…",
  ["EcruteakItemfinderTrueSpiritText"] = "¡Bien! Entiendes\nel verdadero\fespíritu de\nla aventura.\f¡Me gusta!\nToma esto.",
  ["EcruteakLugiaSpeechHouseGrampsText"] = "Sucedió cuando\nera joven. El cielo\fse oscu- reció\nde repente. Un\fenorme POKéMON\nestaba tapando\vel sol. Me pregunto\fqué sería ese\nPOKéMON, mezcla\fde pájaro\ny dragón.",
  ["EcruteakLugiaSpeechHouseYoungsterText"] = "¿Existe un POKéMON\ntan grande? Si existe,\fdebe de ser\nmuy fuerte.",
  ["EcruteakMartGrannyText"] = "Si usas REVIVIR,\nel POKéMON debilitado\fse reanimará.\n",
  ["EcruteakMartSuperNerdText"] = "Mi EEVEE evolu- cionó\nen ESPEON. Pero el\fEEVEE de mi amigo\nevolu- cionó en\vUMBREON. No sé por\fqué. Los dos educamos\na nuestros EEVEE\fde la misma\nforma…",
  ["EcruteakPokecenter1FCooltrainerFText"] = "MORTI, el LÍDER\ndel GIMNASIO, es\vmuy bueno. Y sus\fPOKéMON son muy\nfuertes.",
  ["EcruteakPokecenter1FGymGuideText"] = "LAGO DE LA FURIA…\fLa aparición de un\nbanco de GYARADOS…\fHuelo una\nconspiración. ¡Lo sé!",
  ["EcruteakPokecenter1FPokefanMText"] = "Las CHICAS KIMONO\nson unas geniales\fbailarinas, además\nde magníficas\fcon sus POKéMON.\n",
  ["EcruteakPokecenter1FPokefanMTextMobile"] = "Seguro que esperas\nluchar con más\fgente, ¿verdad?\nParece que hay\fun sitio en\nel que se reúnen\vlos entrenadores.\fTe preguntarás\ndónde. Es\fpasando\nCIUDAD\vOLIVO.",
  ["EcruteakPokecenter1F_BillText1"] = "Hola, soy BILL.\n¿Quién eres tú?\f¿Eh? ¿{PLAYER}?\n¡Has llegado justo\va tiempo!",
  ["EcruteakPokecenter1F_BillText2"] = "Ya he terminado de\najustar la CÁPSULA\vDEL TIEMPO. Sabes\fque puedes cambiar\nPOKéMON, ¿verdad?\vMi CÁPSULA DEL TIEMPO\fsirve para intercambiar\ncon el pasado. Pero\fno podrás enviar\nnada que no existiera\fen el pasado. Si\nlo haces, el PC\fdel pasado podría\nestropearse. Así\fque debes eliminar\ncualquier cosa\vque no existiera\fantes. Esto es,\nno envíes nuevos\fmovimientos ni\nnuevos POKéMON\fen esta CÁPSULA.\nNo te preocupes.\fYa he acabado\nde ajustarla.\fMañana funcionarán\ntodas las CÁPSULAS\vDEL TIEMPO de\flos CENTROS\nPOKéMON. Debo\fvolver pronto\na CIUDAD TRIGAL.\fMi familia\nespera.\v¡Hasta\fluego!",
  ["EcruteakThreeMonText"] = "En CIUDAD IRIS\ntambién vivían\ftres POKéMON que\ncorrían por toda\fla ciudad. Dicen\nque habían nacido\fdel agua, del\nfuego y del\frayo. Pero como\nno podían contener\vsu enorme\ffuerza… Huyeron\nhacia\flos pastos.\n",
  ["EcruteakTinTowerEntranceGrampsText"] = "Dos torres… Dos\nPOKéMON… Pero cuando\funa se quemó, los\ndos POKéMON huyeron\fy nunca volvieron.\n",
  ["EcruteakTinTowerEntranceSageText"] = "Sin la MEDALLA del\nGIMNASIO de CIUDAD\fIRIS, no se puede\nentrar en la TORRE\fHOJALATA. ¡Tendrás\nque irte!",
  ["EcruteakTinTowerEntranceSageText_GotFogBadge"] = "Sin la MEDALLA del\nGIMNASIO de CIUDAD\fIRIS, no se puede\nentrar en la TORRE\fHOJALATA. ¡Ah!\f¡La MEDALLA de\nCIUDAD IRIS! Puedes\vpasar.",
  ["EcruteakTinTowerEntranceSageText_HeardClearBell"] = "El sonido de\nla campana muestra\vel alma del\fportador. Tú…\fPuedes entrar\nen la TORRE\vHOJALATA.\fSigue adelante.\n",
  ["EcruteakTinTowerEntranceSageText_HearsClearBell"] = "Ha ocurrido un\nhecho importante.\vPerdóname, pero\ftengo que pedirte\nque te vayas.\v<……> <……> <……>\f¡Ah! ¡El sonido\fde esa CAMPANA\fCLARA! Es… ¡Es\nsublime! ¡Nunca\fantes había escuchado\fun sonido así!\nEl sonido de\fla campana\nmuestra el\valma del portador.\fTú… Puedes\fentrar en\nla TORRE\vHOJALATA.\fSigue adelante.\n",
  ["EcruteakTinTowerEntranceSageText_NoClearBell"] = "Ha ocurrido un\nhecho importante.\vPerdóname, pero\ftengo que pedirte\nque te vayas.\vLo que alivia\fel alma… El\nTRÍO DE SABIOS\fdice cosas\nmuy difíciles\fde entender…\n",
  ["EcruteakTinTowerEntranceSageText_PleaseDoGoOn"] = "Sigue adelante.\n",
  ["EcruteakTinTowerEntranceWanderingSageText"] = "La TORRE HOJALATA\nes una espléndida\vtorre de nueve\vpisos. Alivia\fel alma de todos\nlos que la\vmiran.",
  ["EcruteakTinTowerEntranceWanderingSageText_GotClearBell"] = "¡La TORRE HOJALATA\nse ha movido! ¡Se\fhabrá posado un\nPOKéMON arriba!",
  ["EcruteakTwoTowersText"] = "En CIUDAD IRIS había\ndos torres. Cada\funa acogía a un\nfuerte POKéMON\vvolador. Pero una\fde ellas se quemó.\nY desde entonces\vno se ha visto\fa ninguno de\nlos dos POKéMON.\v¿Sigues leyendo?\f",
  ["ElmAfterTheftText1"] = "ELM: {PLAYER}, es\nterrible… Oh, sí,\f¿cuál era el gran\ndescubri- miento\vdel SR. POKéMON?",
  ["ElmAfterTheftText2"] = "{PLAYER} le dio el\nHUEVO MISTERIOSO\val PROF. ELM.",
  ["ElmAfterTheftText3"] = "ELM: ¿Esto?",
  ["ElmAfterTheftText4"] = "Pero… ¿es un HUEVO\nde POKéMON? Si\flo es, ¡vaya descubrimiento!\n",
  ["ElmAfterTheftText5"] = "ELM: ¿¡Qué!? ¿El\fPROF. OAK te dio\nuna POKéDEX? {PLAYER},\f¿es cierto? Es…\n¡Es increíble!\vÉl es capaz de\fver el potencial\nde un entrenador\vsólo con mirarle.\vUau, {PLAYER}.\fParece que tienes\nlo que hay que\ftener. Y parece\nque te llevas\fmuy bien con los\nPOKéMON. Deberías\vafrontar el reto\fde los GIMNASIOS\nPOKéMON. El\vGIMNASIO más\fcercano es\nel de CIUDAD\vMALVA.",
  ["ElmAfterTheftText6"] = "{PLAYER}… El camino\nhacia el campeonato\fserá largo. Antes\nde partir,\fno te olvides\nde ver a tu\vmadre.",
  ["ElmAideHasEggText"] = "ELM: ¿{PLAYER}?\n¿Te encontraste\vcon mi ayudante?\fDebía llevarte\nel HUEVO al\fCENTRO POKéMON\nde CIUDAD MALVA.\vNo le habrás\fvisto.\nBúscale\vallí.",
  ["ElmDescribesMrPokemonText"] = "El SR. POKéMON\nbusca las rarezas\ven todas partes.\fLo malo es que,\nademás de\vser raras,\fno son muy\nútiles…",
  ["ElmDirectionsText1"] = "El SR. POKéMON vive un poco más allá\nde CEREZO, la próxima ciudad. Es\vcasi una ruta directa, así que no\ftiene pérdida. Pero por si acaso,\naquí tienes mi número de móvil.\v¡Llámame si ocurriera algo!",
  ["ElmDirectionsText2"] = "Si tu POKéMON resulta dañado,\ndebes curarlo con esta\fmáquina. Úsala siempre\nque quieras.",
  ["ElmDirectionsText3"] = "¡{PLAYER}, cuento\ncontigo!",
  ["ElmGiveEverstoneText1"] = "¡Gracias, {PLAYER},\npor ayudarnos a desenmarañar\flos misterios POKéMON!\nQuiero que lleves\festo como muestra\nde agradecimiento.\v",
  ["ElmGiveEverstoneText2"] = "Esta es una PIEDRAETERNA.\nAlgunos POKéMON evolucionan\nalcanzar ciertos niveles. si uno\nPOKéMON estará equipado con la PIEDRAETERNA,\nno evolucionará.\vDáselo al POKéMON que no quieras\nque evoluciona.",
  ["ElmGiveMasterBallText1"] = "ELM: ¡Hola, {PLAYER}!\n¡Mi investigación\festá mejorando gracias\na tu ayuda! Toma\festo como muestra\nde agradecimiento.\v",
  ["ElmGiveMasterBallText2"] = "¡La MASTER BALL\nes la mejor! ¡Es\fla BALL definitiva!\nCaptura cualquier\fPOKéMON sin fallar.\nSe les entrega\fa los grandes\ninvestigadores\vPOKéMON. ¡Creo\fque tú harás\nun mejor uso\fde ella que yo,\n{PLAYER}!",
  ["ElmGiveTicketText1"] = "ELM: ¡{PLAYER}!\n¡Aquí estás! Te\fllamé porque tengo\nalgo para ti.\v¿Ves? Es un TICKET\fBARCO. Ahora\npuedes atrapar\fPOKéMON en\nKANTO.",
  ["ElmGiveTicketText2"] = "el barco sale\nCIUDAD OLIVO. Pero eso es todo lo que sabes,\n {PLAYER}. Lo has cubierto todo\ncon tu POKéMON.\vSaludos al PROF.\fROBLE de mi parte\nen KANTO!",
  ["ElmPhoneAssistantText"] = "Hola. ¿{PLAYER}?\f¿Has visto a mi\nayudante? Está\ven el CENTRO\fPOKéMON de CIUDAD\nMALVA.",
  ["ElmPhoneCheckingTheEggText"] = "Hola. ¿{PLAYER}?\fEstamos examinando\nel HUEVO. Parece\fser un HUEVO\nPOKéMON.",
  ["ElmPhoneDisasterText"] = "¿Hola? ¿{PLAYER}?\n¡Menudo desastre!\fSí, sí…  ¡Es terrible!\n¿Qué debo hacer?\fEs… Oh, no…\n¡Por favor,\fvuelve cuanto\nantes!",
  ["ElmPhoneDiscoveredHatchTimeText"] = "Hola. ¿{PLAYER}?\fHe hecho un nuevo\ndescubrimiento. El\ftiempo que tarda\nun HUEVO en eclosionar,\fdepen- de del\nPOKéMON.",
  ["ElmPhoneDiscoveredPokerusText"] = "Hola. ¿{PLAYER}?\fdescubrí uno\ncosa muy rara. Aparentemente hay algo llamado\n#RUS que infecta a POKéMON.\nSí, es como un virus, entonces\nSe llama #RUS.\vSe multiplica muy rápidamente e infecta.\na los POKéMON.\fPero eso es todo.\nNo parece que haya nada\nSucede con el tiempo. Creo\nque no hay por qué preocuparse\nParsis. ¡Adiós!",
  ["ElmPhoneEggAssistantText"] = "Hola. ¿{PLAYER}?\n¡Hemos descubierto\falgo acerca de\nlos HUEVOS! Mi\fayudante está en\nel CENTRO POKéMON\fde CIUDAD MALVA.\n¿Puedes hablar\vcon él?",
  ["ElmPhoneEggHatchedText"] = "Hola. ¿{PLAYER}? ¿Cómo\nestá el HUEVO? ¿Qué…?\f¿Ha eclosionado?\n¡Uau! ¿Qué clase\vde POKéMON es? ¡Por\ffavor, ven a\nenseñármelo!",
  ["ElmPhoneGiftText"] = "Hola. ¿{PLAYER}?\fTengo aquí algo\npara ti. ¿Puedes\fvenir a mi LABORATORIO?\n¡Hasta\fluego!",
  ["ElmPhoneHealYourMonText"] = "Hola. ¿{PLAYER}?\fIntenta no pasarte.\nAsegúrate de\fcurar a tus POKéMON\nsi están\vheridos.",
  ["ElmPhoneHowIsTheEggText"] = "Hola. ¿{PLAYER}? ¿Cómo\festá el HUEVO? ¿Ha\ncambiado algo? Si\fpasa algo, por favor,\nllámame.",
  ["ElmPhoneInvestigatingEggMovesText"] = "Hola. ¿{PLAYER}?\fTodavía son un misterio\nlos movimientos\fque tendrá un\nPOKéMON al eclosionar.\fAhora lo estamos\ninvestigando.\v",
  ["ElmPhonePokemonStolenText"] = "¿{PLAYER}? Estoy\nmuy enfadado. Nos\facaban de robar\nun POKéMON. ¿Quién\fpodría hacer\nalgo así?",
  ["ElmPhoneRadioTowerRocketTakeoverText"] = "¿{PLAYER}, qué tal\nvan las cosas?\fTe llamo porque\npasa algo raro\fcon las emisiones\nde radio. Están\fhablando del TEAM\nROCKET. {PLAYER},\f¿sabes algo acerca\nde ellos? Quizá\vha regresado\fel TEAM ROCKET.\nNo, no puede\fser verdad.\nSiento molestarte.\f¡Ten cuidado!\n",
  ["ElmPhoneSawMrPokemonText"] = "Hola. ¿{PLAYER}? ¿Conociste\fal SR. POKéMON?\n¡Genial! ¡Ve\vcon cuidado!",
  ["ElmPokeBallText"] = "Contiene un POKéMON\natrapado por el\vPROF. ELM.",
  ["ElmStudyingEggText"] = "ELM: ¡No te rindas!\nSi sé algo sobre\fese HUEVO, te\nllamaré.",
  ["ElmText_CallYou"] = "ELM: {PLAYER},\nte llamaré si\vocurre algo.",
  ["ElmText_Intro"] = "OLMO: ¡ {PLAYER} !\n¡Aquí tiene! Tengo que pedirte un favor.\nEstoy realizando una nueva investigación.\nción POKéMON en este momento. Pregúntame si podrías\nayúdame, {PLAYER}.\vMira… estoy preparando el discurso que daré en una conferencia.\nPero hay algunas cosas que todavía\nNo llego a entender.\n¡Bien! Necesito que cuides un POKéMON que capturé\nhay poco.",
  ["ElmText_LetYourMonBattleIt"] = "Si aparece un POKéMON salvaje,\nhaz que tu POKéMON\vluche contra él.",
  ["ElmThoughtEggHatchedText"] = "¿{PLAYER}? Creía que\nel HUEVO había eclosionado…\f¿Dónde está\nel POKéMON?",
  ["ElmWaitingEggHatchText"] = "ELM: ¿Alguna\nnovedad?",
  ["ElmsHouseLabFoodText"] = "Aquí hay comida.\nDebe de ser para\vel LABORATORIO.",
  ["ElmsHousePCText"] = "POKéMON… ¿De dónde\nvienen? ¿Adónde\fvan? ¿Por qué\nnadie ha visto\fun POKéMON nacer?\n¡Quiero saberlo!\v¡Dedicaré mi\fvida al estudio\nde los POKéMON!\f… Es parte\nde los papeles\fde la investigación\fdel PROF.\nELM.\v",
  ["ElmsHousePokemonFoodText"] = "Aquí hay comida.\nDebe de ser para\vlos POKéMON.",
  ["ElmsLabHealingMachineText1"] = "Me pregunto qué\nserá esto.",
  ["ElmsLabHealingMachineText2"] = "¿Quieres curar\na tus POKéMON?",
  ["ElmsLabMonEggText"] = "Es el HUEVO de\nPOKéMON que estudia\vel PROF. ELM.",
  ["ElmsLabOfficerText1"] = "Dicen que han robado\nun POKéMON. Y acabo\fde recibir cierta\ninformación del\vPROF. ELM. Parece\fque fue un joven\npelirrojo, de pelo\vlargo. ¿Qué? ¿Que\ftú te has enfrentado\fa un entrenador\nasí? ¿Y sabes\fcómo se\nllama?",
  ["ElmsLabOfficerText2"] = "¡Bien! Así que su\nnombre es <RIVAL>.\f¡Gracias por tu\ncolaboración!",
  ["ElmsLabPCText"] = "OBSERVACIONES DE\nEVOLUCIÓN POKéMON\fEs lo que pone en\nla pantalla…",
  ["ElmsLabTrashcanText"] = "Dentro está el envoltorio\ndel tentempié que se\vtomó el PROF. ELM.",
  ["ElmsLabTravelTip1Text"] = "{PLAYER} abrió\nun libro. Pista\fde viaje 1: Pulsa\fSTART para abrir\nel MENÚ.",
  ["ElmsLabTravelTip2Text"] = "{PLAYER} abrió\nun libro. Pista\fde viaje 2: ¡Graba\ftu viaje con\nGUARDAR!",
  ["ElmsLabTravelTip3Text"] = "{PLAYER} abrió un\nlibro. Pista de\fviaje 3: Abre tu\fMOCHILA y pulsa\nSELECT para mover\vobjetos.",
  ["ElmsLabTravelTip4Text"] = "{PLAYER} abrió un\nlibro. Pista de\fviaje 4: Mira los\fataques de tus\nPOKéMON. Pulsa\fA para cambiar\nde ataque.",
  ["ElmsLabWindowText1"] = "La ventana está\fabierta. Entra una\nsuave brisa.",
  ["ElmsLabWindowText2"] = "¡Entró por\naquí!",
  ["ElmsLookingForYouText"] = "¡Ah, {PLAYER}…!\nNuestro vecino,\fel PROF. ELM, te\nestaba buscando.\fDijo que quería\nque le hicieras\vun favor. ¡Ah!\f¡Casi se me olvida!\nYa han traído\ftu POKéGEAR del\ntaller. ¡Aquí\ftienes!",
  ["ElmsSonText"] = "¡Cuando sea mayor,\nayudaré a mi\vpadre! ¡Voy\fa ser un gran\nprofesor\vPOKéMON!",
  ["ElmsWifeText"] = "¡Hola, {PLAYER}! Mi\nmarido siempre está\fmuy ocupado. Espero\nque esté bien. Cuando\festá embebido en la\ninvestigación POKéMON,\fse olvida hasta\nde comer.",
  ["ErikaAfterBattleText"] = "ERIKA: La derrota\nDeja mal sabor de boca... Pero sé que hay entrenadores\npero me animas a\nmejorar…",
  ["ErikaBeatenText"] = "ERIKA: ¡Oh! Admito\nque he perdido…\fEres realmente\nfuerte… Te daré\fla MEDALLA\nARCOIRIS…",
  ["ErikaBeforeBattleText"] = "ERIKA: Hola… Bonito\ndía, ¿verdad? Se\festá tan bien…\nPodría hasta dormirme…\fMe llamo ERIKA.\nSoy la LÍDER\fdel GIMNASIO\nde CIUDAD AZULONA.\v¿Cómo? ¿Vienes\fde JOHTO? ¡Qué\nbien…! ¡Oh!\vLo siento, no\fme di cuenta\nde que querías\fdesafiarme.\nMuy bien,\fpero no perderé.\n",
  ["ErikaExplainTMText"] = "ERIKA: Ha sido un\ncombate genial.\fMe has inspirado.\nAcepta esta MT\vcomo regalo. Es\fGIGA-DRENADO. Es\fun fantástico ataque\nque drena la mitad\fdel daño producido\npara curar\val POKéMON.\fÚsalo si\nquieres…",
  ["ExecutiveM4AfterText"] = "No puedo dejar que\nme afecte. Tengo\fque informar\na los otros…",
  ["ExecutiveM4BeatenText"] = "Yo… no pude\nevitarlo… GIOVANNI,\fperdóname…\n",
  ["ExecutiveM4BeforeText"] = "¿Qué? ¿Quién eres?\nEste es el taller de nuestro líder,\nGIOVANNI. He estado entrenando desde\nese TEAM ROCKET se separó hace\ntres años. Pero estoy seguro de que volverá.\nCualquier día para recuperar el mando.\nPor eso estamos aquí de guardia.\nNo dejes que nada te moleste\neste lugar!",
  ["Executivef1AfterBattleText"] = "{PLAYER}, ¿verdad?\fAlguien como tú\nno aprecia la\fmagnificencia\ndel TEAM ROCKET.\fUna lástima.\nAdmiro tu\vfuerza.",
  ["Executivef1BeatenText"] = "¡Esto no me puede\nestar pasando!\fHe luchado y\nhe perdido…",
  ["Executivef1SeenText"] = "¿Me recuerdas\ndel ESCONDITE\fde PUEBLO CAOBA?\nEntonces perdí,\vpero esta\fvez no lo\nharé.",
  ["Executivem2AfterBattleText"] = "Te has ganado mi\nrespeto. ¡Te daré\vun consejo! Aún\festás a tiempo\nde darte la\vvuelta.",
  ["Executivem2BeatenText"] = "¡La fortaleza\nse derrumbó!",
  ["Executivem2SeenText"] = "¡Hola! ¡yo!\n¡Llama a la fortaleza del TEAM ROCKET!\fno dejes uno\n¡acércate!",
  ["FakeDirectorTextAfter"] = "Escondimos al auténtico\nDIRECTOR en el\fALMACÉN SUBTERRÁNEO.\nEstá al otro\fextremo del\nSUBTERRÁNEO.\vPero dudo que\fllegues tan\nlejos.",
  ["FakeDirectorTextBefore1"] = "¡Tú! ¿Has venido\na rescatarme?",
  ["FakeDirectorTextBefore2"] = "Eso es lo que eras\nesperando? ¡Pues no! ¡Soy un impostor!\nPídeme que pase por el DIRECTOR para\npreparar nuestra invasión. quieres\n¿Sabes dónde escondemos al DIRECTOR?\nTe lo diré, pero sólo si eres capaz.\n¡para vencerme!",
  ["FakeDirectorWinText"] = "Muy bien. Te diré\ndónde está.",
  ["FalknerFightDoneText"] = "Encontrarás GIMNASIOS\nPOKéMON en las ciudades\vy en los pueblos.\fDeberías probar tus\nhabilidades en estos\vGIMNASIOS. ¡Yo\fseguiré entrenándome\npara ser el\fmaestro de los\npájaros!",
  ["FalknerIntroText"] = "¡Soy PEGASO, LÍDER\ndel GIMNASIO de\vCIUDAD MALVA! Dicen\fque una sacudida\neléctrica puede\facabar con las alas\nde los POKéMON\vvoladores. ¡No\fpermitiré que hablen\nasí de ellos!\v¡Yo te enseñaré\fel auténtico poder\nde los magníficos\fpájaros POKéMON!\n",
  ["FalknerTMMudSlapText"] = "Al usar una MT, el\nPOKéMON aprenderá\finmediatamente un\nnuevo movimiento.\fPiensa antes de actuar,\nya que las MT sólo\vse pueden usar una\fvez. MT31 contiene\nBOFETÓN-LODO. Reduce\fla precisión del\nenemigo y causa\fgrandes daños.\nEs decir, es\ftanto defensiva\ncomo ofensiva.\v",
  ["FalknerWinLossText"] = "¡Maldición! Los\nqueridos POKéMON\vde mi padre… ¡Muy\fbien! Toma esto.\nEs la MEDALLA\fCÉFIRO oficial\nde la LIGA\vPOKéMON.",
  ["FalknerZephyrBadgeText"] = "La MEDALLA CÉFIRO\nmejora el ATAQUE\vde los POKéMON.\fY permite que\nlos POKéMON usen\fDESTELLO, si\nlo tienen. Toma,\ftambién te\ndaré esto.",
  ["FarfetchdText"] = "FARFETCH'D: ¡Farf!",
  ["FarmerFText_HealedMiltank"] = "Has curado a nuestra\nMUU-MUU. Ya vuelve\fa dar LECHE MU-MU.\nAquí tienes\falgo que te\nayudará.",
  ["FarmerFText_InTrouble"] = "Nuestra leche llega\nhasta KANTO. Así\fque si nuestra MUU-MUU\nno nos da leche,\ftendremos problemas.\n",
  ["FarmerFText_SnoreSpeech"] = "Esto es RONQUIDO.\nEs un movimiento\fraro que sólo\nfunciona cuando\fel POKéMON duerme.\nMejor que pienses\fcómo vas\na utilizarlo.\v",
  ["FarmerMText_BuyMilk"] = "¿Te gusta mi LECHE\nMU-MU? Es mi orgullo\fy mi alegría.\n¡Dásela a los\fPOKéMON para restaurar\nsus PS! Tuya\fes por sólo\n500¥.",
  ["FarmerMText_GotMilk"] = "¡Toma! ¡Bébetela\ny disfruta!",
  ["FarmerMText_Milking"] = "Mejor que me vaya\na ordeñar.",
  ["FarmerMText_NoMoney"] = "Lo siento. ¡Si no hay\ndinero, no hay trato!",
  ["FarmerMText_NoRoom"] = "Vaya, tu MOCHILA\nestá llena.",
  ["FarmerMText_NoSale"] = "¿No la quieres? Vuelve\notro día.",
  ["FarmerMText_SickCow"] = "Mi MUU-MUU ya\nNo me des leche.\vEs famosa la leche de esta GRANJA.\nTodo el mundo quiere probarlo. supongo\nque si le doy muchas\nBAYAS me dará mucho\nleche.",
  ["FastShip1FGrandpaText"] = "¡Auuu! Perdóname.\n¡Tengo prisa!\v¡Mi nieta ha\fdesaparecido!\nEs muy pequeña.\f¡Si la ves,\npor favor,\fházmelo\nsaber!",
  ["FastShip1FSailor1Text_InOlivine"] = "El FERRY S.S. AQUA\nha llegado a CIUDAD\vOLIVO.",
  ["FastShip1FSailor1Text_InVermilion"] = "El FERRY S.S.\nAQUA ha llegado\va CIUDAD\vCARMÍN.",
  ["FastShip1FSailor1Text_ToOlivine"] = "El FERRY S.S.\nAQUA se dirige\va CIUDAD OLIVO.\fDaremos un aviso\ncuando lleguemos.\v",
  ["FastShip1FSailor1Text_ToVermilion"] = "El FERRY S.S.\nAQUA se dirige a CIUDAD CARMÍN.\vLe avisaremos cuando\nlleguemos allí.",
  ["FastShip1FSailor2Text"] = "Es tu camarote. Puedes\fcurar a tus POKéMON\ndurmiendo una\vsiesta. El barco\fllegará a su\ndestino mientras\vduermes.",
  ["FastShip1FSailor2Text_FirstTime"] = "Esta es tu cabaña.\fsi estas cansado\ntu POKéMON, es una siestecita.\fEso es todo\nsanará.",
  ["FastShip1FSailor3Text"] = "Los pasajeros son\nentrenadores.\fEstán deseando\nluchar en sus\vcamarotes.",
  ["FastShipArrivedOlivineText"] = "El FERRY S.S. AQUA\nha llegado a CIUDAD\vOLIVO.",
  ["FastShipArrivedVermilionText"] = "El FERRY S.S.\nAQUA ha llegado\va CIUDAD\vCARMÍN.",
  ["FastShipB1FOnDutySailorDirectionsText"] = "El comedor está ahí\ndelante. Las escaleras\fdel fondo conducen\nal camarote del\vCAPITÁN.",
  ["FastShipB1FOnDutySailorRefusedText"] = "¡Oh…! El CAPITÁN\fse pondrá\nfurioso…",
  ["FastShipB1FOnDutySailorSawLittleGirlText"] = "¿Una niña pequeña?\fPuede que la haya\nvisto por aquí.",
  ["FastShipB1FOnDutySailorText"] = "¡Eh! ¿Podrías buscar\na mi compañero?\v¡Está haciendo de\flas suyas en algún\nsitio! ¡El muy\vvago! Me gustaría\fir a buscarle,\npero estoy de\vservicio.",
  ["FastShipB1FOnDutySailorThanksText"] = "¡Gracias, joven! ¡Le\nhe echado una buena\fbronca y se ha\ntranquilizado!",
  ["FastShipBedText1"] = "¡Una buena cama!\nA dormir…",
  ["FastShipBedText2"] = "¡Ah! Vuelvo a estar\nen forma.",
  ["FightingDojoBlackBeltText"] = "¡Hola! El REY del\fKARATE, el maestro\ndel DOJO-KARATE,\festá entrenando\nen una cueva\vde JOHTO.",
  ["FightingDojoSign1Text"] = "¡Lo que tenga que\nser… será!",
  ["FightingDojoSign2Text"] = "¡Enemigos por\ntodas partes!",
  ["FightingDojoSignText"] = "¡Bienvenidos!\nDOJO-KARATE",
  ["FirebreatherBillAfterBattleText"] = "Los fines de semana\nse oyen extraños\frugidos en\nla cueva.",
  ["FirebreatherBillSeenText"] = "El SUPERSÓNICO\nde ZUBAT confunde\va mis POKéMON.\v¡Y eso\fme preocupa!\n",
  ["FirebreatherBurtAfterBattleText"] = "Soy el mejor\nCOMEFUEGOS de\vKANTO. Pero\fno el mejor\nentrenador…",
  ["FirebreatherBurtSeenText"] = "¡Sube y echa\nun vistazo!",
  ["FirebreatherLyleAfterBattleText"] = "El fuego es débil\ncontra el agua.\fNo te importa,\n¿verdad?",
  ["FirebreatherLyleBeatenText"] = "La débil llama\npierde fuerza.",
  ["FirebreatherOtisAfterBattleText"] = "Cuando llueve,\nes difícil encenderlo…\v",
  ["FirebreatherOtisBeatenText"] = "Hace sol, pero\nestoy mojado…",
  ["FirebreatherRayAfterBattleText"] = "El fuego de mi\nPOKéMON ilumina\vla cueva.",
  ["FirebreatherRaySeenText"] = "Si hay luz, no me\nasusta la cueva.\fSi eres fuerte,\nlos POKéMON no\vse asustarán.",
  ["FirebreatherWaltAfterBattleText"] = "La Marcha POKéMON\nde la radio atrae\vPOKéMON salvajes.",
  ["FirebreatherWaltBeatenText"] = "¡Me he quemado la punta\nde la nariz!",
  ["FirebreatherWaltSeenText"] = "Practico mi aliento\nde fuego.",
  ["Fisher1Text_Concentration"] = "¡No me hables!\f¡Me vas a desconcentrar!\n",
  ["Fisher1Text_Snarfle"] = "¡Ñam, ñam!",
  ["Fisher2Text_GulpChew"] = "¡Glup…! ¡Ñam!",
  ["Fisher2Text_Quantity"] = "¡Mejor cantidad\nque calidad! ¡Si\festoy lleno,\nestoy feliz!",
  ["Fisher3Text_GoldenrodIsBest"] = "La comida de aquí\nes buena, pero en\vCIUDAD TRIGAL\ves aún mejor.",
  ["Fisher3Text_MunchMunch"] = "¡Ñam, ñam!",
  ["FisherAndreAfterBattleText"] = "¡No perderás como pescador!\nMe paso el día capturando POKéMON.",
  ["FisherAndreBeatenText"] = "Puede que sea un\npescador experto,\fpero soy un mal\nentrenador…",
  ["FisherAndreSeenText"] = "¡Déjame luchar con\nel POKéMON que acabo\vde atrapar!",
  ["FisherArnoldAfterBattleText"] = "Voy a volver\na pescar…",
  ["FisherArnoldBeatenText"] = "Qué fracaso…",
  ["FisherArnoldSeenText"] = "Estoy aburrido de pescar.\n¡Luchemos!",
  ["FisherBarneyAfterBattleText"] = "Creo que la electricidad\nes lo más importante\fen nuestras vidas.\nSi no lo fuera,\fno se habría\nmontado tanto\ffollón cuando\nse estropeó\fla CENTRAL\nENERGÍA.",
  ["FisherBarneyBeatenText"] = "¡La respuesta\nvendrá luego!",
  ["FisherBarneySeenText"] = "¿Qué es lo más\nimportante en nuestras\vvidas?",
  ["FisherEdgarAfterBattleText"] = "Son 100 victorias\ny 101 derrotas.\fNo lucharé en\nun rato.",
  ["FisherEdgarBeatenText"] = "¡Mmmmm…! eso no es todo\nEstá bien.",
  ["FisherEdgarSeenText"] = "Pesco hasta que\nno puedo más, y\flucho hasta desfallecer.\nÉsta es la relación\fque tengo\ncon mis POKéMON.\v",
  ["FisherHenryAfterText"] = "Los POKéMON recién\natrapados no\vson comparables\fcon los criados.\n",
  ["FisherHenrySeenText"] = "¿Mi POKéMON? ¡Recién\npescado!",
  ["FisherJonahAfterBattleText"] = "Voy a pescar en los muelles\nde CIUDAD CARMÍN.",
  ["FisherJonahBeatenText"] = "Ya… Ya no me\naburro…",
  ["FisherJonahSeenText"] = "¡Aunque estemos\nen el mar, no\vpuedo pescar!\f¡Qué aburrido!\n¡Luchemos!",
  ["FisherJustinAfterText"] = "Paciencia… La\nbase de la pesca\fy de los POKéMON\nes la misma.\v",
  ["FisherJustinSeenText"] = "¡Vaya! ¡Se me escapó\fese pez por\ntu culpa!",
  ["FisherKyleAfterBattleText"] = "El tirón de la\nCAÑA cuando ha\fpicado un POKéMON…\nÉsa es la mejor\fsensación para\nun pescador\vcomo yo.",
  ["FisherKyleBeatenText"] = "Te acuerdas, ¿no?",
  ["FisherKyleSeenText"] = "¿Te acuerdas?",
  ["FisherMartinAfterBattleText"] = "No tengo paciencia\npara la\vpesca…",
  ["FisherMarvinAfterBattleText"] = "Las CEBO BALL de\nCÉSAR son las mejores\fpara pescar POKéMON.\nSon mucho más\fefectivas\nque las ULTRA\vBALL.",
  ["FisherMarvinBeatenText"] = "He perdido, pero\nme siento mejor.",
  ["FisherMarvinSeenText"] = "No estoy en racha.\fQuizá sea por el equipo\nque uso. Luchemos.\fA ver si cambia\nmi suerte.",
  ["FisherRalph1BeatenText"] = "Intenté acelerar\nlas cosas…",
  ["FisherRalph1SeenText"] = "Soy muy bueno, tanto\npescando como con\vlos POKéMON. ¡No\fvoy a perder\ncon alguien\vtan joven!",
  ["FisherRalphAfterText"] = "¡Pescar es una pasión\neterna y los POKéMON\fson amigos\neternos!",
  ["FisherRaymondAfterBattleText"] = "¿Por qué no atrapo\nbuenos POKéMON?",
  ["FisherRaymondBeatenText"] = "Mi caña se ha\nenredado…",
  ["FisherRaymondSeenText"] = "Haga lo que haga,\nsiempre capturo los\fmismos POKéMON…",
  ["FisherScottAfterBattleText"] = "Como en la pesca,\ncon los POKéMON\ftodo está perdido\nsi te rindes.",
  ["FisherScottBeatenText"] = "¡No! ¡En esta\nbatalla, no!",
  ["FisherScottSeenText"] = "¡Hoy me siento muy\nbien! ¡Siento que\fpodría vencer\nhasta al CAMPEÓN\vde LIGA!",
  ["FisherStephenAfterBattleText"] = "¿Conoces las emisoras\nde radio de\fKANTO? Tenemos\nmuchas.",
  ["FisherStephenBeatenText"] = "¡Mi estúpida radio\nme ha distraído!",
  ["FisherStephenSeenText"] = "Me gusta pescar\nmientras escucho\vcanciones por\vla radio.",
  ["FisherWilton1BeatenText"] = "Simplemente\nolvídalo.",
  ["FisherWiltonHugePoliwagText"] = "Ese POLIWAG que\nescapó… Era enorme.\v¡Juraría que\fmedía unos\n5 metros!",
  ["FishingDudeText"] = "Soy el TÍO PESCA-\nDOR, el mayor de los\vHERMANOS PESCADORES.\f¿Conoces al GURÚ PESCADOR\ndel LAGO DE LA FURIA?\vSueña con ver el\fMAGIKARP más grande\ndel mundo. Si no\vte importa, ¿podrías\fmostrarle todos\nlos MAGIKARP que\fcaptures? Quién\nsabe, podrías\fcapturar el\nMAGIKARP de\vsus sueños.",
  ["FishingDudesHousePhotoText"] = "Es una foto de\ngente pescando…\fLo están pasando\nmuy bien…",
  ["FishingGurusHouseSignText"] = "CASA DEL GURÚ\nPESCADOR",
  ["FishingSpotSignText"] = "COTO DE PESCA",
  ["FriedaFridayText"] = "VICKI: ¡Hola! ¿Qué\ndía prefieres? A\fmí me gusta el\nviernes. Sin duda.\f¿No crees que\nes genial?",
  ["FriedaGaveGiftText"] = "VICKI: Dásela a\nun POKéMON de tipo\vveneno. ¡Oh! ¡Es\fterrible! ¡Te sorprenderá\fver cómo mejora\flos movimientos\nde tipo\vveneno!",
  ["FriedaGivesGiftText"] = "¡Toma una FLECHA\nVENENOSA!",
  ["FriedaNotFridayText"] = "VICKI: ¿Hoy no\nes viernes? ¡Me\faburro cuando\nno lo es!",
  ["FuchsiaCityPokefanMText"] = "La chica de KOGA le\ntriunfó como LÍDER del GIMNASIO cuando\nse incorporó a ALTO MANDO.",
  ["FuchsiaCitySignText"] = "CIUDAD FUCSIA ¡Mirad\fla CIUDAD FUCSIA!\n¡La pasión rosa!",
  ["FuchsiaCityTeacherText"] = "La ZONA SAFARI está\ncerrada. Da pena,\fya que es la mayor\natracción de CIUDAD\vFUCSIA.",
  ["FuchsiaCityYoungsterText"] = "Un miembro del ALTO\nMANDO era el LÍDER\fdel GIMNASIO de\nCIUDAD FUCSIA.",
  ["FuchsiaGymGuideText"] = "¡Eh, futuro\nCAMPEÓN!\f¡Mira bien a tu\nalrededor!\fTodos los entrenadores\nse parecen a la\vLÍDER, SACHIKO.\f¿Cuál de ellas es\nla verdadera SACHIKO?",
  ["FuchsiaGymGuideWinText"] = "¡Ha sido un gran\ncombate, entrenador\vde JOHTO!",
  ["FuchsiaGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vFUCSIA: SACHIKO\fLa venenosa maestra\nninja",
  ["FuchsiaMartCooltrainerFText"] = "La nieta del GUARDA\nde la ZONA SAFARI\vvive en la\vciudad.",
  ["FuchsiaMartFisherText"] = "Esperaba comprar algunos\nsouvenirs en la\fZONA SAFARI, pero\nestá cerrada.",
  ["FuchsiaPokecenter1FCooltrainerFText"] = "Me sorprendió mucho\nel GIMNASIO.\fTodas las chicas\nparecían idénti-\vcas.",
  ["FuchsiaPokecenter1FCooltrainerMText"] = "¡Anda! Tienes\nun nuevo tipo\vde POKéDEX. ¿Te\fla ha dado el\nPROF. OAK?",
  ["FuchsiaPokecenter1FJanineImpersonatorText1"] = "¡Soy SACHIKO!\nAbracadabra…",
  ["FuchsiaPokecenter1FJanineImpersonatorText2"] = "¿Has visto? ¡Ahora\nsoy como ella!",
  ["GameFreakCharacterDesignerText"] = "¿A que las GEMELAS\nson adorables? Y\fYASMINA también\nes muy guapa.\f¡Me encantan!",
  ["GameFreakGameDesignerAfterDiplomaText"] = "El DISEÑADOR GRÁ-\nFICO te imprimirá\vun DIPLOMA. Deberías\fpresumir\nde ello.",
  ["GameFreakGameDesignerCompletedPokedexText"] = "¡Uau! ¡Excelente!\n¡Has completado\vtu POKéDEX! ¡Enhorabuena!\f",
  ["GameFreakGameDesignerText"] = "¡Hola! ¡Soy el\fDISEÑADOR DEL JUEGO!\nTe costará completar\ftu POKéDEX,\npero… ¡no te\vrindas!",
  ["GameFreakGraphicArtistPrintDiplomaText"] = "Soy el DISEÑADOR\nGRÁFICO. ¿Has\fcompletado tu\nPOKéDEX? ¿Quieres\fimprimir tu\nDIPLOMA?",
  ["GameFreakGraphicArtistRefusedText"] = "Avísame si quieres\nque te imprima\vtu DIPLOMA.",
  ["GameFreakGraphicArtistText"] = "Soy el DISEÑADOR\nGRÁFICO. ¡Yo te\fhe dibujado!",
  ["GameFreakProgrammerText"] = "¿Quién? ¿Yo? Soy\nel PROGRAMADOR.\f¡Juega a las\ntragaperras!",
  ["GaveGoodRodText"] = "No sólo hay peces\nen el mar. Allá donde\fhaya agua los\nencontrarás.",
  ["GaveSuperRodText"] = "Intenta pescar allí\ndonde veas agua.\vRecuerda: puedes\fcapturar POKéMON\ndiferentes usando\fdistintas\nCAÑAS.",
  ["GentlemanAlfredAfterBattleText"] = "Arriba hay un POKéMON\nque ilumina el FARO.\vPero dicen que\festá enfermo y\nque la medicina\fnormal no puede\ncurarle.",
  ["GentlemanAlfredBeatenText"] = "¡Ah! Ya veo que\nvas en serio.",
  ["GentlemanAlfredSeenText"] = "¿Qué? Aquí no\nse juega.",
  ["GentlemanEdwardAfterBattleText"] = "Me rindo. No\ntienes por qué\fbuscarlo. ¡Olvídalo!\n",
  ["GentlemanEdwardBeatenText"] = "No… No lo encuentro…\n",
  ["GentlemanEdwardSeenText"] = "¡Oh, no! He perdido\nalgo muy importante.\v",
  ["GentlemanGregoryAfterBattleText"] = "Cuando aún estaba\nen el ejército,\fel LT. SURGE me\nsalvó la vida.",
  ["GentlemanGregoryBeatenText"] = "¡Cuánto siento\nhaberle fallado,\vLT. SURGE!",
  ["GentlemanGregorySeenText"] = "¿Vienes a derrotar\nal LT. SURGE?\f¡No, si yo puedo\nimpedirlo!",
  ["GentlemanPrestonAfterBattleText"] = "YASMINA solía utilizar\nPOKéMON roca\vcomo ONIX.",
  ["GentlemanPrestonBeatenText"] = "Ufffff… Debo entrenar\nmás.",
  ["GentlemanPrestonSeenText"] = "Viajo por el mundo\npara entrenar a\vmis POKéMON. ¿Quieres\vluchar?",
  ["GetStormBadgeText"] = "{PLAYER} recibió la\nMEDALLA TORMENTA.",
  ["GinaRocketTakeoverRumorText"] = "¿Sabes lo del\nTEAM ROCKET?\fHan tomado la\nTORRE RADIO\fde CIUDAD TRIGAL.\n¿Estarán\fbien los\nrehenes?",
  ["GiveGoodRodText"] = "¡Ah, ja, ja! ¡Ya\ntenemos alguien\vmás que pesca!",
  ["GiveSuperRodText"] = "Sí, sí. ¡Justo\nlo que pensaba!\f¡Aquí tienes! Toma\nesto. Es una\vSÚPER CAÑA.",
  ["GoldenrodBikeShopBicycleText"] = "¡Es una BICI\nnovísima!",
  ["GoldenrodBikeShopClerkAgreedText"] = "¿De verdad? ¡Bien!\fDime tu nombre\ny número de teléfono\fy te prestaré\nuna BICI.",
  ["GoldenrodBikeShopClerkFirstRateBikesText"] = "¡Mis BICIS son de\ngran calidad! Puedes\fusarlas en cualquier\nlugar.",
  ["GoldenrodBikeShopClerkIntroText"] = "(Suspiro…) Me trasladé\naquí, pero no vendo\fmis BICIS. ¿Por\nqué? ¿Montarías\fen una BICI para\nhacerme publicidad?\v",
  ["GoldenrodBikeShopClerkRefusedText"] = "(Suspiro…) ¡Oh,\nrayos y centellas…!\v",
  ["GoldenrodBikeShopJustReleasedCompactBikeText"] = "¡Lo último! ¡BICIS\fcompactas de máxima\ncalidad!",
  ["GoldenrodCityBikeShopSignText"] = "¡El mundo es un camino\nde bicis! TIENDA\vDE BICIS",
  ["GoldenrodCityCooltrainerF1Text"] = "¿Ese hombre de negro\nse ha vestido como\funo del TEAM ROCKET?\n¡Qué tonto!",
  ["GoldenrodCityCooltrainerF1Text_ClearedRadioTower"] = "¿Pertenecía ese\nhombre de negro\fal TEAM ROCKET?\n¡Es increíble!",
  ["GoldenrodCityCooltrainerF2Text"] = "La TORRE RADIO\nde CIUDAD TRIGAL\ves muy importante.\vAhora están en\funa campaña promocional.\nModificarán\vtu POKéGEAR\fpara que\nte sirva\ftambién de\nradio.",
  ["GoldenrodCityCooltrainerF2Text_GotRadioCard"] = "¡Oh, tu POKéGEAR\nsirve de radio!",
  ["GoldenrodCityFlowerShopSignText"] = "Un bello florecer\nFLORISTERÍA",
  ["GoldenrodCityGameCornerSignText"] = "¡Tu zona de\fjuego! CASINO\nDE CIUDAD\vTRIGAL",
  ["GoldenrodCityGrampsText"] = "¡Uau! Esta ciudad\nes muy grande.\fNo sé dónde están\nlas cosas.",
  ["GoldenrodCityLassText"] = "El hombre de esa casa\nevalúa los nombres de\vtus POKéMON. Y puede\fcambiar el nombre\nde tus POKéMON.",
  ["GoldenrodCityMoveTutorAsk4000CoinsOkayText"] = "Te costará 4000\nfichas. ¿Vale?",
  ["GoldenrodCityMoveTutorAskTeachAMoveText"] = "Si quieres, puedo\nenseñar increíbles\fmovimientos\na tus POKéMON.\f¿Le enseño\nun nuevo movimiento?\v",
  ["GoldenrodCityMoveTutorAwwButTheyreAmazingText"] = "Auu… Pero son\nincreíbles…",
  ["GoldenrodCityMoveTutorBButText"] = "Pe… Pero…",
  ["GoldenrodCityMoveTutorFarewellKidText"] = "¡Uajajaja!\n¡Adiós!",
  ["GoldenrodCityMoveTutorHmTooBadText"] = "Mm, qué mal. Tendré\nque coger algo\vde dinero\vde casa…",
  ["GoldenrodCityMoveTutorIfYouUnderstandYouveMadeItText"] = "Si comprendes lo\nincreíble de este\fmovimiento, tu entrenamiento\nserá de alto\fnivel.",
  ["GoldenrodCityMoveTutorWhichMoveShouldITeachText"] = "¡Uajajaja! ¡No\nlo lamentarás!\f¿Qué movimiento\ndebo enseñar?",
  ["GoldenrodCityMoveTutorYouDontHaveEnoughCoinsText"] = "…No tienes\nsufi- cientes\vfichas…",
  ["GoldenrodCityNameRaterSignText"] = "INSPECTOR DE MOTES\fEvalúa los motes\nde tus POKéMON",
  ["GoldenrodCityPokeComCenterSignText"] = "¡Consejos móviles!\nCENTRO #COM",
  ["GoldenrodCityPokefanMText"] = "Han construido una\nTORRE RADIO nueva\fque sustituye\na la antigua.",
  ["GoldenrodCityRadioTowerSignText"] = "TORRE RADIO\nDE CIUDAD\vTRIGAL",
  ["GoldenrodCityRocket1Text"] = "¡Fuera de mi camino!\n¡Vete!",
  ["GoldenrodCityRocket2Text"] = "Asaltemos la TORRE\nRADIO… ¿Qué?\f¡Y a ti qué\nte importa!",
  ["GoldenrodCityRocket3Text"] = "¿Los POKéMON?\n¡Sólo son herramientas\fpara ganar\ndinero!",
  ["GoldenrodCityRocket4Text"] = "Nuestro sueño se\ncumplirá pronto…\fHa sido una lucha\ntan larga…",
  ["GoldenrodCityRocket5Text"] = "¡Eh, tú! ¡No recuerdo\ntu cara! ¡Lárgate!\v",
  ["GoldenrodCityRocket6Text"] = "¡Prueba el verdadero\nterror del TEAM\vROCKET!",
  ["GoldenrodCityRocketScoutText1"] = "Así que ésta es\nla TORRE RADIO…",
  ["GoldenrodCityRocketScoutText2"] = "¿Qué quieres,\neh? ¡Fuera!",
  ["GoldenrodCitySignText"] = "CIUDAD TRIGAL\nLa alegre ciudad\fde rico\nencanto",
  ["GoldenrodCityStationSignText"] = "ESTACIÓN\nDE CIUDAD\vTRIGAL",
  ["GoldenrodCityUndergroundSignNorthText"] = "ENTRADA SUBTERRÁNEA\n",
  ["GoldenrodCityUndergroundSignSouthText"] = "ENTRADA SUBTERRÁNEA\n",
  ["GoldenrodCityYoungster1Text"] = "Sé que hay una\nnueva TIENDA DE\fBICIS, pero no\nla encuentro.",
  ["GoldenrodCityYoungster2Text"] = "¡Je, je, je…! Me\fhe metido en líos\npor jugar en el\fsótano del CENTRO\nCOMERCIAL.",
  ["GoldenrodDeptStore1FBugCatcherText"] = "Mamá es experta\nen conseguir gangas.\fSiempre compra\ncosas a precios\vmás bajos.",
  ["GoldenrodDeptStore1FDirectoryText"] = "PB INFORMACIÓN P1\fTIENDA DE    ENTRENADORES\nP2 ARTÍCULOS\fDE COMBATE P3\nBOTIQUÍN P4 TIENDA\fDE MT P5 PLAZA\fTRANQUILA\fMIRADOR",
  ["GoldenrodDeptStore1FGentlemanText"] = "El CENTRO COMERCIAL\ntiene buenos\vartículos. Pero\falgunos objetos\nsólo se consiguen\fen el CASINO.\n",
  ["GoldenrodDeptStore1FPokefanFText"] = "¡Me encanta ir\nde compras!",
  ["GoldenrodDeptStore1FReceptionistText"] = "Éste es el CENTRO COMERCIAL\nde CIUDAD TRIGAL.",
  ["GoldenrodDeptStore2FCooltrainerFText"] = "Conseguí mi ABRA\nen el CASINO. Ahora\fes mi mejor\ncompañero.",
  ["GoldenrodDeptStore2FDirectoryText"] = "Tu Compañero\nde Viaje P1 TIENDA\fDE    ENTRENADORES\n",
  ["GoldenrodDeptStore2FGentlemanText"] = "Este CENTRO COMERCIAL\nindica que CIUDAD\fTRIGAL es muy\ngrande. Su gama\fde productos\nno tiene\vrival.",
  ["GoldenrodDeptStore2FUnusedText1"] = "Vendemos objetos\npara los POKéMON.\vEsto es\fun regalo.\nDáselo\va un POKéMON.\v",
  ["GoldenrodDeptStore2FUnusedText2"] = "Si equipas\na tus POKéMON\vcon objetos,\fpodrías\nsalir ganando\ven el\vcombate.\v",
  ["GoldenrodDeptStore2FYoungsterText"] = "El POKéGEAR puede\nalmacenar hasta\vdiez números. Es\fdifícil decidir\nqué números debes\vguardar.",
  ["GoldenrodDeptStore3FDirectoryText"] = "Para los amantes\nde la victoria\fP2 ARTÍCULOS\n  DE COMBATE",
  ["GoldenrodDeptStore3FRockerText"] = "¡Eh! ¿Utilizas\nESPECIAL X cuando\vluchas? ¡Es increíble!\f¡Aumenta los\nATAQUES ESPECIALES!\v",
  ["GoldenrodDeptStore3FSuperNerdText"] = "¡Yo, yo, yo soy muy\n¡impaciente! Usa SPEED X en combate para\ndale velocidad a mi POKéMON.",
  ["GoldenrodDeptStore4FBugCatcherText"] = "El HIERRO mejora\nsu DEFENSA.",
  ["GoldenrodDeptStore4FCooltrainerMText"] = "Me encantan los\nPOKéMON fuertes.\fLes doy PROTEÍNAS\npara mejorar\vsu ATAQUE.",
  ["GoldenrodDeptStore4FDirectoryText"] = "¡Fortalecemos\na tus POKéMON!\fP3 BOTIQUÍN",
  ["GoldenrodDeptStore4FGameboyKidText"] = "Algunos POKéMON\nsólo evolucionan\fal intercambiarlos\ncon el Game Link.\fPor ejemplo: MACHOKE,\nKADABRA, HAUNTER\fy GRAVELER.\nDicen que\fhay otros\ntambién.",
  ["GoldenrodDeptStore5FCarrieMysteryGiftExplanationText"] = "REGALO MISTERIOSO. Con\fun simple bip, recibes\nun regalo. Búscalo\ven el menú.",
  ["GoldenrodDeptStore5FCarrieMysteryGiftRequiresGBCText"] = "La opción REGALO MISTERIOSO\nes para Game\vBoy Color.",
  ["GoldenrodDeptStore5FDirectoryText"] = "Personaliza a\ntus POKéMON P4\fTIENDA DE MT",
  ["GoldenrodDeptStore5FLassText"] = "Los domingos,\nUna señora viene a ver POKéMON.\fIncluye regalo\nMT!",
  ["GoldenrodDeptStore5FPokefanMText"] = "No puedes cambiar\nel nombre de un POKéMON\vque has intercambiado.\fEl nombre refleja\nlos sentimientos\fdel entrenador\noriginal.",
  ["GoldenrodDeptStore5FReceptionistItLooksEvilHowAboutThisTMText"] = "Parece malvado.\n¿Qué te parece esta\vMT para él?",
  ["GoldenrodDeptStore5FReceptionistItsAdorableText"] = "¡Es adorable!\fEnséñale unas\npotentes MT.",
  ["GoldenrodDeptStore5FReceptionistOhYourMonDotDotDotText"] = "Hola. ¡Oh, tu\nPOKéMON…!",
  ["GoldenrodDeptStore5FReceptionistThereAreTMsPerfectForMonText"] = "Seguro que hay\nMT que serían\fperfectas para\ntus POKéMON.",
  ["GoldenrodDeptStore5FReceptionistThisMoveShouldBePerfectText"] = "Está muy unido\na ti. Este movimiento\fsería perfecto\npara vosotros.\v",
  ["GoldenrodDeptStore6FDirectoryText"] = "¡Descansa de las\ncompras! P5 PLAZA\fTRANQUILA",
  ["GoldenrodDeptStore6FLassText"] = "¿Escuchas el CANAL\nde la SUERTE?\fSi quieres ganar,\ncambia POKéMON\fcon mucha gente\npara conseguir\fmuchos números\nID.",
  ["GoldenrodDeptStore6FSuperNerdText"] = "Si te cansas, prueba\nlas bebidas de\vlas máquinas.\fA tus POKéMON\nles gustarán.",
  ["GoldenrodDeptStoreB1FBlackBelt1Text"] = "¡Eh, tú! ¡Estás\ninterrumpiéndonos!\f¡Tenemos por costumbre\ntrabajar sin\fque nadie\nnos vea!",
  ["GoldenrodDeptStoreB1FBlackBelt2Text"] = "Pierdo las ganas\nde trabajar si hay\valguien mirando.\f¡Venga, tú, fuera\nde aquí!",
  ["GoldenrodDeptStoreB1FBlackBelt3Text"] = "¡Oohah! ¡Oohah!\fHay cosas tiradas\npor el suelo.\f¡Recógelas si\nquieres!",
  ["GoldenrodDeptStoreRoofBugCatcherText"] = "Mis POKéMON quedan\nparalizados o envenenados\fcuando menos\nlo esperas… Así\fque vine a comprar\fCURA TOTAL.\nMe pregunto\fsi aún quedará…\n",
  ["GoldenrodDeptStoreRoofFisherText"] = "¿Perdona? ¿Quién dijo\nque un adulto no podía\vmeterse en esto?\f¡Voy a volver todos\nlos días para coleccionar\ftodos los\nmuñecos!",
  ["GoldenrodDeptStoreRoofPokefanFText"] = "Uf, estoy cansada.\nA veces vengo\fa la azotea\na tomarme\fun respiro.\n",
  ["GoldenrodDeptStoreRoofPokefanMText"] = "Hay algo que quiero\nrealmente, pero\fno tengo el dinero\nsuficiente… Es\fposible que venda\nlas BAYAS que\vhe recogido…",
  ["GoldenrodDeptStoreRoofSuperNerdOhWowText"] = "¡Oh, uau!",
  ["GoldenrodDeptStoreRoofSuperNerdQuitBotheringMeText"] = "¿Vas a dejarme\nen paz?",
  ["GoldenrodDeptStoreRoofTeacherText"] = "¡Oh, todo está\ntan barato! ¡Compré\ftanto que mi\nMOCHILA está\vabarrotada!",
  ["GoldenrodDeptStoreRoofTwinText"] = "Aquí suelen\ntener gangas\va menudo.",
  ["GoldenrodDeptStoreSignText"] = "¡Una gran gama\nde artículos POKéMON!\fCENTRO COMERCIAL\nDE CIUDAD\vTRIGAL",
  ["GoldenrodFlowerShopFloriaItReallyWasAMonText"] = "¡Entonces era\nun POKéMON!",
  ["GoldenrodFlowerShopFloriaWonderIfSisWillLendWaterBottleText"] = "Cuando le conté\na mi hermana lo\fdel extraño árbol,\nme dijo que\vera peligroso.\fSi venzo a BLANCA,\nes posible\fque me preste\nsu REGADERA…\v",
  ["GoldenrodFlowerShopFloriaYouBeatWhitneyText"] = "Uuau, ¿venciste a\nBLANCA? ¡Genial!",
  ["GoldenrodFlowerShopTeacherAskWantToBorrowWaterBottleText"] = "¿Quieres llevarte\nla REGADERA? No\fquiero que cometas\nninguna impruden-\fcia con\nella.",
  ["GoldenrodFlowerShopTeacherDontDoAnythingDangerousText"] = "¡No hagas nada\npeligroso!",
  ["GoldenrodFlowerShopTeacherHeresTheSquirtbottleText"] = "Oh, eres mejor\nque BLANCA…\fEntonces vale.\n¡Aquí tienes\vla REGADERA!\v",
  ["GoldenrodFlowerShopTeacherLalalaHavePlentyOfWaterText"] = "Lalala, lalalala.\n¡Échale mucha\vagua, cariño!",
  ["GoldenrodFlowerShopTeacherMySisterWentToSeeWigglyTreeRoute36Text"] = "¿Has visto ese\nextraño árbol\fque crece en la\nRUTA 36? Mi hermana\fsintió curiosidad\ny salió a verlo…\fEstoy preocupada…\n¿No es\fpeligroso?\n",
  ["GoldenrodGameCornerCooltrainerFText"] = "¡No pararé hasta\nque gane!",
  ["GoldenrodGameCornerCooltrainerMText"] = "Vivir es un juego\ny yo jugaré hasta\vel final.",
  ["GoldenrodGameCornerGentlemanText"] = "Enseñé VENTISCA\na mi POKéMON. Ha\fsido difícil ganar\nbastantes fichas,\fpero ha merecido\nla pena.",
  ["GoldenrodGameCornerLeftTheirDrinkText"] = "Alguien se dejó\nla bebida. Huele\fdulce.",
  ["GoldenrodGameCornerPharmacistText"] = "Yo siempre juego\nen esta máquina.\fGano más fichas\nque en otras.",
  ["GoldenrodGameCornerPokefanFText"] = "Las cartas… Las\fprefiero a las\ntragaperras porque\fson más fáciles\nde acertar. Pero\fse gana mucho\nmenos.",
  ["GoldenrodGameCornerPokefanM1Text"] = "Me encanta esta\nnueva tragaperras.\fEs más difícil\nque las de C.\vAZULONA.",
  ["GoldenrodGameCornerPokefanM2Text"] = "No gané en las\ntragaperras y\flo perdí todo\nen las cartas…\fMe enfadé tanto\nque tiré mi MONEDERO\fal SUBTERRÁNEO.\n",
  ["GoldenrodGameCornerPrizeVendorConfirmPrizeText"] = ". ¿De acuerdo?\n",
  ["GoldenrodGameCornerPrizeVendorHereYouGoText"] = "¡Aquí tienes!",
  ["GoldenrodGameCornerPrizeVendorIntroText"] = "¡Hola! ¡Aquí cambiamos\ftus fichas por\npremios fabulosos!\v",
  ["GoldenrodGameCornerPrizeVendorNeedMoreCoinsText"] = "¡Vaya! ¡Necesitas\nmás fichas!",
  ["GoldenrodGameCornerPrizeVendorNoCoinCaseText"] = "¡Vaya! No tienes\nMONEDERO.",
  ["GoldenrodGameCornerPrizeVendorNoMoreRoomText"] = "Lo siento. No tienes\nmás sitio.",
  ["GoldenrodGameCornerPrizeVendorQuitText"] = "Vale. ¡Guarda tus\nfichas y vuelve\vcuando quieras!",
  ["GoldenrodGameCornerPrizeVendorWhichPrizeText"] = "¿Qué premio\nquieres?",
  ["GoldenrodGymGuideText"] = "¡Eh! ¡FUTURO\nCAMPEÓN!\fEste GIMNASIO es\npara entrenadores\vde POKéMON normales.\fTe recomiendo usar\nPOKéMON de tipo\vlucha.",
  ["GoldenrodGymGuideWinText"] = "¿Has ganado? ¡Genial!\fEstaba ocupado\nmirando a las chicas.",
  ["GoldenrodGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vTRIGAL: BLANCA\v¡La increíble\fy bella señorita!\n",
  ["GoldenrodHappinessRaterPokefanMText"] = "No dejo de perder\nen los combates y\fmis POKéMON acaban\ndesmayándose… Quizá\fsea ésa la razón\npor la que no\vles gusto…",
  ["GoldenrodHappinessRaterTeacherText"] = "Si tratas bien\na tus POKéMON,\fellos te querrán.\n¿Eh? Déjame\fver tu\n@ …",
  ["GoldenrodHappinessRaterTwinText"] = "Si uso un objeto\n¡Con mi POKéMON eres feliz!",
  ["GoldenrodHappinessRatingText_LooksMean"] = "Da la impresión de\nque no le gustas.\vParece malvado.",
  ["GoldenrodHappinessRatingText_LovesYouALot"] = "¡Parece muy feliz!\nTe debe de querer\vmucho.",
  ["GoldenrodHappinessRatingText_NotUsedToYou"] = "Deberías tratarlo\nmejor. No está acostumbrado\va ti.",
  ["GoldenrodHappinessRatingText_QuiteCute"] = "Es bastante mono.",
  ["GoldenrodHappinessRatingText_ReallyTrustsYou"] = "Me parece que\nconfía mucho\ven ti.",
  ["GoldenrodMagnetTrainStationGentlemanText"] = "Soy el PRESIDENTE.\fMi sueño era crear\nun tren que fuera\fmás rápido que cualquier\nPOKéMON. Hace\fque JOHTO esté\nmucho más cerca\vde KANTO.",
  ["GoldenrodMagnetTrainStationOfficerAreYouComingAboardText"] = "Pronto saldremos\npara C. AZAFRÁN.\f¿Quiere\nsubir?",
  ["GoldenrodMagnetTrainStationOfficerArrivedInGoldenrodText"] = "Hemos llegado\na CIUDAD TRIGAL.\fSiempre a su\nservicio.",
  ["GoldenrodMagnetTrainStationOfficerHopeToSeeYouAgainText"] = "Siempre a su\nservicio.",
  ["GoldenrodMagnetTrainStationOfficerRightThisWayText"] = "Por favor, ¿puedo\nver su PASE? Muy\fbien. Pase por aquí,\npor favor.",
  ["GoldenrodMagnetTrainStationOfficerTheTrainHasntComeInText"] = "El tren no ha llegado…\n¡Tengo una idea!\f¡Llevaré a cuestas\na los pasajeros!\vAunque no creo\fque funcione.",
  ["GoldenrodMagnetTrainStationOfficerYouDontHaveARailPassText"] = "Lo siento, pero\nno tiene PASE.",
  ["GoldenrodPPSpeechHouseFisherText"] = "Un día estaba\nluchando y mis\fPOKéMON no se\npodían mover.\fSus movimientos\nno tenían ningún\fPUNTO de PODER\no PP.",
  ["GoldenrodPPSpeechHouseLassText"] = "A veces, un POKéMON\nsano no puede\fusar sus movimientos.\nSi ocurre esto,\fcúralo en el\nCENTRO POKéMON\vo usa un\vobjeto.",
  ["GoldenrodPokecenter1FAskGiveAwayAnEonMailText"] = "¿Entregas una\nCARTA EÓN?",
  ["GoldenrodPokecenter1FGameboyKidText"] = "En el COLISEO\nde arriba se\flucha enlazado.\nLos récords se\fapuntan en la\npared, así\fque no puedo\nperder.",
  ["GoldenrodPokecenter1FLassText"] = "Un POKéMON de nivel\nsuperior no siempre\vgana. Aun así,\fsu tipo puede\ntener alguna desventaja.\vNo creo que\fhaya un único\nPOKéMON que\fsea el más\nfuerte.",
  ["GoldenrodPokecenter1FPlayerGaveAwayTheEonMailText"] = "{PLAYER} entrega\nla CARTA EÓN.",
  ["GoldenrodPokecenter1FPokefanFAnotherTimeThenText"] = "Oh… Bueno, en otra\nocasión será.",
  ["GoldenrodPokecenter1FPokefanFDaughterWillBeDelightedText"] = "¡A mi hija le\n¡Se deleitará!",
  ["GoldenrodPokecenter1FPokefanFDoYouHaveEonMailText"] = "Llevas mucho peso\nen la mochila!\f¡Oye! no tendrás\nalgo llamado CARTA EÓN? mi hija esta buscando\nuno. ¿Puedes darme uno?\ncierto?",
  ["GoldenrodPokecenter1FPokefanFThisIsForYouText"] = "¡Oh, genial! ¡Gracias,\ncariño! ¡Toma\festo en agradecimiento!\n",
  ["GoldenrodPokecenter1FPokefanFTooBadText"] = "¿Oh? ¿No tienes?\nQué lástima…",
  ["GoldenrodPokecenter1FWeHopeToSeeYouAgainText_2"] = "Esperamos te ver\nde novo.",
  ["GoldenrodUndergroundBasementKeyOpenedDoorText"] = "Puerta abierta con\nLLAVE del SÓTANO.",
  ["GoldenrodUndergroundNoEntryText"] = "PROHIBIDO PASAR\nDE ESTE PUNTO",
  ["GoldenrodUndergroundOlderHaircutBrotherAllDoneText"] = "¡Bien! ¡Ya está!",
  ["GoldenrodUndergroundOlderHaircutBrotherAskWhichMonText"] = "¿A qué POKéMON le\ncorto el pelo?",
  ["GoldenrodUndergroundOlderHaircutBrotherOfferHaircutText"] = "¡Hola! ¡Dirijo PELUQUERÍA POKéMON!\nSoy el alcalde y el mejor de ellos.\nPELUQUEROS HERMANOS.\vPuedo agregar guapos a tu POKéMON\npor sólo 500¥.\v¿Quieres que te los corte?\n¿Él pelaje?",
  ["GoldenrodUndergroundOlderHaircutBrotherOneHaircutADayText"] = "Sólo corto el pelo\nuna vez al día. Ya\vvale por hoy.",
  ["GoldenrodUndergroundOlderHaircutBrotherThatsAShameText"] = "¿De verdad?\n¡Qué pena!",
  ["GoldenrodUndergroundOlderHaircutBrotherWatchItBecomeBeautifulText"] = "¡Vale! ¡Verás lo\nbien que queda!",
  ["GoldenrodUndergroundOlderHaircutBrotherYoullNeedMoreMoneyText"] = "Necesitarás\nmás dinero.",
  ["GoldenrodUndergroundSwitchRoomEntrances_SuperNerdText"] = "me retaron a\nuna pelea en el piso inferior.\fAhí abajo son muy\nduro. Ten mucho cuidado.",
  ["GoldenrodUndergroundSwitchRoomEntrances_TeacherText"] = "Abajo hay algunas\ntiendas… Pero\ftambién hay entrenadores.\nMe da miedo\fbajar\nahí.",
  ["GoldenrodUndergroundTheDoorIsOpenText"] = "Puerta abierta.",
  ["GoldenrodUndergroundTheDoorsLockedText"] = "Puerta cerrada…",
  ["GoldenrodUndergroundWeAreNotOpenTodayText"] = "Lo siento, hemos\ncerrado.",
  ["GoldenrodUndergroundYoungerHaircutBrotherAllDoneText"] = "¡Muy bien!\n¡Ya está!",
  ["GoldenrodUndergroundYoungerHaircutBrotherAskWhichMonText"] = "¿A qué POKéMON le\ncorto el pelo?",
  ["GoldenrodUndergroundYoungerHaircutBrotherHowDisappointingText"] = "¿No? ¡Qué\nlástima!",
  ["GoldenrodUndergroundYoungerHaircutBrotherIllMakeItLookCoolText"] = "¡Vale! Ya verás lo\nbien que queda.",
  ["GoldenrodUndergroundYoungerHaircutBrotherOfferHaircutText"] = "Bienvenido a\nla PELUQUERIA!\fsoy el mas joven\ny el más novato de los HERMANOS PELUQUEROS. Pondré guapos a tus\nPOKéMON por sólo 300¥. ¿Qué dices?",
  ["GoldenrodUndergroundYoungerHaircutBrotherOneHaircutADayText"] = "Sólo corto el pelo\nuna vez al día. Perdona,\fpero hoy no trabajo\nmás.",
  ["GoldenrodUndergroundYoungerHaircutBrotherShortOnFundsText"] = "No te queda mucho\ndinero.",
  ["GoldenrodVendingNoMoneyText"] = "¡Uups! No tienes\nbastante dinero.",
  ["GoldenrodVendingNoSpaceText"] = "No hay sitio para\nnada más.",
  ["GoldenrodVendingText"] = "¡Una máquina\nexpendedora!",
  ["GotElmsNumberText"] = "{PLAYER} anotó el\nnúmero de ELM.",
  ["GotMapCardText"] = "¡Ahora el POKéGEAR de {PLAYER}\ntiene un MAPA!",
  ["GruntF1AfterBattleText"] = "¡Las COLAS de los SLOWPOKE\nse regeneran rápido!\f¿Qué hay de malo\nen venderlas?",
  ["GruntF1BeatenText"] = "¡Maldición!",
  ["GruntF1SeenText"] = "¿No más COLAS? ¡Claro!\f¡Intenta vencernos\na todos!",
  ["GruntF2AfterBattleText"] = "Me ganaste y no lo hiciste\n¡Creo que lo olvido!",
  ["GruntF2SeenText"] = "¡Ja, ja, ja! ¡Qué\faburrimiento!\n¡Fue tan sencillo\fapoderarse de\neste lugar!\f¡Venga, entretenme!\n",
  ["GruntF3AfterBattleText"] = "¡Ve adonde quieras!\n¡Lárgate! ¡No\vme importa!",
  ["GruntF3SeenText"] = "¿Te has perdido?\nNo, es imposible.\fNo pareces\ntener miedo.\f¡Te daré algo\nque te asustará!\v",
  ["GruntF4AfterBattleText"] = "¡Me amo a mí\nmisma! ¿Qué\fimportan los\nPOKéMON?",
  ["GruntF4BeatenText"] = "¡Oh, no! ¡Son\ntan inútiles!",
  ["GruntF4SeenText"] = "¿Son buenos mis\nPOKéMON? ¡Creeré\fque mis POKéMON\nson buenos cuando\fderroten a\nlos tuyos!",
  ["GruntF5AfterBattleText"] = "La contraseña de la\noficina del jefe\fes… COLASLOWPOKE.\fPero no te servirá\nde nada si no tienes\vlas dos.",
  ["GruntF5BeatenText"] = "Muy bien. Espera.\nTe la diré.",
  ["GruntF5SeenText"] = "¿Conozco yo la\ncontraseña? A\flo mejor. ¡Pero\fnadie débil\nla sabrá!",
  ["GruntM10AfterBattleText"] = "¡Increíble! ¡He\nperdido!",
  ["GruntM10BeatenText"] = "¡No! ¡Increíble!",
  ["GruntM10SeenText"] = "¿Quieres rescatar al\nDIRECTOR? ¡Pues ya\fte puedes ir olvidando\nde eso, porque te\vvoy a ganar!",
  ["GruntM11AfterBattleText"] = "Tampoco lo sé… Primero\nhay que pulsar\fel último botón,\npero…",
  ["GruntM11BeatenText"] = "¡Caramba! ¡Perdí por\nmi indecisión!",
  ["GruntM11SeenText"] = "Una puerta se abre\ny otra se cierra.\f¡Seguro que no consigues\nllegar!",
  ["GruntM13AfterBattleText"] = "Debes de tener hielo en\nlas venas para enfrentarte\val TEAM ROCKET.",
  ["GruntM13BeatenText"] = "¡Seguro! Te crees\ngenial, ¿verdad?",
  ["GruntM13SeenText"] = "¡Qué me importa\nsi te has perdido!\fApareciste aquí,\n¡eres sólo una\vvíctima!",
  ["GruntM14AfterBattleText"] = "He perdido…\f¡Perdóname,\nGIOVANNI!",
  ["GruntM14SeenText"] = "¡No vas a ir más\nlejos! ¡Soy implacable\fcon mis enemigos\ny con cualquier\vjoven!",
  ["GruntM15AfterBattleText"] = "¡Ji, ji, ji! ¡Vaya\ncombate! ¡No\vte olvidaré!",
  ["GruntM15BeatenText"] = "¡Ji, ji, ji! ¿Así\nfuncionas?",
  ["GruntM15SeenText"] = "¡Ji, ji, ji! ¡Te\nrecuerdo! ¡Me\fdiste bien en\nla guarida!",
  ["GruntM16AfterBattleText"] = "Yo ni siquiera\nsé dónde están\vlas trampas. Tendrás\fque ser muy\nvaliente y\vcaminar.",
  ["GruntM16SeenText"] = "¡Je, je! ¿Te crees\ncon suerte? Adelante,\fda otro paso.\n¡El suelo está\flleno de\ntrampas!",
  ["GruntM17AfterBattleText"] = "¿Qué? Soy sólo\nun SOLDADO. Y no\fconozco la contraseña.\nLo siento\vpor ti.",
  ["GruntM17SeenText"] = "¿No se abre la\npuerta? Bueno,\fnecesitas una contraseña\nque sólo conoce\fel TEAM\nROCKET.",
  ["GruntM18AfterBattleText"] = "En mi última misión\ntambién fui derrotado\vpor alguien tan joven.\fCuando estábamos\nsecuestrando unos\fPOKéMON, un chico\npelirrojo y de\fextraña mirada\nme machacó…",
  ["GruntM18SeenText"] = "¡Oh! ¿Tan joven?\nNo me gusta,\fpero debo eliminarte.\n",
  ["GruntM19AfterBattleText"] = "¡Oye! Sólo el jefe\nconoce la clave de\vesa puerta. ¿Dónde\festá el jefe? ¡Quién\nsabe! Encuéntralo\vtú.",
  ["GruntM19SeenText"] = "¡Tú! ¡Pequeño parásito\npodrido!",
  ["GruntM1BeatenText"] = "Lo hiciste bien hoy,\npero… ¡espera a\vla próxima vez!",
  ["GruntM1SeenText"] = "¿Qué quieres? ¡Si\fnos molestas,\nno esperes misericordia!\v",
  ["GruntM24AfterBattleText"] = "El equipo cohete\nSeguiremos esperando el regreso de GIOVANNI. veremos que pasa\nnecesario.",
  ["GruntM24BeatenText"] = "Acabó conmigo…",
  ["GruntM25AfterBattleText"] = "Bien. ¡Una pista! Cambia\fel orden al pulsar\nlos botones y cambiará\fla forma en que se\nabren y se cierran\vlas puertas.",
  ["GruntM25SeenText"] = "¡Ajajaja! ¿Te\flías con tanta\nllave? ¡Te contaré\fun secreto\nsi logras\vvencerme!",
  ["GruntM28AfterBattleText"] = "¡Ji, ji, ji! La contraseña\fde la oficina del\njefe es… ¡Eh…!\fCreo que es COLARATICATE.\n",
  ["GruntM28BeatenText"] = "¡Ji, ji, ji! ¡Se\nte da bien!",
  ["GruntM28SeenText"] = "¡Je, je, je! ¿Me desafiarías a una pelea?\n¡Bah! ¡Es una locura, pero todavía lo tienes!\n¡Eso es lo que me gusta!\fSi me ganas te diré la contraseña\n¡De la oficina del jefe!",
  ["GruntM29AfterBattleText"] = "Sí, hemos estado\ncortando las colas\fde los SLOWPOKE\ny vendiéndolas.\fLo hacemos sólo\npor dinero. ¡Así\fes! Somos el TEAM\nROCKET, ¡y haríamos\flo que fuera\npor dinero!",
  ["GruntM29BeatenText"] = "¡Arrg! ¡Hoy no\nes mi día!",
  ["GruntM29SeenText"] = "¡Maldición! Estaba\nde guardia arriba\fcuando un viejo\nmemo me gritó. Me\fasusté tanto que\nme caí aquí abajo.\v¡Creo que voy\fa desahogar mi\nira luchando\vcontra ti!",
  ["GruntM2AfterBattleText"] = "Necesitamos pasta,\n¿pero vendiendo COLAS\vde SLOWPOKE? ¡Es\fmuy duro ser un\nSOLDADO ROCKET!",
  ["GruntM2BeatenText"] = "Simplemente…\nMuy fuerte…",
  ["GruntM2SeenText"] = "¿Dejar de cortar las\nCOLAS de los SLOWPOKE?\f¡Obedecerte arruinaría\nla reputación del\vTEAM ROCKET!",
  ["GruntM3AfterBattleText"] = "Eres muy fuerte. Arruinarías\fnuestros planes.\nMejor alertar\va los otros…",
  ["GruntM3BeatenText"] = "¡Demasiado fuerte!\nTe vigilaremos…",
  ["GruntM3SeenText"] = "¡Por fin nos hemos\napoderado de la\vTORRE RADIO! ¡Ahora\ftodos experimentarán\nel verdadero terror\fdel TEAM ROCKET!\n¡Ya veréis\fqué horribles\nsomos!",
  ["GruntM4AfterBattleText"] = "¡No permitiremos\nque arruines nuestros\vplanes!",
  ["GruntM4BeatenText"] = "¡Bah! ¡No vayas de\nperdonavidas!",
  ["GruntM4SeenText"] = "Hace tres años, el\nTEAM ROCKET tuvo que\vsepararse. ¡Pero nos\festamos volviendo\na reunir aquí!",
  ["GruntM5AfterBattleText"] = "No siempre somos\nmalos. Hacemos lo\vque queremos.",
  ["GruntM5BeatenText"] = "¿Te crees invencible?\n",
  ["GruntM5SeenText"] = "¡Somos el TEAM ROCKET,\nexplotadores de los\vPOKéMON! ¡Nos gusta\fser malos! ¿Damos\nmiedo?",
  ["GruntM6AfterBattleText"] = "Nuestros EJECUTIVOS\nquieren hacerse\vcon este lugar.\fTienen grandes\nplanes. ¿Cuáles\vserán?",
  ["GruntM6BeatenText"] = "¡Arggh! Me rindo.",
  ["GruntM6SeenText"] = "¡Oye! ¡Fuera de\nnuestro camino!",
  ["GruntM7AfterBattleText"] = "No he cumplido\ncon mi deber…\fMe van a bajar\nel sueldo…",
  ["GruntM7SeenText"] = "He recibido órdenes.\n¡Aplastaré a\ftodo aquel que\ndesafíe al TEAM\vROCKET!",
  ["GruntM8AfterBattleText"] = "¡No me gusta\nperder! ¡Odio\fa los POKéMON\ninútiles!",
  ["GruntM8BeatenText"] = "¿Bromeas?",
  ["GruntM8SeenText"] = "Me encanta ordenar\na los POKéMON que\vcometan delitos.",
  ["GruntM9AfterBattleText"] = "¿Qué? ¿Esquivaste\na nuestros hombres\vdel SUBTERRÁNEO? ¿Cómo\flo hiciste?",
  ["GruntM9BeatenText"] = "¡Es mi fin!",
  ["GruntM9SeenText"] = "¿Por qué se abrió\nla puerta? ¿Acaso\fhas tenido algo\nque ver?",
  ["GuideGentGiftText"] = "Llegamos… ¡Ésta\fes mi casa! Gracias\npor tu compañía.\vDéjame que te\fdé un pequeño\nregalo.",
  ["GuideGentIntroText"] = "Empezaste hace poco,\n¿verdad? ¡Estoy\vseguro! ¡Está bien!\f¡Todo el mundo\nes novato alguna\vvez! Si quieres,\fte puedo enseñar\nalgunas\vcosas.",
  ["GuideGentMartText"] = "Esto es una TIENDA\nPOKéMON. Hay POKé\fBALL para capturar\nPOKéMON salvajes\fy otras muchas\ncosas.",
  ["GuideGentNoText"] = "Oh… Disfruto haciéndolo…\nBueno. Vuelve\fa verme cuando\nquieras.",
  ["GuideGentPokecenterText"] = "Esto es un CENTRO\nPOKéMON. Aquí curan\fa tus POKéMON.\nVas a necesitar\fmucho de ellos,\nasí que es mejor\fconocerlos\nbien.",
  ["GuideGentPokegearText"] = "El POKéGEAR será\nmás útil cuando\vañadas TARJETAS.\f¡Mucha suerte en\ntu aventura!",
  ["GuideGentRoute30Text"] = "La RUTA 30 está\npor aquí. En ella\fluchan los entrenadores\ncon sus queridos\fPOKéMON.\n",
  ["GuideGentSeaText"] = "Como puedes ver,\nesto es el mar.\fAlgunos POKéMON\nsólo viven en\vel agua.",
  ["GuideGentTourText1"] = "¡De acuerdo!\n¡Sígueme!",
  ["GuideGentsHouseGuideGentText"] = "¡Cuando era niño,\nera un brillante\ventrenador! Éste\fes mi consejo:\n¡atrapa muchos\vPOKéMON! ¡Y trátalos\fcon mucho\ncariño!",
  ["GuideGentsHouseSignText"] = "CASA DEL GUÍA",
  ["GuitaristClydeAfterBattleText"] = "Hablando de la ESTACIÓN\nde RADIO, ¿cuál es el\fnúmero de la suerte\nde esta semana?",
  ["GuitaristClydeBeatenText"] = "¡Uauu! ¡Distorsión\ntotal!",
  ["GuitaristClydeSeenText"] = "Voy a una audición\nde mis canciones\fen la EMISORA de\nCIUDAD TRIGAL.",
  ["GuitaristVincentAfterBattleText"] = "Si funcionaran las\ntrampas del GIMNASIO,\fno lo habrías\nlogrado.",
  ["GuitaristVincentBeatenText"] = "¡Ooh! ¡Increíble!",
  ["GuitaristVincentSeenText"] = "El LT. SURGE reco-\nnoció mi potencial\fcon los POKéMON\neléctricos. ¿Crees\fque puedes\nvencerme?",
  ["HallOfFame_LanceText"] = "LANCE: Ha pasado mucho\ntiempo desde la última\vvez que vine aquí.\fAquí es donde honramos\na los CAMPEONES de\fla LIGA por toda\nla eternidad. Y a\fsus valerosos POKéMON\ntambién. Hoy, hemos\vsido testigos de\fla aparición de\nun nuevo CAMPEÓN\fde la LIGA, alguien\nque ha creído y\fha sabido confiar\nen sus POKéMON.\fAlguien que ha\nlogrado el éxito\fgracias a la perseverancia\ny la determinación.\f¡Un nuevo triunfo\nen la LIGA, conseguido\fcon grandeza!\n¡{PLAYER},\fpermite que\nte registre\fa ti y a tus\ncompañeros\fcomo CAMPEONES!\n",
  ["HappinessText1"] = "No has domesticado\na tu POKéMON. Si\fno eres amable, éste\nse enfadará.",
  ["HappinessText2"] = "Cuanto más tiempo\npases con los\fPOKéMON, más\nte querrán.",
  ["HappinessText3"] = "¡Uauu! ¡Tú y tus\nPOKéMON estáis\vmuy unidos!",
  ["HaveGoodRodText"] = "¿Qué tal va todo?\n¿Pica el grande?",
  ["HiddenPowerGuyText1"] = "Te has perdido…\nYo he estado aquí\fmeditando y un\nnuevo poder ha\fna- cido dentro\nde mí. Déjame\fcompartir mi poder\ncon tus POKéMON.\fToma esto,\njoven.",
  ["HiddenPowerGuyText2"] = "¿Lo ves? ¡Es PODER\nOCULTO! Saca el\fpoder de los POKéMON\npara atacar.\vRecuerda: su\ftipo y poder\ndependen del\vPOKéMON que\vlo usa.",
  ["HiddenPowerGuyText3"] = "Estoy meditando…",
  ["HikerAnthony2AfterText"] = "Los MONTAÑEROS somos\nfelices en las\vmontañas.",
  ["HikerAnthony2BeatenText"] = "¡Guau! ¡Tienes más\nfuerza que yo!",
  ["HikerBaileyAfterBattleText"] = "Se acabó, pero no me\nimporta. Los MONTAÑEROS\vsomos así.",
  ["HikerBaileyBeatenText"] = "¡Me has demostrado\ntu poder!",
  ["HikerBenjaminAfterBattleText"] = "¡Pierde en tu posesión\nImporta si lo comparas con eso.\ncielo inmenso!",
  ["HikerBenjaminSeenText"] = "¡Ah! ¡Qué bien se\nestá fuera! ¡Me siento\vtan libre!",
  ["HikerDanielAfterBattleText"] = "Me obligaron a comprar\nuna COLA de SLOWPOKE.\vLo siento por\fel pobre\nPOKéMON.",
  ["HikerDanielBeatenText"] = "¡Uauu! ¡Me han\nmachacado!",
  ["HikerDanielSeenText"] = "¡Uauu! ¡Qué\nsorpresa! ¡No\fesperaba ver\na nadie!",
  ["HikerErikAfterBattleText"] = "Volveré a la RUTA\nHELADA de CIUDAD\fENDRINO y seguiré\nentrenándome.",
  ["HikerJimAfterBattleText"] = "¡La alergia me\nhace estornudar!\v¡AAACHÚS!",
  ["HikerKennyAfterBattleText"] = "Parece que las\nformas geológicas\vno cambian. Pero\fsí que cambian,\naunque poco\va poco.",
  ["HikerKennySeenText"] = "Debería ir al TÚNEL\nROCA para conseguir\vun ONIX.",
  ["HikerLeonardAfterBattleText"] = "Vivo aquí abajo.\fY tú también podrías\nsi quisieras.\fComo ves, hay\nmucho sitio.",
  ["HikerLeonardBeatenText"] = "¡Jajaja! Te gusta\npelear, ¿verdad?",
  ["HikerLeonardSeenText"] = "¡Qué sabes tú!\n¡Un visitante!",
  ["HikerMichaelAfterBattleText"] = "¡Cómo me gusta MÁS\nPS! ¡Mmmm! ¡Me\fbebo la de mis\nPOKéMON! No puedo\fevitarlo.",
  ["HikerMichaelBeatenText"] = "¡A mis POKéMON les\nfaltaron agallas!",
  ["HikerMichaelSeenText"] = "¡Eres valiente!\nPero… ¿Sabes\fqué? Para\nvaliente,\v¡yo!",
  ["HikerNolandAfterBattleText"] = "Me pregunto si en\nKANTO habrá montañas\fque valga la pena\nescalar.",
  ["HikerNolandBeatenText"] = "¡Es demasiado!\n",
  ["HikerNolandSeenText"] = "¿Estás aquí? ¡Pues\nluchemos!",
  ["HikerParry3BeatenText"] = "¡Buaaaaa! ¡Soy\nun perdedor!",
  ["HikerParry3SeenText"] = "¡Mis POKéMON son\nmuy poderosos!",
  ["HikerParryAfterBattleText"] = "No se me da muy\nbien pensar. ¡Así\fque utilizo sólo\nla fuerza!",
  ["HikerPhillipAfterBattleText"] = "Llevo perdido mucho\ntiempo… No es\fque me importe,\n¡pero estoy\vhambriento!",
  ["HikerRussellAfterBattleText"] = "¡Muy bien! Ya lo\nhe decidido. ¡No\fme iré hasta que\nmis POKéMON se\vfortalezcan!",
  ["HikerSidneyAfterBattleText"] = "La CENTRAL ENERGÍA\nestá al otro lado\vde un riachuelo.",
  ["HikerSidneyBeatenText"] = "¡Caray! He\nperdido…",
  ["HikerSidneySeenText"] = "Te contaré un\nsecreto. Pero\fprimero, ¡luchemos!\n",
  ["HikerTimAfterBattleText"] = "Los combates son cuestión\nde concentración.",
  ["HikerTimBeatenText"] = "Estaba ocupado\ncantando…",
  ["HikerTimSeenText"] = "Cuando venga, lo\nhará por MT. PLATEADO…\vMT. PLATEADO\festá en JOHTO,\n¿verdad?",
  ["HikerTimothyAfterBattleText"] = "Lo mejor que me\nha pasado nunca\ffue descubrir a\nlos POKéMON.",
  ["HikerTimothyBeatenText"] = "Las derrotas… ¡son\ninevitables!",
  ["HikerTimothySeenText"] = "¿Que por qué\nescalo montañas?\fPorque están\nahí. ¿Que por\fqué entreno\nPOKéMON? ¡Porque\festán\nahí!",
  ["HomepageText"] = "PÁGINA DE INICIO REVISTA POKéMON.\nNo ha sido actualizada…\f¡RADIO POKéMON! ¡Llámanos\ncon tus peticiones!",
  ["HouseForSaleSignText"] = "¿Qué es esto? Casa\fen venta… No\nvive nadie.",
  ["HurryUpElmIsWaitingText"] = "El PROF. ELM te\nestá esperando.\f¡Date prisa!",
  ["IcePathB2FMahoganySideBoulderText"] = "Está empotrado\nen el hielo.",
  ["IlexForestApprenticeAfterText"] = "¡Uauu! ¡Muchísimas\ngracias! El POKéMON\fde mi jefe no\nme obedecía porque\vno tengo MEDALLAS.\v",
  ["IlexForestApprenticeIntroText"] = "¡Vaya…! Mi jefe\nse va a poner furioso…\vSe me escapó el\fFARFETCH'D que\nCORTA árboles\fpara conseguir\ncarbón. No puedo\fir a buscarlo\nal ENCINAR.\vDemasiado grande\fy oscuro\npara mí…",
  ["IlexForestAzaleaGateGrannyText"] = "El ENCINAR está\nvigilado por\vsu guardián.\f¡No hagas nada\nmalo!",
  ["IlexForestAzaleaGateOfficerText"] = "El ENCINAR es muy\ngrande. ¡Cuidado!\vNo te pierdas.",
  ["IlexForestSignpostText"] = "Hay tantos árboles\nen el ENCINAR que\fno se ve ni el\ncielo. Por favor,\fbusca objetos\nque puedan haber\vcaído.",
  ["ImBehindYouText"] = "¡Vamos, {PLAYER}!\f¡Cuentas con toda\nmi ayuda!",
  ["IncenseBurnerText"] = "¿Qué es esto?\f¡Oh! ¡Es un\npebetero!",
  ["IndigoPlateauPokecenter1FCooltrainerMText"] = "En la LIGA POKéMON,\nserás puesto\fa prueba por\nel ALTO MANDO.\fDeberás vencerlos\na todos. ¡Si\fpierdes, volverás\na empezar!\v",
  ["IndigoPlateauSignText"] = "MESETA AÑIL ¡El objetivo\ffinal de los entrenadores!\nEl CG de la LIGA\fPOKéMON",
  ["InsertedTheCardKeyText"] = "{PLAYER} utiliza la LLAVE\nMAGNETICOS.",
  ["InstructionsNextText"] = "Los números están\nen la memoria.\fElige el nombre\nque quieras.\f¿No te parece\nestupendo?",
  ["IrwinRocketTakeoverRumorText"] = "¿{PLAYER}, te has\nenterado? ¡La TORRE\fRADIO de CIUDAD\nTRIGAL ha sido\ftomada por el\nTEAM ROCKET! Um…\f¿Qué es el TEAM\nROCKET?",
  ["IsItDSTText"] = "¿Es horario\nde verano?",
  ["ItemfinderExplanationText"] = "Por aquí hay muchos\nobjetos que no se\fven tan fácilmente.\nUtiliza el BUSCAOBJETOS\fpara saber si hay\nalgún objeto cerca.\fÉste no indica\nel lugar exacto,\fasí que tú tendrás\nque encontrarlo.\f¡Ah, sí! Dicen\nque hay muchos\fobjetos en\nTORRE QUEMADA\fde CIUDAD\nIRIS.",
  ["JanineText_ApplyMyself"] = "SACHIKO: Voy a\nesforzarme por\fmejorar mis habilidades.\n¡Quiero llegar\fa ser mejor\nque mi padre\vy que tú!",
  ["JanineText_DisappointYou"] = "¡Fufufufu…! Lo siento\fmucho… ¡Sólo bromeaba!\n¡Soy la auténtica!\fSoy SACHIKO,\fdel GIMNASIO\fFUCSIA. ¡La\noriginal!",
  ["JanineText_ToughOne"] = "SACHIKO: Eres muy\nfuerte. ¡Y, sin\vduda, has ganado!\fAquí tienes la\nMEDALLA ALMA.",
  ["JanineText_ToxicSpeech"] = "SACHIKO: ¡Eres tan\nfuerte! ¡Tengo un\vregalo para ti! Es\fTÓXICO, un potente\nveneno que va agotando\flos PS de la\nvíctima.",
  ["JasmineAmphyHangOnText"] = "¡AMPHY, aguanta!",
  ["JasmineAmphyHowAreYouFeelingText"] = "YASMINA: … AMPHY,\f¿cómo te\nsientes?",
  ["JasmineCianwoodPharmacyText"] = "YASMINA: Este POKéMON\nsiempre iluminaba\fel mar por la noche.\nPero de pronto\fenfermó… Le cuesta\nrespirar… Dicen\vque hay una FARMACIA\festupenda en\nCIUDAD ORQUÍDEA…\fPero está al\notro lado\fdel mar… Y\nno puedo dejar\fsolo a\nAMPHY…",
  ["JasmineCureAmphyText"] = "YASMINA: ¿Le hará\nla medicina algo\va AMPHY?",
  ["JasmineDontBeOffendedText"] = "YASMINA: ¡Mmm! Por\nfavor, no te ofendas…\vAMPHY no aceptaría\fnada de nadie.\nSólo confía\ven mí.",
  ["JasmineGetSomeMedicineText"] = "¿Podrías traerme\nsu medicina?\v¿Por favor?",
  ["JasmineISeeText"] = "YASMINA: Ya veo…",
  ["JasmineThankYouText"] = "YASMINA: ¡Oh…!\n¡Menos mal…!\fEs tan estupendo…\nMuchísimas\fgracias.\nRegresaré\fal GIMNASIO…\n",
  ["JugglerFritzAfterBattleText"] = "No vuelvo a ir en\nbarco. La próxima\fvez viajaré en el\nMAGNETOTRÉN.",
  ["JugglerFritzBeatenText"] = "No me puedo\nmover…",
  ["JugglerFritzSeenText"] = "¡Urrf…! ¡Estoy\nmareado!",
  ["JugglerHortonAfterBattleText"] = "No te relajes por\nhaberme vencido…\fLT. SURGE es\nmuy fuerte.",
  ["JugglerHortonBeatenText"] = "¡Vaya! Me has\nvencido…",
  ["JugglerHortonSeenText"] = "¡Voy a acabar contigo!\n¡Vas a echar\vchispas!",
  ["JugglerIrwin1BeatenText"] = "¡Uauuu! ¡Vaya\nsacudida!",
  ["JugglerIrwin1SeenText"] = "¡Observa cómo uso\nlas POKé BALL!",
  ["JugglerIrwinAfterBattleText"] = "Te iba a deslumbrar\ncon mi preciado\vPOKéMON. ¡Pero\ftu habilidad me\nelectrificó!",
  ["KantoRadioStationSignText"] = "EMISORA DE KANTO\n¡Tus programas\ffavoritos\na cualquier\vhora!",
  ["KarenScript_KarenBeatenText"] = "Lo haces bien... yo\nasí en los entrenadores.",
  ["KarenScript_KarenBeforeText"] = "Soy KAREN, del ALTO\nMANDO. ¿Eres {PLAYER}?\f¡Qué gracia! Me\ngustan los POKéMON\fde tipo siniestro.\nSu naturaleza tan\ffuerte y salvaje\nme parece muy\fatractiva. ¿Crees\nque podrás detenerlos?\f¡A ver qué\ntal lo haces!\v¡Vamos\fallá!",
  ["KarenScript_KarenDefeatText"] = "POKéMON fuertes.\fPOKéMON débiles.\fÉsa es la visión\negoísta que tiene\vtodo el mundo. Si\fun entrenador es\nbueno, debería ser\fcapaz de ganar con\nsus favoritos.\fMe gusta tu estilo.\nSabes lo que importa.\vAdelante. El\fCAMPEÓN te\nespera.",
  ["KimonoGirlKuniAfterBattleText"] = "He entrenado mucho\ny creía que tenía\fposibilidades,\npero no.",
  ["KimonoGirlKuniBeatenText"] = "Eres más fuerte de\nlo que pareces.",
  ["KimonoGirlKuniSeenText"] = "¡Oh! ¡Eres tan\nguay! ¿Quieres\vluchar?",
  ["KimonoGirlMikiAfterBattleText"] = "Sigo bailando porque\nhay gente a la\fque le gusta\nlo que hago.\fMis POKéMON\nme animan.",
  ["KimonoGirlMikiBeatenText"] = "¡Oh! ¡Tú también\neres genial!",
  ["KimonoGirlMikiSeenText"] = "¿Te gusta cómo bailo?\nTambién soy hábil\vcon los POKéMON.",
  ["kimonoChicaNaokodespuésbatallaTexto"] = "Me ha gustado el\ncombate. Me gustaría\vvolver a verte.",
  ["KimonoChicaNaokoGolpeadoTexto"] = "Oh, eres muy\nfuerte.",
  ["KimonoGirlSayoAfterBattleText"] = "El ritmo es muy\nimportante para\fla danza y para\nlos POKéMON.",
  ["KimonoGirlSayoBeatenText"] = "¡Estuve cerca! Por\npoco te venzo.",
  ["KimonoGirlSayoSeenText"] = "Yo siempre bailo\ncon mis POKéMON.\fY también los entreno,\nclaro.",
  ["KimonoGirlZukiAfterBattleText"] = "Cada mes pongo\nuna flor nueva\ven mi pasador.",
  ["KimonoGirlZukiBeatenText"] = "No me queda ningún\nPOKéMON…",
  ["KimonoGirlZukiSeenText"] = "¿Te gusta mi\npasador? ¡Ah!\f¿Un combate\nPOKéMON?",
  ["KnowTheInstructionsText"] = "¿Recuerdas que hay\nque encender el\fPOKéGEAR y elegir\nel TELÉFONO?",
  ["KogaScript_KogaBeatenText"] = "¡Ah! ¡Has demos-\ntrado tu\vvalor!",
  ["KogaScript_KogaBeforeText"] = "¡Ja, ja, ja! Soy\fKOGA, del ALTO\nMANDO. Vivo en\flas sombras, como\nun ninja. ¡Te confundiré\fy te destruiré\ncon mi estilo!\vConfusión, sueño,\fveneno… ¡Prepárate\npara ser víctima\fde mis técnicas!\n¡Ja, ja, ja!\vLos POKéMON\fno utilizan\fsólo la fuerza\nbruta.\f¡Ya lo\nverás!",
  ["KogaScript_KogaDefeatText"] = "He probado contigo\ntodo lo que sé.\vPero he fallado.\fDebería entrenarme\nbastante más. ¡Entra\ven la siguiente\fsala y demuestra\ntus habilidades!\v",
  ["KurtLeaveSlowpokeWellText"] = "CÉSAR: ¡Muy bien,\n{PLAYER}! El TEAM\fROCKET ha huido.\nYa estoy mejor\fde la espalda.\n¡Salgamos\vde aquí!",
  ["KurtsGranddaughterDadText"] = "Papá trabaja en SILPH\ny estudié POKé BALL. tengo que quedarme en casa\ncon Abuelo y SLOWPOKE.",
  ["KurtsGranddaughterLonelyText"] = "El abuelo se fue.\nEstoy tan sola…",
  ["KurtsGranddaughterSlowpokeBackText"] = "¡El SLOWPOKE que me\nregaló mi padre ha\fvuelto! ¡Y su COLA\nvuelve a crecer!",
  ["KurtsGranddaughterSlowpokeGoneText"] = "Los SLOWPOKE se\nhan ido… ¿Se los\fha llevado la\ngente mala?",
  ["KurtsHouseCelebiStatueText"] = "Es una estatua\ndel guardián\vdel encinar.",
  ["KurtsHouseKurtAhHaISeeText"] = "¡Ajá! ¡Ya veo!\nEntonces…",
  ["KurtsHouseKurtAskYouHaveAnApricornText"] = "CÉSAR: ¿Tienes\nun BONGURI? ¡Vale!\fTe haré una\nBALL.",
  ["KurtsHouseKurtBallsFromApricornsText"] = "CÉSAR: Fabrico las\nBALL de los BONGURI.\fRecógelos de los\nárboles y tráemelos.\vLos usaré para\fhacer las\nBALL.",
  ["KurtsHouseKurtDontBotherMeText"] = "CÉSAR: ¡Estoy\ntrabajando!\v¡Vete!",
  ["KurtsHouseKurtGranddaughterHelpingWorkFasterText"] = "CÉSAR: Ahora que\nmi nieta me ayuda,\fpuedo trabajar\nmucho más\vrápido.",
  ["KurtsHouseKurtHonoredToMakeBallsText"] = "CÉSAR: ¡{PLAYER}!\fTe has portado\ncomo nadie en\vel POZO. ¡Tienes\festilo! Sería\fun honor hacer\nalguna BALL para\falguien como\ntú. Ahora sólo\ftengo ésta.\nTuya es.",
  ["KurtsHouseKurtImCheckingItNowText"] = "Estoy viéndolo.\n",
  ["KurtsHouseKurtItWillTakeADayText"] = "CÉSAR: Tardaré un\ndía en fabricar una\fBALL. Vuelve mañana\na por ella.",
  ["KurtsHouseKurtJustFinishedYourBallText"] = "CÉSAR: ¡{PLAYER}!\nAcabo de terminar\vtu BALL. Tuya es.",
  ["KurtsHouseKurtMakingBallsMustWaitText"] = "¿Quién eres? {PLAYER},\f¿quieres que haga\nalguna BALL? Lo\vsiento, pero deberás\fesperar. ¿Conoces\nal TEAM ROCKET?\f¡Bah! No importa.\nYo te lo contaré.\fSe trata de una\nbanda malvada\fque usa POKéMON\npara el trabajo\fsucio. Se supone\nque se separaron\fhace tres años.\n¡Pero están en\vel POZO cortando\fCOLAS de SLOWPOKE\npara venderlas!\f¡Así que voy\na ir allí a\fdarles una\nlección! ¡Resistid,\vSLOWPOKE!\f¡CÉSAR\nos ayudará!\v",
  ["KurtsHouseKurtThatsALetdownText"] = "CÉSAR: ¡Oh…! ¡Qué\ndecepción!",
  ["KurtsHouseKurtThisBallStartedToShakeText"] = "¡{PLAYER}! Esta\fBALL comenzó a\nagitarse cuando\vla examinaba.\f¡Tiene que haber\nalgo!",
  ["KurtsHouseKurtTurnedOutGreatText"] = "CÉSAR: Ha salido\nmuy bien. Intenta\fcapturar POKéMON\ncon ella.",
  ["KurtsHouseKurtWhatIsThatText"] = "¿Qué es eso? Nunca\flo había visto.\nSe parece mucho\fa una POKé BALL,\npero parece\fque tiene\nalgo más.\fDéjame que\nlo vea.",
  ["KurtsHouseOakPhotoText"] = "¿Un joven PROF.\nOAK?",
  ["KurtsHouseSignText"] = "CASA DE CÉSAR",
  ["KurtsHouseSlowpokeText"] = "SLOWPOKE: ¡Mmm!\n(Bostezo).",
  ["LabWhereGoingText"] = "ELM: ¡Espera!\n¿Adónde vas?",
  ["LakeOfRageCooltrainerFText"] = "¿Me han engañado\nmis ojos? He visto\fun GYARADOS rojo\nen el LAGO… Yo\fpensaba que los\nGYARADOS eran\vazules.",
  ["LakeOfRageGotRedScaleText"] = "{PLAYER} obtuvo una\nESCAMA ROJA.",
  ["LakeOfRageGrampsText"] = "¡Los GYARADOS están\nenfadados! ¡Mal\fpresagio!",
  ["LakeOfRageGrampsText_ClearedRocketHideout"] = "¡Ajá! ¡Los MAGIKARP\npican!",
  ["LakeOfRageGyaradosCryText"] = "GYARADOS: ¡Gyaraa!",
  ["LakeOfRageLanceAskHelpText"] = "LANCE: ¿Qué? ¿Me\nvas a ayudar?",
  ["LakeOfRageLanceForcedToEvolveText"] = "Este LAGO está\nlleno de GYARADOS…\vAsí que los\fMAGIKARP deben\nha- ber\vevolucionado.\v",
  ["LakeOfRageLanceIntroText"] = "¿Viniste?\nlos rumores?\v¿Eres {PLAYER}?\fme llamo lanza\ny soy entrenador como tú. Hola rumores y por eso vine.\ninvestigando... Te vi pelear antes, {PLAYER}.\nCreo que tienes una habilidad considerable.\nSi no te importa,\n¿Podrías ayudarme?\ninvestigando?",
  ["LakeOfRageLanceRadioSignalText"] = "LANZA: ¡Excelente!\fParece que MAGIKARP\ndel LAGO se ve obligado a evolucionar.\nUn misterioso programa de radio que\nviene de CAOBA tiene culpa.\nTe estaré esperando, {PLAYER}.",
  ["LakeOfRageLanceRefusedText"] = "¡Oh…! Si cambias\nde opinión agradecería\vtu ayuda.",
  ["LakeOfRageMagikarpHouseUnusedRecordText"] = "RÉCORD ACTUAL\f@  cm, atrapado\npor @\v.@",
  ["LakeOfRageSignText"] = "LAGO DE LA FURIA,\nconocido como LAGO\vDE GYARADOS",
  ["LakeOfRageSuperNerdText"] = "Dicen que este lago\nfue obra del violento GYARADOS. Me pregunto si será\nrelacionado con su apariencia\nmasivo.",
  ["LanceBattleAfterText"] = "Fiuuu… Eres\frealmente fuerte,\n{PLAYER}. Tus\vPOKéMON han\frespondido\na tu fuerte\fnaturaleza.\nDebes continuar\ffortaleciéndote\ncon tus\fPOKéMON.\n",
  ["LanceBattleIntroText"] = "LANCE: Te estaba\nesperando. ¡{PLAYER}!\fSabía que tú, con\ftu habilidad, finalmente\nserías capaz de\fllegar hasta mí.\nNo necesitamos\fmás palabras. Debemos\nluchar para determinar\fquién es más fuerte\nde los dos. Como\fel entrenador\nmás poderoso\fy el CAMPEÓN\nde la LIGA POKéMON…\f¡Yo, LANCE,\nel maestro\fdragón, acepto\ntu desafío!\v",
  ["LanceBattleWinText"] = "Se acabó… Pero\fes extraño. No\nestoy enfadado\fpor perder. De\nhecho, estoy contento.\vEstoy contento\fpor haber presenciado\ntu triunfo.\f¡No tienes\nigual!",
  ["LanceGetPasswordText"] = "LANCE: Se necesi-\ntan 2 contraseñas\fpara acceder al\ncuarto del jefe.\fEsas contraseñas\nsólo las conocen\valgunos ROCKET.\fEse ROCKET de ahí\nme lo dijo amablemente.\v{PLAYER}, obtén\flas contraseñas.\n",
  ["LanceHealsText1"] = "LANCE: ¿Estás\nbien? Tus POKéMON\festán débiles\ny cansa- dos.\fToma, dales\nun poco de mi\vmedicina.",
  ["LanceHealsText2"] = "LANCE: {PLAYER}, da\nlo mejor de ti por\vlos POKéMON.",
  ["LancesRoomMaryInterviewText"] = "ROSA: ¡Vamos a entrevistar\na la persona que ha\vganado la LIGA!",
  ["LancesRoomMaryNoInterviewText"] = "ROSA: ¡Espera! ¡No\nhemos hecho la\ventrevista!",
  ["LancesRoomMaryOhNoOakText"] = "ROSA: ¡Oh, no! ¡Todo\nha acabado! PROF.\fOAK, si no fuera\ntan lento…",
  ["LancesRoomNoisyText"] = "LANCE: Esto va\na ponerse demasiado\vfeo… ¿{PLAYER},\fpuedes venir\nconmigo?",
  ["LancesRoomOakCongratulationsText"] = "PROF. OAK: ¡Ah,\n{PLAYER}! Ha pasado\fmucho tiempo. Cada\fdía eres más impresionante.\n¡Tu conquista\vde la LIGA ha\fsido fantástica!\nTu dedicación,\vconfianza y amor\fpor tus POKéMON\nlo han conseguido.\fTus POKéMON\ntambién han\festado increíbles.\nHan perseverado\vporque han\fcreído en\nti y en tu\fentrenamiento.\n¡Felicidades,\f{PLAYER}!\n",
  ["LassAliceAfterText"] = "¿Cómo reconocerás\na la auténtica\vLÍDER?",
  ["LassAliceBeatenText"] = "Te he engañado…",
  ["LassAliceBeforeText"] = "¡Fufufu! ¡Soy SACHIKO,\fla LÍDER del GIMNASIO!\n¡No, no soy\fyo! ¡Qué tontería!\n",
  ["LassBridgetAfterBattleText"] = "Intento vencer\na BLANCA, pero…\vEs deprimente.\f¡De acuerdo! ¡Si\npierdo, volveré\fa intentarlo\notra vez!",
  ["LassBridgetSeenText"] = "Prefiero un POKéMON\nmono a un POKéMON\vfuerte. ¡Mis POKéMON\fson monos y\nfuertes!",
  ["LassCarrieAfterBattleText"] = "¿Creen mis POKéMON\nque soy\vguapa?",
  ["LassCarrieBeatenText"] = "¡Vaya…! Pensaba\nque eras débil…",
  ["LassCarrieSeenText"] = "No dejes que te\nimpresione la\vbelleza de mis\fPOKéMON. ¡Son\nmuy fuertes!",
  ["LassConnie1AfterBattleText"] = "Cualquiera estaría\npreocupado si sus\vPOKéMON estuvieran\venfermos. Rezaré\fpor ese POKéMON,\npara que YASMINA\fregrese al\nGIMNASIO.",
  ["LassConnie1BeatenText"] = "¡Ay! ¡Mi POKéMON!",
  ["LassConnie1SeenText"] = "YASMINA es LÍDER\ndel GIMNASIO. Quiero\fque vuelva conmigo.\n¡No he encontrado\fa nadie\nmejor!",
  ["LassDana1BeatenText"] = "Ya veo. De modo\nque luchas así.",
  ["LassDana1SeenText"] = "Parece que sabes de\nPOKéMON. Si es así,\f¿por qué no me das\nalgún consejo?",
  ["LassDanaMoomooMilkText"] = "me lo paso bien\nnoticias! La leche de GRANJA MUU-MUU\nEs famoso por su sabor.",
  ["LassEllenAfterBattleText"] = "Hice lo que pude.\nNo me arrepiento.",
  ["LassEllenBeatenText"] = "¿Cómo he podido perder?",
  ["LassEllenSeenText"] = "Ahora me toca a mí.\n¡En guardia!",
  ["LassKriseAfterBattleText"] = "¡Pensaba que\nme estabas\vmirando porque\fsoy bonita!\n",
  ["LassKriseSeenText"] = "¿Eh? ¿Y tú qué\nmiras? ¿Quieres\fluchar?",
  ["LassLauraAfterBattleText"] = "Hice lo que pude.\nNo me arrepiento.",
  ["LassLauraSeenText"] = "¡Yo soy la cuarta!\n¿No puedes más?",
  ["LassLindaBeatenText"] = "¡Oh…! He perdido…\nNo eres débil…",
  ["LassLindaBeforeText"] = "¡Te engañé!\n¡Ja ja ja!",
  ["LassMichelleAfterBattleText"] = "Tenía que haber\nestado más\vatenta.",
  ["LassMichelleSeenText"] = "¿Te parece raro un\nGIMNASIO exclusivo\vpara chicas?",
  ["LassShannonAfterBattleText"] = "Hice lo que pude.\nNo me arrepiento.",
  ["LassShannonBeatenText"] = "¿Estás bromeando?",
  ["LassShannonSeenText"] = "Y por último yo,\npero te lo aviso,\v¡soy la mejor!",
  ["LavRadioTower1FDirectoryText"] = "PB RECEPCIÓN\nP1 VENTAS P2\vPERSONAL P3 PRODUCCIÓN\vP4 DESPACHO\vDEL    DIRECTOR\v",
  ["LavRadioTower1FGentlemanText"] = "¡Oh, no, no, no!\fNo hemos emitido\ndesde que cerró\fla CENTRAL ENERGÍA.\nSi no emitimos,\fde nada servirá\nel esfuerzo realizado\fpor la emisora.\n¡Me arruinaré!\f",
  ["LavRadioTower1FGentlemanText_GotExpnCard"] = "con eso puedes\nsintonizar programas de radio\nde KANTO. ¡Jajajaja!",
  ["LavRadioTower1FGentlemanText_ReturnedMachinePart"] = "¡Ah! Así que tú, {PLAYER},\narreglas- te el problema\fde la CENTRAL ENERGÍA…\nGracias a ti, no\fperdí mi empleo.\n¡Me has salvado\fla vida! Acepta\nesto como muestra\fde mi gratitud.\n",
  ["LavRadioTower1FOfficerText"] = "Lo siento, pero sólo\npuedes dar una vuelta\vpor la planta baja.\fDesde que una banda\ncriminal asaltó la\fTORRE RADIO de JOHTO,\ntuvimos que incre-\fmentar las medidas\nde seguridad.",
  ["LavRadioTower1FPokeFluteSignText"] = "Anima a los #- MON\ncon la melodía\fde la # FLAUTA\ndel CANAL 20",
  ["LavRadioTower1FReceptionistText"] = "¿Qué tal? Mira\npor donde quieras\fen esta\nplanta.",
  ["LavRadioTower1FReferenceLibraryText"] = "¡Uau! Un estante\nlleno de CD\vy vídeos de\vPOKéMON. Debe\fde ser una\nbiblioteca.\v",
  ["LavRadioTower1FSuperNerd1Text"] = "En la TORRE RADIO hay\nmucha gente que trabaja\fduramente. Seguro\nque están haciendo\ftodo lo posible\npor emitir buenos\vprogramas.",
  ["LavRadioTower1FSuperNerd2Text"] = "¡Oye, joven! ¡Soy\fel DIRECTOR de MÚSICA!\n¡Vaya! Tu POKéGEAR\fno sintoniza mis\nprogramas de música.\f¡Qué pena! Si\nconsigues una\fTARJETA EXPN,\nlos podrás\foír. ¡Hazte\ncon una!",
  ["LavRadioTower1FSuperNerd2Text_GotExpnCard"] = "¡Oye, joven! ¡Soy\fel DIRECTOR de MÚSICA!\nSoy el encargado\fde las fantásticas\nmelodías que se\femiten aquí.\nNo seas anticuado.\f¡Atrapa la\nmúsica de las\vondas!",
  ["LavenderMartPokefanMText"] = "Si vas a explorar\nuna cueva, debes\fllevar siempre REPELENTE.\nAunque me gusta\fla exploración,\naún no he recorrido\ftodas las\ncuevas.",
  ["LavenderMartRockerText"] = "He oído hablar de\nun artesano que fabrica\fPOKé BALL a medida\nen PUEBLO AZALEA,\fen JOHTO. ¡Yo\nquiero una!",
  ["LavenderMartSignText"] = "Qué edificio tan\ngrandioso, ¿verdad?\fEs la TORRE RADIO\nde KANTO.",
  ["LavenderPokecenter1FGentlemanText"] = "Al norte de PUEBLO\nLAVANDA está el\vTÚNEL ROCA. Crúzalo\fpara lle- gar\na la CENTRAL\vENERGÍA.",
  ["LavenderPokecenter1FTeacherText"] = "Hay un programa de\nradio que pone música\vde # FLAUTA. Necesitas\funa TARJETA\nEXPN para sintonizarlo.\v",
  ["LavenderPokecenter1FYoungsterText"] = "Si la CENTRAL ENERGÍA\nno está en funcionamiento,\vel MAGNETOTRÉN tampoco\vlo estará… Y eso\fsignifica que\nla ESTACIÓN de\vRADIO no podrá\vemitir…",
  ["LavenderPokecenter1FYoungsterText_ReturnedMachinePart"] = "El DIRECTOR de\nla EMISORA estaba\vmuy contento.\fDijo que han vuelto\na emitir porque\fla CENTRAL\nENERGÍA ya\vfunciona.",
  ["LavenderSpeechHousePokefanFText"] = "El PUEBLO LAVANDA\nes un pequeño y apacible\flugar, al pie de\nlas montañas. Desde\fque se construyó\nla TORRE RADIO,\facude algo más\nde gente.",
  ["LavenderTownGrampsText"] = "Viene gente de todas\npartes a rendir homenaje\fa las almas de\nlos POKéMON que\vhan partido.",
  ["LavenderTownPokefanMText"] = "Menudo edificio,\n¿eh? Es la\fTORRE RADIO\nde KANTO.",
  ["LavenderTownSignText"] = "PUEBLO LAVANDA\fEl noble pueblo\npúrpura",
  ["LavenderTownTeacherText"] = "KANTO tiene muchos programas\nde radio buenos.",
  ["LavenderTownYoungsterText"] = "Para despertar\na los POKéMON,\vsintoniza FLAUTA\fPOKéMON. ¡Todo\nentrenador debería\vsaberlo!",
  ["LeaderBlueAfterText"] = "AZUL: … De acuerdo,\fme he equivocado.\nTenías razón.\fNo me engañabas.\nPero algún\fdía te derrotaré.\n¡No lo\folvides!\n",
  ["LeaderBlueBeforeText"] = "AZUL: ¡Hola! Al\nfin llegaste, ¿eh?\fEn ISLA CANELA no\nestaba a punto,\fpero ahora estoy\nlisto para luchar.\f… ¿Me estás contando\fque superaste los\nGIMNASIOS de JOHTO?\v¡Vaya! Pues los\fGIMNASIOS de JOHTO\ndeben de ser\vpatéticos. Pero\fbueno, no te\npreocupes. Sabremos\fsi vales o\nno en un momento.\fLuchemos\nahora.\f¿Vale?",
  ["LeaderBlueEpilogueText"] = "AZUL: Escucha. Será\fmejor que no pierdas\nhasta que yo te derrote.\v¿Entendido?",
  ["LeaderBlueWinText"] = "AZUL: ¿Qué? ¿Cómo\fdiablos he perdido?\n… ¡Está bien…!\fToma. Aquí\ftienes la\nMEDALLA\vTIERRA.",
  ["LookTownMapText"] = "MAPA del PUEBLO.",
  ["LtSurgeFightDoneText"] = "SURGE: ¡Eh, tú! ¿Todavía\nestás molestando\vpor aquí? ¡Mis POKéMON\fy yo seguimos\nen ello!",
  ["LtSurgeIntroText"] = "SURGE: ¡Eh, tú,\njoven! Tengo que\frecono- cerlo.\fNo es que sea\ninteligente desafiarme,\v¡pero requiere\vagallas! Cuando\vse trata de POKéMON\feléctricos, ¡soy\nel número uno!\vNunca he perdido\ven la batalla.\f¡Te electrocutaré\ncomo hice\fcon el enemigo\nen la\vguerra!\v",
  ["LtSurgeThunderBadgeText"] = "SURGE: La MEDALLA\nTRUENO aumenta la\vVELOCIDAD de los\vPOKéMON. Te la\fmereces por haberme\nvencido. Llévala\fcon orgullo,\n¿me oyes?",
  ["LtSurgeWinLossText"] = "SURGE: ¡Arrrgh! ¡Eres\nfuerte! Vale, joven.\f¡Toma la MEDALLA\nTRUENO!",
  ["MagazineBookshelfText"] = "Revistas POKéMON…\nTELEVISOR POKéMON,\vMANUAL POKéMON,\fGRÁFICA POKéMON…\n",
  ["MagikarpLengthRaterText_Bonus"] = "Lo importante es\nel récord. ¡Piensa\fen él como una\nbonificación!",
  ["MagikarpLengthRaterText_LakeOfRageHistory"] = "El LAGO DE LA FURIA\nes un cráter obra\fde violentos GYARADOS.\nEl cráter se llenó\fde agua de lluvia\ny se formó el\fLAGO. Esta historia\nla contó por\fprimera vez el\ntatarabuelo de\fmi abuelo. Antes\nse podían pescar\fMAGIKARP en\nel lago, pero…\fNo entiendo\nlo que\focurre\nahora.",
  ["MagikarpLengthRaterText_Memento"] = "¡Uau! ¡Éste es\nimpresionante!\f¡Me quito el sombrero\nante ti! ¡Toma\festo como\nrecuerdo!",
  ["MagikarpLengthRaterText_MenInBlack"] = "En el LAGO pasan cosas\nraras desde que\fllegaron esos hombres\nde negro.",
  ["MagikarpLengthRaterText_NotMagikarp"] = "¿Qué? eso no es todo\n¡Un MAGIKARP!",
  ["MagikarpLengthRaterText_Refused"] = "¿No tienes ninguno\nbueno que enseñarme?\fQuizá la próxima\nvez.",
  ["MagikarpLengthRaterText_TooShort"] = "¡Uau! ¡Éste es impresionante!\nOjalá no tuviera\fque decirlo,\npero he visto\funo más grande\nantes.",
  ["MagikarpLengthRaterText_WorldsLargestMagikarp"] = "La normalidad ha vuelto\nal LAGO DE LA FURIA.\fVuelve a haber MAGIKARP.\nQuizá se cumpla\fmi sueño de ver\nal MAGIKARP más\vgrande del mundo.\v¿Tienes una CAÑA?\fSi tienes una,\nayúdame por\vfavor.",
  ["MagikarpLengthRaterText_YouHaveAMagikarp"] = "¡Ah, tienes un\nMAGIKARP! A ver\flo grande que\nes ese bebé.",
  ["MahoganyGymGuideText"] = "FREDO es un veterano\ny lleva entrenando\nPOKéMON\funos 50 años.\fDicen que es bueno\ncongelando a sus\nadversarios con\nataques de hielo.\f¡Así que tendrás que\nderretirlo\fcon tu ardiente\nambición!",
  ["MahoganyGymGuideWinText"] = "FREDO es bueno,\n¡pero tú estás a\votro nivel!\fHa sido un combate\ncaliente que\fha unido a dos\ngeneraciones.",
  ["MahoganyGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE PUEBLO\vCAOBA: FREDO El\fmaestro del crudo\ninvierno",
  ["MahoganyMart1FBlackBeltText"] = "El experimento\nfuncionó a las\vmil maravillas.\vLos MAGIKARP no\fvalen nada, pero\nlos GYARADOS\fson muy productivos.\n",
  ["MahoganyMart1FBlackBeltText_LanceEntered"] = "¡Urrg…! Los POKéMON\fdragón de ese chico\nson muy fuertes…",
  ["MahoganyMart1FLanceDragoniteHyperBeamText"] = "LANCE: DRAGONITE,\nHÍPER RAYO.",
  ["MahoganyMart1FLanceRadioText"] = "¡Ya estás aquí,\n{PLAYER}! Tal y\fcomo creía, esa\nextraña señal\fde radio proviene\nde aquí.",
  ["MahoganyMart1FLanceSplitUpText"] = "LANCE: {PLAYER}, debemos\nsepararnos para inspeccionar\fel lugar. Iré\nprimero.",
  ["MahoganyMart1FLanceStairsText"] = "Las escaleras están\njusto aquí.",
  ["MahoganyMart1FPharmacistText_LanceEntered"] = "¡Arrgh…! Has encontrado\nla escalera\vsecreta.",
  ["MahoganyMart1FRageCandyBarText"] = "¡Hola, chico!\f¿Qué tal una\nBAR. FURIA?\f¡Es lo que se come\nen PUEBLO CAOBA!",
  ["MahoganyPokecenter1FCooltrainerFText"] = "Al evolucionar,\nlos POKéMON se fortalecen,\fpero tardan más\nen aprender\vataques.",
  ["MahoganyPokecenter1FPokefanMText"] = "¿Qué pasa? ¿Ha\nvuelto el TEAM\vROCKET? He visto\fhombres de negro\nen el LAGO DE\vLA FURIA.",
  ["MahoganyPokecenter1FYoungsterText"] = "No permito que mis\nPOKéMON evolu- cionen\vdemasiado pronto.\fAntes de dejarles\nevolucionar, les\venseño algunos\vmovimientos.",
  ["MahoganyRedGyaradosSpeechHouseBlackBeltText"] = "Dicen que ha aparecido\nun GYARADOS rojo\ven el LAGO. ¡Qué\fraro, porque en el\nlago no son frecuentes\fni los GYARADOS\ncomunes!",
  ["MahoganyRedGyaradosSpeechHouseTeacherText"] = "¿Mi programa de radio\nfavorito? La MÚSICA\vPOKéMON.",
  ["MahoganyRedGyaradosSpeechHouseTeacherText_RocketsInRadioTower"] = "He estado oyendo\nrisas en la\fradio… Es espeluznante.\n",
  ["MahoganyTownFisherText"] = "Has venido de muy\nlejos. Tómate tiempo\fpara ver el paisaje.\nDeberías ir hacia\fel Norte y ver\nlo que pasa\fen el LAGO DE\nLA FURIA.",
  ["MahoganyTownGrampsText"] = "¿Vas al LAGO a\nver a los violentos\vGYARADOS?",
  ["MahoganyTownGrampsText_ClearedRocketHideout"] = "Los MAGIKARP han\nvuelto al LAGO\vDE LA FURIA. Son\fbuenas noticias\npara los pescadores.\v",
  ["MahoganyTownLassText"] = "Visita la Tienda\nde la Abuela. Hay\fcosas que sólo\nella tiene.",
  ["MahoganyTownRagecandybarSignText"] = "¡Si visitas PUEBLO\vCAOBA, prueba\nun CARAMELO\vFURIA!",
  ["MahoganyTownSignText"] = "PUEBLO CAOBA\fEl hogar de\nlos Ninja",
  ["ManiaText_AskLookAfterShuckle"] = "¡Estoy alucinado!\fVino un chico de\ntu edad, de pelo\flargo y mirada penetrante.\n¡Y me obligó a\fdarle mis queridos\nPOKéMON! Todavía\vme queda uno,\f¿pero qué hago\nsi vuelve? Pareces\vfuerte. ¿Podrías\fcuidar de\nmi POKéMON\fdurante un\nrato?",
  ["ManiaText_CanIHaveMyMonBack"] = "¡Hola! ¿Cómo estás?\n¿Mi POKEMON? Creo que lo pasaste\npeligro. ¿Me lo devolverás?",
  ["ManiaText_GotShuckle"] = "{PLAYER} recibió\nun POKéMON.",
  ["ManiaText_HappinessSpeech"] = "Para los POKéMON,\nla felicidad es\festar con quien\nlos quiere.",
  ["ManiaText_IfHeComesBack"] = "¡Oh, no…! ¿Y\nqué hago si\vvuelve?",
  ["ManiaText_PartyFull"] = "No puedes llevar\nmás POKéMON.",
  ["ManiaText_SameAsBeingRobbed"] = "¡Oh, no, no…! Es\ncomo si me hubieran\vrobado.",
  ["ManiaText_ShuckleLikesYou"] = "Mi POKéMON te ha\ntomado cariño.\f¡Vale! ¡Quédatelo,\npero prométeme\fque serás amable\ncon él!",
  ["ManiaText_ShuckleNotThere"] = "¡Oye! ¡No llevas\na mi POKéMON\vcontigo!",
  ["ManiaText_TakeCareOfShuckle"] = "¡Oh, gracias!\f¡Cuídale bien,\npor favor!",
  ["ManiaText_ThankYou"] = "¡Gracias!",
  ["MartNoMoneyText"] = "No tienes\ndinero.",
  ["MartSignText"] = "Todo lo necesario\npara tus POKéMON\fTIENDA POKéMON",
  ["MediumDorisAfterBattleText"] = "¡Maldición! Olvidé\nque predije mi derrota\vcontra ti.",
  ["MediumDorisBeatenText"] = "A pesar de leerte el pensamiento,\nhe perdido…",
  ["MediumDorisSeenText"] = "¡Fufufufu…! Lo veo\nclaramente. ¡Puedo\fver lo que encierra\ntu alma!",
  ["MediumGraceAfterBattleText"] = "Bien. Te contaré\nel secreto del\fsuelo invisible.\n¡La ruta\festá frente\na ti!",
  ["MediumGraceSeenText"] = "¿Te asombra el suelo\ninvisible? ¡Si\fquieres una pista,\nvénceme!",
  ["MediumMarthaAfterBattleText"] = "¡Ganará quien\nmás lo desee!",
  ["MediumRebeccaAfterBattleText"] = "¿De dónde proviene\ntu poder?",
  ["MediumRebeccaBeatenText"] = "Fuerte… Muy\nfuerte…",
  ["MediumRebeccaSeenText"] = "¡El poder de todos\na los que venciste\vestá en mí!",
  ["MeetArthurText"] = "JOSUÉ: ¿Quién\neres tú? Soy\fJOSUÉ, por\njueves.",
  ["MeetFriedaText"] = "VICKI: ¡Yuju!\n¡Es viernes!\fSoy VICKI, por\nviernes. ¡Mucho\fgusto!",
  ["MeetMonicaText"] = "LUNA: Encantada de\nconocerte. Soy LUNA,\fpor lunes.",
  ["MeetSantosText"] = "SABINO: … Es\fsábado… Soy\fSABINO, por\nsábado…",
  ["MeetSunnyText"] = "DOMINGO: ¡Hola! Soy\fDOMINGO, por el\ndía. Es decir, ¡hoy\ves domingo!",
  ["MeetTuscanyText"] = "MARTA: Creo\nque es la primera\fvez que nos\nvemos. Déjame\fque me presente.\nSoy MARTA,\fpor martes.\n",
  ["MeetWesleyText"] = "MIGUEL: Hola, ¿qué\ntal estás? Hoy\fes miércoles\ny yo soy MIGUEL,\fpor lo de miércoles.\n",
  ["MerchandiseShelfText"] = "¡Cantidad de\nartículos\vPOKéMON!",
  ["MistyFightDoneText"] = "MISTY: ¿Hay muchos\nentrenadores fuertes\ven JOHTO? Como\vtú, digo. Un\fdía viajaré y\nlucharé contra\fentrenadores\nexpertos.",
  ["MistyIntroText"] = "MISTY: ¡Te estaba\nesperando, pelma!\vSeguro que tienes\fmuchas MEDALLAS\nde JOHTO, pero\fno me subestimes\nen absoluto.\v¡Mis POKéMON\fde tipo agua\nson fuertes!",
  ["MistyWinLossText"] = "MISTY: Eres realmente\ngenial… Reconozco\ftu gran experiencia…\nAquí tienes\fla MEDALLA\nCASCADA.",
  ["MobileBattleRoom_EstablishingCommsText"] = "Estableciendo\nconexión…",
  ["MobileBattleRoom_HealText"] = "Tus POKéMON serán\ncurados totalmente\vantes del\vcombate.",
  ["MobileTradeRoom_EstablishingCommsText"] = "Estableciendo\nconexión…",
  ["MomDeterminedText"] = "Eso parece mucho\nduro. Pero, {PLAYER}, si puedes\nHazlo y te hará feliz.\n¿de acuerdo?",
  ["MomGivesPokegearText"] = "El POKéMON GEAR\no sólo POKéGEAR.\fEs básico para\nser un buen entrenador.\v¡Ah! Falta\fel día de la\nsemana. ¡No\folvides ponerlo!\n",
  ["MomImportantToSaveText"] = "Es importante que\nahorres dinero.",
  ["MomOKIllSaveText"] = "Vale. Te guardaré\nel dinero.",
  ["MomPhoneGreetingText"] = "¿Dígame? ¡Hola,\f{PLAYER}! ¿Trabajando\nmucho?",
  ["MomPhoneHangUpText"] = "¡Sigue así, {PLAYER}!\n¡Estoy contigo!\v",
  ["MomPhoneLectureText"] = "¿Diga? … ¿{PLAYER}…?\fMe ha dicho el PROF.\nELM que te has ido\fpara hacer un largo\nviaje. Me hubiera\fgustado que me lo\ndijeras… Tu dinero…\f¿Quieres que te\nlo guarde?",
  ["MomPhoneNoGymQuestText"] = "¿Diga? Oh, hola,\f{PLAYER}. Cuando\nacabes tu\frecado ven\na casa.",
  ["MomPhoneNoPokedexText"] = "¿Diga? Oh, hola, {PLAYER}.\f¿Estás en una gran\nmisión para el\fPROF. ELM? ¡Pórtate\nbien!",
  ["MomPhoneNoPokemonText"] = "¿Diga? Oh, hola,\f{PLAYER}. ¿No te\nestaba esperando\vel PROF. ELM?",
  ["MomYoureNotSavingText"] = "¡Oh, {PLAYER}!\nNo estás ahorrando\fdinero. ¿Quieres\nahorrar?",
  ["MonicaGaveGiftText"] = "LUNA: Es un objeto\nque aumenta el poder\fde los movimientos\nde tipo volador.\fDeberías dar este\nobjeto a un POKéMON\vpájaro.",
  ["MonicaGivesGiftText"] = "¡Como prueba de\nnuestra amistad,\vtengo un regalo\vpara ti!",
  ["MonicaMondayText"] = "LUNA: Mis hermanos\ny hermanas están\fpor todas partes.\n¡A ver si\flos encuentras!\n",
  ["MonicaNotMondayText"] = "LUNA: No creo que\nhoy sea lunes.\v¡Qué pena…!",
  ["MoomooFarmSignText"] = "GRANJA MUU-MUU Prueba nuestra rica\nleche fresca",
  ["MortyFightDoneText"] = "Entiendo… Tu\fviaje te ha llevado\na tierras lejanas.\vY has presenciado\fmuchas más\ncosas que\vyo. ¡Cómo\fte envidio…!\n",
  ["MortyIntroText"] = "Me alegro de que\nhayas venido. Aquí\fen IRIS, los POKéMON\nson venerados.\vSe dice que un\fPOKéMON de los\ncolores del arco\firis aparecerá\nante un verdadero\fentrenador. Yo\ncreo en esa historia\fy, por eso, llevo\nentre- nándome\faquí toda mi vida.\nAsí que ahora\vpuedo ver cosas\fque otros no\nven. Sólo un\vpoco más… Con\fun poco más,\fpodría ser yo\nquien viera al\fPOKéMON de los\ncolores del\varco iris.\f¡Ayúdame a\nalcan- zar\vese nivel!",
  ["MortyText_FogBadgeSpeech"] = "Con la MEDALLA NIEBLA,\nte obede- cerán\ftodos los POKéMON\nhasta el nivel 50.\fY los POKéMON que\nsepan SURF podrán\fusarlo en cualquier\nmomento. Quédate\fcon esto\ntambién.",
  ["MortyText_ShadowBallSpeech"] = "Es BOLA SOMBRA.\nCausa daños y\fpuede reducir\nla DEFENSA ESPECIAL.\fÚsala si te\ngusta.",
  ["MortyWinLossText"] = "Aún no soy lo bastante\nbueno… De acuerdo.\fEsta MEDALLA\nes tuya.",
  ["MountMoonGiftShopLassText"] = "Cuando el sol se\npone, CLEFAIRY\vsale a jugar.",
  ["MountMoonRivalTextAfter"] = "…… …… ……\f…Has ganado de\nforma justa.\fLo admito. Pero esto\nno ha terminado.\fMe convertiré en el\nmejor entrenador de\vPOKéMON.\fPorque estos chicos\nestán conmigo.\f…Escucha, {PLAYER}.\fAlgún día demostraré\nlo bueno que soy\nderrotándote.",
  ["MountMoonRivalTextBefore"] = "…… …… ……\fCuánto tiempo,\n{PLAYER}.\f…Desde que perdí\ncontra ti, pensé\fen lo que les faltaba\na mis\vPOKéMON…\fY llegué a una\nrespuesta.\f{PLAYER}, ¡ahora\nte lo demostraremos!",
  ["MountMoonRivalTextLoss"] = "…… …… ……\fHe saldado mi\ndeuda contigo.\fCon mis POKéMON,\nderrotaré al\fCAMPEÓN y me\nconvertiré en el mejor\vdel mundo.",
  ["MountMoonRivalTextWin"] = "…… …… ……\fPensaba que mis\nPOKéMON eran\nlo mejor que\npodían ser…\f…Pero no ha\nsido suficiente…",
  ["MountMortarB1FKiyoFullPartyText"] = "¡No tienes sitio\nen tu equipo!",
  ["MountMortarB1FKiyoGotTyrogueText"] = "TYROGUE es del\ntipo lucha. Evoluciona\fen un POKéMON\nmás fuerte. Sigue\fasí. Yo también\nseguiré entrenándome.\v¡Adiós!\f",
  ["MountMortarB1FKiyoIntroText"] = "¡Hola! ¡Soy el\fREY del KARATE!\n¡Me entreno\fsolo en la\noscuridad!\f¡Tú! ¡Lucha\nconmigo! ¡Uaaarggh!\f",
  ["MountMortarB1FKiyoWinText"] = "¡Aaaargg! ¡He\nperdido!",
  ["MountMortarB1FReceiveMonText"] = "{PLAYER} recibió\na TYROGUE.",
  ["MountMortarB1FTyrogueRewardText"] = "He… perdido… Tendré\fque seguir entrenándome…\nPero una derrota\fes una derrota.\nComo prueba de\ftu victoria,\nte voy a dar\fun raro POKéMON\nde lucha.",
  ["MoveDeletersHouseSignText"] = "CASA DEL QUITA-MOVIMIENTOS\n",
  ["MrFujiText"] = "SEÑOR. FUJI: ¡Hola! Mmm…!\fparece que eres\neducando a tus POKéMON con mucho amor.\nLos amantes de Pokémon vienen a\nrendir homenaje a los POKéMON muertos.\nPor favor muestra tu condolencia\npara las almas POKéMON rotas.\nEstoy seguro de que lo harán\nfeliz.",
  ["MrFujisHouseLassText"] = "Algunas personas son\ntan crueles que abandonan\va sus POKéMON. El\fabuelo recoge a\nlos POKéMON que\fno tienen hogar\ny los cuida.",
  ["MrFujisHouseSuperNerdText"] = "El SR. FUJI vive\naquí, pero ahora\fno está en casa.\fDebe de estar en\nel CEMENTERIO.",
  ["MrPokemonIntroText1"] = "¡Hola, hola! Debes\nde ser {PLAYER}. El\fPROF. ELM me dijo\nque vendrías.",
  ["MrPokemonIntroText2"] = "Esto es lo que quiero\nque examine el\vPROF. ELM.",
  ["MrPokemonIntroText3"] = "Conozco a una pareja\nque tiene una GUARDERÍA\vPOKéMON. Ellos me\fdieron ese HUEVO.\nComo me intrigaba,\fle mandé una carta\nal PROF. ELM. El\vPROF. ELM es la\fmáxima autoridad\nen evolución de\vlos POKéMON.",
  ["MrPokemonIntroText4"] = "Hasta el PROF. OAK\nlo reconoce.",
  ["MrPokemonIntroText5"] = "Si tengo razón,\nel PROF. ELM\vlo sabrá.",
  ["MrPokemonText_AlwaysNewDiscoveries"] = "¡La vida es genial!\n¡Siempre quedan\fcosas por descubrir!\n",
  ["MrPokemonText_Disappointed"] = "Es una pena.\nEs realmente\vraro.",
  ["MrPokemonText_GimmeTheScale"] = "¿Mmm? ¡Esa ESCAMA!\n¿Qué es esto? ¿Un\vGYARADOS rojo? ¡Qué\fraro!  Lo quiero…\n¿{PLAYER}, quieres\fintercambiarlo?\nPuedo ofrecerte\feste REPARTIR EXP\nque me dio el\vPROF. OAK.",
  ["MrPokemonText_ImDependingOnYou"] = "¡Confío\nen ti!",
  ["MrPokemonsHouseDirectionsSignText"] = "CASA SR. POKéMON\n¡Todo recto!",
  ["MrPokemonsHouseSignText"] = "CASA SR. POKéMON",
  ["MrPokemonsHouse_BrokenComputerText"] = "Es un ordenador\nenorme. ¡Mmm! Está\vestropeado.",
  ["MrPokemonsHouse_ForeignMagazinesText"] = "Lleno de revistas\nextranjeras. Ni siquiera\fpuedo leer los\ntítulos.",
  ["MrPokemonsHouse_GetDexText"] = "¡{PLAYER} recibió\nla POKéDEX!",
  ["MrPokemonsHouse_GotEggText"] = "{PLAYER} recibió\nun HUEVO MIST.",
  ["MrPokemonsHouse_MrPokemonHealText"] = "¿Vas a ir a ver\nal PROF. ELM? Toma.\fTus POKéMON deberían\ndescansar\vun poco.",
  ["MrPokemonsHouse_OakText1"] = "OAK: ¡Ajá! ¡Así que\neres {PLAYER}! ¡Soy\fOAK! Investi- go\na los POKéMON. Estaba\fvisitando a mi viejo\namigo el SR. POKéMON.\vOí que estabas haciendo\fun recado para el\nPROF. ELM, así que\fte esperé aquí.\n¡Oh! ¿Qué es esto?\f¡Un POKéMON raro!\nVeamos… Mmm… ¡Ya\fveo! Ya entiendo\fpor qué el PROF.\fELM te dio un POKéMON\npara este recado.\fLos investigadores\ncomo el PROF. ELM\fy yo somos amigos\nde los POKéMON.\fSe dio cuenta de\nque cuidarías\fa tu POKéMON con\namor y cariño.\f¡Ah…! Pareces\nser muy responsable.\f¿Querrías ayudarme?\f¿Ves? Ésta es\nla última versión\fde la POKéDEX.\nGuarda automática-\fmente datos\nde los POKéMON\vque hayas visto\fo capturado.\n¡Es una enciclo-\fpedia de\nalta tecnología!\f\n",
  ["MrPokemonsHouse_OakText2"] = "¡Ve a conocer todos\nlos POKéMON que\fpuedas y com- pleta\nesa POKéDEX! Llevo\fdemasiado tiempo\naquí. Tengo que\fir a CIUDAD TRIGAL\npor mi programa\vde radio. ¡{PLAYER},\fcuento contigo!\n",
  ["MrPokemonsHouse_StrangeCoinsText"] = "¡Un montón de monedas\nextrañas! Quizá\fsean de otro\npaís…",
  ["MrPsychicText1"] = "<……> <……>\f<……> ¡Lo\fconseguí!\f¡Tú lo quisiste!\f",
  ["MrPsychicText2"] = "MT29 es PSÍQUICO.\fPuede reducir la\nDEFENSA ESPECIAL\vdel blanco.",
  ["MrPsychicsHouseSignText"] = "CASA DEL SR.\nPSÍQUICO",
  ["MtMoonSquareSignText"] = "PLAZA MT. MOON\fSube las escaleras\n",
  ["MtMortarSign1Text"] = "MONTE MORTERO\fCUEVA CASCADA\nInterior",
  ["MtMortarSign2Text"] = "MONTE MORTERO\fCUEVA CASCADA\nInterior",
  ["MtSilverSignText"] = "MT. PLATEADO",
  ["MysticWaterGuyTextAfter"] = "Pues yo me voy\na pescar.",
  ["MysticWaterGuyTextBefore"] = "Atrapé un POKéMON\nque llevaba un\vobjeto. Creo\fque es AGUA MÍSTICA.\nNo lo necesito,\f¿lo quieres?\n",
  ["NationalParkBattleNoticeText"] = "¿Qué dice este cartel?\nPor favor, lucha\fsólo en la hierba.\nPUESTO DEL GUARDA\fPARQUE NACIONAL\n",
  ["NationalParkBugContestBattleNoticeText"] = "¿Qué dice este cartel?\nPor favor, lucha\fsólo en la hierba.\nPARQUE NACIONAL\fPUESTO DEL\nGUARDA",
  ["NationalParkBugContestRelaxationSquareText"] = "PLAZA DEL DESCANSO\nPARQUE NACIONAL",
  ["NationalParkBugContestTrainerTipsText"] = "PISTAS ENTRENADOR\fImprime una CARTA\nabriéndola y pulsando\vSTART",
  ["NationalParkGameboyKidText"] = "Estoy imprimiendo\nmi POKéDEX. También\fpuedes imprimir\nlas CARTAS\fy CAJAS de\ntu PC.",
  ["NationalParkLassText"] = "¡Eh! ¡Mira mi mochila!\nImprimí desde\fla POKéDEX mis\nPOKéMON favoritos\fy los pegué\nen ella.",
  ["NationalParkPersianText"] = "PERSIAN: ¡Persiia!",
  ["NationalParkPokefanFText"] = "Es una CARTA de\nmi hija. ¡Me\vda ánimos!",
  ["NationalParkRelaxationSquareText"] = "PLAZA DEL DESCANSO\nPARQUE NACIONAL",
  ["NationalParkTeacher1Text"] = "¡Presta atención,\npor favor! ¡Ups!\fA ver si dejo\nde hablar como\fsi fuera una\nmaestra. Parece\fque entrenas\nPOKéMON. Como\festás trabajando\ntanto, he\fpensado darte\nesto.",
  ["NationalParkTeacher1Text_GotQuickClaw"] = "Dale a un POKéMON\nesa GARRA RÁPIDA.\fA veces, atacará\nel primero en\vcombate.",
  ["NationalParkTeacher2Text"] = "Doy paseos por\nel PARQUE, pero\fnunca entro en\nla hierba. Los\fentrenadores adoran\nluchar…",
  ["NationalParkTrainerTipsText"] = "PISTAS ENTRENADOR\fImprime una CARTA\nabriéndola y pulsando\vSTART",
  ["NationalParkYoungster1Text"] = "Estoy jugando con\nlas pegatinas de\vmi POKéDEX.",
  ["NationalParkYoungster2Text"] = "La pegatina de la POKéDEX\ndel otro chico será\vmía si gano.",
  ["NewBarkTownElmsHouseSignText"] = "CASA DE ELM",
  ["NewBarkTownElmsLabSignText"] = "LABORATORIO DE ELM",
  ["NewBarkTownPlayersHouseSignText"] = "CASA DE {PLAYER}",
  ["NewBarkTownRivalText1"] = "<……>Este es el famoso LABORATORIO\nPOKEMON OLMO…",
  ["NewBarkTownRivalText2"] = "¿Qué estás\nmirando…?",
  ["NewBarkTownSignText"] = "PUEBLO PRIMAVERA El\fpueblo donde soplan\nvientos de un nuevo\vamanecer",
  ["NoLitteringSignText"] = "No ensuciar. Por\ffavor, no tirar\nbasura",
  ["NoRoomForLeftoversText"] = "Pero {PLAYER} no\ntiene espacio…",
  ["NurseAskHealText"] = "Nosotros curamos\na tus POKéMON.\v¿Quieres curar\fa tus POKéMON?\n",
  ["NurseDayText"] = "¡Bienvenidos\na nuestro CENTRO\vPOKéMON!",
  ["NurseGoodbyeText"] = "¡Vuelve siempre que quieras!\n¡Vuelve siempre que quieras!",
  ["NurseMornText"] = "¡Bienvenidos\na nuestro CENTRO\vPOKéMON!",
  ["NurseNiteText"] = "¡Buenas noches!\nBienvenidos a\fnuestro CENTRO\nPOKéMON.",
  ["NursePokerusText"] = "Tus POKéMON tienen\nminúsculas formas\fde vida unidas\na ellos. Tus\vPOKéMON están\fsanos y parecen\ncontentos. Pero\vno podemos\fdarte más información\nen un CENTRO\fPOKéMON.\n",
  ["NurseReturnPokemonText"] = "¡Gracias por esperar!\nTus POKéMON\festán en plena\nforma.",
  ["NurseTakePokemonText"] = "Muy bien, déjame\ntus POKéMON.",
  ["OakLabDexCheckText"] = "¿Qué tal va\ntu POKéDEX?\fVeamos…",
  ["OakLabGoodbyeText"] = "Si pasas por aquí,\nespero que vengas\va visitarme.",
  ["OakNoKantoBadgesText"] = "OAK: ¿Cómo? ¿No has\nconseguido las MEDALLAS\vDE KANTO? Los LÍDERES\fde los GIMNASIOS\nde KANTO son tan\ffuertes como\nlos de JOHTO.\fTe aconsejo que\nte enfrentes\va ellos.",
  ["OakWelcomeKantoText"] = "OAK: ¡{PLAYER}!\nQué bueno que\fhayas venido hasta\nKANTO. ¿Qué piensas\fde los entrenadores\nde aquí?\fFuertes,\n¿no?",
  ["OakYesKantoBadgesText"] = "OAK: Ah, estás coleccionando\nlas MEDALLAS de\vGIMNASIO de KANTO.\fMe imagino que es\nduro, pero la experiencia\fte será de ayuda.\nVen a verme cuando\flas tengas todas.\nTe tengo preparado\fun regalo.\n¡Sigue así,\f{PLAYER}!\n",
  ["OaksAssistant1Text"] = "El programa de la\nHORA POKéMON del PROF.\fOAK no se emite\naquí, en KANTO.\f¡Qué pena! ¡Me gustaría\noírlo!",
  ["OaksAssistant2Text"] = "Gracias a tu\nPOKéDEX, la\vinvestigación\vdel profesor\festá avanzando.\n",
  ["OaksAssistant3Text"] = "No se lo digas a\nnadie, pero la\fHORA DE OAK no\nes en directo.",
  ["OaksLabPCText"] = "Hay un e-mail en\nel PC. … PROF.\fOAK, ¿cómo siguen\fsus investigaciones?\nYo sigo perseve-\vrando en lo mío.\fHe oído rumores\nde que {PLAYER}\fse está labrando\nbuena reputación.\fEstoy encantado\nde oír eso.\fELM, de\nPUEBLO\fPRIMAVERA\n8-)",
  ["OaksLabPoster1Text"] = "Pulsa START para\nacceder al MENÚ.",
  ["OaksLabPoster2Text"] = "La opción GUARDAR\nestá en el MENÚ.\fUtilízala con\nfrecuencia.",
  ["OaksLabSignText"] = "LABORATORIO DE INVESTIGACIÓN\nPOKéMON DE OAK",
  ["OaksLabTrashcanText"] = "Aquí no hay\nnada…",
  ["OfferGoodRodText"] = "¡CIUDAD OLIVO está\njunto al mar!\f¡Y si está junto\nal mar, tiene\vque haber peces!\fLlevo 30 años\npescando aquí.\f¿Quieres mirar\nal mar y\vpescar?",
  ["OfferSuperRodText"] = "Soy el hermano\npequeño del\vGURÚ PESCADOR.\fVeo que te gusta\npescar. ¡No\ftengo ninguna\nduda! Sé\fque tengo\nrazón.",
  ["OfficerDirkAfterBattleText"] = "Ya sabes, la noche\nes divertida\va su manera.\fPero no te pases,\n¿vale?",
  ["OfficerDirkBeatenText"] = "¡Uy!",
  ["OfficerDirkPrettyToughText"] = "Tus POKéMON son bastante\nfuertes. Estarás\fa salvo en cualquier\nparte.",
  ["OfficerDirkSeenText"] = "¡El peligro acecha\npor la noche!",
  ["OfficerKeithAfterText"] = "Hoy no veo nada\nmalo. Pórtate\fbien y no te metas\nen líos.",
  ["OfficerKeithDaytimeText"] = "Estoy buscando\nindividuos sospechosos.\v",
  ["OfficerKeithSeenText"] = "¿Quién anda ahí?\n¿Qué es lo que\vquieres?",
  ["OfficerKeithWinText"] = "Eres muy\nfuerte.",
  ["OfficerText_AvoidGrass"] = "Usa esta puerta\npara no andar por\vla hierba.",
  ["OfficerText_FoundTM"] = "Esos gamberros\nde negro me\vecharon de mi\fpuesto. Se dejaron\nesto. Me molesta.\f¿Podrías\nllevártelo?\v",
  ["OlivineCafeFishingGuruText"] = "¡El menú del CAFÉ\nOLIVO está repleto\fde buena comida\npara fornidos\vMARINEROS!",
  ["OlivineCafeSailorText"] = "Cuando estoy de\npaso, siempre visito\fel CAFÉ OLIVO.\nTodo lo del menú\fme hace sentir\nmás fuerte. ¡No\fpuedo parar\nde comer!",
  ["OlivineCafeStrengthSailorText"] = "¡Ja! ¡Tus\nPOKéMON parecen\vser muy enclenques!\fNo tienen\nel poder\vpara desplazar\frocas.\nMira,\v¡usa esto\fy enséñales\nFUERZA!\f\n",
  ["OlivineCafeStrengthSailorText_GotStrength"] = "¡En el mar sólo\npuedes confiar\fen ti mismo!\n¡Y yo estoy\fen plena\nforma!",
  ["OlivineCityBattleTowerSignText"] = "HACIA LA TORRE BATALLA\n¡Ya hemos abierto!",
  ["OlivineCityBattleTowerSignText_NotYetOpen"] = "HACIA LA TORRE BATALLA",
  ["OlivineCityPortSignText"] = "PUERTO OLIVO MUELLE\nDEL FERRY",
  ["OlivineCityRivalText"] = "… ¿Tú otra vez?\f¿Y a mí qué me\fimporta? Enclen-\nques como tú no\fme asustan. Y\nhablando de debiluchos,\fla LÍDER del GIMNASIO\nno está aquí.\fSe supone que\nestá cuidando\fa un POKéMON\nenfermo en el\fFARO. ¡Buuuu!\n¡Fuera los POKéMON\fenfermos! ¡Los\nPOKéMON que\vno pueden luchar\fson unos inútiles!\n¿Por qué no\vvas a entrenar\fal FARO?\n¿Quién sabe?\v¡A lo mejor\fte refuerza!\n\v",
  ["OlivineCitySailor1Text"] = "Las calles oscuras\nson muy peligrosas\vpor la noche. Pero,\fsi es noche cerrada,\n¡el mar es aún\fmás traicionero!\nSi no les guiara\fla luz del FARO,\nlos barcos\fno podrían\nnavegar.",
  ["OlivineCitySailor2Text"] = "¡El mar es dulce! ¡Los\natardeceres en el\fmar son maravillosos!\n¡Canta conmigo!\v¡La, la, la…!",
  ["OlivineCitySignText"] = "CIUDAD OLIVO El\fpuerto a tierras\nlejanas",
  ["OlivineCityStandingYoungsterPokedexText"] = "¡Uauu, tienes\nuna POKéDEX!\fEs realmente\nincreíble.\v",
  ["OlivineCityStandingYoungsterPokegearText"] = "eso es lo que tienes\nEs un POKéGEAR, ¿verdad? ¡Guau!\v¡Es brillante!",
  ["OlivineGymGuidePreText"] = "YASMINA, la LÍDER\ndel GIMNASIO, está\ven el FARO.\fCuida de un\nPOKéMON enfermo.\fUn entrenador fuerte\ndebe tener\vcompasión.",
  ["OlivineGymGuideText"] = "YASMINA usa el\ntipo acero, que es\vmuy reciente.\fNo sé casi nada\nsobre él.",
  ["OlivineGymGuideWinText"] = "¡Ha sido increíble!\fAsí que el tipo\nacero, ¿eh?\f¡Ha sido un combate\nentre tipos\vdesconocidos!",
  ["OlivineGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vOLIVO: YASMINA\fLa chica\nde acero",
  ["OlivineHouseBetaRhydonText"] = "RHYDON: ¡Rhydo!",
  ["OlivineHouseBetaTeacherText"] = "Cuando mis POKéMON\nenfermaron, el FARMACÉUTICO\fde CIUDAD IRIS\nme dio una\vmedicina.",
  ["OlivineLighthouse1FPokefanFText"] = "Antes había unos\nPOKéMON que iluminaban\vel mar que rodea\fCIUDAD OLIVO.\nEl FARO se construyó\fen honor\na esos POKéMON.\v",
  ["OlivineLighthouse1FSailorText"] = "En este FARO se entrena\nla gente. No es\ffácil subir porque\nhay muchos entrenadores.\v",
  ["OlivineLighthouseSignText"] = "FARO DE OLIVO También\nconocido como el\vFARO BRILLANTE",
  ["OlivineMartCooltrainerFText"] = "¿Tus POKéMON saben\nun movimiento para\fllevar personas\npor el agua?",
  ["OlivineMartLassText"] = "Mi BUTTERFREE\nha estado con\vmi novio. Y me\fha traído una\nCARTA suya. ¿Quieres\fsaber lo que\ndice? Veamos…\f¡No! ¡Es un\nsecreto!",
  ["OlivinePokecenter1FFisherText"] = "El MARINERO del CAFÉ\nOLIVO de aquí al lado\fes muy generoso. Le enseñó\nFUERZA a mi POKéMON.\fAhora puede mover\nrocas grandes.",
  ["OlivinePokecenter1FTeacherText"] = "Hay una persona\nen CIUDAD ORQUÍDEA,\vcruzando el\vmar. ¡Dicen\fque presume\nde sus raros\vPOKéMON!",
  ["OlivinePortAskBoardText"] = "Éste es el FERRY\nS.S. AQUA.\f¿Vas a embarcar\nhoy?",
  ["OlivinePortAskTicketText"] = "¿Puedo ver tu\nTICKET BARCO?",
  ["OlivinePortCantBoardText"] = "Lo siento. No puedes\nembarcar.",
  ["OlivinePortComeAgainText"] = "¡Esperamos volver\na verte!",
  ["OlivinePortCooltrainerFText"] = "En KANTO hay muchos\nPOKéMON. ¡Ojalá\fpudiera ir!",
  ["OlivinePortFishingGuru1Text"] = "Aquí es fácil atrapar\nSHELLDER. En\fotros sitios\nson raros.",
  ["OlivinePortFishingGuru2Text"] = "¿Cuántas CAÑAS tienes?\nLas distintas CAÑAS\fsirven para atrapar\ndistintos\vPOKéMON.",
  ["OlivinePortFlashTicketText"] = "{PLAYER} enseña\nel TICKET BARCO.\fMuy bien. ¡Gracias,\njoven!",
  ["OlivinePortFridayShipText"] = "El FERRY zarpará\nel viernes.",
  ["OlivinePortMondayShipText"] = "El FERRY zarpará el\npróximo lunes.",
  ["OlivinePortNoTicketText"] = "{PLAYER} intentó\nenseñar el TICKET\vBARCO… ¡Pero no\flo tiene! ¡Lo\fsiento! Sólo puedes\nsubir si tienes\fun TICKET\nBARCO.",
  ["OlivinePortPassagePokefanMText"] = "El FERRY S.S. AQUA\nnavega hasta KANTO\flos lunes y los\nviernes.",
  ["OlivinePortSailorBeforeHOFText"] = "no queremos\nCaes al mar y por eso no puedes\nentrar.",
  ["OlivinePortSailorGetOnBoardText"] = "El barco va a zarpar.\nPor favor, sube\va bordo.",
  ["OlivinePortYoungsterText"] = "¡El S.S. AQUA usa\npropulsores para\vsurcar las olas!",
  ["OlivinePunishmentSpeechHouseDadText"] = "De camino a CIUDAD\nORQUÍDEA, hay cuatro\fislas desiertas.\n¡Los niños malos\fvan a las\nislas como\vcastigo!",
  ["OlivinePunishmentSpeechHouseDaughterText"] = "Cuando me meto en\nlíos, papá siempre\vse enfada.",
  ["PalletTownFisherText"] = "¡La tecnología es\nincreíble! Ahora puedes\fcambiar POKéMON\ncon el pasado, como\vun e-mail.",
  ["PalletTownSignText"] = "PUEBLO PALETA Un\ftranquilo lugar\nde paz y pureza",
  ["PalletTownTeacherText"] = "Yo también entreno\nPOKéMON. Son mis\fguardaespaldas\npersonales.",
  ["PewterCityBugCatcherText"] = "Por la noche, los\nCLEFAIRY salen a\vjugar al MT. MOON,\fpero no todas\nlas noches.",
  ["PewterCityCooltrainerFText"] = "¿Has ido al GIMNASIO\nde CIUDAD PLATEADA?\fEl LÍDER utiliza\nPOKéMON roca.",
  ["PewterCityGrampsText"] = "¡Vaya! ¿Vienes\nde JOHTO? Me\vtrae muchos recuerdos.\fCuando era joven,\nfui a JOHTO\va entrenar.\fTe pareces mucho\na mí cuando\fyo tenía tu\nedad. Me gustaría\fdarte este\nobjeto que\fencontré\nen JOHTO.\v",
  ["PewterCityGrampsText_GotSilverWing"] = "Visitar nuevos\nsitios y conocer\vgente nueva… Eso\fes lo bueno\nde viajar.",
  ["PewterCityMtMoonGiftShopSignText"] = "Aquí hay una nota…\n¡TIENDA DE REGALOS\fMT. MOON\nabierta!",
  ["PewterCitySignText"] = "CIUDAD PLATEADA La ciudad\nde piedra grisácea",
  ["PewterCityWelcomeSignText"] = "¡Bienvenidos a CIUDAD\nPLATEADA!",
  ["PewterGymGuideText"] = "¡Eh! ¡Futuro\nCAMPEÓN!\fTe va muy bien.\n¿Te estás enfrentando\na los LÍDERES de\nGIMNASIO de KANTO?\fSon gente fuerte y\ndedicada,\figual que los LÍDERES\nde JOHTO.",
  ["PewterGymGuideWinText"] = "¡Eh! ¡Futuro\nCAMPEÓN!\fEl GIMNASIO no te\nha dado problemas.\fLa forma en que\nhas tomado el mando\nha sido inspiradora.\n¡Lo digo en serio!",
  ["PewterGymSignText"] = "LÍDER DEL GIMNASIO POKéMON\nDE CIUDAD PLATEADA:\vBROCK El entrenador\fPOKéMON más fuerte\nque la roca",
  ["PewterMartSuperNerdText"] = "Había una vez un\nanciano muy raro\vque vendía MAGIKARP.\fDecía que los MAGIKARP\ndel LAGO DE LA\fFURIA eran excelentes.\n",
  ["PewterMartYoungsterText"] = "¡Hola! ¡Mira mi\nGYARADOS! Procede\fde un MAGIKARP.\nNo me puedo\fcreer lo fuerte\nque es.",
  ["PewterMuseumSignText"] = "Aquí hay una nota…\nMUSEO DE LA CIENCIA\fDE CIUDAD PLATEADA:\nCerrado por\vobras…",
  ["PewterNidoranSpeechHouseSuperNerdText"] = "¡NIDORAN, agítate!",
  ["PewterPokecenter1FBugCatcherText"] = "Casi todos los POKéMON\nse duermen al oír\fcantar a JIGGLYPUFF.\nCuando un POKéMON\festá dormido sólo\nse pueden usar\fciertos movi-\nmientos.",
  ["PewterPokecenter1FTeacherText"] = "¡Sí! Ya no hay\nGIMNASIO en la\fISLA CANELA.\nMe quedé de piedra.\f¿Sí? Estoy\nal teléfono.\v¡Fuera!",
  ["PewterSnoozeSpeechHouseGrampsText"] = "Me gusta dormirme\ncon la radio\ven… ¡Zzzz…!",
  ["PharmacistDescribeSecretpotionText"] = "Mi POCIÓN SECRETA\nes muy potente. Sólo\fla doy en casos\nde urgencia.",
  ["PharmacistGiveSecretpotionText"] = "Parece que tus\nPOKéMON están\fbien. ¿Hay algo\nque te preocupa?\f… ¿El POKéMON\fdel FARO tiene\nproblemas?\v¡Entendido!\fEsto debería\fayudarte.\n",
  ["PhoneThankYouText"] = "Obrigado!",
  ["PicnickerBrookeAfterBattleText"] = "Confío más en mis\nPOKéMON que en\vmi novio.",
  ["PicnickerBrookeBeatenText"] = "¡Cielos! ¡Eres\ntan fuerte!",
  ["PicnickerBrookeSeenText"] = "Mi novio es débil.\nAsí que no puedo\vconfiar en él.",
  ["PicnickerCindyAfterText"] = "Debes de estar\ncansándote.",
  ["PicnickerCindyBeatenText"] = "¡Maldición! ¡Quería\nganar!",
  ["PicnickerCindyBeforeText"] = "¡Soy SACHIKO! ¿Cómo\fhas sabido que\nno era ella?\f¡Luchemos!",
  ["PicnickerDebraAfterBattleText"] = "AZAFRÁN… AZULONA…\nDicen que hay muchas\fciudades grandes\nen KANTO.",
  ["PicnickerDebraBeatenText"] = "¡Uau! ¡Eres demasiado\nfuerte!",
  ["PicnickerDebraSeenText"] = "Me aburro tanto…\n¿Quieres luchar?",
  ["PicnickerEdnaAfterBattleText"] = "Ahorrar energía\nes importante, pero\fel entorno aún\nlo es más.",
  ["PicnickerEdnaSeenText"] = "La gente no debería\ndejar la basura\vpor ahí.",
  ["PicnickerErin1SeenText"] = "¡Yo también entreno\nPOKéMON! ¿Quieres\fluchar contra mí?",
  ["PicnickerErinAfterBattleText"] = "He estado en muchos\nGIMNASIOS, pero\fel de TRIGAL es\nmi favorito. ¡Está\flleno de flores\npreciosas!",
  ["PicnickerGina1AfterText"] = "Eres demasiado fuerte\npara practicar\vconmigo.",
  ["PicnickerGina1BeatenText"] = "¡Oh, no! No puedo\nganar…",
  ["PicnickerGina1SeenText"] = "¿Entrenas POKéMON?\fLibremos un combate\nde prueba.",
  ["PicnickerHeidiAfterBattleText"] = "Hacemos dulces y\nlos repartimos\fentre todos. ¡Son\ndeliciosos!",
  ["PicnickerHeidiSeenText"] = "¿Has ido alguna\nvez de picnic?\f¡Es muy divertido!\n",
  ["PicnickerHopeAfterBattleText"] = "Dicen que CLEFAIRY\naparece en\vel MT. MOON.\f¿Pero dónde?\n",
  ["PicnickerHopeBeatenText"] = "¡Uau! Eres demasiado\nfuerte.",
  ["PicnickerHopeSeenText"] = "Presiento que\npuedo ganar.\f¡Veamos si tengo\nrazón!",
  ["PicnickerKimAfterBattleText"] = "Me gustan las MEDALLAS\nde los GIMNASIOS.\vLas colecciono.",
  ["PicnickerKimBeatenText"] = "¡Vaya! No pude\nganar…",
  ["PicnickerKimSeenText"] = "¿Vas al GIMNASIO?\n¡Yo también!",
  ["PicnickerLiz1AfterText"] = "Yo también estaba\ncharlando.",
  ["PicnickerLiz1BeatenText"] = "¡Oh! ¡Tengo\nque aliviar\vmi enfado!",
  ["PicnickerLiz1SeenText"] = "Sí. Y sabes que…\n¿Luchar? ¡Estoy\fal teléfono!\nVale. Pero\fque sea\nrápido.",
  ["PicnickerSharonAfterBattleText"] = "…Creo que seguiré\nentrenándome…",
  ["PicnickerTanyaAfterBattleText"] = "¡Uauu! ¡Tienes muchas\nMEDALLAS! ¡No\fme extraña haber\nperdido!",
  ["PicnickerTanyaSeenText"] = "¡Oh! ¿Un combate?\nMe da un poco de miedo,\vpero bueno.",
  ["PicnickerTiffanyBeatenText"] = "¡He jugado mucho!",
  ["PicnickerTiffanySeenText"] = "¿Tú también vas\nal LAGO DE LA\fFURIA? ¡Juguemos\nun ratito!",
  ["PicnickerTiffanyWantsPicnicText"] = "Voy a ir de picnic\ncon mis POKéMON.\v¿No te vienes?\f",
  ["PictureBookshelfText"] = "¡Una colección de\nlibros ilustrados\vde POKéMON!",
  ["PlateauRivalLoseText"] = "… ¡Uau…! Con\fayuda de mis\ncompañeros,\f¡voy a ser el\nCAMPEÓN!",
  ["PlateauRivalText1"] = "Espera. ¿Te vas\fa enfrentar ahora\nal desafío de\fla LIGA POKéMON?\nPues yo no lo\fcreo. Mis POKéMON\nestán muy bien\fentrenados\ny van a acabar\fcontigo.\n¡{PLAYER}!\f¡Te desafío!\n",
  ["PlateauRivalText2"] = "¡Maldición…! Sigo\nsin ganar… Yo…\fTengo que pensar\nmás en mis POKéMON…\v¡Umm! ¡Procura\fno perder!\n",
  ["PlayerHandedSecretpotionText"] = "{PLAYER} entregó\nla POCIÓN SECRETA\va YASMINA.",
  ["PlayerNeighborRadioText1"] = "¡La HORA POKéMON del\nPROF. OAK! ¡Sintonízanos\vla próxima vez!",
  ["PlayerNeighborRadioText2"] = "¡CANAL POKéMON!",
  ["PlayerNeighborRadioText3"] = "¡Soy DJ ROSA, la\npresentadora!",
  ["PlayerNeighborRadioText4"] = "¡POKéMON! El CANAL\nPOKéMON…",
  ["PlayerReceivedPlainBadgeText"] = "{PLAYER} recibió la\nMEDALLA PLANICIE.",
  ["PlayerReceivedRainbowBadgeText"] = "{PLAYER} recibió MEDALLA\nARCOIRIS.",
  ["PlayersHouse1FFridgeText"] = "Vamos ver o que há\nna geladeira…\fFRESH WATER e uma\nboa LEMONADE!",
  ["PlayersHouse1FSinkText"] = "A pia está\nimpecável. A mamãe\vgosta dela limpa.",
  ["PlayersHouse1FStoveText"] = "Prato da mamãe!\fHAMB├ÜRGUER VULCÃO\nDE CINNABAR!",
  ["PlayersHouse1FTVText"] = "En la TV ponen una\npelícula: estrellas en\nel cielo y dos\nniños en el tren…\f¡Será mejor que yo\ntambién me vaya!",
  ["PlayersNeighborsDaughterText"] = "PIKACHU es un POKEMON\nevolucionado. El descubrimiento de ello\nPROF. ELM me deja impresionado. Es muy famoso por su\nInvestigación sobre la evolución de POKéMON.\f(Suspiro…) Ojalá era investigador\ncomo es…",
  ["PlayersRadioText1"] = "¡La HORA POKéMON del\nPROF. OAK! ¡Sintonízanos\vla próxima vez!",
  ["PlayersRadioText2"] = "¡EL CANAL POKéMON!",
  ["PlayersRadioText3"] = "¡Soy DJ ROSA, la\npresentadora!",
  ["PlayersRadioText4"] = "¡POKéMON! El CANAL\nPOKéMON…",
  ["PokecenterSignText"] = "Cura a tus POKéMON\nCENTRO POKéMON",
  ["PokecomCenterAdminOfficeMobileComputer1Text"] = "Es una nota sobre\ndónde deben usarse\flos ADAPTADORES\nde MÓVIL…",
  ["PokecomCenterAdminOfficeMobileComputer1Text_MobileCenter"] = "Para usar el CENTRO\nDE CAMBIO o leer\flas NOTICIAS POKéMON,\nnecesitas llamar\val CENTRO MÓVIL.\vDebes inscribirte\fen el CENTRO\nMÓVIL antes\fde poder\nconectarte.\v",
  ["PokecomCenterAdminOfficeMobileComputer1Text_PokeComClub"] = "El CLUB #COM es\nen el último piso de los CENTROS\nPOKÉMON. Entonces podrás luchar\no cambiar con un amigo\nutilizando el ADAPTADOR MÓVIL. Para conectarse, su amigo debe\ntener el mismo tipo de ADAPTADOR\nde MOVIL.",
  ["PokecomCenterAdminOfficeMobileComputer2Text"] = "Es una nota sobre\ncómo usar el\vteléfono…",
  ["PokecomCenterAdminOfficeMobileComputer2Text_DontUsePhone"] = "Si el servidor\nestá ocupado, no\fserá posible conectar.\nInténtalo más\ftarde. Si no consigues\nconectar o no\fcomprendes los\nmensajes de\ferror, llama\na Atención al\fCliente o lee\nlas instrucciones.\v",
  ["PokecomCenterAdminOfficeMobileComputer2Text_UsePhone"] = "Asegúrate de\nque tu teléfono\fy el ADAPTADOR\nde MÓVIL están\vbien conectados.\fCuida que haya\nbuena cobertura\ven tu móvil.\vNo toques\fni cuelgues\nel móvil\vmientras\vconecta.",
  ["PokecomCenterAdminOfficeMobileComputer3Text"] = "La OFICINA de ADMINISTRACIÓN\nrecibió un e-mail.\vDice… <……> <……>\f<……> Al equipo\fdel CENTRO #COM…\nLa comunicación\fsin cables permite\nque los entrenado-\fres interactúen\na nivel nacional.\fSigamos trabajando\nhasta el día\fen que todos\nlos entrenadores\fdel mundo nos\npodamos unir\vsin barreras.\v<……> <……>\f<……>",
  ["PokecomCenterAdminOfficeMobileScientist1Text"] = "El CENTRO #COM y\nel CENTRO MÓVIL fueron\vconstruidos para\vsatisfacer la demanda\vde cambio y lucha\ventre entrenadores\vque no se\vconocen.",
  ["PokecomCenterAdminOfficeMobileScientist2Text"] = "Cuando enlazaste\ncon alguien\fpor teléfono\nmóvil por primera\vvez, ¿no te\fimpresionó?\n¡La primera\fvez me impresionó\ntanto que\fme puse\na temblar!\v",
  ["PokecomCenterAdminOfficeMobileScientist3Text"] = "Fueron capaces\nde construir este\fgran edificio\ngracias a los\vavances en tecnología\vinalámbrica.\v",
  ["PokefanBeverlyCuteMonText"] = "Debo decirte\nque tus POKéMON\vson bonitos\vtambién.",
  ["PokefanMDerekText_NotBragging"] = "¡No te estoy escuchando!\n¡Los #FANS tenemos\fpor norma no\nescuchar a\fla gente presumida!\n",
  ["PokefanfBeverly1BeatenText"] = "Puedo\nderrotarte,\fpero…\n",
  ["PokefanfBeverly1SeenText"] = "Mis POKéMON son\nencantadores.\vDéjame mostrarte\flo orgullosa\nque estoy\vde ellos.",
  ["PokefanfGeorgiaAfterBattleText"] = "¡Ah, sí! Tengo que ir\na buscar a mis POKéMON\va la GUARDERÍA.",
  ["PokefanfGeorgiaBeatenText"] = "¿Qué es lo que\niba a hacer?",
  ["PokefanfGeorgiaSeenText"] = "Me voy de compras\nal C. COMERCIAL\vy luego…",
  ["PokefanfRuthAfterBattleText"] = "¿Sabes algo sobre\nlos POKéMON bebés?\f¡Seguro que son\nadorables!",
  ["PokefanfRuthBeatenText"] = "No me importa\nperder.",
  ["PokefanfRuthSeenText"] = "¡Qué POKéMON más\nencantadores! Enseñemos\fnuestros POKéMON\nal mismo\vtiempo.",
  ["PokefanmAlexAfterBattleText"] = "ni siquiera lo sé\n¿Ser rey en todo el mundo?",
  ["PokefanmAlexBeatenText"] = "¿Qué? ¡Te burlas\nde la realeza!",
  ["PokefanmBrandonAfterText"] = "Mi POKéMON lo sabía\nmovimientos que no conoces.\fEso me confundió\nmucho!",
  ["PokefanmBrandonBeatenText"] = "¿Por qué acaba\nasí?",
  ["PokefanmBrandonSeenText"] = "Acabo de recoger\nmi POKéMON de la\vGUARDERÍA. ¡Veamos\flo fuerte que\nes ahora!",
  ["PokefanmCarterAfterBattleText"] = "SQUIRTLE, CHARMAN-\nDER y BULBASAUR.\vCreo que es\funa buena combinación.\n",
  ["PokefanmColinAfterBattleText"] = "¿Viajas sin compañía?\n¿Tu madre\fno está preocupada?\n",
  ["PokefanmColinSeenText"] = "¡Hola, peque! ¿Quieres\nluchar?",
  ["PokefanmDerekBeatenText"] = "No tuve tiempo de presumir\nde mi PIKACHU…",
  ["PokefanmDerekSeenText"] = "¡Es buen momento\npara alardear de\vmi PIKACHU!",
  ["PokefanmJeremyAfterBattleText"] = "¡Debo ir a la PELUQUERÍA\nPOKéMON para ponerlos\vguapos!",
  ["PokefanmJeremyBeatenText"] = "¡Oh, no! ¡Mis preciosos\nPOKéMON!",
  ["PokefanmJeremySeenText"] = "¿Qué opinas? Mis\nPOKéMON son bonitos,\v¿verdad?",
  ["PokefanmJoshuaAfterBattleText"] = "Parece que tienes\nmuchos POKéMON,\fpero PIKACHU\nes el mejor.",
  ["PokefanmJoshuaSeenText"] = "¡Jijiji! ¿Quieres\nluchar contra mi grupo\vde PIKACHU?",
  ["PokefanmRobertAfterBattleText"] = "Mira lo que le\nhas hecho a mi\fPOKéMON. No lo\nolvidaré…",
  ["PokefanmRobertBeatenText"] = "Debo admitir\nmi derrota.",
  ["PokefanmRobertSeenText"] = "Te gustan los POKéMON,\n¿verdad? ¡A\fmí también!",
  ["PokefanmTrevorAfterBattleText"] = "Si hubiera un sistema\nfácil de identificar\vdónde obtuve\vmi POKéMON…",
  ["PokefanmTrevorBeatenText"] = "¿Dónde conocí\na este PSYDUCK?\v",
  ["PokefanmTrevorSeenText"] = "Hola. ¿Sabes qué…?\fLos POKéMON son\nmás amigables si\flos entrenas en\nun lugar que ellos\vrecuerden.",
  ["PokefanmWilliamAfterBattleText"] = "Perdí el combate,\npero mis POKéMON\fson más adorables\nque los tuyos.",
  ["PokefanmWilliamSeenText"] = "Queremos a nuestros\nPOKéMON, aunque ellos\vno nos quieran. Eso\fsignifica ser un\nFAN POKéMON.",
  ["PokemaniacAndrewAfterBattleText"] = "Sólo yo y mis POKéMON.\n¡Me muero de\valegría!",
  ["PokemaniacAndrewSeenText"] = "¿Quién anda ahí? ¡Déjame\fen paz, a mí y\na mis POKéMON!",
  ["PokemaniacBenAfterBattleText"] = "¿Que qué me gusta además\nde los POKéMON? Oír\va ROSA en la radio.\f¡Seguro que es\nmuy guapa!",
  ["PokemaniacBenBeatenText"] = "¿Cómo me has podido\nhacer esto?",
  ["PokemaniacBrentAfterBattleText"] = "Sería feliz con\nsólo tener un\vPOKéMON raro.",
  ["PokemaniacBrentBeatenText"] = "¡Oh, mis pobres\nPOKéMON!",
  ["PokemaniacBrentSeenText"] = "¡Eh! ¿Tienes algún\nPOKéMON raro?",
  ["PokemaniacCalvinAfterBattleText"] = "Debería reunir\ny publicar mis\vhallazgos. Podría\fhacerme tan famoso\ncomo el PROF.\vELM.",
  ["PokemaniacCalvinBeatenText"] = "¡Lo has demostrado\nconmigo!",
  ["PokemaniacCalvinSeenText"] = "He venido hasta aquí\npara estudiar a\vlos POKéMON. ¡Te\fdemostraré mis\nhallazgos en un\vcombate real!",
  ["PokemaniacDonaldAfterBattleText"] = "¿Tienes una POKéDEX?\nPues te daré una\vpista. El MONTAÑERO\fde la RUTA 33,\nLUIS, es un buen\vchico. Te telefoneará\fsi ve algún\nPOKéMON\vraro.",
  ["PokemaniacDonaldBeatenText"] = "¡Bah! ¡He perdido!\n¡Qué rabia me da!",
  ["PokemaniacDonaldSeenText"] = "Creo que tienes\nalgunos POKéMON\vmuy raros. ¡Déjame\fverlos!",
  ["PokemaniacEthanAfterBattleText"] = "LILA es buena pero\nROSA es la mejor.\f¡Me encantaría escuchar\nlas emisoras\vde JOHTO!",
  ["PokemaniacEthanSeenText"] = "¿Conoces a LILA?\nEs una DJ muy buena\vde KANTO.",
  ["PokemaniacIssacAfterBattleText"] = "Los POKéMON serán\nmás amigos tuyos\fsi los llevas a cortarse\nel pelo.",
  ["PokemaniacIssacSeenText"] = "¡Les corté el pelo\na mis POKéMON! ¡Ahora\fverás lo fuertes\nque son!",
  ["PokemaniacLarryAfterBattleText"] = "Todos los viernes\nse escucha a\fun POKéMON\nque ruge en\vla cueva.",
  ["PokemaniacLarryBeatenText"] = "¡Ugh! Mis pobres\nPOKéMON…",
  ["PokemaniacLarrySeenText"] = "Merodeo por todas partes\nen busca de POKéMON.\v¿También tú vas en\fbusca de POKéMON?\n¡Pues entonces\feres mi rival coleccionista!\n",
  ["PokemaniacRonAfterBattleText"] = "Es bueno que a\nla gente le gusten\fdistintos tipos\nde POKéMON. No\fsólo se trata\nde tener el\vmás fuerte.",
  ["PokemaniacRonBeatenText"] = "¡Mi NIDOKING lo ha\nhecho muy bien!",
  ["PokemaniacRonSeenText"] = "¿Te lo puedes\ncreer? ¡<RIVAL>\fse ha burlado\nde mi POKéMON!\v¡Maldición!\f¡Mi POKéMON\nes genial!",
  ["PokemaniacShaneAfterBattleText"] = "¿Tienes una\nPOKéDEX? ¡Uau,\fhabrás visto\nPOKéMON muy\vraros! ¿Puedo\fverla, por\nfavor?",
  ["PokemaniacShaneBeatenText"] = "Debí haber usado\nmi PIEDRA LUNAR…",
  ["PokemaniacShaneSeenText"] = "¡OYE! ¡Éste es\fmi lugar secreto!\n¡Fuera de aquí,\vcotilla!",
  ["PokemaniacZachAfterBattleText"] = "Los POKéMON de colores\npoco habituales\ftienen más valor.\n¿Qué? ¿Insinúas\fque no es\ncierto?",
  ["PokemaniacZachBeatenText"] = "Oooh, tus POKéMON\nson muy bonitos.",
  ["PokemaniacZachSeenText"] = "¡Haré lo que sea\npara conseguir\vPOKéMON raros!",
  ["PokemonFanClubBayleefText"] = "BAYLEEF:\n¡Liliif!\f\n\v",
  ["PokemonFanClubBraggingSignText"] = "Si alguno alardea,\nhazlo tú también.",
  ["PokemonFanClubChairmanDidYouVisitToHearAboutMyMonText"] = "Soy el PRESIDENTE\ndel CLUB de FANS\vde POKéMON. He\fcurado a más de\n150 POKéMON. Soy\fmuy exigente cuando\nse trata de\vPOKéMON. ¿Has\fvenido para\nsaber de mis\vPOKéMON?",
  ["PokemonFanClubChairmanHowDisappointingText"] = "¡Qué pena…!\f¡Vuelve cuando\nquieras!",
  ["PokemonFanClubChairmanIWantYouToHaveThisText"] = "¡Gracias por\nescucharme!\v¡Toma esto!",
  ["PokemonFanClubChairmanItsARareCandyText"] = "Es un CARAMELORARO\nque fortalece a\vlos POKéMON. Prefiero\fque mis POKéMON\nluchen para fortalecerse.\f¡Así que\ntoma!",
  ["PokemonFanClubChairmanMoreTalesToTellText"] = "¡Hola, {PLAYER}!\f¿Viniste a verme\nde nuevo por mis\vPOKéMON? ¿No? Oh…\fTengo más historias\nque contar…",
  ["PokemonFanClubChairmanRapidashText"] = "¡Muy bien! ¡Pues\nescucha! Mi… preferido\fes RAPIDASH… Es…\ngracioso… cariñoso…\fveloz e increíble…\n¿No crees…? Es\vsorprendente…\vsimpático… ¡Y\vlo quiero! Si\vlo abrazas…\vcuando duerme…\fes tan cálido…\ny mimoso… Es\vespectacular…\vencantador…\v¡Uuups! ¡Mira\vqué hora\ves! ¡Hablo\vdemasiado!\v",
  ["PokemonFanClubClefairyDollText"] = "¡Es un CLEFAIRY!\n¿Verdad? ¡No!\fEs un # MUÑECO\nCLEFAIRY.\v",
  ["PokémonFanClubClefairyGuyClefairyEsTanAdorableTexto"] = "Me encanta el modo\nen que CLEFAIRY\fmueve el dedo\npara usar METRÓNOMO.\f¡Es tan adorable!\n",
  ["PokemonFanClubClefairyGuyGoingToGetARealClefairyText"] = "¡Ya verás! Voy\na hacerme amigo\fde un auténtico\nCLEFAIRY.",
  ["PokemonFanClubClefairyGuyMakingDoWithADollIFoundText"] = "Me gusta CLEFAIRY,\npero jamás podría\fatrapar uno. Por eso\nme conformo con este\f# MUÑECO que he\nencontrado.",
  ["PokemonFanClubClefairyGuyPackIsJammedFullText"] = "Tu MOCHILA está\nrepleta.",
  ["PokemonFanClubClefairyGuyTakeThisDollBackToGirlText"] = "¡Ah, entiendo! La\nniña que perdió\fel # MUÑECO está\ftriste… Vale. ¿Podrías\ndevolverle este\f# MUÑECO a esa\npobre niña? Un\fdía me haré amigo\nde un CLEFAIRY\freal. ¡No te\npreocupes!",
  ["PokemonFanClubListenSignText"] = "Escuchemos atentamente\na los entrenadores.\v",
  ["PokemonFanClubPlayerReceivedDollText"] = "{PLAYER} recibió\nel # MUÑECO.",
  ["PokemonFanClubReceptionistText"] = "Al PRESIDENTE le encanta\nhablar cuando se trata\vde POKéMON…",
  ["PokemonFanClubSignText"] = "CLUB DE FANS\fDE POKéMON ¡Bienvenidos!\n",
  ["PokemonFanClubTeacherText"] = "mira mi preciosa\n¡BAYLEEF! Toma un poco hoy\nMona!",
  ["PowerPlantGymGuide1GeneratorUpAndRunningText"] = "El generador ya\nfunciona y está\ven marcha.\f¡Está produciendo\nelectricidad!",
  ["PowerPlantGymGuide1SomeoneStoleAPartText"] = "Alguien se llevó\nuna pieza que es\fimprescindible para\nel generador.\fSin ella, el\nnuevo generador\vno sirve.",
  ["PowerPlantGymGuide2GeneratorIsRunningAgainText"] = "¡El generador\nfunciona de nuevo!",
  ["PowerPlantGymGuide2PowerPlantUpAndRunningText"] = "Esta CENTRAL\nENERGÍA había sido\vabandonada.\fLa hemos reactivado\npara dar\fenergía al\nMAGNETOTRÉN.",
  ["PowerPlantGymGuide4MagnetTrainConsumesElectricityText"] = "El MAGNETOTRÉN\ngasta mucha\velectricidad.\fNo se mueve si el\nnuevo generador\vno funciona.",
  ["PowerPlantGymGuide4WeCanGetMagnetTrainRunningText"] = "Legal! Podemos\nfinalmente p├┤r o\fMAGNET TRAIN\nde novo no ar!",
  ["PowerPlantManagerIWontForgiveCulpritText"] = "DIRECTOR: ¡Nunca\nle perdonaré! Aunque\fel culpable llore\ny suplique perdón,\f¡le machacaré!\n¡Ja, ja,\fja!",
  ["PowerPlantManagerMyBelovedGeneratorText"] = "DIRECTOR: ¡Mi querido\ngenerador! ¡Sigue\fproduciendo electricidad!\n",
  ["PowerPlantManagerTM07IsZapCannonText"] = "DIRECTOR: La MT07\nes mi ELECTRO-\fCAÑÓN. ¡Es muy\npotente! Aunque\fpresenta el inconveniente\nde no ser\fmuy precisa.\n",
  ["PowerPlantManagerTakeThisTMText"] = "¡Yuju! ¡Gracias!\f¡Toma esta MT como\nrecompensa!",
  ["PowerPlantManagerThatsThePartText"] = "DIRECTOR: ¡Sí! ¡Ésa\fes la pieza que\nle faltaba a mi\vgenerador! ¿La encontraste\vtú?",
  ["PowerPlantManagerWhoWouldRuinMyGeneratorText"] = "DIRECTOR: ¡Me voy\na enfadar con alguien!\v¿Quién ha roto\fmi generador?\n¡Con el tiempo\fque le he dedicado!\n¡Como lo atrape,\fva a saber\nlo que es\fmi ELECTROCAÑÓN!\n",
  ["PowerPlantOfficer1AThiefBrokeInText"] = "Entró un ladrón en\nla CENTRAL ENERGÍA…\f¿Adónde vamos\na ir a parar?",
  ["PowerPlantOfficer1CeruleanShadyCharacterText"] = "Tengo noticias de\nCIUDAD CELESTE. Parece\fque ha estado merodeando\npor allí un\fhombre muy sospechoso.\n",
  ["PowerPlantOfficer1CouldIAskForYourCooperationText"] = "¿Puedo pedirte\nayuda?",
  ["PowerPlantOfficer1HaveToBeefUpSecurityText"] = "Tendremos que reforzar\nlas medidas de\vseguridad.",
  ["PowerPlantOfficer2ManagerHasBeenCheerfulText"] = "El DIRECTOR está\ncontento porque\fel generador ya\nestá arreglado.",
  ["PowerPlantOfficer2ManagerHasBeenSadAndFuriousText"] = "El DIRECTOR de la\nCENTRAL ENERGÍA\vestá ahí delante.\fPero está triste\ny enfadado porque\valguien ha estropeado\vel generador…\v",
  ["PowerPlantSignText"] = "CENTRAL ENERGÍA DE KANTO",
  ["PrintDayCareText.HaveNoRoomText"] = "No tienes\nsitio para esto.",
  ["PrintDayCareText.NotEnoughMoneyText"] = "No tienes\ndinero.",
  ["PryceText_CherishYourPokemon"] = "La primavera llega\ncuando se derrite\vel hielo y la\fnieve. Tú y\ntus POKéMON\fpasaréis juntos\nmuchos años.\f¡Pasadlo\nbien!",
  ["PryceText_GlacierBadgeSpeech"] = "Esta MEDALLA sube\nlas habilidades ESPECIALES\vde los POKéMON.\fY tus POKéMON usarán\nTORBELLINO para\vpasar los torbellinos.\v¡Además, te\fvoy a hacer\nun regalo!",
  ["PryceText_IcyWindSpeech"] = "Esta MT contiene\nVIENTO HIELO.\fCausa daño y baja\nla velocidad.\fDemuestra la\ndure- za del\vinvierno.",
  ["PryceText_Impressed"] = "¡Ah! Me impresiona\ntu valor. Con\vtu gran voluntad,\fsé que superarás\ntodos los\fobstáculos.\n¡Te mereces\festa MEDALLA!\n",
  ["PryceText_Intro"] = "Los POKéMON viven\ntodo tipo de experiencias.\fYo también he\nvisto y sufrido\fmucho en mi vida.\nSoy mayor, así\vque te enseñaré\flo que quiero\ndecir. He estado\vcon los POKéMON\fdesde antes\nde que tú nacieras.\fY no pierdo\nfácilmente.\f¡Yo, FREDO,\nel entrenador\fdel invierno,\nte mostraré\fmi poder!\n",
  ["PsychicFidelAfterBattleText"] = "Fuerza de convicción…\nEres fuerte\fporque confías\nen tus POKéMON.\v",
  ["PsychicFidelBeatenText"] = "No me imaginaba\ntu poder…",
  ["PsychicFidelSeenText"] = "Ya veo… Todo\flo que hay que\nver de ti…",
  ["PsychicFranklinAfterBattleText"] = "Has fortalecido tu\nalma, no sólo tus\vhabilidades.",
  ["PsychicFranklinBeatenText"] = "¡Tu alma tiene más\npoder que la mía!",
  ["PsychicFranklinSeenText"] = "El poder psíquico\nes el poder\vde tu alma.",
  ["PsychicGilbertAfterBattleText"] = "Con tus habilida-\ndes, te irá bien\ven la LIGA. Eso\fes lo que presiento.\n",
  ["PsychicGilbertBeatenText"] = "¡Eres demasiado!",
  ["PsychicGilbertSeenText"] = "¡No digas nada!\fDéjame adivinar\nlo que piensas.\f¡Mmmmmmm…! ¡Listo!\f¡Estás en\nla LIGA POKéMON!\v",
  ["PsychicGregAfterBattleText"] = "Dormir o paralizar\na los POKéMON son\vbuenas técnicas\vde lucha.",
  ["PsychicGregBeatenText"] = "He perdido.\n¡Qué pena…!",
  ["PsychicGregSeenText"] = "Los POKéMON no pueden\nhacer nada dormidos.\v¡Yo te enseñaré\fel miedo que\nda eso!",
  ["PsychicHermanAfterBattleText"] = "… Perdí cuando\ftenía los ojos\ncerrados.",
  ["PsychicJaredAfterBattleText"] = "El REY del KARATE,\nel maestro del DOJO-KARATE,\facaba de ser\nmachacado por\vSABRINA.",
  ["PsychicJaredSeenText"] = "El DOJO-KARATE era\nel GIMNASIO de\vesta ciudad.",
  ["PsychicMarkAfterBattleText"] = "Sería fuerte si\npudiera saber lo\fque está pensando\nmi rival.",
  ["PsychicMarkSeenText"] = "¡Te voy a leer el\npensamiento!",
  ["PsychicNathanAfterBattleText"] = "Me gusta pensar\naquí.",
  ["PsychicNathanSeenText"] = "¡Mmm…! ¡Qué lugar\ntan extraño!",
  ["PsychicNormanAfterBattleText"] = "¿Sabes que los POKéMON\ntienen distintas\vhabilidades? Son\fcomo las personas.\nCada uno tiene\fsu propio potencial.\n",
  ["PsychicNormanBeatenText"] = "¡Ooh! Tus POKéMON\ntienen potencial.",
  ["PsychicNormanSeenText"] = "Déjame ver de qué\nson capaces tus\vPOKéMON.",
  ["PsychicPhilAfterBattleText"] = "Es importante tener\nconfianza en\vuno mismo.",
  ["PsychicPhilBeatenText"] = "¡Arrgh…! No esperaba\nperder.",
  ["PsychicPhilSeenText"] = "¡Voy a ganar!\n¡Seguro!",
  ["PsychicRichardAfterBattleText"] = "Las personas y los\nPOKéMON se enriquecen\vcon la experiencia.\fNo seas tan conformista.\n",
  ["PsychicRichardSeenText"] = "¡Uau! ¡Cuántas\nMEDALLAS! Estoy\vimpresionado.\fPero no te basta\nsólo con coleccio-\fnarlas, ¿verdad?\n",
  ["PsychicRodneyAfterBattleText"] = "Entiendo. Puedes oír\nla radio de JOHTO\ven el FERRY.",
  ["PsychicRodneyBeatenText"] = "¡Escucho\nalgo…!",
  ["PsychicRodneySeenText"] = "¡Ssh! ¡Mi cerebro\nestá captando señales\vde radio!",
  ["RadioTower1FDirectoryText"] = "PB RECEPCIÓN\nP1 VENTAS P2\fPERSONAL P3 PRODUCCIÓN\nP4 OFICINA\fDEL    DIRECTOR\n",
  ["RadioTower1FLassText"] = "NARDO es un DJ\nfabuloso. ¡Su\fdulce voz me\nderrite!",
  ["RadioTower1FLuckyChannelSignText"] = "¡CANAL SUERTE! ¡Gana\fcon los ID de los\nPOKéMON! ¡Cambia\fPOKéMON y reúne\ndiferentes números\vID!",
  ["RadioTower1FLuckyNumberManAskToPlayText"] = "¿Quieres probar\nen el NÚMERO DE\vLA SUERTE? ¿Compruebo\flos números ID\nde tus POKéMON?\vSi tienes suerte,\fganarás un\npremio.",
  ["RadioTower1FLuckyNumberManCheckIfMatchText"] = "A ver si coincide\ncon tu número.",
  ["RadioTower1FLuckyNumberManComeAgainText"] = "Vuelve la próxima semana\ny participa otra vez en\vel N.° DE LA SUERTE.",
  ["RadioTower1FLuckyNumberManDotDotDotText"] = "<……>\n<……>",
  ["RadioTower1FLuckyNumberManNoRoomForYourPrizeText"] = "No tienes sitio\npara tu premio.\fHazle sitio y vuelve\nenseguida.",
  ["RadioTower1FLuckyNumberManNoneOfYourIDNumbersMatchText"] = "¡No! Tus números\nID no coinciden.",
  ["RadioTower1FLuckyNumberManOkayMatchText"] = "¡Oye! ¡Tus tres\núltimos números\vcoinciden! ¡Ganaste\fel segundo\npremio: REPARTIR\vEXP!",
  ["RadioTower1FLuckyNumberManPerfectMatchText"] = "¡Uauu! ¡Tus cinco\nnúmeros coinciden!\v¡Ya tenemos\fganador! ¡Has\nganado una\fMASTER\nBALL!",
  ["RadioTower1FLuckyNumberManThisWeeksIdIsText"] = "El número de\nesta semana\ves @ .",
  ["RadioTower1FLuckyNumberManWeakMatchText"] = "¡Ooooh! ¡Tus dos\núltimos números\vcoinciden! Ganaste\fel tercer premio:\nMÁS PP.",
  ["RadioTower1FPokegearIsARadioText"] = "¡El POKéGEAR de {PLAYER}\nse puede usar\vcomo radio!",
  ["RadioTower1FRadioCardWomanNotTakingQuizText"] = "¡Ah! Entiendo. Vuelve\na probar si cambias\vde idea.",
  ["RadioTower1FRadioCardWomanOfferQuizText"] = "Ahora tenemos una\npromoción especial.\vAcierta estas\f5 preguntas y\ngana una TARJETA\vRADIO. Introdúcela\fen tu POKéGEAR\npara oír la\fradio siempre\nque quieras.\f¿Quieres participar?\n",
  ["RadioTower1FRadioCardWomanQuestion1Text"] = "1a Pregunta: ¿Hay\fPOKéMON que sólo\naparecen por\vla mañana?",
  ["RadioTower1FRadioCardWomanQuestion2Text"] = "¡Correcto! 2a\nPregunta: ¿Es\fverdad que\nno puedes comprar\funa BAYA\nen una TIENDA?\v",
  ["RadioTower1FRadioCardWomanQuestion3Text"] = "¡Acertaste! 3a\nPregunta: ¿Contiene\fla MO01 el\nmovimiento\vDESTELLO?",
  ["RadioTower1FRadioCardWomanQuestion4Text"] = "¡Vas bien! 4a Pregunta:\n¿PEGASO, el LÍDER de GIMNASIO\fde CIUDAD MALVA usa\nPOKéMON pájaro?",
  ["RadioTower1FRadioCardWomanQuestion5Text"] = "¡Guau! ¡Correcto!\nÉsta es la última\vpregunta: ¿Sale\fCHARMANDER en\nlas máquinas\vdel CASINO\fde CIUDAD\nTRIGAL?",
  ["RadioTower1FRadioCardWomanTuneInText"] = "Sintoniza nuestros\nprogramas.",
  ["RadioTower1FRadioCardWomanWrongAnswerText"] = "Lo siento mucho,\npero te has equivocado.\f¡Vuelve a\nprobar!",
  ["RadioTower1FRadioCardWomanYouWinText"] = "¡Bingo! ¡Enhorabuena!\nÉste es tu premio:\f¡la TARJETA\nRADIO!",
  ["RadioTower1FReceptionistNoToursText"] = "Hola. Lo siento,\npero hoy no\vse admiten\vvisitas.",
  ["RadioTower1FReceptionistWelcomeText"] = "¡Bienvenidos!",
  ["RadioTower1FYoungsterText"] = "Me gusta ROSA,\nde la HORA POKéMON,\faunque sólo\nconozca\vsu voz.",
  ["RadioTower2FBlackBelt1Text"] = "¡Aviso! Prohibido\nentrar sin autorización.\vAntes no era\fasí. Debe de\nhaber algún\fproblema\ncon el DIRECTOR…\v",
  ["RadioTower2FBlackBelt2Text"] = "Puedes mirar\npor todas partes.\fEl DIRECTOR\nya no está\venfadado.",
  ["RadioTower2FBuenaAlreadyPlayedText"] = "BUENA: Lo siento…\fSólo tienes una oportunidad\npor día. ¡Vuelve\fmañana para otro\nintento!",
  ["RadioTower2FBuenaCallMeText"] = "BUENA: ¡Llámame\ncuando quieras!",
  ["RadioTower2FBuenaCardIsFullText"] = "BUENA: Tu TARJETA\nAZUL está llena.\f¡Consigue algún premio\nfabuloso!",
  ["RadioTower2FBuenaComeBackAfterListeningText"] = "BUENA: Vuelve tras\nescuchar mi show,\f¿vale? ¡Hasta\nluego!",
  ["RadioTower2FBuenaCorrectAnswerText"] = "BUENA: ¡YUUUUPI!\n¡Correcto! ¡Me habías\foído! ¡Estoy muy\nfeliz! ¡Ganaste\fun punto! ¡Felicidades!\n",
  ["RadioTower2FBuenaDidYouForgetText"] = "BUENA: Ooooh…\nIncorrecto… ¿Has\folvidado el\ncódigo?",
  ["RadioTower2FBuenaDoYouKnowPasswordText"] = "BUENA: ¡Hola! ¿Sintonizaste\nmi programa de\vradio? ¿Recuerdas\fel código\nde hoy?",
  ["RadioTower2FBuenaEveryoneSayPasswordText"] = "BUENA: ¿Todos\npreparados?\f¡Quiero oírte\ndecir el código\fde hoy, {PLAYER}!\n",
  ["RadioTower2FBuenaJoinTheShowText"] = "BUENA: ¡Oh, guau!\n¡Gracias! ¿Cómo\fdecías que te llamabas?\n… ¡{PLAYER},\fvale! Venga,\f{PLAYER}. Únete\nal show.",
  ["RadioTower2FBuenaNoBlueCardText"] = "BUENA: ¿Eh? ¿Olvidaste\ntraer tu TARJETA\vAZUL? No\vpuedo darte\fpuntos si\nno la tienes.\v",
  ["RadioTorre2FBuenaOfertaNúmeroOtra vezTexto"] = "BUENA: {PLAYER},\n¿quieres registrar\fmi número de\nteléfono?",
  ["RadioTorre2FBuenaOfertaTeléfonoNúmeroTexto"] = "BUENA: ¡Oh! ¡Tu TARJETA\nAZUL ha llegado\fhoy hasta los 30\npuntos! ¡Increíble!\fMmm… No hay ningún\npremio por llegar\va los 30 puntos,\fpero… Has venido\nmuy a menudo,\f{PLAYER}. ¡Te\nofreceré algo\fespecial! ¿Quieres\nmi número de\vteléfono?",
  ["RadioTower2FBuenaPasswordIsHelpText"] = "BUENA: ¿Eh? ¿El código\nde hoy? ¡AYUDA,\fpor supuesto!",
  ["RadioTower2FBuenaReceptionistNoCardText"] = "No puedes cambiar\npuntos sin tu TARJETA\vAZUL. ¡No olvides\ftu TARJETA\nAZUL!",
  ["RadioTower2FBuenaReceptionistPointsForPrizesText"] = "¡Puedes cambiar los\npuntos guarda- dos\fpor el premio de\ntu elección!",
  ["RadioTower2FBuenaSadRejectedText"] = "BUENA: Ooh… Es un\npremio especial…",
  ["RadioTower2FBuenaShowIntroductionText"] = "BUENA: ¡Hola! ¡Soy\nBUENA! ¿Conoces\fun programa de\nradio llamado\vCÓDIGO? Si puedes\fdecirme el código\ndel programa,\fganarás puntos.\n¡Acumula puntos\fy cámbiaselos\na esa dulce jovencita\fde ahí para\nrecibir regalos!\f¡Allá vamos!\n¡Es tu propia\ftarjeta\fde puntos!\n",
  ["RadioTower2FBuenaThanksForComingText"] = "BUENA: Hemos concursado\ncon {PLAYER}. ¡Gracias\fpor venir! ¡Espero\nque todos los\foyentes vengan\ntambién! ¡Estaré\fesperando!\n",
  ["RadioTower2FBuenaTuneInAfterSixText"] = "BUENA: ¡Sintoniza con\nCÓDIGO todos los días\fdesde las seis de la\ntarde hasta medianoche!\f¡Sintoniza y luego\nven a visitarnos!",
  ["RadioTower2FBuenaTuneInToMyShowText"] = "BUENA: ¡Sintoniza\nmi SHOW CÓDIGO!",
  ["RadioTower2FBuenaYourPhoneIsFullText"] = "BUENA: {PLAYER},\nno queda espacio\fen tu agenda para\nmi número…",
  ["RadioTower2FOaksPKMNTalkSignText"] = "La HORA POKéMON\ndel PROF. OAK. ¡El\fmejor programa\nde la radio!",
  ["RadioTower2FPokemonRadioSignText"] = "Radio POKéMON. A cualquier\nhora y en todas partes.",
  ["RadioTower2FRegisteredBuenasNumberText"] = "{PLAYER} registró el número\nde teléfono de BUENA.",
  ["RadioTower2FSalesSignText"] = "P1 VENTAS",
  ["RadioTower2FSuperNerdText"] = "Puedes oír la radio\ndonde sea. ¡Sintonízala!\v",
  ["RadioTower2FTeacherText"] = "Las nanas de la\nradio duermen a\vlos POKéMON.",
  ["RadioTower2FTeacherText_Rockets"] = "¿Por qué querrían\napoderarse de la\vTORRE RADIO?",
  ["RadioTower3FCardKeySlotText"] = "Es la ranura de la\nLLAVE MAGNÉTICA.",
  ["RadioTower3FCooltrainerFIsDirectorSafeText"] = "¿Está a salvo\nel DIRECTOR?",
  ["RadioTower3FCooltrainerFItsSunnyDayText"] = "¡Es DÍA SOLEADO! Mejora\nmovimientos del\vtipo fuego durante\vun tiempo.",
  ["RadioTower3FCooltrainerFPleaseSaveDirectorText"] = "El jefe del TEAM\nROCKET se ha\vencerrado. Pero\fel DIRECTOR puede\nabrirle. Está\fen el cuarto\npiso. ¡Sálvale!\f",
  ["RadioTower3FCooltrainerFYouWereMarvelousText"] = "¡Estuviste\ngenial!",
  ["RadioTower3FCooltrainerFYoureMyHeroText"] = "¡Gracias! ¡Eres\ngenial! Toma\festo como agradecimiento.\n",
  ["RadioTower3FGymGuideText"] = "Trabajamos 24 horas\nal día para\femitir\nprogramas geniales.\f¡Haré todo lo\vposible por\ntrabajar bien!",
  ["RadioTower3FGymGuideText_Rockets"] = "Para los entrenadores,\nlos POKéMON son\vsus compañeros.\fEs terrible que el\nTEAM ROCKET esté\fintentando controlar\na los POKéMON.",
  ["RadioTower3FPersonnelSignText"] = "P2 PERSONAL",
  ["RadioTower3FPokemonMusicSignText"] = "MÚSICA POKéMON con\nel DJ NARDO",
  ["RadioTower3FSuperNerdText"] = "Hemos grabado los\ngritos de todos\flos POKéMON descubiertos.\nDebemos de\ftener unos\n200 tipos.",
  ["RadioTower4FDJMaryText"] = "ROSA: ¿Por qué?\n¿Por qué debo\vsufrir? ¡MEOWTH,\fayúdame!",
  ["RadioTower4FDJMaryText_After"] = "ROSA: Sintoniza\nconmigo en la\fHORA POKéMON del\nPROF. OAK.",
  ["RadioTower4FDJMaryText_ClearedRockets"] = "ROSA: ¡Oh! ¡Eres\nmi salvación! ¿Aceptas\festo como agradecimiento?\n",
  ["RadioTower4FDJMaryText_GivePinkBow"] = "ROSA: Es para los\nPOKéMON que saben\fmovimientos de\ntipo normal.",
  ["RadioTower4FFisherText"] = "Mientras estaba\nen las RUINAS oía\vla radio. Y escuché\fun extraño\nprograma.",
  ["RadioTower4FProductionSignText"] = "P3 PRODUCCIÓN",
  ["RadioTower4FStudio2SignText"] = "P3 ESTUDIO 2",
  ["RadioTower5FDirectorDescribeClearBellText"] = "En el pasado, hubo\nuna torre en CIUDAD TRIGAL, aquí mismo.\vPero todavía estaba vivo y caí. así\nque lo sustituyamos por nuestra TORRE\nRADIO. Encontramos esta campana durante la construcción.\nEscuché que, en el pasado, todas las clases de POKéMON\nVivía en CIUDAD TRIGAL. Quizás…\nQuizás esta campana tenga alguna conexión con la TORRE HOJALATA\npor CIUDAD IRIS… ¡Ah! Eso me recuerda...\nEscuchó susurros sobre el TEAM ROCKET.\fAl parecer algo está pasando en la TORRE HOJALATA.\nno tengo idea de que\nsucederá, pero deberías encontrar uno\nvistazo.\fDE ACUERDO. ¿Será\nmejor que ir a\nmi TALLER.",
  ["RadioTower5FDirectorText"] = "DIRECTOR: ¡Hola,\n{PLAYER}! Ya sabes\fque adoro a los\nPOKéMON. Construí\festa TORRE RADIO\npara mostrar mi\famor por los POKéMON.\nMe encantaría\fque nuestros\nprogramas\vgustaran.",
  ["RadioTower5FDirectorThankYouText"] = "DIRECTOR: ¡{PLAYER},\nmuchas gracias!\fTus valerosas\nacciones han salvado\fa los POKéMON.\nSé que no es\fmucho, pero\ncoge esto,\vpor favor.",
  ["RadioTower5FDirectorsOfficeSignText"] = "P4 OFICINA\nDEL DIRECTOR",
  ["RadioTower5FRocketBossAfterText"] = "¿Qué ha pasado?\fNuestros sueños\nhechos añicos. Creo\fque no he estado\na la altura. Como\fya hiciera GIOVANNI,\nhoy yo desarticularé\fel TEAM\nROCKET.\f¡Adiós!",
  ["RadioTower5FRocketBossBeforeText"] = "¿Cómo lograste\nllega tan lento?\fdebes entrenar\nmuy bueno. Queremos lidiar con esto\nESTACIÓN DE RADIO para anunciar\nnuestro viaje.\vTendría que volver a GIOVANNI\nde tu formación.\fvamos a recuperarnos\nla gloria perdida.\fY no voy a\npermitirle interferir con nosotros\nplanes.",
  ["RadioTower5FRocketBossWinText"] = "¡No! ¡Perdóname,\nGIOVANNI!",
  ["RadioTower5FStudio1SignText"] = "P4 ESTUDIO 1",
  ["RadioTowerJigglypuffText"] = "JIGGLYPUFF:\nJiggly…",
  ["RadioTowerMeowthText"] = "MEOWTH: Meowth…",
  ["RageCandyBarMerchantNoRoomText"] = "No tienes espacio\npara esto.",
  ["RageCandyBarMerchantNotEnoughMoneyText"] = "No tienes bastante\ndinero.",
  ["RageCandyBarMerchantRefusedText"] = "¡Oh, de acuerdo…!",
  ["RageCandyBarMerchantSavorItText"] = "¡Bien! ¡Saboréalo!",
  ["RageCandyBarMerchantSoldOutText"] = "CARAMELOS FURIA\nagotados. Estoy\fhaciendo las maletas.\nNo me molestes,\vjoven.",
  ["RageCandyBarMerchantTryOneText"] = "¿Qué tal, joven?\nVeo que no eres\vde CIUDAD CAOBA.\v¡Por no ser de\faquí, deberías\nprobar el CARAMELO\fFURIA! ¡Puede\nser tuyo por\fsólo 300¥!\n¿Quieres\vuno?",
  ["ReceivedBoulderBadgeText"] = "{PLAYER} recibió\nla MEDALLA ROCA.",
  ["ReceivedCascadeBadgeText"] = "{PLAYER} recibió\nMEDALLA CASCADA.",
  ["ReceivedEeveeText"] = "¡{PLAYER} recibió\na EEVEE!",
  ["ReceivedMarshBadgeText"] = "{PLAYER} recibió\nMEDALLA PANTANO.",
  ["ReceivedSecretpotionText"] = "{PLAYER} recibió la\nPOCIÓN SECRETA.",
  ["ReceivedThunderBadgeText"] = "{PLAYER} recibió la\nMEDALLA TRUENO.",
  ["ReceivedVolcanoBadgeText"] = "{PLAYER} recibió\nla MED. VOLCÁN.",
  ["ReceivedZephyrBadgeText"] = "{PLAYER} recibió la\nMEDALLA CÉFIRO.",
  ["RecordedBillsNumberText"] = "{PLAYER} grabó el\nn.° de BILL.",
  ["RedsHouse1FTVText"] = "Tienen programas\nque no se emiten\ven JOHTO…",
  ["RedsHouse2FN64Text"] = "{PLAYER} jugó a\nla N64. Mejor irse.\fNo hay tiempo\nque perder.",
  ["RedsHouse2FPCText"] = "Parece que nadie\nlo ha usado en\vmucho tiempo…",
  ["RedsHouseSignText"] = "CASA DE ROJO",
  ["RedsMomText1"] = "¡Hola! ROJO lleva\ffuera mucho tiempo.\nTampoco ha llamado,\fasí que no sé\ndónde está, ni\flo que ha estado\nhaciendo. Dicen\vque si no hay\fnoticias es\nque todo va\fbien, pero estoy\npreocupada\vpor él.",
  ["RedsMomText2"] = "Me preocupa que ROJO\nesté herido o enfermo,\fpero ya es todo un\nhombre- cito. Estoy\forgullosa de que\nesté haciendo lo\fque quiere.",
  ["RhydonText"] = "RHYDON: ¡Rhydo,\nrhydo!",
  ["RivalCherrygroveLossText"] = "Humph. Eso fue\npérdida de tiempo.",
  ["RivalCherrygroveWinText"] = "Hunf. Feliz por\nter ganhado?",
  ["RivalText_Training1"] = "…\n¿Qué?  ¿{PLAYER}?\f…No, no lo haré\nbatalla ahora… Mi POKéMON\nno están listos no puedo\nobligarlos ahora.\fnecesito ser\ndisciplinado para convertirse\nel mejor entrenador",
  ["RivalText_Training2"] = "…\fUfa…\fAprenda a\nse afastar.",
  ["RockSmashGuyText1"] = "¡Cielos! Iba\fa quitar ese\nárbol con un\fgran derechazo.\nPero no pude.\f¡Soy un fracaso!\n",
  ["RockSmashGuyText2"] = "¿Quitaste ese\npobre árbol?\f¡Estoy impresio-\nnado! Toma\vesto.",
  ["RockSmashGuyText3"] = "Se trata del GOLPE\nROCA. Puedes destrozar\frocas con un\nsimple golpe\fbien dirigido.\nSi encuentras\funa roca en\ntu camino, ¡destrózala!\v",
  ["RockerBaseLanceElectrodeFaintText"] = "esa es la maquina\nque está causando todos los problemas.\fNadie vio un interruptor...\nNo hay opción.\fdebemos debilitarnos\na todos los ELECTRODOS.\feso se detendrá\nla máquina no transmite\npero esta extraña señal. Los\nPOKéMON no tiene culpa;\nMe siento responsable.\n {PLAYER}, separemos.",
  ["RocketBaseB2FDeactivateTransmitterText"] = "Por fin la emisora\nde radio ha dejado\fde transmitir\nesa maldita\vseñal.",
  ["RocketBaseB2FTransmitterText"] = "La emisora de radio\nestá emitiendo\funa siniestra señal.\nEstá funcionando\fa máxima capacidad.\n",
  ["RocketBaseBossDontMeddleText"] = "¿Qué? ¿Tenías un\ncómplice? ¿Dónde\festá tu sentido\ndel honor? Como\fsustituto provisional\nde GIOVANNI,\f¡ya te enseñaré\nyo a no meterte\fcon el TEAM\nROCKET!",
  ["RocketBaseBossFThrashText"] = "No podemos tener\na alguien como tú\vsuelto por ahí. Es\fperjudicial para\nel orgullo del TEAM\vROCKET. Da igual\flo fuerte que seas,\nno podrás con ambos\fal mismo tiempo.\nLo siento, pero\fprepárate para\nla aniquilación.\v",
  ["RocketBaseBossRetreatText"] = "Esta guarida se\nacabó… Pero no\fimporta. El experimento\nde emisión fue\vtodo un éxito.\vQué más da lo\fque pase ahora\ncon esta guarida.\vTenemos planes\fmás importantes.\nMuy pronto conocerás\fel verdadero\npoder del TEAM\fROCKET. Disfruta\nmientras\fpuedas…\n¡Fufufufu…!\f",
  ["RocketBaseBossWinText"] = "¡Uuau! Eres muy\nfuerte. ¡Qué lástima!\fSi te unieras\fal TEAM ROCKET,\npodrías llegar\fa ser del EJECUTIVO.\n",
  ["RocketBaseDoorKnowPasswordText"] = "La puerta está cerrada…\f{PLAYER} introdujo\nla contraseña. ¡Puerta\fabierta!",
  ["RocketBaseDoorNoPasswordText"] = "La puerta está cerrada…\fRequiere una\ncontraseña.",
  ["RocketBaseExecutiveFHoldItText"] = "¡Alto\nahí!",
  ["RocketBaseLanceElectrodeDoneText"] = "LANCE: Por fin\nse ha detenido\vesa extraña señal.\fEl LAGO vuelve\na la normalidad.\f¡Eres increíble!\nMuchas gracias\fen nombre de todos\nlos POKéMON.\f¡Ah, sí! Toma\nesto. Lo encontré\faquí, pero\nyo no lo necesito.\v",
  ["RocketBaseLanceMonMasterText"] = "{PLAYER}… El viaje\fpara ser MAESTRO\nPOKéMON es largo\fy difícil. Sabiéndolo,\n¿vas a continuar?\f… Ya veo. No,\ntienes razón.\fSi hubieras\fabandonado\ntan fácilmente,\fnunca hubieras\nseguido ese\fsueño en\nprimer lugar.\f¡Espero\nverte\fde nuevo!\n",
  ["RocketBaseLancePostBattleText"] = "LANCE: Funcionó.\nHemos derrotado\fa todos estos\fROCKET. Pero\nme preocupa\vese joven contra\fel que\nluché…",
  ["RocketBaseLancePowerOffText"] = "Lo siento, {PLAYER}.\nVi que lo estabas haciendo\ftan bien, que me quedé\nensimismado. Ahora\ftodo lo que queda\npor hacer es apagar\fesa extraña señal\nde radio.",
  ["RocketBaseLanceShareFunText"] = "¡Oye! No seas tan\negoísta. Comparte\vla diversión.",
  ["RocketBaseLanceWhirlpoolText"] = "Es TORBELLINO. Enséñasela\na un POKéMON y podrá\fcruzar torbellinos.\nPero recuerda\fque… sólo podrás\nusarla fuera\fde los combates\ncon la MEDALLA\fdel GIMNASIO\nCAOBA.",
  ["RocketBaseLancesSideText"] = "LANCE: Déjame\neste lado.",
  ["RocketBaseMurkrowText"] = "MURKROW: La contraseña\nes… VIVA GIOVANNI.\f",
  ["RocketBaseRivalText"] = "… ¿No te había\fdicho que iba a\ndestruir al TEAM\fROCKET? Dime, ¿quién\nera el chico de\fla capa que usaba\nlos POKéMON dragón?\fMis POKéMON no\npudieron con él.\fNo me importa\nperder. Podría\fganarle con otros\nPOKéMON. Lo que\fme molestó es\nlo que dijo…\fMe dijo que no\namo ni confío\flo bastante en\nmis POKéMON.\fMe enfurece\nhaber perdido\fcontra un memo\ncomo él. ¡Humph!\v¡No tengo\ftiempo para\ngente como\vtú!",
  ["RocketText_AllYouGot"] = "Entonces paga lo\nque tengas.",
  ["RocketText_MakingABundle"] = "¡Je, je! Nos estamos\nforrando. Todo\fel mundo quiere\nver lo que ocurre\fen el LAGO DE\nLA FURIA.",
  ["RocketText_ThankYou"] = "¡Gracias, joven!",
  ["RocketText_TollFee"] = "¡Alto ahí, joven!\nEl precio por\fpasar es\n1.000¥.",
  ["Route10Pokecenter1FCooltrainerFText"] = "Cuando salgas,\nverás el tejado\fde un edificio\nmuy grande. Eso\fes la CENTRAL\nENERGÍA.",
  ["Route10Pokecenter1FGentlemanText"] = "¿Un CENTRO\nPOKéMON junto\va una cueva?\f¡Qué bien!\n",
  ["Route10Pokecenter1FGymGuideText"] = "El DIRECTOR de la\nCENTRAL ENERGÍA quiere\fencontrar a un hombre\ncon buenos POKéMON.\fNecesita ayuda para\nrecuperar algo que\nle han robado.",
  ["Route10Pokecenter1FGymGuideText_ReturnedMachinePart"] = "He oído que el TEAM\nROCKET se reunió\fde nuevo en JOHTO,\npero se disolvió.\fNo sabía nada\nde eso.",
  ["Route10SignText"] = "RUTA 10 CIUDAD\fCELESTE - PUEBLO\nLAVANDA",
  ["Route11SignText"] = "RUTA 11",
  ["Route12SignText"] = "RUTA 12 PUEBLO\fLAVANDA HACIA\nEL NORTE",
  ["Route13DirectionsSignText"] = "HACIA EL NORTE AL\nPUEBLO LAVANDA HACIA\fEL OESTE A CIUDAD\nFUCSIA",
  ["Route13SignText"] = "RUTA 13 HACIA\fEL NORTE AL PUENTE\nSILENCIO",
  ["Route13TrainerTipsText"] = "PISTAS ENTRENADOR\f¡Mira! Allí,\na la izquierda\vdel poste",
  ["Route15FuchsiaGateOfficerText"] = "¿Estás trabajando\nen una POKéDEX? Es\fmuy importante.\n¡No te rindas!",
  ["Route15SignText"] = "RUTA 15 CIUDAD\fFUCSIA - PUEBLO\nLAVANDA",
  ["Route16FuchsiaSpeechHouseSuperNerdText"] = "Si bajas por\nel CAMINO de\fBICIS, llegarás\na CIUDAD\vFUCSIA.",
  ["Route16GateCannotPassText"] = "¡Eh! ¡Alto! No\fpuedes pasar por\nel CAMINO de BICIS\fsi no vas en\nBICICLETA.",
  ["Route16GateOfficerText"] = "Aquí empieza el\nCAMINO de BICIS.\fEs todo cuesta\nabajo. Es muy emocionante.\vEs una sensación\fque no se experimenta\nen barco\fo en tren.\n",
  ["Route17Route18GateCannotPassText"] = "¡Alto! ¿No tienes\nuna BICICLETA? Aquí\fempieza el CAMINO\nde BICIS. Necesitas\funa BICI para\nseguir.",
  ["Route17Route18GateOfficerText"] = "CAMINO de BICIS A partir de\naquí, es cuesta arriba.",
  ["Route18SignText"] = "RUTA 18 CIUDAD\fAZULONA - CIUDAD\nFUCSIA",
  ["Route19Fisher1Text"] = "Lo siento. La carretera\nestá cortada por\vobras. Si quieres\fllegar a ISLA\nCANELA, ve\fpor el Sur,\ndesde PUEBLO\vPALETA.",
  ["Route19Fisher1Text_RocksCleared"] = "Estoy sudando. ¡Voy\na bañarme!",
  ["Route19Fisher2Text"] = "A saber cuánto se\ntardaría en mover\vesta roca…",
  ["Route19Fisher2Text_RocksCleared"] = "Las obras de la\ncarretera ya han\vterminado. Ya\fpuedo volver\na pescar.",
  ["Route19FuchsiaGateOfficerText"] = "El volcán de ISLA CANELA\nha entrado en erupción.\fY ha lanzado rocas que\nhan cortado la RUTA\v19 hasta nuevo aviso.\fMe pregunto si la\ngente de ISLA CANELA\vestará bien…",
  ["Route19FuchsiaGateOfficerText_RocksCleared"] = "Nadie en ISLA CANELA\nresultó herido\fpor la erupción.\n¡Bien!",
  ["Route19SignText"] = "RUTA 19 CIUDAD\fFUCSIA - ISLAS\nESPUMA",
  ["Route1SignText"] = "RUTA 1 PUEBLO\fPALETA - CIUDAD\nVERDE",
  ["Route24RocketAfterBattleText"] = "Vale. Contar secreto\na ti. MAQUINARIA\fyo robar, escondida\nen GIMNASIO de\fCELESTE. En agua\nyo poner. Mirar\fen centro de\nagua de GIMNASIO.\f¡Pero tú no\nolvidar a mí!\fTEAM ROCKET\nseguro derrotar\fa ti. Míos\namigos venir\fde JOHTO,\nsí. Vengar\fellos\na mí.",
  ["Route24RocketBeatenText"] = "¡Ayyyy! ¡No, no,\nno! ¡Creer no\vpuedo! ¡Fuerte\fmucho eres!\n¡Rival para\vti no soy!",
  ["Route24RocketDisappearsText"] = "… ¿Dices que TEAM ROCKET\n¿adiós? ¿Roto?\f¿Qué dices?\n¡Oh, no! tengo que ir por dinero\nmi ahora?",
  ["Route24RocketSeenText"] = "¡Eh, tú! ¡Un miembro\ndel TEAM ROCKET\vser yo! Ser de\fotro país. Entrenador\nnúmero uno, ¡yo\vése! Pensar hice.\fSi cortar energía,\n¡mucho pánico\faquí todos! Misión\nsecreta es,\f¡no contar a\nti! Pero, si\vganar a mí,\fun hombre soy\ny secreto mío\fa ti contar.\n¡Eh, tú!\f¡Lucha empezar!\n",
  ["Route25MistyDateText"] = "MISTY: ¡Auuu! ¿Por\nqué has tenido\fque venir a molestarnos?\n¿Sabes cómo te\fllama la gente?\n¡Pelma! ¿Me oyes\vbien, pelma?\f… ¿Eh…? Esas\nMEDALLAS… ¿Son\fMEDALLAS de GIMNASIO\fde JOHTO? Si\ntienes ocho,\vno eres moco\fde pavo. Entonces,\nvale. Ven al\fGIMNASIO de\nCELESTE. Soy\fMISTY, la\nLÍDER de GIMNASIO\fde CIUDAD\nCELESTE.\v",
  ["Route26HealHouseKeepAtItText"] = "¡Vaya! ¡Tus POKéMON\ftienen buen\naspecto! ¡Sigue\fasí!",
  ["Route26HealHouseRestAWhileText"] = "Tus POKéMON parecen\ncansados. Deberías\fdejarlos descansar\nun poco.",
  ["Route26SignText"] = "RUTA 26 RECEPCIÓN\fDE LA LIGA\nPOKéMON",
  ["Route27FisherHeyText"] = "¡Eh!",
  ["Route27FisherText"] = "¿Sabes lo que\nacabas de hacer?\fAcabas de entrar\nen KANTO. Consulta\vel MAPA\fdel POKéGEAR.\n",
  ["Route28SignText"] = "RUTA 28",
  ["Route29CooltrainerMText_WaitingForDay"] = "estoy esperando\nPOKéMON que solo aparecen\nde día.",
  ["Route29CooltrainerMText_WaitingForMorning"] = "Estoy esperando\na los POKéMON que\faparecen sólo por\nla mañana.",
  ["Route29CooltrainerMText_WaitingForNight"] = "Estoy esperando\na los POKéMON que\faparecen sólo\npor la noche.",
  ["Route29FisherText"] = "Quería descansar\nun poco, así\fque guardé la\npartida.",
  ["Route29Route46GateOfficerText"] = "No puedes cruzar\nsetos. Pero puedes\fsaltar por encima\nde ellos para\vatajar.",
  ["Route29Route46GateYoungsterText"] = "Más adelante aparecen\nmuchos tipos de\vPOKéMON. Si quieres\fhacerte con todos,\ntendrás que buscar\fpor todas\npartes.",
  ["Route29Sign1Text"] = "RUTA 29 CIUDAD\fCEREZO -\vPUEBLO PRIMAVERA\v",
  ["Route29Sign2Text"] = "RUTA 29 CIUDAD\fCEREZO -\vPUEBLO PRIMAVERA\v",
  ["Route29TeacherText"] = "¿Ves esos setos?\nDa miedo saltarlos.\vPero puedes\fir a PUEBLO\nPRIMAVERA sin\fpasar por la\nhierba.",
  ["Route29YoungsterText"] = "¿Cómo están tus\nPOKéMON? Si están\fdébiles y no\npueden luchar,\fno entres en\nla hierba.",
  ["Route2DiglettsCaveSignText"] = "CUEVA DIGLETT",
  ["Route2GateScientistText"] = "¿Eres {PLAYER}? Soy\fel AYUDANTE del PROF.\nOAK. No tenía ni\fidea de dónde estabas.\nEl LABORATORIO\fdel PROF. OAK\nestá en PUEBLO\vPALETA.",
  ["Route2NuggetHouseFisherText"] = "¡Hola! Me alegro de\nverte. Eres la primera\fvisita que recibo\ndesde hace mucho\vtiempo. ¡Estoy muy\fcontento! Te voy\na hacer un pequeño\vregalo.",
  ["Route2NuggetHouseFisherText_GotNugget"] = "Es una PEPITA.\fNo puedo darte\npepitas de la\fsabiduría, ¡sólo\nesto!",
  ["Route2SignText"] = "RUTA 2 CIUDAD\fVERDE - CIUDAD\nPLATEADA",
  ["Route30BerrySpeechHouseCheckTreesText"] = "Busca BAYAS en los árboles.\nSon muy fáciles\vde encontrar.",
  ["Route30BerrySpeechHouseMonEatBerriesText"] = "Los POKéMON\ncomen BAYAS.\fMi POKéMON\nse curó comiendo\vuna BAYA.\f¡Te daré\nuna!",
  ["Route30CooltrainerFText"] = "No soy una entrenadora.\fPero si miras a uno\na los ojos, prepárate\vpara luchar.",
  ["Route30SignText"] = "RUTA 30 CIUDAD\fMALVA -\nCIUDAD\vCEREZO",
  ["Route30TrainerTipsText"] = "PISTAS ENTRENADOR\f¡No robes los POKéMON\nde otros! ¡Las\fPOKé BALL sólo\nse lanzan a POKéMON\vsalvajes!",
  ["Route30YoungsterText_DirectionsToMrPokemonsHouse"] = "¿La casa del SR. POKéMON?\nEstá un poco más\vadelante.",
  ["Route30YoungsterText_EveryoneIsBattling"] = "¡Todo el mundo se divierte\nluchando! ¡Tú también\vdeberías hacerlo!",
  ["Route31CooltrainerMText"] = "CUEVA OSCURA… Si\flos POKéMON pudieran\niluminarla, la\vexploraría.",
  ["Route31SignText"] = "RUTA 31 CIUDAD\fMALVA -\nCIUDAD\vCEREZO",
  ["Route31VioletGateCooltrainerFText"] = "Estoy demasiado\nlejos. ¡Mejor que\vllame a casa!",
  ["Route31VioletGateOfficerText"] = "¡Hola! ¿Has visitado\nla TORRE BELLSPROUT?\v",
  ["Route31YoungsterText"] = "He encontrado un\nbuen POKéMON en la\vCUEVA OSCURA. Voy\fa criarlo para enfrentarme\na PEGASO. Es\vel LÍDER del\fGIMNASIO de CIUDAD\nMALVA.",
  ["Route32CooltrainerMText_AideIsWaiting"] = "{PLAYER}, ¿verdad?\nUn tipo con\fgafas te buscaba.\nCompruébalo.\fTe está esperando\nen el CENTRO\fPOKéMON.\n",
  ["Route32CooltrainerMText_ExperiencesShouldBeUseful"] = "Tu experiencia en\nCIUDAD MALVA debería\fayudarte en\ntu viaje.",
  ["Route32CooltrainerMText_HaveThisSeed"] = "Tienes POKéMON muy\nbuenos. Seguro que\fes por haberlos\nentrenado en los\falrededores de CIUDAD\nMALVA. El entrenamiento\fen el GIMNASIO\nha debido de ser\fde gran ayuda.\nToma esto como\frecuerdo de CIUDAD\nMALVA. Aumenta\vel poder de\flos movimientos\nde tipo\vplanta.",
  ["Route32CooltrainerMText_UnusedSproutTower"] = "¿Has ido a la TORRE\nBELLSPROUT? Si pasas\fpor CIUDAD MALVA,\ndeberías entrenarte\fallí. Es crucial\npara los entrenadores.\f¡Ve a la\nTORRE BELLSPROUT!\v",
  ["Route32CooltrainerMText_VioletGym"] = "¿Has ido al GIMNASIO\nPOKéMON? Allí\fpuedes probar\na tus POKéMON\vy a ti mismo.\f¡Es un rito para\ntodos los entrenadores!\v",
  ["Route32CooltrainerMText_WhatsTheHurry"] = "¡Espera! ¿Por\nqué corres?",
  ["Route32Pokecenter1FCooltrainerFText"] = "¿Cómo equipar a\nmi POKéMON? Quizá\fcon un objeto\nque aumente\vsu ATAQUE…",
  ["Route32Pokecenter1FFishingGuruText_After"] = "Hola. ¿Están\npicando?",
  ["Route32Pokecenter1FFishingGuruText_GiveOldRod"] = "¡Pescar es genial!\fSi ves agua, ya\nsea el mar o\fun río, utiliza\ntu CAÑA.",
  ["Route32Pokecenter1FFishingGuruText_No"] = "¡Vaya! Me has\ndecepcionado…",
  ["Route32Pokecenter1FFishingGuruText_Question"] = "Éste es un buen sitio\npara pescar. ¿Has\fvisto a gente pescando?\n¿Y tú? ¿Quieres\funa de mis\nCAÑAS?",
  ["Route32Pokecenter1FFishingGuruText_Yes"] = "Está bien.\n¡Ahora puedes pescar!",
  ["Route32RuinsOfAlphGateOfficerText"] = "RUINAS ALFA Lugar\fturístico para observar\ny tocar. ¡Intenta\fmover los paneles\nde piedra!",
  ["Route32RuinsOfAlphGatePokefanMText"] = "¿Estás estudiando\nlas RUINAS? Podrías\fdedicarte a\nla ciencia.",
  ["Route32RuinsOfAlphGateYoungsterText"] = "Hay dibujos en los\npaneles de piedra.\fIntenté moverlos.\nMe pregunto\vqué serán.",
  ["Route32RuinsSignText"] = "RUINAS ALFA ENTRADA\nESTE",
  ["Route32SignText"] = "RUTA 32 CIUDAD\fMALVA - PUEBLO\nAZALEA",
  ["Route32UnionCaveSignText"] = "Hacia la CUEVA\nUNIÓN",
  ["Route32UnusedFisher1AfterText"] = "¿Cómo es posible que\nel tipo de al lado pesque\vbuenos POKéMON?",
  ["Route32UnusedFisher1BeatenText"] = "Ahora ya nada\nme sale bien…",
  ["Route32UnusedFisher1SeenText"] = "Siempre atrapo\nlos mismos POKéMON…\fQuizá con un combate\ncambien las\vcosas.",
  ["Route32UnusedFisher2AfterText"] = "Si quieres atrapar\nbuenos POKéMON, tienes\fque tener una\nbuena CAÑA.",
  ["Route32UnusedFisher2BeatenText"] = "¡Uf! Esta vez no\ntuve suerte.",
  ["Route32UnusedFisher2SeenText"] = "¡Oye! Hoy estoy de\nsuerte. ¿Quieres\vluchar, joven?",
  ["Route32UnusedText"] = "Los pescadores me\nhan insultado por\vmolestarles…",
  ["Route33LassText"] = "Uff, uff… Por\ffin he atrave-\nsado esa cueva.\fEra más grande\nde lo que esperaba.\fEstaba tan\ncansada de\vexplorarla,\fque he salido\nfuera.",
  ["Route33SignText"] = "RUTA 33",
  ["Route34IlexForestGateLassText"] = "¿Has visto el santuario\nen honor del\vguardián? Protege\fel BOSQUE desde\nantaño. Creo\vque debe de\fser un POKéMON\ndel tipo\vplanta.",
  ["Route34IlexForestGateTeacherText"] = "¿Estás completando\nuna POKéDEX? Sería\fduro si los POKéMON\nno aparecieran.\fPrueba esta\nMT.",
  ["Route34IlexForestSignText"] = "EL ENCINAR Por\nla Puerta",
  ["Route34SignText"] = "RUTA 34 CIUDAD\fTRIGAL - PUEBLO\vAZALEA EL\vENCINAR\fEntre medias\n",
  ["Route34TrainerTipsText"] = "PISTAS ENTRENADOR\fTodos los días crecen\nBAYAS en los árboles.\vToma nota de los\ftipos de BAYAS\nque tiene cada\várbol",
  ["Route35GoldenrodGateFisherText"] = "Me pregunto cuántos\ntipos de POKéMON\fhay en el mundo.\nHace tres años,\fel PROF. OAK\ndijo que había\f150 tipos distintos.\n",
  ["Route35GoldenrodGatePlayerReceivedAMonWithMailText"] = "{PLAYER} recibió POKéMON\ncon CARTA.",
  ["Route35GoldenrodGatePokefanFText"] = "Un extraño árbol\nbloquea el camino.\fSi le hablas, se\nmueve. Dicen que\fse volvió loco\ncuando alguien\flo mojó con una\nREGADERA.",
  ["Route35GoldenrodGatePokefanFText_FoughtSudowoodo"] = "Me gusta la Nana\nPOKéMON que ponen\ven la radio.",
  ["Route35GoldenrodGateRandyAskTakeThisMonToMyFriendText"] = "¡Perdona, joven!\n¿Puedes hacerme\vun favor? ¿Puedes\fdarle este POKéMON\ncon CARTA a mi\vamigo? Está en\fla RUTA 31.",
  ["Route35GoldenrodGateRandyCantCarryAnotherMonText"] = "No puedes llevar\notro POKéMON…",
  ["Route35GoldenrodGateRandyMyPalWasSnoozingRightText"] = "¿A que mi amigo\nestaba durmiendo?\vTe lo dije.",
  ["Route35GoldenrodGateRandyOhNeverMindThenText"] = "¡Oh…! Entonces,\nno importa…",
  ["Route35GoldenrodGateRandySomethingForYourTroubleText"] = "¡Gracias, joven! ¡Muchas\ngracias por habérselo\vllevado! ¡Toma\festo por las\nmolestias!",
  ["Route35GoldenrodGateRandyThanksText"] = "¿Vas? ¡Perfecto!\n¡Gracias, joven!\fMi amigo es\nun tipo gordito\vque solo duerme.\f¡Lo reconocerás\nfácilmente!",
  ["Route35GoldenrodGateRandyWeirdTreeBlockingRoadText"] = "Puedes leerla,\n¡pero no la pierdas!\v¡RUTA 31! Ah,\fsí. Un extraño\nárbol bloqueaba\vel camino. ¿Lo\fhabrán retirado\nya?",
  ["Route35NationalParkGateOfficer1AskToParticipateText"] = "Hoy es @ . Eso significa\nHoy es el Concurso de Captura de Animales.\nLas reglas son simples. uso\nuno de tus POKéMON y captura uno\nAnimal POKéMON para ganar. tu\n¿Quieres probarlo?",
  ["Route35NationalParkGateOfficer1AskToUseFirstMonText"] = "¡Oh, oh…! Tienes\fmás de un POKéMON.\nTendrás que\fusar a @ ,\nel primer\fPOKéMON de\ntu equipo.\f¿Te parece\nbien?",
  ["Route35NationalParkGateOfficer1ChooseMonAndComeBackText"] = "Elige el POKEMON\n¿Qué usarás en el Concurso y Luego?\nviene el gusano.",
  ["Route35NationalParkGateOfficer1ContestIsOverText"] = "El Concurso ha terminado.\nEsperamos verte aquí de nuevo.\nlisto.",
  ["Route35NationalParkGateOfficer1EggAsFirstMonText"] = "¡Oh, oh…! Tienes\nun HUEVO como primer\fPOKéMON de tu equipo.\nSustitúyelo por\fel POKéMON que\nquieras usar\fy luego ven\na verme.",
  ["Route35NationalParkGateOfficer1ExplainsRulesText"] = "Aquel que consiga\nel POKéMON bicho\vmás fuerte será\vel ganador. Tienes\f20 minutos. Si\nte quedas sin PARQUE\fBALL, ya no puedes\nseguir. Puedes\vquedarte el último\fPOKéMON que\ncaptures. ¡Sal\vy captura el\fPOKéMON bicho\nmás fuerte\fque encuentres!\n",
  ["Route35NationalParkGateOfficer1FirstMonCantBattleText"] = "¡Oh, oh…! El primer\fPOKéMON de tu equipo\nno puede luchar.\fSustitúyelo por el\nPOKéMON que quieras\fusar y luego\nven a verme.",
  ["Route35NationalParkGateOfficer1GiveParkBallsText"] = "Aquí tienes las\nPARQUE BALL para\vel Concurso.",
  ["Route35NationalParkGateOfficer1MakeRoomText"] = "¡Ay, ay…! tu equipas\ny tu PC CAJA está llena.\nNo tienes donde guardarlo\nAnimales Pokémon.\vHay un lugar en su equipo o en\nLa PC CAJA y luego ven\nel gusano.",
  ["Route35NationalParkGateOfficer1OkGoFinishText"] = "Vale. Vuelve\nfuera y termina\vel juego.",
  ["Route35NationalParkGateOfficer1TakePartInFutureText"] = "Muy bien. Esperamos\nverte pronto\vpor aquí.",
  ["Route35NationalParkGateOfficer1WaitAtNorthGateText"] = "Bien. Espera en la\nPuerta Norte a que\fse anuncie a los\nganadores.",
  ["Route35NationalParkGateOfficer1WantToFinishText"] = "Aún te quedan\n@  minuto(s).\v¿Quieres\fterminar\nahora?",
  ["Route35NationalParkGateOfficer1WeHoldContestsText"] = "En el PARQUE se suelen\ncelebrar muchos\fConcursos. Deberías\nprobar.",
  ["Route35NationalParkGateOfficer1WellHoldYourMonText"] = "Bien, guardaremos los\notros POKéMON mientras\vcompites.",
  ["Route35NationalParkGatePlayerReceivedParkBallsText"] = "{PLAYER} recibió\n20 PARQUE BALL.",
  ["Route35NationalParkGatePlayersMonLeftWithHelperText"] = "Los POKéMON de {PLAYER}\nse quedan con\vel AYUDANTE.",
  ["Route35NationalParkGateYoungsterText"] = "¿Cuándo será el próximo?\n¿Competencia de captura de animales?",
  ["Route35SignText"] = "RUTA 35",
  ["Route36LassText"] = "un árbol extraño\nbloquea la vía a CIUDAD TRIGAL.\fno me dejes ir\nde compras. Alguien debería hacer algo al respecto.",
  ["Route36LassText_ClearedSudowoodo"] = "Ese árbol extraño\ndesapareció sin\vdejar rastro. ¡Oh!\f¿Ese árbol era\nun POKéMON?",
  ["Route36NationalParkGateOfficer1AskToParticipateText"] = "Hoy es @ . Eso significa\nHoy es el Concurso de Captura de Animales.\nLas reglas son simples. uso\nuno de tus POKéMON y captura uno\nAnimal POKéMON para ganar. tu\n¿Quieres probarlo?",
  ["Route36NationalParkGateOfficer1AskToUseFirstMonText"] = "¡Oh, oh…! Tienes\fmás de un POKéMON.\nTendrás que\fusar @ , el\nprimer POKéMON\fde tu equipo.\n¿Te parece\fbien?\n",
  ["Route36NationalParkGateOfficer1ChooseMonAndComeBackText"] = "Elige el POKEMON\n¿Qué usarás en el Concurso y Luego?\nviene el gusano.",
  ["Route36NationalParkGateOfficer1ContestIsOverText"] = "El Concurso ha terminado.\nEsperamos verte aquí de nuevo.\nmuy listo.",
  ["Route36NationalParkGateOfficer1EggAsFirstMonText"] = "¡Oh, oh…! Tienes\nun HUEVO como primer\fPOKéMON de tu equipo.\nSustitúyelo por\fel POKéMON que\nquieras usar\fy luego ven\na verme.",
  ["Route36NationalParkGateOfficer1ExplainsRulesText"] = "Aquel que consiga\nel POKéMON bicho\vmás fuerte será\vel ganador. Tienes\f20 minutos. Si\nte quedas sin\fPARQUE BALL, no\ntendrás opción.\vPuedes quedarte\fel último POKéMON\nque captures.\v¡Sal y captura\fel POKéMON\nbicho más fuerte\fque encuentres!\n",
  ["Route36NationalParkGateOfficer1FirstMonCantBattleText"] = "¡Oh, oh…! El primer\fPOKéMON de tu equipo\nno puede luchar.\fSustitúyelo por el\nPOKéMON que quieras\fusar y luego\nven a verme.",
  ["Route36NationalParkGateOfficer1GiveParkBallsText"] = "Aquí tienes las\nPARQUE BALL para\vel Concurso.",
  ["Route36NationalParkGateOfficer1HeresThePrizeText"] = "¿{PLAYER}? Aquí\ftienes el premio\nque te guardábamos.\v",
  ["Route36NationalParkGateOfficer1MakeRoomText"] = "¡Ay, ay…! tu equipas\ny tu PC CAJA está llena.\nNo tienes donde guardarlo\nAnimales Pokémon.\vHay un lugar en su equipo o en\nLa PC CAJA y luego ven\nel gusano.",
  ["Route36NationalParkGateOfficer1OkGoFinishText"] = "Bien. Por favor,\nvuelve fuera\vy termina.",
  ["Route36NationalParkGateOfficer1SomeMonOnlySeenInParkText"] = "Algunos POKéMON\nsólo aparecen\ven el PARQUE.",
  ["Route36NationalParkGateOfficer1TakePartInFutureText"] = "Bien. Esperamos\nvolver a verte por\vaquí pronto.",
  ["Route36NationalParkGateOfficer1WaitHereForAnnouncementText"] = "Bien. Por favor,\nespera aquí a que\fse anuncien los\nganadores.",
  ["Route36NationalParkGateOfficer1WantToFinishText"] = "Aún te quedan\n@ minutos.\v¿Quieres\fterminar\nahora?",
  ["Route36NationalParkGateOfficer1WellHoldPrizeText"] = "¡Vaya…! Tu MOCHILA\nestá llena. Guardaremos\ftu premio, pero\nsólo hoy. Haz\vsitio en ella\fy ven a\nverme.",
  ["Route36NationalParkGateOfficer1WellHoldYourMonText"] = "Bien, guardaremos los\notros POKéMON mientras\vcompites.",
  ["Route36NationalParkGatePlayerReceivedParkBallsText"] = "{PLAYER} recibió\n20 PARQUE BALL.",
  ["Route36NationalParkGatePlayersMonLeftWithHelperText"] = "Los POKéMON de {PLAYER}\nse quedan con\vel AYUDANTE.",
  ["Route36RuinsOfAlphGateGrampsText"] = "¿Has visto este extracto?\nárbol en el camino?\vEsto explica por qué vienen menos.\npersonas que visitan las RUINAS\nALFA.",
  ["Route36RuinsOfAlphGateOfficerText"] = "¿No te imaginas\nquién podría hacer\valgo así? ¿Y\vpor qué?",
  ["Route36SignText"] = "RUTA 36",
  ["Route36TrainerTips1Text"] = "PISTAS ENTRETENIMIENTO Las habilidades de los POKéMON\nvariable incluida dentro de la misma especie.\fAl principio, tus habilidades\npueden parecerse.\fSin embargo, ellos\nLas diferencias surgen a medida que él\nPokémon crece",
  ["Route36TrainerTips2Text"] = "PISTAS ENTRENADOR\fUsa EXCAVAR\npara volver\va la entrada.\fEs útil para\nexplorar cuevas\fy otros\nlugares",
  ["Route37SignText"] = "RUTA 37",
  ["Route38EcruteakGateOfficerText"] = "¿De dónde has dicho\nque eras? ¿De\fPUEBLO PRIMAVERA?\vEl PROF. ELM\fvive por allí,\n¿no? Has recorrido\fun largo\ncamino.",
  ["Route38SignText"] = "RUTA 38 CIUDAD\fOLIVO - CIUDAD\nIRIS",
  ["Route38TrainerTipsText"] = "PISTAS ENTRENADOR\fSi un POKéMON va\na evolucionar, puedes\vpararlo. Pulsa\fel Botón B mientras\nintenta evolucionar.\vEsto asusta\fal POKéMON y\ndetiene su\vevolución",
  ["Route39BarnAskGiveBerryText"] = "¿Dar una BAYA\na MUU-MUU?",
  ["Route39BarnGaveBerryText"] = "{PLAYER} dio una\nBAYA a MUU-MUU.",
  ["Route39BarnItsCryIsWeakText"] = "Está débil…",
  ["Route39BarnLittleHealthierText"] = "¡MUU-MUU está un\npoco mejor!",
  ["Route39BarnNoBerriesText"] = "{PLAYER} no tiene\nBAYAS…",
  ["Route39BarnQuiteHealthyText"] = "¡MUU-MUU está\nmucho mejor!",
  ["Route39BarnRefusedBerryText"] = "{PLAYER} no le da\nuna BAYA. MUU-MUU\fparece triste.",
  ["Route39BarnTotallyHealthyText"] = "¡MUU-MUU se ha\nrecuperado!",
  ["Route39BarnTwinMoomooIsSickText"] = "MUU-MUU está enferma…\fNecesita muchas\nBAYAS.",
  ["Route39BarnTwinWereFeedingMoomooText"] = "¡Estamos dando de\ncomer a MUU-MUU!",
  ["Route39SignText"] = "RUTA 39 CIUDAD\fOLIVO - CIUDAD\nIRIS",
  ["Route39TrainerTipsText"] = "PISTAS ENTRENADOR\fUsa GOLPE CABEZA\nen los árboles\vpara que salgan\fPOKéMON. De\nlos árboles\vpueden caer\fvarios tipos\nde POKéMON",
  ["Route3MtMoonSquareSignText"] = "PLAZA MT. MOON\fSube las escaleras\n",
  ["Route40BattleTowerGateRockerText"] = "¿Vas a la TORRE\nBATALLA? Es un\fsecreto, pero si\nganas muchas veces\fpodrás conseguir\nregalos especiales.\v",
  ["Route40BattleTowerGateTwinText"] = "Los niveles de los\nPOKéMON que quiero\fusar son todos\ndiferentes. ¡Tengo\fque entrenarlos\nahora!",
  ["Route40BattleTowerGateUnusedText1"] = "¿También has venido\na ver la TORRE\vBATALLA?\fPero creo que aún\nno puedes entrar.",
  ["Route40BattleTowerGateUnusedText2"] = "La TORRE BATALLA\nha abierto.\fQuiero ir, pero\naún no he pensado\fen una buena frase\npara cuando\vgané.",
  ["Route40BattleTowerGateUnusedText3"] = "Voy a entrenar a mis\nPOKéMON para estar\fpreparado para\nla TORRE BATALLA.",
  ["Route40Lass1Text"] = "Aunque no se ve desde\naquí, CIUDAD ORQUÍDEA\festá al otro lado\ndel mar.",
  ["Route40Lass2Text"] = "Vine en barco a\nC. OLIVO por las\fvistas y el aire\nque se respira.\fComo es un puerto,\nparece diferente\vde la gran\vciudad.",
  ["Route40PokefanMText"] = "¡Mira! ¡Hay un\ngran edificio ahí!\f¿Qué será?",
  ["Route40PokefanMText_Mobile"] = "¡Mmmmm! Mira cómo\nentran todos esos\ventrenadores tan\vpreparados.\f¿Qué? ¿Qué?",
  ["Route40SignText"] = "RUTA 40 CIUDAD\fORQUÍDEA - CIUDAD\nOLIVO",
  ["Route40StandingYoungsterText"] = "¿Has estado en la\nTORRE BATALLA? Creo\fque en ella se han\nreunido mu- chos\fentrenadores muy\nfuertes. Aunque,\fteniendo tantas\nMEDALLAS, no debería\fresul- tarte\ndifícil.",
  ["Route42EcruteakGateOfficerText"] = "MONTE MORTERO es\ncomo un laberinto.\fTen cuidado. No\nte pierdas.",
  ["Route42Sign1Text"] = "RUTA 42 CIUDAD\fIRIS - PUEBLO\nCAOBA",
  ["Route42Sign2Text"] = "RUTA 42 CIUDAD\fIRIS - PUEBLO\nCAOBA",
  ["Route43MahoganyGateOfficerRocketsClearedText"] = "Ahora nadie\nva al LAGO DE\vLA FURIA.",
  ["Route43MahoganyGateOfficerText"] = "Últimamente sólo\npasaban por aquí\flos que iban al LAGO\nDE LA FURIA.",
  ["Route43Sign1Text"] = "RUTA 43 LAGO DE\fLA FURIA - PUEBLO\nCAOBA",
  ["Route43Sign2Text"] = "RUTA 43 LAGO DE\fLA FURIA - PUEBLO\nCAOBA",
  ["Route43TrainerTipsText"] = "PISTAS ENTRENADOR\fTodos los POKéMON\ntienen ventajas y\fdesventajas según\nel tipo. Entre dos\fPOKéMON de distinto\ntipo, puede perder\fel de nivel superior.\nAprende qué tipos\fson fuertes\no débiles contra\ftu tipo de\nPOKéMON",
  ["Route44Sign1Text"] = "RUTA 44 HACIA\nRUTA HELADA",
  ["Route44Sign2Text"] = "RUTA 44 PUEBLO\fCAOBA -\vCIUDAD ENDRINO\n",
  ["Route45DummyText"] = "¡Soy muy, muy fuerte!\n¿Hay algún lugar\fen el que pueda\nprobar mi\vfuerza?",
  ["Route45SignText"] = "RUTA 45 CAMINO\nMONTAÑA",
  ["Route46SignText"] = "RUTA 46 CAMINO\nMONTAÑA",
  ["Route5CleanseTagHouseGrannyText1"] = "¡Aaaayy! Siento\fque una siniestra\nsombra se cierne\vsobre ti. ¡Toma\festo para protegerte!\n",
  ["Route5CleanseTagHouseGrannyText2"] = "Corrías un peligro\nmortal, pero ahora\vestás a salvo.",
  ["Route5CleanseTagHouseTeacherText"] = "A mi abuela le gusta\nprotegerse contra\fsupuestos malos\nespíritus. Perdona\fsi te ha asustado.\n",
  ["Route5PokefanMText"] = "La carretera está\ncortada hasta que\farreglen la CENTRAL\nENERGÍA.",
  ["Route5SaffronGateOfficerText"] = "Eres de JOHTO,\n¿verdad? ¿Qué\fopinas de KANTO?\nEs bonito,\v¿no crees?",
  ["Route5UndergroundPathEntranceTeacherText"] = "Muchas ciudades de\nJOHTO están llenas\fde historia. ¡Cómo\nme gustaría ir!",
  ["Route5UndergroundPathSignText"] = "VÍA SUBTERRÁNEA\fCIUDAD CELESTE\v- CIUDAD\vCARMÍN\v",
  ["Route6PokefanMText"] = "La carretera está\ncortada hasta que\farreglen la CEN-\nTRAL ENERGÍA.",
  ["Route6SaffronGuardMagnetTrainText"] = "El MAGNETOTRÉN\nes lo más famoso\fde CIUDAD\nAZAFRÁN.",
  ["Route6SaffronGuardWelcomeText"] = "Bienvenido a\n¡CIUDAD AZAFRÁN, hogar del MAGNETOTRÉN!\vEso es lo que tengo que decidir,\npero el MAGNETOTRÉN no funciona\nahora. No recibir electricidad\nporque hay un problema\nen ENERGÍA CENTRAL.",
  ["Route6UndergroundPathSignText"] = "VÍA SUBTERRÁNEA\fCIUDAD CELESTE\v- CIUDAD\vCARMÍN\v",
  ["Route7LockedDoorText"] = "Está cerrada…",
  ["Route7SaffronGuardPowerPlantText"] = "¿Has oído lo del\naccidente de la\vCENTRAL ENERGÍA?\fSe encuentra al\nEste, cerca de PUEBLO\vLAVANDA.",
  ["Route7SaffronGuardSeriousText"] = "Me tomo muy en\nserio mi trabajo\fde GUARDA. ¡Eh!\nTienes una POKéDEX.\fVale. Puedes\npasar.",
  ["Route7UndergroundPathSignText"] = "¿Y este cartel?\fAlgunos entrenadores\nhan estado luchando\fen VÍA SUBTERRÁNEA.\nTras numerosas\fquejas de los\nvecinos, la VÍA\vSUBTERRÁNEA ha\vsido cerrada\vindefinidamente.\vPOLICÍA C.\fAZULONA",
  ["Route8LockedDoorText"] = "Está cerrada…",
  ["Route8SaffronGateOfficerText"] = "¿Has estado en\nPUEBLO LAVANDA?\vHay una TORRE\fRADIO muy\nalta.",
  ["Route8UndergroundPathSignText"] = "El cartel está\froto. Es imposible\nleerlo…",
  ["Route9SignText"] = "RUTA 9 CIUDAD\fCELESTE - TÚNEL\nROCA",
  ["RuinsOfAlphAerodactylChamberAncientReplicaText"] = "Es una réplica\nde un POKéMON\vantiguo.",
  ["RuinsOfAlphAerodactylChamberDescriptionText"] = "Este POKéMON volador\nataca a su presa\fcon sus fuertes\ncolmillos.",
  ["RuinsOfAlphAerodactylChamberUnownText"] = "¡Es texto UNOWN!",
  ["RuinsOfAlphAerodactylChamberWallHoleText"] = "¡Hay un gran agu-\njero en la pared!",
  ["RuinsOfAlphAerodactylChamberWallPatternLeftText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphAerodactylChamberWallPatternRightText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphAerodactylItemRoomAncientReplicaText"] = "Es una réplica\nde un antiguo\vPOKéMON.",
  ["RuinsOfAlphHoOhChamberAncientReplicaText"] = "Es una réplica\nde un antiguo\vPOKéMON.",
  ["RuinsOfAlphHoOhChamberDescriptionText"] = "Un POKéMON que mo-\nvía con gracia sus\falas de los colo- res\ndel arco iris.",
  ["RuinsOfAlphHoOhChamberUnownText"] = "¡Es texto UNOWN!",
  ["RuinsOfAlphHoOhChamberWallHoleText"] = "¡Hay un gran agu-\njero en la pared!",
  ["RuinsOfAlphHoOhChamberWallPatternLeftText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphHoOhChamberWallPatternRightText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphHoOhItemRoomAncientReplicaText"] = "Es una réplica\nde un antiguo\vPOKéMON.",
  ["RuinsOfAlphInnerChamberFisherText"] = "Esta habitación es\nmuy grande, pero aquí\vno hay nada.",
  ["RuinsOfAlphInnerChamberGrampsText"] = "Los edificios antiguos\nsuelen ser tumbas\vde reyes. Como,\fpor ejemplo, las\npirámides.",
  ["RuinsOfAlphInnerChamberStatueText"] = "Es una réplica\nde un antiguo\vPOKéMON.",
  ["RuinsOfAlphInnerChamberTeacherText"] = "Este lugar está\nimpregnado de\vmisticismo.\fParece incluso\netéreo.",
  ["RuinsOfAlphKabutoChamberAncientReplicaText"] = "Es una réplica\nde un POKéMON\vantiguo.",
  ["RuinsOfAlphKabutoChamberDescriptionText"] = "Un POKéMON que se\noculta en el mar.\fCon sus ojos explora\nla zona.",
  ["RuinsOfAlphKabutoChamberReceptionistText"] = "Bienvenidos a esta cámara.\nHay paneles móvi- les\fque muestran a un POKéMON\ndibujado por los antepasados.\fMueve los paneles para\nformar el dibujo.\fA la derecha hay una\ndescripción del POKéMON.\vEl científico del\ffondo está examinando\nunos dibujos\vnuevos.",
  ["RuinsOfAlphKabutoChamberScientistCrypticText"] = "Recientemente,\nunos misteriosos\vdibujos han\vaparecido. Es\fraro. Hace un\nrato no estaban\vaquí… Debes\fechar un ojo\na las paredes.\v",
  ["RuinsOfAlphKabutoChamberScientistHoleText"] = "¡Ah! ¡Hay otro\ngran agujero!\f¡Es tan grande\nque se puede pasar\vpor él!",
  ["RuinsOfAlphKabutoChamberScientistTremorText"] = "¡Ese temblor me\nasustó mucho! Pero\fme preocupa mucho\nmás este muro\vde aquí…",
  ["RuinsOfAlphKabutoChamberUnownText"] = "¡Es texto UNOWN!",
  ["RuinsOfAlphKabutoChamberUnusedText"] = "¡Los dibujos de la\npared parecen ser\vpalabras! Y estos\fpaneles móviles\nde piedra parecen\fser algún tipo\nde señal. Creo\fque hacen aparecer\na los POKéMON,\fpero aún no\nestá claro…",
  ["RuinsOfAlphKabutoChamberWallHoleText"] = "¡Hay un gran agu-\njero en la pared!",
  ["RuinsOfAlphKabutoChamberWallPatternLeftText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphKabutoChamberWallPatternRightText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphKabutoItemRoomAncientReplicaText"] = "Es una réplica\nde un antiguo\vPOKéMON.",
  ["RuinsOfAlphNorthSignText"] = "RUINAS ALFA ENTRADA\nNORTE",
  ["RuinsOfAlphOmanyteChamberAncientReplicaText"] = "Es una réplica\nde un POKéMON\vantiguo.",
  ["RuinsOfAlphOmanyteChamberDescriptionText"] = "Este POKéMON se\ndesplazaba por el\fmar con sus diez\ntentáculos.",
  ["RuinsOfAlphOmanyteChamberUnownText"] = "¡Es texto UNOWN!",
  ["RuinsOfAlphOmanyteChamberWallHoleText"] = "¡Hay un gran agu-\njero en la pared!",
  ["RuinsOfAlphOmanyteChamberWallPatternLeftText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphOmanyteChamberWallPatternRightText"] = "Aparecieron\ndibujos en las\vparedes…",
  ["RuinsOfAlphOmanyteItemRoomAncientReplicaText"] = "Es una réplica\nde un antiguo\vPOKéMON.",
  ["RuinsOfAlphOutsideFisherText1"] = "Mientras explorá-\nbamos las RUINAS,\fde repente notamos\nuna extraña presencia.\vNos asustamos\fy huimos. Tu\ntambién debes\ftener cuidado.\n",
  ["RuinsOfAlphOutsideFisherText2"] = "¡Las RUINAS\nesconden un\vgran secreto!\fCreo…",
  ["RuinsOfAlphOutsideMysteryChamberSignText"] = "SALA DEL PANEL DE\nPIEDRA MISTERIOSO",
  ["RuinsOfAlphOutsideScientistText"] = "¿Eh? Es una POKéDEX,\n¿verdad? ¿Puedo\vverla? Hay muchos\ftipos de POKéMON.\n¿Y esto qué es?\f¿Cuál es este\fPOKéMON? Se parece\na las raras escrituras\fde las paredes\nde las RUINAS.\fSi esos dibujos\nson POKéMON,\fdebería haber\nmuchos más.\v¡Ya sé! Voy\va actualizar\ftu POKéDEX.\nSígueme.\v",
  ["RuinsOfAlphOutsideYoungster1Text"] = "Hay muchas clases\nde UNOWN, así que\flos utilizamos\ncomo nuestro código\vsecreto.",
  ["RuinsOfAlphOutsideYoungster2Text"] = "A… D… E… L… A…\nN… T… E… Mmmmmm…\f¿Qué? ¡Estoy\fdecodifi-\ncando el\vmensaje!",
  ["RuinsOfAlphResearchCenterAcademicBooksText"] = "Hay muchos libros\nacadémicos. Ruinas\fAntiguas… Los\nMisterios de los\vAntiguos…",
  ["RuinsOfAlphResearchCenterComputerText"] = "RUINAS ALFA\f10 Años de Exploración\n",
  ["RuinsOfAlphResearchCenterComputerText_GotAllUnown"] = "Nombre de POKéMON\nmisterioso: UNOWN\fEncontrados un total\nde 26 tipos.",
  ["RuinsOfAlphResearchCenterDexUpgradedText"] = "Mejorada POKéDEX\nde {PLAYER}.\v",
  ["RuinsOfAlphResearchCenterModifiedDexText"] = "¡Ya está! He modificado\ftu POKéDEX. Añadí\nuna POKéDEX opcional\fpara guardar\nlos datos de\fUNOWN. Los\nregistra en\fel orden en\nque son atrapados.\v",
  ["RuinsOfAlphResearchCenterPrinterText_DoesntWork"] = "Parece que esto aún\nno funciona.",
  ["RuinsOfAlphResearchCenterProfSilktreePhotoText"] = "Es una foto del fundador\ndel CENTRO de INVES-\fTIGACIÓN, el PROF.\nSILKTREE.",
  ["RuinsOfAlphResearchCenterScientist1Text"] = "Las RUINAS datan\nde hace unos 1.500\faños. Pero ignoramos\npor qué o por\fquién fueron\nconstruidas.",
  ["RuinsOfAlphResearchCenterScientist1Text_GotAllUnown"] = "Nuestra investiga-\nción, con tu ayuda,\fnos está reportando\ninfor- mación acerca\vde las RUINAS. Las\fRUINAS parecen haber\nsido cons- truidas\fcomo un hábitat\npara POKéMON.",
  ["RuinsOfAlphResearchCenterScientist1Text_GotUnownDex"] = "¿Cuántos tipos de\nPOKéMON habrá en\vlas RUINAS?",
  ["RuinsOfAlphResearchCenterScientist1Text_UnownAppeared"] = "¿Hay POKéMON en\nlas RUINAS? ¡Qué\fnoticia tan increíble!\nTendremos\fque investigarlo.\n",
  ["RuinsOfAlphResearchCenterScientist2Text"] = "En las paredes\nde las RUINAS\fhay unos dibujos\nmuy raros. Son\fla clave para\nresolver el\vmisterio de\vlas RUINAS.",
  ["RuinsOfAlphResearchCenterScientist2Text_GotAllUnown"] = "¿Por qué estos antiguos\ndibujos aparecen\fahora en el muro?\nEsto es cada\fvez más misterioso…\n",
  ["RuinsOfAlphResearchCenterScientist2Text_UnownAppeared"] = "¿Los POKéMON raros\nque viste en las\vRUINAS? Son muy\fparecidos a los\ndibujos de esas\fparedes de ahí.\n¡Mmm…! Debe\fde significar\fque hay muchos\ntipos diferentes…\v",
  ["RuinsOfAlphResearchCenterScientist3Text"] = "Todos los UNOWN que\natrapes serán registrados\vaquí. A ver\fcuántos tipos\nexisten.",
  ["RuinsOfAlphResearchCenterSignText"] = "C. INVESTIGACIÓN\nDE LAS RUINAS ALFA\fLa Autoridad en\nlas RUINAS ALFA",
  ["RuinsOfAlphResearchCenterUnownPrinterText"] = "Se puede imprimir\nUNOWN.",
  ["RuinsOfAlphResearchCenterUnusedText1"] = "Pensamos que algo\nhizo aparecer en las\fRUINAS esos enigmáticos\ndibujos. Basamos\fnuestros estudios\nen ello.",
  ["RuinsOfAlphResearchCenterUnusedText2"] = "De acuerdo con mi\ninvestigación… Esos\fmisteriosos dibujos\naparecie- ron cuando\fse construyó el\nCENTRO #COM. Debe\vde ser que las\fondas de radio\ntienen algún\ftipo de relación…\n",
  ["RuinsOfAlphSignText"] = "RUINAS ALFA ¡Bienvenidos!\n",
  ["RuinsOfAlphStrangePresenceText"] = "Siento una rara\npresencia…",
  ["SSAquaCantFindGranddaughterText"] = "Oh, hola… Todavía\nno he podido encontrar\va mi nieta. Si\festá en el barco,\nno hay problema.\fEs una niña muy\ntraviesa, así\fque estará molestando\na alguien.\fMe preocupa…\n",
  ["SSAquaCaptainExhaustingText"] = "¡Ah! Gracias\npor venir. Estoy\fagotado de entretener\na esa\vniña.",
  ["SSAquaCaptainHowDoYouLikeText"] = "¿Te gusta viajar\nen el S.S. AQUA?\fPrácticamente vuela\npor encima de\vlas olas.",
  ["SSAquaEntertainedGranddaughterText"] = "¿{PLAYER}, verdad?\nHe oído que has\ventretenido\va mi nieta.\fQuiero agradecértelo.\n",
  ["SSAquaGranddaughterCaptainPlayWithMeText"] = "CAPITÁN, venga,\njuegue conmigo.\f¡Me aburro! Quiero\njugar más.",
  ["SSAquaGranddaughterHadFunText"] = "¡Me he divertido\nmucho jugando!",
  ["SSAquaGranddaughterHasToFindGrandpaText"] = "¡Hola! ¿Juegas\nconmigo? ¡Oh…!\f¿El abuelo está\fpreocupado?\n¡Debo irme!\f¡Tengo que encon-\ftrar al\nabuelo!",
  ["SSAquaGranddaughterWasPlayingMText"] = "¡Hola, abuelo!\nEstaba jugando\fcon el CAPITÁN\ny este chico.",
  ["SSAquaGrandpaHaveThisText"] = "¡Me gustaría que\ntuvieras esto!",
  ["SSAquaGrandpaTravellingText"] = "Estamos viajando por\ntodo el mundo.",
  ["SSAquaHasArrivedVermilionText"] = "El FERRY S.S.\nAQUA ha llegado\va CIUDAD\vCARMÍN.",
  ["SabrinaFightDoneText"] = "SABRINA: Tu amor\npor tus POKéMON\fsupera mi poder\npsíquico… Creo\fque el poder\ndel amor es un\ftipo de poder\npsíquico…",
  ["SabrinaIntroText"] = "SABRINA: ¿Sabías que\nventas… Hace tres años tuviste una visión\nde tu llegada.\vLo que quieras es mi MEDALLA.\nNo me gusta pelear, pero tengo que hacerlo.\ncomo LÍDER otorgas MEDALLAS\na todo aquel que los merezca.\nComo esto es lo que quieres, mira mis poderes.\npsíquicos.",
  ["SabrinaMarshBadgeText"] = "SABRINA: La MEDALLA\nPANTANO muestra\vtus poderes\focultos. Aunque\nno supe predecir\ftu poder con\nexactitud,\vsabía que valías\vmucho. ¡Llegarás\va ser lo\fque te\npropongas!\v",
  ["SabrinaWinLossText"] = "SABRINA: Tu poder…\nsupera con creces\flo que esperaba…\nQuizá no se pueda\fpredecir del todo\nlo que nos espera\fen el futuro…\nVale, tú ganas.\fTe has ganado\nla MEDALLA\vPANTANO.",
  ["SafariZoneClosedSignText"] = "El GUARDA está de\nviaje. Ésa es la\frazón por la que\nla ZONA SAFARI\vestá cerrada",
  ["SafariZoneOfficeSignText"] = "Aquí hay una nota…\nEl PUESTO GUARDA\fDE LA ZONA SAFARI\nestá cerrado hasta\vnuevo aviso",
  ["SafariZonePhotoText"] = "Es una foto de una\nextensa pradera\fllena de POKéMON\nraros jugando.",
  ["SaffronCityCooltrainerFText"] = "Es SILPH S.A., famosa\npor sus artículos POKéMON.\vEn el pasado, el\fTEAM ROCKET quiso\nhacerse con esta\fcompañía por esa\nmisma razón.",
  ["SaffronCityCooltrainerMText"] = "Iba al GIMNASIO\na luchar contra\ventrenadores…\fY acabé en el\nviejo GIMNASIO\fque hay al\nlado. ¡Vaya,\fqué vergüenza\npasé!",
  ["SaffronCityFisherText"] = "¡Ñam, ñam! Dicen\fque en la CENTRAL\nENERGÍA tienen\vmuchos problemas.\f¡Ñam, ñam!",
  ["SaffronCityFisherText_ReturnedMachinePart"] = "¡Ñam, ñam! Dicen\fque hay problemas\nen la CENTRAL\vENERGÍA. ¡Ñam,\fñam! ¡Estoy\nlleno!",
  ["SaffronCityLass1Text"] = "Aqui vive una chica\nquien es experto en imitarlo\ngente. Incluso lo imita\ngente con lo que habla, y\nte confunde.",
  ["SaffronCityLass1Text_ReturnedMachinePart"] = "La COPIONA parecía\nmuy triste. Había\fperdido su #\nMUÑECO CLEFAIRY\vfavorito.",
  ["SaffronCityLass2Text"] = "Nuestra ciudad salió\nen un programa\vde radio. Está\fbien oír alabanzas\nsobre tu ciudad,\fpero también\nda un poco de\vvergüenza.",
  ["SaffronCityMagnetTrainStationSignText"] = "ESTACIÓN DEL MAGNETOTRÉN\nDE CIUDAD\vAZAFRÁN",
  ["SaffronCityPokefanMText"] = "¿Eres de JOHTO? Si\nfuncionara el MAGNETOTRÉN,\fno tardarías\nnada en volver\va casa.",
  ["SaffronCityPokefanMText_ReturnedMachinePart"] = "¿Eres de JOHTO?\nCon el MAGNETOTRÉN\fenseguida\nestarás en\vcasa.",
  ["SaffronCitySignText"] = "CIUDAD AZAFRÁN La brillante\fy dorada tierra\ndel comercio",
  ["SaffronCityYoungster1Text"] = "Entrar por primera\nvez en un callejón\fme pone un poco\nnervioso.",
  ["SaffronCityYoungster2Text"] = "En CIUDAD VERDE hay\nun lugar llamado\fla CASA del ENTRENADOR,\ndonde se reúne\fgente de todas\npartes.",
  ["SaffronGymGuideText"] = "¡Eh, futuro\nCAMPEÓN!\fUn entrenador tan\nbueno como tú\fno necesita que le\fdigan cómo tratar\na los POKéMON de\ntipo psíquico, ¿no?\f¡Espero grandes\ncosas de ti!\f¡Buena suerte!",
  ["SaffronGymGuideWinText"] = "¡Ha sido otro\ncombate increíble!",
  ["SaffronGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vAZAFRÁN: SABRINA\fMaestra de los POKéMON\npsíquicos",
  ["SaffronMagnetTrainStationGymGuideText"] = "El MAGNETOTRÉN\nes un tren muy\fmoderno que usa\nelectricidad e\fimanes para alcanzar\nuna velocidad\vincreíble.\fPero si no hay\nenergía\veléctrica…",
  ["SaffronMagnetTrainStationGymGuideText_ReturnedMachinePart"] = "Uf… ¿cuántas veces he\nHe estado yendo y viniendo entre KANTO\ny JOHTO?",
  ["SaffronMagnetTrainStationLassText"] = "Hola. ¿Tienes un PASE\npara el tren? Tengo\funo. Todos los de\nAZAFRÁN que toman\fel MAGNETOTRÉN\ntienen PASES.",
  ["SaffronMagnetTrainStationOfficerAreYouComingOnBoardText"] = "Pronto saldremos\nhacia CIUDAD\fTRIGAL. ¿Quiere\nsubir?",
  ["SaffronMagnetTrainStationOfficerArrivedInSaffronText"] = "Hemos llegado\na CIUDAD AZAFRÁN.\fSiempre a su\nservicio.",
  ["SaffronMagnetTrainStationOfficerHopeToSeeYouAgainText"] = "Siempre a su\nservicio.",
  ["SaffronMagnetTrainStationOfficerRightThisWayText"] = "¿Por favor, puedo\nver su PASE? Bien.\fYa puede pasar,\njoven.",
  ["SaffronMagnetTrainStationOfficerTrainIsntOperatingText"] = "Lo siento, pero el\nMAGNETOTRÉN no funciona\vahora.",
  ["SaffronMagnetTrainStationOfficerYouDontHaveAPassText"] = "Lo siento, pero\nno tiene PASE.",
  ["SaffronMagnetTrainStationTeacherText"] = "Antes de que se\nconstruyera la\fESTACIÓN, ahí había\nuna casa. Y en\fella vivía una\nniña llamada\vCOPIONA.",
  ["SaffronMartCooltrainerFText"] = "Quiero ser más fuerte,\npero aún debo\vaprender… ¿Podrías\fayudarme a\nmejorar?",
  ["SaffronMartCooltrainerMText"] = "En PUEBLO LAVANDA\nhay una gran\vTORRE RADIO.",
  ["SaffronPokecenter1FFisherReturnedMachinePartText"] = "Las bodegas sudorosas\ndesmoronarse. Han desaparecido recientemente\nvarias cuevas, como la de CIUDAD\nCELESTE. Para un MONTAÑERO profesional,\nEso es obvio.",
  ["SaffronPokecenter1FFisherText"] = "Acabo de cruzar\nel TÚNEL ROCA.\fPasaba algo\nen la CENTRAL\vENERGÍA.",
  ["SaffronPokecenter1FTeacherMobileText"] = "¿Cómo son los CENTROS\nPOKéMON de JOHTO?\v…Oh, ya veo. Así\fque permiten conectar\ncon gente de\flejos… ¡Entonces\nle diré a mi\famigo de JOHTO\nque capture\fun MARILL\ny me lo\vcambie!",
  ["SaffronPokecenter1FTeacherText"] = "¿Cómo son los CENTROS\nPOKéMON de JOHTO?\vOh… ya veo. Así\fque no son tan\fdiferentes de\nlos de KANTO…\v¡Entonces puedo\fir a JOHTO sin\ntener que preocuparme!\v",
  ["SaffronPokecenter1FYoungsterText"] = "La OFICINA CENTRAL\nde SILPH S.A. y la\fESTACIÓN del MAGNETOTRÉN\nson los lugares\fmás vistos de\nAZAFRÁN.",
  ["SageChowAfterBattleText"] = "Todos los seres\nvivos cooperan para\vsobrevivir. Deberíamos\festar agradecidos.\n",
  ["SageEdmondAfterBattleText"] = "Quería imitar los\nsuaves movimientos\fde BELLSPROUT para\npelear… Pero no\fme entrené lo\nsuficiente.",
  ["SageEdmondSeenText"] = "Muévete como las\nhojas al viento…",
  ["SageJeffreyAfterBattleText"] = "¿De dónde vienen\nlos POKéMON?",
  ["SageJeffreyBeatenText"] = "Viví victorias\ny derrotas.",
  ["SageJeffreySeenText"] = "Pasé la primavera\ncon mis POKéMON.\fY el verano, otoño\ne invierno. Luego\fvolvió la primavera.\nHemos vivido\fjuntos mucho\ntiempo.",
  ["SageJinAfterBattleText"] = "Cuanto más fuerte\nsea el POKéMON,\vmás fuerte será\vsu entrenador.\fNo, espera. Cuanto\nmás fuerte sea\fel entrenador,\nmás fuerte el\vPOKéMON.",
  ["SageJinBeatenText"] = "Mi entrenamiento\nes incompleto…",
  ["SageJinSeenText"] = "¡Me entreno para\nsaberlo todo sobre\vlos POKéMON!",
  ["SageLiAfterBattleText"] = "¡Ojalá aprendas\ny madures con\vtu viaje!",
  ["SageLiBeatenText"] = "¡Ah, excelente!",
  ["SageLiFlashExplanationText"] = "DESTELLO ilumina\nhasta el lugar\vmás oscuro. Y,\fcon la MEDALLA\nde CIUDAD MALVA,\fpodrás usarlo\nfuera del\vcombate.",
  ["SageLiSeenText"] = "¡Encantado de verte\npor aquí! TORRE BELLSPROUT\fes un lugar de entrenamiento.\nLa gente y los\fPOKéMON evalúan\nsus vínculos para\fconstruir juntos\nun futuro mejor.\fYo soy la prueba\nfinal. ¡Déjame\fevaluar tus\nvínculos\fcon los POKéMON!\n",
  ["SageLiTakeThisFlashText"] = "Tú y tus POKéMON\nno deberíais tener\fproblemas con este\nmovimiento. Toma\festa MO. Es\nDESTELLO.",
  ["SageNealAfterBattleText"] = "¡Que haya luz en\ntus viajes!",
  ["SageNealBeatenText"] = "¡Mi cerebro sí que\nes brillante!",
  ["SageNealSeenText"] = "La MO del ANCIANO\nalumbra hasta lo\vmás oscuro.",
  ["SageNicoAfterBattleText"] = "La columna flexible\nprotege la TORRE\fhasta de los\nterremotos.",
  ["SageNicoBeatenText"] = "Luché con fuerza,\npero estoy débil.",
  ["SagePingAfterBattleText"] = "Sólo usamos POKéMON\ndel tipo fantasma.\f¡Los ataques normales\nno les hacen\vdaño!",
  ["SagePingSeenText"] = "¿Puedes causar algún\ndaño a nuestros\vPOKéMON?",
  ["SageTroyAfterBattleText"] = "No estás lejos\ndel ANCIANO.",
  ["SageTroyBeatenText"] = "¡Sí, tu confianza\nes auténtica!",
  ["SageTroySeenText"] = "A ver cuánto\nconfías en tus\vPOKéMON.",
  ["SailorErnestAfterBattleText"] = "Ser LÍDER de GIMNASIO\nno es sólo cuestión\fde fuerza. Todo LÍDER\ntambién debe ser\vcompasivo.",
  ["SailorErnestBeatenText"] = "¡Uauu! ¡Eres\nincreíble!",
  ["SailorEugeneAfterBattleText"] = "Mis POKéMON han sido\natrapados y entrenados\ven el extranjero.\fMe han acompañado\nen esos largos\vviajes.",
  ["SailorEugeneSeenText"] = "Acabo de volver a\nCIUDAD OLIVO. ¿Te\fapetece luchar con\nlos POKéMON?",
  ["SailorGarrettAfterBattleText"] = "Llevamos a\nmuchos pasajeros\vdesde CIUDAD\fCARMÍN a\vCIUDAD\vOLIVO.",
  ["SailorGarrettBeatenText"] = "He perdido en mi\npropio campo…",
  ["SailorGarrettSeenText"] = "¡Aquí es donde\ntrabajamos!",
  ["SailorHarryAfterBattleText"] = "Gentes de todo\nel mundo viven\ffelices con los\nPOKéMON.",
  ["SailorHarryBeatenText"] = "¡Tu destreza es de\ncategoría mundial!",
  ["SailorHarrySeenText"] = "He estado en el extranjero.\n¡Así que conozco\ftodo tipo de\nPOKéMON!",
  ["SailorJeffAfterBattleText"] = "Supongo que no ganaré\nsi no me lo tomo\ven serio.",
  ["SailorJeffBeatenText"] = "¡Gane o pierda, se\nacabó el descanso!",
  ["SailorJeffSeenText"] = "No hay nada mejor\nque un combate en\vmi tiempo libre.",
  ["SailorKennethAfterBattleText"] = "¡Ocho MEDALLAS! Eso\ndemuestra que has\fvencido a los LÍDERES\nde GIMNASIO. ¡No\fme extraña que seas\ntan fuerte!",
  ["SailorKennethBeatenText"] = "Me falta entrenamiento…\n",
  ["SailorKennethSeenText"] = "¡Soy marinero!\fPero entreno POKéMON\npara ser el\vCAMPEÓN.",
  ["SailorKentAfterBattleText"] = "Hablando de enfermedades,\nhay una FARMACIA\fen CIUDAD\nORQUÍDEA.",
  ["SailorKentBeatenText"] = "Yo tampoco puedo\nsonreír…",
  ["SailorStanlyAfterBattleText"] = "Los marineros hacemos\nmucho trabajo\vfísico. ¡Es\vagotador!",
  ["SailorStanlyBeatenText"] = "¡Lo siento! ¡Todo\nes culpa mía!",
  ["SailorStanlySeenText"] = "Sí, es verdad,\nsoy un marinero.\f¡No hacía nada\nmalo! Como el camarote\festaba vacío,\nme eché un sueñecito.\v¡Ah! ¡Olvídalo!\f¡Luchemos!\n",
  ["SailorTerrellAfterBattleText"] = "Siempre que vuelvo\na CIUDAD OLIVO voy\val GIMNASIO. El\ftipo de POKéMON\nde su LÍDER ha\fcambiado sin darme\ncuenta.",
  ["SailorTerrellBeatenText"] = "Eres fuerte\ny amable…",
  ["SailorTerrellSeenText"] = "Los marineros somos\nfuertes y simpáticos.\v¿Y tú?",
  ["SandstormHouseWomanDisloyalText"] = "Si no confían más\nen ti, tendras problemas\fpara ganar. La confianza\nes el vínculo\fentre los POKéMON\ny sus entrenadores.\v",
  ["SandstormHouseWomanLoyalText"] = "¡Ah! Tus POKéMON\nconfían mucho en\vti. Da gusto ver\fa alguien tan\nbueno. Toma.\fUn regalo para\nel viaje.",
  ["SandstormHouseWomanText1"] = "¿Adónde vas con los\nPOKéMON? ¿A la LIGA\fPOKéMON? ¿Son tus\fPOKéMON lo bastante\nfieles como para\vpermi- tirte ganar?\fDéjame ver…",
  ["SantosGaveGiftText"] = "SABINO: … HECHIZO…\fMejora los movimientos\fde tipo fantasma.\nTe voy\fa asustar…\n",
  ["SantosGivesGiftText"] = "Toma esto…",
  ["SantosNotSaturdayText"] = "SABINO: Hoy no\nes sábado…",
  ["SantosSaturdayText"] = "SABINO: … Nos\fvemos otro sábado…\nPero ya no\ftendré más\nregalos…",
  ["SchoolboyAlan1BeatenText"] = "¡Ups! ¿Error\nde cálculo?",
  ["SchoolboyAlan1SeenText"] = "¡Gracias a mis estudios,\nestoy preparado para\vcualquier POKéMON!",
  ["SchoolboyAlanBooksText"] = "Yo también estudio\n5 horas al día.\fLeyendo libros\npuedes aprender\vmuchas cosas.",
  ["SchoolboyBillyAfterBattleText"] = "¡Si los POKéMON fueran\nuna asignatura, yo\vsería el mejor!",
  ["SchoolboyBillyBeatenText"] = "¡Oh, no! ¿Cómo he\npodido perder?",
  ["SchoolboyBillySeenText"] = "¡Mi asignatura favorita\nes la gimnasia!",
  ["SchoolboyChad1BeatenText"] = "Creo que no estudié\nbastante.",
  ["SchoolboyChad1SeenText"] = "Déjame probar\nalgo que he aprendido\vhoy.",
  ["SchoolboyChadSoManyTestsText"] = "Tengo que hacer muchos\nexámenes y no tengo\ftiempo para los\nPOKéMON. Así que,\fcuando puedo jugar,\nme concentro\vmucho.",
  ["SchoolboyDannyAfterBattleText"] = "Es natural que los\nentrenadores luchemos\fcuando nos encontremos.\n",
  ["SchoolboyDannyBeatenText"] = "Tengo el récord de\ncombates perdidos.",
  ["SchoolboyDudleyAfterBattleText"] = "Hice lo que pude.\nNo me arrepiento.",
  ["SchoolboyDudleyBeatenText"] = "¡Uau! Muy bien.",
  ["SchoolboyDudleySeenText"] = "¡Véncenos a los\nseis para ganar\vun fantástico\fpremio! ¿Lo conseguirás?\n",
  ["SchoolboyJack1SeenText"] = "El mundo POKéMON\nes muy amplio.\fY sigue habiendo\nmuchas cosas\vque ignoramos.\f¡Pero yo sé\nmás que tú!",
  ["SchoolboyJackTradeMonText"] = "Hay muchas cosas\nque aprender. Por\fejemplo… Hay 50\ftipos de MT. Los\nPOKéMON intercambiados\fsuben antes\nde nivel.",
  ["SchoolboyJoeAfterBattleText"] = "Hice lo que pude.\nNo me arrepiento.",
  ["SchoolboyJoeBeatenText"] = "¡Au! ¡Se acabó!",
  ["SchoolboyJoeSeenText"] = "¡Soy el tercero!\nY no será fácil.",
  ["SchoolboyJohnnyAfterBattleText"] = "Estoy cansado de\ncaminar. Necesito\vun descanso.",
  ["SchoolboyJohnnyBeatenText"] = "¡Eres demasiado\nfuerte!",
  ["SchoolboyJohnnySeenText"] = "Vamos a la TORRE\nRADIO de LAVANDA\vpara realizar\funos estudios\nsociales.",
  ["SchoolboyKippAfterBattleText"] = "Mi madre se preocupa\nmucho por mí,\ftengo que llamarla\nsiempre.",
  ["SchoolboyKippBeatenText"] = "¡Lo siento, mamá!\n¡Me han vencido!",
  ["SchoolboyKippSeenText"] = "Espera. Tengo que\nllamar a mamá.",
  ["SchoolboyNateAfterBattleText"] = "Las radios captan\nseñales extrañas\ven las RUINAS.",
  ["SchoolboyNateSeenText"] = "¿Conoces las\nRUINAS ALFA?",
  ["SchoolboyRickyAfterBattleText"] = "He leído que hay cuatro\npaneles de piedra\vcomo ésos.",
  ["SchoolboyRickySeenText"] = "En las RUINAS ALFA\nhay unos extraños paneles\vde piedra.",
  ["SchoolboyTommyAfterBattleText"] = "¡Sayonara! Lo he\naprendido en la clase\vde japonés.",
  ["SchoolboyTommyBeatenText"] = "¡Me olvidé de hacer\nlos deberes!",
  ["SchoolboyTommySeenText"] = "Luchemos. ¡No\nperderé!",
  ["ScientistJedAfterBattleText"] = "Bien. te diré\nun secreto sobre nuestra guarida.\feso es lo que hay\nel suelo es un panel corredero.\fSi te pones encima,\nte llevará de regreso allí\nentrada.",
  ["ScientistJedSeenText"] = "Esto era una guarida\nninja. Hay trampas\fpara confundir\na los intrusos\vcomo tú.",
  ["ScientistMarcAfterBattleText"] = "¡Jajajajaja…! Desde\faquí puedo transmitir\ntodo tipo de\vseñales.",
  ["ScientistMarcBeatenText"] = "¡Vaya! ¡No te tomé\nmuy en serio!",
  ["ScientistMarcSeenText"] = "¿Qué haces mero-\ndeando por aquí?\f¿Quién eres?",
  ["ScientistMitchAfterBattleText"] = "Si enviáramos nuestra\nseñal de radio\fpor todo el país…\n¡Me emociono\fsólo de pensarlo!\n",
  ["ScientistMitchBeatenText"] = "Mi fuerte es\npensar, no\vpelear.",
  ["ScientistMitchSeenText"] = "Me da igual que los POKéMON\nsufran debido a nuestros\vexperimentos.",
  ["ScientistRichAfterBattleText"] = "¿De verdad crees que\npuedes detener al\vTEAM ROCKET?",
  ["ScientistRichBeatenText"] = "¡Mmmm…! Todo gran\fplan tiene\nsus pegas.",
  ["ScientistRichSeenText"] = "¡Extraordinario!\fEsta TORRE RADIO\ncompletará nuestro\vgran plan.",
  ["ScientistRossAfterBattleText"] = "una señal de radio\nque vuelve loco a los POKéMON… Mi experimento es\ncada éxito.\festoy ascendiendo\nasegurado. Esta derrota no significa\nnada.",
  ["ScientistRossBeatenText"] = "Un error táctico\nacabó conmigo…",
  ["ScientistRossSeenText"] = "Trabajaba para SILPH,\npero ahora investigo\fpara el TEAM\nROCKET. Ya está\fbien de tantas\npreguntas,\vse acabó.",
  ["SeafoamGymGuideWinText"] = "¡Hola!\f…¿Eh? ¿Ya ha\nterminado?\f¿Tan rápido?\f¡Perdona, amigo!\fEl GIMNASIO de\nCANELA desapareció,\fasí que no sabía\ndónde encontrarte.\fPero eres muy\nfuerte, incluso\fsin mi consejo.\n¡Ya lo sabía!",
  ["SeafoamGymGuideWinText2"] = "Un GIMNASIO puede\nestar en cualquier\vlugar, siempre que\nel LÍDER esté allí.\fNo necesita un\nedificio.",
  ["ShowElmTogepiText1"] = "ELM: ¡{PLAYER},\nestás genial!",
  ["ShowElmTogepiText2"] = "¿Qué? ¿¡Ese\nPOKéMON!?",
  ["ShowElmTogepiText3"] = "¡El HUEVO se abrió!\nLos POKéMON deben\vnacer así. Quizá\fno todos los\nPOKéMON. ¡Uauu!\fAún nos queda\nmucho por\vaprender.",
  ["SilphCoOfficerText"] = "En el suelo del acantilado\nSólo los empleados pueden subir. Pero ¿cómo llegaste?\nDe tan lejos, toma este pequeño\nLo recuerdo.",
  ["SilphCoOfficerText_GotUpGrade"] = "Es lo último de\nSILPH S.A. Aún\fno se encuentra\na la venta.",
  ["SilphCoReceptionistText"] = "Ésta es la OFICINA\nCENTRAL de\vSILPH S.A.",
  ["SilphCoSignText"] = "EDIFICIO-OFICINAS\nSILPH S.A.",
  ["SilverCavePokecenter1FGrannyText"] = "Los entrenadores\nambiciosos escalan\fel MT. PLATEADO\na pesar del\vpeligro. Con\fsus fieles POKéMON\nsienten que\fpueden ir\na cualquier\vlado…",
  ["SkierClarissaAfterBattleText"] = "No debería haber presumido\nsobre mi forma\vde esquiar.",
  ["SkierClarissaBeatenText"] = "¡No! ¡He\nperdido!",
  ["SkierClarissaSeenText"] = "¡Mira qué bien\nlo hago!",
  ["SkierRoxanneAfterBattleText"] = "Si no patinas con\nprecisión, no lograrás\fnada en este\nGIMNASIO.",
  ["SkierRoxanneBeatenText"] = "¡No perderé ante\nti esquiando!",
  ["SkierRoxanneSeenText"] = "Para vencer a FREDO,\nel LÍDER del GIMNASIO,\fpiensa antes\nde patinar.",
  ["SlowpokeWellB1FKurtText"] = "CÉSAR: ¡Hola, {PLAYER}!\nLos guardias de\farriba huyeron\nen cuanto les\vgrité. Pero entonces\fme caí por el\nPOZO. Me golpeé\ven la espalda\fy ahora no puedo\nmoverme. Si estuviera\vbien, mis POKéMON\flos habrían\nmachacado…\f¡Bah! Pero\nno puedo hacer\fnada. ¡{PLAYER},\ndemuéstrales\flo que\nvales!\v",
  ["SlowpokeWellB1FSlowpokeMailText"] = "{PLAYER} lee la\nCARTA. Sé buena\fy cuida de la\ncasa donde están\fel abuelo y SLOWPOKE.\nTe quiere,\fpapá.",
  ["SlowpokeWellB1FSlowpokeWithMailText"] = "Un SLOWPOKE sin\nCOLA… ¿Qué? Tiene\funa CARTA.\n¿La lees?",
  ["SlowpokeWellB1FTaillessSlowpokeText"] = "Un SLOWPOKE\nsin COLA…",
  ["SlowpokeWellB2FGymGuideText"] = "Espero o momento\nde evolução do\vSLOWPOKE.\fPelas minhas\nobservaç├Áes,\vdescobri algo.\fUm SLOWPOKE com\numa KING'S ROCK\fé mordido por\num SHELLDER.\fAqui, vou te\ndar uma KING'S\vROCK.",
  ["SlowpokeWellB2FGymGuideText_GotKingsRock"] = "Vou ser como\no SLOWPOKE.\fEsperarei com\npaciência para\vver um evoluir.",
  ["SlowpokeWellSignText"] = "POZO SLOWPOKE Conocido\ftambién como POZO\nLLUVIA. Los nativos\fcreen que el bostezo\nde SLOWPOKE invoca\vla lluvia. Hace\f400 años, un bostezo\nde SLOWPOKE\facabó con una\nsequía",
  ["SoWhatWasProfElmsErrandText"] = "¿Qué quería el\nPROF. ELM? …\fParece muy difícil.\fDeberías llevar\ncon orgullo\fel que la\ngente confíe\ven ti.",
  ["SoulHouseGrannyText"] = "A los POKéMON que\nvivían conmigo…\flos quería como\na mis nietos…",
  ["SoulHouseLassText"] = "He venido con mi madre\na visitar las tumbas\vde los POKéMON…",
  ["SoulHouseSignText"] = "CEMENTERIO Que las\falmas de los POKéMON\ndescansen en paz",
  ["SoulHouseTeacherText"] = "Creo que aquí hay\notras tumbas de POKéMON.\vHay muchas cámaras\fen las que sólo\npuede entrar\vel SR. FUJI.",
  ["SproutTower1FGrannyText"] = "Un BELLSPROUT de 30\nm de altura. Dice\fla gente que se convirtió\nen la columna\vcentral.",
  ["SproutTower1FSage1Text"] = "Sólo obtendrás\nuna MO si llegas\varriba.",
  ["SproutTower1FSage2Text"] = "La TORRE BELLSPROUT\nfue construida\fpara entrenar\nPOKéMON.",
  ["SproutTower1FStatueText"] = "Estatua POKéMON…\fParece muy\nilustre.",
  ["SproutTower1FTeacherText"] = "¿Ves cómo se mueve\nla columna? Arriba\fhay gente entrenándose.\n",
  ["SproutTower2FStatueText"] = "Estatua POKéMON…\fParece muy\nilustre.",
  ["SproutTower3FPaintingText"] = "Es un bonito\ncuadro de un\vBELLSPROUT.",
  ["SproutTower3FStatueText"] = "Estatua POKéMON…\fParece muy\nilustre.",
  ["SproutTowerElderLecturesRivalText"] = "ANCIANO: Eres muy\nhábil entrenando\vPOKéMON. Como te\fprometí, aquí tienes\ntu MO. Pero déjame\fque te diga que\ndeberías tratar\fmejor a tus POKéMON.\nLuchas de forma\fmuy violenta.\nLos POKéMON\fno son armas\nde guerra.",
  ["SproutTowerRivalOnlyCareAboutStrongText"] = "… ¡Bah! estados\nser el VIEJO, pero es muy\ndébil. Es obvio.\vNunca perdería antes\ndi que tienes que ser bueno\ncon los POKéMON.\fsolo estoy interesado\nel POKéMON ganador.\nPaso de los POKéMON débiles.",
  ["SproutTowerRivalUsedEscapeRopeText"] = "¡<RIVAL> usa CUERDA\n¡HUIDA!",
  ["SproutTowerSignText"] = "TORRE BELLSPROUT\fVive la vida\nPOKéMON",
  ["SudowoodoAttackedText"] = "¡Al árbol extraño\nno le gusta la\vREGADERA! ¡El\fárbol extraño\natacó!",
  ["SunnyGaveGiftText"] = "DOMINGO: Eso…\f¡Um…! ¿Qué era…?\f… ¡Ah! ¡Ahora\flo recuerdo!\fDebería llevarlo\nun POKéMON con\fhabilidades eléctricas.\n¡Mi hermana\fLUNA dice\nque mejora\flas habilidades\neléctricas!\v",
  ["SunnyGivesGiftText1"] = "¡Me dijeron que\nte diera esto\vsi te veía!",
  ["SunnyNotSundayText"] = "DOMINGO: ¿Hoy no\nes domingo? ¡Um…!\v¡Lo olvidé!",
  ["SunnySundayText"] = "DOMINGO: Mis hermanos\nson LUNA, MARTA,\vMIGUEL, JOSUÉ,\vVICKI y SABINO.\v¡Son todos\fmayores\nque yo!",
  ["SupernerdEricAfterBattleText"] = "Supongo que debería\nactuar honradamente…\v",
  ["SupernerdPatAfterBattleText"] = "Lo siento… No haré\nmás trampas.",
  ["SupernerdPatBeatenText"] = "¿No sientes\ncansancio?",
  ["SupernerdPatSeenText"] = "¡Mufufufu…! No tengo\fnada que ver con\nlos otros seis entrenadores.\vPero he esperado\fa que estés débil\nde tanto pelear\fpara vencerte.\n",
  ["SupernerdSamAfterBattleText"] = "¡El poder de los imanes\nes inmenso!",
  ["SupernerdSamBeatenText"] = "Quiero ver el\nMAGNETOTRÉN…",
  ["SupernerdSamSeenText"] = "¿Cómo funciona el\nMAGNETOTRÉN?",
  ["SupernerdShawnAfterBattleText"] = "Deberías usar las\nBALL adecuadas para\vcada situación.",
  ["SupernerdShawnBeatenText"] = "¡Espera! ¡Detente!\n¡No, por favor!",
  ["SupernerdShawnSeenText"] = "¿Qué tipos de\nPOKé BALL llevas\vcontigo?",
  ["SupernerdTeruAfterBattleText"] = "Conozco mis tipos\nde POKéMON.\vPero sólo uso\fun tipo de\nPOKéMON.",
  ["SupernerdTeruSeenText"] = "¿Tienes en cuenta\nlos tipos durante\vel combate? Si\fconoces bien los\ndistintos tipos,\frendirás más\nen combate.",
  ["SupernerdTomAfterBattleText"] = "MEDALLAS DE GIMNASIO\nte da una ventaja en el combate.",
  ["SupernerdTomBeatenText"] = "Tal y como pensé…\n¡Eres fuerte!",
  ["SupernerdTomSeenText"] = "Mmm… Tienes muchas MEDALLAS\nde GIMNASIO.",
  ["SurfGuyElegantKimonoGirlsText"] = "Ojalá mis POKéMON fueran\ntan elegantes como\vlas CHICAS KIMONO…",
  ["SurfGuyLadGiftText"] = "¡Chaval! Si vences\na todas las CHICAS\fKIMONO, te daré\nun regalo.",
  ["SurfGuyLikeADanceText"] = "Verte luchar ha\nsido como ver\vuna danza. ¡Ha\fsido un extraño\ncombate! Me gustaría\fdarte esto.\nAdelante,\v¡tuyo es!",
  ["SurfGuyNeverLeftAScratchText"] = "Las CHICAS KIMONO\nno sólo bailan.\fTambién son extraordinarias\ncon los POKéMON.\vYo siempre las\fdesafío pero\nnunca les he\fhecho ni un\nrasguño…",
  ["SurfGuySurfExplanationText"] = "Es SURF. Un movimiento\fque permite\nnadar a los\vPOKéMON.",
  ["SwimmerfBrianaAfterBattleText"] = "No fardes tanto\nde haberme vencido.\vMISTY acabará\fcontigo si\nte confías\vdemasiado.",
  ["SwimmerfBrianaBeatenText"] = "¡Ooh! Has acabado\nconmigo…",
  ["SwimmerfBrianaSeenText"] = "No te desanimes\npor mi elegante\vforma de nadar.",
  ["SwimmerfDawnAfterBattleText"] = "No hay que nadar\nmucho desde CIUDAD\fFUCSIA a las ISLAS\nESPUMA… ¡Con todo\flo gran- de que\nes, menudo blandengue!\f",
  ["SwimmerfDawnBeatenText"] = "Podría ganarte\nnadando…",
  ["SwimmerfDawnSeenText"] = "¡No me gustan\nlos peques!",
  ["SwimmerfDeniseAfterBattleText"] = "El sol es muy malo\npara la piel. Pero no uso protección\nsolares. no quiero insistir\nel agua.",
  ["SwimmerfDeniseSeenText"] = "¡No me puedo creer\nel buen día\vque hace!",
  ["SwimmerfDianaAfterBattleText"] = "Estaré nadando tranquilamente.\n",
  ["SwimmerfDianaBeatenText"] = "¡Me rindo! ¡Has\nganado!",
  ["SwimmerfDianaSeenText"] = "Siento haber estado\nfuera. ¡A lo\vnuestro!",
  ["SwimmerfElaineAfterBattleText"] = "Creo que nado\nmejor que tú.\v¡Sin duda!",
  ["SwimmerfElaineBeatenText"] = "¡He perdido!",
  ["SwimmerfElaineSeenText"] = "¿Vas a CIUDAD\nORQUÍDEA? ¿Te\fapetece luchar\nantes?",
  ["SwimmerfKaraAfterBattleText"] = "He oído rugidos\nprocedentes de\vlas ISLAS.",
  ["SwimmerfKaraBeatenText"] = "¡Oh! Tienes más\nenergía que yo.",
  ["SwimmerfKaraSeenText"] = "Si necesitas descansar,\nflota y déjate\vllevar por\fel viento,\nasí no malgastarás\ftus fuerzas.\n",
  ["SwimmerfKayleeAfterBattleText"] = "Dicen que hay\nun gran POKéMON\vbajo las ISLAS\vREMOLINO. Me\fpregunto cómo\nserá…",
  ["SwimmerfKayleeBeatenText"] = "¿Así es como\nlo haces?",
  ["SwimmerfKayleeSeenText"] = "Voy hacia las ISLAS\nREMOLINO. Voy a\fexplorarlas con\nunos amigos.",
  ["SwimmerfLoriAfterBattleText"] = "SURF ya no es el único\nmovimiento que se utiliza\ven el agua.",
  ["SwimmerfLoriSeenText"] = "¡Vaya colección\nde MEDALLAS\fde GIMNASIO!\n¡Luchemos!",
  ["SwimmerfNicoleAfterBattleText"] = "La natación forta-\nlece todo tu\fcuer- po. ¡Es\nmuy sana!",
  ["SwimmerfNikkiAfterBattleText"] = "Debería tener cuidado\ncon las manchas causadas\vpor el sol.",
  ["SwimmerfNikkiBeatenText"] = "No quiero\nquemarme…",
  ["SwimmerfNikkiSeenText"] = "¡Si gano, tienes\fque ayudarme\ncon la loción\vsolar!",
  ["SwimmerfPaulaAfterBattleText"] = "Mientras flote\nasí, las olas\vme llevarán.",
  ["SwimmerfPaulaBeatenText"] = "¡Ooh, estoy\nmareada!",
  ["SwimmerfPaulaSeenText"] = "Yo no necesito\nflotador. ¡Voy\fagarrada a un POKéMON\nde mar!",
  ["SwimmerfSusieAfterBattleText"] = "¿No había una canción\nfamosa sobre un niño que\vmontaba un LAPRAS?",
  ["SwimmerfSusieSeenText"] = "Estás tan elegante\nsobre tu\vPOKéMON.",
  ["SwimmerfWendyAfterBattleText"] = "Los grupos de STARYU\nse iluminan al\vmismo tiempo. Es\fmuy bonito, pero\nda miedo.",
  ["SwimmerfWendySeenText"] = "Por la noche, los STARYU\nse reúnen cerca de\vla superficie.",
  ["SwimmermBerkeAfterBattleText"] = "Era de noche y\nllovía… Vi un POKéMON\fgigante volando\ndesde las islas.\vDejaba caer\flas plumas de\nsus alas plateadas.\v",
  ["SwimmermBerkeBeatenText"] = "¿Cuál es tu\nsecreto?",
  ["SwimmermBerkeSeenText"] = "¿Ves esas islas\naisladas por torbellinos?\v¡Tiene que\fhaber un\nsecreto!",
  ["SwimmermCameronAfterBattleText"] = "Además de nadar en el\nmar, puedo nadar en\vestanques y ríos.",
  ["SwimmermCameronSeenText"] = "Supongo que es\nimposible ir\fnadando hasta\nJOHTO.",
  ["SwimmermCharlieAfterBattleText"] = "¡Qué relajante\nes flotar\vasí!",
  ["SwimmermCharlieBeatenText"] = "¡Vaya! ¡Estoy como\nuna pasa!",
  ["SwimmermGeorgeAfterBattleText"] = "CIUDAD ORQUÍDEA está\nmuy lejos. Pero\ftampoco es fácil\nvolver a CIUDAD\vOLIVO. ¿Qué se\fpuede hacer?",
  ["SwimmermGeorgeSeenText"] = "Estoy cansado. Si\ngano, ¿me prestas\vtus POKéMON?",
  ["SwimmermHaroldAfterBattleText"] = "De noche, el mar está\noscuro. Da la impresión\fde que te va\na tragar.",
  ["SwimmermJeromeAfterBattleText"] = "Puede que no nade\nmuy bien, pero me\vencanta el mar.",
  ["SwimmermJeromeBeatenText"] = "Creía que podía\nganar.",
  ["SwimmermJeromeSeenText"] = "Soy malísimo nadando.\nSólo estoy chapoteando\fpor estas aguas\npoco profundas.\v",
  ["SwimmermKirkAfterBattleText"] = "La corriente me\nimpide llegar\va las islas.",
  ["SwimmermKirkSeenText"] = "Aquí hay mucho\noleaje. Cuesta\fmucho nadar.\n",
  ["SwimmermMathewAfterBattleText"] = "Un secreto sobre\nISLAS REMOLINO…\f¡Dentro está\nmuy oscuro!",
  ["SwimmermMathewBeatenText"] = "¡Ooh, tienes una gran\nresistencia!",
  ["SwimmermMathewSeenText"] = "¿Estás buscando el\nsecreto de las ISLAS\vREMOLINO?",
  ["SwimmermParkerAfterBattleText"] = "MISTY ha mejorado\nmucho en los\vúltimos años.\f¡No bajes la\nguardia o acabarás\vmal!",
  ["SwimmermParkerSeenText"] = "¡Glup…! ¡Soy el\fprimero! ¡Ven\na por mí!",
  ["SwimmermRandallAfterBattleText"] = "La natación fortalece\ntu cuerpo.\vEs sana.",
  ["SwimmermRandallSeenText"] = "¡Eres joven y estás\nen forma! ¡No vayas\fsobre tu POKéMON!\n¡Nada!",
  ["SwimmermSethAfterBattleText"] = "Ese chico tan arrogante\nestaba en el volcán\vde ISLA CANELA.",
  ["SwimmermSimonAfterBattleText"] = "CIUDAD ORQUÍDEA\nestá bastante lejos\vde aquí.",
  ["SwimmermSimonBeatenText"] = "¡Vale! ¡Me rindo!",
  ["SwimmermTuckerAfterBattleText"] = "Le… pedí a mi novia\nque nadara a CIUDAD\vFUCSIA…",
  ["SwimmermTuckerSeenText"] = "(Resoplido)… Un…\npoco más… y…\fllegaré… a CIUDAD\nFUCSIA…",
  ["SwitchRoomText_Emergency"] = "Viene marcado como\nEMERGENCIA.",
  ["SwitchRoomText_OffTurnOn"] = "Está APAGADO. ¿Lo\nENCIENDES?",
  ["SwitchRoomText_OnTurnOff"] = "Está ENCENDIDO.\n¿Lo APAGAS?",
  ["SwitchRoomText_Switch1"] = "Viene marcado\ncomo BOTÓN 1.",
  ["SwitchRoomText_Switch2"] = "Viene marcado\ncomo BOTÓN 2.",
  ["SwitchRoomText_Switch3"] = "Viene marcado\ncomo BOTÓN 3.",
  ["TEXT_AZALEA_GYM_OBJ_001"] = "¡Soy ANTÓN!\nNunca pierdo cuando se trata de\n¡Animales POKEMON!\fmis investigaciones\nme convertirá en\nla máxima autoridad\nen POKéMON animales!\fDéjame enseñarte\nlo que aprendí\nen mis estudios.",
  ["TEXT_AZALEA_GYM_OBJ_002"] = "Los POKéMON se\nhacen más fuertes\vcuando evolucionan.\n¡De verdad!",
  ["TEXT_AZALEA_GYM_OBJ_002_AFTER"] = "Los POKéMON se\nhacen más fuertes\vcuando evolucionan.\n¡De verdad!",
  ["TEXT_AZALEA_GYM_OBJ_002_BEATEN"] = "¡Evolucionar no\nlo es todo!",
  ["TEXT_AZALEA_GYM_OBJ_002_SEEN"] = "Los animales POKéMON\nevolucionar listo.\fPor eso sucedió\nmás fuerte.",
  ["TEXT_AZALEA_GYM_OBJ_003"] = "Son geniales, pero la\nmayoría de las chicas\nodia a los POKéMON\vbicho.\fNo sé por qué…",
  ["TEXT_AZALEA_GYM_OBJ_003_AFTER"] = "Son geniales, pero la\nmayoría de las chicas\nodia a los POKéMON\vbicho.\fNo sé por qué…",
  ["TEXT_AZALEA_GYM_OBJ_003_BEATEN"] = "Has demostrado lo\nfuerte que eres…",
  ["TEXT_AZALEA_GYM_OBJ_003_SEEN"] = "¡Los POKéMON bicho\nson buenos y muy\nfuertes!\f¡Voy a demostrártelo!",
  ["TEXT_AZALEA_GYM_OBJ_004"] = "Debería enseñarles\nmejores movimientos.",
  ["TEXT_AZALEA_GYM_OBJ_004_AFTER"] = "Debería enseñarles\nmejores movimientos.",
  ["TEXT_AZALEA_GYM_OBJ_004_BEATEN"] = "¡Aaah!",
  ["TEXT_AZALEA_GYM_OBJ_004_SEEN"] = "¿Has salvado a\ntodos los SLOWPOKE?\v¡Uf! ¡Eres increíble!\fPero mis POKéMON\nadultos también son\vmuy fuertes!",
  ["TEXT_AZALEA_GYM_OBJ_005"] = "AMY: ¡Eres\nmuy fuerte!",
  ["TEXT_AZALEA_GYM_OBJ_005_AFTER"] = "AMY: ¡Eres\nmuy fuerte!",
  ["TEXT_AZALEA_GYM_OBJ_005_BEATEN"] = "AMY y MAY: ¡Oh,\ndoblemente bien!",
  ["TEXT_AZALEA_GYM_OBJ_005_SEEN"] = "AMY: ¡Hola! ¿Vas a\ndesafiar al LÍDER?\v¡Ni hablar!",
  ["TEXT_AZALEA_GYM_OBJ_006"] = "MAY: ¡Mis POKéMON\nbicho han perdido!\v¡Qué pena!",
  ["TEXT_AZALEA_GYM_OBJ_006_AFTER"] = "MAY: ¡Mis POKéMON\nbicho han perdido!\v¡Qué pena!",
  ["TEXT_AZALEA_GYM_OBJ_006_BEATEN"] = "AMY y MAY: ¡Oh,\ndoblemente bien!",
  ["TEXT_AZALEA_GYM_OBJ_006_SEEN"] = "MAY: ¿Quieres ver\nal LÍDER?\v¡Antes nosotras!",
  ["TEXT_AZALEA_GYM_OBJ_007"] = "¡Hola, valiente!\fANTÓN es joven, pero\nconoce muy bien a los\nPOKéMON bicho.\fSin mis consejos te\nresultaría más duro.\fVeamos… A los POKéMON\nbicho no les va el fuego.\fY los ataques de tipo\nvolador son muy\vefectivos.",
  ["TEXT_AZALEA_MART_OBJ_001"] = "No hay GREAT BALL\naquí. Las POKé\fBALLS tendrán que\nservir.\fOjalá KURT me\nhiciera unas\vBALLS especiales.",
  ["TEXT_AZALEA_MART_OBJ_002"] = "No hay GREAT BALL\naquí. Las POKé\fBALLS tendrán que\nservir.\fOjalá KURT me\nhiciera unas\vBALLS especiales.",
  ["TEXT_AZALEA_POKECENTER1_F_OBJ_001"] = "¿Tus POKéMON saben\nmovimientos de HM?\fEstos movimientos\npueden usarse aunque\fel POKéMON esté\ndesmayado.",
  ["TEXT_AZALEA_POKECENTER1_F_OBJ_002"] = "\f{BYTE:34}{PC}\f{BYTE:EE}{PC}\f{BYTE:19}TMSeus POKéMON\nsabem golpes\vde HM?\fEsses golpes podem\nser usados mesmo\fse o POKéMON\nestiver desmaiado.",
  ["TEXT_AZALEA_TOWN_OBJ_001"] = "No es seguro\nentrar ahí, así que\vme quedaré vigilando.\f¿No soy un buen\nsamaritano?",
  ["TEXT_AZALEA_TOWN_OBJ_002"] = "El lento\ndesapareció de la ciudad… escuché que las COLAS\nde ellos están a la venta por ahí.",
  ["TEXT_AZALEA_TOWN_OBJ_003"] = "vino a preguntarle al\n¿KURT hace unas BOLAS?\fviene mucha gente\nsolo por eso.",
  ["TEXT_AZALEA_TOWN_OBJ_004"] = "Cortado por AZALEA\ny llegas al BOSQUE DE ILEX.\fPero estos árboles\ndelgado lo hace imposible\npase.\fPOKEMON\nCARVOEIRO utiliza CUT en los árboles.",
  ["TEXT_AZALEA_TOWN_OBJ_005"] = "SLOWPOKE: …\f…… …… ……",
  ["TEXT_AZALEA_TOWN_OBJ_006"] = "SLOWPOKE: …\f…… …… ……",
  ["TEXT_AZALEA_TOWN_OBJ_007"] = "SLOWPOKE: …\f…… …… ……",
  ["TEXT_AZALEA_TOWN_OBJ_008"] = "SLOWPOKE: …\f…… …… ……",
  ["TEXT_AZALEA_TOWN_OBJ_011"] = "Conozca el\n¿COLA LENTA?\v¡Dicen que es bueno!\fNo contento con\n¿Se lo he dicho?",
  ["TEXT_AZALEA_TOWN_OBJ_012"] = "Puedes ver por\n¿Por qué ILEX FOREST está tan ocupado?",
  ["TEXT_BATTLE_TOWER1_F_BG_001"] = "las reglas de\nTORRE DE BATALLA están escritos aquí.\f¿Leer las reglas?",
  ["TEXT_BATTLE_TOWER1_F_OBJ_001"] = "LA TORRE DE BATALLA\nte da la bienvenida!\fpuedo llevarte a\nuna SALA DE BATALLA.",
  ["TEXT_BATTLE_TOWER1_F_OBJ_002"] = "Destruido por\nprimer oponente en\ntiempo... no soy bueno...",
  ["TEXT_BATTLE_TOWER1_F_OBJ_003"] = "Tem várias\nBATTLE ROOMS, mas\fvou ganhar todas\nelas!",
  ["TEXT_BATTLE_TOWER1_F_OBJ_004"] = "lo estoy intentando\nver hasta dónde puedo llegar usando solo\nInsecto POKéMON.\feso no tiene\nsin fuego POKEMON...",
  ["TEXT_BATTLE_TOWER1_F_OBJ_005"] = "├ë muy difícil\nno poder usar artículos durante\nla batalla.\fHaz tu POKEMON\nMantener objetos es la clave para\nganar batallas.",
  ["TEXT_BATTLE_TOWER_OUTSIDE_OBJ_001"] = "Vaya, la BATALLA\n¡La TORRE es enorme!\fDebe haber muchos\ntipos de POKéMON en su interior!",
  ["TEXT_BATTLE_TOWER_OUTSIDE_OBJ_002"] = "Sólo puedes usar\ntres POKÉMON.\f├ë tan difícil\ndecide cuáles tres irán a la batalla...",
  ["TEXT_BILLS_FAMILYS_HOUSE_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_BILLS_FAMILYS_HOUSE_BG_002"] = "Uma coleção\ninteira de livros\vde POKéMON!",
  ["TEXT_BILLS_FAMILYS_HOUSE_BG_003"] = "............BILL: ¡Hola, {PLAYER}!\nHazte un favor y quédate con este EEVEE.\nLlegó cuando estaba ajustando la CÁPSULA DEL TIEMPO.\nAlguien necesita cuidar\nPero no me gusta salir.\n¿Puedo contar contigo, {PLAYER}?",
  ["TEXT_BILLS_FAMILYS_HOUSE_OBJ_001"] = "BILL: ¡Hola, {PLAYER}!\nHazte un favor y quédate con este EEVEE.\nLlegó cuando estaba ajustando la CÁPSULA DEL TIEMPO.\nAlguien necesita cuidar\nPero no me gusta salir.\n¿Puedo contar contigo, {PLAYER}?",
  ["TEXT_BILLS_FAMILYS_HOUSE_OBJ_002"] = "Oh, recoge\n¿POKÉMON? Mi hijo BILL es un experto.\fel tenia que ir\nal CENTRO CIUDAD DE POKEMON\nECRUTEAK.",
  ["TEXT_BILLS_FAMILYS_HOUSE_OBJ_003"] = "¿Eres entrenador?\ftengo un numero\nnúmero de teléfono útil para usted.",
  ["TEXT_BILLS_HOUSE_OBJ_001"] = "¿Mmm? Conozca el\n¿BILL? ├ë mi nieto.\fEl esta en JOHTO\nHace algo con las PC, así que\nYo cuido la casa.",
  ["TEXT_BLACKTHORN_CITY_BG_006"] = ".................Lo lamento.\fNuestro LÍDER es\nentrenando en la cueva de allí.\fno tengo idea\n¿Cuándo regresará nuestro LÍDER?",
  ["TEXT_BLACKTHORN_CITY_OBJ_001"] = "Lo lamento.\fNuestro LÍDER es\nentrenando en la cueva de allí.\fno tengo idea\n¿Cuándo regresará nuestro LÍDER?",
  ["TEXT_BLACKTHORN_CITY_OBJ_002"] = "Lo lamento.\fNuestro LÍDER es\nentrenando en la cueva de allí.\fno tengo idea\n¿Cuándo regresará nuestro LÍDER?",
  ["TEXT_BLACKTHORN_CITY_OBJ_003"] = "Sólo los usuarios de\nEl dragón puede entrenar aquí.\nPor favor vete.",
  ["TEXT_BLACKTHORN_CITY_OBJ_004"] = "Al igual que CLAIR, el\nmaestro dragón, te permití\npuedes entrar.",
  ["TEXT_BLACKTHORN_CITY_OBJ_005"] = "mi radio es\nroto?\vSólo esta señal.",
  ["TEXT_BLACKTHORN_CITY_OBJ_006"] = "tu lo haras\n¿Tu POKéMON olvida movimientos?",
  ["TEXT_BLACKTHORN_CITY_OBJ_007"] = "Todos os mestres\nde dragão vêm da\vCIDADE DE\vBLACKTHORN.",
  ["TEXT_BLACKTHORN_CITY_OBJ_008"] = "SANTOS: …\f├ë sábado…\fSou SANTOS\ndo sábado…",
  ["TEXT_BLACKTHORN_CITY_OBJ_009"] = "Vaya, viniste\npor ICE PATH?\fdebes ser\n¡un entrenador!",
  ["TEXT_BLACKTHORN_DRAGON_SPEECH_HOUSE_OBJ_001"] = "un clan de\nLos entrenadores que dominan los drags viven aquí en BLACKTHORN.\fPor eso hay\nHay muchas leyendas sobre dragones en esta ciudad.",
  ["TEXT_BLACKTHORN_DRAGON_SPEECH_HOUSE_OBJ_002"] = "DRATINI: Draa!",
  ["TEXT_BLACKTHORN_EMYS_HOUSE_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_BLACKTHORN_EMYS_HOUSE_BG_002"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_BLACKTHORN_EMYS_HOUSE_OBJ_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_001"] = "Soy CLARO. yo soy\nEl mejor maestro de dragones del mundo.\nPuedo rivalizar incluso con los CUATRO\nLIGA POKéMON A LO GRANDE.\n¿Aún quieres desafiarme?\n…Todo está bien.\f¡Vamos!\nComo entrenador, utilizaré el máximo\ncontra oponente!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_002"] = "Ahora conozco mi\nlimitaciones.\fgracias por mi\nmostrar!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_002_AFTER"] = "Ahora conozco mi\nlimitaciones.\fgracias por mi\nmostrar!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_002_BEATEN"] = "Que estranho.",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_002_SEEN"] = "mi oportunidad de\nperder? ¡Ni el uno por ciento!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_003"] = "O LANCE disse que\nquer te ver de\vnovo?\fSem chance!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_003_AFTER"] = "O LANCE disse que\nquer te ver de\vnovo?\fSem chance!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_003_BEATEN"] = "mi pokemon\ndragón perdido?",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_003_SEEN"] = "Primeira batalha\ncontra drag├Áes?\fVou mostrar como\nsão dur├Áes!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_004"] = "Drag├Áes são fracos\ncontra movimentos\vde dragão.",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_004_AFTER"] = "Drag├Áes são fracos\ncontra movimentos\vde dragão.",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_004_BEATEN"] = "¡Muy bien!",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_004_SEEN"] = "Los dragones son\nPOKéMON sagrado.\ftienen mucho\nenergía vital.\fSi no tomas\nEn serio, no lo lograrás.\nderrotarlos.",
  ["TEXT_BLACKTHORN_GYM1_F_OBJ_005"] = "¡Ey!\n¡FUTURO CAMPEÓN!\nHa pasado un tiempo desde que empezamos, pero\n¡Ya casi llegamos! ¡Cuenta conmigo!\nCLAIR utiliza dragones míticos y sagrados de tipo dragón.\fno puedes\nles duele fácilmente.\nPero debes saber que son débiles.\ncontra el hielo.",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_001"] = "Los miembros de la\nNuestro clan solo usa POKéMON dragón.\ndespués que el MAESTRO lo permita.",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_001_AFTER"] = "Los miembros de la\nNuestro clan solo usa POKéMON dragón.\ndespués que el MAESTRO lo permita.",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_001_BEATEN"] = "Droga! Se eu ao\nmenos tivesse um\vdragão!",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_001_SEEN"] = "Nem todo mundo\nusa POKéMON\vtipo dragão.",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_002"] = "Ai… A CLAIR vai\nficar brava…",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_002_AFTER"] = "Ai… A CLAIR vai\nficar brava…",
  ["TEXT_BLACKTHORN_GYM2_F_OBJ_002_SEEN"] = "no puedo irme\n¡Pasa un autocar sin nombre!\fCLAIR sería\nfurioso!",
  ["TEXT_BLACKTHORN_MART_OBJ_001"] = "no puedo comprar\nMAX REVIVE, pero restaura todo\nPOKéMON se desmayó Ten cuidado, no\nrestaura PP, TOMAS DE CORRIENTE\nnecesario.",
  ["TEXT_BLACKTHORN_MART_OBJ_002"] = "{BYTE:6A} {USER} & {USER} No puedo comprar\nMAX REVIVE, pero ella revive a un\nPOKéMON se desmayó por completo.\fPrecaución: no\nrecupera el PP, los POWER POINTS de\ngolpes.",
  ["TEXT_BLACKTHORN_MART_OBJ_003"] = "& {USER} No puedo comprar\nMAX REVIVE, pero restaura todo\nPOKéMON se desmayó Ten cuidado, no\nrestaura PP, TOMAS DE CORRIENTE\nnecesario.",
  ["TEXT_BLACKTHORN_POKECENTER1_F_OBJ_001"] = "Lá no fundo do\ndistante INDIGO\vPLATEAU fica a\vPOKéMON LEAGUE.\fOuvi dizer que os\nmelhores\ftreinadores do\npaís se reúnem lá.",
  ["TEXT_BLACKTHORN_POKECENTER1_F_OBJ_002"] = "\fF{PC}\f7{PC}...................................................Lá no fundo do\ndistante INDIGO\vPLATEAU fica a\vPOKéMON LEAGUE.\fOuvi dizer que os\nmelhores\ftreinadores do\npaís se reúnem lá.",
  ["TEXT_BLACKTHORN_POKECENTER1_F_OBJ_003"] = "7 {PC} ...................................................En lo profundo de la distancia\nMESETA ÍNDIGO y la LIGA POKéMON\nEscuché a los mejores entrenadores irse\nde todo el país.\fquiero ir allí\nun día.",
  ["TEXT_BLACKTHORN_POKECENTER1_F_OBJ_004"] = "Lá no fundo do\ndistante INDIGO\vPLATEAU fica a\vPOKéMON LEAGUE.\fOuvi dizer que os\nmelhores\ftreinadores do\npaís se reúnem lá.",
  ["TEXT_BLUES_HOUSE_OBJ_001"] = "MARGARITA: ¡Hola! mio\nhermano menor es LÍDER DE GIMNASIO\nde CIUDAD VIRIDIANA.\fpero el se va\nciudad tanto que causa problemas\npara el entrenador.",
  ["TEXT_BRUNOS_ROOM_OBJ_001"] = "Soy BRUNO, de\nÉLITE CUATRO.\fyo siempre entreno\nal extremo porque creo en nuestro potencial.\fAsí fue como el\nNos volvimos fuertes. Puedes manejarlo.\nnuestro poder?\f¿Mmm? no veo miedo\nen ti. Parece decidido.\n¡Perfecto!\f¿Listo, {PLAYER}?\nSe inclinará ante nuestro poder\nabrumador!\fRuu ja!",
  ["TEXT_BURNED_TOWER1_F_OBJ_002"] = "Todavía no calienta\nsuficiente…",
  ["TEXT_BURNED_TOWER1_F_OBJ_004"] = "MORTY: O LÍDER DE\nGINÁSIO de\fECRUTEAK precisa\nestudar os\fPOKéMON lendários\n--SUICUNE, ENTEI\fe RAIKOU.\fEUSINE está aqui,\nentão decidi\finvestigar a\nTOWER com ele.",
  ["TEXT_BURNED_TOWER_B1_F_OBJ_009"] = "EUSINA: Yo también.\nCavé un hoyo aquí… ¡Me sorprendió!\fSUICUNE pasó\n¡Como una mancha, justo frente a mis ojos!\fDurante diez años yo\npersiguió a SUICUNE, y finalmente\nLogré verlo.\f¡Estoy emocionado!\f {PLAYER}, debo\ntodo esto para ti!\f¡Gracias!\fescuché que el\nPOKEMON legendario de ECRUTEAK\nprobar a los humanos permitiéndoles\nenfoque.\fvoy tras\nSUICUNE.\f {PLAYER}, arriba\n¡un día más!\f¡Adiós!",
  ["TEXT_CELADON_CAFE_BG_001"] = "{PLAYER} achou\n{RAM:D099}!",
  ["TEXT_CELADON_CAFE_BG_002"] = "{PLAYER} achou\n{RAM:D099}!",
  ["TEXT_CELADON_CAFE_OBJ_001"] = "¡Ey!\festamos haciendo\nun concurso de comida. No\npodemos acomodar.",
  ["TEXT_CELADON_CAFE_OBJ_002"] = "…Nhac, nhac…",
  ["TEXT_CELADON_CAFE_OBJ_003"] = "quiero cantidad\n¡antes que la calidad! me quedo\nfeliz cuando como",
  ["TEXT_CELADON_CAFE_OBJ_004"] = "Nhac, nhac…",
  ["TEXT_CELADON_CAFE_OBJ_005"] = "Nhac… nhac…",
  ["TEXT_CELADON_CITY_OBJ_001"] = "Este POLIIRA es\nmi compañero.\falgún día\nEvoluciona a POKéMON rana.",
  ["TEXT_CELADON_CITY_OBJ_003"] = "lo perdí de nuevo\nmáquina tragamonedas… Ahora las chicas\ntambién jugar.\fdeberías dar\nuna mirada.",
  ["TEXT_CELADON_CITY_OBJ_004"] = "Grimer tiene\napareció mucho.\fVi el lago en\nfrente a la casa?\fGrimer vive allí.\nahora.\f¿De dónde vinieron?\nEste es un problema grave…",
  ["TEXT_CELADON_CITY_OBJ_005"] = "¡Nihihi! esto\n¡El GIMNASIO es genial!\fSólo entra chica\n¡aquí!",
  ["TEXT_CELADON_CITY_OBJ_006"] = "Quer saber um\nsegredo?\fA CELADON MANSION\ntem uma porta\vsecreta.",
  ["TEXT_CELADON_CITY_OBJ_007"] = "esta pasando algo\nConcurso de comida en restaurante.\fsolo verlos\ncomiendo, ya me siento hinchada…",
  ["TEXT_CELADON_CITY_OBJ_008"] = "DEPARTAMENTO DE CELADÓN.\nTIENDA tiene la mayor y mejor selección.\nde bienes.\fSi no encuentras\nAhí no lo encuentras por ningún lado.\nVaya... parezco un vendedor.\ntienda.",
  ["TEXT_CELADON_CITY_OBJ_009"] = "De olhar pro chão\nenquanto\fandava, fiquei\ntonto.",
  ["TEXT_CELADON_DEPT_STORE1_F_BG_002"] = "....................Bem-vindo ├á LOJA\nDE DEPARTAMENTOS\vCELADON!\fO índice está\nna parede.",
  ["TEXT_CELADON_DEPT_STORE1_F_OBJ_001"] = "Bem-vindo ├á LOJA\nDE DEPARTAMENTOS\vCELADON!\fO índice está\nna parede.",
  ["TEXT_CELADON_DEPT_STORE1_F_OBJ_002"] = "Esta TIENDA es de\nmisma red que GOLDENROD.\nAmbos fueron renovados en el\nal mismo tiempo, juntos.",
  ["TEXT_CELADON_DEPT_STORE1_F_OBJ_003"] = "├ë mi primera\ntiempo aquí.\f├ë tan grande… tengo miedo de\nperder.",
  ["TEXT_CELADON_DEPT_STORE2_F_BG_002"] = "....................me convertí\nentrenador animado por\nmi hijo.\festoy impresionado\ncon la selección de artículos prácticos.",
  ["TEXT_CELADON_DEPT_STORE2_F_OBJ_001"] = "me convertí\nentrenador animado por\nmi hijo.\festoy impresionado\ncon la selección de artículos prácticos.",
  ["TEXT_CELADON_DEPT_STORE2_F_OBJ_002"] = "me convertí\nentrenador animado por\nmi hijo.\festoy impresionado\ncon la selección de artículos prácticos.",
  ["TEXT_CELADON_DEPT_STORE2_F_OBJ_003"] = "me convertí\nentrenador animado por\nmi hijo.\festoy impresionado\ncon la selección de artículos prácticos.",
  ["TEXT_CELADON_DEPT_STORE2_F_OBJ_004"] = "mi padre esta teniendo\ntrabajar para memorizar los nombres\nde los artículos y cómo deben ser\nusado...",
  ["TEXT_CELADON_DEPT_STORE3_F_BG_001"] = "{RIVAL} F\nno puedo\ndecide en qué POKéMON usar esto\nMT…",
  ["TEXT_CELADON_DEPT_STORE3_F_OBJ_001"] = "no puedo\ndecide en qué POKéMON usar esto\nMT…",
  ["TEXT_CELADON_DEPT_STORE3_F_OBJ_002"] = "no puedo\ndecide en qué POKéMON usar esto\nMT…",
  ["TEXT_CELADON_DEPT_STORE3_F_OBJ_003"] = "Opa! Negociei meu\nPOKéMON sem tirar\fo UPGRADE que o\nPOKéMON tinha.",
  ["TEXT_CELADON_DEPT_STORE3_F_OBJ_004"] = "Enfim consegui um\nPORYGON!\fSou péssimo nas\nmáquinas, nunca\fjuntaria moedas\npara trocar…\f…Hã?\fO PORYGON trocado\nvirou outro\vPOKéMON!",
  ["TEXT_CELADON_DEPT_STORE3_F_OBJ_005"] = "TM TIENDA vende\nmovimientos raros.",
  ["TEXT_CELADON_DEPT_STORE4_F_OBJ_001"] = "vine a comprar uno\nCORREO DE SURF a mi novia.",
  ["TEXT_CELADON_DEPT_STORE4_F_OBJ_002"] = "vine a comprar uno\nCORREO DE SURF a mi novia.",
  ["TEXT_CELADON_DEPT_STORE4_F_OBJ_003"] = "Este es el único\nlugar donde compras un ENCANTADOR\nCORREO.",
  ["TEXT_CELADON_DEPT_STORE5_F_BG_002"] = ".................Quiero comprar\nelementos que elevan el estatus de la\nPOKéMON, pero no tengo dinero...",
  ["TEXT_CELADON_DEPT_STORE5_F_OBJ_001"] = "quiero comprar\nelementos que elevan el estatus de la\nPOKéMON, pero no tengo dinero...",
  ["TEXT_CELADON_DEPT_STORE5_F_OBJ_002"] = "quiero comprar\nelementos que elevan el estatus de la\nPOKéMON, pero no tengo dinero...",
  ["TEXT_CELADON_DEPT_STORE5_F_OBJ_003"] = "quiero comprar\nelementos que elevan el estatus de la\nPOKéMON, pero no tengo dinero...",
  ["TEXT_CELADON_DEPT_STORE5_F_OBJ_004"] = "quiero un PP UP,\naumentar el PP de los golpes, pero\nno puedo comprar",
  ["TEXT_CELADON_DEPT_STORE5_F_OBJ_005"] = "Usar itens neles\ndeixa o POKéMON\vfeliz.\fEles odeiam alguns\nitens, porém…",
  ["TEXT_CELADON_DEPT_STORE6_F_BG_002"] = "....................Bem-vindo ├á LOJA\nDE DEPARTAMENTOS\vCELADON!\fO índice está\nna parede.",
  ["TEXT_CELADON_DEPT_STORE6_F_BG_003"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_CELADON_DEPT_STORE6_F_BG_004"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_CELADON_DEPT_STORE6_F_BG_005"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_CELADON_DEPT_STORE6_F_BG_006"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_CELADON_DEPT_STORE6_F_OBJ_001"] = "una maquina\nventas con ruleta de premios… Ya no lo ves\ncomo estos hoy.",
  ["TEXT_CELADON_DEPT_STORE6_F_OBJ_002"] = "¡Ah! no hay juegos\n¡aquí!\fquería jugar...",
  ["TEXT_CELADON_GAME_CORNER_BG_001"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_002"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_003"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_004"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_005"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_006"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_007"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_008"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_009"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_010"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_011"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_012"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_017"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_BG_033"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_CELADON_GAME_CORNER_OBJ_002"] = "¡Bienvenido!\fpuedes intercambiar\ntus monedas para premios increíbles\nen la casa de al lado.",
  ["TEXT_CELADON_GAME_CORNER_OBJ_003"] = "As caça-níqueis\nsão todas de\vúltima geração.",
  ["TEXT_CELADON_GAME_CORNER_OBJ_004"] = "├ë esta máquina\nque quiero.\fella me limpió\nayer, entonces deberías pagar\nhoy.",
  ["TEXT_CELADON_GAME_CORNER_OBJ_005"] = "Acho que esta\nmáquina vai pagar\vagora…\fAs chances variam\nentre máquinas.",
  ["TEXT_CELADON_GAME_CORNER_OBJ_006"] = "¡Jajajaja!\fLas monedas no\ndeja de irte!\f¿Hay? quiero jugar,\nchico?\fyo compartiré el mio\nsuerte contigo!",
  ["TEXT_CELADON_GAME_CORNER_OBJ_007"] = "¡Jajajaja!\fLas monedas no\ndeja de irte!\f¿Hay? quiero jugar,\nchico?\fyo compartiré el mio\nsuerte contigo!",
  ["TEXT_CELADON_GAME_CORNER_OBJ_008"] = "¡Ey! Futuro\n¡CAMPEÓN!\fTambién juega en\nmáquinas tragamonedas?\flo estoy intentando\nRecoge monedas para conseguir un premio POKéMON. pero\nAún no lo tengo...",
  ["TEXT_CELADON_GAME_CORNER_OBJ_009"] = "Hmm… As chances\nsão melhores na\ffila do PIKACHU,\n…o que fazer?",
  ["TEXT_CELADON_GAME_CORNER_PRIZE_ROOM_BG_001"] = "Bem-vindo!\fTrocamos suas\nmoedas por\vprêmios incríveis",
  ["TEXT_CELADON_GAME_CORNER_PRIZE_ROOM_BG_002"] = "Bem-vindo!\fTrocamos suas\nmoedas por\vprêmios incríveis",
  ["TEXT_CELADON_GAME_CORNER_PRIZE_ROOM_OBJ_001"] = "Queria um MR.MIME\nmas me faltaram\v100 moedas…",
  ["TEXT_CELADON_GAME_CORNER_PRIZE_ROOM_OBJ_002"] = "Uf... necesito quedarme\ntranquilo y frio... no puedo perder\nCálmate o pierdo el dinero...",
  ["TEXT_CELADON_GYM_OBJ_001"] = "ERIKA: Hola...\nQue lindo momento, ¿eh?\n├ë tan tranquilo... puedo incluso\nsiesta… Mi nombre es ERIKA.\nSoy el LÍDER de GINÁSIO CELADON.\f…¿Oh? tu viniste\nde JOHTO?\vBien... Ah. Lo siento, no\nMe di cuenta de que me querías\ndesafío.\fMuy bueno, pero\nNo perderé.",
  ["TEXT_CELADON_GYM_OBJ_002"] = "acabo de ir\ndescuidado, eso es todo!",
  ["TEXT_CELADON_GYM_OBJ_002_AFTER"] = "acabo de ir\ndescuidado, eso es todo!",
  ["TEXT_CELADON_GYM_OBJ_002_BEATEN"] = "Ah, que nojo!",
  ["TEXT_CELADON_GYM_OBJ_002_SEEN"] = "¿Crees que un\n¿Es raro un GIMNASIO para niñas?",
  ["TEXT_CELADON_GYM_OBJ_003"] = "mira todo\nsus INSIGNIAS.\fNo es de extrañar que\n¡No gané!",
  ["TEXT_CELADON_GYM_OBJ_003_AFTER"] = "mira todo\nsus INSIGNIAS.\fNo es de extrañar que\n¡No gané!",
  ["TEXT_CELADON_GYM_OBJ_003_BEATEN"] = "Ah, ¿eso es todo?",
  ["TEXT_CELADON_GYM_OBJ_003_SEEN"] = "Oh, uma batalha?\nQue assustador,\vmas tudo bem!",
  ["TEXT_CELADON_GYM_OBJ_004"] = "Como faço para\nficar elegante\vcomo a ERIKA?",
  ["TEXT_CELADON_GYM_OBJ_004_AFTER"] = "Como faço para\nficar elegante\vcomo a ERIKA?",
  ["TEXT_CELADON_GYM_OBJ_004_BEATEN"] = "Que droga!",
  ["TEXT_CELADON_GYM_OBJ_004_SEEN"] = "tu eras\n¿mirando las flores o a mí?",
  ["TEXT_CELADON_GYM_OBJ_005"] = "ERIKA vai se\nvingar por nós!",
  ["TEXT_CELADON_GYM_OBJ_005_AFTER"] = "ERIKA vai se\nvingar por nós!",
  ["TEXT_CELADON_GYM_OBJ_005_SEEN"] = "Vamos mostrar\ngolpes que ERIKA\vnos ensinou!",
  ["TEXT_CELADON_GYM_OBJ_006"] = "ERIKA es muy,\n¡mucho más fuerte!",
  ["TEXT_CELADON_GYM_OBJ_006_AFTER"] = "ERIKA es muy,\n¡mucho más fuerte!",
  ["TEXT_CELADON_GYM_OBJ_006_BEATEN"] = "No pudimos…",
  ["TEXT_CELADON_GYM_OBJ_006_SEEN"] = "Nós vamos proteger\na ERIKA!",
  ["TEXT_CELADON_MANSION1_F_BG_001"] = "{RIVAL} lPOKé..Queridos\nPOKéMON me hace compañía, así que nunca\nMe siento solo.\fMEOWTH incluso trae\ndinero a casa.",
  ["TEXT_CELADON_MANSION1_F_BG_002"] = "..Mi POKéMON yo\nHazme compañía, nunca siento\nsolo.\fHasta maullido\ntrae dinero.",
  ["TEXT_CELADON_MANSION1_F_BG_003"] = "..Mi POKéMON yo\nHazme compañía, nunca siento\nsolo.\fHasta maullido\ntrae dinero.",
  ["TEXT_CELADON_MANSION1_F_OBJ_001"] = "Mi POKéMON yo\nHazme compañía, nunca siento\nsolo.\fHasta maullido\ntrae dinero.",
  ["TEXT_CELADON_MANSION2_F_BG_001"] = "{PLAYER} encendió el\nordenador personal.\f… Alguien estaba en el\nforma de escribir un correo electrónico.\f…espero\nvisita KANTO.\fte sorprenderas\ncon tantas cosas, tantas cosas\ncambiado aquí.\fTambién verás\nvarios POKéMON que no existen\nen JOHTO.\fAl PRODUCTOR…",
  ["TEXT_CELADON_MANSION2_F_BG_002"] = "GAME FREAK\nSALA DE ENCONTROS",
  ["TEXT_CELADON_MANSION2_F_BG_003"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_CELADON_MANSION3_F_BG_001"] = "ZXQ PLACEHOLDER0QXZ {TARGET} ├¿En serio?\fsoy JUEGO\nDISEÑADOR!\fLlena el POKéDEX\n¡Es difícil, pero no te rindas!",
  ["TEXT_CELADON_MANSION3_F_BG_003"] = "{RIVAL} {PLAYER} {TARGET} {RIVAL} W {TARGET} ¡Así es!\fSOY EL DISEÑADOR\ndel JUEGO!\fCompleta tu\nPOKéDEX es difícil, ¡pero no te rindas!",
  ["TEXT_CELADON_MANSION3_F_BG_004"] = "{RIVAL} W {TARGET} ¡Así es!\fSOY EL DISEÑADOR\ndel JUEGO!\fCompleta tu\nPOKéDEX es difícil, ¡pero no te rindas!",
  ["TEXT_CELADON_MANSION3_F_OBJ_001"] = "¡Así es!\fSOY EL DISEÑADOR\ndel JUEGO!\fCompleta tu\nPOKéDEX es difícil, ¡pero no te rindas!",
  ["TEXT_CELADON_MANSION3_F_OBJ_002"] = "Sou o ARTISTA\nGRÁFICO.\fEu te desenhei!",
  ["TEXT_CELADON_MANSION3_F_OBJ_003"] = "Quem, eu? Sou o\nPROGRAMADOR.\fJogue nas máquinas\ncaça-níqueis!",
  ["TEXT_CELADON_MANSION3_F_OBJ_004"] = "As G├èMEAS são\nadoráveis!\fJASMINE também\né bonita.\fAh, eu as adoro!",
  ["TEXT_CELADON_MANSION_ROOF_BG_001"] = "{RIVAL}b{USER}Lugares altos--eu\nadoro eles!\fAcho que a única\ncoisa que ama\faltura tanto\nquanto eu\vé a fumaça!",
  ["TEXT_CELADON_MANSION_ROOF_HOUSE_OBJ_001"] = "Deixe-me contar\nalgo terrível…",
  ["TEXT_CELADON_POKECENTER1_F_OBJ_001"] = "Bom dia!\nBem-vindo ao nosso\vCENTRO POKéMON.",
  ["TEXT_CELADON_POKECENTER1_F_OBJ_002"] = "¡Guau! tu y tu\n¡Los POKéMON están muy unidos!",
  ["TEXT_CELADON_POKECENTER1_F_OBJ_003"] = "el escondite\nde EQUIPE ROCKET está en el sótano de\nCASA DE JUEGO.\fAh, espera. esto\nFue hace tres años.",
  ["TEXT_CELADON_POKECENTER1_F_OBJ_004"] = "ERIKA es una maestra en\nPOKéMON tipo Planta. ella lo hará\nhacerte pagar si te equivocas.",
  ["TEXT_CELADON_POKECENTER1_F_OBJ_005"] = "EUSINE: Oi!\fEstou de volta\nvisitando minha\vcidade natal.\fFaz um bom tempo.",
  ["TEXT_CERULEAN_CITY_OBJ_001"] = "A USINA de KANTO\nfica perto do fim\fda ROTA 9.\nHouve um acidente\fde algum tipo\npor lá.",
  ["TEXT_CERULEAN_CITY_OBJ_002"] = "EL CABO al norte\nEs un buen lugar para reuniones.\n¡A las chicas les gusta!",
  ["TEXT_CERULEAN_CITY_OBJ_004"] = "Yo y mi SLOWBRO\n¡Hacemos un dúo increíble!",
  ["TEXT_CERULEAN_CITY_OBJ_005"] = "Sou fã da\nMISTY do GINÁSIO\vde CERULEAN.",
  ["TEXT_CERULEAN_CITY_OBJ_006"] = "Aqui havia uma\ncaverna\fcom POKéMON\nhorríveis e\vfortes.",
  ["TEXT_CERULEAN_GYM_BG_002"] = "Desculpe, saí\npor um tempo.\vMISTY, GYM LEADER",
  ["TEXT_CERULEAN_GYM_BG_003"] = "Como a MISTY saiu,\nnós também.\vGYM TRAINERS",
  ["TEXT_CERULEAN_GYM_OBJ_002"] = "MISTY: ¡Te estaba\nesperando, pelma!\vPuedes tener muchas\nMEDALLAS de JOHTO,\npero no me vencerás\nfácilmente.\v¡Mis POKéMON de\nagua son\nmuy fuertes!",
  ["TEXT_CERULEAN_GYM_OBJ_003"] = "Estaré nadando\ntranquilamente.",
  ["TEXT_CERULEAN_GYM_OBJ_003_AFTER"] = "Estaré nadando\ntranquilamente.",
  ["TEXT_CERULEAN_GYM_OBJ_003_BEATEN"] = "¡Me rindo! ¡Has\nganado!",
  ["TEXT_CERULEAN_GYM_OBJ_003_SEEN"] = "Perdona mi ausencia…\v¡Sigamos!",
  ["TEXT_CERULEAN_GYM_OBJ_004"] = "No te confíes tanto\vpor haber ganado.\fMISTY te derrotará\nsi te descuidas.",
  ["TEXT_CERULEAN_GYM_OBJ_004_AFTER"] = "No te confíes tanto\vpor haber ganado.\fMISTY te derrotará\nsi te descuidas.",
  ["TEXT_CERULEAN_GYM_OBJ_004_BEATEN"] = "Oh, me has\nvencido tranquilamente…",
  ["TEXT_CERULEAN_GYM_OBJ_004_SEEN"] = "No dejes que mi\nelegante natación\vte intimide.",
  ["TEXT_CERULEAN_GYM_OBJ_005"] = "MISTY ha mejorado\nmucho estos últimos\vaños.\f¡No bajes la\nguardia o te\vaplastará!",
  ["TEXT_CERULEAN_GYM_OBJ_005_AFTER"] = "MISTY ha mejorado\nmucho estos últimos\vaños.\f¡No bajes la\nguardia o te\vaplastará!",
  ["TEXT_CERULEAN_GYM_OBJ_005_SEEN"] = "Glub…\f¡Soy el primero!\n¡Ven a por mí!",
  ["TEXT_CERULEAN_GYM_OBJ_006"] = "¡Eh, futuro\nCAMPEÓN!\fComo MISTY se ha\nido, ¡yo también\nvoy a divertirme!\fJe, je, je.",
  ["TEXT_CERULEAN_MART_OBJ_001"] = "veras\nmuchos por ahí en el camino a CAPE\npor CERÚLEO.\fellos quieren ver\n¿Cómo les va frente a los demás?\nentrenadores.",
  ["TEXT_CERULEAN_MART_OBJ_002"] = "veras\nmuchos por ahí en el camino a CAPE\npor CERÚLEO.\fellos quieren ver\n¿Cómo les va frente a los demás?\nentrenadores.",
  ["TEXT_CERULEAN_POKECENTER1_F_OBJ_001"] = "Para luchar,\nPrefiero usar POKéMON que creé, incluso si son\nMás débil que un POKEMON\nrecién capturado.",
  ["TEXT_CERULEAN_POKECENTER1_F_OBJ_002"] = "Para luchar,\nPrefiero usar POKéMON que creé, incluso si son\nMás débil que un POKEMON\nrecién capturado.",
  ["TEXT_CERULEAN_POKECENTER1_F_OBJ_003"] = "9 {BYTE:42} A la batalla,\nPrefiero usar POKéMON que creé, incluso si son\nMás débil que un POKEMON\nrecién capturado.",
  ["TEXT_CERULEAN_POLICE_STATION_OBJ_001"] = "escuché ese\nUn tipo extraño anda por ahí.\fno lo toleraré\nsi termina siendo un ladrón.",
  ["TEXT_CERULEAN_POLICE_STATION_OBJ_002"] = "ya hemos sido victimas\nde ladrones.",
  ["TEXT_CERULEAN_TRADE_SPEECH_HOUSE_OBJ_001"] = "mi marido vive\ncontento con los POKéMON que consiguió en los intercambios.",
  ["TEXT_CHARCOAL_KILN_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_CHARCOAL_KILN_BG_002"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_CHARCOAL_KILN_BG_003"] = "............Todos os SLOWPOKE\nsumiram\vda cidade.\fO protetor da\nfloresta pode\vestar bravo…\fPode ser mau\nagouro. ├ë melhor\vficar em casa.",
  ["TEXT_CHARCOAL_KILN_OBJ_001"] = "Todos os SLOWPOKE\nsumiram\vda cidade.\fO protetor da\nfloresta pode\vestar bravo…\fPode ser mau\nagouro. ├ë melhor\vficar em casa.",
  ["TEXT_CHARCOAL_KILN_OBJ_002"] = "¿A dónde fueron?\nel LENTO?\festan bromeando\nen alguna parte?",
  ["TEXT_CHARCOAL_KILN_OBJ_003"] = "FARFETCH'D: Kwaa!",
  ["TEXT_CHERRYGROVE_CITY_OBJ_001"] = "eres un\nnuevo entrenador, ¿verdad? ¡Se puede ver!\f¡Todo está bien! Todos\n¡El mundo alguna vez fue un principiante!\fsi quieres puedo\nenseñarte algunas cosas.",
  ["TEXT_CHERRYGROVE_CITY_OBJ_003"] = "¿Hablaste con el\n¿Viejo cerca del CENTRO POKéMON?\fPone un MAPA de\nJOHTO en tu POKéGEAR.",
  ["TEXT_CHERRYGROVE_CITY_OBJ_004"] = "A casa do\nMR.POKéMON fica\vmais adiante.",
  ["TEXT_CHERRYGROVE_CITY_OBJ_005"] = "Un pokémon que\nRecibí un artículo.\fcreo que es\nAGUA MÍSTICA.\fNo lo necesito,\n¿Quieres quedarte?",
  ["TEXT_CHERRYGROVE_EVOLUTION_SPEECH_HOUSE_BG_001"] = "...POKéMON ganha\nexperiência em\fbatalha e muda\nde forma.",
  ["TEXT_CHERRYGROVE_EVOLUTION_SPEECH_HOUSE_BG_002"] = "...POKéMON ganha\nexperiência em\fbatalha e muda\nde forma.",
  ["TEXT_CHERRYGROVE_EVOLUTION_SPEECH_HOUSE_OBJ_001"] = "POKéMON muda?\fEu ia levar um\nsusto se mudasse!",
  ["TEXT_CHERRYGROVE_EVOLUTION_SPEECH_HOUSE_OBJ_002"] = "POKéMON ganha\nexperiência em\fbatalha e muda\nde forma.",
  ["TEXT_CHERRYGROVE_GYM_SPEECH_HOUSE_OBJ_001"] = "¿Quieres ver el\nque bueno es como entrenador\nde POKEMON?\f├ë mejor visita\nlos GIMNASIOS por todo JOHTO y\nañadir INSIGNIAS.",
  ["TEXT_CHERRYGROVE_GYM_SPEECH_HOUSE_OBJ_002"] = "Cuando sea mayor,\n¡Voy a ser LÍDER DE GIMNASIO!\fle puse mi POKéMON\npelear con su amigo y\nponlos duros.",
  ["TEXT_CHERRYGROVE_MART_OBJ_001"] = "Acabaram as\nPOKé BALLS!\fQuando será que\nchegam mais?",
  ["TEXT_CHERRYGROVE_MART_OBJ_002"] = "Acabaram as\nPOKé BALLS!\fQuando será que\nchegam mais?",
  ["TEXT_CHERRYGROVE_POKECENTER1_F_OBJ_001"] = "├ë ótimo. Posso\nguardar quantos\fPOKéMON eu quiser,\ne é tudo de graça.",
  ["TEXT_CHERRYGROVE_POKECENTER1_F_OBJ_002"] = "├ë ótimo. Posso\nguardar quantos\fPOKéMON eu quiser,\ne é tudo de graça.",
  ["TEXT_CHERRYGROVE_POKECENTER1_F_OBJ_003"] = "Aquele PC é livre\npara qualquer\vtreinador usar.",
  ["TEXT_CHERRYGROVE_POKECENTER1_F_OBJ_004"] = "EL CENTRO DE\nCOMUNICACIÓN Es nuevo ahí arriba.\fPero todavía están\nacabar con él.",
  ["TEXT_CIANWOOD_CITY_OBJ_001"] = "Se usar o FLY,\ndá para voltar\fpara OLIVINE na\nhora.",
  ["TEXT_CIANWOOD_CITY_OBJ_002"] = "As pedras ao norte\nda cidade podem\vser quebradas.\fElas podem estar\nescondendo algo.\fSeu POKéMON pode\nusar ROCK SMASH\vpara quebrar.",
  ["TEXT_CIANWOOD_CITY_OBJ_003"] = "O CHUCK, LÍDER do\nGINÁSIO, treina\fcom os POKéMON\nlutadores dele.",
  ["TEXT_CIANWOOD_CITY_OBJ_010"] = "Cruzaste el\nmar para llegar?\fdebe haber sido\nbastante difícil.\fseria mucho mas\nfácil si tu POKéMON lo supiera\nusa VOLAR...",
  ["TEXT_CIANWOOD_GYM_OBJ_001"] = "¡UAHAHAAH!\fEntonces llegaste\n¡nos vemos aquí!\fTe lo advierto:\n¡Soy duro!\fMi POKéMON\n¡Aplasta rocas y rompe huesos!\f¡Solo mira esto!",
  ["TEXT_CIANWOOD_GYM_OBJ_002"] = "parece que tienes\n¡Un fuerte vínculo con tu POKéMON!",
  ["TEXT_CIANWOOD_GYM_OBJ_002_AFTER"] = "parece que tienes\n¡Un fuerte vínculo con tu POKéMON!",
  ["TEXT_CIANWOOD_GYM_OBJ_002_BEATEN"] = "¡Esto no es real!",
  ["TEXT_CIANWOOD_GYM_OBJ_002_SEEN"] = "Mi POKéMON y yo\nNos une la amistad.\fNuestro vínculo\n¡nunca se rompe!",
  ["TEXT_CIANWOOD_GYM_OBJ_003"] = "POKéMON de luta\ntemem os\vpsíquicos…",
  ["TEXT_CIANWOOD_GYM_OBJ_003_AFTER"] = "POKéMON de luta\ntemem os\vpsíquicos…",
  ["TEXT_CIANWOOD_GYM_OBJ_003_BEATEN"] = "¡Esto es impactante!",
  ["TEXT_CIANWOOD_GYM_OBJ_003_SEEN"] = "Nada tememos,\nnós, lutadores!",
  ["TEXT_CIANWOOD_GYM_OBJ_004"] = "Perdi! Estou\nsem palavras!",
  ["TEXT_CIANWOOD_GYM_OBJ_004_AFTER"] = "Perdi! Estou\nsem palavras!",
  ["TEXT_CIANWOOD_GYM_OBJ_004_SEEN"] = "Palavras são\ninúteis. Deixe\vos punhos falar!",
  ["TEXT_CIANWOOD_GYM_OBJ_005"] = "mi pokemon\nperdido... Mi orgullo está roto...",
  ["TEXT_CIANWOOD_GYM_OBJ_005_AFTER"] = "mi pokemon\nperdido... Mi orgullo está roto...",
  ["TEXT_CIANWOOD_GYM_OBJ_005_BEATEN"] = "Fui despedaçado!",
  ["TEXT_CIANWOOD_GYM_OBJ_005_SEEN"] = "mis puños furiosos\n¡destroza tu POKéMON!",
  ["TEXT_CIANWOOD_LUGIA_SPEECH_HOUSE_BG_001"] = "..vienes de\n¿OLIVINO?\frecuerda los cuatro\nislas que están en el camino?\fescuché eso\nAllí se esconde una criatura marina mítica.",
  ["TEXT_CIANWOOD_LUGIA_SPEECH_HOUSE_BG_002"] = "..vienes de\n¿OLIVINO?\frecuerda los cuatro\nislas que están en el camino?\fescuché eso\nAllí se esconde una criatura marina mítica.",
  ["TEXT_CIANWOOD_LUGIA_SPEECH_HOUSE_OBJ_001"] = "tu viniste de\n¿OLIVINO?\frecuerda los cuatro\nislas que están en el camino?\fescuché eso\nAllí se esconde una criatura marina mítica.",
  ["TEXT_CIANWOOD_LUGIA_SPEECH_HOUSE_OBJ_002"] = "solo escuché eso\npuedes verlo si tienes uno\nALA DE PLATA.\fElla debe tener el\nEl mismo olor que la criatura.",
  ["TEXT_CIANWOOD_LUGIA_SPEECH_HOUSE_OBJ_003"] = "Os redemoinhos\nperto das ilhas\fdevem ser causados\npela criatura.",
  ["TEXT_CIANWOOD_PHARMACY_BG_001"] = ".Tu POKEMON\nse ven bien.\fhay algo\n¿te preocupa?\f… EL POKEMON de\n¿Está LEUCHTTURM en problemas?\f¡Ya lo sé!\fEsto debería\nresolver.",
  ["TEXT_CIANWOOD_PHARMACY_BG_002"] = ".Tu POKEMON\nse ven bien.\fhay algo\n¿te preocupa?\f… EL POKEMON de\n¿Está LEUCHTTURM en problemas?\f¡Ya lo sé!\fEsto debería\nresolver.",
  ["TEXT_CIANWOOD_PHARMACY_OBJ_001"] = "Tu POKEMON\nse ven bien.\fhay algo\n¿te preocupa?\f… EL POKEMON de\n¿Está LEUCHTTURM en problemas?\f¡Ya lo sé!\fEsto debería\nresolver.",
  ["TEXT_CIANWOOD_PHOTO_STUDIO_OBJ_001"] = "tienes algunos\nMagnífico POKéMON.\f¿Qué tal una foto?\nrecuerdo?",
  ["TEXT_CIANWOOD_POKECENTER1_F_OBJ_001"] = "¿Sabías que\n¿POKEMANÍACO?\fel vive si\nalardeando de su raro POKéMON.",
  ["TEXT_CIANWOOD_POKECENTER1_F_OBJ_002"] = "¿Sabías que\n¿POKEMANÍACO?\fel vive si\nalardeando de su raro POKéMON.",
  ["TEXT_CIANWOOD_POKECENTER1_F_OBJ_003"] = "Os treinadores do\nGINÁSIO daqui são\vuns brutamontes.\fSe eu ficar aqui,\neles podem vir\vpara cima de mim.\fVai uma dica: o\nLÍDER do\fGINÁSIO usa o\ntipo lutador.\fEntão confunda\nele com POKéMON\vpsíquicos.\fAcabe com eles\nantes que usem\fa força\nfísica deles.",
  ["TEXT_CINNABAR_ISLAND_OBJ_001"] = "¿Quién eres?\fBueno, es obvio\nque eres entrenador… Mi nombre es AZUL.\fUna vez fui el\nCAMPEÓN, aunque fue por\npoco tiempo… ese ROJO\nvencerme... De todos modos, ¿qué\nquieres? ¿Quieres desafiarme o\n¿qué?\f...odio decir,\nPero no tengo ganas de pelear\nahora.\fmira tu\nalrededor… Entra un volcán\nestallando, y de repente, un\nla ciudad desaparece.\fpodemos ganar\ny perder en peleas POKéMON. pero\nsi la naturaleza se mueve, morimos\nen un segundo.\f… ├ë tan pronto como\nlas cosas están... Pero de todos modos, todavía\nSoy entrenador.\fsi veo uno\nBuen oponente, me dan ganas de pelear.\nSi quieres, acércate al VIRIDIAN GYM. voy a ir a ti\ncara.",
  ["TEXT_CINNABAR_POKECENTER1_F_OBJ_001"] = "O BLAINE, do\nCINNABAR GYM,\fparece morar\nsozinho na caverna\fdas SEAFOAM\nISLANDS…",
  ["TEXT_CINNABAR_POKECENTER1_F_OBJ_002"] = "O BLAINE, do\nCINNABAR GYM,\fparece morar\nsozinho na caverna\fdas SEAFOAM\nISLANDS…",
  ["TEXT_COLOSSEUM_BG_001"] = "O seu amigo\nestá pronto.",
  ["TEXT_COLOSSEUM_BG_002"] = "O seu amigo\nestá pronto.",
  ["TEXT_COLOSSEUM_OBJ_001"] = "O seu amigo\nestá pronto.",
  ["TEXT_COLOSSEUM_OBJ_002"] = "O seu amigo\nestá pronto.",
  ["TEXT_COPYCATS_HOUSE1_F_OBJ_001"] = "a mi hija le gusta\nimitar a la gente.\fLa imitación dio\nsu apodo es COPYCAT\naquí en la región.",
  ["TEXT_COPYCATS_HOUSE1_F_OBJ_002"] = "mi hija es tan\ncentrado en ella... Ella sólo tiene unos pocos\npocos amigos.",
  ["TEXT_DANCE_THEATER_OBJ_001"] = "Eu gostei do\nduelo. Queria\vte ver de novo.",
  ["TEXT_DANCE_THEATER_OBJ_001_AFTER"] = "Eu gostei do\nduelo. Queria\vte ver de novo.",
  ["TEXT_DANCE_THEATER_OBJ_001_BEATEN"] = "Oh, eres muy\nfuerte.",
  ["TEXT_DANCE_THEATER_OBJ_001_SEEN"] = "Seus POKéMON são\nlindos. Posso\vver numa batalha?",
  ["TEXT_DANCE_THEATER_OBJ_002"] = "O ritmo é\nimportante para\fdançar e para\nPOKéMON.",
  ["TEXT_DANCE_THEATER_OBJ_002_AFTER"] = "O ritmo é\nimportante para\fdançar e para\nPOKéMON.",
  ["TEXT_DANCE_THEATER_OBJ_002_BEATEN"] = "Oh, tão perto!\nQuase te peguei!",
  ["TEXT_DANCE_THEATER_OBJ_002_SEEN"] = "yo siempre bailo\ncon mi POKéMON.\fPor supuesto yo también\nYo los entreno.",
  ["TEXT_DANCE_THEATER_OBJ_003"] = "Coloco uma flor\ndiferente no\vgrampo todo mês.",
  ["TEXT_DANCE_THEATER_OBJ_003_AFTER"] = "Coloco uma flor\ndiferente no\vgrampo todo mês.",
  ["TEXT_DANCE_THEATER_OBJ_003_BEATEN"] = "no tengo mas\nPOKÉMON…",
  ["TEXT_DANCE_THEATER_OBJ_003_SEEN"] = "mi clip es\nhermosa ¿no?\fOh. una batalla\nde POKEMON?",
  ["TEXT_DANCE_THEATER_OBJ_004"] = "Entrené mucho y\nPensé que era capaz de luchar. pero\nNo lo creo.",
  ["TEXT_DANCE_THEATER_OBJ_004_AFTER"] = "Entrené mucho y\nPensé que era capaz de luchar. pero\nNo lo creo.",
  ["TEXT_DANCE_THEATER_OBJ_004_BEATEN"] = "tu eres mas fuerte\nde lo que parece.",
  ["TEXT_DANCE_THEATER_OBJ_004_SEEN"] = "Oh, eres un\nlindo entrenador.\v¿Quieres luchar?",
  ["TEXT_DANCE_THEATER_OBJ_005"] = "sigo bailando\nporque hay gente a la que le gusta\nlo que hago.\fmi pokemon\nanimame.",
  ["TEXT_DANCE_THEATER_OBJ_005_AFTER"] = "sigo bailando\nporque hay gente a la que le gusta\nlo que hago.\fmi pokemon\nanimame.",
  ["TEXT_DANCE_THEATER_OBJ_005_BEATEN"] = "Oh, tu también\nEs bueno en POKEMON.",
  ["TEXT_DANCE_THEATER_OBJ_005_SEEN"] = "Gosta da minha\ndança? Também sou\vboa com POKéMON.",
  ["TEXT_DANCE_THEATER_OBJ_006"] = "No sólo el KIMONO\nLAS NIÑAS también son grandes bailarinas\nSon buenos en POKéMON.\fSiempre los desafío,\npero nunca dejé ni un rasguño.\nen ellos…",
  ["TEXT_DANCE_THEATER_OBJ_007"] = "RHYDON: Grogoh\ngrugrooh!",
  ["TEXT_DARK_CAVE_BLACKTHORN_ENTRANCE_OBJ_001"] = "¡Guau! tu yo\nasustado!\fyo estaba con\nGAFAS NEGRAS, entonces no\nTe noté.\f¿Qué soy yo?\nhaciendo aquí?\fOye, ¿no?\npreocuparse.\fte daré\na BLACKGLASSES, así que olvida que me viste, ¿vale?",
  ["TEXT_DARK_CAVE_VIOLET_ENTRANCE_OBJ_002"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_DARK_CAVE_VIOLET_ENTRANCE_OBJ_003"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_DARK_CAVE_VIOLET_ENTRANCE_OBJ_004"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_DARK_CAVE_VIOLET_ENTRANCE_OBJ_005"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_DAY_CARE_BG_001"] = ".El abuelo├┤ era\nbuscándote.",
  ["TEXT_DAY_CARE_BG_002"] = ".El abuelo├┤ era\nbuscándote.",
  ["TEXT_DAY_CARE_OBJ_001"] = "I am DAY-CARE\nHOMBRE.\f¿Sabes acerca de\nEGGS?\fYo creé POKEMON\ncon mi esposa, ya sabes.\fNos quedamos en shock\nal encontrar un HUEVO!\f¿No es asombroso?\nesto?\fBueno, no quieres\nthis EGG?\fSo, it's yours\npara mantener!",
  ["TEXT_DAY_CARE_OBJ_002"] = "El abuelo├┤ era\nbuscándote.",
  ["TEXT_DAY_OF_WEEK_SIBLINGS_HOUSE_OBJ_001"] = "Tem uma coisa\nescrita aqui.\fLer?",
  ["TEXT_DIGLETTS_CAVE_OBJ_001"] = "Montón de DIGLETT\nsaltó del suelo!\fEso fue\nimpactante!",
  ["TEXT_DRAGONS_DEN_B1_F_BG_001"] = "SANTUÁRIO DRAGÃO\fUm santuário em\nhonra aos POKéMON\fdragão que viveu\nno DRAGON'S DEN.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_001"] = "{PLAYER} achou\n{RAM:D099}!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_003"] = "…\n¿Qué?  ¿{PLAYER}?\f…No, no lo haré\nbatalla ahora… Mi POKéMON\nno están listos no puedo\nobligarlos ahora.\fnecesito ser\ndisciplinado para convertirse\nel mejor entrenador",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_004"] = "SANTUARIO allí está el\ncasa del MAESTRO de nuestra\nclan de dragones.\fno puedes\n¡entra así!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_004_AFTER"] = "SANTUARIO allí está el\ncasa del MAESTRO de nuestra\nclan de dragones.\fno puedes\n¡entra así!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_004_BEATEN"] = "Fo-forte!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_004_SEEN"] = "¡Tú! ¿Cómo te atreves?\n¡Entra sin invitación!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_005"] = "Pronto tendré\npermiso de nuestro MAESTRO\nusar arrastrar├Áes.\fcuando esto\npasa, voy a ser entrenador\nadmirable conjunto de dragones y gana el\naprobación de nuestro MAESTRO.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_005_AFTER"] = "Pronto tendré\npermiso de nuestro MAESTRO\nusar arrastrar├Áes.\fcuando esto\npasa, voy a ser entrenador\nadmirable conjunto de dragones y gana el\naprobación de nuestro MAESTRO.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_005_BEATEN"] = "Ai, eu perdi!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_005_SEEN"] = "no deberías\n¡esté aquí!",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_006"] = "fue como pelear\ncontra LANZA.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_006_AFTER"] = "fue como pelear\ncontra LANZA.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_006_BEATEN"] = "Ai, ai.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_006_SEEN"] = "├ë un extraño que\nno lo sabemos.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_007"] = "o en BIEN.\fMe gustó el tuyo\ncamino!\fseria un honor\nhacer BOLAS para un entrenador\ncomo tú.\f├ë todo lo que tengo\nAhora, pero tómalo.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_007_AFTER"] = "Vamos te\ndenunciar.\fO MESTRE vai\nficar bravo.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_007_BEATEN"] = "Que maldade.",
  ["TEXT_DRAGONS_DEN_B1_F_OBJ_007_SEEN"] = "¿Quién eres?",
  ["TEXT_DRAGON_SHRINE_OBJ_001"] = "Parece que CLAIR\naprendí una valiosa lección\ncontigo.\fGracias como abuelo├┤\nella.",
  ["TEXT_DRAGON_SHRINE_OBJ_002"] = "Ha pasado un tiempo desde\nningún entrenador ha ganado lo raro\naprobación de nuestro MAESTRO.\fEn realidad, no\ndesde Maestro LANCE.",
  ["TEXT_DRAGON_SHRINE_OBJ_003"] = "¿Conoces el\n¿Joven Maestro LANCE?\fel parece\nmucho con nuestro MAESTRO cuando era joven.\f├ë cosa\nfamilia.",
  ["TEXT_EARLS_POKEMON_ACADEMY_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_EARLS_POKEMON_ACADEMY_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_EARLS_POKEMON_ACADEMY_BG_003"] = "O quadro fala\nsobre mudanças\fde status em\nbatalha.",
  ["TEXT_EARLS_POKEMON_ACADEMY_BG_004"] = "O quadro fala\nsobre mudanças\fde status em\nbatalha.",
  ["TEXT_EARLS_POKEMON_ACADEMY_OBJ_001"] = "¡EARL soy yo!\fmaravilloso\nSon POKéMON, ¡sí!\n¡Te enseñaré que lo haré!\f¿Qué quieres?\n¿sabes? ¿Quieres ser ganador?",
  ["TEXT_EARLS_POKEMON_ACADEMY_OBJ_002"] = "Estou anotando\na aula do\vprofessor.\fMelhor copiar\no que está no\vquadro também.",
  ["TEXT_EARLS_POKEMON_ACADEMY_OBJ_003"] = "cambié lo mejor que pude\nPOKéMON con el chico a mi lado.",
  ["TEXT_EARLS_POKEMON_ACADEMY_OBJ_004"] = "¿Hay? EL POKEMON que\n¡Lo acabo de pillar sosteniendo algo!",
  ["TEXT_EARLS_POKEMON_ACADEMY_OBJ_005"] = "POKéMON com uma\nBERRY se cura\vna batalha.\fOutros itens\ntambém podem ser\vsegurados…\f├ë difícil\nanotar tudo…",
  ["TEXT_EARLS_POKEMON_ACADEMY_OBJ_006"] = "├ë o caderno\ndeste garoto…\fPegue POKéMON\ncom POKé BALLS.\fAté seis podem\nna sua equipe.\fContinuar lendo?",
  ["TEXT_ECRUTEAK_CITY_OBJ_001"] = "ECRUTEAK ya tenía\ndos torres: una al este y\notro al oeste.",
  ["TEXT_ECRUTEAK_CITY_OBJ_002"] = "Ah, jovencito.\n¿Aprendiste a bailar como el\n¿CHICAS KIMONOS?\fSi vas a BAILAR\nTEATRO de ellos, un viejo extraño\nTe doy algo genial, según he oído.",
  ["TEXT_ECRUTEAK_CITY_OBJ_003"] = "Vou treinar lá no\nDANCE THEATER.\fQuer vir junto\ncomigo?",
  ["TEXT_ECRUTEAK_CITY_OBJ_004"] = "La torre que se encontraba\naquí… dijo mi abuela\nque era mucho mayor.",
  ["TEXT_ECRUTEAK_CITY_OBJ_005"] = "escuché un rumor\nsobre FARO OLIVINO.\fEL POKEMON que\nsirve de faro y enfermó.\nParece que están en problemas.",
  ["TEXT_ECRUTEAK_CITY_OBJ_006"] = "escuché que pokemon\nestán alborotados en LAKE OF RAGE. yo\nQuería ver eso.",
  ["TEXT_ECRUTEAK_CITY_OBJ_007"] = "hay mucho\nhace mucho tiempo… Esta torre\nse incendió.\fTres POKEMON sin\nnombre murió.\fUN POKÉMON\nEl arco iris descendió del cielo y el\nresucitado… ├ë una leyenda\ntransmitido por los LÍDERES DE\nGIMNASIO ECRUTEAK.\f¿I?\fyo era un\nentrenador durante mucho tiempo.\v¡Rohoho!",
  ["TEXT_ECRUTEAK_GYM_OBJ_001"] = "Me alegro de que hayas venido.\fAquí en ECRUTEAK,\nLos POKéMON siempre han sido venerados.\fDicen que uno\nPOKéMON con los colores del arcoíris\nponerse delante de un entrenador\nrealmente fuerte.\fyo creí\nen esta historia y entrené aquí en\nsecreto toda mi vida.\fPor eso hoy yo\nVeo lo que otros no ven.\fSólo un poco más... Con un poco más,\nVería un futuro donde encontraría la\nPOKéMON con los colores del arcoíris.\f¿Me ayudarás?\npara llegar a ese nivel!",
  ["TEXT_ECRUTEAK_GYM_OBJ_002"] = "De onde vieram\nos POKéMON?",
  ["TEXT_ECRUTEAK_GYM_OBJ_002_AFTER"] = "De onde vieram\nos POKéMON?",
  ["TEXT_ECRUTEAK_GYM_OBJ_002_BEATEN"] = "ya he experimentado la victoria\ny derrota.",
  ["TEXT_ECRUTEAK_GYM_OBJ_002_SEEN"] = "pasé la primavera\ncon mi POKéMON.\fLuego el verano, el\notoño, invierno y luego primavera\nregresó. Hemos vivido juntos durante\nmucho tiempo.",
  ["TEXT_ECRUTEAK_GYM_OBJ_003"] = "Sólo utilizamos el\nPOKEMON FANTASMA Sin ataque\n¡Lo normal puede hacerles daño!",
  ["TEXT_ECRUTEAK_GYM_OBJ_003_AFTER"] = "Sólo utilizamos el\nPOKEMON FANTASMA Sin ataque\n¡Lo normal puede hacerles daño!",
  ["TEXT_ECRUTEAK_GYM_OBJ_003_BEATEN"] = "¡Oh! ¡Muy bien!",
  ["TEXT_ECRUTEAK_GYM_OBJ_003_SEEN"] = "Consegue causar\ndano aos nossos\vPOKéMON?",
  ["TEXT_ECRUTEAK_GYM_OBJ_004"] = "Quem quiser vencer\nmais, vencerá!",
  ["TEXT_ECRUTEAK_GYM_OBJ_004_AFTER"] = "Quem quiser vencer\nmais, vencerá!",
  ["TEXT_ECRUTEAK_GYM_OBJ_004_BEATEN"] = "Eu, eu perdi!",
  ["TEXT_ECRUTEAK_GYM_OBJ_004_SEEN"] = "Eu vou vencer!",
  ["TEXT_ECRUTEAK_GYM_OBJ_005"] = "Tudo bem. Eu vou\ncontar o segredo\fdo piso\ninvisível.\fO caminho está\nna nossa frente!",
  ["TEXT_ECRUTEAK_GYM_OBJ_005_AFTER"] = "Tudo bem. Eu vou\ncontar o segredo\fdo piso\ninvisível.\fO caminho está\nna nossa frente!",
  ["TEXT_ECRUTEAK_GYM_OBJ_005_BEATEN"] = "O quê?",
  ["TEXT_ECRUTEAK_GYM_OBJ_005_SEEN"] = "Confundido por nuestro\npiso invisible?\fGolpéame si quieres\nun consejo!",
  ["TEXT_ECRUTEAK_GYM_OBJ_006"] = "los entrenadores\npor eso tienen motivos secretos.\fSi ganas,\npueden contar secretos profundos\npor ECRUTEAK.",
  ["TEXT_ECRUTEAK_ITEMFINDER_HOUSE_BG_001"] = "no hay nada\naquí dentro...",
  ["TEXT_ECRUTEAK_ITEMFINDER_HOUSE_OBJ_001"] = "Oh. estas en un\n¿Aventura con tu POKéMON?\fy cual seria\n¿Una aventura sin búsqueda del tesoro?\fT├┤ correcto o no\n¿Estoy en lo cierto?",
  ["TEXT_ECRUTEAK_ITEMFINDER_HOUSE_OBJ_002"] = "HISTÔRIA DE\nECRUTEAK\fQuer ler?",
  ["TEXT_ECRUTEAK_LUGIA_SPEECH_HOUSE_BG_001"] = "...........Esto pasó\ncuando era joven.\fEl cielo de repente\nse volvió negro. Un POKEMON gigante\nvolando cubrió el sol.\fQue pokemon\n¿lo fue?\fParecía un pájaro\ny un dragón.",
  ["TEXT_ECRUTEAK_LUGIA_SPEECH_HOUSE_OBJ_001"] = "esto paso\ncuando era joven.\fEl cielo de repente\nse volvió negro. Un POKEMON gigante\nvolando cubrió el sol.\fQue pokemon\n¿lo fue?\fParecía un pájaro\ny un dragón.",
  ["TEXT_ECRUTEAK_LUGIA_SPEECH_HOUSE_OBJ_002"] = "{BYTE:EC} {RIVAL} ...........Esto sucedió\ncuando yo era joven.\fEl cielo de repente\nse volvió negro. Un POKEMON volador\ngigante cubrió el sol.\f¿Qué fue?\n¿Ese POKEMON?\fEra como un\npájaro y un dragón.",
  ["TEXT_ECRUTEAK_MART_OBJ_001"] = "Mi EEVEE se volvió\nun ESPEÓN.\fpero el de mi amigo\nEEVEE se convirtió en un UMBREON.\f¿Por qué sería? nosotros\nAmbos creamos nuestro EEVEE a partir de\nde la misma manera...",
  ["TEXT_ECRUTEAK_MART_OBJ_002"] = "{BYTE:48} TM 'tTMMi EEVEE ha evolucionado\npara ESPEÓN.\fPero mi EEVEE\namigo se convirtió en UMBREON.\f¿Por qué sería? nosotros\nAmbos creamos EEVEE del mismo\ncamino…",
  ["TEXT_ECRUTEAK_MART_OBJ_003"] = "'tTMMi EEVEE ha evolucionado\npara ESPEÓN.\fPero mi EEVEE\namigo se convirtió en UMBREON.\f¿Por qué sería? nosotros\nAmbos creamos EEVEE del mismo\ncamino…",
  ["TEXT_ECRUTEAK_POKECENTER1_F_OBJ_001"] = "O jeito que as\nKIMONO GIRLS\fdançam é\nmaravilhoso. Igual\fao jeito que usam\nos POKéMON delas.",
  ["TEXT_ECRUTEAK_POKECENTER1_F_OBJ_002"] = "O jeito que as\nKIMONO GIRLS\fdançam é\nmaravilhoso. Igual\fao jeito que usam\nos POKéMON delas.",
  ["TEXT_ECRUTEAK_POKECENTER1_F_OBJ_003"] = "MORTY, o LÍDER\ndo GINÁSIO, é tão\vlegal.\fOs POKéMON dele\nsão fortes também",
  ["TEXT_ECRUTEAK_POKECENTER1_F_OBJ_004"] = "LAKE OF RAGE…\fO aparecimento do\nbando de GYARADOS\fSinto cheiro de\nconspiração. Sei!",
  ["TEXT_ECRUTEAK_TIN_TOWER_ENTRANCE_OBJ_001"] = "La torre de hojalata es\nprohibido a cualquier persona que no tenga la INSIGNIA\npor ECRUTEAK.\fLo siento, pero tu\ntengo que irme.",
  ["TEXT_ECRUTEAK_TIN_TOWER_ENTRANCE_OBJ_002"] = "La torre de hojalata es\nprohibido a cualquier persona que no tenga la INSIGNIA\npor ECRUTEAK.\fLo siento, pero tu\ntengo que irme.",
  ["TEXT_ECRUTEAK_TIN_TOWER_ENTRANCE_OBJ_003"] = "A TIN TOWER ali\n├á frente tem nove\vandares de beleza\vdivina.\fEla acalma a alma\nde todos que a\vveem.",
  ["TEXT_ECRUTEAK_TIN_TOWER_ENTRANCE_OBJ_004"] = "Duas torres…\nDois POKéMON…\fMas quando uma\nqueimou, os dois\fPOKéMON voaram\ne nunca voltaram.",
  ["TEXT_ELMS_HOUSE_BG_001"] = "POKÉMON. De donde\n¿vienen?\fdonde estan\n¿van?\fpor que nadie\n¿Alguna vez has visto nacer un POKéMON?\f¡Quiero saber! lo haré\ndedicar su vida al estudio de\n¡POKÉMON!\f…Es parte de\nArtículos de investigación de ELM.",
  ["TEXT_ELMS_HOUSE_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_HOUSE_BG_003"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_HOUSE_OBJ_001"] = "Oi, {PLAYER}! Meu\nmarido vive tão\focupado, e espero\nque ele fique bem\fQuando mergulha na\npesquisa POKéMON,\fele até esquece\nde comer.",
  ["TEXT_ELMS_HOUSE_OBJ_002"] = "Quando eu crescer,\nvou ajudar o meu\vpai!\fVou ser um grande\nprofessor\vPOKéMON!",
  ["TEXT_ELMS_LAB_BG_001"] = "Será que isto faz\no quê?",
  ["TEXT_ELMS_LAB_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_003"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_004"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_005"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_006"] = "!\fVai. Escolha um!",
  ["TEXT_ELMS_LAB_BG_010"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_011"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_012"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_013"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_ELMS_LAB_BG_015"] = "Ele entrou\npor aqui!",
  ["TEXT_ELMS_LAB_OBJ_002"] = "Somos solo nosotros dos,\npor eso siempre estamos ocupados.",
  ["TEXT_ELMS_LAB_OBJ_003"] = "ELM: Vai levar o\nCYNDAQUIL, o\vPOKéMON de fogo?",
  ["TEXT_ELMS_LAB_OBJ_004"] = "ELM: ¿Quieres el\nTOTODILE, ¿el POKéMON de agua?",
  ["TEXT_ELMS_LAB_OBJ_005"] = "ELM: Então gosta\nda CHIKORITA, a\vPOKéMON planta?",
  ["TEXT_ELMS_LAB_OBJ_006"] = "escuché que robaron\nun POKéMON aquí... estaba cosechando\ninformación con el PROF.ELM.\fAl parecer era un\njoven de largo cabello rojo… ¿Qué?\fpeleaste con un\n¿Entrenador así?\fme pasó a saber\nsu nombre?",
  ["TEXT_FAST_SHIP1_F_OBJ_001"] = "O FAST SHIP S.S.\nAQUA segue para\vCIDADE DE\vVERMILION.\fVamos anunciar\nassim que a gente\vchegar.",
  ["TEXT_FAST_SHIP1_F_OBJ_002"] = "├ë tu cabaña.\fSi tu POKéMON\nestán heridos, duerman en la cama.\festo sanará\nellos.",
  ["TEXT_FAST_SHIP1_F_OBJ_003"] = "Cada pasajero\nEste es un entrenador.\festan todos locos\npara luchar en las cabañas.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_001"] = "Oye, jovencito. puede\n¿Buscas a mi colega?\fel esta holgazaneando\n¡Ahí fuera, ese holgazán!\fquería ir tras\nsuyo, pero estoy de servicio.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_002"] = "Oye, jovencito. puede\n¿Buscas a mi colega?\fel esta holgazaneando\n¡Ahí fuera, ese holgazán!\fquería ir tras\nsuyo, pero estoy de servicio.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_003"] = "no creo que funcione\nganar si no lo tomo en serio",
  ["TEXT_FAST_SHIP_B1_F_OBJ_003_AFTER"] = "no creo que funcione\nganar si no lo tomo en serio",
  ["TEXT_FAST_SHIP_B1_F_OBJ_003_BEATEN"] = "Ganando o no,\n¡Se acabó el descanso!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_003_SEEN"] = "Nada mejor que\nuna batalla en mi día libre.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_004"] = "AZAFRÁN, CELADÓN…\nEscuché que hay muchas ciudades.\nlos grandes en KANTO.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_004_AFTER"] = "AZAFRÁN, CELADÓN…\nEscuché que hay muchas ciudades.\nlos grandes en KANTO.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_004_BEATEN"] = "¡Guau! tu eres fuerte\n¡demasiado!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_004_SEEN"] = "Estoy aburrido.\n¿Quieres luchar?",
  ["TEXT_FAST_SHIP_B1_F_OBJ_005"] = "Chega de navio\npara mim. Da\fpróxima vez eu vou\nde MAGNET TRAIN.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_005_AFTER"] = "Chega de navio\npara mim. Da\fpróxima vez eu vou\nde MAGNET TRAIN.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_005_BEATEN"] = "ya no puedo hacerlo\nmuéveme...",
  ["TEXT_FAST_SHIP_B1_F_OBJ_005_SEEN"] = "Urrf…\nEstou enjoado!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_006"] = "Recebemos\npassageiros\vdiferentes\fde CIDADE DE\vVERMILION a\vCIDADE DE OLIVINE.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_006_AFTER"] = "Recebemos\npassageiros\vdiferentes\fde CIDADE DE\vVERMILION a\vCIDADE DE OLIVINE.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_006_BEATEN"] = "Perdi no meu\npróprio campo…",
  ["TEXT_FAST_SHIP_B1_F_OBJ_006_SEEN"] = "├ë aqui que os\nmarinheiros ralam",
  ["TEXT_FAST_SHIP_B1_F_OBJ_007"] = "Pretendo pescar no\npíer de VERMILION",
  ["TEXT_FAST_SHIP_B1_F_OBJ_007_AFTER"] = "Pretendo pescar no\npíer de VERMILION",
  ["TEXT_FAST_SHIP_B1_F_OBJ_007_BEATEN"] = "yo… ya no estoy\naburrido...",
  ["TEXT_FAST_SHIP_B1_F_OBJ_007_SEEN"] = "Aunque estés en\nMar, ¡no puedo pescar!\f¡Qué aburrido!\n¡Luchemos!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_008"] = "no pude encontrarlo\nel REY DEL KARATE en JOHTO.\fdicen que el\ntren en alguna cueva por ahí.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_008_AFTER"] = "no pude encontrarlo\nel REY DEL KARATE en JOHTO.\fdicen que el\ntren en alguna cueva por ahí.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_008_BEATEN"] = "Balancei e\ncapotei!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_008_SEEN"] = "Estou fortalecendo\nas pernas firmes\fcontra o balanço\ndo navio!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_009"] = "¡Ocho INSIGNIAS!\nDemuestran que superaste el\nLÍDERES.\fNo es de extrañar que\n¡eres tan bueno!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_009_AFTER"] = "¡Ocho INSIGNIAS!\nDemuestran que superaste el\nLÍDERES.\fNo es de extrañar que\n¡eres tan bueno!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_009_BEATEN"] = "mi falta de\nel entrenamiento es claro...",
  ["TEXT_FAST_SHIP_B1_F_OBJ_009_SEEN"] = "Sou marinheiro!\fMas estou criando\nPOKéMON para virar\vo CAMPEÃO!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_010"] = "Estamos em\nexcursão nas\vRUÍNAS perto de\vVIOLET.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_010_AFTER"] = "Estamos em\nexcursão nas\vRUÍNAS perto de\vVIOLET.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_010_BEATEN"] = "Aaaah!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_010_SEEN"] = "No detengas uno\n¡Toca a los estudiantes!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_011"] = "CIDADE DE\nVERMILION.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_011_AFTER"] = "Os rádios captam\nsinais estranhos\vnas RUÍNAS.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_011_BEATEN"] = "Aargh!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_011_SEEN"] = "¿Conoces el\n¿RUINAS ALFA?",
  ["TEXT_FAST_SHIP_B1_F_OBJ_012"] = "Tu POKEMON\nparece estar infectado por\ndiminutas formas de vida.\fTus POKéMON son\nsano y lucir bien.\fPero no podemos\nno decir nada más en un POKéMON\nCENTRO.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_012_AFTER"] = "Li que existem\nquatro painéis de\vpedra.",
  ["TEXT_FAST_SHIP_B1_F_OBJ_012_BEATEN"] = "Fui derrotado!",
  ["TEXT_FAST_SHIP_B1_F_OBJ_012_SEEN"] = "Há painéis\nesquisitos nas\vRUÍNAS DE ALPH.",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_BG_001"] = "no hay nada\naquí dentro...",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_BG_002"] = "no hay nada\naquí dentro...",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_BG_003"] = "no hay nada\naquí dentro...",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_001"] = "entrenadores de\nJOHTO puede luchar con\nLÍDERES DE GIMNASIO KANTO.",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_001_AFTER"] = "entrenadores de\nJOHTO puede luchar con\nLÍDERES DE GIMNASIO KANTO.",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_001_BEATEN"] = "Eu queria ganhar!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_001_SEEN"] = "voy a KANTO\nPon a prueba mis habilidades.",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_002"] = "un dia gano\n¡tú!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_002_AFTER"] = "un dia gano\n¡tú!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_002_BEATEN"] = "Qual é a diferença\nentre nós dois?",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_002_SEEN"] = "Estou treinando\npara ser CAMPEÃO",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_003"] = "LILY es genial,\npero MARÍA es la mejor!\n¡Quiero conocer estaciones de radio JOHTO!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_003_AFTER"] = "LILY es genial,\npero MARÍA es la mejor!\n¡Quiero conocer estaciones de radio JOHTO!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_003_BEATEN"] = "Aaaargh!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_003_SEEN"] = "¿Conoces el\n¿LIRIO? Ella es una DJ de KANTO.",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_004"] = "Será que tem\nalguma montanha\fboa para escalar\nem KANTO?",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_004_AFTER"] = "Será que tem\nalguma montanha\fboa para escalar\nem KANTO?",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_004_BEATEN"] = "esto es demasiado\npara mi!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_004_SEEN"] = "Está sozinho?\nEntão vamos lutar",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_005"] = "├ë, yo soy\nmarinero si.\fyo no estaba\nholgazaneando!\fEsta cabaña fue\nvacío, ¡así que solo tomé una siesta!\f¡Ah, no importa!\n¡Luchemos!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_006"] = "Me rindo.\nNo necesitas mirar. olvidar\nesto!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_006_AFTER"] = "Me rindo. hijo,\nno es necesario buscarlo. olvidar\nesto!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_006_SEEN"] = "Oh, no. perdi uno\nalgo que es muy importante.",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_007"] = "encontré una moneda\nhermoso aquí.\fAlguien debe tener\nperdido...",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_007_AFTER"] = "encontré una moneda\nhermoso aquí.\fAlguien debe tener\nperdido...",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_007_BEATEN"] = "Que azar!\nEu perdi!",
  ["TEXT_FAST_SHIP_CABINS_NNW_NNE_NE_OBJ_007_SEEN"] = "Eba!\nSorte!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_BG_001"] = "no hay nada\naquí dentro...",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_001"] = "Ufa! Obrigado por\nter vindo junto.\fEntreter aquela\nmenininha foi\vexaustivo.",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_002"] = "Hola hijo...\nNo puedo encontrar a mi nieta.\fsi ella esta en\nbarco, está bien.\fPero ¿y si ella se cayera?\nen el mar?\fella es una niña\neléctrico, por lo que puede molestar a alguien\nEstoy angustiado...",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_003"] = "me divertí mucho\nbromeando!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_004"] = "CAPITÁN, broma\npoco conmigo?\f¡Estoy aburrido!\n¡Quiero jugar!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_005"] = "tu viajas\n¿solo?\ftu madre no se queda\npreocupado?",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_005_AFTER"] = "tu viajas\n¿solo?\ftu madre no se queda\npreocupado?",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_005_BEATEN"] = "¡Eres fuerte!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_005_SEEN"] = "¡Oye, hijo! querer\npelear conmigo?",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_006"] = "El bebé es una manera\n¡Es de mala educación llamarnos chicas!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_006_AFTER"] = "El bebé es una manera\n¡Es de mala educación llamarnos chicas!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_006_BEATEN"] = "Ah! Perdemos!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_006_SEEN"] = "¿Crees que yo\n¿Soy un bebé?\v¡Eso no es justo!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_007"] = "├Çs vezes crianças\nsão mais espertas\vque adultos!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_007_AFTER"] = "├Çs vezes crianças\nsão mais espertas\vque adultos!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_007_BEATEN"] = "Ah! Perdemos!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_007_SEEN"] = "¡No soy un bebé!\fno es agradable hablar\n¡Así con la dama!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_008"] = "Tu teléfono no\nTiene memoria para más números.",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_008_AFTER"] = "Entendi. Dá para\nouvir a rádio de\vJOHTO no navio.",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_008_BEATEN"] = "…Estou ouvindo\nalguma coisa!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_008_SEEN"] = "¡Pst! mi cerebro\n¡Está captando señales de radio!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_009"] = "necesito ir a\nSALÓN POKéMON y hazlos hermosos!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_009_AFTER"] = "necesito ir a\nSALÓN POKéMON y hazlos hermosos!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_009_BEATEN"] = "¡Oh, no! mio\n¡hermoso POKEMON!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_009_SEEN"] = "¿Qué opinas?\nMis POKéMON son hermosos, ¿no?",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_010"] = "¡Oh sí! tengo que\nbusca mi POKéMON en DAY-CARE!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_010_AFTER"] = "¡Oh sí! tengo que\nbusca mi POKéMON en DAY-CARE!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_010_BEATEN"] = "O que eu ia\nfazer mesmo?",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_010_SEEN"] = "Vou fazer compras\nna DEPT.STORE e\vdepois…",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_011"] = "Deberías usar el\nBOLA adecuada para cada situación.",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_011_AFTER"] = "Deberías usar el\nBOLA adecuada para cada situación.",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_011_BEATEN"] = "¡Esperar! ¡A! ¡No!\n¡Por favor!",
  ["TEXT_FAST_SHIP_CABINS_SE_SSE_CAPTAINS_CABIN_OBJ_011_SEEN"] = "¿Qué tipos de POKé?\nBOLAS tienes contigo?",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_BG_001"] = "Uma cama macia!\nHora de dormir…",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_BG_002"] = "Uma cama macia!\nHora de dormir…",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_BG_003"] = "no hay nada\naquí dentro...",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_001"] = "Creo que el fuego es\ndébil en el mar.\f¿No hace la diferencia?\n¿Grave?",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_001_AFTER"] = "Creo que el fuego es\ndébil en el mar.\f¿No hace la diferencia?\n¿Grave?",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_001_BEATEN"] = "Fsss… A chama\nestá fraquinha…",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_001_SEEN"] = "voy a KANTO\n¡Haz espectáculos de escupe fuego!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_002"] = "Oh, guau. tu eres\n¡Duro, hombre!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_002_AFTER"] = "Dá para achar um\nmonte de POKéMON\vnas árvores!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_002_BEATEN"] = "Oh, guau. tu eres\n¡Duro, hombre!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_002_SEEN"] = "visitaré mi\nabuela para atrapar algunos insectos!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_003"] = "un viaje es\nLa mejor manera de superar un corazón roto.\fPero el ENVÍO RÁPIDO es\ndemasiado corto para sufrir.",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_003_AFTER"] = "un viaje es\nLa mejor manera de superar un corazón roto.\fPero el ENVÍO RÁPIDO es\ndemasiado corto para sufrir.",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_003_BEATEN"] = "Mi pecho llora...",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_003_SEEN"] = "lo estoy intentando\nolvida las penas ¡Luchemos!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_004"] = "Falando na RADIO\nSTATION, qual é o\fnúmero da sorte\ndesta semana?",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_004_AFTER"] = "Falando na RADIO\nSTATION, qual é o\fnúmero da sorte\ndesta semana?",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_004_BEATEN"] = "Uau!\nDistorção total!",
  ["TEXT_FAST_SHIP_CABINS_SW_SSW_NW_OBJ_004_SEEN"] = "Vou fazer um teste\ncom as minhas\fmúsicas na RADIO\nSTATION.",
  ["TEXT_FIGHTING_DOJO_BG_001"] = "{RIVAL}{BYTE:C0}{PC}{RIVAL}'{PC}{BYTE:77}{RAM:8700}lá!\fO KARATE KING,\nmestre do FIGHTING\vDOJO, está numa\fcaverna em JOHTO,\ntreinando.",
  ["TEXT_FIGHTING_DOJO_OBJ_001"] = "Olá!\fO KARATE KING,\nmestre do DOJO,\festá numa caverna\nem JOHTO,\vtreinando.",
  ["TEXT_FUCHSIA_CITY_BG_001"] = "d outros\npontos de\vreferência.",
  ["TEXT_FUCHSIA_CITY_OBJ_001"] = "Uno de la ÉLITE\nCUATRO fue una vez el LÍDER DEL GIMNASIO\nde FUCSIA.",
  ["TEXT_FUCHSIA_CITY_OBJ_002"] = "A filha do KOGA\nvirou o LÍDER do\fGINÁSIO depois\nque ele entrou no\vELITE FOUR.",
  ["TEXT_FUCHSIA_CITY_OBJ_003"] = "A SAFARI ZONE está\nfechada… Que\fpena, era a\nmaior atração\vde FUCHSIA.",
  ["TEXT_FUCHSIA_GYM_OBJ_001"] = "Fufufufu... lo siento\ndecepcionarte… ├ë ¡es broma!\f¡Yo soy el verdadero!\fJANINE, de GINÁSIO\nde FUCSIA!",
  ["TEXT_FUCHSIA_GYM_OBJ_002"] = "¡Fuffufu!\fsoy janine,\nel LÍDER!\f¡No, no lo soy!\n¡Caí, tonto!",
  ["TEXT_FUCHSIA_GYM_OBJ_003"] = "Te enganei!\nHahaha!",
  ["TEXT_FUCHSIA_GYM_OBJ_004"] = "¡Soy JANINE!\f¿Cómo lo supiste?\nque yo era real?\f¡Luchemos!",
  ["TEXT_FUCHSIA_GYM_OBJ_005"] = "Uahahaha!\fPode crer, cara.\nEu sou a JANINE!",
  ["TEXT_FUCHSIA_GYM_OBJ_006"] = "Ei, futuro\nCAMPEÃO!\fOpa! Dê uma boa\nolhada em volta.\fOs treinadores são\ntodos iguais ├á\vLÍDER, a JANINE.\fQual deles é a\nJANINE real?",
  ["TEXT_FUCHSIA_MART_OBJ_001"] = "Eu queria comprar\nlembranças da\fSAFARI ZONE, mas\nestá fechada…",
  ["TEXT_FUCHSIA_MART_OBJ_002"] = "\fÔÖÇTM\f{BYTE:36}{TRAINER}Queria comprar\numa lembrança da\fSAFARI ZONE, mas\nestá fechada…",
  ["TEXT_FUCHSIA_MART_OBJ_003"] = "\f{BYTE:36}{TRAINER}Queria comprar\numa lembrança da\fSAFARI ZONE, mas\nestá fechada…",
  ["TEXT_FUCHSIA_POKECENTER1_F_OBJ_001"] = "¡Ey! ¿Tienes un\nPOKéDEX de un tipo completamente nuevo.\fEra PROF.ROBLE\n¿Qué te dio?",
  ["TEXT_FUCHSIA_POKECENTER1_F_OBJ_002"] = "¡Ey! ¿Tienes un\nPOKéDEX de un tipo completamente nuevo.\fEra PROF.ROBLE\n¿Qué te dio?",
  ["TEXT_FUCHSIA_POKECENTER1_F_OBJ_003"] = "Levei um susto\nno GINÁSIO.\fTinha um monte de\nmeninas que eram\vtodas iguais.",
  ["TEXT_FUCHSIA_POKECENTER1_F_OBJ_004"] = "Eu sou a JANINE!\nAbracadabra… Puf!",
  ["TEXT_GOLDENROD_BIKE_SHOP_OBJ_001"] = "...suspiro...yo\nMe cambié, pero no vendo mi\nBICICLETA. ¿Por qué?\f¡Ah, lo sé! tu\n¿Podrías venir y anunciármelo?",
  ["TEXT_GOLDENROD_CITY_OBJ_001"] = "Construíram a nova\nRADIO TOWER para\ftrocar a velha,\nque rangia.",
  ["TEXT_GOLDENROD_CITY_OBJ_002"] = "se que hay uno\nTIENDA DE BICICLETAS nueva, pero no la encuentro\nen ninguna parte.",
  ["TEXT_GOLDENROD_CITY_OBJ_003"] = "Aquele homem de\npreto se veste\fcomo a TEAM ROCKET\nQue bobagem!",
  ["TEXT_GOLDENROD_CITY_OBJ_004"] = "LA TORRE DE RADIO\nGOLDENROD CITY es una postal.\fellos tienen un\npromoción en curso ahora.\fellos modifican\ntu POKéGEAR, para que pueda girar\nuna radio también.",
  ["TEXT_GOLDENROD_CITY_OBJ_005"] = "E-he-he-he…\fLevei bronca\npor brincar no\fsubsolo da\nDEPT.STORE.",
  ["TEXT_GOLDENROD_CITY_OBJ_006"] = "El hombre de ese\nEl hogar evalúa los nombres que le das. Incluso cambia el nombre.\ntu POKéMON.",
  ["TEXT_GOLDENROD_CITY_OBJ_007"] = "¡Uf! esta ciudad\nEs grande. no se donde esta\nnada.",
  ["TEXT_GOLDENROD_CITY_OBJ_008"] = "Então esta é a\nRADIO TOWER…",
  ["TEXT_GOLDENROD_CITY_OBJ_009"] = "Saia do caminho!\nCai fora!",
  ["TEXT_GOLDENROD_CITY_OBJ_010"] = "Toma la RADIO\nTORRE… ¿Qué? no es de\ntu cuenta!",
  ["TEXT_GOLDENROD_CITY_OBJ_011"] = "¿POKÉMON? ellos no son\nnada más que herramientas para\nganar dinero!",
  ["TEXT_GOLDENROD_CITY_OBJ_012"] = "Nuestro sueño pronto\nse hará realidad... Fue una pelea así\nlargo…",
  ["TEXT_GOLDENROD_CITY_OBJ_013"] = "¡Oye, mocoso! tu\n¡No es de aquí!\v¡Piérdase!",
  ["TEXT_GOLDENROD_CITY_OBJ_014"] = "Venha provar o\nverdadeiro terror\vda TEAM ROCKET!",
  ["TEXT_GOLDENROD_CITY_OBJ_015"] = "puedo enseñar\nmovimientos increíbles para tu POKéMON,\nsi quieres.\f¿me quieres?\nenseñar un nuevo movimiento?",
  ["TEXT_GOLDENROD_DEPT_STORE1_F_BG_001"] = "1F BALCÃO\f2F MERCADO DO\n   TREINADOR\f3F COLE├çÃO DE\n   BATALHA\f4F REM├ëDIOS\f5F CANTO DAS TM\f6F TERRA├çO",
  ["TEXT_GOLDENROD_DEPT_STORE1_F_BG_002"] = "....................Bem-vindo ├á\nDEPT.STORE!",
  ["TEXT_GOLDENROD_DEPT_STORE1_F_OBJ_001"] = "Bem-vindo ├á\nDEPT.STORE!",
  ["TEXT_GOLDENROD_DEPT_STORE1_F_OBJ_002"] = "Estou doida para\ncomprar hoje!",
  ["TEXT_GOLDENROD_DEPT_STORE1_F_OBJ_003"] = "Mamãe é boa em\ncaçar promoção.\fEla sempre compra\nas coisas mais\vbaratas.",
  ["TEXT_GOLDENROD_DEPT_STORE1_F_OBJ_004"] = "DEPT.STORE tiene\nuna buena variedad.\fPero algunos elementos\nsolo salen como premios del\nRINCÓN DE JUEGO.",
  ["TEXT_GOLDENROD_DEPT_STORE2_F_BG_002"] = "...................Vendamos artículos\npara que POKéMON lo mantenga presionado.\fEste es un\nregalo gratis.\vDeja reposar un POKéMON.",
  ["TEXT_GOLDENROD_DEPT_STORE2_F_OBJ_001"] = "A POKéGEAR pode\nguardar até dez\vnúmeros.\f├ë difícil\ndecidir quais\vguardar.",
  ["TEXT_GOLDENROD_DEPT_STORE2_F_OBJ_002"] = "A POKéGEAR pode\nguardar até dez\vnúmeros.\f├ë difícil\ndecidir quais\vguardar.",
  ["TEXT_GOLDENROD_DEPT_STORE2_F_OBJ_003"] = "A POKéGEAR pode\nguardar até dez\vnúmeros.\f├ë difícil\ndecidir quais\vguardar.",
  ["TEXT_GOLDENROD_DEPT_STORE2_F_OBJ_004"] = "Gané mi ABRA\nen la CASA DE JUEGOS.\fahora es mio\nmejor socio.",
  ["TEXT_GOLDENROD_DEPT_STORE2_F_OBJ_005"] = "Esta TIENDA me hace\nver que GOLDENROD es una ciudad\ngrande.\fLa selección aquí\nNo hay igual en ninguna parte.",
  ["TEXT_GOLDENROD_DEPT_STORE3_F_OBJ_001"] = "Yo, yo, estoy bien\n¡impaciente!\fYo uso X SPEED en\nBatalla para acelerar POKéMON.",
  ["TEXT_GOLDENROD_DEPT_STORE3_F_OBJ_002"] = "Yo, yo, estoy bien\n¡impaciente!\fYo uso X SPEED en\nBatalla para acelerar POKéMON.",
  ["TEXT_GOLDENROD_DEPT_STORE3_F_OBJ_003"] = "¡Ey! En la batalla,\n¿Utilizas X ESPECIAL?\f├ë demasiado. el\n¡Aumenta mucho la ESPECIAL!",
  ["TEXT_GOLDENROD_DEPT_STORE4_F_BG_002"] = "....................Ei. Amo POKéMON\nfortes.\fDou PROTEIN a\neles para elevar\vo ATTACK.",
  ["TEXT_GOLDENROD_DEPT_STORE4_F_OBJ_001"] = "Ei. Amo POKéMON\nfortes.\fDou PROTEIN a\neles para elevar\vo ATTACK.",
  ["TEXT_GOLDENROD_DEPT_STORE4_F_OBJ_002"] = "Ei. Amo POKéMON\nfortes.\fDou PROTEIN a\neles para elevar\vo ATTACK.",
  ["TEXT_GOLDENROD_DEPT_STORE4_F_OBJ_003"] = "IRON: a DEFESA do\nPOKéMON sobe.",
  ["TEXT_GOLDENROD_DEPT_STORE4_F_OBJ_004"] = "Alguns POKéMON\nevoluem quando\fsão trocados por\ncabo Game Link.\fConheço quatro:\nMACHOKE, KADABRA,\fHAUNTER e, hum,\nGRAVELER.\fDizem que existem\noutros também.",
  ["TEXT_GOLDENROD_DEPT_STORE5_F_OBJ_002"] = "Aos domingos, uma\nmoça vem olhar\vos POKéMON.\fEla até dá\nTM de presente!",
  ["TEXT_GOLDENROD_DEPT_STORE5_F_OBJ_003"] = "no puedo\ncambiar el nombre de un POKéMON intercambiado.\fEl nombre muestra la\ncariño del viejo entrenador\npara el.",
  ["TEXT_GOLDENROD_DEPT_STORE5_F_OBJ_004"] = "no puedo\ncambiar el nombre de un POKéMON intercambiado.\fEl nombre muestra la\ncariño del viejo entrenador\npara el.",
  ["TEXT_GOLDENROD_DEPT_STORE5_F_OBJ_005"] = "REGALO MISTERIOSO.\fcon un pequeño\nbip, obtienes un regalo",
  ["TEXT_GOLDENROD_DEPT_STORE5_F_OBJ_006"] = "Olá. Oh, seu\nPOKéMON…",
  ["TEXT_GOLDENROD_DEPT_STORE6_F_BG_003"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_GOLDENROD_DEPT_STORE6_F_BG_004"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_GOLDENROD_DEPT_STORE6_F_BG_005"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_GOLDENROD_DEPT_STORE6_F_BG_006"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_GOLDENROD_DEPT_STORE6_F_OBJ_001"] = "¿Escuchas el\n¿CANAL CON SUERTE?\fSi quieres ganar,\nintercambiar POKéMON con el máximo\nlas personas deben tener números de identificación\ndiferente.",
  ["TEXT_GOLDENROD_DEPT_STORE6_F_OBJ_002"] = "Se estiver cansado\ntente as bebidas\vdas máquinas.\fSeu POKéMON vai\namar também.",
  ["TEXT_GOLDENROD_DEPT_STORE_B1_F_OBJ_005"] = "¡Oye chico!\n¡Nos frenas!\fNuestro esquema\nestá trabajando detrás de escena,\ndonde nadie ve!",
  ["TEXT_GOLDENROD_DEPT_STORE_B1_F_OBJ_006"] = "pierdo la voluntad\na trabajar si alguien me ve.\fVamos, muchacho,\n¡fuera!",
  ["TEXT_GOLDENROD_DEPT_STORE_B1_F_OBJ_007"] = "Oohah! Oohah!\fAs coisas no\nchão são lixo.\fLeve-as se\nquiser!",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_001"] = "Uf, estoy\ncansado.\f├a veces vengo\na la terraza a descansar\nde compras.",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_002"] = "Uf, estoy\ncansado.\f├a veces vengo\na la terraza a descansar\nde compras.",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_003"] = "¿Como? quien dijo\n¿A qué adulto no le puede gustar eso?\fvolveré todo\ndía para recogerlos todos\nlas muñecas!",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_004"] = "Aqui tem promoção\nde vez em\vquando.",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_005"] = "Nossa!",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_006"] = "Hay una cosa que\nRealmente lo quiero, pero no lo tengo.\ndinero para eso... Tal vez lo venda\nlas BAYAS que recogí…",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_007"] = "Vaya, todo es\n¡tan barato!\fcompré mucho\nque mi BOLSA estaba llena!",
  ["TEXT_GOLDENROD_DEPT_STORE_ROOF_OBJ_008"] = "mi pokemon\nsiempre está paralizado o\nenvenenado justo a tiempo… vine a comprar uno\nCURACIÓN COMPLETA.\f¿todavía\ntienes?",
  ["TEXT_GOLDENROD_FLOWER_SHOP_OBJ_002"] = "conocer el arbol\n¿Qué está pasando?\fSi lo riegas,\nella salta sorprendida!",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_002"] = "Bem-vindo!\fTrocamos suas\nmoedas de jogo\vpor prêmios bons!",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_003"] = "Bem-vindo!\fTrocamos suas\nmoedas de jogo\vpor prêmios bons!",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_004"] = "Sempre jogo nesta\nmáquina.\fAcho que ela paga\nmais que outras.",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_005"] = "Sempre jogo nesta\nmáquina.\fAcho que ela paga\nmais que outras.",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_006"] = "Adoro esta nova\ncaça-níqueis.\f├ë mais desafiadora\nque as de\vCELADON.",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_007"] = "A vida é um jogo.\nVou virar\vcartas até cair!",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_008"] = "Vira-cartas…\fPrefiro aos\ncaça-níqueis\fporque é mais\nfácil de calcular\fas chances.\nMas paga menos.",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_009"] = "no paro hasta\nlogra ganar!",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_010"] = "yo enseñé a BLIZZARD\na mi POKéMON.\fFue difícil juntar\nlas monedas para él, pero valió la pena\nvale la pena.",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_011"] = "perdí en\nmáquinas tragamonedas, lo gasté todo\nen el volteador de cartas... estaba tan nervioso\nque tiré mi MONEDEROS\nen SUBTERRÁNEO.",
  ["TEXT_GOLDENROD_GAME_CORNER_OBJ_012"] = "¡Jajaja! las patatas fritas\n¡no dejan de venir!",
  ["TEXT_GOLDENROD_GYM_OBJ_001"] = "¡Ey! ¡Soy WHITNEY!\fA todos les gustó\nPOKéMON, ¡así que me uní también!\fPOKÉMON son\n¡demasiado lindo!\f¿Quieres luchar?\n¡Te lo advierto, estoy bien!",
  ["TEXT_GOLDENROD_GYM_OBJ_002"] = "Será que meus\nPOKéMON me acham\vfofa?",
  ["TEXT_GOLDENROD_GYM_OBJ_002_AFTER"] = "Será que meus\nPOKéMON me acham\vfofa?",
  ["TEXT_GOLDENROD_GYM_OBJ_002_BEATEN"] = "Maldita sea... pensé\neras débil...",
  ["TEXT_GOLDENROD_GYM_OBJ_002_SEEN"] = "No te dejes engañar por\nla linda cara de mi POKéMON.\fellos pueden tu\n¡derrota!",
  ["TEXT_GOLDENROD_GYM_OBJ_003"] = "Tento vencer a\nWHITNEY, mas… ├ë\vdeprimente.\fEstou bem! Se eu\nperder, tentarei\fde novo da próxima\nvez!",
  ["TEXT_GOLDENROD_GYM_OBJ_003_AFTER"] = "Tento vencer a\nWHITNEY, mas… ├ë\vdeprimente.\fEstou bem! Se eu\nperder, tentarei\fde novo da próxima\nvez!",
  ["TEXT_GOLDENROD_GYM_OBJ_003_BEATEN"] = "¡Ay, no, no!",
  ["TEXT_GOLDENROD_GYM_OBJ_003_SEEN"] = "Gosto mais de POKé\nMON fofos do que\vdos fortes.\fMas tenho POKéMON\nfortes e fofos!",
  ["TEXT_GOLDENROD_GYM_OBJ_004"] = "Vaya, debes estarlo\nbueno vencerme!\v¡Avanza!",
  ["TEXT_GOLDENROD_GYM_OBJ_004_AFTER"] = "Vaya, debes estarlo\nbueno vencerme!\v¡Avanza!",
  ["TEXT_GOLDENROD_GYM_OBJ_004_BEATEN"] = "Vejamos… Ops,\nacabou?",
  ["TEXT_GOLDENROD_GYM_OBJ_004_SEEN"] = "Ay que entrenador\nlindo! Me gustas, pero no\n¡Aguantaré!",
  ["TEXT_GOLDENROD_GYM_OBJ_005"] = "Ensinei ao MEOWTH\ngolpes para lidar\vcom todo tipo…",
  ["TEXT_GOLDENROD_GYM_OBJ_005_AFTER"] = "Ensinei ao MEOWTH\ngolpes para lidar\vcom todo tipo…",
  ["TEXT_GOLDENROD_GYM_OBJ_005_BEATEN"] = "¡No! Oh, maullido,\n¡Lo siento!",
  ["TEXT_GOLDENROD_GYM_OBJ_005_SEEN"] = "Dê o seu melhor,\nou eu vou te\vderrubar!",
  ["TEXT_GOLDENROD_GYM_OBJ_006"] = "E aí! Futuro\nCAMPEÃO!\fEste GINÁSIO é de\ntreinadores de\vPOKéMON normais.\fRecomendo que use\nPOKéMON do tipo\vlutador.",
  ["TEXT_GOLDENROD_HAPPINESS_RATER_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_GOLDENROD_HAPPINESS_RATER_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_GOLDENROD_HAPPINESS_RATER_BG_003"] = "............Si lo tratas\nbueno tu POKéMON, te amará\natrás.\f¿Oh? Déjame ver\ntu {RAM:D099}…",
  ["TEXT_GOLDENROD_HAPPINESS_RATER_OBJ_001"] = "si tratas\nbueno tu POKéMON, te amará\natrás.\f¿Oh? Déjame ver\ntu {RAM:D099}…",
  ["TEXT_GOLDENROD_HAPPINESS_RATER_OBJ_002"] = "sigo perdiendo\nbatallas y mi final POKéMON\ndesmayándose... Quizás por eso\nA mis POKéMON no les agrado...",
  ["TEXT_GOLDENROD_HAPPINESS_RATER_OBJ_003"] = "Cuando uso el artículo\n¡En POKéMON, está todo feliz!",
  ["TEXT_GOLDENROD_MAGNET_TRAIN_STATION_OBJ_001"] = "El tren no\nHa llegado… ¡lo sé! tomaré\n¡Los pasajeros en la parte de atrás!\fNo funcionará.",
  ["TEXT_GOLDENROD_MAGNET_TRAIN_STATION_OBJ_002"] = "Soy el PRESIDENTE.\fmi sueño fue\nconstruir un tren más rápido que\ncualquier POKEMON.\fel realmente\nacerca a JOHTO y KANTO.",
  ["TEXT_GOLDENROD_NAME_RATER_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_GOLDENROD_NAME_RATER_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_GOLDENROD_NAME_RATER_BG_003"] = "............Mi POKéMON es\nexperto en recolección de MIEL DULCE.\fcompartiré uno\npoco contigo.",
  ["TEXT_GOLDENROD_NAME_RATER_OBJ_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_GOLDENROD_POKECENTER1_F_OBJ_003"] = "EL COLISEO\nen los pisos del CENTRO POKéMON,\nEs para batallas vía enlace.\nLos registros de pelea en la pared,\nNo puedo perder.",
  ["TEXT_GOLDENROD_POKECENTER1_F_OBJ_004"] = "UN POKEMON de\nEl nivel más alto no siempre gana.\fIncluso puede que tenga\ntipo de desventaja.\fno lo creo\nsolo hay un POKéMON que es\nel más fuerte.",
  ["TEXT_GOLDENROD_POKECENTER1_F_OBJ_005"] = "Vaya, tu bolso\n¡Es tan pesado!\f¡Oh! por casualidad\n¿Tienes algo llamado EON MAIL?\fmi hija quiere\nuno.\fpuedes abrir\nla mano, ¿verdad?",
  ["TEXT_GOLDENROD_PPSPEECH_HOUSE_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_GOLDENROD_PPSPEECH_HOUSE_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_GOLDENROD_PPSPEECH_HOUSE_BG_003"] = ".............Una vez, en un\nbatalla, mi POKéMON no\npodría actuar.\fPUNTOS DE ENERGÍA,\no PP, sus golpes habían\nterminado.",
  ["TEXT_GOLDENROD_PPSPEECH_HOUSE_OBJ_001"] = "Una vez, en un\nbatalla, mi POKéMON no\npodría actuar.\fPUNTOS DE ENERGÍA,\no PP, sus golpes habían\nterminado.",
  ["TEXT_GOLDENROD_PPSPEECH_HOUSE_OBJ_002"] = "├Ç A veces, un\nPOKéMON sanos no pueden usarse\ntus golpes.\fSi esto ocurre,\ncurarte en el CENTRO POKéMON o usar un objeto.",
  ["TEXT_GOLDENROD_UNDERGROUND_BG_001"] = "Porta trancada…",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_001"] = "Acho que tenho que\nfazer as coisas\vdireito…",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_001_AFTER"] = "Acho que tenho que\nfazer as coisas\vdireito…",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_001_SEEN"] = "fui expulsado de\nRINCÓN DE JUEGO.\flo intenté\nhacer trampa con mi POKéMON…",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_002"] = "conozco el\nventajas tipográficas.\fPero solo uso uno\ntipo de POKÉMON.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_002_AFTER"] = "conozco el\nventajas tipográficas.\fPero solo uso uno\ntipo de POKÉMON.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_002_BEATEN"] = "Ai, ai, ai!",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_002_SEEN"] = "tomas el tipo\nen cuenta durante la batalla?\fSi conoces el\nLas ventajas del tipo funcionarán mejor.\nen batalla.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_003"] = "Tu POKéMON\nMe gustas más si das uno.\nTrato el pelaje.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_003_AFTER"] = "Tu POKéMON\nMe gustas más si das uno.\nTrato el pelaje.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_003_BEATEN"] = "Aiii!",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_003_SEEN"] = "mi pokemon\nAcaban de terminar de esquilar. Te mostraré cómo.\n¡son fuertes!",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_004"] = "Está fazendo uma\nPOKéDEX? Aqui vai\vuma dica boa.\fO HIKER da ROTA\n33, o ANTHONY, é\vgente boa.\fEle te liga se vir\nalgum POKéMON\vraro.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_004_AFTER"] = "Está fazendo uma\nPOKéDEX? Aqui vai\vuma dica boa.\fO HIKER da ROTA\n33, o ANTHONY, é\vgente boa.\fEle te liga se vir\nalgum POKéMON\vraro.",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_004_BEATEN"] = "Gaah! Eu perdi!\nQue raiva!",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_004_SEEN"] = "creo que tienes\nalgunos POKéMON raros ahí contigo.\f¡Déjeme ver!",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_007"] = "¡Bienvenido!\fyo manejo el\n¡SALÓN POKEMON!\fsoy el mayor y\nmejor de los dos HAIRCUT BROTHERS.\f¿Puedo dejar tu\nLindos POKéMON por sólo R$ 500.\fme gustaria\nde esto?",
  ["TEXT_GOLDENROD_UNDERGROUND_OBJ_008"] = "Bem-vindo ao\nPOKéMON SALON!\fSou o mais jovem\ne menos caro\vdos dois IRTOS\vCABELEIREIROS.\fVou arrumar seu\nPOKéMON por\vapenas R$300.\fComo vai?",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_BG_001"] = "Está escrito\nSWITCH 1.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_BG_002"] = "Está escrito\nSWITCH 2.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_BG_003"] = "Está escrito\nSWITCH 3.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_BG_004"] = "Está escrito\nEMERG├èNCIA.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_001"] = "Roubar e vender!\n├ë o básico do\vcrime, colega!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_001_AFTER"] = "Roubar e vender!\n├ë o básico do\vcrime, colega!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_001_BEATEN"] = "Piedade!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_001_SEEN"] = "Passe as suas\ncoisas para cá!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_002"] = "SUBTERRÁNEO\n¿ALMACÉN?\f¿Para qué quieres?\nir allí?\fno hay nada ahí\nabajo.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_002_AFTER"] = "SUBTERRÁNEO\n¿ALMACÉN?\f¿Para qué quieres?\nir allí?\fno hay nada ahí\nabajo.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_002_BEATEN"] = "Passou dos\nlimites!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_002_SEEN"] = "Abandonaram esta\nobra antes de\vterminar.\fEstou procurando\no que sobrou.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_003"] = "tienes sangre\nde hielo al pecho del ROCKET.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_003_AFTER"] = "tienes sangre\nde hielo al pecho del ROCKET.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_003_BEATEN"] = "Urk! ├ë, se acha\nesperto, hein?",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_003_SEEN"] = "No me importa si tu\nestá perdido.\fApareció aquí,\nse convirtió en víctima y ¡listo!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_004"] = "Droga! Afundei\npor indecisão!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_004_AFTER"] = "Eu também estou\nconfuso… O botão\fda ponta é o que\nse aperta antes…",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_004_BEATEN"] = "Droga! Afundei\npor indecisão!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_004_SEEN"] = "Abre una persiana,\notro cierra.\fApuesto que no\n¡llega a donde quieras!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_005"] = "Ai…\nEstraguei tudo.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_005_AFTER"] = "Bien. ¡Un consejo!\fCambiar el orden en\nque presionas.\fcambia la forma\nque las contraventanas se abran y cierren.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_005_BEATEN"] = "Ai…\nEstraguei tudo.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_005_SEEN"] = "¡Kwahaha!\fConfundido por el\npersianas, ¿verdad?\fle digo a uno\nsecreto si me ganas!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_006"] = "Ve a donde tu\nquiero! ¡Añádelo!\v¡No me importa!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_006_AFTER"] = "Ve a donde tu\nquiero! ¡Añádelo!\v¡No me importa!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_006_BEATEN"] = "¿Cómo pudiste?",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_006_SEEN"] = "¿Estás perdido? No,\nno puede ser.\fno tienes\ncara de miedo te daré\n¡Un motivo para tener miedo!",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_007"] = "Há lojas\nlá embaixo…\fMas também\nhá treinadores.\fTenho medo\nde descer.",
  ["TEXT_GOLDENROD_UNDERGROUND_SWITCH_ROOM_ENTRANCES_OBJ_008"] = "Fui desafiado\npara uma batalha\vlá embaixo.\f├ë perigoso\nlá. Melhor\vtomar cuidado.",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_001"] = "A TEAM ROCKET vai\nseguir em frente,\vesperando a volta\vdo GIOVANNI.\fFaremos o que for\npreciso.",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_001_AFTER"] = "A TEAM ROCKET vai\nseguir em frente,\vesperando a volta\vdo GIOVANNI.\fFaremos o que for\npreciso.",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_001_BEATEN"] = "Ele acabou comigo",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_001_SEEN"] = "como llegaste\nhasta ahora?\fNo hay manera.\nVoy a acabar contigo.",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_002"] = "Eu perdi…\fPor favor me\nperdoe, GIOVANNI!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_002_AFTER"] = "Eu perdi…\fPor favor me\nperdoe, GIOVANNI!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_002_BEATEN"] = "Droga!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_002_SEEN"] = "no pasas\n¡desde aquí!\fno tengo piedad\n¡De enemigos, ni de mocosos!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_003"] = "Hyuck-hyuck-hyuck!\nFoi demais!\vVou me lembrar!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_003_AFTER"] = "Hyuck-hyuck-hyuck!\nFoi demais!\vVou me lembrar!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_003_BEATEN"] = "Hyuck-hyuck-hyuck!\nEntão é assim?",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_003_SEEN"] = "¡Hyuck-hyuck-hyuck!\n¡Te recuerdo!\fme tienes\nescondido!",
  ["TEXT_GOLDENROD_UNDERGROUND_WAREHOUSE_OBJ_004"] = "DIRECTORA: ¿Quién?\n¿Qué? ¿Viniste a rescatarme?\f¡Gracias!\f¡LA TORRE DE RADIO!\fque es\npasando ahí?\fTomado por\n¿EQUIPO COHETE?\fAquí. tomar\nla LLAVE DE LA TARJETA.",
  ["TEXT_GUIDE_GENTS_HOUSE_BG_001"] = "...Quando eu era\npequeno, eu era um\vtreinador craque!\fVai um conselho:\npegue um monte\vde POKéMON!\fTrate todos eles\ncom bondade!",
  ["TEXT_GUIDE_GENTS_HOUSE_BG_002"] = "...Quando eu era\npequeno, eu era um\vtreinador craque!\fVai um conselho:\npegue um monte\vde POKéMON!\fTrate todos eles\ncom bondade!",
  ["TEXT_GUIDE_GENTS_HOUSE_OBJ_001"] = "Quando eu era\npequeno, eu era um\vtreinador craque!\fVai um conselho:\npegue um monte\vde POKéMON!\fTrate todos eles\ncom bondade!",
  ["TEXT_ICE_PATH_B1_F_OBJ_001"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_ICE_PATH_B1_F_OBJ_002"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_ICE_PATH_B1_F_OBJ_003"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_ICE_PATH_B1_F_OBJ_004"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_ICE_PATH_B3_F_OBJ_002"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_ILEX_FOREST_BG_001"] = "SANTUÁRIO DA\nILEX FOREST…\f├ë em honra ao\nprotetor da\vfloresta…\fOh? O que é isto?\f├ë um buraco.\nParece que a GS\vBALL caberia\vdentro dele.\fQuer colocar a GS\nBALL aqui?",
  ["TEXT_ILEX_FOREST_BG_005"] = "SANTUÁRIO DA\nILEX FOREST…\f├ë em honra ao\nprotetor da\vfloresta…\fOh? O que é isto?\f├ë um buraco.\nParece que a GS\vBALL caberia\vdentro dele.\fQuer colocar a GS\nBALL aqui?",
  ["TEXT_ILEX_FOREST_OBJ_002"] = "Oh, hombre... mi\nEl jefe se pondrá furioso... EL FARFETCH'D que\nutiliza CUT en los árboles para\nel carbón huyó.\fNo es posible para mi\nBúscalo aquí en ILEX FOREST.\f├ë grande, oscuro\ny aterrador...",
  ["TEXT_ILEX_FOREST_OBJ_003"] = "¡Oh! ¡EL FARFETCH'D!\f¿Lo encontraste?\n¿Para nosotros, muchacho?\fSin él, nosotros\nNo podría usar CUT para\nhacer carbón.\f¡Gracias muchacho!\f¿Cómo puedo\ngracias… ¡lo sé! Toma,\nquédate con esto.",
  ["TEXT_ILEX_FOREST_OBJ_004"] = "¿Qué debo hacer?\fsacudo los arboles\ncon CABEZAZO.\f├ë divertido. Pruebe\n¡tú también!",
  ["TEXT_ILEX_FOREST_OBJ_007"] = "Será que algo\naconteceu com o\vguardião da\vfloresta?",
  ["TEXT_ILEX_FOREST_OBJ_008"] = "Um POKéMON que eu\nnunca vi\fcaiu da árvore\nquando usei\vHEADBUTT.\fDevia usar\nHEADBUTT em\voutros lugares\vtambém.",
  ["TEXT_ILEX_FOREST_OBJ_008_AFTER"] = "Um POKéMON que eu\nnunca vi\fcaiu da árvore\nquando usei\vHEADBUTT.\fDevia usar\nHEADBUTT em\voutros lugares\vtambém.",
  ["TEXT_ILEX_FOREST_OBJ_008_BEATEN"] = "Eu nunca tinha\nvisto esse\vPOKéMON…",
  ["TEXT_ILEX_FOREST_OBJ_008_SEEN"] = "no llegues asi\n¡de repente!\fTu asustaste a uno\n¡POKÉMON!",
  ["TEXT_INDIGO_PLATEAU_POKECENTER1_F_OBJ_001"] = "En la LIGA POKéMON,\nserás probado por\nÉLITE CUATRO.\ftengo que ganar\ntodos. Si pierdes, tendrás que\n¡Empieza todo de nuevo!",
  ["TEXT_INDIGO_PLATEAU_POKECENTER1_F_OBJ_002"] = "En la LIGA POKéMON,\nserás probado por\nÉLITE CUATRO.\ftengo que ganar\ntodos. Si pierdes, tendrás que\n¡Empieza todo de nuevo!",
  ["TEXT_INDIGO_PLATEAU_POKECENTER1_F_OBJ_003"] = "En la LIGA POKéMON,\nserás probado por\nÉLITE CUATRO.\ftengo que ganar\ntodos. Si pierdes, tendrás que\n¡Empieza todo de nuevo!",
  ["TEXT_INDIGO_PLATEAU_POKECENTER1_F_OBJ_005"] = "¡Oh! lo harás\n¿Desafiar a los CUATRO DE ÉLITE? ¿Estás seguro?\n¿Qué está listo?\fSi necesitas\nentrenar más, mi ABRA puede\nayudarte.\fÉl puede TELEPORTARSE\nEstás en casa.\f¿Quieres ir?\n¿a casa ahora?",
  ["TEXT_KARENS_ROOM_OBJ_001"] = "Soy KAREN, de\nÉLITE CUATRO.\f¿Eres {PLAYER}?\nQue divertido.\fme encanta pokemon\nel tipo oscuro.\fcreo que la imagen\nsalvaje y duro de ellos atractivo. y\nson fuertes.\f¿Crees que puedes manejar\nde ellos? Sólo intenta entretenerme.\fVamos.",
  ["TEXT_KOGAS_ROOM_OBJ_001"] = "Fuahahahaha!\fSoy KOGA, dos\nÉLITE CUATRO.\fyo vivo en\n¡Sombras, ninja!\fmi estilo es\nintrincado y te destruirá!\fConfusión, sueño,\nveneno... Prepárate para\n¡Sé víctima de mi técnica!\fFuahahahaha!\fPOKéMON no es sólo\nfuerza bruta, ya verás que\n¡pronto, pronto!",
  ["TEXT_KURTS_HOUSE_BG_002"] = "…Um PROF.OAK\njovem?",
  ["TEXT_KURTS_HOUSE_BG_003"] = "…Um PROF.OAK\njovem?",
  ["TEXT_KURTS_HOUSE_BG_004"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_KURTS_HOUSE_BG_005"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_KURTS_HOUSE_BG_006"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_KURTS_HOUSE_BG_007"] = "├ë uma estátua do\nprotetor da\vfloresta.",
  ["TEXT_KURTS_HOUSE_OBJ_001"] = "¿Mmm? ¿Quién eres?\f {PLAYER}, ¿verdad? querer\npara que yo haga unas BOLAS?\fLo siento, pero esto\nesperará.\fConozca el EQUIPO\n¿COHETE? Ah, no importa. yo cuento\nde todos modos TEAM ROCKET es\nuna mala pandilla que usa POKéMON para\nel trabajo sucio.\ffue para ellos\nse disolvió hace tres años.\fEn definitiva, están en\nBIEN, cortando SLOWPOKETAILS a\nvender!\fentonces voy allí\n¡Enséñales una dolorosa lección!\fAgárrate fuerte,\n¡LENTO! ¡El viejo KURT se va!",
  ["TEXT_KURTS_HOUSE_OBJ_003"] = "SLOWPOKE: …\nBocejo?",
  ["TEXT_KURTS_HOUSE_OBJ_004"] = "KURT: Yo soy\ntrabajando!\v¡No me molestes!",
  ["TEXT_KURTS_HOUSE_OBJ_005"] = "ahora ayudo\nabuela├┤!\fHagamos BOLAS\nbien por ti, ¡así que espera!",
  ["TEXT_LAKE_OF_RAGE_BG_001"] = "CASA DO\nFISHING GURU",
  ["TEXT_LAKE_OF_RAGE_BG_002"] = "CASA DO\nFISHING GURU",
  ["TEXT_LAKE_OF_RAGE_HIDDEN_POWER_HOUSE_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_LAKE_OF_RAGE_HIDDEN_POWER_HOUSE_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_LAKE_OF_RAGE_HIDDEN_POWER_HOUSE_OBJ_001"] = "… vagabas mucho\nmuy lejos... Aquí medité.\nDentro de mí, un nuevo poder\ndesperté.\fDéjame dividir\nmi poder con tu POKéMON.\nToma, niña.",
  ["TEXT_LAKE_OF_RAGE_MAGIKARP_HOUSE_BG_001"] = ".LAKE OF RAGE es\nen realidad un cráter hecho por\nGYARADOS en furia El cráter se llenó\ndel agua de lluvia y así nació\nel LAGO.\f├ë la historia que\nvino del tatarabuelo├┤ del tatarabuelo├┤\nmi abuelo├┤.\fEn el pasado fue\npara pescar animado MAGIKARP\nahí, pero... no entiendo qué\nlo que está pasando.",
  ["TEXT_LAKE_OF_RAGE_MAGIKARP_HOUSE_BG_002"] = ".LAKE OF RAGE es\nen realidad un cráter hecho por\nGYARADOS en furia El cráter se llenó\ndel agua de lluvia y así nació\nel LAGO.\f├ë la historia que\nvino del tatarabuelo├┤ del tatarabuelo├┤\nmi abuelo├┤.\fEn el pasado fue\npara pescar animado MAGIKARP\nahí, pero... no entiendo qué\nlo que está pasando.",
  ["TEXT_LAKE_OF_RAGE_MAGIKARP_HOUSE_OBJ_001"] = "EL LAGO DE LA IRA es\nen realidad un cráter hecho por\nGYARADOS en furia El cráter se llenó\ndel agua de lluvia y así nació\nel LAGO.\f├ë la historia que\nvino del tatarabuelo├┤ del tatarabuelo├┤\nmi abuelo├┤.\fEn el pasado fue\npara pescar animado MAGIKARP\nahí, pero... no entiendo qué\nlo que está pasando.",
  ["TEXT_LAKE_OF_RAGE_OBJ_001"] = "este lago es\nlleno de GYARADOS y nada más… Entonces el MAGIKARP\nse ven obligados a evolucionar...",
  ["TEXT_LAKE_OF_RAGE_OBJ_002"] = "Los GYARADOS son\nfurioso!\f├ë ¡mal augurio!",
  ["TEXT_LAKE_OF_RAGE_OBJ_003"] = "Ouvi que este lago\nfoi feito por\vGYARADOS em fúria\fSerá que tem\nalguma ligação\fcom esse surto\ntodo de agora?",
  ["TEXT_LAKE_OF_RAGE_OBJ_004"] = "mis ojos\nengañado? Vi un GYARADOS\nrojo en el LAGO… Pero pensé que\nLos GYARADOS eran azules, ¿no?",
  ["TEXT_LAKE_OF_RAGE_OBJ_005"] = "no pierdo como\npescador! Pesco POKéMON todos los días.",
  ["TEXT_LAKE_OF_RAGE_OBJ_005_AFTER"] = "no pierdo como\npescador! Pesco POKéMON todos los días.",
  ["TEXT_LAKE_OF_RAGE_OBJ_005_BEATEN"] = "Sou bom pescador,\nmas péssimo como\ftreinador de\nPOKéMON…",
  ["TEXT_LAKE_OF_RAGE_OBJ_005_SEEN"] = "Déjame luchar\ncon el POKéMON que acabo de atrapar!",
  ["TEXT_LAKE_OF_RAGE_OBJ_006"] = "¿Por qué no lo entiendo?\n¿buenos POKEMON?",
  ["TEXT_LAKE_OF_RAGE_OBJ_006_AFTER"] = "¿Por qué no lo entiendo?\n¿buenos POKEMON?",
  ["TEXT_LAKE_OF_RAGE_OBJ_006_BEATEN"] = "mi linea es\ntodos avergonzados...",
  ["TEXT_LAKE_OF_RAGE_OBJ_006_SEEN"] = "No importa qué\nhazlo, solo atrapo el mismo POKéMON…",
  ["TEXT_LAKE_OF_RAGE_OBJ_007"] = "POKéMON e o dono\nficam fortes\fcom batalha\nconstante.",
  ["TEXT_LAKE_OF_RAGE_OBJ_007_AFTER"] = "POKéMON e o dono\nficam fortes\fcom batalha\nconstante.",
  ["TEXT_LAKE_OF_RAGE_OBJ_007_BEATEN"] = "Ufa…\nBoa batalha.",
  ["TEXT_LAKE_OF_RAGE_OBJ_007_SEEN"] = "Se um treinador vê\noutro, ele tem\fque fazer um\ndesafio. Esse\fé o nosso\ndestino.",
  ["TEXT_LAKE_OF_RAGE_OBJ_008"] = "Pensando bem,\nvi um BUTTERFREE\vrosa.",
  ["TEXT_LAKE_OF_RAGE_OBJ_008_AFTER"] = "Pensando bem,\nvi um BUTTERFREE\vrosa.",
  ["TEXT_LAKE_OF_RAGE_OBJ_008_BEATEN"] = "¡Muy bien!",
  ["TEXT_LAKE_OF_RAGE_OBJ_008_SEEN"] = "que paso\ncon los GYARADOS rojos? ¿Desapareció?\fDroga. yo vine\n├¿para nada?\flo sé, vámonos\nbatalla!",
  ["TEXT_LAKE_OF_RAGE_OBJ_009"] = "GYARADOS: Gyasha!",
  ["TEXT_LAKE_OF_RAGE_OBJ_010"] = "WESLEY: Hola, ¿cómo\n¿Vas a ir?\fya que hoy es\nMiércoles, soy WESLEY de\ncuarto.",
  ["TEXT_LANCES_ROOM_OBJ_001"] = "LANZA: Yo estaba\nesperando por ti.\f {PLAYER} !\fte conocí,\ncon tu talento se acabaría\nllegando a mí.\fno es momento de\npalabras ahora.\fluchemos\npara decidir quien es el mas fuerte\nde nosotros dos.\fcomo el entrenador\nmás poderoso y como CAMPEÓN de\nLIGA POKéMON… YO, LANCE, maestro\nde los dragones, acepto el desafío!",
  ["TEXT_LAVENDER_MART_OBJ_001"] = "REPELIR es una cosa\nnecesario si vas a explorar un\ncueva.\faunque me gusta\nexplorar, todavía no he estado en todos\nlas cuevas.",
  ["TEXT_LAVENDER_NAME_RATER_OBJ_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_LAVENDER_POKECENTER1_F_OBJ_001"] = "Ao norte de\nLAVENDER fica o\vROCK TUNNEL.\fAtravesse ele pra\nchegar na POWER\vPLANT.",
  ["TEXT_LAVENDER_POKECENTER1_F_OBJ_002"] = "Ao norte de\nLAVENDER fica o\vROCK TUNNEL.\fAtravesse ele pra\nchegar na POWER\vPLANT.",
  ["TEXT_LAVENDER_POKECENTER1_F_OBJ_003"] = "Hay un programa\nradio que reproduce FLAUTA POKé.\f¿Oh? tu radio\nNecesitas la TARJETA EXPN para conseguirla.",
  ["TEXT_LAVENDER_POKECENTER1_F_OBJ_004"] = "Si CENTRAL ELÉCTRICA\nno funciona, el TREN MAGNETICO tampoco se mueve... Y también quiere\ndecir que ESTACION DE RADIO no transmite…",
  ["TEXT_LAVENDER_SPEECH_HOUSE_BG_001"] = "..LAVENDER é uma\nvila pequena e\fquieta, no pé da\nmontanha.\fFicou um pouco\nmais movimentada\fdesde que a RADIO\nTOWER foi feita.",
  ["TEXT_LAVENDER_SPEECH_HOUSE_BG_002"] = "..LAVENDER é uma\nvila pequena e\fquieta, no pé da\nmontanha.\fFicou um pouco\nmais movimentada\fdesde que a RADIO\nTOWER foi feita.",
  ["TEXT_LAVENDER_SPEECH_HOUSE_OBJ_001"] = "LAVENDER é uma\nvila pequena e\fquieta, no pé da\nmontanha.\fFicou um pouco\nmais movimentada\fdesde que a RADIO\nTOWER foi feita.",
  ["TEXT_LAVENDER_TOWN_OBJ_001"] = "Que prédio é\nesse, hein?\f├ë a TORRE de\nRÁDIO de KANTO.",
  ["TEXT_LAVENDER_TOWN_OBJ_002"] = "KANTO tiene mucho\nprograma de radio",
  ["TEXT_LAVENDER_TOWN_OBJ_003"] = "As pessoas vêm de\nlonge para\fhomenagear as\nalmas dos\vPOKéMON.",
  ["TEXT_LAVENDER_TOWN_OBJ_004"] = "necesitas\nuna FLAUTA POKé para despertar a POKéMON. Todos\n¡El entrenador lo sabe!",
  ["TEXT_LAV_RADIO_TOWER1_F_OBJ_001"] = "Bem-vindo!\nFique ├á vontade\fpara olhar tudo\nneste andar.",
  ["TEXT_LAV_RADIO_TOWER1_F_OBJ_002"] = "Lo siento, pero tu\nSólo se puede visitar la planta baja.\fdesde RADIO\nLa TORRE JOHTO fue tomada por un\npandilla, tuvimos que reforzar\nseguridad.",
  ["TEXT_LAV_RADIO_TOWER1_F_OBJ_003"] = "Mucha gente aquí\ntrabaja duro en RADIO\nTORRE.\fDeben estar dando\nlo mejor para buenos programas.",
  ["TEXT_LAV_RADIO_TOWER1_F_OBJ_004"] = "¡Ay, no, no!\festamos fuera\naire desde la CENTRAL ELÉCTRICA\ndetenido.\fTodo el esfuerzo de\nAbrir esta radio se convierte en polvo si\nno emitido.\f¡Estoy arruinado!",
  ["TEXT_LAV_RADIO_TOWER1_F_OBJ_005"] = "¡Hola camarada!\fsoy súper\n¡DIRECTOR DE MÚSICA!\f¿Hay? Tu POKéGEAR\nNo entiendas mis programas.\n¡Qué mala suerte!\fSi toma EXPN\nTARJETA, ¿puedes oírla?\n¡Ve a buscar uno!",
  ["TEXT_MAHOGANY_GYM_OBJ_001"] = "pokémon en vivo\nmuchas cosas en sus vidas, como\ncomo nosotros.\fyo también he visto\ny sufrí mucho en mi vida.\fcomo soy mas\nViejo, déjame mostrarte lo que es.\ftengo pokemon\ndesde antes de ti\nnacer.\fno pierdo\nfácil.\fYo, PRYCE, el\nentrenador de invierno, me voy\nmuestra mi poder",
  ["TEXT_MAHOGANY_GYM_OBJ_002"] = "sin patinar con\nprecisión, no llegarás muy lejos\nen este GIMNASIO.",
  ["TEXT_MAHOGANY_GYM_OBJ_002_AFTER"] = "sin patinar con\nprecisión, no llegarás muy lejos\nen este GIMNASIO.",
  ["TEXT_MAHOGANY_GYM_OBJ_002_BEATEN"] = "yo no perdería\n¡tú a esquiar!",
  ["TEXT_MAHOGANY_GYM_OBJ_002_SEEN"] = "para llegar al\nPRYCE, necesitas pensar\nantes de patinar.",
  ["TEXT_MAHOGANY_GYM_OBJ_003"] = "Acho que existe um\nmovimento que um\fPOKéMON pode usar\nmesmo congelado.",
  ["TEXT_MAHOGANY_GYM_OBJ_003_AFTER"] = "Acho que existe um\nmovimento que um\fPOKéMON pode usar\nmesmo congelado.",
  ["TEXT_MAHOGANY_GYM_OBJ_003_BEATEN"] = "Droga. no pude\nno hacer nada.",
  ["TEXT_MAHOGANY_GYM_OBJ_003_SEEN"] = "me congelaré\n¡Tú POKéMON, no harás nada!",
  ["TEXT_MAHOGANY_GYM_OBJ_004"] = "no debería haber\nMe jactaba de mi esquí...",
  ["TEXT_MAHOGANY_GYM_OBJ_004_AFTER"] = "no debería haber\nMe jactaba de mi esquí...",
  ["TEXT_MAHOGANY_GYM_OBJ_004_BEATEN"] = "¡No! tu me hiciste\ncaer!",
  ["TEXT_MAHOGANY_GYM_OBJ_004_SEEN"] = "ver mi\ngiro paralelo!",
  ["TEXT_MAHOGANY_GYM_OBJ_005"] = "me encanta patinar\ncon mis POKéMON en este GIMNASIO!",
  ["TEXT_MAHOGANY_GYM_OBJ_005_AFTER"] = "me encanta patinar\ncon mis POKéMON en este GIMNASIO!",
  ["TEXT_MAHOGANY_GYM_OBJ_005_BEATEN"] = "¿Ves como\n¿Hablamos en serio?",
  ["TEXT_MAHOGANY_GYM_OBJ_005_SEEN"] = "este gimnasio\nTiene piso liso.\f├ë divertido, no\n¿lo es?\fPero bueno, aquí estamos.\n¡No estamos bromeando!",
  ["TEXT_MAHOGANY_GYM_OBJ_006"] = "O segredo do\npoder de PRYCE…\fEle medita sob\numa cachoeira\fpara fortalecer\nmente e corpo.",
  ["TEXT_MAHOGANY_GYM_OBJ_006_AFTER"] = "O segredo do\npoder de PRYCE…\fEle medita sob\numa cachoeira\fpara fortalecer\nmente e corpo.",
  ["TEXT_MAHOGANY_GYM_OBJ_006_BEATEN"] = "Vou te contar o\nsegredo do PRYCE.",
  ["TEXT_MAHOGANY_GYM_OBJ_006_SEEN"] = "Conheço o segredo\ndo PRYCE.",
  ["TEXT_MAHOGANY_GYM_OBJ_007"] = "PRYCE es un veterano\ny ha estado entrenando POKéMON durante algunos\n50 años.\fdicen que el es\nbueno para congelar oponentes con\ngolpes de hielo.\fEs decir, tienes\nQue lo derrita con tu ambición\n¡en llamas!",
  ["TEXT_MAHOGANY_MART1_F_OBJ_001"] = "Arrgh… ¿pensaste\nla escalera secreta...",
  ["TEXT_MAHOGANY_MART1_F_OBJ_002"] = "Jejeje! oh\nEl experimento funcionó a las mil maravillas.\fMAGIKARP no valen\nnada mas que GYARADOS dan mucho\ndinero.",
  ["TEXT_MAHOGANY_POKECENTER1_F_OBJ_001"] = "¿Qué es eso? un\n¿El equipo ROCKET ha vuelto?\fvi algunos hombres\nnegro en LAKE OF RAGE…",
  ["TEXT_MAHOGANY_POKECENTER1_F_OBJ_002"] = "¿Qué es eso? un\n¿El equipo ROCKET ha vuelto?\fvi algunos hombres\nnegro en LAKE OF RAGE…",
  ["TEXT_MAHOGANY_POKECENTER1_F_OBJ_003"] = "sostengo mi POKEMON\nde evolucionar demasiado pronto.\fles hago aprender\nciertos movimientos antes de dejarlos evolucionar.",
  ["TEXT_MAHOGANY_RED_GYARADOS_SPEECH_HOUSE_OBJ_001"] = "Ouvi que apareceu\num GYARADOS\vvermelho no LAKE.\f├ë estranho, pois\naté GYARADOS\fcomuns são raros\nnaquele lago…",
  ["TEXT_MAHOGANY_RED_GYARADOS_SPEECH_HOUSE_OBJ_002"] = "mi programa\n¿Radio favorita? MÚSICA POKÉMON.",
  ["TEXT_MAHOGANY_TOWN_OBJ_001"] = "EL RAGECANDYBAR\nagotado.\fEstoy cerrando.\nNo me molestes, pequeño.",
  ["TEXT_MAHOGANY_TOWN_OBJ_002"] = "Vai lá ver o\nGYARADOS em fúria\vno LAKE?",
  ["TEXT_MAHOGANY_TOWN_OBJ_003"] = "Desde que llegaste\naquí aprovecha para pasear\npoco.\fIr al norte\ny echa un vistazo al LAGO DE LA RAGE\nahora mismo.",
  ["TEXT_MAHOGANY_TOWN_OBJ_004"] = "visita la tienda\nAbuelo. Ella vende cosas que la mayoría\nnadie lo ha hecho.",
  ["TEXT_MANIAS_HOUSE_OBJ_001"] = "¡Estoy en shock!\fun chico como tu\nedad, con mirada dura y cabello\nentró hace mucho tiempo.\fMe asustó y\n¡Tomé mi preciado POKéMON!\ftodavía tengo uno,\n¿Pero qué pasa si regresa?\fTe ves fuerte.\n¿Puedes cuidar de mi POKéMON?\npor un tiempo?",
  ["TEXT_MOBILE_BATTLE_ROOM_BG_001"] = "Seus POKéMON\nserão totalmente\vcurados antes\vda batalha.",
  ["TEXT_MOBILE_TRADE_ROOM_BG_001"] = "Estabelecendo\ncomunicação…",
  ["TEXT_MOUNT_MOON_GIFT_SHOP_OBJ_001"] = "Quando o sol se\np├Áe, os CLEFAIRY\vvêm brincar.",
  ["TEXT_MOUNT_MOON_GIFT_SHOP_OBJ_002"] = "Quando o sol se\np├Áe, os CLEFAIRY\vvêm brincar.",
  ["TEXT_MOUNT_MOON_SQUARE_BG_002"] = "PLAZA MONTE LUNA\nNo tires basura",
  ["TEXT_MOUNT_MOON_SQUARE_OBJ_003"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_001"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_007"] = "Hace un tiempo, un\nEl chico del karate quería pelear.\nEra demasiado bueno.\fel nosotros\nse rompió fácilmente.\fel era mas\nfondo diciendo que estaba entrenando. ¿Será\n¿Cómo está él?",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_007_AFTER"] = "Hace un tiempo, un\nEl chico del karate quería pelear.\nEra demasiado bueno.\fel nosotros\nse rompió fácilmente.\fel era mas\nfondo diciendo que estaba entrenando. ¿Será\n¿Cómo está él?",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_007_BEATEN"] = "perdí contra uno\nniño…?",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_007_SEEN"] = "no perderé\nesta vez!",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_008"] = "vine a explorar\nMT.MORTAR, pero me separé de\nmi compañero... Encontraste un\nentrenador que utiliza un SEADRA que\n¿Conoces CASCADA?",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_008_AFTER"] = "vine a explorar\nMT.MORTAR, pero me separé de\nmi compañero... Encontraste un\nentrenador que utiliza un SEADRA que\n¿Conoces CASCADA?",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_008_BEATEN"] = "Te confundi com\noutra pessoa…",
  ["TEXT_MOUNT_MORTAR1_FINSIDE_OBJ_008_SEEN"] = "Ei! HUGH!",
  ["TEXT_MOUNT_MORTAR2_FINSIDE_OBJ_007"] = "yo soy\ninvestigando MT.MORTAR, pero mi compañero desapareció.\f¿Has visto un\nentrenador que tiene un SLOWPOKE que\n¿Conoces la FORTALEZA?",
  ["TEXT_MOUNT_MORTAR2_FINSIDE_OBJ_007_AFTER"] = "yo soy\ninvestigando MT.MORTAR, pero mi compañero desapareció.\f¿Has visto un\nentrenador que tiene un SLOWPOKE que\n¿Conoces la FORTALEZA?",
  ["TEXT_MOUNT_MORTAR2_FINSIDE_OBJ_007_BEATEN"] = "Foi mal, engano\nmeu.",
  ["TEXT_MOUNT_MORTAR2_FINSIDE_OBJ_007_SEEN"] = "Ei! MARKUS!",
  ["TEXT_MOUNT_MORTAR_B1_F_OBJ_004"] = "¡Ey!\fyo soy kárate\n¡REY!\fyo entreno solo\naquí en la oscuridad!\f¡Tú!\n¡Lucha conmigo!\f¡Hwaaarggh!",
  ["TEXT_MOVE_DELETERS_HOUSE_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_MOVE_DELETERS_HOUSE_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_MOVE_DELETERS_HOUSE_OBJ_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_MR_FUJIS_HOUSE_BG_001"] = ".MR.FUJI vive\naquí, pero no en casa.\fEl debe estar en\nCASA DEL ALMA.",
  ["TEXT_MR_FUJIS_HOUSE_BG_002"] = ".MR.FUJI vive\naquí, pero no en casa.\fEl debe estar en\nCASA DEL ALMA.",
  ["TEXT_MR_FUJIS_HOUSE_OBJ_001"] = "El señor Fuji vive.\naquí, pero no en casa.\fEl debe estar en\nCASA DEL ALMA.",
  ["TEXT_MR_FUJIS_HOUSE_OBJ_002"] = "Hay gente de\nCorazón frío que deja caer el POKéMON.\fv├┤ da la bienvenida a la\npersonas pobres sin hogar y los cuida con\ncariño.",
  ["TEXT_MR_POKEMONS_HOUSE_OBJ_001"] = "estoy contando\ncontigo!",
  ["TEXT_MR_PSYCHICS_HOUSE_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_MR_PSYCHICS_HOUSE_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_MR_PSYCHICS_HOUSE_OBJ_001"] = "… … … …¡Lo sé!\f¡Querías esto!",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_001"] = "DON: Lo haré\n¡gana! No me molestes.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_002"] = "ED: Mi PARASECTO\nhace que POKéMON duerma con SPORE.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_003"] = "NICK: Crio\nPOKéMON rápidos\vpara batalhas.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_004"] = "GUILLERMO: Yo no.\nMe importa ganar.\fsolo estoy mirando\nPOKÉMON raros.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_005"] = "BENNY: ¡Ssh!\nAsustará a SCYTHER. yo hablo\ncontigo más tarde.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_006"] = "barry: tu\ndebería debilitar a los POKéMON insectos,\njugar POKé BOLA.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_007"] = "cindy: me encanta\nInsecto POKéMON.\fcreo que tu\ntambién le gusta.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_008"] = "JOSH: Yo colecciono\nInsecto POKéMON desde que era\nbien niño.\fNo hay manera\n¡Yo ganaré!",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_009"] = "SAMUEL: Se tem\ntempo para\fconversar, procure\nPOKéMON inseto.",
  ["TEXT_NATIONAL_PARK_BUG_CONTEST_OBJ_010"] = "kipp: estudié\nmucho sobre POKéMON insectos.\fvoy a ganar\nseguro.",
  ["TEXT_NATIONAL_PARK_OBJ_001"] = "¡Mirar! ver el mio\nbolsa!\fimprimir el mio\nFavoritos y pegados de POKéDEX\nen mi bolso.",
  ["TEXT_NATIONAL_PARK_OBJ_002"] = "Este es un CORREO de\nmi hija.\vElla me anima.",
  ["TEXT_NATIONAL_PARK_OBJ_003"] = "Atención, por\n¡por favor!\f…Ups, necesito\ndeja de pensar como un maestro\ntodo el tiempo.\fDebes ser un\nEntrenador POKéMON Ya que te esfuerzas\ntanto, quiero que te quedes con\nesto.",
  ["TEXT_NATIONAL_PARK_OBJ_004"] = "Estou brincando\ncom adesivos que\vtirei da POKéDEX.",
  ["TEXT_NATIONAL_PARK_OBJ_005"] = "Se eu ganhar, fico\ncom o adesivo da\vPOKéDEX dele.",
  ["TEXT_NATIONAL_PARK_OBJ_006"] = "yo camino a través\nPARK, pero nunca entro en medio de\narbusto.\fEntrenadores siempre\nquieren pelear...",
  ["TEXT_NATIONAL_PARK_OBJ_007"] = "PERSIAN: Fufusha!",
  ["TEXT_NATIONAL_PARK_OBJ_008_AFTER"] = "hay mucho\nqué aprender.\fPor ejemplo… Hay 50 tipos\nde TM.\fPOKEMON intercambiado\nsubir más rápido",
  ["TEXT_NATIONAL_PARK_OBJ_008_BEATEN"] = "O-o quê?",
  ["TEXT_NATIONAL_PARK_OBJ_008_SEEN"] = "El mundo POKÉMON\nEs profundo.\ftodavía hay\nmuchas cosas que no sabemos.\fPero sé más\nque tu!",
  ["TEXT_NATIONAL_PARK_OBJ_009_AFTER"] = "Devo dizer que\nseus POKéMON\vtambém são bem\vfofos.",
  ["TEXT_NATIONAL_PARK_OBJ_009_BEATEN"] = "Tal vez yo no\nganarte en la pelea... Pero los míos son\nmucho más hermoso.",
  ["TEXT_NATIONAL_PARK_OBJ_009_SEEN"] = "Mis POKéMON son\nsolo un poco de amor.\fDéjame decirte\nel orgullo que siento por ellos.",
  ["TEXT_NATIONAL_PARK_OBJ_010"] = "perdí la batalla,\npero mis POKéMON ganan el premio\nporque son lindos.",
  ["TEXT_NATIONAL_PARK_OBJ_010_AFTER"] = "perdí la batalla,\npero mis POKéMON ganan el premio\nporque son lindos.",
  ["TEXT_NATIONAL_PARK_OBJ_010_BEATEN"] = "¡M-mi POKEMON!",
  ["TEXT_NATIONAL_PARK_OBJ_010_SEEN"] = "Amamos a nuestro\nPOKéMON, aunque no les guste.\f├ë eso es lo que es\nser un FAN.",
  ["TEXT_NATIONAL_PARK_OBJ_011"] = "Por tu mirada,\nPensé que te gustaba.\fDespués de todo, soy\nlindo!",
  ["TEXT_NATIONAL_PARK_OBJ_011_AFTER"] = "Por tu mirada,\nPensé que te gustaba.\fDespués de todo, soy\nlindo!",
  ["TEXT_NATIONAL_PARK_OBJ_011_SEEN"] = "¿Hola? ¿Por qué tu\n¿Me estás mirando?\fAh, ¿una batalla?",
  ["TEXT_NATIONAL_PARK_OBJ_013"] = "estoy imprimiendo el\nmi POKéDEX.\fSe puede imprimir\notras cosas, como MAIL y sus\nCAJAS DE PC.",
  ["TEXT_NEW_BARK_TOWN_OBJ_001"] = "Uau, sua POKéGEAR\né incrível!\fFoi sua mãe quem\nlhe deu ela?",
  ["TEXT_NEW_BARK_TOWN_OBJ_002"] = "Ei, {PLAYER}!\fSoube que o PROF.\nELM descobriu\vnovos POKéMON.",
  ["TEXT_NEW_BARK_TOWN_OBJ_003"] = "…… Entonces este es el\nEl famoso POKéMON LABORATORIO de ELM…",
  ["TEXT_OAKS_LAB_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_003"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_004"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_005"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_006"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_007"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_008"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_009"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_010"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_011"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_BG_012"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_OAKS_LAB_OBJ_001"] = "ROBLE: ¡Oh, {PLAYER}!\nMe alegro que hayas llegado tan lejos\nhasta KANTÓ.\f¿Qué piensas?\nde los entrenadores aquí?\nBastante duro, ¿verdad?",
  ["TEXT_OAKS_LAB_OBJ_002"] = "El programa POKéMON\nLA CHARLA DEL PROF no aparece aquí\nen KANTÓ.\f├ë una pena, yo\nquería escuchar.",
  ["TEXT_OAKS_LAB_OBJ_003"] = "Gracias a tu\ntrabajo en POKéDEX, la investigación del PROF va\nmuy bien.",
  ["TEXT_OAKS_LAB_OBJ_004"] = "no digas\nnadie, pero POKéMON TALK no es\nvivir.",
  ["TEXT_OLIVINE_CAFE_OBJ_001"] = "¡Ja! Tu POKEMON\n¡Realmente parecen pesos ligeros!\fno tienen fuerza\npara apartar las rocas.\fToma, usa esto\n¡Y enséñales el movimiento de FUERZA!\fNecesitarás el\nINSIGNIA DE GIMNASIO GOLDENROD para\nusar fuera de la pelea",
  ["TEXT_OLIVINE_CAFE_OBJ_002"] = "O cardápio do\nOLIVINE CAFE é\fcheio de comida\nreforçada pros\vSAILORS fort├Áes!",
  ["TEXT_OLIVINE_CAFE_OBJ_003"] = "{RAM:004A} ¡oh! Tu POKEMON\n¡se ven débiles!\fno tienen fuerza\npara mover rocas.\fToma, usa esto y\n¡Enséñales FUERZA!",
  ["TEXT_OLIVINE_CITY_BG_001"] = "norte\napareciendo últimamente.\f¿Viste ese lago?\nfrente a la casa?\fHay GRIMER viviendo\nallí ahora.\f¿De dónde vinieron?\nEste es un problema grave…",
  ["TEXT_OLIVINE_CITY_BG_002"] = "norte\napareciendo últimamente.\f¿Viste ese lago?\nfrente a la casa?\fHay GRIMER viviendo\nallí ahora.\f¿De dónde vinieron?\nEste es un problema grave…",
  ["TEXT_OLIVINE_CITY_BG_003"] = "norte\napareciendo últimamente.\f¿Viste ese lago?\nfrente a la casa?\fHay GRIMER viviendo\nallí ahora.\f¿De dónde vinieron?\nEste es un problema grave…",
  ["TEXT_OLIVINE_CITY_OBJ_001"] = "Caminos oscuros\nSon peligrosos por la noche.\fPero en la oscuridad\nnoche completa, el mar esta en calma\n¡Más traicionero!\fSin luz del faro\nde FARO a guía, barco\nninguno navega.",
  ["TEXT_OLIVINE_CITY_OBJ_002"] = "Esta cosa que\nLo tienes, es un POKéGEAR, ¿verdad? Vaya, qué genial.",
  ["TEXT_OLIVINE_CITY_OBJ_003"] = "Olá, rapazinho!\nO mar é doce!\fCante comigo!\nEi-├┤! Puxa a corda\vcom força!…",
  ["TEXT_OLIVINE_GOOD_ROD_HOUSE_OBJ_001"] = "OLIVINE fica no\nmar!\fE se fica no mar,\ncom certeza há\vpeixes!\fPesco aqui há\n30 anos.\fQuer encarar o\nmar e pescar\vtambém?",
  ["TEXT_OLIVINE_GYM_OBJ_001"] = "…Gracias por tu\nayuda en LEUCHTTURM... Pero esto es\ndiferente. Por favor permítame\npresente.\fSoy JAZMÍN, LÍDER\nde GIMNASIO. Yo uso el tipo de acero.\f… ¿Conoces el\ntipo de acero?\f├ë un chico que era\ndescubierto muy recientemente.\f…Um… ¿Estamos empezando?",
  ["TEXT_OLIVINE_GYM_OBJ_002"] = "JAZMÍN utiliza el\ntipo acero, que es muy reciente.\fcasi no lo sé\nnada sobre él.",
  ["TEXT_OLIVINE_HOUSE_BETA_BG_002"] = "...Cuando mi POKEMON\ncayó enfermo, el FARMACÉUTICO de\nECRUTEAK me preparó un medicamento.",
  ["TEXT_OLIVINE_HOUSE_BETA_OBJ_001"] = "Cuando mi POKEMON\ncayó enfermo, el FARMACÉUTICO de\nECRUTEAK me preparó un medicamento.",
  ["TEXT_OLIVINE_HOUSE_BETA_OBJ_002"] = "RHYDON: Grrugooh!",
  ["TEXT_OLIVINE_LIGHTHOUSE1_F_OBJ_001"] = "La gente entrena\nen este FARO.\fNo es fácil escalar\ngracias a todos los entrenadores.",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_001"] = "¡Qué fuerza!\n¿Qué tal si navegas por los mares?\nconmigo?",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_001_BEATEN"] = "Argh!\nEu perco!",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_001_SEEN"] = "Homens do mar\nsempre querem\vuma boa briga!",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_002"] = "Arriba hay un\nPOKéMON que mantiene encendido el faro.\fPero lo escuché\nestá enfermo y no sanará\nmedicina común.",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_002_AFTER"] = "Arriba hay un\nPOKéMON que mantiene encendido el faro.\fPero lo escuché\nestá enfermo y no sanará\nmedicina común.",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_002_BEATEN"] = "¡Oh! puedes ver\nque hablas en serio.",
  ["TEXT_OLIVINE_LIGHTHOUSE2_F_OBJ_002_SEEN"] = "¿Mmm? aqui no esta\nlugar para jugar.",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_001"] = "Toda vez que volto\na OLIVINE, eu\vvisito o GINÁSIO.\fO tipo de POKéMON\nda LÍDER mudou\fsem que eu\npercebesse.",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_001_AFTER"] = "Toda vez que volto\na OLIVINE, eu\vvisito o GINÁSIO.\fO tipo de POKéMON\nda LÍDER mudou\fsem que eu\npercebesse.",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_001_BEATEN"] = "Eres bueno y\nfuerte también...",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_001_SEEN"] = "Los marineros son\nbueno y fuerte.\v¿Y tú?",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_003"] = "¿Cómo diablos si\n¿Subir aquí?\fquiero visitar el\nPOKéMON enfermo, pero no puedo\nllegar allí…",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_003_AFTER"] = "¿Cómo diablos si\n¿Subir aquí?\fquiero visitar el\nPOKéMON enfermo, pero no puedo\nllegar allí…",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_003_BEATEN"] = "¿te importa?\nde verdad...",
  ["TEXT_OLIVINE_LIGHTHOUSE3_F_OBJ_003_SEEN"] = "¿Por qué estás aquí?\n¿Acabas de venir a mirar?\fYo sugiero que\n¡te vas!",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_001"] = "Falando em doente,\nouvi que tem\fuma boa farmácia\nem CIANWOOD.",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_001_AFTER"] = "Falando em doente,\nouvi que tem\fuma boa farmácia\nem CIANWOOD.",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_001_BEATEN"] = "Yo tampoco\npuedo sonreír...",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_001_SEEN"] = "JAZMÍN debe\nestar muy preocupado por los POKéMON aquí.\fElla ni siquiera sonríe\nmás estos días.",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_002"] = "Certo. Qualquer um\nficaria preocupado\vse o POKéMON dele\vestivesse ferido.\fVou rezar pelo\nPOKéMON daqui,\fpara a JASMINE\nvoltar ao GINÁSIO",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_002_AFTER"] = "Certo. Qualquer um\nficaria preocupado\vse o POKéMON dele\vestivesse ferido.\fVou rezar pelo\nPOKéMON daqui,\fpara a JASMINE\nvoltar ao GINÁSIO",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_002_BEATEN"] = "Aaai! POKéMON!",
  ["TEXT_OLIVINE_LIGHTHOUSE4_F_OBJ_002_SEEN"] = "A JASMINE é a\nLÍDER daqui.\fPretendo trazer\nela de volta.\f├ë melhor ninguém\natrapalhar!",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_001"] = "UN LÍDER no es sólo\ncuestión de ser fuerte. UN LÍDER\nTambién necesitas tener compasión.",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_001_AFTER"] = "UN LÍDER no es sólo\ncuestión de ser fuerte. UN LÍDER\nTambién necesitas tener compasión.",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_001_BEATEN"] = "Vaya, vaya. tu eres\ndevastador!",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_001_SEEN"] = "quería luchar\ncon JASMINE, pero ella no\nbueno. ¿Quieres pelear?",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_002"] = "mi pokemon\nAprendí a usar FLY en CIANWOOD.\fBueno, ¿cómo me lo perdí?\nUsaré FLY para cruzar el mar…",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_002_AFTER"] = "mi pokemon\nAprendí a usar FLY en CIANWOOD.\fBueno, ¿cómo me lo perdí?\nUsaré FLY para cruzar el mar…",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_002_BEATEN"] = "Opa…Eles caíram…",
  ["TEXT_OLIVINE_LIGHTHOUSE5_F_OBJ_002_SEEN"] = "Estamos bem alto\naqui. Meus\fPOKéMON pássaro\nem plena forma.",
  ["TEXT_OLIVINE_LIGHTHOUSE6_F_OBJ_001"] = "JAZMÍN: …Esto\nPOKéMON siempre ha mantenido el mar\niluminado por la noche.\f...pero el\ncayó enfermo... Está jadeando... ...Sé que hay\nuna gran FARMACIA en\nCIANWOOD… Pero eso queda\nmás allá del mar... Y no puedo\ndeja AMPHY…",
  ["TEXT_OLIVINE_LIGHTHOUSE6_F_OBJ_002"] = "A respiração\nestá difícil…",
  ["TEXT_OLIVINE_MART_OBJ_001"] = "Seus POKéMON já\nsabem o golpe pra\fcarregar pessoas\nsobre a água?",
  ["TEXT_OLIVINE_MART_OBJ_002"] = "Seus POKéMON já\nsabem o golpe pra\fcarregar pessoas\nsobre a água?",
  ["TEXT_OLIVINE_POKECENTER1_F_OBJ_001"] = "Bom dia!\nBem-vindo ao nosso\vCENTRO POKéMON.",
  ["TEXT_OLIVINE_POKECENTER1_F_OBJ_002"] = "¡Guau! tu y tu\n¡Los POKéMON están muy unidos!",
  ["TEXT_OLIVINE_POKECENTER1_F_OBJ_003"] = "los marineros\nson generosos.\funo me enseñó\no FUERZA.\fAhora mi POKEMON\nmueve rocas.",
  ["TEXT_OLIVINE_PORT_OBJ_001"] = "Vamos partir logo.\nPor favor, suba\va bordo.",
  ["TEXT_OLIVINE_PORT_OBJ_002"] = "no queremos\nte caes al mar, entonces no puedes\nentrar.",
  ["TEXT_OLIVINE_PORT_OBJ_004"] = "SHELLDER es fácil\npara llegar aquí.\fen otros lugares\nEs algo raro.",
  ["TEXT_OLIVINE_PORT_OBJ_005"] = "cuantas varillas tienes\ntienes?\fdiferentes ruedas\natrapa diferentes POKéMON.",
  ["TEXT_OLIVINE_PORT_OBJ_006"] = "O S.S.AQUA usa\njatos e desliza\vsobre as ondas!",
  ["TEXT_OLIVINE_PORT_OBJ_007"] = "Tem um monte de\nPOKéMON em KANTO.\fQueria poder ir…",
  ["TEXT_OLIVINE_PUNISHMENT_SPEECH_HOUSE_BG_001"] = "...No caminho para\nCIANWOOD, existem\fHá quatro ilhas\ndesertas.\fCrianças ruins são\nlevadas pras ilhas\vcomo castigo!",
  ["TEXT_OLIVINE_PUNISHMENT_SPEECH_HOUSE_OBJ_001"] = "No caminho para\nCIANWOOD, existem\fHá quatro ilhas\ndesertas.\fCrianças ruins são\nlevadas pras ilhas\vcomo castigo!",
  ["TEXT_OLIVINE_PUNISHMENT_SPEECH_HOUSE_OBJ_002"] = "Quando me meto em\nenrascada, papai\vsempre me assusta",
  ["TEXT_OLIVINE_TIMS_HOUSE_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_OLIVINE_TIMS_HOUSE_BG_002"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_OLIVINE_TIMS_HOUSE_OBJ_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_PALLET_TOWN_OBJ_001"] = "yo también creo\nPOKÉMON.\fEllos sirven como\nmis guardias",
  ["TEXT_PALLET_TOWN_OBJ_002"] = "La tecnología es\nincreible!\f¿Puedes intercambiar?\nPOKéMON en el tiempo como correo electrónico.",
  ["TEXT_PEWTER_CITY_OBJ_001"] = "¿Has visitado el\n¿GIMNASIO DE PEWTER?\fEL LÍDER utiliza\nPOKEMON de piedra.",
  ["TEXT_PEWTER_CITY_OBJ_002"] = "Por la noche, CLEFAIRY\nven a jugar a MT.MOON.\fPero no todos\nnoche.",
  ["TEXT_PEWTER_CITY_OBJ_003"] = "Oh, vienes de\nhasta ahora, de JOHTO?\festo trae\nrecuerdos. Cuando era joven, fui a\nTren JOHTO.\fme recuerdas\nmucho de lo que yo era, tan joven como\nusted.\fquiero que te quedes\ncon un artículo que encontré en JOHTO.",
  ["TEXT_PEWTER_GYM_OBJ_001"] = "BROCK: ├ë raro\nrecibir desafío de entrenador\nViniendo de JOHTO.\fsoy BROCK,\nLÍDER DE PEWTER.\fsoy un experto\nen piedra POKéMON.\fMis POKéMON son\ninmune a la mayoría de los ataques\nfísico. Será difícil causar\nalgún daño.\f¡Venir!",
  ["TEXT_PEWTER_GYM_OBJ_002"] = "¡Eh, tú!\n¡Entrenador JOHTO!\fBROCK es duro. ir\ncastigarte si no lo llevas a\nen serio.",
  ["TEXT_PEWTER_GYM_OBJ_002_AFTER"] = "¡Eh, tú!\n¡Entrenador JOHTO!\fBROCK es duro. ir\ncastigarte si no lo llevas a\nen serio.",
  ["TEXT_PEWTER_GYM_OBJ_002_BEATEN"] = "necesito ganar\nestas batallas...",
  ["TEXT_PEWTER_GYM_OBJ_002_SEEN"] = "los entrenadores\nen este GYM usan POKéMON de piedra. el tipo\nLa piedra tiene alta DEFENSA. las batallas\npueden tardar mucho tiempo. tu\n¿Estás listo?",
  ["TEXT_PEWTER_GYM_OBJ_003"] = "¡Ey! Futuro\n¡CAMPEÓN!\flo estas haciendo bien\nEstás frente a los LÍDERES de\n¿GIMNASIO KANTO?\fSon personas fuertes y\ndedicado, igual a LÍDERES\npor JOHTO.",
  ["TEXT_PEWTER_MART_OBJ_001"] = "¡Ey! mira el mio\n¡GYARADOS!\fLo crié desde\nMAGIKARP. no puedo creerlo\nqué fuerte se volvió.",
  ["TEXT_PEWTER_MART_OBJ_002"] = "¡Ey! mira el mio\n¡GYARADOS!\fLo crié desde\nMAGIKARP. no puedo creerlo\nqué fuerte se volvió.",
  ["TEXT_PEWTER_NIDORAN_SPEECH_HOUSE_OBJ_001"] = "NIDORAN, pata!",
  ["TEXT_PEWTER_POKECENTER1_F_OBJ_001"] = "…├ë, y el GIMNASIO\nde CINNABAR se ha ido. me quedé\nmuy asombrado.\f…¿Sí? estoy en\nteléfono.\v¡Salir!",
  ["TEXT_PEWTER_POKECENTER1_F_OBJ_002"] = "…├ë, y el GIMNASIO\nde CINNABAR se ha ido. me quedé\nmuy asombrado.\f…¿Sí? estoy en\nteléfono.\v¡Salir!",
  ["TEXT_PEWTER_POKECENTER1_F_OBJ_004"] = "Casi todos los POKEMON\nle da sueño si escucha uno\nJIGGLYPUFF canta Tiene varios movimientos\nque sólo se puede utilizar mientras el\nPOKEMON duerme.",
  ["TEXT_PEWTER_SNOOZE_SPEECH_HOUSE_BG_001"] = "..Gosto de cochilar\ncom o rádio ligado\v…Zzzz…",
  ["TEXT_PEWTER_SNOOZE_SPEECH_HOUSE_BG_002"] = "..Gosto de cochilar\ncom o rádio ligado\v…Zzzz…",
  ["TEXT_PEWTER_SNOOZE_SPEECH_HOUSE_OBJ_001"] = "Gosto de cochilar\ncom o rádio ligado\v…Zzzz…",
  ["TEXT_PLAYERS_HOUSE1_F_OBJ_005"] = "Bom dia,\n{PLAYER}!\fEstou de visita!",
  ["TEXT_PLAYERS_HOUSE2_F_BG_001"] = "Um bilhete lembra\nde visitar o ELM.",
  ["TEXT_PLAYERS_HOUSE2_F_BG_002"] = "POKEMON HABLAR HACER\nPROF.ROBLE! ¡No te pierdas el próximo!",
  ["TEXT_PLAYERS_HOUSE2_F_BG_003"] = "Está bem\narrumado.",
  ["TEXT_PLAYERS_HOUSE2_F_BG_004"] = "un pequeño\nLa decoración está aquí.",
  ["TEXT_PLAYERS_HOUSE2_F_OBJ_001"] = "O console de jogos\nestá conectado.\fHora de começar\nsua jornada.",
  ["TEXT_PLAYERS_HOUSE2_F_OBJ_002"] = "├ë o seu PC.\nMelhor descer\vlogo.",
  ["TEXT_PLAYERS_HOUSE2_F_OBJ_003"] = "Uma estante\narrumada, cheia\vde anotaç├Áes.",
  ["TEXT_PLAYERS_HOUSE2_F_OBJ_004"] = "Um rádio toca uma\nmúsica alegre.",
  ["TEXT_PLAYERS_NEIGHBORS_HOUSE_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_PLAYERS_NEIGHBORS_HOUSE_BG_002"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_PLAYERS_NEIGHBORS_HOUSE_BG_003"] = "POKEMON HABLAR HACER\nPROF.ROBLE! ¡No te pierdas el próximo!",
  ["TEXT_PLAYERS_NEIGHBORS_HOUSE_OBJ_001"] = "PIKACHU é um\nPOKéMON evoluído.\fFiquei espantado\ncom as descobertas\vdo PROF.ELM.\fEle é bem famoso\npela pesquisa da\vevolução.\f…suspiro…\fEu queria poder\nser pesquisador\vcomo ele…",
  ["TEXT_PLAYERS_NEIGHBORS_HOUSE_OBJ_002"] = "mi hija es\ndecidido a convertirse\nasistente del PROF. OLMO.\fella lo ama demasiado\n¡POKÉMON!\f¡A mí también me encanta!",
  ["TEXT_POKECENTER2_F_BG_001"] = "¡Hola! tu eres el\n {PLAYER}, ¿verdad?\ftengo uno\ncosa para ti.",
  ["TEXT_POKECENTER2_F_OBJ_001"] = "Bienvenido a CABLE\nCLUB TRADE CENTER Aquí usted comercia\ntu POKéMON con un amigo.\fquieres\n¿intercambio?",
  ["TEXT_POKECENTER2_F_OBJ_002"] = "Bienvenido a CABLE\nCOLISEO DEL CLUB.\fAquí luchas\ncon un amigo.\fquieres\nbatalla?",
  ["TEXT_POKECENTER2_F_OBJ_003"] = "Bienvenido a CABLE\nCÁPSULA DEL TIEMPO DEL CLUB Puedes viajar a\nPasa e intercambia tus POKéMON.\f¿Quieres intercambiar?\ncon el pasado?",
  ["TEXT_POKECENTER2_F_OBJ_004"] = "¡Hola! tu eres el\n {PLAYER}, ¿verdad?\ftengo uno\ncosa para ti.",
  ["TEXT_POKECOM_CENTER_ADMIN_OFFICE_MOBILE_BG_001"] = "├ë una advertencia sobre\ndónde deben estar los ADAPTADORES MÓVILES\nser usado...",
  ["TEXT_POKECOM_CENTER_ADMIN_OFFICE_MOBILE_BG_002"] = "├ë una advertencia sobre\ncómo usar el teléfono...",
  ["TEXT_POKECOM_CENTER_ADMIN_OFFICE_MOBILE_OBJ_001"] = "O POKéCOM CENTER e\no MOBILE CENTER\vforam feitos pra\vatender trocas e\vbatalhas com\vtreinadores\vdistantes e\vestranhos.",
  ["TEXT_POKECOM_CENTER_ADMIN_OFFICE_MOBILE_OBJ_002"] = "cuando tu\nconectado con alguien\ncelular por primera vez no funciono\nimpresionado?\fcuando mi\nPrimero funcionó, estaba\n¡Tan impresionado que temblé por todos lados!",
  ["TEXT_POKECOM_CENTER_ADMIN_OFFICE_MOBILE_OBJ_003"] = "Conseguiram\nconstruir esse\flugar enorme\ngraças aos\vavanços em\vtecnologia sem\vfio.",
  ["TEXT_POKEMON_FAN_CLUB_OBJ_001"] = "SOY EL PRESIDENTE\ndel CLUB DE FANS DE POKEMON.\fHe creado más de\n150 POKÉMON.\festoy bien\nexigente cuando se trata de POKéMON Viniste solo para\n¿Has oído hablar de mis POKéMON?",
  ["TEXT_POKEMON_FAN_CLUB_OBJ_002"] = "NUESTRO PRESIDENTE\nHabla demasiado cuando se trata de POKéMON...",
  ["TEXT_POKEMON_FAN_CLUB_OBJ_003"] = "Eu amo o jeito\nque o CLEFAIRY\fbalança o dedo\nquando vai usar\fMETRONOME.\n├ë tão adorável!",
  ["TEXT_POKEMON_FAN_CLUB_OBJ_004"] = "mira mi cariño\n¡BAYLEEF!\fLa hoja en la cabeza\n¡El suyo es tan lindo!",
  ["TEXT_POKEMON_FAN_CLUB_OBJ_005"] = "├ë um CLEFAIRY!\nHã?\fAh, é mesmo. ├ë uma\nPOKé DOLL de\vCLEFAIRY.",
  ["TEXT_POKEMON_FAN_CLUB_OBJ_006"] = "├ë um CLEFAIRY!\nHã?\fAh, é mesmo. ├ë uma\nPOKé DOLL de\vCLEFAIRY.",
  ["TEXT_POWER_PLANT_BG_001"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_POWER_PLANT_BG_002"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_POWER_PLANT_OBJ_001"] = "Um ladrão invadiu\na POWER PLANT…\fO que o mundo\nestá virando?",
  ["TEXT_POWER_PLANT_OBJ_002"] = "alguien tomó\nuna pieza imprescindible para\nel generador.\fSin ello, el\n¡El nuevo generador no funciona!",
  ["TEXT_POWER_PLANT_OBJ_003"] = "Esta CENTRAL DE ENERGÍA\nhabía sido abandonado.\fNos reactivamos\nella para darle energía\nTREN IMÁN.",
  ["TEXT_POWER_PLANT_OBJ_004"] = "EL GERENTE de\nLA PLANTA DE ENERGÍA está justo delante.\f¿Pero cómo alguien\nSe rompió el generador, estaba triste y furioso...",
  ["TEXT_POWER_PLANT_OBJ_005"] = "EL TREN IMÁN\nconsume mucha electricidad.\fNo camines si\nEl nuevo generador no funciona.",
  ["TEXT_POWER_PLANT_OBJ_006"] = "ADMINISTRADOR: Lo haré\n¡Hacer volar a alguien!\v¿Quién se atreve a estropearme?\ngenerador?\fgasté tanto\n¡tiempo en ello!\fSi lo atrapo,\nel vera lo que es un ZAP\n¡CAÑÓN!",
  ["TEXT_RADIO_TOWER1_F_OBJ_001"] = "Bem-vindo!",
  ["TEXT_RADIO_TOWER1_F_OBJ_002"] = "O BEN é um DJ\nfabuloso.\fA voz doce dele\nme derrete!",
  ["TEXT_RADIO_TOWER1_F_OBJ_003"] = "Amo a MARÍA, de\nHABLA DE POKÉMON.\fsolo conozco la voz\nella, pero nunca la vi.",
  ["TEXT_RADIO_TOWER1_F_OBJ_004"] = "├ë demasiado fuerte.\fNuestro plan puede\ndesmoronarse. Necesito advertir a los demás...",
  ["TEXT_RADIO_TOWER1_F_OBJ_004_AFTER"] = "├ë demasiado fuerte.\fNuestro plan puede\ndesmoronarse. Necesito advertir a los demás...",
  ["TEXT_RADIO_TOWER1_F_OBJ_004_BEATEN"] = "¡Acérrimo! nosotros\ntenemos que mirar...",
  ["TEXT_RADIO_TOWER1_F_OBJ_004_SEEN"] = "Finalmente\n¡Asumimos la TORRE DE RADIO!\fahora todos van\nExperimenta el verdadero terror de\n¡EQUIPO COHETE!\fvamos a mostrar\n¡Qué miedo tenemos!",
  ["TEXT_RADIO_TOWER1_F_OBJ_005"] = "Hola, viniste\n¿MUESTRA DE NÚMEROS DE SUERTE?\fquieres que vea\n¿Tus números de ID de POKéMON?\fSi tienes suerte,\ngana un premio.",
  ["TEXT_RADIO_TOWER1_F_OBJ_006"] = "Temos uma promoção\nde quiz especial\vrolando agora.\fAcerte cinco\nperguntas e ganhe\vum RADIO CARD.\fEncaixe ele na sua\nPOKéGEAR e toque\fo rádio a qualquer\nhora e lugar.\fQuer responder ao\nquiz?",
  ["TEXT_RADIO_TOWER2_F_BG_001"] = "2F VENDAS",
  ["TEXT_RADIO_TOWER2_F_BG_002"] = "TALK POKéMON\nDO PROF.OAK\fO Show Mais Quente\nno Ar!",
  ["TEXT_RADIO_TOWER2_F_BG_006"] = "Em Qualquer Lugar\nPOKéMON Radio",
  ["TEXT_RADIO_TOWER2_F_OBJ_001"] = "¿Puedes oír?\nla radio en cualquier lugar.",
  ["TEXT_RADIO_TOWER2_F_OBJ_002"] = "Canç├Áes de ninar\nna radio podem\vfazer dormir.",
  ["TEXT_RADIO_TOWER2_F_OBJ_003"] = "no lo dejaremos\n¡Arruinas nuestros planes!",
  ["TEXT_RADIO_TOWER2_F_OBJ_003_AFTER"] = "no lo dejaremos\n¡Arruinas nuestros planes!",
  ["TEXT_RADIO_TOWER2_F_OBJ_003_BEATEN"] = "¡Puaj! no se queda\ngracioso!",
  ["TEXT_RADIO_TOWER2_F_OBJ_003_SEEN"] = "Há três anos, a\nTEAM ROCKET foi\vobrigada a parar.\fMas agora a volta\nvem com tudo!",
  ["TEXT_RADIO_TOWER2_F_OBJ_004"] = "No siempre estamos\nchicos malos. Hacemos lo que nos gusta.",
  ["TEXT_RADIO_TOWER2_F_OBJ_004_AFTER"] = "No siempre estamos\nchicos malos. Hacemos lo que nos gusta.",
  ["TEXT_RADIO_TOWER2_F_OBJ_004_BEATEN"] = "¿Crees que es\nun héroe?",
  ["TEXT_RADIO_TOWER2_F_OBJ_004_SEEN"] = "Somos TEAM ROCKET,\nos que exploram\vos POKéMON!\fAmamos ser\nmalvados! Medo?",
  ["TEXT_RADIO_TOWER2_F_OBJ_005"] = "Nuestros EJECUTIVOS\nestán tratando de tomar este lugar.\ftienen un plan\ngrande. Quería saber qué es.",
  ["TEXT_RADIO_TOWER2_F_OBJ_005_AFTER"] = "Nuestros EJECUTIVOS\nestán tratando de tomar este lugar.\ftienen un plan\ngrande. Quería saber qué es.",
  ["TEXT_RADIO_TOWER2_F_OBJ_005_BEATEN"] = "Argh. Desisto.",
  ["TEXT_RADIO_TOWER2_F_OBJ_005_SEEN"] = "¡Oye, oye! salir de\n¡nuestro camino!",
  ["TEXT_RADIO_TOWER2_F_OBJ_006"] = "Me ganaste y\n¡No lo olvidaré!",
  ["TEXT_RADIO_TOWER2_F_OBJ_006_AFTER"] = "Me ganaste y\n¡No lo olvidaré!",
  ["TEXT_RADIO_TOWER2_F_OBJ_006_BEATEN"] = "¿Q-quién eres tú?",
  ["TEXT_RADIO_TOWER2_F_OBJ_006_SEEN"] = "Hahaha!\fQue tédio.\nFoi fácil\fdemais tomar\neste lugar!\fVamos, me\ndivirta!",
  ["TEXT_RADIO_TOWER2_F_OBJ_007"] = "Lo siento. Sólo\npersonal autorizado más allá de aquí.\fno fue asi\nantes.\falgo anda mal\ncon la DIRECTORA...",
  ["TEXT_RADIO_TOWER2_F_OBJ_008"] = "Sinta-se livre\npara olhar.\fO DIRETOR esta\nbom de novo,\vcomo era antes.",
  ["TEXT_RADIO_TOWER2_F_OBJ_009"] = "JIGGLYPUFF:\nJiggly…",
  ["TEXT_RADIO_TOWER2_F_OBJ_011"] = "puedes intercambiar\ntus puntos por un premio\nhermosa, ├elección!",
  ["TEXT_RADIO_TOWER3_F_BG_003"] = "E o slot da\nCHAVE-CARTAO.",
  ["TEXT_RADIO_TOWER3_F_OBJ_001"] = "Temos gravaç├Áes\ndos gritos de\ftodos os POKéMON\nencontrados.\fDevemos ter uns\n200 tipos.",
  ["TEXT_RADIO_TOWER3_F_OBJ_002"] = "Para treinadores,\nPOKéMON são\vseus parceiros.\fE terrível como a\nTEAM ROCKET esta\ftentando controlar\nPOKéMON.",
  ["TEXT_RADIO_TOWER3_F_OBJ_003"] = "O chefe da TEAM\nROCKET trancou\vele mesmo lá.\fMas o DIRETOR\npode abrir.\fEle esta no\nquinto andar.\fSalve-o!",
  ["TEXT_RADIO_TOWER3_F_OBJ_004"] = "yo falle el mio\ntrabajo… obtendré un descuento\ncon mi salario...",
  ["TEXT_RADIO_TOWER3_F_OBJ_004_AFTER"] = "yo falle el mio\ntrabajo… obtendré un descuento\ncon mi salario...",
  ["TEXT_RADIO_TOWER3_F_OBJ_004_BEATEN"] = "O quê?!",
  ["TEXT_RADIO_TOWER3_F_OBJ_004_SEEN"] = "Recebi ordens\nrígidas.\fVou esmagar quem\ndesafiar a TEAM\vROCKET!",
  ["TEXT_RADIO_TOWER3_F_OBJ_005"] = "Estou péssimo por\nter perdido!\fDroga! Odeio\nPOKéMON inúteis!",
  ["TEXT_RADIO_TOWER3_F_OBJ_005_AFTER"] = "Estou péssimo por\nter perdido!\fDroga! Odeio\nPOKéMON inúteis!",
  ["TEXT_RADIO_TOWER3_F_OBJ_005_BEATEN"] = "Tá brincando!",
  ["TEXT_RADIO_TOWER3_F_OBJ_005_SEEN"] = "├ë ótimo mandar\nos POKéMON\vcometer crimes.",
  ["TEXT_RADIO_TOWER3_F_OBJ_006"] = "O quê?! Passou\npelos nossos,\vno UNDERGROUND?\fComo conseguiu?",
  ["TEXT_RADIO_TOWER3_F_OBJ_006_AFTER"] = "O quê?! Passou\npelos nossos,\vno UNDERGROUND?\fComo conseguiu?",
  ["TEXT_RADIO_TOWER3_F_OBJ_006_BEATEN"] = "Estou feito!",
  ["TEXT_RADIO_TOWER3_F_OBJ_006_SEEN"] = "¿Por qué los ciegos?\nabierto? ¿Tienes algo que ver con\nesto?",
  ["TEXT_RADIO_TOWER3_F_OBJ_007"] = "Bwahahaha... puedo transmitir\nuna señal tan fuerte como necesito.",
  ["TEXT_RADIO_TOWER3_F_OBJ_007_AFTER"] = "Bwahahaha... puedo transmitir\nuna señal tan fuerte como necesito.",
  ["TEXT_RADIO_TOWER3_F_OBJ_007_BEATEN"] = "Tsk! Eu te\nsubestimei!",
  ["TEXT_RADIO_TOWER3_F_OBJ_007_SEEN"] = "un niño\nperdido aquí?\f¿Quién eres?",
  ["TEXT_RADIO_TOWER4_F_OBJ_001"] = "Ouvi a radio\nquando estava\vnas RUÍNAS.\fOuvi uma\ntransmissão lá.",
  ["TEXT_RADIO_TOWER4_F_OBJ_002"] = "MARÍA: ¿Por qué?\n¿Por qué tengo que sufrir esto?\f¡MEOWTH ayúdame!",
  ["TEXT_RADIO_TOWER4_F_OBJ_003"] = "MEOWTH: Meowth…",
  ["TEXT_RADIO_TOWER4_F_OBJ_004"] = "¡No lo creo!\n¡Fui derrotado!",
  ["TEXT_RADIO_TOWER4_F_OBJ_004_AFTER"] = "¡No lo creo!\n¡Fui derrotado!",
  ["TEXT_RADIO_TOWER4_F_OBJ_004_BEATEN"] = "¡No puede ser!",
  ["TEXT_RADIO_TOWER4_F_OBJ_004_SEEN"] = "quiero guardar\nel DIRECTOR?\festo no sera\nposible, porque te derrotaré!",
  ["TEXT_RADIO_TOWER4_F_OBJ_005"] = "tu ganaste mi\nrespeto, así que aquí tienes algunos consejos.\fNo es demasiado tarde.\nAún puedes volver.",
  ["TEXT_RADIO_TOWER4_F_OBJ_005_AFTER"] = "tu ganaste mi\nrespeto, así que aquí tienes algunos consejos.\fNo es demasiado tarde.\nAún puedes volver.",
  ["TEXT_RADIO_TOWER4_F_OBJ_005_BEATEN"] = "A fortaleza\ncaiu!",
  ["TEXT_RADIO_TOWER4_F_OBJ_005_SEEN"] = "¡Detener! sou\n¡Conocido como el bastión del TEAM ROCKET! tu\n¡no pasará!",
  ["TEXT_RADIO_TOWER4_F_OBJ_006"] = "Eu amo a minha\nbeleza!\fQuem liga para\nos POKéMON?",
  ["TEXT_RADIO_TOWER4_F_OBJ_006_AFTER"] = "Eu amo a minha\nbeleza!\fQuem liga para\nos POKéMON?",
  ["TEXT_RADIO_TOWER4_F_OBJ_006_BEATEN"] = "¡Oh, no! ellos son\n¡Qué inútil!",
  ["TEXT_RADIO_TOWER4_F_OBJ_006_SEEN"] = "No creo que el\n¿Pokemon lindo?\fencontraré el mío\nlindo, después de que derrotaron al\ntuyo!",
  ["TEXT_RADIO_TOWER4_F_OBJ_007"] = "¿Crees?\n¿Incluso si puedes detener al TEAM?",
  ["TEXT_RADIO_TOWER4_F_OBJ_007_AFTER"] = "¿Crees?\n¿Incluso si puedes detener al TEAM?",
  ["TEXT_RADIO_TOWER4_F_OBJ_007_BEATEN"] = "Hmmm…\fOs grandes planos\ntêm percalços.",
  ["TEXT_RADIO_TOWER4_F_OBJ_007_SEEN"] = "Excelente.\fEsta TORRE DE RADIO\nllevaremos a cabo nuestro plan.",
  ["TEXT_RADIO_TOWER5_F_BG_001"] = "5F ESCRITORIO\nDO DIRETOR",
  ["TEXT_RADIO_TOWER5_F_BG_002"] = "5F ESTUDIO 1",
  ["TEXT_RADIO_TOWER5_F_BG_003"] = "5F ESTUDIO 1",
  ["TEXT_RADIO_TOWER5_F_BG_004"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_RADIO_TOWER5_F_BG_005"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_RADIO_TOWER5_F_OBJ_001"] = "Ocultamos el\nDIRECTOR REAL en ALMACÉN\nSUBTERRÁNEO.\fY en la punta de\nSUBTERRÁNEO.\vpero dudo de ti\nllegar allí.",
  ["TEXT_RADIO_TOWER5_F_OBJ_003"] = "{PLAYER}, ¿verdad?\fun mocoso como\nno apreciarás el\nmagnificencia del TEAM ROCKET.\nQué vergüenza. Admiro tu poder.",
  ["TEXT_RADIO_TOWER5_F_OBJ_003_AFTER"] = "{PLAYER}, ¿verdad?\fun mocoso como\nno apreciarás el\nmagnificencia del TEAM ROCKET.\nQué vergüenza. Admiro tu poder.",
  ["TEXT_RADIO_TOWER5_F_OBJ_003_BEATEN"] = "esto no puede\nsea verdad!\fLuché duro, pero\nTodavía perdí...",
  ["TEXT_RADIO_TOWER5_F_OBJ_003_SEEN"] = "Hola chico.\nRecuérdame de HIDEOUT en\n¿CIUDAD DE CAOBA?\fperdí allí pero\nAhora no pierdo.",
  ["TEXT_RADIO_TOWER5_F_OBJ_004"] = "BEN: ¿Oyes?\nnuestra música?",
  ["TEXT_REDS_HOUSE1_F_OBJ_001"] = "¡Ey!\fROJO está fuera\nha pasado mucho tiempo.\fY tampoco\nllamado así que no tengo idea\ndónde está o qué hace.\fdicen sin\nlas noticias son una señal de que las cosas van bien,\nPero me preocupo por él.",
  ["TEXT_ROUTE10_NORTH_BG_001"] = "KANTO POWER PLANT",
  ["TEXT_ROUTE10_NORTH_BG_002"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_ROUTE10_POKECENTER1_F_OBJ_001"] = "UN CENTRO POKEMON\ncerca de una cueva?\feso esta bien\nconveniente.",
  ["TEXT_ROUTE10_POKECENTER1_F_OBJ_002"] = "UN CENTRO POKEMON\ncerca de una cueva?\feso esta bien\nconveniente.",
  ["TEXT_ROUTE10_POKECENTER1_F_OBJ_003"] = "EL GERENTE de\nPOWER PLANT quiere encontrar un hombre\ncon buenos POKEMON.\fel necesita\nayuda para recuperar algo\nfue robado.",
  ["TEXT_ROUTE10_POKECENTER1_F_OBJ_004"] = "UN CENTRO POKEMON\ncerca de una cueva?\feso esta bien\nconveniente.",
  ["TEXT_ROUTE10_SOUTH_BG_001"] = "ROTA 10\fCIDADE DE CERULEAN\nCIDADE DE LAVENDER",
  ["TEXT_ROUTE10_SOUTH_OBJ_001"] = "A alergia está me\nfazendo espirrar!\vAtchiiim!",
  ["TEXT_ROUTE10_SOUTH_OBJ_001_AFTER"] = "A alergia está me\nfazendo espirrar!\vAtchiiim!",
  ["TEXT_ROUTE10_SOUTH_OBJ_001_BEATEN"] = "Hahaha-atchim!",
  ["TEXT_ROUTE10_SOUTH_OBJ_001_SEEN"] = "Hahahá!",
  ["TEXT_ROUTE10_SOUTH_OBJ_002"] = "mira lo que tu\nhice con POKéMON no lo haré\nolvídate de eso...",
  ["TEXT_ROUTE10_SOUTH_OBJ_002_AFTER"] = "mira lo que tu\nhice con POKéMON no lo haré\nolvídate de eso...",
  ["TEXT_ROUTE10_SOUTH_OBJ_002_BEATEN"] = "Eu diria que essa\nfoi derrota minha",
  ["TEXT_ROUTE10_SOUTH_OBJ_002_SEEN"] = "te gusta\nPOKÉMON, ¿verdad?\f¡Yo también!",
  ["TEXT_ROUTE11_OBJ_001"] = "Luché limpiamente y con\nhonor.\fno me arrepiento\nde nada.",
  ["TEXT_ROUTE11_OBJ_001_AFTER"] = "Luché limpiamente y con\nhonor.\fno me arrepiento\nde nada.",
  ["TEXT_ROUTE11_OBJ_001_BEATEN"] = "¿Hay? ¿Cómo funciona esto?\nsucedió?",
  ["TEXT_ROUTE11_OBJ_001_SEEN"] = "no existe\nhacer trampa en POKéMON.\fmantengamos\ntodo justo!",
  ["TEXT_ROUTE11_OBJ_002"] = "conseguiré más\nPOKéMON allí en el monte.",
  ["TEXT_ROUTE11_OBJ_002_AFTER"] = "conseguiré más\nPOKéMON allí en el monte.",
  ["TEXT_ROUTE11_OBJ_002_BEATEN"] = "Aiaaai!\nFui pisoteado!",
  ["TEXT_ROUTE11_OBJ_002_SEEN"] = "Coça e faz cócega\num pouco quando\fando de shorts\nno mato.",
  ["TEXT_ROUTE11_OBJ_003"] = "…\fPerdi de olhos\nfechados…",
  ["TEXT_ROUTE11_OBJ_003_AFTER"] = "…\fPerdi de olhos\nfechados…",
  ["TEXT_ROUTE11_OBJ_004"] = "Fuerza en\nconvicción…eres fuerte\nporque cree en su POKéMON.",
  ["TEXT_ROUTE11_OBJ_004_AFTER"] = "Fuerza en\nconvicción…eres fuerte\nporque cree en su POKéMON.",
  ["TEXT_ROUTE11_OBJ_004_BEATEN"] = "No preví el tuyo\nfuerza…",
  ["TEXT_ROUTE11_OBJ_004_SEEN"] = "Puedo ver... Todo lo que hay\npara ver en ti...",
  ["TEXT_ROUTE12_OBJ_001"] = "no tengo\npaciencia para pescar...",
  ["TEXT_ROUTE12_OBJ_001_AFTER"] = "no tengo\npaciencia para pescar...",
  ["TEXT_ROUTE12_OBJ_001_BEATEN"] = "Aaargh!",
  ["TEXT_ROUTE12_OBJ_001_SEEN"] = "La paciencia es la\nClave tanto para la pesca como para POKéMON.",
  ["TEXT_ROUTE12_OBJ_002"] = "¿Alguna vez has escuchado el\n¿Radios KANTO?\fLa variedad aquí\nEs bueno.",
  ["TEXT_ROUTE12_OBJ_002_AFTER"] = "¿Alguna vez has escuchado el\n¿Radios KANTO?\fLa variedad aquí\nEs bueno.",
  ["TEXT_ROUTE12_OBJ_002_BEATEN"] = "mi estúpida radio\n¡me distrajo!",
  ["TEXT_ROUTE12_OBJ_002_SEEN"] = "me siento tan comoda\npescar y escuchar música en mi radio.",
  ["TEXT_ROUTE12_OBJ_003"] = "creo que el\nla electricidad es lo mas importante\nde nuestros días.\fSi no fuera así,\nnadie hubiera hecho tanto\nderrochar cuando la PLANTA DE ENERGÍA\ndetenido de una vez por todas.",
  ["TEXT_ROUTE12_OBJ_003_AFTER"] = "creo que el\nla electricidad es lo mas importante\nde nuestros días.\fSi no fuera así,\nnadie hubiera hecho tanto\nderrochar cuando la PLANTA DE ENERGÍA\ndetenido de una vez por todas.",
  ["TEXT_ROUTE12_OBJ_003_BEATEN"] = "A resposta vem\nlogo depois!",
  ["TEXT_ROUTE12_OBJ_003_SEEN"] = "¿Qué es más?\nimportante en nuestra vida diaria?",
  ["TEXT_ROUTE12_OBJ_004"] = "El tirón de ti\nsiente en la VARILLA cuando enganchas una\nPOKéMON… ├ë el mejor\nsentimiento por un pescador como yo.",
  ["TEXT_ROUTE12_OBJ_004_AFTER"] = "El tirón de ti\nsiente en la VARILLA cuando enganchas una\nPOKéMON… ├ë el mejor\nsentimiento por un pescador como yo.",
  ["TEXT_ROUTE12_OBJ_004_BEATEN"] = "Lembra mesmo?",
  ["TEXT_ROUTE12_OBJ_004_SEEN"] = "¿Te acuerdas?",
  ["TEXT_ROUTE12_SUPER_ROD_HOUSE_OBJ_001"] = "yo soy el hermano\nLo más nuevo de FISHING GURU.\fveo que tu\nle gusta pescar.\fno tengo ni lo mas minimo\n¡Dudo de eso!\f¿Y ahí? lo se\nTengo razón.",
  ["TEXT_ROUTE13_OBJ_001"] = "Tus POKéMON son\nmuy bien entrenado.",
  ["TEXT_ROUTE13_OBJ_001_AFTER"] = "Tus POKéMON son\nmuy bien entrenado.",
  ["TEXT_ROUTE13_OBJ_001_BEATEN"] = "Me ganaste\nvelocidad…",
  ["TEXT_ROUTE13_OBJ_001_SEEN"] = "Agilidade é o\nponto forte dos\vPOKéMON pássaro.",
  ["TEXT_ROUTE13_OBJ_002"] = "Se escovar eles,\nPOKéMON ficam bem",
  ["TEXT_ROUTE13_OBJ_002_AFTER"] = "Se escovar eles,\nPOKéMON ficam bem",
  ["TEXT_ROUTE13_OBJ_002_BEATEN"] = "¡Droga!\n¡No fue suficiente!",
  ["TEXT_ROUTE13_OBJ_002_SEEN"] = "mira el mio\nPOKÉMON. Ver el color y el plumaje.\nde ellos.",
  ["TEXT_ROUTE13_OBJ_003"] = "si te cepillas\nellos, los POKéMON están felices.",
  ["TEXT_ROUTE13_OBJ_003_AFTER"] = "parece que tienes\nmuchos POKéMON, pero PIKACHU aún\nes el mejor.",
  ["TEXT_ROUTE13_OBJ_003_SEEN"] = "¡Nihihi! querer\n¿Batalla con mi pandilla?",
  ["TEXT_ROUTE13_OBJ_004"] = "El alivio parece\neso nunca cambia.\fPero él cambia,\npoco a poco, con el tiempo.",
  ["TEXT_ROUTE13_OBJ_004_AFTER"] = "El alivio parece\neso nunca cambia.\fPero él cambia,\npoco a poco, con el tiempo.",
  ["TEXT_ROUTE13_OBJ_004_BEATEN"] = "Eu perdi…",
  ["TEXT_ROUTE13_OBJ_004_SEEN"] = "debería ir a\nTÚNEL DE ROCA consigue un ONIX.",
  ["TEXT_ROUTE13_OBJ_005"] = "No todos\n¿Sueñas con ser algún día rey?",
  ["TEXT_ROUTE13_OBJ_005_AFTER"] = "No todos\n¿Sueñas con ser algún día rey?",
  ["TEXT_ROUTE13_OBJ_005_BEATEN"] = "Como… Como ousa\nzombar da realeza",
  ["TEXT_ROUTE13_OBJ_005_SEEN"] = "Curve-se ante meu\nPOKéMON real!",
  ["TEXT_ROUTE14_OBJ_001"] = "SQUIRTLE,\nCHARMANDER e\vBULBASAUR…\fAcho que é uma boa\nmistura.",
  ["TEXT_ROUTE14_OBJ_001_AFTER"] = "SQUIRTLE,\nCHARMANDER e\vBULBASAUR…\fAcho que é uma boa\nmistura.",
  ["TEXT_ROUTE14_OBJ_001_BEATEN"] = "Aaaah!",
  ["TEXT_ROUTE14_OBJ_001_SEEN"] = "Déjame decirte,\nFue dificil atrapar a mi POKEMON\nmascota.",
  ["TEXT_ROUTE14_OBJ_002"] = "¿Tienes POKEMON?\nConoces la estafa FLY, ¿no? que\nenvidia.",
  ["TEXT_ROUTE14_OBJ_002_AFTER"] = "¿Tienes POKEMON?\nConoces la estafa FLY, ¿no? que\nenvidia.",
  ["TEXT_ROUTE14_OBJ_002_BEATEN"] = "Puedo soñar, pero\nnunca volaré...",
  ["TEXT_ROUTE14_OBJ_002_SEEN"] = "mi sueño es volar\ncon mi querido pájaro POKéMON.",
  ["TEXT_ROUTE14_OBJ_003"] = "si hubiera uno\nmanera fácil de saber de dónde saqué mi POKéMON...",
  ["TEXT_ROUTE14_OBJ_003_AFTER"] = "si hubiera uno\nmanera fácil de saber de dónde saqué mi POKéMON...",
  ["TEXT_ROUTE14_OBJ_003_BEATEN"] = "Onde foi que eu\nachei este\vPSYDUCK?",
  ["TEXT_ROUTE14_OBJ_003_SEEN"] = "Hola. Sabías…?\fPOKéMON se vuelven más\namigable si los entrenas en un\nlugar que recuerdan.",
  ["TEXT_ROUTE14_OBJ_004"] = "SQUIRTLE,\nCHARMANDER e\vBULBASAUR…\fAcho que é uma boa\nmistura.",
  ["TEXT_ROUTE15_BG_001"] = "{RIVAL}-{BYTE:68}{BYTE:3E}{RAM:8700}ocê esqueceu\nde algo?",
  ["TEXT_ROUTE15_OBJ_001"] = "mi madre si\nMe preocupa mucho tengo que llamar\ntodo el tiempo.",
  ["TEXT_ROUTE15_OBJ_001_AFTER"] = "mi madre si\nMe preocupa mucho tengo que llamar\ntodo el tiempo.",
  ["TEXT_ROUTE15_OBJ_001_BEATEN"] = "Desculpe, mãe!\nEu apanhei!",
  ["TEXT_ROUTE15_OBJ_001_SEEN"] = "Esperar. necesito\nllama a mamá",
  ["TEXT_ROUTE15_OBJ_002"] = "¡Sayonara! ya terminé\npara aprender esto en clase de japonés",
  ["TEXT_ROUTE15_OBJ_002_AFTER"] = "¡Sayonara! ya terminé\npara aprender esto en clase de japonés",
  ["TEXT_ROUTE15_OBJ_002_BEATEN"] = "Esqueci de fazer\na lição!",
  ["TEXT_ROUTE15_OBJ_002_SEEN"] = "Luchemos.\n¡No perderé!",
  ["TEXT_ROUTE15_OBJ_003"] = "Me cansé de caminar.\nNecesito un descanso.",
  ["TEXT_ROUTE15_OBJ_003_AFTER"] = "Me cansé de caminar.\nNecesito un descanso.",
  ["TEXT_ROUTE15_OBJ_003_BEATEN"] = "tu eres fuerte\n¡demasiado!",
  ["TEXT_ROUTE15_OBJ_003_SEEN"] = "Estamos em\nexcursão na\vLAVENDER\fRADIO TOWER para\nestudos sociais.",
  ["TEXT_ROUTE15_OBJ_004"] = "Se POKéMON fosse\nmatéria na escola,\veu era o melhor!",
  ["TEXT_ROUTE15_OBJ_004_AFTER"] = "Se POKéMON fosse\nmatéria na escola,\veu era o melhor!",
  ["TEXT_ROUTE15_OBJ_004_BEATEN"] = "¡Oh, no!\n¿Cómo perdí?",
  ["TEXT_ROUTE15_OBJ_004_SEEN"] = "Aula favorita?\nEducação física!",
  ["TEXT_ROUTE15_OBJ_005"] = "antes de girar\nmaestro, se me olvidó mucho\ncosa.",
  ["TEXT_ROUTE15_OBJ_005_AFTER"] = "antes de girar\nmaestro, se me olvidó mucho\ncosa.",
  ["TEXT_ROUTE15_OBJ_005_SEEN"] = "te olvidaste\nde algo?",
  ["TEXT_ROUTE15_OBJ_006"] = "Estudar é\nimportante, mas se\vexercitar também.",
  ["TEXT_ROUTE15_OBJ_006_AFTER"] = "Estudar é\nimportante, mas se\vexercitar também.",
  ["TEXT_ROUTE15_OBJ_006_BEATEN"] = "no queria\nperder...",
  ["TEXT_ROUTE15_OBJ_006_SEEN"] = "Nos dias de sol,\nacho que\fas crianças\nprefeririam\vbrincar no pátio\fa estudar na sala\nde aula.",
  ["TEXT_ROUTE16_FUCHSIA_SPEECH_HOUSE_BG_001"] = "..Si bajas a\nCARRETERA CICLISMO, pararás\nen CIUDAD FUCSIA.",
  ["TEXT_ROUTE16_FUCHSIA_SPEECH_HOUSE_BG_002"] = "..Si bajas a\nCARRETERA CICLISMO, pararás\nen CIUDAD FUCSIA.",
  ["TEXT_ROUTE16_FUCHSIA_SPEECH_HOUSE_OBJ_001"] = "Si bajas a\nCARRETERA CICLISMO, pararás\nen CIUDAD FUCSIA.",
  ["TEXT_ROUTE16_GATE_OBJ_001"] = "LA CARRETERA CICLISMO\ncomienza aquí. ├ë todo cuesta abajo\na continuación, ¡y muy emocionante!\fun sentimiento\neso solo se siente en un barco\no tren.",
  ["TEXT_ROUTE17_OBJ_001"] = "¡Guau, pateas!",
  ["TEXT_ROUTE17_OBJ_001_AFTER"] = "No pienses,\n¡JOHTO niño!",
  ["TEXT_ROUTE17_OBJ_001_BEATEN"] = "¡Guau, pateas!",
  ["TEXT_ROUTE17_OBJ_001_SEEN"] = "¡Eh, tú! ├ë de\nJOHTO, ¿verdad?",
  ["TEXT_ROUTE17_OBJ_002"] = "pero tu no lo eres\nsimplemente hermoso...",
  ["TEXT_ROUTE17_OBJ_002_AFTER"] = "me veo genial\npero soy débil y luego no soy nada.\ftengo que entrenar\nmás…",
  ["TEXT_ROUTE17_OBJ_002_BEATEN"] = "pero tu no lo eres\nsimplemente hermoso...",
  ["TEXT_ROUTE17_OBJ_002_SEEN"] = "Uau. Que BICYCLE\nmaneira!",
  ["TEXT_ROUTE17_OBJ_003"] = "¡Dios! ¿Tienes un\npar increíble!",
  ["TEXT_ROUTE17_OBJ_003_AFTER"] = "Andar sem as mãos\né considerado bom\vna CYCLING ROAD.",
  ["TEXT_ROUTE17_OBJ_003_BEATEN"] = "¡Dios! ¿Tienes un\npar increíble!",
  ["TEXT_ROUTE17_OBJ_003_SEEN"] = "Ei! Quer fazer uma\nbatalha rápida?",
  ["TEXT_ROUTE17_OBJ_004"] = "Aaargh! Bati e\nqueimei!",
  ["TEXT_ROUTE17_OBJ_004_AFTER"] = "Direção imprudente\ncausa acidente!\vVá com calma!",
  ["TEXT_ROUTE17_OBJ_004_BEATEN"] = "Aaargh! Bati e\nqueimei!",
  ["TEXT_ROUTE17_OBJ_004_SEEN"] = "Somos as estrelas\nsem medo da via!",
  ["TEXT_ROUTE17_ROUTE18_GATE_OBJ_001"] = "CYCLING ROAD\na subida começa",
  ["TEXT_ROUTE18_OBJ_001"] = "que fuerte eres\nDebe ser divertido luchar.",
  ["TEXT_ROUTE18_OBJ_001_AFTER"] = "que fuerte eres\nDebe ser divertido luchar.",
  ["TEXT_ROUTE18_OBJ_001_BEATEN"] = "Aiiii!",
  ["TEXT_ROUTE18_OBJ_001_SEEN"] = "si estas buscando\nPOKéMON, hay que buscar entre los arbustos\nalto.",
  ["TEXT_ROUTE18_OBJ_002"] = "Si no tienes\nuna BICICLETA, no se puede utilizar la\natajo.",
  ["TEXT_ROUTE18_OBJ_002_AFTER"] = "Si no tienes\nuna BICICLETA, no se puede utilizar la\natajo.",
  ["TEXT_ROUTE18_OBJ_002_SEEN"] = "A CYCLING ROAD é\num atalho rápido\vpara CELADON.",
  ["TEXT_ROUTE19_FUCHSIA_GATE_OBJ_001"] = "O vulcão de\nCINNABAR estourou\fEle jogou pedras\nque fecharam a\vROTA 19 de vez.\fFico pensando se\no povo de CINNABAR\vestá a salvo…",
  ["TEXT_ROUTE19_OBJ_001"] = "Tu POKEMON\nparece estar infectado por\ndiminutas formas de vida.\fTus POKéMON son\nsano y lucir bien.\fPero no podemos\nno decir nada más en un POKéMON\nCENTRO.",
  ["TEXT_ROUTE19_OBJ_001_AFTER"] = "├ë uma nadada bem\ncurta entre\fFUCHSIA e as\nSEAFOAM ISLANDS…\fPuxa, que homem\ngrande o meu\fnamorado! Banana!",
  ["TEXT_ROUTE19_OBJ_001_BEATEN"] = "yo ganaría\ntú en natación...",
  ["TEXT_ROUTE19_OBJ_001_SEEN"] = "Tenho nojo de\ngente banana!",
  ["TEXT_ROUTE19_OBJ_002"] = "├Ç noite o mar\nfica preto.\fParece que ele vai\nte engolir.",
  ["TEXT_ROUTE19_OBJ_002_AFTER"] = "├Ç noite o mar\nfica preto.\fParece que ele vai\nte engolir.",
  ["TEXT_ROUTE19_OBJ_002_SEEN"] = "haber nadado en el mar\n├ ¿Alguna vez es de noche?",
  ["TEXT_ROUTE19_OBJ_003"] = "puedo ser malo\nnadar, pero me encanta el mar.",
  ["TEXT_ROUTE19_OBJ_003_AFTER"] = "puedo ser malo\nnadar, pero me encanta el mar.",
  ["TEXT_ROUTE19_OBJ_003_BEATEN"] = "Achei que eu ia\nganhar.",
  ["TEXT_ROUTE19_OBJ_003_SEEN"] = "¿Nadar? yo soy\nterrible.\fsolo me quedo\nchapoteando en estas aguas poco profundas de aquí.",
  ["TEXT_ROUTE19_OBJ_004"] = "Yo... le pregunté al\nmi novia nada al FUCSIA",
  ["TEXT_ROUTE19_OBJ_004_AFTER"] = "Yo... le pregunté al\nmi novia nada al FUCSIA",
  ["TEXT_ROUTE19_OBJ_004_BEATEN"] = "Estou afogando!",
  ["TEXT_ROUTE19_OBJ_004_SEEN"] = "Ofego, ofego…\nSó… mais… um…\fpouco… até…\nFUCHSIA…",
  ["TEXT_ROUTE19_OBJ_005"] = "Desculpe. Esta\nestrada está em\vobras.\fSe quiser chegar\na CINNABAR, é\fmelhor ir pro sul\nde CIDADE DE\vPALLET.",
  ["TEXT_ROUTE19_OBJ_006"] = "quien sabe cuanto\nEs hora de mover esta roca...",
  ["TEXT_ROUTE1_BG_001"] = "{RIVAL} … {BYTE:46} ) {BYTE:1A} Si los entrenadores\nencontrar, primero es la batalla.",
  ["TEXT_ROUTE1_OBJ_001"] = "Para treinadores,\né lei que a gente\fbatalhe sempre que\nse encontra.",
  ["TEXT_ROUTE1_OBJ_001_AFTER"] = "Para treinadores,\né lei que a gente\fbatalhe sempre que\nse encontra.",
  ["TEXT_ROUTE1_OBJ_001_BEATEN"] = "Aah… Perco mais\ndo que ganho…",
  ["TEXT_ROUTE1_OBJ_001_SEEN"] = "si los entrenadores\nencontrar, primero es la batalla.",
  ["TEXT_ROUTE1_OBJ_002"] = "Eres fuerte.\fPuedes ver eso\nentrenado mucho.",
  ["TEXT_ROUTE1_OBJ_002_AFTER"] = "Eres fuerte.\fPuedes ver eso\nentrenado mucho.",
  ["TEXT_ROUTE1_OBJ_002_BEATEN"] = "Nocauteado…",
  ["TEXT_ROUTE1_OBJ_002_SEEN"] = "¡Oye, estás ahí!\n¿Quieres luchar?",
  ["TEXT_ROUTE20_OBJ_001"] = "Ejercicios de natación\ntodo el cuerpo.\flo hace muy bien\npara ti.",
  ["TEXT_ROUTE20_OBJ_001_AFTER"] = "Ejercicios de natación\ntodo el cuerpo.\flo hace muy bien\npara ti.",
  ["TEXT_ROUTE20_OBJ_001_BEATEN"] = "¡Oh, no!",
  ["TEXT_ROUTE20_OBJ_001_SEEN"] = "Me sinto bem\nmais leve na água.",
  ["TEXT_ROUTE20_OBJ_002"] = "SURF ya no es el\nUn solo golpe de HM que sirve en el agua.",
  ["TEXT_ROUTE20_OBJ_002_AFTER"] = "SURF ya no es el\nUn solo golpe de HM que sirve en el agua.",
  ["TEXT_ROUTE20_OBJ_002_SEEN"] = "¡Qué colección de\nINSIGNIAS Impresionantes.\n¡Luchemos!",
  ["TEXT_ROUTE20_OBJ_003"] = "Além do mar, eu\ntambém nado em\vlagos e rios.",
  ["TEXT_ROUTE20_OBJ_003_AFTER"] = "Além do mar, eu\ntambém nado em\vlagos e rios.",
  ["TEXT_ROUTE20_OBJ_003_BEATEN"] = "Aiya!",
  ["TEXT_ROUTE20_OBJ_003_SEEN"] = "Acho impossível\nnadar todo o\fcaminho até\nJOHTO.",
  ["TEXT_ROUTE21_OBJ_001"] = "Tenho que tomar\ncuidado com as\vmanchas do sol.",
  ["TEXT_ROUTE21_OBJ_001_AFTER"] = "Tenho que tomar\ncuidado com as\vmanchas do sol.",
  ["TEXT_ROUTE21_OBJ_001_BEATEN"] = "Estou preocupada\ncom queimadura…",
  ["TEXT_ROUTE21_OBJ_001_SEEN"] = "Oi!\fEu ia justamente\npassar protetor\vsolar.",
  ["TEXT_ROUTE21_OBJ_002"] = "Esse cara metido\nestava no vulcão\vde CINNABAR.",
  ["TEXT_ROUTE21_OBJ_002_AFTER"] = "Esse cara metido\nestava no vulcão\vde CINNABAR.",
  ["TEXT_ROUTE21_OBJ_002_SEEN"] = "Terra ├á vista!\nVamos em frente!",
  ["TEXT_ROUTE21_OBJ_003"] = "Vou voltar a\npescar…",
  ["TEXT_ROUTE21_OBJ_003_AFTER"] = "Vou voltar a\npescar…",
  ["TEXT_ROUTE21_OBJ_003_BEATEN"] = "Fracaso total....",
  ["TEXT_ROUTE21_OBJ_003_SEEN"] = "Estoy cansado de pescar.\n¡Luchemos!",
  ["TEXT_ROUTE23_BG_001"] = "{RIVAL}{BYTE:3A}{BYTE:65}INDIGO PLATEAU\fO Objetivo Máximo\ndos Treinadores!\fSEDE DA POKéMON\nLEAGUE",
  ["TEXT_ROUTE24_OBJ_001"] = "¡Oye, muchacho! yo\ndel TEAM ROCKET ¡Soy como un chico!\fDe otro pais\n¡Vine, entrenador número uno, yo!\fPensé, si\nparada de energía, gran p├onic\n¡Fuera de aquí gente!\fmi secreto\n¡La misión es, así que no hablo!\f¡Pero! si luchas\ngolpéame, soy un hombre y mi\ncuento secreto.\f¡Oye chico!\n¡Comienza la batalla!",
  ["TEXT_ROUTE25_OBJ_003"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_003_AFTER"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_003_BEATEN"] = "¡Guau! Muy bien.",
  ["TEXT_ROUTE25_OBJ_003_SEEN"] = "Vença nós seis\ntreinadores e leve\vum belo prêmio!\fAcha que dá\nconta do recado?",
  ["TEXT_ROUTE25_OBJ_004"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_004_AFTER"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_004_BEATEN"] = "Como eu perdi?",
  ["TEXT_ROUTE25_OBJ_004_SEEN"] = "Sou o segundo.\nAgora é sério!",
  ["TEXT_ROUTE25_OBJ_005"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_005_AFTER"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_005_BEATEN"] = "Ai! Fui esmagado!",
  ["TEXT_ROUTE25_OBJ_005_SEEN"] = "¡Han llegado N┬║ 3!\nno lo haré fácil",
  ["TEXT_ROUTE25_OBJ_006"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_006_AFTER"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_006_BEATEN"] = "Eu também\nperdi…",
  ["TEXT_ROUTE25_OBJ_006_SEEN"] = "¡Soy N┬║ 4!\n¿Estás cansado todavía?",
  ["TEXT_ROUTE25_OBJ_007"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_007_AFTER"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_007_BEATEN"] = "Nossa! Demais.",
  ["TEXT_ROUTE25_OBJ_007_SEEN"] = "Certo! Sou o N┬║ 5.\nVou te esmagar!",
  ["TEXT_ROUTE25_OBJ_008"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_008_AFTER"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_ROUTE25_OBJ_008_BEATEN"] = "tiene que ser una broma",
  ["TEXT_ROUTE25_OBJ_008_SEEN"] = "Sou o último da\nfila, mas eu digo:\vsou durão!",
  ["TEXT_ROUTE25_OBJ_009"] = "Lo siento... no lo haré\nhacer más trampa...",
  ["TEXT_ROUTE25_OBJ_009_AFTER"] = "Lo siento... no lo haré\nhacer más trampa...",
  ["TEXT_ROUTE25_OBJ_009_BEATEN"] = "tu no lo eres\ncansado en absoluto?",
  ["TEXT_ROUTE25_OBJ_009_SEEN"] = "Mufufufu… no tengo nada\nque ver con los seis entrenadores.\fesperé aquí por\nTe golpeé cuando estabas cansado\nde tanta batalla.",
  ["TEXT_ROUTE25_OBJ_010"] = "te enfrentaste\nuna batalla más de la que esperaba,\npero ganó.\fComo prometí,\nganó un premio.",
  ["TEXT_ROUTE26_HEAL_HOUSE_BG_001"] = "..Tus POKéMON son\nun poco cansado.\f├ë Es bueno dejarles\ndescansar.",
  ["TEXT_ROUTE26_HEAL_HOUSE_BG_002"] = "..Tus POKéMON son\nun poco cansado.\f├ë Es bueno dejarles\ndescansar.",
  ["TEXT_ROUTE26_HEAL_HOUSE_OBJ_001"] = "Tus POKéMON son\nun poco cansado.\f├ë Es bueno dejarles\ndescansar.",
  ["TEXT_ROUTE26_OBJ_001"] = "sera dificil\nganar en la LIGA.\vNecesito entrenar más.\nEscuché que ELITE CUATRO es\nmás duro que los LÍDERES de\nGIMNASIO.",
  ["TEXT_ROUTE26_OBJ_001_AFTER"] = "sera dificil\nganar en la LIGA.\vNecesito entrenar más.\nEscuché que ELITE CUATRO es\nmás duro que los LÍDERES de\nGIMNASIO.",
  ["TEXT_ROUTE26_OBJ_001_BEATEN"] = "Eu estraguei!",
  ["TEXT_ROUTE26_OBJ_001_SEEN"] = "estoy en nosotros\nPreparativos finales para POKéMON\nLIGA.",
  ["TEXT_ROUTE26_OBJ_002_AFTER"] = "Para chegar ├á\nLEAGUE POKéMON,\ftem que atravessar\na VICTORY ROAD.\fMas a VICTORY ROAD\né difícil.\fQuase ninguém\nvai lá!",
  ["TEXT_ROUTE26_OBJ_002_BEATEN"] = "Aaah! A vida é\ntão difícil!",
  ["TEXT_ROUTE26_OBJ_002_SEEN"] = "Pasando por\nEn batallas duras, se gana poder.",
  ["TEXT_ROUTE26_OBJ_003"] = "Eu derrotei\noito LÍDERES,\fentão estava\nconfiante.\fVou ter que\nme esforçar mais.",
  ["TEXT_ROUTE26_OBJ_003_AFTER"] = "Eu derrotei\noito LÍDERES,\fentão estava\nconfiante.\fVou ter que\nme esforçar mais.",
  ["TEXT_ROUTE26_OBJ_003_BEATEN"] = "¡No! yo no\n¡Lo creo!",
  ["TEXT_ROUTE26_OBJ_003_SEEN"] = "desde que llegaste\nHasta ahora debería estar bien.\fle daré esto\n¡Lucha contra todo lo que tengo!",
  ["TEXT_ROUTE26_OBJ_004"] = "POKEMON no lo son\nherramientas de guerra.",
  ["TEXT_ROUTE26_OBJ_004_AFTER"] = "POKÉMON son\nsocios valiosos para toda la vida.",
  ["TEXT_ROUTE26_OBJ_004_BEATEN"] = "POKEMON no lo son\nherramientas de guerra.",
  ["TEXT_ROUTE26_OBJ_004_SEEN"] = "perdí contra\n {RIVAL}.\fel era muy\nfuerte, pero... Era como si él\nQuería ganar a cualquier precio.\fSentí pena por el\nsu POKéMON.",
  ["TEXT_ROUTE26_OBJ_005"] = "Boa batalha!",
  ["TEXT_ROUTE26_OBJ_005_AFTER"] = "Personas y POKEMON\ncrecer a partir de sus experiencias.\fNo te quedes quieto\ny acomodado.",
  ["TEXT_ROUTE26_OBJ_005_BEATEN"] = "Boa batalha!",
  ["TEXT_ROUTE26_OBJ_005_SEEN"] = "Vaya, míralos a todos.\nestas INSIGNIAS!\vImpresionado.\fPero no lo haces\nse conforma con recogerlos,\n¿verdad?",
  ["TEXT_ROUTE26_OBJ_006"] = "¡No! en esta batalla\n¡no!",
  ["TEXT_ROUTE26_OBJ_006_AFTER"] = "como pescar,\nen POKéMON todo se pierde si\nte rindes.",
  ["TEXT_ROUTE26_OBJ_006_BEATEN"] = "¡No! en esta batalla\n¡no!",
  ["TEXT_ROUTE26_OBJ_006_SEEN"] = "Estou me sentindo\nótimo hoje!\fSinto que poderia\nvencer até\vo CAMPEÃO!",
  ["TEXT_ROUTE27_OBJ_001"] = "si ganas\nEste camino es duro, la verdad lo será.\nrevelado!\fJe, lo siento, solo\nQuería decir algo bonito.",
  ["TEXT_ROUTE27_OBJ_001_AFTER"] = "si ganas\nEste camino es duro, la verdad lo será.\nrevelado!\fJe, lo siento, solo\nQuería decir algo bonito.",
  ["TEXT_ROUTE27_OBJ_001_SEEN"] = "pareces\nmuy fuerte.\v¡Luchemos!",
  ["TEXT_ROUTE27_OBJ_002"] = "Um bom treinador\nreconhece outros\vbons treinadores.",
  ["TEXT_ROUTE27_OBJ_002_AFTER"] = "Um bom treinador\nreconhece outros\vbons treinadores.",
  ["TEXT_ROUTE27_OBJ_002_BEATEN"] = "Como eu pensei!",
  ["TEXT_ROUTE27_OBJ_002_SEEN"] = "¿Mmm? Eres bueno\n¿no es así?",
  ["TEXT_ROUTE27_OBJ_003_AFTER"] = "eres un chico,\nPero no te pueden subestimar.\nNi de lejos.",
  ["TEXT_ROUTE27_OBJ_003_BEATEN"] = "¡Oh! tu eres\n¡demasiado fuerte!",
  ["TEXT_ROUTE27_OBJ_003_SEEN"] = "no deberías\nsubestimar a los POKéMON salvajes\nestas bandas.",
  ["TEXT_ROUTE27_OBJ_004"] = "¡Oh! eres muy\nrealmente fuerte!",
  ["TEXT_ROUTE27_OBJ_004_AFTER"] = "Analizo POKéMON\nAntes y después de la evolución.\frealmente evolucionar\nhace a POKéMON más fuerte.\fPero las formas\nlos evolucionados también aprenden más tarde.",
  ["TEXT_ROUTE27_OBJ_004_BEATEN"] = "¡Oh! eres muy\nrealmente fuerte!",
  ["TEXT_ROUTE27_OBJ_004_SEEN"] = "├ë raro de ver\ncualquiera aquí.\ftu entrenas\n¿solo?",
  ["TEXT_ROUTE27_OBJ_005"] = "Con tu fuerza,\nLo estás haciendo bien en la LIGA.\f├ë que dices mi\npremonición.",
  ["TEXT_ROUTE27_OBJ_005_AFTER"] = "Con tu fuerza,\nLo estás haciendo bien en la LIGA.\f├ë que dices mi\npremonición.",
  ["TEXT_ROUTE27_OBJ_005_BEATEN"] = "¡Usted es maravilloso!",
  ["TEXT_ROUTE27_OBJ_005_SEEN"] = "¡No digas nada!\fdéjame adivinar\n¿Qué piensas?\fMmmmmmm… ¡lo encontré! eres tu\nen el desafío LIGA POKéMON!",
  ["TEXT_ROUTE27_OBJ_006_AFTER"] = "BIRD KEEPERS, nós\nimitamos assobios\fpara comandar\nos POKéMON.",
  ["TEXT_ROUTE27_OBJ_006_BEATEN"] = "Piu!",
  ["TEXT_ROUTE27_OBJ_006_SEEN"] = "Tweet! Tweet!\nTetweet!",
  ["TEXT_ROUTE27_OBJ_009"] = "saber lo que tu\n¿acabas de hacerlo?\fdiste tu\nprimer paso en KANTO.\fCompruébalo en\nmapa de POKEGEAR",
  ["TEXT_ROUTE27_SANDSTORM_HOUSE_BG_001"] = "...a donde vas\ncon POKÉMON?\f¿LIGA POKEMON?\fTus POKéMON son\n¿Lo suficientemente leal como para ganar?\fDéjeme ver...",
  ["TEXT_ROUTE27_SANDSTORM_HOUSE_BG_002"] = "...a donde vas\ncon POKÉMON?\f¿LIGA POKEMON?\fTus POKéMON son\n¿Lo suficientemente leal como para ganar?\fDéjeme ver...",
  ["TEXT_ROUTE27_SANDSTORM_HOUSE_OBJ_001"] = "¿A dónde vas?\ncon POKÉMON?\f¿LIGA POKEMON?\fTus POKéMON son\n¿Lo suficientemente leal como para ganar?\fDéjeme ver...",
  ["TEXT_ROUTE28_STEEL_WING_HOUSE_BG_001"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_ROUTE28_STEEL_WING_HOUSE_BG_002"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_ROUTE28_STEEL_WING_HOUSE_OBJ_001"] = "Ay dios mío.\nMe encontraste.\fPor favor no\ndíselo a cualquiera.\fte doy esto\npara guardar el secreto. ¿Sí?",
  ["TEXT_ROUTE29_OBJ_001"] = "¿Hay? ¿me quieres?\n¿Muestra cómo atrapar POKéMON?",
  ["TEXT_ROUTE29_OBJ_002"] = "Y ahí. como estas\n¿Tu POKEMON?\fsi son débiles\ny sin preparación, mantente fuera del\narbusto.",
  ["TEXT_ROUTE29_OBJ_003"] = "Viu aqueles\nbarrancos? Dá medo\vpular deles.\fMas dá para ir a\nNEW BARK sem\fpassar pelo\nmato.",
  ["TEXT_ROUTE29_OBJ_005"] = "Quis dar uma\npausa, e salvei\fpara guardar meu\nprogresso.",
  ["TEXT_ROUTE29_OBJ_006"] = "estoy esperando\nPOKéMON que solo aparecen ├á\nnoche.",
  ["TEXT_ROUTE29_OBJ_007"] = "TUSCANY: Creio eu\nque esta é a\fprimeira vez que\nnos vemos?\fPermita-me que eu\nme apresente.\fSou TUSCANY, de\nterça-feira.",
  ["TEXT_ROUTE29_ROUTE46_GATE_OBJ_001"] = "no puedo subir\nbarranco.\fPero puedes saltar\ndesde arriba de ellos y corta el camino.",
  ["TEXT_ROUTE2_NUGGET_HOUSE_OBJ_001"] = "¡Ey! Vaya que bueno\nNos vemos.\ftu eres el primero\nvisita que tengo desde hace mucho tiempo.\f¡Estoy súper feliz!\nDéjame hacerte un pequeño regalo.",
  ["TEXT_ROUTE2_OBJ_001"] = "Vou procurar\nPOKéMON inseto\vmais fortes.",
  ["TEXT_ROUTE2_OBJ_001_AFTER"] = "Vou procurar\nPOKéMON inseto\vmais fortes.",
  ["TEXT_ROUTE2_OBJ_001_BEATEN"] = "Fui destroçado…",
  ["TEXT_ROUTE2_OBJ_001_SEEN"] = "mi pokemon\nLos insectos son fuertes.\v¡Prepárate para perder!",
  ["TEXT_ROUTE2_OBJ_002"] = "realmente arde\ncuando te duchas.",
  ["TEXT_ROUTE2_OBJ_002_AFTER"] = "realmente arde\ncuando te duchas.",
  ["TEXT_ROUTE2_OBJ_002_BEATEN"] = "Ai, ai, ai!",
  ["TEXT_ROUTE2_OBJ_002_SEEN"] = "si entras\narbusto alto en pantalones cortos, se corta\ntodos?",
  ["TEXT_ROUTE2_OBJ_003"] = "insecto pokemon\naplastar como un animal de peluche\ncuando les aprietas la barriga.\fMe encanta como ellos\nson!",
  ["TEXT_ROUTE2_OBJ_003_AFTER"] = "insecto pokemon\naplastar como un animal de peluche\ncuando les aprietas la barriga.\fMe encanta como ellos\nson!",
  ["TEXT_ROUTE2_OBJ_003_BEATEN"] = "¡No fue así!",
  ["TEXT_ROUTE2_OBJ_003_SEEN"] = "¿Por qué las chicas\n¿No te gustan?",
  ["TEXT_ROUTE30_BERRY_HOUSE_BG_001"] = "...Ya sabes, POKEMON\ncomer BAYAS.\fBueno, mi POKEMON\nSe hizo más fuerte comiendo un BERRY Toma. voy a compartir\nuno contigo!",
  ["TEXT_ROUTE30_BERRY_HOUSE_BG_002"] = "...Ya sabes, POKEMON\ncomer BAYAS.\fBueno, mi POKEMON\nSe hizo más fuerte comiendo un BERRY Toma. voy a compartir\nuno contigo!",
  ["TEXT_ROUTE30_BERRY_HOUSE_OBJ_001"] = "ya sabes pokemon\ncomer BAYAS.\fBueno, mi POKEMON\nSe hizo más fuerte comiendo un BERRY Toma. voy a compartir\nuno contigo!",
  ["TEXT_ROUTE30_OBJ_001"] = "Vai, RATTATA!\fTACKLE!",
  ["TEXT_ROUTE30_OBJ_002_AFTER"] = "necesito tener\nmás POKéMON para batallas.\fconseguiré más\nun poco!",
  ["TEXT_ROUTE30_OBJ_002_BEATEN"] = "Ai! Perdi de novo!\nQue droga!",
  ["TEXT_ROUTE30_OBJ_002_SEEN"] = "acabo de perder,\nVoy a buscar más POKéMON.\f¡Esperar! tu\n¡Parece débil!\v¡Luchemos!",
  ["TEXT_ROUTE30_OBJ_003"] = "Conviértete en un buen\nEntrenar es difícil.\fpelearé\ncon otras personas para mejorar.",
  ["TEXT_ROUTE30_OBJ_003_AFTER"] = "Conviértete en un buen\nEntrenar es difícil.\fpelearé\ncon otras personas para mejorar.",
  ["TEXT_ROUTE30_OBJ_003_BEATEN"] = "Estranho.\nEu venci antes.",
  ["TEXT_ROUTE30_OBJ_003_SEEN"] = "eres un\nentrenador, ¿verdad?\fEntonces tienes que\nbatalla!",
  ["TEXT_ROUTE30_OBJ_004"] = "Fiquei sem POKé\nBALLS enquanto\vcapturava POKéMON\fDevia ter trazido\nmais…",
  ["TEXT_ROUTE30_OBJ_004_AFTER"] = "Fiquei sem POKé\nBALLS enquanto\vcapturava POKéMON\fDevia ter trazido\nmais…",
  ["TEXT_ROUTE30_OBJ_004_BEATEN"] = "¡Argh! tu eres\n¡demasiado fuerte!",
  ["TEXT_ROUTE30_OBJ_004_SEEN"] = "Em vez de um\nPOKéMON, achei\vum treinador!",
  ["TEXT_ROUTE30_OBJ_005"] = "A casa do\nMR.POKéMON? Fica\vum pouco adiante.",
  ["TEXT_ROUTE30_OBJ_010"] = "No soy entrenador, pero si miras\nOjos de uno, prepárate.",
  ["TEXT_ROUTE31_BG_001"] = "DARK CAVE…\fSe um POKéMON\npudesse iluminar,\veu exploraria.",
  ["TEXT_ROUTE31_BG_002"] = "DARK CAVE…\fSe um POKéMON\npudesse iluminar,\veu exploraria.",
  ["TEXT_ROUTE31_OBJ_001"] = "… Hnnn… ¿Eh?\fCaminé demasiado hoy\nBuscando POKÉMON.\fMe duelen los pies y\nTengo sueño... Si fuera un\nPOKéMON salvaje, sería fácil… …Zzzz…",
  ["TEXT_ROUTE31_OBJ_002"] = "Achei um bom\nPOKéMON na DARK\vCAVE.\fVou criar ele\npara encarar o\vFALKNER.\fEle é o líder do\nGINÁSIO de VIOLET",
  ["TEXT_ROUTE31_OBJ_003_AFTER"] = "puedes atrapar\nPOKéMON aunque tengas seis.\nSi atrapas uno, va al tuyo.\nCAJA automáticamente.",
  ["TEXT_ROUTE31_OBJ_003_BEATEN"] = "Aaaah…",
  ["TEXT_ROUTE31_OBJ_003_SEEN"] = "tomé mucho\nde POKÉMON. lucharemos contigo",
  ["TEXT_ROUTE31_OBJ_004"] = "DARK CAVE…\fSe um POKéMON\npudesse iluminar,\veu exploraria.",
  ["TEXT_ROUTE31_VIOLET_GATE_OBJ_001"] = "Hola hombre!\n¿Has visitado SPROUT TOWER?",
  ["TEXT_ROUTE32_OBJ_001"] = "Calmo, concentrado\nA essência da\fpesca e dos\nPOKéMON é a\vmesma.",
  ["TEXT_ROUTE32_OBJ_001_AFTER"] = "Calmo, concentrado\nA essência da\fpesca e dos\nPOKéMON é a\vmesma.",
  ["TEXT_ROUTE32_OBJ_001_BEATEN"] = "Splash!",
  ["TEXT_ROUTE32_OBJ_001_SEEN"] = "¡Guau!\fMe hiciste perder\nese pez!",
  ["TEXT_ROUTE32_OBJ_002_AFTER"] = "Pescar é paixão\nde uma vida.\fPOKéMON são amigos\nde uma vida!",
  ["TEXT_ROUTE32_OBJ_002_BEATEN"] = "Tch! Quis apressar\nas coisas…",
  ["TEXT_ROUTE32_OBJ_002_SEEN"] = "soy muy bueno\nen pesca y en POKéMON.\fno perderé\n¡para ningún niño!",
  ["TEXT_ROUTE32_OBJ_003"] = "POKÉMON\nLos recién capturados no son rival para los buenos.\ncreado.",
  ["TEXT_ROUTE32_OBJ_003_AFTER"] = "POKÉMON\nLos recién capturados no son rival para los buenos.\ncreado.",
  ["TEXT_ROUTE32_OBJ_003_SEEN"] = "¿Mi POKEMON?\n¡Recién pescado!",
  ["TEXT_ROUTE32_OBJ_004"] = "intentaré ser el\nmejor con mis favoritos.\fNo uso los mismos\nPOKéMON fuertes que todos usan.",
  ["TEXT_ROUTE32_OBJ_004_AFTER"] = "intentaré ser el\nmejor con mis favoritos.\fNo uso los mismos\nPOKéMON fuertes que todos usan.",
  ["TEXT_ROUTE32_OBJ_004_BEATEN"] = "¡Eres fuerte!",
  ["TEXT_ROUTE32_OBJ_004_SEEN"] = "nunca te vi\naquí antes.\fEntonces piensas\n¿bastante duro?",
  ["TEXT_ROUTE32_OBJ_005"] = "O mato está cheio\nde coisa grudenta",
  ["TEXT_ROUTE32_OBJ_005_AFTER"] = "O mato está cheio\nde coisa grudenta",
  ["TEXT_ROUTE32_OBJ_005_BEATEN"] = "Droga. Achei que\nia ganhar.",
  ["TEXT_ROUTE32_OBJ_005_SEEN"] = "Encontré algunos POKEMON\n¡Buenos allí en el bosque!\fcreo que lo harán\n¡date cuenta!",
  ["TEXT_ROUTE32_OBJ_006"] = "Si no quieres\nPelea, evita mirar a los ojos.",
  ["TEXT_ROUTE32_OBJ_006_AFTER"] = "Si no quieres\nPelea, evita mirar a los ojos.",
  ["TEXT_ROUTE32_OBJ_006_BEATEN"] = "Hmmm. Que\ndecepção.",
  ["TEXT_ROUTE32_OBJ_006_SEEN"] = "Aquele olhar…\n├ë intrigante.",
  ["TEXT_ROUTE32_OBJ_007_AFTER"] = "E eu estava numa\nboa conversa.",
  ["TEXT_ROUTE32_OBJ_007_BEATEN"] = "Ah! Preciso\ndescontar minha\vraiva!",
  ["TEXT_ROUTE32_OBJ_007_SEEN"] = "Ejem. ├ë, y\nYa sabes cómo es… ¿Cómo? ¿Batalla?\nEstoy hablando por teléfono. Oh, está bien. pero\nsé rápido.",
  ["TEXT_ROUTE32_OBJ_008"] = "{PLAYER}, ¿verdad?\nUn chico con gafas estaba mirando\npara ti.\fVe a verlo por ti mismo.\nTe espera en el CENTRO\nPOKÉMON.",
  ["TEXT_ROUTE32_OBJ_009"] = "Eu devia treinar\nde novo no GINÁSIO\vde CIDADE DE\vVIOLET.",
  ["TEXT_ROUTE32_OBJ_009_AFTER"] = "Eu devia treinar\nde novo no GINÁSIO\vde CIDADE DE\vVIOLET.",
  ["TEXT_ROUTE32_OBJ_009_BEATEN"] = "se cuales son\nmis debilidades.",
  ["TEXT_ROUTE32_OBJ_009_SEEN"] = "Essa BADGE! ├ë de\nCIDADE DE VIOLET!\fVenceu o FALKNER?",
  ["TEXT_ROUTE32_OBJ_010"] = "¿Qué tal tomar\nEs delicioso y nutritivo.\n¿COLA LENTA?\fPara ti ahora,\n¡solo ┬Ñ1,000,000!\f¡Lo querrás!",
  ["TEXT_ROUTE32_OBJ_012"] = "¡GUAUAR!\n¡LA GENTE HUYE CUANDO RUJO! PERO TÚ\n¡VEN DETRÁS!\f¡ESTO ME AGRADE!\n¡AHORA TOMA ESTO!",
  ["TEXT_ROUTE32_OBJ_013"] = "FRIEDA: Oba!\n├ë sexta-feira!\fSou a FRIEDA de\nsexta!\fPrazer!",
  ["TEXT_ROUTE32_POKECENTER1_F_OBJ_001"] = "Este es un gran\nlugar de pesca.\f¿Viste gente?\n¿pesca? ¿Y tú?\f¿Quieres uno de\nmis VARILLAS?",
  ["TEXT_ROUTE32_POKECENTER1_F_OBJ_002"] = "Este es un gran\nlugar de pesca.\f¿Viste gente?\n¿pesca? ¿Y tú?\f¿Quieres uno de\nmis VARILLAS?",
  ["TEXT_ROUTE32_POKECENTER1_F_OBJ_003"] = "mTMEste es un gran\nlugar para pescar.\f¿Viste gente?\n¿pescar? ¿Y tú?\f¿Quieres uno de\nmis VARILLAS?",
  ["TEXT_ROUTE32_RUINS_OF_ALPH_GATE_OBJ_001"] = "\f{BYTE:36}{USER}\fB{USER}\f{BYTE:BD}{USER}RUINS OF ALPH\fPonto Turístico\nde Ver e Tocar\fExperimente os\npainéis de pedra!",
  ["TEXT_ROUTE32_RUINS_OF_ALPH_GATE_OBJ_002"] = "\fB{USER}\f{BYTE:BD}{USER}RUINS OF ALPH\fPonto Turístico\nde Ver e Tocar\fExperimente os\npainéis de pedra!",
  ["TEXT_ROUTE32_RUINS_OF_ALPH_GATE_OBJ_003"] = "\f{BYTE:BD}{USER}RUINS OF ALPH\fPonto Turístico\nde Ver e Tocar\fExperimente os\npainéis de pedra!",
  ["TEXT_ROUTE33_BG_001"] = "{RIVAL} {BYTE:79} {BYTE:42}) Entré por el túnel,\npero todavía tengo mucha energía\nsobrantes.",
  ["TEXT_ROUTE33_OBJ_001_AFTER"] = "Nós HIKERS somos\nmelhores nas\vmontanhas.",
  ["TEXT_ROUTE33_OBJ_001_BEATEN"] = "¡Guau, muchacho! tu\nhay más gasolina.",
  ["TEXT_ROUTE33_OBJ_001_SEEN"] = "Entré por el túnel,\npero todavía tengo mucha energía\nsobrantes.",
  ["TEXT_ROUTE33_OBJ_002"] = "Ufa, ufa…\fFinalmente saí\ndaquela caverna.\fEra bem maior do\nque eu esperava.\fFiquei cansado\ndemais pra\vexplorar tudo\fentão vim pra\nfora.",
  ["TEXT_ROUTE33_OBJ_003"] = ")Entré por el túnel,\npero todavía tengo mucha energía\nsobrantes.",
  ["TEXT_ROUTE34_ILEX_FOREST_GATE_OBJ_001"] = "Oh, cariño. hacer\n¿Una POKéDEX?\fdebe ser dificil\nsi los POKéMON no aparecen.\nIntente usar TM.",
  ["TEXT_ROUTE34_ILEX_FOREST_GATE_OBJ_003"] = "Viu o santuário\nem honra ao\vprotetor?\fEle vigia a\nFLORESTA através\vdos tempos.\fAcho que deve ser\num POKéMON do tipo\vgrama.",
  ["TEXT_ROUTE34_ILEX_FOREST_GATE_OBJ_004"] = "Oh, cariño. hacer\n¿Una POKéDEX?\fdebe ser dificil\nsi los POKéMON no aparecen.\nIntente usar TM.",
  ["TEXT_ROUTE34_OBJ_001_AFTER"] = "Talvez eu devesse\ndeixar um no\vDAYCARE. O que eu\vfaço?",
  ["TEXT_ROUTE34_OBJ_001_BEATEN"] = "¿Cometí un error?\nmi entrenamiento?",
  ["TEXT_ROUTE34_OBJ_001_SEEN"] = "tengo confianza\nen mi forma de crear POKéMON.\f¿Quieres ver?",
  ["TEXT_ROUTE34_OBJ_002"] = "O que aconteceu?",
  ["TEXT_ROUTE34_OBJ_002_AFTER"] = "todavía entrenaré\nmás fuerte.\fDespués de todo, quiero\nconviértete en un LÍDER DE GIMNASIO.",
  ["TEXT_ROUTE34_OBJ_002_BEATEN"] = "Derrotado por um\nestranho de\vpassagem!",
  ["TEXT_ROUTE34_OBJ_002_SEEN"] = "├ë aqui que eu\ntreino!",
  ["TEXT_ROUTE34_OBJ_003"] = "me esfuerzo por\nser lo más destacado de mi clase.",
  ["TEXT_ROUTE34_OBJ_003_AFTER"] = "me esfuerzo por\nser lo más destacado de mi clase.",
  ["TEXT_ROUTE34_OBJ_003_BEATEN"] = "¡No! tiene\nmejores entrenadores...",
  ["TEXT_ROUTE34_OBJ_003_SEEN"] = "Sou o melhor da\nturma em POKéMON.",
  ["TEXT_ROUTE34_OBJ_004_AFTER"] = "tu eres fuerte\ndemasiado para ser mi pareja.",
  ["TEXT_ROUTE34_OBJ_004_BEATEN"] = "¡Oh, no! yo no\npuedo ganar...",
  ["TEXT_ROUTE34_OBJ_004_SEEN"] = "¿Eres entrenador?\fhagamos uno\nbatalla de entrenamiento",
  ["TEXT_ROUTE34_OBJ_005"] = "¿Quién viene ahí?\n¿Qué estás haciendo?",
  ["TEXT_ROUTE34_OBJ_006"] = "Mi POKEMON lo sabia\nmovimientos que ni siquiera sabía que tenía.\fEsto me confundió\n¡demasiado!",
  ["TEXT_ROUTE34_OBJ_006_AFTER"] = "Mi POKEMON lo sabia\nmovimientos que ni siquiera sabía que tenía.\fEsto me confundió\n¡demasiado!",
  ["TEXT_ROUTE34_OBJ_006_BEATEN"] = "Por que termina\nassim?",
  ["TEXT_ROUTE34_OBJ_006_SEEN"] = "lo acabo de recibir\nmi POKéMON de vuelta en DAY-CARE A ver cuánto\n¡Se hizo fuerte!",
  ["TEXT_ROUTE34_OBJ_010"] = "IRENE: Mi hermana\n¡KATE te atrapará por esto!",
  ["TEXT_ROUTE34_OBJ_010_AFTER"] = "IRENE: Mi hermana\n¡KATE te atrapará por esto!",
  ["TEXT_ROUTE34_OBJ_010_BEATEN"] = "IRENE: Ooooh!\nEle é forte!",
  ["TEXT_ROUTE34_OBJ_010_SEEN"] = "IRENE: Aaaai!\nUm menino achou!",
  ["TEXT_ROUTE34_OBJ_011"] = "JENN: No pienses\n¡demasiado! ¡Mi hermana KATE es una ruda!",
  ["TEXT_ROUTE34_OBJ_011_AFTER"] = "JENN: No pienses\n¡demasiado! ¡Mi hermana KATE es una ruda!",
  ["TEXT_ROUTE34_OBJ_011_BEATEN"] = "JENN: Me desculpe,\nIRENE! Maninha!",
  ["TEXT_ROUTE34_OBJ_011_SEEN"] = "jenn: no puedo\n¡Golpea a IRENE y queda impune!",
  ["TEXT_ROUTE34_OBJ_012"] = "kate: eres fuerte\ndemasiado. No tuve oportunidad.\fAquí. Te lo mereces\nesto.",
  ["TEXT_ROUTE34_OBJ_012_AFTER"] = "kate: eres fuerte\ndemasiado. No tuve oportunidad.\fAquí. Te lo mereces\nesto.",
  ["TEXT_ROUTE34_OBJ_012_BEATEN"] = "KATE: ¡No! No\nYo creo eso.",
  ["TEXT_ROUTE34_OBJ_012_SEEN"] = "kate: lo hiciste bien\nmalo con mis hermanitas",
  ["TEXT_ROUTE35_GOLDENROD_GATE_OBJ_001"] = "¡Oye, muchacho!\n¿Puedes hacerme un favor?\fpuedes tomar esto\n¿POKéMON con CORREO a mi amigo?\fPor la RUTA 31.",
  ["TEXT_ROUTE35_GOLDENROD_GATE_OBJ_002"] = "un arbol\nUn extraño bloquea el camino.\nElla se mueve si hablas.\nDicen que se volvió loca\ncon BOTELLA DE SQUIRT.",
  ["TEXT_ROUTE35_NATIONAL_PARK_GATE_OBJ_001"] = "Hoy es {RAM:D099}.\nEn otras palabras, hay una Competencia de Caza.\na los insectos hoy.\flas reglas son\nsencillo.\fUsando uno de\ntu POKéMON, atrapa un POKéMON\ninsecto para juzgar.\f¿Quieres intentarlo?",
  ["TEXT_ROUTE35_NATIONAL_PARK_GATE_OBJ_002"] = "Quando é o\npróximo Concurso\vde Insetos?",
  ["TEXT_ROUTE35_NATIONAL_PARK_GATE_OBJ_003"] = "Fazemos Concursos\nno PARK toda\fhora. Deveria\ntentar.",
  ["TEXT_ROUTE35_OBJ_001"] = "A música do rádio\nmuda o humor dos\vPOKéMON selvagens",
  ["TEXT_ROUTE35_OBJ_001_AFTER"] = "A música do rádio\nmuda o humor dos\vPOKéMON selvagens",
  ["TEXT_ROUTE35_OBJ_001_BEATEN"] = "Eu desisto!",
  ["TEXT_ROUTE35_OBJ_001_SEEN"] = "Venho pegando\ndados de POKéMON\fno rádio. Acho\nque estou bom.",
  ["TEXT_ROUTE35_OBJ_002"] = "Fui humilhado\nna frente da minha\vnamorada…",
  ["TEXT_ROUTE35_OBJ_002_AFTER"] = "Fui humilhado\nna frente da minha\vnamorada…",
  ["TEXT_ROUTE35_OBJ_002_BEATEN"] = "te quería\nhabia perdido...",
  ["TEXT_ROUTE35_OBJ_002_SEEN"] = "se lo mostraré a\nmi novia que soy buena!",
  ["TEXT_ROUTE35_OBJ_003"] = "Confío más en nosotros\nmi POKéMON que mi novio.",
  ["TEXT_ROUTE35_OBJ_003_AFTER"] = "Confío más en nosotros\nmi POKéMON que mi novio.",
  ["TEXT_ROUTE35_OBJ_003_BEATEN"] = "¡Nuestro! tu eres\n¡tan fuerte!",
  ["TEXT_ROUTE35_OBJ_003_SEEN"] = "mi novio es\nDébil, no puedes contar con él.",
  ["TEXT_ROUTE35_OBJ_004"] = "As BADGES de\nGINÁSIO são lindas\vEu coleciono.",
  ["TEXT_ROUTE35_OBJ_004_AFTER"] = "As BADGES de\nGINÁSIO são lindas\vEu coleciono.",
  ["TEXT_ROUTE35_OBJ_004_BEATEN"] = "Oh. yo no\nLo tengo...",
  ["TEXT_ROUTE35_OBJ_004_SEEN"] = "tu vas al\n¿GIMNASIO? ¡Voy!",
  ["TEXT_ROUTE35_OBJ_005"] = "Algunos Pokémon\nhuyen de inmediato.\fIntenta atraparlos\ncon la BOLA RÁPIDA de KURT.\fSiempre que encuentro uno\nQUÉ ALBARICORNIO, se lo llevaré a KURT.\fÉl hace un POKé\nBOLA hecha a medida.",
  ["TEXT_ROUTE35_OBJ_005_AFTER"] = "Algunos Pokémon\nhuyen de inmediato.\fIntenta atraparlos\ncon la BOLA RÁPIDA de KURT.\fSiempre que encuentro uno\nQUÉ ALBARICORNIO, se lo llevaré a KURT.\fÉl hace un POKé\nBOLA hecha a medida.",
  ["TEXT_ROUTE35_OBJ_005_BEATEN"] = "¡Dios! yo no fui\nlo suficientemente rápido",
  ["TEXT_ROUTE35_OBJ_005_SEEN"] = "Que clase de POKE\n¿BOLA que utilizas?",
  ["TEXT_ROUTE35_OBJ_006"] = "A POKéMON March\nno rádio atrai\vPOKéMON do mato.",
  ["TEXT_ROUTE35_OBJ_006_AFTER"] = "A POKéMON March\nno rádio atrai\vPOKéMON do mato.",
  ["TEXT_ROUTE35_OBJ_006_BEATEN"] = "Ai! Queimei a\nponta do nariz!",
  ["TEXT_ROUTE35_OBJ_006_SEEN"] = "estoy entrenando\nmi aliento de fuego",
  ["TEXT_ROUTE35_OBJ_007_AFTER"] = "Mi VENONAT ganó\nel concurso de captura de insectos\nen el PARQUE NACIONAL.",
  ["TEXT_ROUTE35_OBJ_007_BEATEN"] = "¿Hay? no debería\nMe perdí este...",
  ["TEXT_ROUTE35_OBJ_007_SEEN"] = "Eu vou a qualquer\nlugar onde apareça\vPOKéMON inseto.",
  ["TEXT_ROUTE35_OBJ_008"] = "yo deslumbraría\ntú con mi preciado POKéMON.\fpero tu fuerza\n¡Me electrizó!",
  ["TEXT_ROUTE35_OBJ_008_AFTER"] = "yo deslumbraría\ntú con mi preciado POKéMON.\fpero tu fuerza\n¡Me electrizó!",
  ["TEXT_ROUTE35_OBJ_008_BEATEN"] = "Ufa! Que choque\nfoi esse!",
  ["TEXT_ROUTE35_OBJ_008_SEEN"] = "mira como estoy\nbien con la BOLA!",
  ["TEXT_ROUTE35_OBJ_009"] = "O perigo espreita\nna noite!",
  ["TEXT_ROUTE35_OBJ_010"] = ")Venho pegando\ndados de POKéMON\fno rádio. Acho\nque estou bom.",
  ["TEXT_ROUTE36_BG_002"] = "lo haré\nsentirme aún peor por haber perdido\npara ti!\fda todo lo que tu\ntienes.",
  ["TEXT_ROUTE36_BG_003"] = "lo haré\nsentirme aún peor por haber perdido\npara ti!\fda todo lo que tu\ntienes.",
  ["TEXT_ROUTE36_BG_004"] = "lo haré\nsentirme aún peor por haber perdido\npara ti!\fda todo lo que tu\ntienes.",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_001"] = "Hoy es {RAM:D099}.\nEn otras palabras, hay una Competencia de Caza.\na los insectos hoy.\flas reglas son\nsencillo.\fUsando uno de\ntu POKéMON, atrapa un POKéMON\ninsecto para juzgar.\f¿Quieres intentarlo?",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_002"] = "DON: Vaya, tú\nganó. Eres muy bueno.",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_003"] = "ED: Te invito.\nEsta vez no lo logré.",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_004"] = "NIC: ¡Muy bien!\nCriaré mejor a mis POKéMON.",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_005"] = "GUILLERMO: Tú y\nel ganador? ¿Qué capturaste?",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_006"] = "BENNY: ¡Felicitaciones!\n¡Te has ganado mi respeto!",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_007"] = "BARRY: EL POKEMON\nque capturaste… ¡e increíble!",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_008"] = "CINDY: ¿Ganaste?\n¡Excelente!\f¿Quieres ir?\n¿Cazar insectos POKéMON conmigo?",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_009"] = "JOSÉ: Yo... no.\nCreo que perdí en el concurso...",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_010"] = "SAMUEL: Na próxima\nvou vencer.",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_011"] = "KIPP: Tú puedes\ndarme consejos?\fquiero estudiar\ntu estilo.",
  ["TEXT_ROUTE36_NATIONAL_PARK_GATE_OBJ_012"] = "Alguns POKéMON só\npodem ser vistos\vno PARQUE.",
  ["TEXT_ROUTE36_OBJ_001"] = "yo seria fuerte\nSi pudiera saber cuál es mi oponente\nestá pensando.",
  ["TEXT_ROUTE36_OBJ_001_AFTER"] = "yo seria fuerte\nSi pudiera saber cuál es mi oponente\nestá pensando.",
  ["TEXT_ROUTE36_OBJ_001_BEATEN"] = "Te avaliei mal!",
  ["TEXT_ROUTE36_OBJ_001_SEEN"] = "Vou ler os\nseus pensamentos!",
  ["TEXT_ROUTE36_OBJ_002_AFTER"] = "Droga. Estudio 5\nhoras/día también.\fHay muchas cosas\nque no se puede aprender simplemente leyendo libros.",
  ["TEXT_ROUTE36_OBJ_002_BEATEN"] = "Ops! Erro de\ncálculo?",
  ["TEXT_ROUTE36_OBJ_002_SEEN"] = "Graças aos meus\nestudos, encaro\vqualquer POKéMON!",
  ["TEXT_ROUTE36_OBJ_003"] = "E uma árvore\nestranha?",
  ["TEXT_ROUTE36_OBJ_004"] = "un arbol\nestá bloqueando el camino a la CIUDAD DE\nVARA DE ORO.\vMe impide comprar.\nAlguien debe actuar.",
  ["TEXT_ROUTE36_OBJ_005"] = "¡Oye!\fme rompería\neste árbol con mi puñetazo\ndirecto.\f¡Pero no pude!\n¡Soy un fracaso!",
  ["TEXT_ROUTE36_OBJ_007"] = "ARTURO: ¿Quién es?\n¿tú?\fSoy ARTHUR de\nJueves.",
  ["TEXT_ROUTE36_OBJ_008"] = "soy FLORIA,\nde FLORES!\f¡Escucha, escucha!\fcuando tiré agua\nen ese árbol que se mueve, ella\nsaltó!\ftiene que ser uno\nPOKÉMON.\fApuesto a que ella\nsaldría del disfraz si tomara uno\nbaño!\f¡Ya lo sé! te lo diré\na mi hermana y coger la botella\nde su agua!",
  ["TEXT_ROUTE36_RUINS_OF_ALPH_GATE_OBJ_001"] = "no preguntes\n¿quién haría algo así?\v¿Y por qué?",
  ["TEXT_ROUTE36_RUINS_OF_ALPH_GATE_OBJ_002"] = "{PC} {BYTE:6A} Tú no\n¿Me pregunto quién haría tal cosa? ¿Y por qué?",
  ["TEXT_ROUTE37_OBJ_001"] = "ana: sé lo que\nmi hermana y mis POKéMON son\npensando.",
  ["TEXT_ROUTE37_OBJ_001_AFTER"] = "ana: sé lo que\nmi hermana y mis POKéMON son\npensando.",
  ["TEXT_ROUTE37_OBJ_001_BEATEN"] = "ANN & ANNE: Nnn…\nForte demais.",
  ["TEXT_ROUTE37_OBJ_001_SEEN"] = "ANN: Eu e ANNE\nestamos juntas\vnessa!",
  ["TEXT_ROUTE37_OBJ_002"] = "ANNE: Sentimos o\nmesmo que os\vnossos POKéMON.",
  ["TEXT_ROUTE37_OBJ_002_AFTER"] = "ANNE: Sentimos o\nmesmo que os\vnossos POKéMON.",
  ["TEXT_ROUTE37_OBJ_002_BEATEN"] = "ANN & ANNE: Nnn…\nForte demais.",
  ["TEXT_ROUTE37_OBJ_002_SEEN"] = "ANNE: ANN y yo\n¡Estamos juntos en esto!",
  ["TEXT_ROUTE37_OBJ_003"] = "Fazer o POKéMON\ndormir ou deixar\vele paralisado são\vboas técnicas.",
  ["TEXT_ROUTE37_OBJ_003_AFTER"] = "Fazer o POKéMON\ndormir ou deixar\vele paralisado são\vboas técnicas.",
  ["TEXT_ROUTE37_OBJ_003_BEATEN"] = "Perdi. Que\ntristeza…",
  ["TEXT_ROUTE37_OBJ_003_SEEN"] = "POKEMON no lo hagas\nnada si están durmiendo.\fte mostraré cómo\nesto da miedo",
  ["TEXT_ROUTE37_OBJ_005"] = "SUNNY: Oi!\fEu sou o SUNNY de\nsábado, ou seja,\vhoje é sábado!",
  ["TEXT_ROUTE38_OBJ_001_AFTER"] = "tengo tantos\npruebas para hacer eso ya queda poco\nhora de POKéMON Entonces, ¿cuándo podrá\nPara jugar me concentro mucho.",
  ["TEXT_ROUTE38_OBJ_001_BEATEN"] = "no lo creo\nEstudié mucho.",
  ["TEXT_ROUTE38_OBJ_001_SEEN"] = "Deixa eu tentar\numa coisa que\vaprendi hoje.",
  ["TEXT_ROUTE38_OBJ_002_AFTER"] = "yo se de uno\nbueno!\fLa leche de MOOMOO\nFARM es famosa por su sabor.",
  ["TEXT_ROUTE38_OBJ_002_BEATEN"] = "Entendi. Então dá\npara lutar assim.",
  ["TEXT_ROUTE38_OBJ_002_SEEN"] = "eres bueno en\ntren?\fSi es así, ¿puedes\nmostrar como?",
  ["TEXT_ROUTE38_OBJ_003"] = "tengo la intención de entrenar\nen CIANWOOD CITY para mi POKéMON\naprende a volar.",
  ["TEXT_ROUTE38_OBJ_003_AFTER"] = "tengo la intención de entrenar\nen CIANWOOD CITY para mi POKéMON\naprende a volar.",
  ["TEXT_ROUTE38_OBJ_003_BEATEN"] = "Dá vontade de sair\nvoando agora.",
  ["TEXT_ROUTE38_OBJ_003_SEEN"] = "Vuela alto en el cielo,\n¡Mi querido pájaro POKéMON!",
  ["TEXT_ROUTE38_OBJ_004"] = "Quando vejo\nPOKéMON, meus\vnervos se\vacalmam.",
  ["TEXT_ROUTE38_OBJ_004_AFTER"] = "Quando vejo\nPOKéMON, meus\vnervos se\vacalmam.",
  ["TEXT_ROUTE38_OBJ_004_BEATEN"] = "Que bom que eu vi\nseus POKéMON!",
  ["TEXT_ROUTE38_OBJ_004_SEEN"] = "¡Ey! que entrenador\nlindo eres!\f¿Puedo ver tu\n¿POKÉMON?",
  ["TEXT_ROUTE38_OBJ_005"] = "Todo tipo de\ngente pelo mundo\fvive feliz com\nos POKéMON.",
  ["TEXT_ROUTE38_OBJ_005_AFTER"] = "Todo tipo de\ngente pelo mundo\fvive feliz com\nos POKéMON.",
  ["TEXT_ROUTE38_OBJ_005_BEATEN"] = "Sua habilidade é\nde nível mundial!",
  ["TEXT_ROUTE38_OBJ_005_SEEN"] = "he estado en\nen el extranjero, así que conozco todo tipo\nde POKÉMON!",
  ["TEXT_ROUTE38_OBJ_006"] = ") {RAM:8500} Vuela alto en el cielo,\n¡Mi querido pájaro POKéMON!",
  ["TEXT_ROUTE38_OBJ_007"] = "LA LECHE MOOMOO es buena\npor la belleza y la salud, pero,\nlamentablemente solo venden uno\nbotella a la vez.",
  ["TEXT_ROUTE38_OBJ_007_AFTER"] = "LA LECHE MOOMOO es buena\npor la belleza y la salud, pero,\nlamentablemente solo venden uno\nbotella a la vez.",
  ["TEXT_ROUTE38_OBJ_007_BEATEN"] = "Bebemos MOOMOO\nMILK todo dia.",
  ["TEXT_ROUTE38_OBJ_007_SEEN"] = "¿No crees que yo y\nmis POKéMON somos hermosos?",
  ["TEXT_ROUTE39_BARN_OBJ_001"] = "Enferma MOOMOO... Ella necesita\nmuchas BAYAS.",
  ["TEXT_ROUTE39_BARN_OBJ_002"] = "Enferma MOOMOO... Ella necesita\nmuchas BAYAS.",
  ["TEXT_ROUTE39_FARMHOUSE_BG_001"] = "Uma coleção\ninteira de livros\vde POKéMON!",
  ["TEXT_ROUTE39_FARMHOUSE_BG_002"] = "Uma coleção\ninteira de livros\vde POKéMON!",
  ["TEXT_ROUTE39_FARMHOUSE_OBJ_001"] = "MILTANK no\nda leche pero no.\vahora.\fEsta GRANJA aquí\nTiene leche famosa.\fCasi todos\nquiero beber.\fella me da mucho\nleche si le doy muchas BAYAS,\ncreo.",
  ["TEXT_ROUTE39_FARMHOUSE_OBJ_002"] = "nuestra leche va\nIncluso a KANTO.\fEntonces si nuestro\nMILTANK no da leche, nos quedamos\nen problemas.",
  ["TEXT_ROUTE39_OBJ_001"] = "Mis POKéMON eran\ncapturado y criado en el extranjero.\fson mios\ncompañeros en largos viajes.",
  ["TEXT_ROUTE39_OBJ_001_AFTER"] = "Mis POKéMON eran\ncapturado y criado en el extranjero.\fson mios\ncompañeros en largos viajes.",
  ["TEXT_ROUTE39_OBJ_001_BEATEN"] = "Aaaargh!",
  ["TEXT_ROUTE39_OBJ_001_SEEN"] = "Acabei de voltar\npara OLIVINE.\fQue tal uma\nbatalha POKéMON?",
  ["TEXT_ROUTE39_OBJ_002_AFTER"] = "no escucharé\n¡alardeas!\fNosotros POKé FANS\nTenemos una regla de no escuchar\notros se jactan",
  ["TEXT_ROUTE39_OBJ_002_BEATEN"] = "No hubo tiempo para\nmostrar PIKACHU…",
  ["TEXT_ROUTE39_OBJ_002_SEEN"] = "¿Te importa si\n¿Presumo de mi POKéMON?",
  ["TEXT_ROUTE39_OBJ_003"] = "¿Sabes acerca de\n¿Bebé POKEMON?\fApuesto que lo son\n¡demasiado lindo!",
  ["TEXT_ROUTE39_OBJ_003_AFTER"] = "¿Sabes acerca de\n¿Bebé POKEMON?\fApuesto que lo son\n¡demasiado lindo!",
  ["TEXT_ROUTE39_OBJ_003_BEATEN"] = "no me importa\nde perder.",
  ["TEXT_ROUTE39_OBJ_003_SEEN"] = "Que POKéMON\nqueridos.\fVamos mostrar os\nnossos POKéMON\vao mesmo tempo.",
  ["TEXT_ROUTE39_OBJ_008"] = "Sabe como POKéMON\ntêm habilidades\vdiferentes?\fPessoas são assim\ntambém. Cada uma\ftem um potencial\ndiferente.",
  ["TEXT_ROUTE39_OBJ_008_AFTER"] = "Sabe como POKéMON\ntêm habilidades\vdiferentes?\fPessoas são assim\ntambém. Cada uma\ftem um potencial\ndiferente.",
  ["TEXT_ROUTE39_OBJ_008_BEATEN"] = "Ooh, seus POKéMON\ntêm potencial.",
  ["TEXT_ROUTE39_OBJ_008_SEEN"] = "Deixa eu ver do\nque os seus\vPOKéMON são bons.",
  ["TEXT_ROUTE39_OBJ_010"] = "Llegaste a\nmomento adecuado.\fLuchemos.",
  ["TEXT_ROUTE3_OBJ_001"] = "Quando chove, é\ndifícil dar a\vpartida…",
  ["TEXT_ROUTE3_OBJ_001_AFTER"] = "Quando chove, é\ndifícil dar a\vpartida…",
  ["TEXT_ROUTE3_OBJ_001_BEATEN"] = "Está sol, mas eu\nestou encharcado…",
  ["TEXT_ROUTE3_OBJ_001_SEEN"] = "Ah! O tempo\nestá ótimo como\vsempre.",
  ["TEXT_ROUTE3_OBJ_002"] = "Te veías bien.\festaba asustado de\nenfrentarte...",
  ["TEXT_ROUTE3_OBJ_002_AFTER"] = "Te veías bien.\festaba asustado de\nenfrentarte...",
  ["TEXT_ROUTE3_OBJ_002_BEATEN"] = "Eu sabia que\nperderia…",
  ["TEXT_ROUTE3_OBJ_002_SEEN"] = "Mmm… no sé qué\nque hacer…",
  ["TEXT_ROUTE3_OBJ_003"] = "llevo pantalones cortos\ntodo el año.\f├ë mi regla\nde la moda.",
  ["TEXT_ROUTE3_OBJ_003_AFTER"] = "llevo pantalones cortos\ntodo el año.\f├ë mi regla\nde la moda.",
  ["TEXT_ROUTE3_OBJ_003_BEATEN"] = "Arrasado!",
  ["TEXT_ROUTE3_OBJ_003_SEEN"] = "Eu corro como o\nvento!",
  ["TEXT_ROUTE3_OBJ_004"] = "El mayor escupidor\nde fuego de KANTO soy yo.\fPero no es el mejor\nentrenador…",
  ["TEXT_ROUTE3_OBJ_004_AFTER"] = "El mayor escupidor\nde fuego de KANTO soy yo.\fPero no es el mejor\nentrenador…",
  ["TEXT_ROUTE3_OBJ_004_BEATEN"] = "Ai! Que quente!",
  ["TEXT_ROUTE3_OBJ_004_SEEN"] = "Chegue mais perto\ne dê uma olhada!",
  ["TEXT_ROUTE40_BATTLE_TOWER_GATE_OBJ_001"] = "Ir a\n¿TORRE DE BATALLA?\f├ë secreto, pero si\nganas mucho, puedes\nGana regalos especiales.",
  ["TEXT_ROUTE40_OBJ_001"] = "CIDADE DE CIANWOOD\nfica bem longe\vdaqui.",
  ["TEXT_ROUTE40_OBJ_001_AFTER"] = "CIDADE DE CIANWOOD\nfica bem longe\vdaqui.",
  ["TEXT_ROUTE40_OBJ_001_BEATEN"] = "Tá! Chega! Perdi!",
  ["TEXT_ROUTE40_OBJ_001_SEEN"] = "tengo que calentar\nantes de entrar al agua.\fEsto es básico.",
  ["TEXT_ROUTE40_OBJ_002"] = "Nadar exercita\no corpo inteiro.\v├ë saudável.",
  ["TEXT_ROUTE40_OBJ_002_AFTER"] = "Nadar exercita\no corpo inteiro.\v├ë saudável.",
  ["TEXT_ROUTE40_OBJ_002_BEATEN"] = "Ops. Eu perdi…",
  ["TEXT_ROUTE40_OBJ_002_SEEN"] = "un joven como\ndeberías nadar.\fNo utilice SURF en\ntu POKEMON.",
  ["TEXT_ROUTE40_OBJ_003"] = "Yo diría que nado\nmejor que tú.\v├ë ¡eso es!",
  ["TEXT_ROUTE40_OBJ_003_AFTER"] = "Yo diría que nado\nmejor que tú.\v├ë ¡eso es!",
  ["TEXT_ROUTE40_OBJ_003_BEATEN"] = "Perdi essa!",
  ["TEXT_ROUTE40_OBJ_003_SEEN"] = "vas a\n¿MADERA DE CIAN?\f¿Qué tal una pelea?\nrápidamente antes?",
  ["TEXT_ROUTE40_OBJ_004"] = "Enquanto eu boio\nassim, as ondas\vme levam.",
  ["TEXT_ROUTE40_OBJ_004_AFTER"] = "Enquanto eu boio\nassim, as ondas\vme levam.",
  ["TEXT_ROUTE40_OBJ_004_BEATEN"] = "Ooh, estou ficando\ntonto!",
  ["TEXT_ROUTE40_OBJ_004_SEEN"] = "La boya no es\nconmigo.\fme estoy aferrando a\nun POKEMON de mar",
  ["TEXT_ROUTE40_OBJ_008"] = "Incluso no\nMirando desde aquí, CIANWOOD es\nen el otro lado",
  ["TEXT_ROUTE40_OBJ_009"] = "MONICA: Prazer, eu\nsou a MONICA de\fsegunda.",
  ["TEXT_ROUTE40_OBJ_010"] = "Hm! Tem um prédio\ngrande ├á frente!\fO que é aquilo?",
  ["TEXT_ROUTE40_OBJ_011"] = "vine en barco a\nOLIVINE, para ver las vistas y disfrutar\nel medio ambiente.\fComo es un puerto,\nEs muy diferente a una gran ciudad.",
  ["TEXT_ROUTE40_OBJ_012"] = "ha sido a\n¿TORRE DE BATALLA?\fcreo que muchos\nentrenadores fuertes ya se han reunido\nallí.\fPero con tantos\nINSIGNIAS que tienes, no deberías ir\nno está mal.",
  ["TEXT_ROUTE41_OBJ_001"] = "no es relajante\n¿flotar así?\v¿Bien?",
  ["TEXT_ROUTE41_OBJ_001_AFTER"] = "no es relajante\n¿flotar así?\v¿Bien?",
  ["TEXT_ROUTE41_OBJ_001_BEATEN"] = "¡Dios! mi piel\n¡Está arrugado!",
  ["TEXT_ROUTE41_OBJ_001_SEEN"] = "A água está\nquente aqui.\vEstou solto.\fClaro, vou\nte enfrentar!",
  ["TEXT_ROUTE41_OBJ_002"] = "├ë hasta ahora hasta\nMADERA DE CIAN.\fPero volvamos a\nOLIVINE tampoco es fácil.\f¿Qué debo hacer?",
  ["TEXT_ROUTE41_OBJ_002_AFTER"] = "├ë hasta ahora hasta\nMADERA DE CIAN.\fPero volvamos a\nOLIVINE tampoco es fácil.\f¿Qué debo hacer?",
  ["TEXT_ROUTE41_OBJ_002_BEATEN"] = "Ofegante…",
  ["TEXT_ROUTE41_OBJ_002_SEEN"] = "Estou cansado.\nSe eu ganhar, me\vempreste um.",
  ["TEXT_ROUTE41_OBJ_003"] = "Era uma noite\nescura e de\ftempestade… Eu vi\num POKéMON gigante\vvoando das ilhas.\fEle espalhava\npenas das asas\vprateadas dele.",
  ["TEXT_ROUTE41_OBJ_003_AFTER"] = "Era uma noite\nescura e de\ftempestade… Eu vi\num POKéMON gigante\vvoando das ilhas.\fEle espalhava\npenas das asas\vprateadas dele.",
  ["TEXT_ROUTE41_OBJ_003_BEATEN"] = "Qual é o segredo\nda sua força?",
  ["TEXT_ROUTE41_OBJ_003_SEEN"] = "Viu aquelas ilhas\nbloqueadas por\vredemoinhos?\fTem que ter um\nsegredo ali!",
  ["TEXT_ROUTE41_OBJ_005"] = "Um segredo das\nWHIRL ISLANDS…\fLá dentro é\nescuro total!",
  ["TEXT_ROUTE41_OBJ_005_AFTER"] = "Um segredo das\nWHIRL ISLANDS…\fLá dentro é\nescuro total!",
  ["TEXT_ROUTE41_OBJ_005_BEATEN"] = "Oh, tienes\nmuy sin aliento!",
  ["TEXT_ROUTE41_OBJ_005_SEEN"] = "tu buscas el\n¿Secretos de las ISLAS WHIRL?",
  ["TEXT_ROUTE41_OBJ_006"] = "Dizem que tem um\nPOKéMON enorme lá\vno fundo das\vWHIRL ISLANDS.\fO que será que\npode ser?",
  ["TEXT_ROUTE41_OBJ_006_AFTER"] = "Dizem que tem um\nPOKéMON enorme lá\vno fundo das\vWHIRL ISLANDS.\fO que será que\npode ser?",
  ["TEXT_ROUTE41_OBJ_006_BEATEN"] = "├ë assim que se\nfaz?",
  ["TEXT_ROUTE41_OBJ_006_SEEN"] = "Estou indo para\nas WHIRL ISLANDS.\fVou explorar com\nuns amigos.",
  ["TEXT_ROUTE41_OBJ_007"] = "No tenía un\n¿Canción sobre un chico de LAPRAS?",
  ["TEXT_ROUTE41_OBJ_007_AFTER"] = "No tenía un\n¿Canción sobre un chico de LAPRAS?",
  ["TEXT_ROUTE41_OBJ_007_SEEN"] = "Eres tan\nelegante montado en tu POKéMON.",
  ["TEXT_ROUTE41_OBJ_008"] = "Quemaduras de sol\nEs malo para la piel.\fpero no uso\nprotectora.\fno voy a contaminar\nel agua.",
  ["TEXT_ROUTE41_OBJ_008_AFTER"] = "Quemaduras de sol\nEs malo para la piel.\fpero no uso\nprotectora.\fno voy a contaminar\nel agua.",
  ["TEXT_ROUTE41_OBJ_008_SEEN"] = "O tempo está tão\nlindo que eu fico\vabobado!",
  ["TEXT_ROUTE41_OBJ_009"] = "Ouvi rugidos lá\ndo fundo das\vISLANDS.",
  ["TEXT_ROUTE41_OBJ_009_AFTER"] = "Ouvi rugidos lá\ndo fundo das\vISLANDS.",
  ["TEXT_ROUTE41_OBJ_009_BEATEN"] = "¡Oh! tienes mas\nenergía que yo.",
  ["TEXT_ROUTE41_OBJ_009_SEEN"] = "Si necesitas\ndescansa, simplemente flota.\frecuperas el\nRespiro y puedo seguir adelante\ncon fuerza.",
  ["TEXT_ROUTE41_OBJ_010"] = "Os cardumes de\nSTARYU acendem\vao mesmo tempo.\f├ë tão bonito que\nchega a assustar.",
  ["TEXT_ROUTE41_OBJ_010_AFTER"] = "Os cardumes de\nSTARYU acendem\vao mesmo tempo.\f├ë tão bonito que\nchega a assustar.",
  ["TEXT_ROUTE41_OBJ_010_BEATEN"] = "Ah, céus…",
  ["TEXT_ROUTE41_OBJ_010_SEEN"] = "├Ç noite, STARYU\nse juntam perto\vda superfície.",
  ["TEXT_ROUTE42_OBJ_001_AFTER"] = "quiero girar el\nEntrenador CAMPEÓN con POKéMON\nque pesqué.\f├ë la mejor parte\n¡a pescar!",
  ["TEXT_ROUTE42_OBJ_001_BEATEN"] = "¿Qué? Eso no es\neso es correcto.",
  ["TEXT_ROUTE42_OBJ_001_SEEN"] = "Vou mostrar o\npoder do POKéMON\vque eu peguei!",
  ["TEXT_ROUTE42_OBJ_002"] = "perder parece\npoco si nos fijamos en\ncielo enorme!",
  ["TEXT_ROUTE42_OBJ_002_AFTER"] = "perder parece\npoco si nos fijamos en\ncielo enorme!",
  ["TEXT_ROUTE42_OBJ_002_BEATEN"] = "Rahahá!",
  ["TEXT_ROUTE42_OBJ_002_SEEN"] = "Ah, que bom estar\nao ar livre!\vMe sinto livre!",
  ["TEXT_ROUTE42_OBJ_003"] = "estas haciendo\n¿Una POKéDEX?\fVaya, debes saberlo\n¡Algunos POKéMON muy raros!\f¿Puedo ver?\n¿Por favor?",
  ["TEXT_ROUTE42_OBJ_003_AFTER"] = "estas haciendo\n¿Una POKéDEX?\fVaya, debes saberlo\n¡Algunos POKéMON muy raros!\f¿Puedo ver?\n¿Por favor?",
  ["TEXT_ROUTE42_OBJ_003_BEATEN"] = "Devia ter usado\na MOON STONE…",
  ["TEXT_ROUTE42_OBJ_003_SEEN"] = "¡EY!\feste es mi lugar\nsecreto! ¡Piérdete, extraño!",
  ["TEXT_ROUTE43_GATE_OBJ_001"] = "fui expulsado de\nmi publicación para los de negro.\fse fueron\nesto al revés.\feso me deja\nincómodo.\v¿Puedes tomarlo?",
  ["TEXT_ROUTE43_GATE_OBJ_002"] = "Hihihi. Estamos\nenchendo o bolso.\fTodo mundo quer\nver o que rola\fno LAKE OF\nRAGE.",
  ["TEXT_ROUTE43_GATE_OBJ_003"] = "Hihihi. Estamos\nenchendo o bolso.\fTodo mundo quer\nver o que rola\fno LAKE OF\nRAGE.",
  ["TEXT_ROUTE43_MAHOGANY_GATE_OBJ_001"] = "Sólo aquellos que van a\nLAGO DE FURIA pasó por\nÚltimamente.",
  ["TEXT_ROUTE43_OBJ_001"] = "¿Cómo pudiste\nhacerme esto?",
  ["TEXT_ROUTE43_OBJ_001_AFTER"] = "Do que mais eu\ngosto além de\vPOKéMON?\fA MARY do rádio.\nDeve ser fofa!",
  ["TEXT_ROUTE43_OBJ_001_BEATEN"] = "¿Cómo pudiste\nhacerme esto?",
  ["TEXT_ROUTE43_OBJ_001_SEEN"] = "¡Me encanta POKÉMON!\fPor eso\nEmpecé y así lo haré\n¡sigue coleccionando!",
  ["TEXT_ROUTE43_OBJ_002_AFTER"] = "yo seria feliz\nsimplemente tener un POKéMON raro.",
  ["TEXT_ROUTE43_OBJ_002_BEATEN"] = "Ay mi pobre\n¡Querido POKEMON!",
  ["TEXT_ROUTE43_OBJ_002_SEEN"] = "¡Ey! ¿Tienes alguna?\n¿POKÉMON raros?",
  ["TEXT_ROUTE43_OBJ_003"] = "Un pokémon que\nRecibí un artículo.\fcreo que es\nAGUA MÍSTICA.\fNo lo necesito,\n¿Quieres quedarte?",
  ["TEXT_ROUTE43_OBJ_003_AFTER"] = "No hay problema\na la gente le gustan los chicos\ndiferente.\fPOKéMON no es sólo\ntener los más poderosos.",
  ["TEXT_ROUTE43_OBJ_003_BEATEN"] = "Mi NIDOKING fue\nmuy bien!",
  ["TEXT_ROUTE43_OBJ_003_SEEN"] = "¿Crees?\nen esto?\fun chico llamado\n ¡{RIVAL} se burló de mi POKéMON!\f¡Droga! mi pokemon\n¡Es genial!",
  ["TEXT_ROUTE43_OBJ_004"] = "Un pokémon que\nRecibí un artículo.\fcreo que es\nAGUA MÍSTICA.\fNo lo necesito,\n¿Quieres quedarte?",
  ["TEXT_ROUTE43_OBJ_004_AFTER"] = "PELOTA DE SEÑUELO\nKURT es el mejor atrapando POKéMON\nenganchado.\f├ë mucho más\nmás eficaz que una ULTRA BALL.",
  ["TEXT_ROUTE43_OBJ_004_BEATEN"] = "Perdi, mas me\nsinto melhor.",
  ["TEXT_ROUTE43_OBJ_004_SEEN"] = "Estou numa fase\fDeve ser o\nequipamento.\fVamos lutar para\nmudar o clima!",
  ["TEXT_ROUTE43_OBJ_005_BEATEN"] = "Brinquei demais!",
  ["TEXT_ROUTE43_OBJ_005_SEEN"] = "tu también lo harás\nal LAGO DE LA IRA?\fjuguemos uno\npoquito!",
  ["TEXT_ROUTE43_OBJ_006"] = "O que está\nhavendo no LAKE?\fA gente ia\nacampar lá.",
  ["TEXT_ROUTE43_OBJ_006_AFTER"] = "O que está\nhavendo no LAKE?\fA gente ia\nacampar lá.",
  ["TEXT_ROUTE43_OBJ_006_BEATEN"] = "No existe tal cosa como perder\nnada divertido...",
  ["TEXT_ROUTE43_OBJ_006_SEEN"] = "se puede hacer\n¡tanto con mi POKéMON!",
  ["TEXT_ROUTE44_OBJ_001_AFTER"] = "Aquele POLIWAG\nque escapou…\vEra enorme.\fJuro que tinha uns\n5 metros!",
  ["TEXT_ROUTE44_OBJ_001_BEATEN"] = "Deixa pra\nlá.",
  ["TEXT_ROUTE44_OBJ_001_SEEN"] = "¡Oh! tu me hiciste\n¡pierde un POLIWAG!\f¿Qué harás?\nhacer al respecto?",
  ["TEXT_ROUTE44_OBJ_002"] = "Hay 100 victorias\ny 101 derrotas.\fno pelearé\nnuevo tan pronto.",
  ["TEXT_ROUTE44_OBJ_002_AFTER"] = "Hay 100 victorias\ny 101 derrotas.\fno pelearé\nnuevo tan pronto.",
  ["TEXT_ROUTE44_OBJ_002_BEATEN"] = "Mmmmm...\nNo está bien.",
  ["TEXT_ROUTE44_OBJ_002_SEEN"] = "pesco hasta que no lo hago\naguanta más.\fY lucho hasta\ncaer también.\f├ë esto es mío\nrelación con mi POKéMON.",
  ["TEXT_ROUTE44_OBJ_003"] = "├ë importante ter\nconvicção do seu\vlado.",
  ["TEXT_ROUTE44_OBJ_003_AFTER"] = "├ë importante ter\nconvicção do seu\vlado.",
  ["TEXT_ROUTE44_OBJ_003_BEATEN"] = "Arrgh… Que\nderrota chocante…",
  ["TEXT_ROUTE44_OBJ_003_SEEN"] = "Eu vou ganhar,\ncom certeza!",
  ["TEXT_ROUTE44_OBJ_004"] = "Si un POKéMON tiene\ncolores diferentes a lo normal,\nvale más.\f¿Qué? Eso no es\n¿es verdad?",
  ["TEXT_ROUTE44_OBJ_004_AFTER"] = "Si un POKéMON tiene\ncolores diferentes a lo normal,\nvale más.\f¿Qué? Eso no es\n¿es verdad?",
  ["TEXT_ROUTE44_OBJ_004_BEATEN"] = "Oooh, seus POKéMON\nsão atraentes.",
  ["TEXT_ROUTE44_OBJ_004_SEEN"] = "Faço qualquer\ncoisa para p├┤r a\vmão em raros!",
  ["TEXT_ROUTE44_OBJ_005_AFTER"] = "ARTICUNO, ZAPDOS\ne MOLTRES são\fos três POKéMON\npássaro lendários\fMas ouvi que tem\noutros pássaros\vlendários também.",
  ["TEXT_ROUTE44_OBJ_005_BEATEN"] = "¡Uf! eres bueno\nlo mismo.",
  ["TEXT_ROUTE44_OBJ_005_SEEN"] = "¿Conoces el\n¿Pájaro legendario de POKEMON?",
  ["TEXT_ROUTE44_OBJ_006"] = "Guau. tienes\nmuchas INSIGNIAS.\fNo es de extrañar que\nEs tan fuerte.\fmorty\ndel GIMNASIO ECRUTEAK todavía\n¿Estás entrenando?\fÉl me dejó boquiabierto\nfeo.",
  ["TEXT_ROUTE44_OBJ_006_AFTER"] = "Guau. tienes\nmuchas INSIGNIAS.\fNo es de extrañar que\nEs tan fuerte.\fmorty\ndel GIMNASIO ECRUTEAK todavía\n¿Estás entrenando?\fÉl me dejó boquiabierto\nfeo.",
  ["TEXT_ROUTE44_OBJ_006_BEATEN"] = "¡Tch! fue la derrota\ntotal para mi.",
  ["TEXT_ROUTE44_OBJ_006_SEEN"] = "Puedes ver eso\neres un buen entrenador.\fsoy bueno en\nPOKéMON y veo que tú también lo eres.",
  ["TEXT_ROUTE44_OBJ_007"] = "todos mejoramos\npasando por muchas batallas.\fluché mucho\npara convertirme en lo que soy hoy: un\nélite.",
  ["TEXT_ROUTE44_OBJ_007_AFTER"] = "todos mejoramos\npasando por muchas batallas.\fluché mucho\npara convertirme en lo que soy hoy: un\nélite.",
  ["TEXT_ROUTE44_OBJ_007_BEATEN"] = "¡No! No asi\nrealmente lo hace.",
  ["TEXT_ROUTE44_OBJ_007_SEEN"] = "Te ves fuerte Buenos entrenadores\nbuscan rivales fuertes para sí mismos.",
  ["TEXT_ROUTE45_OBJ_001"] = "Vou voltar para o\nICE PATH de\fBLACKTHORN e\ntreinar mais.",
  ["TEXT_ROUTE45_OBJ_001_AFTER"] = "Vou voltar para o\nICE PATH de\fBLACKTHORN e\ntreinar mais.",
  ["TEXT_ROUTE45_OBJ_001_BEATEN"] = "Ah, eu perdi!",
  ["TEXT_ROUTE45_OBJ_001_SEEN"] = "Estar listo\npor todo!\fVoy a ver si tu\n¡POKéMON estaban bien creados!",
  ["TEXT_ROUTE45_OBJ_002"] = "Guau, como yo\n¡Me encanta PS UP! ¡Mmm!\fsigo bebiendo\nde mis POKéMON!\f¡No puedo controlarme!",
  ["TEXT_ROUTE45_OBJ_002_AFTER"] = "Guau, como yo\n¡Me encanta PS UP! ¡Mmm!\fsigo bebiendo\nde mis POKéMON!\f¡No puedo controlarme!",
  ["TEXT_ROUTE45_OBJ_002_BEATEN"] = "Mis POKéMON no\n¡Tenían agallas!",
  ["TEXT_ROUTE45_OBJ_002_SEEN"] = "¡Ey! tienes\ngarra! ¿Pero lo sabes?\fCuando el tema es\nPura garra, ¡yo soy el chico!",
  ["TEXT_ROUTE45_OBJ_003_AFTER"] = "no soy bueno en\npiensa, ¿sabes?\fAsí que voy a\nrealmente fuerte!",
  ["TEXT_ROUTE45_OBJ_003_BEATEN"] = "Uahahah! Eu sou o\ngrande perdedor!",
  ["TEXT_ROUTE45_OBJ_003_SEEN"] = "Mis POKéMON son\npura fuerza!",
  ["TEXT_ROUTE45_OBJ_004"] = "Lo mejor que\nya me paso fue descubrir el\nPOKÉMON.",
  ["TEXT_ROUTE45_OBJ_004_AFTER"] = "Lo mejor que\nya me paso fue descubrir el\nPOKÉMON.",
  ["TEXT_ROUTE45_OBJ_004_BEATEN"] = "Derrotas…\n¡Ellos también están ahí!",
  ["TEXT_ROUTE45_OBJ_004_SEEN"] = "¿Por qué subo?\nmontañas?\fporque son\nallí.\f¿Por qué entreno?\n¿POKÉMON?\fporque son\nahí!",
  ["TEXT_ROUTE45_OBJ_005"] = "Esto exige medidas\nextremo.\fvoy a\nlas montañas entrenan en soledad.",
  ["TEXT_ROUTE45_OBJ_005_AFTER"] = "Esto exige medidas\nextremo.\fvoy a\nlas montañas entrenan en soledad.",
  ["TEXT_ROUTE45_OBJ_005_BEATEN"] = "Aaaargh!",
  ["TEXT_ROUTE45_OBJ_005_SEEN"] = "yo estaba\nEntrenando solo aquí.\fver el fruto de\nmi trabajo!",
  ["TEXT_ROUTE45_OBJ_006"] = "Te veo crear\nTu POKéMON con cariño.\fEl vínculo que tú\ncrear le ahorrará problemas.",
  ["TEXT_ROUTE45_OBJ_006_AFTER"] = "Te veo crear\nTu POKéMON con cariño.\fEl vínculo que tú\ncrear le ahorrará problemas.",
  ["TEXT_ROUTE45_OBJ_006_BEATEN"] = "tu ganaste mi\nrespeto.",
  ["TEXT_ROUTE45_OBJ_006_SEEN"] = "¿Qué piensas?\n¿Sobre la creación de POKéMON?",
  ["TEXT_ROUTE45_OBJ_007"] = "no estoy a favor\nde golpes demasiado fuertes.\fquiero ganar pero\nTampoco quiero lastimar a POKéMON.",
  ["TEXT_ROUTE45_OBJ_007_AFTER"] = "no estoy a favor\nde golpes demasiado fuertes.\fquiero ganar pero\nTampoco quiero lastimar a POKéMON.",
  ["TEXT_ROUTE45_OBJ_007_BEATEN"] = "Tá bom. Perdi.",
  ["TEXT_ROUTE45_OBJ_007_SEEN"] = "Qual é a sua\nestratégia?\f├ë tolice usar\ngolpes fortes\vsem critério.",
  ["TEXT_ROUTE45_OBJ_013"] = "soy muy,\nmuy fuerte!",
  ["TEXT_ROUTE46_OBJ_001"] = "Acabou. Tudo bem.\nNós HIKERS somos\vassim mesmo.",
  ["TEXT_ROUTE46_OBJ_001_AFTER"] = "Acabou. Tudo bem.\nNós HIKERS somos\vassim mesmo.",
  ["TEXT_ROUTE46_OBJ_001_BEATEN"] = "¡Lástima! tu yo\nmostró fuerza!",
  ["TEXT_ROUTE46_OBJ_001_SEEN"] = "Beleza! Vou\nmostrar o poder\vdos POKéMON da\vmontanha!",
  ["TEXT_ROUTE46_OBJ_002"] = "di lo mejor de mi\ny no fue suficiente.\fNo hay excusa, yo\nAdmito que perdí.",
  ["TEXT_ROUTE46_OBJ_002_AFTER"] = "di lo mejor de mi\ny no fue suficiente.\fNo hay excusa, yo\nAdmito que perdí.",
  ["TEXT_ROUTE46_OBJ_002_SEEN"] = "yo también creo\n¡POKÉMON!\fquiero luchar\nconmigo?",
  ["TEXT_ROUTE46_OBJ_003_AFTER"] = "he estado en muchos\nGIMNASIOS, pero el de GOLDENROD es el\nmi favorito.\fel esta lleno de\nhermosas flores!",
  ["TEXT_ROUTE46_OBJ_003_BEATEN"] = "Ah, droga!",
  ["TEXT_ROUTE46_OBJ_003_SEEN"] = "Eu também crio\nPOKéMON!\fVamos lutar!",
  ["TEXT_ROUTE46_OBJ_004"] = ")Beleza! Vou\nmostrar o poder\vdos POKéMON da\vmontanha!",
  ["TEXT_ROUTE46_OBJ_005"] = ")Beleza! Vou\nmostrar o poder\vdos POKéMON da\vmontanha!",
  ["TEXT_ROUTE4_BG_001"] = "MT.MOON SQUARE ├ë simplemente sube al\nescaleras.",
  ["TEXT_ROUTE4_OBJ_001"] = "Se tem um POKéMON\nespecífico que\vquer treinar,\fponha ele na\nfrente e troque\vna hora.\f├ë assim que\nse faz.",
  ["TEXT_ROUTE4_OBJ_001_AFTER"] = "Se tem um POKéMON\nespecífico que\vquer treinar,\fponha ele na\nfrente e troque\vna hora.\f├ë assim que\nse faz.",
  ["TEXT_ROUTE4_OBJ_001_BEATEN"] = "¿Perdí? esto es\nnuevo también...",
  ["TEXT_ROUTE4_OBJ_001_SEEN"] = "estoy creando mi\nPOKÉMON. ¿Quieres luchar contra mí?",
  ["TEXT_ROUTE4_OBJ_002"] = "Escuché que CLEFAIRY\naparecer en MT.MOON.\fPero ¿dónde estará?\n¿lo son?",
  ["TEXT_ROUTE4_OBJ_002_AFTER"] = "Escuché que CLEFAIRY\naparecer en MT.MOON.\fPero ¿dónde estará?\n¿lo son?",
  ["TEXT_ROUTE4_OBJ_002_BEATEN"] = "Ah, eres fuerte\ndemasiado.",
  ["TEXT_ROUTE4_OBJ_002_SEEN"] = "Tenho a impressão\nde que vou ganhar\fVamos ver se eu\nestou certo!",
  ["TEXT_ROUTE4_OBJ_003"] = "……Vou treinar\nmais um pouco…",
  ["TEXT_ROUTE4_OBJ_003_AFTER"] = "……Vou treinar\nmais um pouco…",
  ["TEXT_ROUTE5_BG_002"] = "{RIVAL}X{PC}A estrada está\nfechada até que\fo problema na\nUSINA se resolva.",
  ["TEXT_ROUTE5_CLEANSE_TAG_HOUSE_BG_001"] = ".Iiiiaaah!\fsiento un\nSombra siniestra que se cierne sobre ti.\fLleva esto a\nmantenla alejada!",
  ["TEXT_ROUTE5_CLEANSE_TAG_HOUSE_BG_002"] = ".Iiiiaaah!\fsiento un\nSombra siniestra que se cierne sobre ti.\fLleva esto a\nmantenla alejada!",
  ["TEXT_ROUTE5_CLEANSE_TAG_HOUSE_OBJ_001"] = "¡iiiaaa!\fsiento un\nSombra siniestra que se cierne sobre ti.\fLleva esto a\nmantenla alejada!",
  ["TEXT_ROUTE5_CLEANSE_TAG_HOUSE_OBJ_002"] = "a mi abuela le gusta\naleja lo que ella cree que es\nmalos espíritus.\fLo siento si ella\nte asusté.",
  ["TEXT_ROUTE5_OBJ_001"] = "\f{BYTE:22}{PC}{RIVAL}{BYTE:66}{PC}{RIVAL}X{PC}A estrada está\nfechada até o\fproblema na POWER\nPLANT ser\vresolvido.",
  ["TEXT_ROUTE5_SAFFRON_GATE_OBJ_001"] = "{BYTE:BC} … Eres de JOHTO,\n¿no es así?\f¿En qué pensaste?\n¿KANTO? ├ë genial, ¿no estás de acuerdo?",
  ["TEXT_ROUTE5_UNDERGROUND_PATH_ENTRANCE_OBJ_001"] = "Muchas ciudades en\nJOHTO son viejos me encantaría\nvisita!",
  ["TEXT_ROUTE6_BG_001"] = "{RIVAL}){TARGET}A estrada está\nfechada até o\fproblema na POWER\nPLANT ser\vresolvido.",
  ["TEXT_ROUTE6_OBJ_001"] = "A estrada está\nfechada até que\fo problema na\nUSINA se resolva.",
  ["TEXT_ROUTE6_OBJ_002"] = "mira que lindo\n¡Mi PHANPY es!\fno es lindo\n¿Suficiente para derretir tu corazón?",
  ["TEXT_ROUTE6_OBJ_002_AFTER"] = "mira que lindo\n¡Mi PHANPY es!\fno es lindo\n¿Suficiente para derretir tu corazón?",
  ["TEXT_ROUTE6_OBJ_002_BEATEN"] = "¡Mi FANPY!",
  ["TEXT_ROUTE6_OBJ_002_SEEN"] = "Mi PHANPY es el\nmás lindo del mundo.",
  ["TEXT_ROUTE6_OBJ_003"] = "mira que lindo\nmi TEDDIURSA es!\fno es lindo\n¿Suficiente para derretir tu corazón?",
  ["TEXT_ROUTE6_OBJ_003_AFTER"] = "mira que lindo\nmi TEDDIURSA es!\fno es lindo\n¿Suficiente para derretir tu corazón?",
  ["TEXT_ROUTE6_OBJ_003_BEATEN"] = "¡Mi TEDDIURSA!",
  ["TEXT_ROUTE6_OBJ_003_SEEN"] = "Mi TEDDIURSA es\nel mas lindo del mundo.",
  ["TEXT_ROUTE6_SAFFRON_GATE_OBJ_001"] = "Bienvenido ├á\n¡SAFFRON CITY, hogar del TREN IMÁN!\f…├ë que diría\nnormalmente, pero el TREN MAGNÉTICO\nno está funcionando.\fno lo es\nrecibiendo energía porque hay algo\nmal con el poder\nPLANTA.",
  ["TEXT_ROUTE7_BG_001"] = "{RIVAL}I{RIVAL}{RIVAL}……POKéQue panfleto é\neste?\f… Treinadores mal-\neducados vêm\ffazendo batalhas\nno UNDERGROUND\vPATH.\fPor causa das\nreclamaç├Áes dos\fmoradores, o\nUNDERGROUND PATH\ffoi fechado por\ntempo indeter-\vminado.\fCELADON POLICE",
  ["TEXT_ROUTE7_BG_002"] = "{RIVAL} ……POKé¿Qué advertencia es esta?\f…los entrenadores\ngente maleducada ha luchado en\nCAMINO SUBTERRÁNEO.\fdebido a la\nDebido a las quejas de los vecinos, el CAMINO SUBTERRÁNEO fue cerrado indefinidamente.\fPOLICÍA DE CELADÓN",
  ["TEXT_ROUTE7_SAFFRON_GATE_OBJ_001"] = "¿Sabías acerca de\n¿accidente en la CENTRAL ELÉCTRICA?\fEstá al este,\ncerca de LA CIUDAD LAVANDA.",
  ["TEXT_ROUTE8_OBJ_001"] = "A KANTO POKéMON\nFEDERATION nunca\vvai cair!",
  ["TEXT_ROUTE8_OBJ_001_AFTER"] = "A KANTO POKéMON\nFEDERATION nunca\vvai cair!",
  ["TEXT_ROUTE8_OBJ_001_BEATEN"] = "D-desculpa!",
  ["TEXT_ROUTE8_OBJ_001_SEEN"] = "somos el grupo de\nentrenadores de la FEDERACIÓN KANTO POKéMON.\fpasemos por\nsobre ti!",
  ["TEXT_ROUTE8_OBJ_002"] = "Arrasado por um\nmoleque de JOHTO…",
  ["TEXT_ROUTE8_OBJ_002_AFTER"] = "Arrasado por um\nmoleque de JOHTO…",
  ["TEXT_ROUTE8_OBJ_002_BEATEN"] = "M-me perdoa!",
  ["TEXT_ROUTE8_OBJ_002_SEEN"] = "La policía cerró el\n¡nuestro CAMINO SUBTERRÁNEO! eso me da\nmuy enojado!",
  ["TEXT_ROUTE8_OBJ_003"] = "intentemos no\nmolestar a nadie de ahora en adelante",
  ["TEXT_ROUTE8_OBJ_003_AFTER"] = "intentemos no\nmolestar a nadie de ahora en adelante",
  ["TEXT_ROUTE8_OBJ_003_BEATEN"] = "Nossa! Desculpa!",
  ["TEXT_ROUTE8_OBJ_003_SEEN"] = "somos kanto\n¡FEDERACIÓN POKEMON! ├ë ¡Eso es todo, hombre!",
  ["TEXT_ROUTE8_OBJ_004"] = "A força dos ímãs\né impressionante!",
  ["TEXT_ROUTE8_OBJ_004_AFTER"] = "A força dos ímãs\né impressionante!",
  ["TEXT_ROUTE8_OBJ_004_BEATEN"] = "solo quiero ver el\nTREN IMÁN…",
  ["TEXT_ROUTE8_OBJ_004_SEEN"] = "Como o MAGNET\nTRAIN funciona?",
  ["TEXT_ROUTE8_OBJ_005"] = "As GYM BADGES dão\nvantagem nas\vbatalhas.",
  ["TEXT_ROUTE8_OBJ_005_AFTER"] = "As GYM BADGES dão\nvantagem nas\vbatalhas.",
  ["TEXT_ROUTE8_OBJ_005_BEATEN"] = "Como pensé…\n¡Eres fuerte!",
  ["TEXT_ROUTE8_OBJ_005_SEEN"] = "Mmmm... tienes\nmuchas INSIGNIAS DE GIMNASIO.",
  ["TEXT_ROUTE9_BG_001"] = "{RIVAL}c{BYTE:72}.{BYTE:3F}Vim explorar o\nROCK TUNNEL.",
  ["TEXT_ROUTE9_OBJ_001"] = "Mi POKéMON\nse lastimó antes de unirse a ROCK\nTÚNEL.\f├ë mejor toma\nllévalos al CENTRO POKéMON ahora.",
  ["TEXT_ROUTE9_OBJ_001_AFTER"] = "Mi POKéMON\nse lastimó antes de unirse a ROCK\nTÚNEL.\f├ë mejor toma\nllévalos al CENTRO POKéMON ahora.",
  ["TEXT_ROUTE9_OBJ_001_BEATEN"] = "Opa! Perigo, cara",
  ["TEXT_ROUTE9_OBJ_001_SEEN"] = "Vim explorar o\nROCK TUNNEL.",
  ["TEXT_ROUTE9_OBJ_002"] = "A gente assa um\nmonte de doces\fe divide com todo\nmundo. ├ë delícia!",
  ["TEXT_ROUTE9_OBJ_002_AFTER"] = "A gente assa um\nmonte de doces\fe divide com todo\nmundo. ├ë delícia!",
  ["TEXT_ROUTE9_OBJ_002_BEATEN"] = "Aaah!",
  ["TEXT_ROUTE9_OBJ_002_SEEN"] = "¿Alguna vez has estado en uno?\n¿picnic?\f├ë muy\ndivertido!",
  ["TEXT_ROUTE9_OBJ_003"] = "Lo siento. tu no\ntiró basura. Fue mi error.",
  ["TEXT_ROUTE9_OBJ_003_AFTER"] = "Lo siento. tu no\ntiró basura. Fue mi error.",
  ["TEXT_ROUTE9_OBJ_003_BEATEN"] = "yo solo estaba\nadvertencia...",
  ["TEXT_ROUTE9_OBJ_003_SEEN"] = "¡Eh, tú!\n¡No tires basura!",
  ["TEXT_ROUTE9_OBJ_004"] = "Ahorra energía\nes importante, pero el medio ambiente es\naún más.",
  ["TEXT_ROUTE9_OBJ_004_AFTER"] = "Ahorra energía\nes importante, pero el medio ambiente es\naún más.",
  ["TEXT_ROUTE9_OBJ_004_SEEN"] = "La gente no\nDeberían dejar basura por ahí.",
  ["TEXT_ROUTE9_OBJ_005"] = "La batalla es una\ncuestión de enfoque.",
  ["TEXT_ROUTE9_OBJ_005_AFTER"] = "La batalla es una\ncuestión de enfoque.",
  ["TEXT_ROUTE9_OBJ_005_BEATEN"] = "Eu estava ocupada\ncantando…",
  ["TEXT_ROUTE9_OBJ_005_SEEN"] = "Ela vem descendo a\nMT.SILVER quando\vela vier…\fA MT.SILVER fica\nem JOHTO, né?",
  ["TEXT_ROUTE9_OBJ_006"] = "A POWER PLANT fica\ndo outro lado de\vum riacho.",
  ["TEXT_ROUTE9_OBJ_006_AFTER"] = "A POWER PLANT fica\ndo outro lado de\vum riacho.",
  ["TEXT_ROUTE9_OBJ_006_BEATEN"] = "Ah, droga!\nPerdi essa…",
  ["TEXT_ROUTE9_OBJ_006_SEEN"] = "Vou te contar um\nsegredo.\fMas primeiro a\ngente luta!",
  ["TEXT_RUINS_OF_ALPH_AERODACTYL_CHAMBER_BG_001"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_AERODACTYL_CHAMBER_BG_002"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_AERODACTYL_CHAMBER_BG_004"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_AERODACTYL_CHAMBER_BG_005"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_AERODACTYL_CHAMBER_BG_006"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_HO_OH_CHAMBER_BG_001"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_HO_OH_CHAMBER_BG_002"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_HO_OH_CHAMBER_BG_004"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_HO_OH_CHAMBER_BG_005"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_HO_OH_CHAMBER_BG_006"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_INNER_CHAMBER_OBJ_001"] = "Esta habitación es\ngrande, pero no hay nada aquí.",
  ["TEXT_RUINS_OF_ALPH_INNER_CHAMBER_OBJ_002"] = "Este lugar tem\numa qualidade\vmística.\fParece até\netéreo.",
  ["TEXT_RUINS_OF_ALPH_INNER_CHAMBER_OBJ_003"] = "Prédios antigos\nsão túmulos de\vreis.\fComo as\npir├ómides.",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_BG_001"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_BG_002"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_BG_004"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_BG_005"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_BG_006"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_OBJ_001"] = "Bem-vindo a esta\nc├ómara.\fHá painéis\ndeslizantes que\fretratam um\nPOKéMON antigo.\fDeslize os\npainéis para\vformar a figura.\f├Ç direita, a\ndescrição do\vPOKéMON.",
  ["TEXT_RUINS_OF_ALPH_KABUTO_CHAMBER_OBJ_002"] = "Aquele tremor foi\nbem assustador!\fMas estou mais\npreocupado com\vessa parede aqui…",
  ["TEXT_RUINS_OF_ALPH_KABUTO_ITEM_ROOM_BG_001"] = "{RIVAL}n{TARGET}├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_RUINS_OF_ALPH_KABUTO_ITEM_ROOM_BG_002"] = "{RIVAL}n{TARGET}├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_RUINS_OF_ALPH_OMANYTE_CHAMBER_BG_001"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_OMANYTE_CHAMBER_BG_002"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_OMANYTE_CHAMBER_BG_004"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_OMANYTE_CHAMBER_BG_005"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_OMANYTE_CHAMBER_BG_006"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_001"] = "Gosto de pensar\naqui.",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_001_AFTER"] = "Gosto de pensar\naqui.",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_001_SEEN"] = "Hmmm… Este é um\nlugar estranho.",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_002"] = "¿Mmm? Este es un\nPOKéDEX, ¿verdad?\v¿Puedo ver?\fHay muchos tipos de\nPOKÉMON.\f¿Mmm? ¿Qué es esto?\f¿Qué es Pokémon?\nesto?\fparece escribir\nextraño en las paredes\nMALO.\fSi estos dibujos\nRealmente son POKéMON, debe haber muchos más.\f¡Lo sé! voy a actualizar\ntu POKéDEX.\vSígueme.",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_003"] = "mientras\nexploramos los MALOS, nos dimos cuenta\nuna extraña presencia.\ftodos nos quedamos con\nAsustado y salimos corriendo.\ftu también deberías\nten cuidado.",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_004"] = "Hay muchos tipos\nde UNOWN, así que los usamos nosotros mismos\nnuestros códigos secretos.",
  ["TEXT_RUINS_OF_ALPH_OUTSIDE_OBJ_005"] = "Gosto de pensar\naqui.",
  ["TEXT_RUINS_OF_ALPH_RESEARCH_CENTER_BG_002"] = "RUÍNAS DE ALPH\fExploração\nAno 10",
  ["TEXT_RUINS_OF_ALPH_RESEARCH_CENTER_BG_003"] = "todavía parece\nno funciona.",
  ["TEXT_RUINS_OF_ALPH_RESEARCH_CENTER_OBJ_001"] = "Los MALOS tienen sobre\n1500 años.\fPero no se sabe\npor qué fueron hechos, ni por qué\nquien.",
  ["TEXT_RUINS_OF_ALPH_RESEARCH_CENTER_OBJ_002"] = "Há padr├Áes\ndesenhados nas\fparedes das\nRUÍNAS.\fDevem ser a chave\npara desvendar\vo mistério\vdas RUÍNAS.",
  ["TEXT_RUINS_OF_ALPH_RESEARCH_CENTER_OBJ_003"] = "El UNOWN que\nque captures quedarán todos registrados. Comprueba cuántos\nexisten tipos.",
  ["TEXT_S15_4122"] = "¡Hola! ¡Soy BLANCA!\fA todo el mundo le\nencantan los POKéMON,\f¡así que yo también\nentré!\f¡Los POKéMON son\nmonísimos!\f¿Quieres luchar?\n¡Te aviso, soy buena!",
  ["TEXT_S15_41A5"] = "Snif…\f…¡Buaaaaa!\n¡Eres malo!\f¡No deberías tomártelo\ntan en serio! ¡Tú,\vniño!",
  ["TEXT_S15_41F4"] = "¡Buaaaaa!\f¡Buaaaaa!\f…Snif, hip…\n…¡Malvado!",
  ["TEXT_S15_4222"] = "…Snif…\f¿Qué? ¿Qué quieres?\n¿Una MEDALLA?\fAh, sí. Se me había\nolvidado. Toma la\vMEDALLA PLANICIE.",
  ["TEXT_S15_4273"] = "{PLAYER} recibió\nla MEDALLA PLANICIE.",
  ["TEXT_S15_428B"] = "La MEDALLA PLANICIE\npermite a tu POKéMON\fusar FUERZA fuera del\ncombate.\fTambién aumenta la\nVELOCIDAD de tu\vPOKéMON.\f¡Ah, y quédate\ntambién con esto!",
  ["TEXT_S15_4302"] = "¡Es ATRACCIÓN!\nUsa todo el\fencanto de un\nPOKéMON.\f¿No es perfecto\npara una monada\vcomo yo?",
  ["TEXT_S15_4360"] = "¡He llorado mucho!\n¡Qué alivio!\f¡Vuelve a visitarme\nde nuevo! ¡Adiós!",
  ["TEXT_S15_43F6"] = "¿Crees que mis\nPOKéMON me consideran\vmonísima?",
  ["TEXT_S15_4470"] = "Intento vencer a\nBLANCA, pero… Es\vdeprimente.\f¡Estoy bien! Si\npierdo, ¡lo intentaré\fde nuevo la próxima\nvez!",
  ["TEXT_S15_44D4"] = "Oh, no. Has hecho\nllorar a BLANCA.\fNo pasa nada. Pronto\nse le pasará. Siempre\fllora cuando\npierde.",
  ["TEXT_S15_458F"] = "¡Guau, debes de ser\nmuy bueno para\nvencerme!\v¡Sigue así!",
  ["TEXT_S15_460B"] = "Enseñé a MEOWTH\nmovimientos para\vlidiar con todo tipo…",
  ["TEXT_S15_463A"] = "¡Hola! ¡Futuro\nCAMPEÓN!\fEste GIMNASIO es de\nentrenadores de\vPOKéMON normales.\fTe recomiendo usar\nPOKéMON de tipo\vlucha.",
  ["TEXT_S15_46A7"] = "¿Has ganado? ¡Genial!\fEstaba ocupado\nmirando a las chicas.",
  ["TEXT_S15_4787"] = "…Suspiro… Me\nhe mudado, pero no\fvendo mis\nBICICLETAS. ¿Por qué?\fAh, ya sé. Podrías\nmontar y\vanunciarme.",
  ["TEXT_S15_47F8"] = "¿En serio? ¡Genial!\fDime tu nombre\ny teléfono y\fte prestaré\nuna BICICLETA.",
  ["TEXT_S15_4848"] = "{PLAYER} consiguió\nuna BICICLETA.",
  ["TEXT_S15_485F"] = "¡Mis BICICLETAS\nson de primera!\fPuedes montar\nen cualquier lugar.",
  ["TEXT_S15_4898"] = "…Suspiro… Ah,\nsi la gente\vfuera buena…",
  ["TEXT_S15_48ED"] = "¡Es una BICICLETA\nnueva y reluciente!",
  ["TEXT_S15_49A3"] = "Si tratas bien\na tu POKéMON,\fte querrá\nde vuelta.\f¿Eh? Déjame ver\ntu {RAM:D099}…",
  ["TEXT_S15_49FC"] = "¡Parece muy\nfeliz! Debe de\vquererte mucho.",
  ["TEXT_S15_4A2C"] = "Tengo la sensación\nde que\vconfía en ti.",
  ["TEXT_S15_4A8E"] = "Es muy mono.",
  ["TEXT_S15_4A9F"] = "Trátalo mejor.\nAún no\vconfía en ti.",
  ["TEXT_S15_4AD1"] = "No parece\nque le gustes.\vParece enfadado.",
  ["TEXT_S15_4B04"] = "sigo perdiendo\nbatallas y mi final POKéMON\ndesmayándose... Quizás por eso\nA mis POKéMON no les agrado...",
  ["TEXT_S15_4B67"] = "Cuando uso el artículo\n¡En POKéMON, está todo feliz!",
  ["TEXT_S15_4C74"] = "BILL: ¡Hola, {PLAYER}!\nHazte un favor y quédate con este EEVEE.\nLlegó cuando estaba ajustando la CÁPSULA DEL TIEMPO.\nAlguien necesita cuidar\nPero no me gusta salir.\n¿Puedo contar contigo, {PLAYER}?",
  ["TEXT_S15_4D3F"] = "BILL: ¡Lo sabía!\n¡Eso es todo, héroe!\feres un chico\nuno bueno!\fOk, cuento con\nusted. Cuídalo bien.",
  ["TEXT_S15_4DAE"] = "{PLAYER} recebeu\num EEVEE!",
  ["TEXT_S15_4DC1"] = "BILL: O PROF.ELM\ndiz que o EEVEE\fpode evoluir de\nmodos inéditos.",
  ["TEXT_S15_4E02"] = "Oye, espera. tu\nNo puedes tomar más POKéMON.",
  ["TEXT_S15_4E2D"] = "Oh… E agora,\no que fazer?",
  ["TEXT_S15_4E42"] = "BILL: Mi padre no\nFunciona. Simplemente se acurruca todo el día.\fSe está convirtiendo en un\ndolor de cabeza…",
  ["TEXT_S15_4EA8"] = "Oh, recoge\n¿POKÉMON? Mi hijo BILL es un experto.\fel tenia que ir\nal CENTRO CIUDAD DE POKEMON\nECRUTEAK.",
  ["TEXT_S15_4F4E"] = "mi marido ya\nconocido como POKéMANIAC.\fBILL debe tener\ntomado después de su padre.",
  ["TEXT_S15_4F9E"] = "¿Eres entrenador?\ftengo un numero\nnúmero de teléfono útil para usted.",
  ["TEXT_S15_4FD9"] = "{PLAYER} anotou\no número do BILL.",
  ["TEXT_S15_4FF3"] = "mi hermano creó\nel sistema de guardia POKéMON en PC.\nIba a darte el número de BILL...",
  ["TEXT_S15_5046"] = "ya no puedes\nanota números.",
  ["TEXT_S15_5069"] = "mi hermano mayor\nEl viejo BILL creó el sistema.\nguardia pokemon",
  ["TEXT_S15_5160"] = "El tren no\nHa llegado… ¡lo sé! tomaré\n¡Los pasajeros en la parte de atrás!\fNo funcionará.",
  ["TEXT_S15_51B7"] = "vámonos pronto\npara AZAFRÁN.\ftu vendras\na bordo?",
  ["TEXT_S15_51ED"] = "¿Puedo ver tu\n¿PASE DE FERROCARRIL?\fBien. Ven por\naquí, señor.",
  ["TEXT_S15_522C"] = "Lo siento. tu\nsin pase de tren",
  ["TEXT_S15_524F"] = "Esperamos vê-lo\nnovamente!",
  ["TEXT_S15_526A"] = "Chegamos a\nGOLDENROD!\fEsperamos vê-lo\nde novo.",
  ["TEXT_S15_52A3"] = "Soy el PRESIDENTE.\fmi sueño fue\nconstruir un tren más rápido que\ncualquier POKEMON.\fel realmente\nacerca a JOHTO y KANTO.",
  ["TEXT_S15_53D4"] = "¿Has visto ese?\nárbol que se mueve, crece\nen la RUTA 36?\fmi hermana pequeña\nse emocionó y fue a ver\ncerca... estoy preocupado...\n¿No es peligroso?",
  ["TEXT_S15_5463"] = "quiero atrapar\npresta la botella de agua\n¿También? no quiero que hagas nada\npeligroso con ella.",
  ["TEXT_S15_54C2"] = "Oh, eres mejor\nque WHITNEY… Todo será\nbueno entonces. ¡Aquí está la BOTELLA DE SQUIRT!",
  ["TEXT_S15_550D"] = "no hagas nada\nmuy peligroso!",
  ["TEXT_S15_552E"] = "Lalala lalalala.\n¡Mucha agua, mi belleza!",
  ["TEXT_S15_5561"] = "cuando le dije\nmi hermana en el tierno árbol,\nElla dijo que es peligroso.\fsi gano\nWHITNEY, ¿le prestará el\nsu botella de agua...",
  ["TEXT_S15_55E6"] = "Vaya, ganaste\na WHITNEY? ¡Legal!",
  ["TEXT_S15_5604"] = "Então era mesmo\num POKéMON!",
  ["TEXT_S15_5659"] = "Una vez, en un\nbatalla, mi POKéMON no\npodría actuar.\fPUNTOS DE ENERGÍA,\no PP, sus golpes habían\nterminado.",
  ["TEXT_S15_56CA"] = "├Ç A veces, un\nPOKéMON sanos no pueden usarse\ntus golpes.\fSi esto ocurre,\ncurarte en el CENTRO POKéMON o usar un objeto.",
  ["TEXT_S15_5993"] = "Bem-vindo ├á\nDEPT.STORE!",
  ["TEXT_S15_59B7"] = "DEPT.STORE tiene\nuna buena variedad.\fPero algunos elementos\nsolo salen como premios del\nRINCÓN DE JUEGO.",
  ["TEXT_S15_5A1A"] = "Estou doida para\ncomprar hoje!",
  ["TEXT_S15_5A3A"] = "Mamãe é boa em\ncaçar promoção.\fEla sempre compra\nas coisas mais\vbaratas.",
  ["TEXT_S15_5A80"] = "1F BALCÃO\f2F MERCADO DO\n   TREINADOR\f3F COLE├çÃO DE\n   BATALHA\f4F REM├ëDIOS\f5F CANTO DAS TM\f6F TERRA├çO",
  ["TEXT_S15_5C25"] = "A POKéGEAR pode\nguardar até dez\vnúmeros.\f├ë difícil\ndecidir quais\vguardar.",
  ["TEXT_S15_5C7B"] = "Gané mi ABRA\nen la CASA DE JUEGOS.\fahora es mio\nmejor socio.",
  ["TEXT_S15_5CB7"] = "Esta TIENDA me hace\nver que GOLDENROD es una ciudad\ngrande.\fLa selección aquí\nNo hay igual en ninguna parte.",
  ["TEXT_S15_5D28"] = "SUA COMPANHEIRA\nDE VIAGEM\f2┬║ ANDAR: MERCADO\nDO TREINADOR",
  ["TEXT_S15_5DCC"] = "Yo, yo, estoy bien\n¡impaciente!\fYo uso X SPEED en\nBatalla para acelerar POKéMON.",
  ["TEXT_S15_5E15"] = "¡Ey! En la batalla,\n¿Utilizas X ESPECIAL?\f├ë demasiado. el\n¡Aumenta mucho la ESPECIAL!",
  ["TEXT_S15_5E74"] = "Para os que Buscam\na Vitória\f3F COLECAO\nDE BATALHA",
  ["TEXT_S15_5F08"] = "Ei. Amo POKéMON\nfortes.\fDou PROTEIN a\neles para elevar\vo ATTACK.",
  ["TEXT_S15_5F52"] = "IRON: a DEFESA do\nPOKéMON sobe.",
  ["TEXT_S15_5F74"] = "Alguns POKéMON\nevoluem quando\fsão trocados por\ncabo Game Link.\fConheço quatro:\nMACHOKE, KADABRA,\fHAUNTER e, hum,\nGRAVELER.\fDizem que existem\noutros também.",
  ["TEXT_S15_600D"] = "Vamos Turbinar\nSeu POKéMON!\f4┬║ ANDAR REM├ëDIOS",
  ["TEXT_S15_6143"] = "Olá. Oh, seu\nPOKéMON…",
  ["TEXT_S15_615A"] = "el es muy\nte tengo cariño.\fEsta estafa debería\nser perfecto para ambos.",
  ["TEXT_S15_61A6"] = "├ë adorável!\fEnsine bons\nmovimentos de TM.",
  ["TEXT_S15_61D8"] = "Parece mau. Que\ntal esta TM para\vele?",
  ["TEXT_S15_6202"] = "Com certeza há\nTM perfeita para\fo seu\nPOKéMON.",
  ["TEXT_S15_6241"] = "REGALO MISTERIOSO.\fcon un pequeño\nbip, obtienes un regalo",
  ["TEXT_S15_6279"] = "O MYSTERY GIFT\nexige um\vGame Boy Color.",
  ["TEXT_S15_62AD"] = "Aos domingos, uma\nmoça vem olhar\vos POKéMON.\fEla até dá\nTM de presente!",
  ["TEXT_S15_62F3"] = "no puedo\ncambiar el nombre de un POKéMON intercambiado.\fEl nombre muestra la\ncariño del viejo entrenador\npara el.",
  ["TEXT_S15_6364"] = "Personalize seu\nPOKéMON\f5┬║ ANDAR: TM",
  ["TEXT_S15_64CB"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_S15_6512"] = "Opa, dinheiro\ninsuficiente…",
  ["TEXT_S15_652B"] = "No hay más espacio\npor las cosas...",
  ["TEXT_S15_654B"] = "¿Escuchas el\n¿CANAL CON SUERTE?\fSi quieres ganar,\nintercambiar POKéMON con el máximo\nlas personas deben tener números de identificación\ndiferente.",
  ["TEXT_S15_65CA"] = "Se estiver cansado\ntente as bebidas\vdas máquinas.\fSeu POKéMON vai\namar também.",
  ["TEXT_S15_661A"] = "Descanse um pouco\ndas compras!\f6┬║ ANDAR: TERRA├çO",
  ["TEXT_S15_677F"] = "Uf, estoy\ncansado.\f├a veces vengo\na la terraza a descansar\nde compras.",
  ["TEXT_S15_67D2"] = "¿Como? quien dijo\n¿A qué adulto no le puede gustar eso?\fvolveré todo\ndía para recogerlos todos\nlas muñecas!",
  ["TEXT_S15_6839"] = "Aqui tem promoção\nde vez em\vquando.",
  ["TEXT_S15_6867"] = "Nossa!",
  ["TEXT_S15_6871"] = "Para de me\nincomodar?",
  ["TEXT_S15_688E"] = "Hay una cosa que\nRealmente lo quiero, pero no lo tengo.\ndinero para eso... Tal vez lo venda\nlas BAYAS que recogí…",
  ["TEXT_S15_6901"] = "Vaya, todo es\n¡tan barato!\fcompré mucho\nque mi BOLSA estaba llena!",
  ["TEXT_S15_6942"] = "mi pokemon\nsiempre está paralizado o\nenvenenado justo a tiempo… vine a comprar uno\nCURACIÓN COMPLETA.\f¿todavía\ntienes?",
  ["TEXT_S15_6E50"] = "Bem-vindo!\fTrocamos suas\nmoedas de jogo\vpor prêmios bons!",
  ["TEXT_S15_6E8B"] = "¿Qué premio tienes?\nquieres?",
  ["TEXT_S15_6EA8"] = "{RAM:D099}.\nEstá certo?",
  ["TEXT_S15_6EBD"] = "Aqui está!",
  ["TEXT_S15_6ECB"] = "Necesito más\nmonedas todavía!",
  ["TEXT_S15_6EE8"] = "Lo siento. tu\nno se puede cargar",
  ["TEXT_S15_6F09"] = "OK. Guarde suas\nmoedas e\vvolte sempre!",
  ["TEXT_S15_6F35"] = "¿Oh? no tienes\nel CAJA DE MONEDAS.",
  ["TEXT_S15_6F55"] = "Sempre jogo nesta\nmáquina.\fAcho que ela paga\nmais que outras.",
  ["TEXT_S15_6F9E"] = "Adoro esta nova\ncaça-níqueis.\f├ë mais desafiadora\nque as de\vCELADON.",
  ["TEXT_S15_6FF4"] = "A vida é um jogo.\nVou virar\vcartas até cair!",
  ["TEXT_S15_702B"] = "Vira-cartas…\fPrefiro aos\ncaça-níqueis\fporque é mais\nfácil de calcular\fas chances.\nMas paga menos.",
  ["TEXT_S15_7097"] = "no paro hasta\nlogra ganar!",
  ["TEXT_S15_70B1"] = "yo enseñé a BLIZZARD\na mi POKéMON.\fFue difícil juntar\nlas monedas para él, pero valió la pena\nvale la pena.",
  ["TEXT_S15_710D"] = "perdí en\nmáquinas tragamonedas, lo gasté todo\nen el volteador de cartas... estaba tan nervioso\nque tiré mi MONEDEROS\nen SUBTERRÁNEO.",
  ["TEXT_S15_718A"] = "¡Jajaja! las patatas fritas\n¡no dejan de venir!",
  ["TEXT_S15_71AF"] = "Alguien salió del\nbebe aquí.\fHuele dulce.",
  ["TEXT_S16_40C7"] = "¿Mmm? Este es un\nPOKéDEX, ¿verdad?\v¿Puedo ver?\fHay muchos tipos de\nPOKÉMON.\f¿Mmm? ¿Qué es esto?\f¿Qué es Pokémon?\nesto?\fparece escribir\nextraño en las paredes\nMALO.\fSi estos dibujos\nRealmente son POKéMON, debe haber muchos más.\f¡Lo sé! voy a actualizar\ntu POKéDEX.\vSígueme.",
  ["TEXT_S16_430E"] = "Gosto de pensar\naqui.",
  ["TEXT_S16_4325"] = "MYSTERY STONE\nPANEL CHAMBER",
  ["TEXT_S16_4342"] = "RUÍNAS DE ALPH\nBem-vindos!",
  ["TEXT_S16_4362"] = "RUÍNAS DE ALPH\nCENTRO PESQUISA\fA Autoridade nas\nRUÍNAS DE ALPH",
  ["TEXT_S16_43A4"] = "mientras\nexploramos los MALOS, nos dimos cuenta\nuna extraña presencia.\ftodos nos quedamos con\nAsustado y salimos corriendo.\ftu también deberías\nten cuidado.",
  ["TEXT_S16_4420"] = "As RUINS escondem\num segredo\vgrande!\f…Eu acho…",
  ["TEXT_S16_4449"] = "Hay muchos tipos\nde UNOWN, así que los usamos nosotros mismos\nnuestros códigos secretos.",
  ["TEXT_S16_448E"] = "A… H… E… A… D…\nHum…\fO quê?\fEstou\ndecodificando\vessa mensagem!",
  ["TEXT_S16_4612"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4644"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4665"] = "Tem um buraco\ngrande na parede!",
  ["TEXT_S16_4685"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_46AA"] = "Um POKéMON que\nvoava com\feleg├óncia em\nasas coloridas.",
  ["TEXT_S16_4800"] = "Bem-vindo a esta\nc├ómara.\fHá painéis\ndeslizantes que\fretratam um\nPOKéMON antigo.\fDeslize os\npainéis para\vformar a figura.\f├Ç direita, a\ndescrição do\vPOKéMON.",
  ["TEXT_S16_48F5"] = "Recientemente,\nSurgieron patrones extraños.\f├ë extraño. No\nEstuvimos aquí hace poco tiempo… Deberías dar\nuna mirada a las paredes.",
  ["TEXT_S16_497C"] = "Ah! Aqui tem outro\nburaco enorme!\f├ë grande o\nbastante pra\vpassar!",
  ["TEXT_S16_49B8"] = "Aquele tremor foi\nbem assustador!\fMas estou mais\npreocupado com\vessa parede aqui…",
  ["TEXT_S16_4AA7"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4AD9"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4AFA"] = "Tem um buraco\ngrande na parede!",
  ["TEXT_S16_4B1A"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_4B3F"] = "Um POKéMON que\nse escondia no\ffundo do mar.\nolhos nas costas.",
  ["TEXT_S16_4C8E"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4CC0"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4CE1"] = "Tem um buraco\ngrande na parede!",
  ["TEXT_S16_4D01"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_4D26"] = "Este POKéMON\nflutuava no mar,\fgirando seus\ndez tentáculos.",
  ["TEXT_S16_4E4F"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4E81"] = "Padr├Áes\napareceram nas\vparedes…",
  ["TEXT_S16_4EA2"] = "Tem um buraco\ngrande na parede!",
  ["TEXT_S16_4EC2"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_4EE7"] = "Este POKéMON\nvoador atacava\fa presa com\ndentes de serra.",
  ["TEXT_S16_4F89"] = "Há uma presença\nestranha aqui…",
  ["TEXT_S16_4FAC"] = "Esta habitación es\ngrande, pero no hay nada aquí.",
  ["TEXT_S16_4FDA"] = "Este lugar tem\numa qualidade\vmística.\fParece até\netéreo.",
  ["TEXT_S16_5024"] = "Prédios antigos\nsão túmulos de\vreis.\fComo as\npir├ómides.",
  ["TEXT_S16_5072"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_5278"] = "Pronto!\fModifiquei sua\nPOKéDEX.\fAdicionei uma\nPOKéDEX opcional\fpara guardar\ndados de UNOWN.\fEla registra\nna ordem em\vque os pegou.",
  ["TEXT_S16_52FA"] = "O POKéDEX de\n{PLAYER} foi\vatualizado.",
  ["TEXT_S16_5311"] = "El UNOWN que\nque captures quedarán todos registrados. Comprueba cuántos\nexisten tipos.",
  ["TEXT_S16_53ED"] = "Los MALOS tienen sobre\n1500 años.\fPero no se sabe\npor qué fueron hechos, ni por qué\nquien.",
  ["TEXT_S16_5445"] = "cuantas especies\nLos POKéMON están en las RUINAS, ¿verdad?",
  ["TEXT_S16_5478"] = "POKEMON apareció\nen las RUINAS?\fque noticias\nincreible!\fnecesitaremos\ninvestiga esto.",
  ["TEXT_S16_54CB"] = "Nossa pesquisa,\ncom sua ajuda,\festá revelando\nmais sobre as\vRUINS.\fAs RUINS parecem\nter sido feitas\fcomo habitat pra\nPOKéMON.",
  ["TEXT_S16_554F"] = "Há padr├Áes\ndesenhados nas\fparedes das\nRUÍNAS.\fDevem ser a chave\npara desvendar\vo mistério\vdas RUÍNAS.",
  ["TEXT_S16_55CB"] = "POKÉMON\n¿Qué viste en las RUINAS?\fSe parecen mucho\nlos dibujos en las paredes allí.\n…Hm… Eso significa que hay muchos\nsu especie...",
  ["TEXT_S16_5769"] = "Por que esses\npadr├Áes antigos\fapareceram na\nparede agora?\fO mistério\naumenta…",
  ["TEXT_S16_57B6"] = "RUÍNAS DE ALPH\fExploração\nAno 10",
  ["TEXT_S16_57D9"] = "POKéMON misterioso\nNome: UNOWN\fUm total de 26\ntipos achados.",
  ["TEXT_S16_580E"] = "todavía parece\nno funciona.",
  ["TEXT_S16_582D"] = "UNOWN podem\nser impressos.",
  ["TEXT_S16_5886"] = "Hay muchos libros\nacadémicos.\fRuinas antiguas…\nMisterios de los Antiguos...",
  ["TEXT_S16_5923"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_59AD"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_5A37"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_5AC1"] = "├ë uma réplica\nde um POKéMON\vantigo.",
  ["TEXT_S16_5C6C"] = "¡Muy bien entonces!\nDecidí.\fno me voy de aquí\n¡Hasta que mis POKéMON sean fuertes!",
  ["TEXT_S16_5D31"] = "Todos los viernes,\npuedes escuchar los rugidos de POKéMON\ndesde el fondo de la cueva.",
  ["TEXT_S16_5DC9"] = "Fui enganado e\ncomprei um\vSLOWPOKETAIL.\fTenho pena desse\ncoitado.",
  ["TEXT_S16_5E6F"] = "No fim de semana\ndá para ouvir\frugidos estranhos\nlá no fundo.",
  ["TEXT_S16_5EFC"] = "├ë o fogo do meu\nPOKéMON que acende\vesta caverna.",
  ["TEXT_S16_6073"] = "he estado perdido\nmucho tiempo... no me importa\nQuédate aquí, ¡pero qué hambre!",
  ["TEXT_S16_60FB"] = "Vivo aquí.\fTambién puedes,\nsi quieres.\fTiene espacio para\nsobras, ya sabes.",
  ["TEXT_S16_6181"] = "solo yo y los mios\nPOKÉMON. Estoy loco de alegría.",
  ["TEXT_S16_6230"] = "Debo reunirme y\ncompartir lo que descubrí.\fQuién sabe, tal vez me quede\nfamoso como PROF.ELM.",
  ["TEXT_S16_63F0"] = "Tu estilo POKEMON\nEs impresionante y colorido, sí.\ftu solo lo harás\nmejorar!",
  ["TEXT_S16_6488"] = "Vou treinar\nsozinho até eu\vmelhorar.",
  ["TEXT_S16_652B"] = "Uma vez por semana\num POKéMON vem\vaté a beira.\fEu queria ver\nesse POKéMON…",
  ["TEXT_S16_66B5"] = "KURT: Hola,\n {PLAYER} !\fLos guardias allí\nHuyeron cuando grité.\fPero luego me caí\nbueno aquí abajo.\fgolpeé la espalda\nduro y ahora no puedo caminar ¡Maldita sea! si yo\nestuvieran bien, POKéMON habría dado\nel cambio... Oh, no hay\nmanera.\f {PLAYER}, muestra el\n¡Dales tu coraje en mi lugar!",
  ["TEXT_S16_67CA"] = "KURT: Muy bien,\n {PLAYER} !\fCOHETE DEL EQUIPO\nse fue.\fmi espalda\nhan mejorado. Vámonos de aquí.",
  ["TEXT_S16_68E8"] = "si, venimos\ncortando la cola del SLOWPOKE y\nvendiéndolos.\fTodo lo que hacemos\nEs con fines de lucro.\f¡Así es!\nSomos TEAM ROCKET y lo hacemos\ntodo por dinero!",
  ["TEXT_S16_69FC"] = "├ë, a TEAM ROCKET\nfoi desfeita\vhá três anos.\fMas continuamos\ncom as atividades\vescondidos.\fAgora divirta-se\nvendo a gente\vaprontar!",
  ["TEXT_S16_6AF2"] = "A gente precisa da\ngrana, mas vender\vSLOWPOKETAILS?\f├ë duro ser um\nROCKET GRUNT!",
  ["TEXT_S16_6B8D"] = "SLOWPOKETAILS\ncrescem rápido!\fQual o problema\nde vender elas?",
  ["TEXT_S16_6BCB"] = "Um SLOWPOKE com a\nTAIL cortada…\fHã? Tem uma MAIL.\nLer?",
  ["TEXT_S16_6C09"] = "{PLAYER} lee el\nCORREO.\fSe bueno y cuídate.\nde la casa con el abuelo├┤ y\nLENTO.\fCon amor papi",
  ["TEXT_S16_6C61"] = "Um SLOWPOKE com a\nTAIL cortada…",
  ["TEXT_S16_6D2A"] = "Espero o momento\nde evolução do\vSLOWPOKE.\fPelas minhas\nobservaç├Áes,\vdescobri algo.\fUm SLOWPOKE com\numa KING'S ROCK\fé mordido por\num SHELLDER.\fAqui, vou te\ndar uma KING'S\vROCK.",
  ["TEXT_S16_6DF2"] = "Vou ser como\no SLOWPOKE.\fEsperarei com\npaciência para\vver um evoluir.",
  ["TEXT_S16_6E6D"] = "La gente entrena\nen este FARO.\fNo es fácil escalar\ngracias a todos los entrenadores.",
  ["TEXT_S16_6EC2"] = "Antigamente,\nPOKéMON\viluminavam\fo mar em volta de\nOLIVINE ├á noite.\fO LIGHTHOUSE foi\nfeito em honra a\vesses POKéMON.",
  ["TEXT_S16_70B0"] = "Argh!\nEu perco!",
  ["TEXT_S16_713E"] = "Arriba hay un\nPOKéMON que mantiene encendido el faro.\fPero lo escuché\nestá enfermo y no sanará\nmedicina común.",
  ["TEXT_S16_72DF"] = "¿Cómo diablos si\n¿Subir aquí?\fquiero visitar el\nPOKéMON enfermo, pero no puedo\nllegar allí…",
  ["TEXT_S16_7384"] = "Toda vez que volto\na OLIVINE, eu\vvisito o GINÁSIO.\fO tipo de POKéMON\nda LÍDER mudou\fsem que eu\npercebesse.",
  ["TEXT_S16_7457"] = "A JASMINE usava\nPOKéMON de pedra\vcomo o ONIX.",
  ["TEXT_S16_7584"] = "Falando em doente,\nouvi que tem\fuma boa farmácia\nem CIANWOOD.",
  ["TEXT_S16_763C"] = "Certo. Qualquer um\nficaria preocupado\vse o POKéMON dele\vestivesse ferido.\fVou rezar pelo\nPOKéMON daqui,\fpara a JASMINE\nvoltar ao GINÁSIO",
  ["TEXT_S17_41D3"] = "¡Mirar! ver el mio\nbolsa!\fimprimir el mio\nFavoritos y pegados de POKéDEX\nen mi bolso.",
  ["TEXT_S17_422E"] = "Este es un CORREO de\nmi hija.\vElla me anima.",
  ["TEXT_S17_4265"] = "Atención, por\n¡por favor!\f…Ups, necesito\ndeja de pensar como un maestro\ntodo el tiempo.\fDebes ser un\nEntrenador POKéMON Ya que te esfuerzas\ntanto, quiero que te quedes con\nesto.",
  ["TEXT_S17_430D"] = "Dê essa QUICK CLAW\na um POKéMON.\f├Çs vezes ele ataca\nprimeiro na\vbatalha.",
  ["TEXT_S17_435D"] = "Estou brincando\ncom adesivos que\vtirei da POKéDEX.",
  ["TEXT_S17_438F"] = "Se eu ganhar, fico\ncom o adesivo da\vPOKéDEX dele.",
  ["TEXT_S17_43BC"] = "yo camino a través\nPARK, pero nunca entro en medio de\narbusto.\fEntrenadores siempre\nquieren pelear...",
  ["TEXT_S17_4416"] = "PERSIAN: Fufusha!",
  ["TEXT_S17_442A"] = "estoy imprimiendo el\nmi POKéDEX.\fSe puede imprimir\notras cosas, como MAIL y sus\nCAJAS DE PC.",
  ["TEXT_S17_44E4"] = "O-o quê?",
  ["TEXT_S17_44F3"] = "hay mucho\nqué aprender.\fPor ejemplo… Hay 50 tipos\nde TM.\fPOKEMON intercambiado\nsubir más rápido",
  ["TEXT_S17_45BD"] = "Devo dizer que\nseus POKéMON\vtambém são bem\vfofos.",
  ["TEXT_S17_4645"] = "perdí la batalla,\npero mis POKéMON ganan el premio\nporque son lindos.",
  ["TEXT_S17_471D"] = "Por tu mirada,\nPensé que te gustaba.\fDespués de todo, soy\nlindo!",
  ["TEXT_S17_4750"] = "PRA├çA DO DESCANSO\nNATIONAL PARK",
  ["TEXT_S17_4771"] = "O que diz este\naviso?\fBatalhe somente no\nmato, por favor.\fNATIONAL PARK\nSEDE DA GUARDA",
  ["TEXT_S17_47C6"] = "TRAINER TIPS\fPara imprimir uma\nMAIL, abra ela e\vaperte START.",
  ["TEXT_S17_494C"] = "DON: Lo haré\n¡gana! No me molestes.",
  ["TEXT_S17_4973"] = "ED: Mi PARASECTO\nhace que POKéMON duerma con SPORE.",
  ["TEXT_S17_49A3"] = "NICK: Crio\nPOKéMON rápidos\vpara batalhas.",
  ["TEXT_S17_49CC"] = "GUILLERMO: Yo no.\nMe importa ganar.\fsolo estoy mirando\nPOKÉMON raros.",
  ["TEXT_S17_4A15"] = "BENNY: ¡Ssh!\nAsustará a SCYTHER. yo hablo\ncontigo más tarde.",
  ["TEXT_S17_4A52"] = "barry: tu\ndebería debilitar a los POKéMON insectos,\njugar POKé BOLA.",
  ["TEXT_S17_4A8F"] = "cindy: me encanta\nInsecto POKéMON.\fcreo que tu\ntambién le gusta.",
  ["TEXT_S17_4AC8"] = "JOSH: Yo colecciono\nInsecto POKéMON desde que era\nbien niño.\fNo hay manera\n¡Yo ganaré!",
  ["TEXT_S17_4B25"] = "SAMUEL: Se tem\ntempo para\fconversar, procure\nPOKéMON inseto.",
  ["TEXT_S17_4B64"] = "kipp: estudié\nmucho sobre POKéMON insectos.\fvoy a ganar\nseguro.",
  ["TEXT_S17_4BA7"] = "PRA├çA DO DESCANSO\nNATIONAL PARK",
  ["TEXT_S17_4BC8"] = "O que diz este\naviso?\fBatalhe somente no\nmato, por favor.\fNATIONAL PARK\nSEDE DA GUARDA",
  ["TEXT_S17_4C1D"] = "TRAINER TIPS\fPara imprimir uma\nMAIL, abra ela e\vaperte START.",
  ["TEXT_S17_4E77"] = "Bem-vindo!",
  ["TEXT_S17_4E81"] = "Hola. lo siento\npero hoy no tenemos visitas guiadas disponibles.",
  ["TEXT_S17_4EBA"] = "Hola, viniste\n¿MUESTRA DE NÚMEROS DE SUERTE?\fquieres que vea\n¿Tus números de ID de POKéMON?\fSi tienes suerte,\ngana un premio.",
  ["TEXT_S17_4F3A"] = "O número de ID\ndesta semana é\v{RAM:D099}.",
  ["TEXT_S17_4F5A"] = "A ver si tu\nalgo de razón.",
  ["TEXT_S17_4F79"] = "……\n……",
  ["TEXT_S17_4F7E"] = "Volte semana que\nvem para o próximo\vLUCKY NUMBER.",
  ["TEXT_S17_4FB5"] = "¡Guau! Lo hiciste bien\n¡Los cinco números completos!\ftenemos un ganador\ndel gran premio!\fganaste uno\n¡MASTERBOLA!",
  ["TEXT_S17_5023"] = "¡Ey! Lo hiciste bien\n¡Los últimos tres números!\fGanó el segundo\npremio, una EXP.\v¡COMPARTIR!",
  ["TEXT_S17_5076"] = "Oh, lo hiciste bien\nlos dos últimos números.\fGanó el tercero\npremio, un PP UP.",
  ["TEXT_S17_50C0"] = "No, ninguno de\nsus identificaciones coinciden.",
  ["TEXT_S17_50E6"] = "No hay espacio para\ntu premio.\fhacer espacio y\nVuelve aquí pronto.",
  ["TEXT_S17_512D"] = "Temos uma promoção\nde quiz especial\vrolando agora.\fAcerte cinco\nperguntas e ganhe\vum RADIO CARD.\fEncaixe ele na sua\nPOKéGEAR e toque\fo rádio a qualquer\nhora e lugar.\fQuer responder ao\nquiz?",
  ["TEXT_S17_51F2"] = "Pergunta 1:\fExiste um POKéMON\nque aparece só\vde manhã?",
  ["TEXT_S17_5231"] = "¡Correcto!\nPregunta 2: Esta oración es\n¿verdad?\fno puedes\ncompre una BAYA en un MART.",
  ["TEXT_S17_5282"] = "Na mosca!\nPergunta 3:\fO KURT, artesão de\nPOKé BALLS, usa\vAPRICORNS?",
  ["TEXT_S17_52BC"] = "¡Hasta ahora, todo bien!\nPregunta 4: MAGIKARP no lo sabe\naprender MT?",
  ["TEXT_S17_530E"] = "¡Guau! Bien de nuevo\nEsta es la última pregunta: POKéMON DEL PROF.OAK\nTALK es un programa muy popular.\fMARÍA es la\ncoanfitrión?",
  ["TEXT_S17_537B"] = "Bingo! Acertou!\nParabéns!\fEste é seu prêmio,\num RADIO CARD!",
  ["TEXT_S17_53C0"] = "A POKéGEAR de\n{PLAYER} agora toca\vrádio também!",
  ["TEXT_S17_53E5"] = "Sintonize nossos\nshows de rádio.",
  ["TEXT_S17_5409"] = "Ay, que pena.\nLo siento, pero cometiste un error.\n¡Intentar otra vez!",
  ["TEXT_S17_5443"] = "Ah. Entendo. Tente\nde novo se mudar\vde ideia.",
  ["TEXT_S17_5476"] = "O BEN é um DJ\nfabuloso.\fA voz doce dele\nme derrete!",
  ["TEXT_S17_54AC"] = "Amo a MARÍA, de\nHABLA DE POKÉMON.\fsolo conozco la voz\nella, pero nunca la vi.",
  ["TEXT_S17_55A2"] = "├ë demasiado fuerte.\fNuestro plan puede\ndesmoronarse. Necesito advertir a los demás...",
  ["TEXT_S17_55E7"] = "1F RECEP├çÃO\n2F VENDAS\v3F PESSOAL\v4F PRODU├çÃO\v5F SALA DO\v   DIRETOR",
  ["TEXT_S17_5631"] = "LUCKY CHANNEL!\fGanhe com os IDs\ndos seus POKéMON!\fTroque POKéMON e\ncolecione IDs\vdiferentes!",
  ["TEXT_S17_5924"] = "¿Puedes oír?\nla radio en cualquier lugar.",
  ["TEXT_S17_5956"] = "Canç├Áes de ninar\nna radio podem\vfazer dormir.",
  ["TEXT_S17_5983"] = "Por que eles\nquerem tomar conta\vda RADIO TOWER?",
  ["TEXT_S17_59B6"] = "JIGGLYPUFF:\nJiggly…",
  ["TEXT_S17_59CB"] = "Lo siento. Sólo\npersonal autorizado más allá de aquí.\fno fue asi\nantes.\falgo anda mal\ncon la DIRECTORA...",
  ["TEXT_S17_5A44"] = "Sinta-se livre\npara olhar.\fO DIRETOR esta\nbom de novo,\vcomo era antes.",
  ["TEXT_S17_5B07"] = "no lo dejaremos\n¡Arruinas nuestros planes!",
  ["TEXT_S17_5B99"] = "No siempre estamos\nchicos malos. Hacemos lo que nos gusta.",
  ["TEXT_S17_5C00"] = "Nuestros EJECUTIVOS\nestán tratando de tomar este lugar.\ftienen un plan\ngrande. Quería saber qué es.",
  ["TEXT_S17_5CD0"] = "Me ganaste y\n¡No lo olvidaré!",
  ["TEXT_S17_5CF4"] = "BUENA: ¡Hola! yo soy\n¡BUENA!\f¿Conoces uno?\nprograma de radio llamado CONTRASEÑA?\fsi me dices\nla contraseña del programa, usted\nganar puntos.\fMantén estos\npuntos e intercambio con esa chica\ndulce ahí para premios\n├elección!\f¡Aquí lo tienes!\fTu propio\ntarjeta de puntos!",
  ["TEXT_S17_5E10"] = "BUENA: Sintonize\no PASSWORD SHOW!",
  ["TEXT_S17_5E35"] = "BUENA: ¡Hola!\n¿Sintonizaste mi programa?\fRecordar contraseña\nhoy?",
  ["TEXT_S17_5E84"] = "BUENA: Nossa!\nObrigada!\fQual era seu\nnome mesmo?\f…{PLAYER}, certo!\fVem, {PLAYER}.\nEntra no show.",
  ["TEXT_S17_5EDD"] = "BUENA: Todos\n¿Listo?\fquiero escucharte\ngrita la contraseña de hoy a\n {PLAYER} !",
  ["TEXT_S17_5F29"] = "BUENA: Vuelve\ndespués de escuchar mi programa, ¿vale?\n¡Hasta luego!",
  ["TEXT_S17_5F6C"] = "BUENA: Lo siento… Sólo tienes uno.\noportunidad por día.\fVuelve mañana\n¡inténtalo de nuevo!",
  ["TEXT_S17_5FC1"] = "BUENA: ¡YAY!\n¡Lo hice bien!\f¡Te sintonizaste!\n¡Qué felicidad!\f¡Tienes razón!\n¡Felicidades!",
  ["TEXT_S17_601C"] = "BUENA: Ah...\nEso no es todo... Se te olvidó el\ncontraseña?",
  ["TEXT_S17_6054"] = "BUENA: ¡Sí!\nNuestro invitado fue {PLAYER}.\n¡Gracias por venir!\fespero que todos\n¡Ustedes, oyentes, vengan también!\n¡Voy a esperar!",
  ["TEXT_S17_60C2"] = "BUENA: Hã?\nA senha de hoje?\fHELP, é claro!",
  ["TEXT_S17_60F1"] = "BUENA: Seu BLUE\nCARD está cheio.\fTroque por um\nprêmio incrível!",
  ["TEXT_S17_6131"] = "BUENA: Sintonize\no PASSWORD\ftoda noite das 6\n├á meia-noite!\fSintonize e venha\nfazer uma visita!",
  ["TEXT_S17_6192"] = "BUENA: ¿Ah? tu\n¿Olvidaste traer tu TARJETA AZUL?\fno puedo dar\npuntos si no lo tienes.",
  ["TEXT_S17_61EE"] = "BUENA: ¡Ay! tu\n¡La TARJETA AZUL llegó hoy a 30 puntos!\n¡Qué increíble!\fMmmm... no hay\npremio por llegar a los 30, pero… Viniste tanto,\n {PLAYER}.\fharé uno\noferta especial!\f¿Qué tal el mío?\nnúmero de teléfono?",
  ["TEXT_S17_62BF"] = "BUENA: {PLAYER} ,\n¿Quieres registrar mi\nnúmero?",
  ["TEXT_S17_62F3"] = "{PLAYER} salvou o\nnúmero da BUENA.",
  ["TEXT_S17_6310"] = "BUENA: Me encantara\n¡te escucho!",
  ["TEXT_S17_633C"] = "BUENA: Ah… ├ë um\nprêmio especial…",
  ["TEXT_S17_635E"] = "BUENA: {PLAYER} ,\ntu lista de teléfonos no tiene\nespacio para mi...",
  ["TEXT_S17_6392"] = "puedes intercambiar\ntus puntos por un premio\nhermosa, ├elección!",
  ["TEXT_S17_63D8"] = "no puedo intercambiar\npuntos sin tu TARJETA AZUL.\fNo olvides tu\n¡TARJETA AZUL!",
  ["TEXT_S17_6426"] = "2F VENDAS",
  ["TEXT_S17_6430"] = "TALK POKéMON\nDO PROF.OAK\fO Show Mais Quente\nno Ar!",
  ["TEXT_S17_6463"] = "Em Qualquer Lugar\nPOKéMON Radio",
  ["TEXT_S17_6621"] = "Temos gravaç├Áes\ndos gritos de\ftodos os POKéMON\nencontrados.\fDevemos ter uns\n200 tipos.",
  ["TEXT_S17_6682"] = "Para treinadores,\nPOKéMON são\vseus parceiros.\fE terrível como a\nTEAM ROCKET esta\ftentando controlar\nPOKéMON.",
  ["TEXT_S17_66EB"] = "Trabalhamos 24h\npor dia para\ftransmitir\nprogramas legais.\fVou dar o meu\nmelhor para\vtrabalhar!",
  ["TEXT_S17_6754"] = "O chefe da TEAM\nROCKET trancou\vele mesmo lá.\fMas o DIRETOR\npode abrir.\fEle esta no\nquinto andar.\fSalve-o!",
  ["TEXT_S17_67CB"] = "O DIRETOR\nesta seguro?",
  ["TEXT_S17_67E2"] = "¡Gracias!\n¡Eres mi héroe!\fEste es un símbolo\nde gratitud.",
  ["TEXT_S17_6821"] = "E SUNNY DAY.\nFortalece\vmovimentos de fogo\vpor um tempo.",
  ["TEXT_S17_685C"] = "tu eras\nmaravilloso!",
  ["TEXT_S17_68D0"] = "yo falle el mio\ntrabajo… obtendré un descuento\ncon mi salario...",
  ["TEXT_S17_6944"] = "Estou péssimo por\nter perdido!\fDroga! Odeio\nPOKéMON inúteis!",
  ["TEXT_S17_69D0"] = "O quê?! Passou\npelos nossos,\vno UNDERGROUND?\fComo conseguiu?",
  ["TEXT_S17_6A61"] = "Bwahahaha... puedo transmitir\nuna señal tan fuerte como necesito.",
  ["TEXT_S17_6AA4"] = "E o slot da\nCHAVE-CARTAO.",
  ["TEXT_S17_6ABC"] = "{PLAYER} inseriu\na CHAVE-CARTAO.",
  ["TEXT_S17_6AD6"] = "3F PESSOAL",
  ["TEXT_S17_6AE4"] = "M├ÜSICA POKéMON\ncom o DJ BEN",
  ["TEXT_S17_6C12"] = "Ouvi a radio\nquando estava\vnas RUÍNAS.\fOuvi uma\ntransmissão lá.",
  ["TEXT_S17_6C68"] = "MARÍA: ¿Por qué?\n¿Por qué tengo que sufrir esto?\f¡MEOWTH ayúdame!",
  ["TEXT_S17_6CAB"] = "MARÍA: ¡Ay! tu y\nmi salvador!\faceptará esto\ncomo gracias",
  ["TEXT_S17_6CEF"] = "MARY: E perfeito\npara POKéMON\fque conhecem\nataques normais.",
  ["TEXT_S17_6D2C"] = "MARÍA: Por favor\nsintoniza mi programa\nHABLAR POKÉMON.",
  ["TEXT_S17_6D66"] = "MEOWTH: Meowth…",
  ["TEXT_S17_6DE2"] = "¡No lo creo!\n¡Fui derrotado!",
  ["TEXT_S17_6E69"] = "tu ganaste mi\nrespeto, así que aquí tienes algunos consejos.\fNo es demasiado tarde.\nAún puedes volver.",
  ["TEXT_S17_6F31"] = "Eu amo a minha\nbeleza!\fQuem liga para\nos POKéMON?",
  ["TEXT_S17_6FCB"] = "¿Crees?\n¿Incluso si puedes detener al TEAM?",
  ["TEXT_S17_6FFE"] = "4F PRODUCAO",
  ["TEXT_S17_700D"] = "4F ESTUDIO 2",
  ["TEXT_S18_4128"] = "¡Tú! tu viniste\nrescatarme?",
  ["TEXT_S18_4147"] = "Eso es lo que tu\nesperado?\f¡Equivocado!\n¡Soy un impostor!\ffingí ser el\ncierto para preparar\nnuestra opinión.\f¿Quieres saber dónde?\n¿Realmente escondimos al DIRECTOR?\fPor supuesto, iré a verte\ncontar. ¡Pero sólo si me ganas!",
  ["TEXT_S18_4223"] = "Tudo bem. Vou te\ncontar.",
  ["TEXT_S18_4246"] = "Ocultamos el\nDIRECTOR REAL en ALMACÉN\nSUBTERRÁNEO.\fY en la punta de\nSUBTERRÁNEO.\vpero dudo de ti\nllegar allí.",
  ["TEXT_S18_4358"] = "{PLAYER}, ¿verdad?\fun mocoso como\nno apreciarás el\nmagnificencia del TEAM ROCKET.\nQué vergüenza. Admiro tu poder.",
  ["TEXT_S18_43D1"] = "¿Oh? lo tienes\n¿llegar aquí?\fDebes ser un\nbuen entrenador.\fNuestros planes son\ntoma esta ESTACION DE RADIO y anuncia\nnuestro regreso.\vEso debería traer a nuestro jefe\nGIOVANNI regresa de su entrenamiento\nsuelo.\fvamos a recuperarnos\nnuestra antigua gloria.\fno lo permitiré\nQue perturbes nuestros planes.",
  ["TEXT_S18_44F3"] = "¡No! Perdóname,\n¡JOVANNI!",
  ["TEXT_S18_450E"] = "¿Cómo puede ser?\fNuestros sueños son\nse convirtió en nada.\fno estaba a la altura\nde la tarea después de todo.\fComo lo hizo GIOVANNI\ndelante de mí disolveré el\nEQUIPO ROCKET hoy.\fAdiós.",
  ["TEXT_S18_45B2"] = "DIRECTOR: {PLAYER},\ngracias!\fTus acciones\ngente valiente salvó POKéMON\nen todo el país.\fse que no lo es\nmucho, pero por favor acéptalo.",
  ["TEXT_S18_462C"] = "Anteriormente había\nuna torre aquí mismo en GOLDENROD CITY.\fpero ella era vieja\ny crujió.\fentonces intercambiamos\npor nuestra TORRE DE RADIO.\fEncontramos esto\ncampana durante la construcción.\fescuché eso\nvarios POKéMON vivían en\nVARILLA DE ORO antes.\fTal vez… Esa campana tiene\ncualquier conexión con TIN TOWER\nen CIUDAD ECRUTEAK… ¡Ah!\fEso me recuerda... escuché TEAM ROCKET\nsusurrando.\fParece que hay\nAlgo está pasando en TIN TOWER.\fno se que\nEstá sucediendo, pero deberías\necha un vistazo.\fBueno, mejor\nve a mi OFICINA.",
  ["TEXT_S18_4824"] = "DIRECTORA: Hola,\n {PLAYER} !\fya sabes, me encanta\nPOKÉMON.\fConstruye esto\nTORRE DE RADIO para expresar mi amor\npor POKÉMON.\fSería bueno si el\nla gente disfrutó de nuestros programas.",
  ["TEXT_S18_48BE"] = "BEN: ¿Oyes?\nnuestra música?",
  ["TEXT_S18_48E0"] = "5F ESCRITORIO\nDO DIRETOR",
  ["TEXT_S18_48F9"] = "5F ESTUDIO 1",
  ["TEXT_S18_4A1F"] = "UN LÍDER no es sólo\ncuestión de ser fuerte. UN LÍDER\nTambién necesitas tener compasión.",
  ["TEXT_S18_4AC3"] = "mi pokemon\nAprendí a usar FLY en CIANWOOD.\fBueno, ¿cómo me lo perdí?\nUsaré FLY para cruzar el mar…",
  ["TEXT_S18_4C81"] = "JAZMÍN: …Esto\nPOKéMON siempre ha mantenido el mar\niluminado por la noche.\f...pero el\ncayó enfermo... Está jadeando... ...Sé que hay\nuna gran FARMACIA en\nCIANWOOD… Pero eso queda\nmás allá del mar... Y no puedo\ndeja AMPHY…",
  ["TEXT_S18_4D64"] = "…Pode buscar\num remédio para\vmim? Por favor?",
  ["TEXT_S18_4D99"] = "JASMINE: …Este\nremédio curará\vo AMPHY?",
  ["TEXT_S18_4DC3"] = "{PLAYER} entregou\na SECRETPOTION\va JASMINE.",
  ["TEXT_S18_4DEA"] = "JAZMÍN: …Eh,\nNo te ofendas, por favor... ...AMPHY no\nno aceptará nada de nadie más...",
  ["TEXT_S18_4E44"] = "JASMINE: … AMPHY, como tú.\nsentir?",
  ["TEXT_S18_4E6C"] = "JAZMÍN: …Oh,\nque alivio… ├ë entonces\nmaravilloso…Muy, muy\ngracias.\f…volveré\nal GIMNASIO...",
  ["TEXT_S18_4EDF"] = "JASMINE: …Vejo…",
  ["TEXT_S18_4EF1"] = "…AMPHY, aguenta!",
  ["TEXT_S18_4F19"] = "A respiração\nestá difícil…",
  ["TEXT_S18_6105"] = "EL COLISEO\nen los pisos del CENTRO POKéMON,\nEs para batallas vía enlace.\nLos registros de pelea en la pared,\nNo puedo perder.",
  ["TEXT_S18_6260"] = "UN POKEMON de\nEl nivel más alto no siempre gana.\fIncluso puede que tenga\ntipo de desventaja.\fno lo creo\nsolo hay un POKéMON que es\nel más fuerte.",
  ["TEXT_S18_63FB"] = "Vaya, tu bolso\n¡Es tan pesado!\f¡Oh! por casualidad\n¿Tienes algo llamado EON MAIL?\fmi hija quiere\nuno.\fpuedes abrir\nla mano, ¿verdad?",
  ["TEXT_S18_648C"] = "Quer doar um\nEON MAIL?",
  ["TEXT_S18_64A4"] = "¡Oh, qué genial!\n¡Gracias querida!\fToma, esto es para\n¡tú a cambio!",
  ["TEXT_S18_64E9"] = "mi hija lo hará\n¡sé radiante!",
  ["TEXT_S18_6509"] = "¿Oh? ¿No tienes uno?\nQué vergüenza.",
  ["TEXT_S18_652A"] = "Ah… Bom, fica pra\noutra hora, então.",
  ["TEXT_S18_6549"] = "{PLAYER} doou o\nEON MAIL.",
  ["TEXT_S18_6674"] = "O POKéCOM CENTER e\no MOBILE CENTER\vforam feitos pra\vatender trocas e\vbatalhas com\vtreinadores\vdistantes e\vestranhos.",
  ["TEXT_S18_66F9"] = "cuando tu\nconectado con alguien\ncelular por primera vez no funciono\nimpresionado?\fcuando mi\nPrimero funcionó, estaba\n¡Tan impresionado que temblé por todos lados!",
  ["TEXT_S18_6795"] = "Conseguiram\nconstruir esse\flugar enorme\ngraças aos\vavanços em\vtecnologia sem\vfio.",
  ["TEXT_S18_67EE"] = "├ë una advertencia sobre\ndónde deben estar los ADAPTADORES MÓVILES\nser usado...",
  ["TEXT_S18_6828"] = "Tiene un POKéCOM\nCLUB arriba de cualquier\nCENTRO POKEMON.\fahí puedes\nluchar o comerciar con un\namigo lejano usando un ADAPTADOR MÓVIL.\fPara conectarse, su\namigo necesita tener el mismo tipo de\nADAPTADOR MÓVIL que tú.",
  ["TEXT_S18_68F4"] = "Para usar COMERCIO\nESQUINA o lee NOTICIAS POKéMON,\nes necesario llamar al CENTRO MÓVIL.\fdebes\nregistrarse en CENTRO MÓVIL\nantes de conectarse allí.",
  ["TEXT_S18_6989"] = "├ë una advertencia sobre\ncómo usar el teléfono...",
  ["TEXT_S18_69AE"] = "Comprueba si tu\nteléfono y ADAPTADOR MÓVIL\nestán bien conectados.\fCompruebe si el\nLa señal del teléfono inalámbrico es fuerte.\fNo tocar ni\napague el teléfono al conectarse.",
  ["TEXT_S18_6A5A"] = "Si el servidor\nestá ocupado, tal vez no\nposible entrar.\fSi ese es el caso,\nllama más tarde.\fSi no lo haces\npoder entrar o no entender\nerrores, llame al soporte\no leer las instrucciones.",
  ["TEXT_S18_6B26"] = "LA ADMINISTRACIÓN\nLA OFICINA recibió un correo electrónico. Él dice… …… …… …… Al equipo\nCENTRO POKéCOM… Comunicación sin\nEl cable permitió a los entrenadores\nPOKéMON interactúa en todo el país.\nSigamos trabajando por\ndía en que todos los entrenadores del\n¡El mundo puede conectarse sin barreras!\f…… …… ……",
  ["TEXT_S18_6C80"] = "BOSQUE DE ILEX\nEs grande. ¡Cuidadoso!\vNo te pierdas.",
  ["TEXT_S18_6CB0"] = "A FLORESTA é\ncuidada pelo\vseu protetor.\fNada de\ntraquinagens!",
  ["TEXT_S18_6D9D"] = "Oh, cariño. hacer\n¿Una POKéDEX?\fdebe ser dificil\nsi los POKéMON no aparecen.\nIntente usar TM.",
  ["TEXT_S18_6E97"] = "Viu o santuário\nem honra ao\vprotetor?\fEle vigia a\nFLORESTA através\vdos tempos.\fAcho que deve ser\num POKéMON do tipo\vgrama.",
  ["TEXT_S18_6FDA"] = "El abuelo├┤ era\nbuscándote.",
  ["TEXT_S18_70CE"] = "soy guardería\nHOMBRE.\f¿Sabes acerca de\n¿HUEVOS?\fYo creé POKEMON\ncon mi esposa, ya sabes.\fNos quedamos en shock\nal encontrar un HUEVO!\f¿No es asombroso?\nesto?\fBueno, no quieres\neste HUEVO?\fentonces es tuyo\npara mantener!",
  ["TEXT_S18_71AE"] = "{PLAYER} recebeu\num ODD EGG!",
  ["TEXT_S18_71C3"] = "Encontré esto cuando\nse hizo cargo de POKéMON\nalguien antes.\fpero el entrenador\nNo quería el HUEVO, así que\nMe quedé con él.",
  ["TEXT_S18_7237"] = "no tienes\nespacio para eso.",
  ["TEXT_S19_4032"] = "{PLAYER}, usted\n¿Lo sabías?\fescuché eso\nRADIO TOWER fue tomada por TEAM\nCOHETE.\fPero que es\nal EQUIPO ROCKET?",
  ["TEXT_S1A_40B2"] = "Luché limpiamente y con\nhonor.\fno me arrepiento\nde nada.",
  ["TEXT_S1A_414A"] = "conseguiré más\nPOKéMON allí en el monte.",
  ["TEXT_S1A_417B"] = "…\fPerdi de olhos\nfechados…",
  ["TEXT_S1A_41EC"] = "Fuerza en\nconvicción…eres fuerte\nporque cree en su POKéMON.",
  ["TEXT_S1A_4238"] = "ROTA 11",
  ["TEXT_S1A_42A2"] = "cuando tomas\nun nuevo POKéMON, es débil.\fPero con el tiempo\nél se volverá fuerte.\f├ë importante\ntrata a los POKéMON con cariño.",
  ["TEXT_S1A_4323"] = "POKÉMON puede\ncontener elementos como POCIÓN y ANTÍDOTO Pero parece que no\nSaber usar artículos hechos por\ngente.",
  ["TEXT_S1A_4473"] = "Soy FALKNER, líder\ndel GIMNASIO POKEMON DE VIOLET!\fdicen que puede\ncortarle las alas a los POKEMON voladores\ncon una descarga eléctrica… no permitiré\n¡Qué insulto a los pájaros POKéMON!\fte mostraré el\nverdadero poder de lo magnífico\n¡Pájaros POKEMON!",
  ["TEXT_S1A_454A"] = "…Droga! As aves\nqueridas do meu\vpai…\fTudo bem.\nPegue isto.\f├ë a ZEPHYRBADGE\noficial da LIGA\vPOKéMON.",
  ["TEXT_S1A_45AF"] = "{PLAYER} recebeu\na ZEPHYRBADGE.",
  ["TEXT_S1A_45C8"] = "A ZEPHYRBADGE\naumenta o ataque\vdos seus POKéMON.\fEla também deixa\no POKéMON usar\fFLASH, se souber,\na qualquer hora.\fTome, leve isto\ntambém.",
  ["TEXT_S1A_4648"] = "Usando uma TM, o\nPOKéMON aprende\fna hora um golpe\nnovo.\fPense antes de\nagir: uma TM só\vserve uma vez.\fA TM31 tem\nMUD-SLAP.\fEla reduz a\nmira do inimigo\fenquanto causa\ndano.\fOu seja, é defesa\ne ataque ao mesmo\vtempo.",
  ["TEXT_S1A_4735"] = "Hay GIMNASIOS\nPOKéMON en las ciudades más adelante.\fdeberías probar\ntu habilidad en estos GIMNASIOS.\fentrenaré más\nfuerte para convertirse en el mayor maestro de\npájaros!",
  ["TEXT_S1A_4837"] = "el talento de\n¡FALKNER es real!\fno te sientas solo\n¡Porque me ganó!",
  ["TEXT_S1A_48C7"] = "Que vergonha,\nperder para um\vnovato…",
  ["TEXT_S1A_48F9"] = "¡Ey! no lo soy\nentrenador, pero te doy un consejo!\f¡Créeme!\nSi crees, el sueño de ser\nsucede el campeón.\f¿Lo crees?\nAsí que escucha.\fEl tipo de planta es\ndébil contra el tipo volador. No\nolvídalo.",
  ["TEXT_S1A_49C8"] = "¡Buena batalla!\nSigue así y serás CAMPEÓN\n¡en un abrir y cerrar de ojos!",
  ["TEXT_S1A_4B3B"] = "¡EARL soy yo!\fmaravilloso\nSon POKéMON, ¡sí!\n¡Te enseñaré que lo haré!\f¿Qué quieres?\n¿sabes? ¿Quieres ser ganador?",
  ["TEXT_S1A_4BBD"] = "Bom! Ensinar\neu vou!\fEm batalha, o\nPOKéMON do topo\vda lista sai!\fMude a ordem\nna lista, fácil\va luta fica!\fMais de mim\nquer ouvir?",
  ["TEXT_S1A_4C51"] = "Então, quer saber\ncomo criar bem\vos POKéMON?",
  ["TEXT_S1A_4C7B"] = "Tá bom! Eu vou\nensinar!\fSe POKéMON entrar\nem batalha, mesmo\fpor pouco tempo,\nganha EXP.\fNo topo da lista\np├Áe o fraco.\fTroque na batalha\nrápido!\fAssim, o fraco\nPOKéMON fica\vforte!",
  ["TEXT_S1A_4D31"] = "¡Oh! estudiante inteligente\n¡tú lo eres! ¡No enseño nada más!\fbueno con pokemon\n¡Debes ser tú!",
  ["TEXT_S1A_4D80"] = "Estou anotando\na aula do\vprofessor.\fMelhor copiar\no que está no\vquadro também.",
  ["TEXT_S1A_4DDA"] = "cambié lo mejor que pude\nPOKéMON con el chico a mi lado.",
  ["TEXT_S1A_4E07"] = "¿Hay? EL POKEMON que\n¡Lo acabo de pillar sosteniendo algo!",
  ["TEXT_S1A_4E39"] = "POKéMON com uma\nBERRY se cura\vna batalha.\fOutros itens\ntambém podem ser\vsegurados…\f├ë difícil\nanotar tudo…",
  ["TEXT_S1A_4EB2"] = "O quadro fala\nsobre mudanças\fde status em\nbatalha.",
  ["TEXT_S1A_4EFE"] = "Envenenado, el\nPOKéMON pierde PS lentamente.\fel veneno\npersiste después de la batalla, y el PS\ncae al caminar.\fPara curar, use\nun ANTÍDOTO.",
  ["TEXT_S1A_4F80"] = "A paralisia\ndiminui a\vvelocidade e\vimpede\fde andar. Fica\napós a luta, use\vPARLYZ HEAL.",
  ["TEXT_S1A_4FE2"] = "Dormido, tu\nPOKéMON no puede moverse.\fpokemon durmiendo\nNo se despierta después de la batalla.\fDespiértate con un\nDESPERTAR.",
  ["TEXT_S1A_5055"] = "una quemadura\nconsume PS.\fReduce\nel ataque.\fquemar\nqueda después de la pelea.\fUtilice una CURACIÓN PARA QUEMADURAS\npara sanar.",
  ["TEXT_S1A_50CB"] = "Congelado, el\nPOKéMON no puede hacer nada.\fSe queda congelado\ndespués de la batalla.\fDescongelar con\nuna CURACIÓN DE HIELO.",
  ["TEXT_S1A_5136"] = "├ë o caderno\ndeste garoto…\fPegue POKéMON\ncom POKé BALLS.\fAté seis podem\nna sua equipe.\fContinuar lendo?",
  ["TEXT_S1A_5197"] = "Antes de POKé\nBOLA, debilita primero el objetivo.\fenvenenado o\nquemado, POKéMON es fácil de atrapar.",
  ["TEXT_S1A_5207"] = "Alguns movimentos\ncausam confusão.\fNa confusão,\no POKéMON pode\vse atacar.\fSair da batalha\ncura qualquer\vconfusão.\fContinuar lendo?",
  ["TEXT_S1A_5287"] = "¿Quién toma y usa?\nLos POKéMON en las batallas son los\nentrenadores.\fdeben irse\na GIMNASIOS y vencer a otros\nentrenadores.\fLa siguiente pagina\nestá en blanco!\fChico: E-je-je...yo no escribí\nnada más…",
  ["TEXT_S1A_53FA"] = "Ela usa os nomes\ndas suas comidas\vpreferidas.\fNos apelidos\nque ela dá aos\vPOKéMON, digo.",
  ["TEXT_S1A_545E"] = "Llamo a mi PIDGEY\npor FRESA!",
  ["TEXT_S1A_547C"] = "STRAWBERRY:Pijji!",
  ["TEXT_S1A_5555"] = "{PLAYER}, ¿cuánto?\ntiempo.\fPROF.ELM preguntó\npara poder encontrarte.\fel tiene otro\npor favor pregunte.\f¿Tomarías el\n¿HUEVO POKEMON?",
  ["TEXT_S1A_55C5"] = "descubrimos que\nUn POKEMON no nace hasta que\ncrecer en EGG.\fel tambien tiene\nestar con otros POKéMON.\f {PLAYER}, usted\nEs el único en quien confiamos.\fLlame al PROF.\n¡ELM cuando el HUEVO choca!",
  ["TEXT_S1A_5693"] = "Oh, no. tu\nNo puedes tomar más POKéMON.\fesperaré\nmientras haces espacio.",
  ["TEXT_S1A_56F2"] = "P-pero… PROF.ELM\npreguntó por ti...",
  ["TEXT_S1A_5712"] = "{PLAYER}, usted\n¿Tomas el HUEVO?",
  ["TEXT_S1A_5809"] = "Um cara chamado\nBILL fez o sistema\vde POKéMON do PC.",
  ["TEXT_S1A_583C"] = "Foi há mais ou\nmenos três anos.\fA TEAM ROCKET\nfazia maldades\vcom POKéMON.\fMas a justiça\nvenceu: um garoto\vacabou com eles.",
  ["TEXT_S1A_58B8"] = "POKÉMON son\ninteligente.\fno obedecer\nun entrenador al que no respetan.\nSin las INSIGNIAS DE GIMNASIO adecuadas, simplemente\nactúan como quieren.",
  ["TEXT_S1A_5997"] = "POKEMON cambió\ncrece rápido.\fPero sin el GYM\nINSIGNIA cierto, ellos pueden\ndesobedecerte.",
  ["TEXT_S1A_5A36"] = "RUÍNAS DE ALPH\fUm Turismo de\nVer e Tocar\fTente os painéis\nde pedra!",
  ["TEXT_S1A_5A81"] = "Está estudando\nas RUÍNAS?\fVejo um cientista\nem formação.",
  ["TEXT_S1A_5ABD"] = "Há desenhos\nnas pedras.\fTentei mover\neles. Será que\vsão o quê?",
  ["TEXT_S1A_5B83"] = "Este es un gran\nlugar de pesca.\f¿Viste gente?\n¿pesca? ¿Y tú?\f¿Quieres uno de\nmis VARILLAS?",
  ["TEXT_S1A_5BE8"] = "Je, eso es bueno\nescucha esto.\fahora lo eres\npescador también!",
  ["TEXT_S1A_5C1B"] = "¡La pesca es genial!\fSi hay agua,\nya sea en el mar o en un arroyo,\nuse su VARILLA.",
  ["TEXT_S1A_5C6C"] = "Oh. Que\ndecepção…",
  ["TEXT_S1A_5C8D"] = "Oye, chico. como\n¿Están mordiendo?",
  ["TEXT_S1A_5CAC"] = "¿Qué debería dar?\na mi POKéMON?\fTal vez un artículo\naumenta tu ATAQUE...",
  ["TEXT_S1A_5DDD"] = "¡Oye, muchacho!\n¿Puedes hacerme un favor?\fpuedes tomar esto\n¿POKéMON con CORREO a mi amigo?\fPor la RUTA 31.",
  ["TEXT_S1A_5E48"] = "¿Vas a ir? ¡Perfecto!\n¡Gracias muchacho!\fmi amigo es\nun gordito que solo duerme la siesta.\flo harás\nfácil de reconocer!",
  ["TEXT_S1A_5EB8"] = "{PLAYER} recebeu\nPOKéMON com MAIL.",
  ["TEXT_S1A_5ED6"] = "Puedes leer,\n¡pero no te lo pierdas!\v¡RUTA 31!\fOh sí. tenia\nun árbol extraño en el camino. ¿Será\n¿Qué se llevaron?",
  ["TEXT_S1A_5F56"] = "no puedo tomar\notro pokémon...",
  ["TEXT_S1A_5F74"] = "Oh… Deixa pra\nlá…",
  ["TEXT_S1A_5F8B"] = "¡Gracias muchacho! tu\n¡Me lo entregó!\ftoma algo\npor la ayuda!",
  ["TEXT_S1A_5FD9"] = "mi amigo era\ndurmiendo la siesta, ¿verdad?\v¿Qué dije?",
  ["TEXT_S1A_600A"] = "un arbol\nUn extraño bloquea el camino.\nElla se mueve si hablas.\nDicen que se volvió loca\ncon BOTELLA DE SQUIRT.",
  ["TEXT_S1A_609A"] = "Gosto do POKéMON\nLullaby que toca\vno rádio.",
  ["TEXT_S1A_60CB"] = "Eu fico pensando\nquantos tipos de\fPOKéMON existem\nno mundo.\fHá três anos,\no PROF.OAK disse\fque existiam 150\ntipos diferentes.",
  ["TEXT_S1A_62EB"] = "Hoy es {RAM:D099}.\nEn otras palabras, hay una Competencia de Caza.\na los insectos hoy.\flas reglas son\nsencillo.\fUsando uno de\ntu POKéMON, atrapa un POKéMON\ninsecto para juzgar.\f¿Quieres intentarlo?",
  ["TEXT_S1A_639D"] = "Aquí están los\nPARK BALLS para el Concurso.",
  ["TEXT_S1A_63C7"] = "{PLAYER} recebeu\n20 PARK BALLS.",
  ["TEXT_S1A_63E2"] = "¿Quién toma el\nEl insecto más fuerte gana el juego.\ftienes 20\nminutos.\fsi te quedas sin\nBOLAS DE PARQUE, eso es todo.\fpuedes quedarte\nEl último insecto que atrapas.\fVe allí y consíguelo\nel insecto más fuerte que\npuede!",
  ["TEXT_S1A_64C6"] = "Ih... tienes más de\nun POKÉMON.\ftendrás que usar\n {RAM:D099}, el primer POKéMON\nde tu equipo.\festa bien\npara ti?",
  ["TEXT_S1A_6537"] = "Certo, seguramos\nseus outros\vPOKéMON.",
  ["TEXT_S1A_656B"] = "POKéMON de\n{PLAYER} ficaram\vcom o HELPER.",
  ["TEXT_S1A_6597"] = "Escolha o\nPOKéMON que vai\fusar no Contest,\ne vem me ver.",
  ["TEXT_S1A_65DC"] = "Certo. Esperamos\nque participe\vno futuro.",
  ["TEXT_S1A_6608"] = "Ups... El primer POKéMON del equipo\nno puedo pelear.\fIntercambiar con\nPOKéMON que quieras usar, y ven\nverme.",
  ["TEXT_S1A_667C"] = "Ups…\nTu equipo y PC BOX son\nlleno.\fno hay espacio\npara detener el insecto que atrapas.\fhacer un espacio\nen el equipo o en el PC BOX y\nven a verme.",
  ["TEXT_S1A_671F"] = "Ups…\n¿Tienes un HUEVO como primera vez?\nPOKéMON inicial.\fIntercambiar con\nPOKéMON que quieras usar,\ny ven a verme.",
  ["TEXT_S1A_679A"] = "aun falta\n {RAM:D099} minuto(s).\fquiero terminar\nahora?",
  ["TEXT_S1A_67DB"] = "Certo. Espere no\nPortão Norte\fpelo anúncio\ndos vencedores.",
  ["TEXT_S1A_6823"] = "Bien. Vuelve\nsalir y terminar.",
  ["TEXT_S1A_684F"] = "El concurso\nHoy se acabó.\fEsperamos que\nparticipar más tarde.",
  ["TEXT_S1A_6894"] = "Fazemos Concursos\nno PARK toda\fhora. Deveria\ntentar.",
  ["TEXT_S1A_68D8"] = "Quando é o\npróximo Concurso\vde Insetos?",
  ["TEXT_S1A_690E"] = "El concurso\nLa captura de insectos se realiza en\nMartes, jueves y sábado.\nNo sólo recibirás un premio por venir,\ncomo también puedes tener un\nInsecto POKéMON.",
  ["TEXT_S1A_6A20"] = "no preguntes\n¿quién haría algo así?\v¿Y por qué?",
  ["TEXT_S1A_6A5B"] = "¿Viste eso?\n¿Árbol extraño en el camino?\fEsto puede explicar\n¿Por qué visitan menos personas?\nlas RUINAS.",
  ["TEXT_S1A_6DD5"] = "Hoy es {RAM:D099}.\nEn otras palabras, hay una Competencia de Caza.\na los insectos hoy.\flas reglas son\nsencillo.\fUsando uno de\ntu POKéMON, atrapa un POKéMON\ninsecto para juzgar.\f¿Quieres intentarlo?",
  ["TEXT_S1A_6E87"] = "Aquí están los\nPARK BALLS para el Concurso.",
  ["TEXT_S1A_6EB1"] = "{PLAYER} recebeu\n20 PARK BALLS.",
  ["TEXT_S1A_6ECC"] = "¿Quién toma el\nEl insecto más fuerte gana el juego.\ftienes 20\nminutos.\fsi te quedas sin\nBOLAS DE PARQUE, eso es todo.\fpuedes quedarte\nEl último insecto que atrapas.\fVe allí y consíguelo\nel insecto más fuerte que\npuede!",
  ["TEXT_S1A_6FB0"] = "Ih... tienes más de\nun POKÉMON.\ftendrás que usar\n {RAM:D099}, el primer POKéMON\nde tu equipo.\festa bien\npara ti?",
  ["TEXT_S1A_7021"] = "Certo, seguramos\nseus outros\vPOKéMON.",
  ["TEXT_S1A_7055"] = "POKéMON de\n{PLAYER} ficaram\vcom o HELPER.",
  ["TEXT_S1A_7081"] = "Escolha o\nPOKéMON que vai\fusar no Contest,\ne vem me ver.",
  ["TEXT_S1A_70C6"] = "Certo. Esperamos\nque participe\vno futuro.",
  ["TEXT_S1A_70F2"] = "Ups... El primer POKéMON del equipo\nno puedo pelear.\fIntercambiar con\nPOKéMON que quieras usar, y ven\nverme.",
  ["TEXT_S1A_7166"] = "Ups…\nTu equipo y PC BOX son\nlleno.\fno hay espacio\npara detener el insecto que atrapas.\fhacer un espacio\nen el equipo o en el PC BOX y\nven a verme.",
  ["TEXT_S1A_7209"] = "Ups…\n¿Tienes un HUEVO como primera vez?\nPOKéMON inicial.\fIntercambiar con\nPOKéMON que quieras usar,\ny ven a verme.",
  ["TEXT_S1A_7284"] = "aun falta\n {RAM:D099} minuto(s).\fquiero terminar\nahora?",
  ["TEXT_S1A_72C5"] = "OK. Por favor\nespere aqui pelo\fanuncio dos\nvencedores.",
  ["TEXT_S1A_7300"] = "OK. Volte lá fora\ne termine\vo que falta.",
  ["TEXT_S1A_732B"] = "El concurso\nHoy se acabó.\fEsperamos que\nparticipar más tarde.",
  ["TEXT_S1A_7370"] = "Alguns POKéMON só\npodem ser vistos\vno PARQUE.",
  ["TEXT_S1A_7399"] = "DON: Vaya, tú\nganó. Eres muy bueno.",
  ["TEXT_S1A_73C4"] = "DON: La suerte tiene un\nmucha influencia.\fnunca se sabe\nqué POKéMON aparecerá.",
  ["TEXT_S1A_740F"] = "ED: Te invito.\nEsta vez no lo logré.",
  ["TEXT_S1A_7440"] = "ED: Quizás tú\nganar con POKéMON",
  ["TEXT_S1A_7462"] = "NIC: ¡Muy bien!\nCriaré mejor a mis POKéMON.",
  ["TEXT_S1A_7496"] = "NIC: Quizás tú\ngana más puntos más grande con un\nPOKéMON poco comunes.",
  ["TEXT_S1A_74DA"] = "GUILLERMO: Tú y\nel ganador? ¿Qué capturaste?",
  ["TEXT_S1A_750A"] = "WILLIAM: Estou\nsatisfeito porque\fpeguei o POKéMON\nque eu queria.",
  ["TEXT_S1A_754E"] = "BENNY: ¡Felicitaciones!\n¡Te has ganado mi respeto!",
  ["TEXT_S1A_757C"] = "BENNY: capturé\nun SCYTHER antes, pero no gané.",
  ["TEXT_S1A_75B0"] = "BARRY: EL POKEMON\nque capturaste… ¡e increíble!",
  ["TEXT_S1A_75DD"] = "BARRY: ├ë más\ngana si capturas uno\nInsecto POKéMON de alto nivel.\nPero creo que miran más cosas.",
  ["TEXT_S1A_764B"] = "CINDY: ¿Ganaste?\n¡Excelente!\f¿Quieres ir?\n¿Cazar insectos POKéMON conmigo?",
  ["TEXT_S1A_7698"] = "CINDY: Eu amo\nPOKéMON insetos!",
  ["TEXT_S1A_76B8"] = "JOSÉ: Yo... no.\nCreo que perdí en el concurso...",
  ["TEXT_S1A_76E9"] = "josh: escuché eso\n¡Alguien ganó con una CATERPIE!",
  ["TEXT_S1A_771B"] = "SAMUEL: Na próxima\nvou vencer.",
  ["TEXT_S1A_7740"] = "SAMUEL: Droga.\nAchei que teria\vmelhor pontuação…",
  ["TEXT_S1A_776F"] = "KIPP: Tú puedes\ndarme consejos?\fquiero estudiar\ntu estilo.",
  ["TEXT_S1A_77AF"] = "KIPP: Estudio bien,\npero esto no es suficiente para\nganar.",
  ["TEXT_S1A_7910"] = "Ups... Tu PAQUETE\nEstá lleno.\fMantendremos tu\npremio, pero sólo por hoy.\fLibera espacio,\nluego regresa.",
  ["TEXT_S1A_797F"] = "¿{PLAYER}?\faqui esta el premio\nque éramos para ti.",
  ["TEXT_S1B_40C8"] = "A KANTO POKéMON\nFEDERATION nunca\vvai cair!",
  ["TEXT_S1B_4143"] = "Arrasado por um\nmoleque de JOHTO…",
  ["TEXT_S1B_41A3"] = "intentemos no\nmolestar a nadie de ahora en adelante",
  ["TEXT_S1B_4219"] = "A força dos ímãs\né impressionante!",
  ["TEXT_S1B_427E"] = "As GYM BADGES dão\nvantagem nas\vbatalhas.",
  ["TEXT_S1B_42AA"] = "Está trancado…",
  ["TEXT_S1B_42B7"] = "O cartaz rasgado…\fImpossível\nler…",
  ["TEXT_S1B_446B"] = "Arrgh… ¿pensaste\nla escalera secreta...",
  ["TEXT_S1B_4494"] = "Jejeje! oh\nEl experimento funcionó a las mil maravillas.\fMAGIKARP no valen\nnada mas que GYARADOS dan mucho\ndinero.",
  ["TEXT_S1B_4501"] = "Urrgh…\fOs POKéMON dragão\ndele são fortes…",
  ["TEXT_S1B_452A"] = "LANCE: DRAGONITE,\nHYPER BEAM.",
  ["TEXT_S1B_4549"] = "Por que demorou,\n{PLAYER}?\fComo eu pensei, o\nsinal de rádio\festranho vem\ndaqui.",
  ["TEXT_S1B_459E"] = "A escada está\nbem aqui.",
  ["TEXT_S1B_45BA"] = "LANCE: {PLAYER},\nvamos nos separar\fpara vasculhar.\nEu vou primeiro.",
  ["TEXT_S1B_4B12"] = "Ei!\nInvasor ├á vista!",
  ["TEXT_S1B_4B28"] = "Droga… Eu falhei…",
  ["TEXT_S1B_4B39"] = "¡Mi turno!\n¡No hay salida!",
  ["TEXT_S1B_4B59"] = "Hay cámaras en el\nEstatuas de POKEMON.\fvamos a aparecer\nhasta encontrar un botón secreto.",
  ["TEXT_S1B_4C16"] = "Él está bien. lo haré\ncontar un secreto desde su escondite.\fque en el suelo hay\nen la parte delantera hay un panel de salto. Si lo pisas,\nserá enviado de regreso a\nentrada.",
  ["TEXT_S1B_4D1B"] = "Ni siquiera se donde\nlas trampas son.\ftendrás que\nreúne coraje y camina.",
  ["TEXT_S1B_4D7C"] = "├ë una estatua de\nPERSA… Sus ojos son\nmuy brillante.",
  ["TEXT_S1B_4DAD"] = "Um botão secreto!\nMelhor apertar.",
  ["TEXT_S1B_4DD0"] = "O botão está\ndesligado.",
  ["TEXT_S1B_52AD"] = "Pare bem\naí!",
  ["TEXT_S1B_52C3"] = "No podemos tener uno\nmocoso como tú corriendo por ahí.\fes malo para el\norgulloso del TEAM ROCKET, ya sabes.\fNo importa lo fuerte\nQuiero decir, no puedes enfrentarnos a los dos.\nal mismo tiempo.\fLo siento, cariño.\nPrepárate para ser derrotado.",
  ["TEXT_S1B_538C"] = "¡Ey! no seas tan\negoísta. Comparte la diversión.",
  ["TEXT_S1B_53BD"] = "¿Qué? Tuviste\n¿un cómplice?\fdonde esta el tuyo\nsentido del honor?\fcomo jefe\ninterino en lugar de GIOVANNI,\nmuestra que error es cometer\ncon EQUIPO COHETE",
  ["TEXT_S1B_545C"] = "Tch, eres fuerte\nlo mismo.\fQué vergüenza.\fSi ingresaste\nen TEAM ROCKET, podría convertirme en un\nEJECUTIVO.",
  ["TEXT_S1B_54C6"] = "…Este escondite\nSe ha ido... Pero está bien.\nEl experimento de transmisión fue un completo éxito.\fya no importa\n¿Qué pasa con este lugar?\ftenemos planes bien\nmás grande.\fte encontraras\nel verdadero poder del EQUIPO\nCOHETE próximamente.\fdisfruta mientras\npuede... Fufufufu...",
  ["TEXT_S1B_55D8"] = "LANCE: ├ë eso es todo.\nDerrotamos a todos los ROCKETS aquí.\fpero yo soy\npreocupado por el chico con el que peleé\nen camino...",
  ["TEXT_S1B_564E"] = "Lo sentimos, {PLAYER} \nVi lo bien que lo estabas haciendo, así que simplemente\nMe quedé fuera.\fAhora todo lo que queda es\nuna cosa: apaga eso\nseñal de radio.",
  ["TEXT_S1B_56CF"] = "├ë esta máquina\nque está causando todo el problema.\fno veo ninguno\nbotón en él... No tenemos otra opción.\nVamos a tener que acabar con todos.\nELECTRODO.\fEsto debería prevenir\nla máquina para transmitir eso\nseñal extraña.\fPOKéMON no tiene\nculpa, así que eso me deja con\nremordimiento.\f {PLAYER}, vamos\ndividir la tarea.",
  ["TEXT_S1B_57EA"] = "LANCE: Deixe este\nlado comigo.",
  ["TEXT_S1B_5809"] = "LANZA: Ese\nLa extraña señal finalmente se detuvo.\fEL LAGO debe ser\nnormalidad de nuevo.\f¡Tú eres el héroe!\nMuchas gracias en nombre de todos.\nel POKÉMON.\fOh sí. tu\nDebería tomar esto.\fLo encontré aquí, pero\nNo lo uso.",
  ["TEXT_S1B_58F8"] = "├ë el WHIRLPOOL.\nEnséñeselo a un POKéMON y críalo\naguas turbulentas.\fpero recuerda\nde una cosa.\fSólo se puede utilizar\nfuera de batalla con la INSIGNIA de\nGIMNASIO DE CAOBA.",
  ["TEXT_S1B_5994"] = "{PLAYER}… El camino hacia\nconvertirse en MAESTRO POKEMON es largo y\ndifícil.\fSabiendo esto,\n¿Lo seguirás?\f…\fEntiendo. no, tu\ntienes razón.\fsi te rendiste\nasí de fácil, nunca lo hubiera hecho\npersiguiendo este sueño\nempezar.\fEspero verte\n¡otra vez!",
  ["TEXT_S1B_5A97"] = "LANZA: ¿Lo eres?\n¿Bueno?\fTus POKéMON son\nherido.\fToma, dale un poco\nde mi medicina para ellos.",
  ["TEXT_S1B_5AF7"] = "LANCE: {PLAYER},\nvamos dar o nosso\vmelhor por eles.",
  ["TEXT_S1B_5B88"] = "Je, solo soy uno\ngruñido.\fno se el\ncontraseña. Tu mala suerte.",
  ["TEXT_S1B_5C1A"] = "Eu apanhei de uma\ncriança na última\vmissão também.\fQuando a gente\nestava roubando\fPOKéMON, um garoto\nruivo de olhar\fmau me\narrasou…",
  ["TEXT_S1B_5CD1"] = "Je, solo el jefe\nSabe la contraseña de esa puerta.\f¿Dónde está el jefe?\nCualquier cosa. Ve a buscar por ti mismo.",
  ["TEXT_S1B_5D39"] = "A porta fechou…\fPrecisa de senha\npara abrir.",
  ["TEXT_S1B_5D6B"] = "A porta fechou…\f{PLAYER} digitou\na senha.\fA porta abriu!",
  ["TEXT_S1B_5DA7"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_S1B_5E03"] = "El transmisor\nla radio finalmente se detuvo\ntransmisión maligna.",
  ["TEXT_S1B_6179"] = "LANZA: Necesidad\ndos contraseñas para entrar a la habitación\ndel jefe.\fsolo unos pocos\nROCKETS conoce estas contraseñas.\fEse COHETE de ahí\ntuvo la amabilidad de decírmelo.\f {PLAYER}, vamos\nbuscar contraseñas.",
  ["TEXT_S1B_6235"] = "Urrggh… O cara\nde capa é\vforte demais…",
  ["TEXT_S1B_6267"] = "...yo no dije eso\niba a destruir el EQUIPO\n¿COHETE?\f…Dime, ¿quién fue?\nel tipo de la capa que usaba POKéMON\ndragón?\fMis POKéMON no\neran un partido.\fno me importa tener\nperdido. Le gané con POKEMON\nmás fuerte.\flo que me molesta\nEso es lo que dijo, dijo que yo.\nNo amo y no confío lo suficiente\nen mi POKéMON.\festoy furioso con\nperdido ante un buen tipo.\f…¡Humf! no tengo\n¡Es hora de gente como tú!",
  ["TEXT_S1B_6400"] = "¿Qué? quien eres tu\nEsta es la habitación de nuestro líder,\nGIOVANNI.\fdesde que termino\ncon TEAM ROCKET durante tres años, él\nes entrenamiento.\fPero estamos seguros\nque algún día regresará a\nhacerse cargo de nuevo.\fPor eso somos\nen guardia.\fno lo dejaré\n¡Que nadie se meta con este lugar!",
  ["TEXT_S1B_6511"] = "Yo... no pude\nno hacer nada… GIOVANNI, por\npor favor perdóname...",
  ["TEXT_S1B_6548"] = "No, no puedo\ndeja que me sacuda. necesito\navisar a los demás...",
  ["TEXT_S1B_6585"] = "MURKROW: A senha\né…\fSALVE GIOVANNI.",
  ["TEXT_S1B_6611"] = "la contraseña de la sala\nEl nombre del jefe es SLOWPOKETAIL.\fPero no sirve de nada\nsi no tiene ambas contraseñas.",
  ["TEXT_S1B_6737"] = "Ruarrr-rarr-rarr!\fA senha da sala\ndo chefe…\fAhn…, eu acho que\né RATICATE TAIL.",
  ["TEXT_S1B_6822"] = "una señal de radio\neso vuelve loco a POKéMON… Mi experimento es\nun éxito total.\fmi ascenso\nestá garantizado.\fEsta derrota no\nno significa nada.",
  ["TEXT_S1B_690A"] = "Si aumentamos la\nintensidad de la señal de radio para\nTransmitir lejos... Sólo estoy pensando en ello ahora.\nanimame!",
  ["TEXT_S1B_6970"] = "A porta fechou…\fPrecisa de duas\nsenhas para abrir",
  ["TEXT_S1B_69A3"] = "A porta fechou…\f{PLAYER} digitou\nas duas senhas.\fA porta abriu!",
  ["TEXT_S1B_6F5C"] = "Oh, hombre... mi\nEl jefe se pondrá furioso... EL FARFETCH'D que\nutiliza CUT en los árboles para\nel carbón huyó.\fNo es posible para mi\nBúscalo aquí en ILEX FOREST.\f├ë grande, oscuro\ny aterrador...",
  ["TEXT_S1B_7019"] = "¡Nuestro! muy\n¡Muchas gracias!\fmi pokemon\nEl jefe no me obedece porque no tengo INSIGNIA.",
  ["TEXT_S1B_706F"] = "├ë o POKéMON que\nsumiu!",
  ["TEXT_S1B_7086"] = "FARFETCH'D: Kwaa!",
  ["TEXT_S1B_7099"] = "¡Oh! ¡EL FARFETCH'D!\f¿Lo encontraste?\n¿Para nosotros, muchacho?\fSin él, nosotros\nNo podría usar CUT para\nhacer carbón.\f¡Gracias muchacho!\f¿Cómo puedo\ngracias… ¡lo sé! Toma,\nquédate con esto.",
  ["TEXT_S1B_7141"] = "├ë el HM de CUT.\nEnseñarle un POKéMON a\ncortar árboles.\fPor supuesto, tu\nNecesito una INSIGNIA DE GIMNASIO\nAZALEA al uso.",
  ["TEXT_S1B_71C0"] = "¿Quieres ser mío?\naprendiz de carbón\nconmigo?\fEn diez años tu\n¡Serás un as!",
  ["TEXT_S1B_721B"] = "¿Qué debo hacer?\fsacudo los arboles\ncon CABEZAZO.\f├ë divertido. Pruebe\n¡tú también!",
  ["TEXT_S1B_726D"] = "Sacuda as árvores\ncom HEADBUTT. ├Çs\vvezes cai um\vPOKéMON dormindo.",
  ["TEXT_S1B_72AF"] = "Será que algo\naconteceu com o\vguardião da\vfloresta?",
  ["TEXT_S1B_72DE"] = "ILEX BOSQUE tiene\ntantos árboles que no puedes ver\nel cielo.\fMantén un ojo en\nobjetos que puedan haberse caído.",
  ["TEXT_S1B_7358"] = "SANTUÁRIO da ILEX\nFOREST…\f├ë em honra ao\nprotetor da\vfloresta…",
  ["TEXT_S1B_7394"] = "SANTUÁRIO DA\nILEX FOREST…\f├ë em honra ao\nprotetor da\vfloresta…\fOh? O que é isto?\f├ë um buraco.\nParece que a GS\vBALL caberia\vdentro dele.\fQuer colocar a GS\nBALL aqui?",
  ["TEXT_S1B_7571"] = "Um POKéMON que eu\nnunca vi\fcaiu da árvore\nquando usei\vHEADBUTT.\fDevia usar\nHEADBUTT em\voutros lugares\vtambém.",
  ["TEXT_S1C_4157"] = "este lago es\nlleno de GYARADOS y nada más… Entonces el MAGIKARP\nse ven obligados a evolucionar...",
  ["TEXT_S1C_41B4"] = "viniste aquí\n¿por los rumores?\f¿Eres {PLAYER}?\nSoy LANCE, un entrenador igualitario.\fescuché algunos rumores\ny vine aquí a investigar… vi el camino\npeleaste, {PLAYER}.\fPuedes ver eso\neres todo un entrenador\nhabilidad.\fSi no te importa,\n¿Quieres ayudarme a investigar?",
  ["TEXT_S1C_42C6"] = "LANZA: ¡Excelente!\fParece que lo son\nforzando el MAGIKARP de LAKE\npara evolucionar.\funa transmisión de\nradio misteriosa proveniente de CAOBA\nes la causa.\fte espero,\n {PLAYER}.",
  ["TEXT_S1C_4371"] = "Ah... bueno, si\nCambia de opinión, ayúdame.",
  ["TEXT_S1C_43A5"] = "LANZA: ¿Hmm? tu\n¿me ayudarás?",
  ["TEXT_S1C_43CB"] = "GYARADOS: Gyasha!",
  ["TEXT_S1C_43DF"] = "{PLAYER} conseguiu\numa RED SCALE.",
  ["TEXT_S1C_43F8"] = "Los GYARADOS son\nfurioso!\f├ë ¡mal augurio!",
  ["TEXT_S1C_4421"] = "¡Jaja! El MAGIKARP\n¡Están mordiendo!",
  ["TEXT_S1C_4444"] = "Ouvi que este lago\nfoi feito por\vGYARADOS em fúria\fSerá que tem\nalguma ligação\fcom esse surto\ntodo de agora?",
  ["TEXT_S1C_44BB"] = "mis ojos\nengañado? Vi un GYARADOS\nrojo en el LAGO… Pero pensé que\nLos GYARADOS eran azules, ¿no?",
  ["TEXT_S1C_458F"] = "no pierdo como\npescador! Pesco POKéMON todos los días.",
  ["TEXT_S1C_4611"] = "¿Por qué no lo entiendo?\n¿buenos POKEMON?",
  ["TEXT_S1C_469C"] = "POKéMON e o dono\nficam fortes\fcom batalha\nconstante.",
  ["TEXT_S1C_4752"] = "Pensando bem,\nvi um BUTTERFREE\vrosa.",
  ["TEXT_S1C_4784"] = "WESLEY: Hola, ¿cómo\n¿Vas a ir?\fya que hoy es\nMiércoles, soy WESLEY de\ncuarto.",
  ["TEXT_S1C_47DD"] = "Prazer em te\nconhecer. Aceite\vuma lembrança.",
  ["TEXT_S1C_480B"] = "WESLEY: BLACKBELT\naumenta a força\vde golpes lutador",
  ["TEXT_S1C_4844"] = "WESLEY: Si yo\nLo encontré, debes haber conocido mi\nhermanos y hermanas.\f¿O fue simplemente\n¿Tienes suerte?",
  ["TEXT_S1C_48A9"] = "WESLEY: Hoy no.\nEs miércoles.\vQué vergüenza.",
  ["TEXT_S1C_48D7"] = "LAKE OF RAGE,\ntambém chamado de\vGYARADOS LAKE.",
  ["TEXT_S1C_4903"] = "CASA DO\nFISHING GURU",
  ["TEXT_S1C_49EF"] = "Bem-vindo ├á LOJA\nDE DEPARTAMENTOS\vCELADON!\fO índice está\nna parede.",
  ["TEXT_S1C_4A35"] = "Esta TIENDA es de\nmisma red que GOLDENROD.\nAmbos fueron renovados en el\nal mismo tiempo, juntos.",
  ["TEXT_S1C_4AA9"] = "├ë mi primera\ntiempo aquí.\f├ë tan grande… tengo miedo de\nperder.",
  ["TEXT_S1C_4AEA"] = "1┬║ PLANTA: RECEPCIÓN\nY SERVICIOS 2┬║ PLANTA: MERCADO\nDEL ENTRENADOR 3┬║: TIENDA TM 4┬║: REGALOS 5┬║: FARMACIA 6┬║: MAQUINARIA. DESDE\nVENTAS",
  ["TEXT_S1C_4BC9"] = "me convertí\nentrenador animado por\nmi hijo.\festoy impresionado\ncon la selección de artículos prácticos.",
  ["TEXT_S1C_4C3E"] = "mi padre esta teniendo\ntrabajar para memorizar los nombres\nde los artículos y cómo deben ser\nusado...",
  ["TEXT_S1C_4C9C"] = "Produtos ótimos\npara treinadores!\f2┬║ ANDAR: MERCADO\nDO TREINADOR",
  ["TEXT_S1C_4D53"] = "no puedo\ndecide en qué POKéMON usar esto\nMT…",
  ["TEXT_S1C_4D86"] = "Opa! Negociei meu\nPOKéMON sem tirar\fo UPGRADE que o\nPOKéMON tinha.",
  ["TEXT_S1C_4DC7"] = "Enfim consegui um\nPORYGON!\fSou péssimo nas\nmáquinas, nunca\fjuntaria moedas\npara trocar…\f…Hã?\fO PORYGON trocado\nvirou outro\vPOKéMON!",
  ["TEXT_S1C_4E61"] = "TM TIENDA vende\nmovimientos raros.",
  ["TEXT_S1C_4E85"] = "3┬║ ANDAR: LOJA\fDE TM! Deixe seu\nPOKéMON forte!",
  ["TEXT_S1C_4F21"] = "vine a comprar uno\nCORREO DE SURF a mi novia.",
  ["TEXT_S1C_4F55"] = "Este es el único\nlugar donde compras un ENCANTADOR\nCORREO.",
  ["TEXT_S1C_4F8C"] = "Dê seu recado\ncom PRESENTES!\f4┬║: PRESENTES",
  ["TEXT_S1C_5023"] = "quiero comprar\nelementos que elevan el estatus de la\nPOKéMON, pero no tengo dinero...",
  ["TEXT_S1C_5072"] = "quiero un PP UP,\naumentar el PP de los golpes, pero\nno puedo comprar",
  ["TEXT_S1C_50B6"] = "Usar itens neles\ndeixa o POKéMON\vfeliz.\fEles odeiam alguns\nitens, porém…",
  ["TEXT_S1C_5100"] = "5┬║ ANDAR FARMÁCIA",
  ["TEXT_S1C_5250"] = "Uma máquina de\nvendas! O menu:",
  ["TEXT_S1C_528E"] = "Opa, dinheiro\ninsuficiente…",
  ["TEXT_S1C_52A7"] = "No hay más espacio\npor las cosas...",
  ["TEXT_S1C_52C7"] = "una maquina\nventas con ruleta de premios… Ya no lo ves\ncomo estos hoy.",
  ["TEXT_S1C_5310"] = "¡Ah! no hay juegos\n¡aquí!\fquería jugar...",
  ["TEXT_S1C_533E"] = "6┬║ ANDAR: PRA├çA DO\nTELHADO: VENDAS",
  ["TEXT_S1C_5416"] = "Mi POKéMON yo\nHazme compañía, nunca siento\nsolo.\fHasta maullido\ntrae dinero.",
  ["TEXT_S1C_54AB"] = "SUÍTE DO GERENTE\nDA MANSÃO CELADON",
  ["TEXT_S1C_5539"] = "{PLAYER} encendió el\nordenador personal.\f… Alguien estaba en el\nforma de escribir un correo electrónico.\f…espero\nvisita KANTO.\fte sorprenderas\ncon tantas cosas, tantas cosas\ncambiado aquí.\fTambién verás\nvarios POKéMON que no existen\nen JOHTO.\fAl PRODUCTOR…",
  ["TEXT_S1C_562C"] = "GAME FREAK\nSALA DE ENCONTROS",
  ["TEXT_S1C_56CE"] = "¡Así es!\fSOY EL DISEÑADOR\ndel JUEGO!\fCompleta tu\nPOKéDEX es difícil, ¡pero no te rindas!",
  ["TEXT_S1C_5725"] = "¡Guau! ¡Excelente!\n¡Has completado tu POKéDEX!\f¡Felicidades!",
  ["TEXT_S1C_5763"] = "EL ARTISTA GRÁFICO\nimprimirá un DIPLOMA para usted.\fDebe mostrarlo por\nallí.",
  ["TEXT_S1C_57B4"] = "Sou o ARTISTA\nGRÁFICO.\fEu te desenhei!",
  ["TEXT_S1C_57D8"] = "YO SOY EL ARTISTA\nGRÁFICO.\fOh, completaste tu\n¿POKéDEX?\f¿Puedo imprimir?\ntu DIPLOMA?",
  ["TEXT_S1C_5830"] = "Me avise se quiser\nimprimir o\vDIPLOMA.",
  ["TEXT_S1C_5895"] = "Quem, eu? Sou o\nPROGRAMADOR.\fJogue nas máquinas\ncaça-níqueis!",
  ["TEXT_S1C_58CA"] = "As G├èMEAS são\nadoráveis!\fJASMINE também\né bonita.\fAh, eu as adoro!",
  ["TEXT_S1C_590B"] = "GAME FREAK\nSALA DE PRODU├çÃO",
  ["TEXT_S1C_5928"] = "├ë um desenho\ndetalhado de uma\vmoça bonita.",
  ["TEXT_S1C_5952"] = "├ë o programa do\njogo. Mexer nele\fpode causar um bug\nno jogo!",
  ["TEXT_S1C_5996"] = "Está cheio de\nmateriais de\vreferência e até\vum POKé DOLL.",
  ["TEXT_S1C_5A3F"] = "Lugares altos--eu\nadoro eles!\fAcho que a única\ncoisa que ama\faltura tanto\nquanto eu\vé a fumaça!",
  ["TEXT_S1C_5AA1"] = "Tem um grafite\nna parede…\f{PLAYER} desenhou\num bigode!",
  ["TEXT_S1C_5B27"] = "Deixe-me contar\nalgo terrível…",
  ["TEXT_S1C_5B4A"] = "Por supuesto, no es eso\nMiedo mientras todavía hay\nluz del día.\fVuelve después\npuesta de sol, ¿vale?",
  ["TEXT_S1C_5BA3"] = "Érase una vez\nun niño que ganó un\nBICICLETA nueva… quería probarla\nal mismo tiempo… se divirtió mucho\nque ni siquiera se dio cuenta que el sol había\nsi publico... Volviendo a casa\nen la noche oscura, y la BICICLETA\nse detuvo repentinamente Los pedales se detuvieron\npesado!\fcuando se detuvo\npedaleando, BICICLETA era\n¡retirado!\fComo si fuera\nmaldijo y quiso llevárselo\n¡al abismo!\f… …¡SHRIEEEEEK!\fel chico estaba\nsubiendo por la CARRETERA CICLISMO…\n¡Pum-pum-pum!\fpara escuchar\n¡Con paciencia, quédate con TM03!",
  ["TEXT_S1C_5DB3"] = "O TM03 é CURSE.\f├ë um golpe que\ndrena o PS da\fvítima aos\npoucos.",
  ["TEXT_S1C_5E70"] = "ERIKA es una maestra en\nPOKéMON tipo Planta. ella lo hará\nhacerte pagar si te equivocas.",
  ["TEXT_S1C_5EC1"] = "el escondite\nde EQUIPE ROCKET está en el sótano de\nCASA DE JUEGO.\fAh, espera. esto\nFue hace tres años.",
  ["TEXT_S1C_5F22"] = "EUSINE: Oi!\fEstou de volta\nvisitando minha\vcidade natal.\fFaz um bom tempo.",
  ["TEXT_S1C_61D0"] = "¡Bienvenido!\fpuedes intercambiar\ntus monedas para premios increíbles\nen la casa de al lado.",
  ["TEXT_S1C_6215"] = "As caça-níqueis\nsão todas de\vúltima geração.",
  ["TEXT_S1C_6242"] = "├ë esta máquina\nque quiero.\fella me limpió\nayer, entonces deberías pagar\nhoy.",
  ["TEXT_S1C_6295"] = "Acho que esta\nmáquina vai pagar\vagora…\fAs chances variam\nentre máquinas.",
  ["TEXT_S1C_62DC"] = "¡Jajajaja!\fLas monedas no\ndeja de irte!\f¿Hay? quiero jugar,\nchico?\fyo compartiré el mio\nsuerte contigo!",
  ["TEXT_S1C_6345"] = "Hahahaha!\f├ë bom fazer\ncoisas boas para\fas outras\npessoas!",
  ["TEXT_S1C_638A"] = "Oye, no tienes\nun CAJA DE MONEDAS.\f¿Cómo te daré?\nmonedas si no tienes una?",
  ["TEXT_S1C_63D9"] = "Oye, tu MONEDA\nEL CASO está lleno.\fdebes ser\ntambién en una racha de suerte.",
  ["TEXT_S1C_6425"] = "¡Ey! Futuro\n¡CAMPEÓN!\fTambién juega en\nmáquinas tragamonedas?\flo estoy intentando\nRecoge monedas para conseguir un premio POKéMON. pero\nAún no lo tengo...",
  ["TEXT_S1C_64AD"] = "Hmm… As chances\nsão melhores na\ffila do PIKACHU,\n…o que fazer?",
  ["TEXT_S1C_64F3"] = "¡Ey!\fdetrás de esto\np├┤ster… ¡No hay nada!",
  ["TEXT_S1C_6521"] = "¡Ey!\fdetrás de esto\np├┤ster… ¡No hay nada!",
  ["TEXT_S1C_654F"] = "Há um isqueiro\naqui.",
  ["TEXT_S1C_6567"] = "una lata de\nrefresco... Alguien debe estar\nvolviendo… ¿Eh? ¡Está vacío!",
  ["TEXT_S1C_68B8"] = "Queria um MR.MIME\nmas me faltaram\v100 moedas…",
  ["TEXT_S1C_68E9"] = "Uf... necesito quedarme\ntranquilo y frio... no puedo perder\nCálmate o pierdo el dinero...",
  ["TEXT_S1C_693E"] = "Bem-vindo!\fTrocamos suas\nmoedas por\vprêmios incríveis",
  ["TEXT_S1C_6974"] = "¿Qué premio tienes?\nquieres?",
  ["TEXT_S1C_69AD"] = "Aqui está!",
  ["TEXT_S1C_69BB"] = "no tienes\nmonedas para eso...",
  ["TEXT_S1C_69D8"] = "no tienes\nespacio para esto.",
  ["TEXT_S1C_69F2"] = "Oh. Volte com\nmais moedas!",
  ["TEXT_S1C_6A14"] = "¿Oh? no tienes\nel CAJA DE MONEDAS.",
  ["TEXT_S1C_6B28"] = "ERIKA: Hola...\nQue lindo momento, ¿eh?\n├ë tan tranquilo... puedo incluso\nsiesta… Mi nombre es ERIKA.\nSoy el LÍDER de GINÁSIO CELADON.\f…¿Oh? tu viniste\nde JOHTO?\vBien... Ah. Lo siento, no\nMe di cuenta de que me querías\ndesafío.\fMuy bueno, pero\nNo perderé.",
  ["TEXT_S1C_6C3E"] = "ÉRICA: ¡Ah!\nAdmito la derrota… Realmente eres\nfuerte... te daré la\nINSIGNIA ARCO IRIS...",
  ["TEXT_S1C_6C96"] = "{PLAYER} recebeu\na RAINBOWBADGE.",
  ["TEXT_S1C_6CB0"] = "ERIKA: Foi uma\npartida adorável.\fMe senti\ninspirada.\vFique com este\fTM.\f├ë GIGA DRAIN.\n├ë um golpe que\fdrena metade do\ndano causado,\vcurando seu\fPOKéMON. Se\nquiser, use…",
  ["TEXT_S1C_6D8F"] = "ERIKA: Perder\ndeixa um gosto\vamargo…\fMas saber que\nhá treinadores\ffortes me espole\na melhorar…",
  ["TEXT_S1C_6E30"] = "acabo de ir\ndescuidado, eso es todo!",
  ["TEXT_S1C_6E8E"] = "mira todo\nsus INSIGNIAS.\fNo es de extrañar que\n¡No gané!",
  ["TEXT_S1C_6F01"] = "Como faço para\nficar elegante\vcomo a ERIKA?",
  ["TEXT_S1C_6F70"] = "ERIKA vai se\nvingar por nós!",
  ["TEXT_S1C_6FC0"] = "ERIKA es muy,\n¡mucho más fuerte!",
  ["TEXT_S1C_70DE"] = "¡Ey!\festamos haciendo\nun concurso de comida. No\npodemos acomodar.",
  ["TEXT_S1C_7129"] = "…Nhac, nhac…",
  ["TEXT_S1C_713A"] = "¡No me hables!\fte romperas\nconcentración!",
  ["TEXT_S1C_716A"] = "…Glup… Glup…",
  ["TEXT_S1C_7178"] = "quiero cantidad\n¡antes que la calidad! me quedo\nfeliz cuando como",
  ["TEXT_S1C_71AE"] = "Nhac, nhac…",
  ["TEXT_S1C_71BD"] = "A comida é boa\naqui, mas a de\vGOLDENROD é a\vmelhor de todas.",
  ["TEXT_S1C_7201"] = "Nhac… nhac…",
  ["TEXT_S1C_7212"] = "Ninguém aqui vai\nte dar uma COIN\fCASE. Procure em\nJOHTO.",
  ["TEXT_S1C_7254"] = "Nhac… Nhac… todavía puedo comer",
  ["TEXT_S1C_7278"] = "Manda mais, CHEF!",
  ["TEXT_S1C_7285"] = "Competição de\ncomilança! Sem\flimite de tempo!\nbatalha sem fim!\fO maior comedor\nleva tudo grátis!",
  ["TEXT_S1C_72E7"] = "{PLAYER} achou\n{RAM:D099}!",
  ["TEXT_S1C_72F7"] = "Pero {PLAYER} no\npuede que sea necesario más",
  ["TEXT_S1C_7379"] = "Si bajas a\nCARRETERA CICLISMO, pararás\nen CIUDAD FUCSIA.",
  ["TEXT_S1C_7408"] = "LA CARRETERA CICLISMO\ncomienza aquí. ├ë todo cuesta abajo\na continuación, ¡y muy emocionante!\fun sentimiento\neso solo se siente en un barco\no tren.",
  ["TEXT_S1C_7496"] = "¡Ey! ¡Detener!\fno puedes ir\npara CICLISMO EN CARRETERA sin\nBICICLETA.",
  ["TEXT_S1C_752C"] = "¿Sabías acerca de\n¿accidente en la CENTRAL ELÉCTRICA?\fEstá al este,\ncerca de LA CIUDAD LAVANDA.",
  ["TEXT_S1C_7592"] = "tomo mi trabajo\nGUARDIA de verdad ¡Oye! ¿Tienes un\nPOKéDEX.\fBien. tu puedes\npase.",
  ["TEXT_S1C_762C"] = "CYCLING ROAD\na subida começa",
  ["TEXT_S1C_764D"] = "¡Esperar! tu no\n¿Tienes una BICICLETA?\fLA CARRETERA CICLISMO\nQuédate aquí.\fnecesitas\nBICICLETA para ir",
  ["TEXT_S1D_4008"] = "Montón de DIGLETT\nsaltó del suelo!\fEso fue\nimpactante!",
  ["TEXT_S1D_4105"] = "…… …… …… Ha pasado un tiempo, eh,\n {PLAYER}.\f…Desde que perdí\npor ti pensé en lo que faltaba\na mi POKéMON… Y llegamos a\nuna respuesta.\f {PLAYER}, ahora\n¡Te lo mostraremos!",
  ["TEXT_S1D_419D"] = "…… …… …… Pensé que mi\nPOKéMON fueron los mejores\npodría ser... ...Pero aún así\nno fue suficiente...",
  ["TEXT_S1D_41FA"] = "…… …… …… …Ganaste, así que\nmanera justa.\fLo admito. Pero esto\nNo es el final.\fme convertiré en el\nEl mejor entrenador POKéMON.\fporque estos chicos\nestán conmigo.\f…Escucha, {PLAYER}.\fUn día de estos, voy a\ndemostrar lo bueno que soy\nvenciéndote.",
  ["TEXT_S1D_42E0"] = "…… …… …… Pagué mi\ndeuda contigo.\fCon mi POKéMON,\nDerrotaré al CAMPEÓN y\nconvertirse en el mejor del mundo.",
  ["TEXT_S1D_455F"] = "Espera un minuto.\f…enfrentará el\n¿Reto LIGA POKéMON?\f…no me obligues\nreír.\feres mucho mas\nmás débil que yo.\fno soy como\nantes.\fAhora tengo el\nPOKéMON mejores y más fuertes.\n¡Soy invencible!\f {PLAYER} !\n¡Te reto!",
  ["TEXT_S1D_463D"] = "…no gané…di todo lo que tenía\ntenía… ¿Qué tienes,\ny lo que me falta… empiezo a entender\n¿Qué hizo ese dragón maestro?\nme dijo...",
  ["TEXT_S1D_46CE"] = "…no me rendí\npara convertirme en el mejor entrenador... lo descubriré\n¿Por qué no puedo ganar?\ny ser más fuerte... Cuando lo descubras,\nTe desafío.\fY te derrotaré\ncon todas mis fuerzas.\f…¡Humf! Continuar\nhasta entonces.",
  ["TEXT_S1D_47AA"] = "…¡Humf!\fAl final de\nDespués de todo, nada supera a la fuerza.\fno necesito\nnada más.",
  ["TEXT_S1D_4A55"] = "Vamos partir logo.\nPor favor, suba\va bordo.",
  ["TEXT_S1D_4A80"] = "Lo siento. no puede\npara abordar.",
  ["TEXT_S1D_4A9C"] = "Bem-vindo ao FAST\nSHIP S.S.AQUA.\fVai embarcar\nhoje?",
  ["TEXT_S1D_4ADA"] = "¿Puedo ver el tuyo?\n¿BOLETO S.S.?",
  ["TEXT_S1D_4AF6"] = "Esperamos vê-lo\nnovamente!",
  ["TEXT_S1D_4B11"] = "{PLAYER} mostró\nel S.S.TICKET.\f├ë eso es todo.\n¡Gracias!",
  ["TEXT_S1D_4B41"] = "{PLAYER} probado\nmuestra el S.S. TICKET… …¡Pero no lo hay!\f¡Lo siento!\nSólo podrán embarcar aquellos que tengan uno.\nS.S.BILLETE.",
  ["TEXT_S1D_4BA8"] = "O FAST SHIP vai\nzarpar segunda.",
  ["TEXT_S1D_4BCE"] = "O FAST SHIP zarpa\nna sexta que vem.",
  ["TEXT_S1D_4BF4"] = "SHELLDER es fácil\npara llegar aquí.\fen otros lugares\nEs algo raro.",
  ["TEXT_S1D_4C35"] = "cuantas varillas tienes\ntienes?\fdiferentes ruedas\natrapa diferentes POKéMON.",
  ["TEXT_S1D_4C76"] = "O S.S.AQUA usa\njatos e desliza\vsobre as ondas!",
  ["TEXT_S1D_4CA2"] = "Tem um monte de\nPOKéMON em KANTO.\fQueria poder ir…",
  ["TEXT_S1D_4CD7"] = "no queremos\nte caes al mar, entonces no puedes\nentrar.",
  ["TEXT_S1D_4F06"] = "Vamos partir logo.\nPor favor, suba\va bordo.",
  ["TEXT_S1D_4F31"] = "Lo siento. no puede\npara abordar.",
  ["TEXT_S1D_4F4D"] = "Bem-vindo ao FAST\nSHIP S.S.AQUA.\fVai embarcar\nhoje?",
  ["TEXT_S1D_4F8B"] = "¿Puedo ver el tuyo?\n¿BOLETO S.S.?",
  ["TEXT_S1D_4FA7"] = "Esperamos vê-lo\nnovamente!",
  ["TEXT_S1D_4FC2"] = "{PLAYER} mostró\nel S.S.TICKET.\f├ë eso es todo.\n¡Gracias!",
  ["TEXT_S1D_4FF2"] = "{PLAYER} probado\nmuestra el S.S. TICKET… …¡Pero no lo hay!\f¡Lo siento!\nSólo podrán embarcar aquellos que tengan uno.\nS.S.BILLETE.",
  ["TEXT_S1D_5059"] = "O FAST SHIP zarpa\nna quarta-feira.",
  ["TEXT_S1D_5080"] = "O FAST SHIP zarpa\ndomingo que vem.",
  ["TEXT_S1D_50A6"] = "tu viniste de\nJOHTO?\fDicen que muchos\nPOKéMON raros viven allí.",
  ["TEXT_S1D_523B"] = "O FAST SHIP S.S.\nAQUA segue para\vCIDADE DE\vVERMILION.\fVamos anunciar\nassim que a gente\vchegar.",
  ["TEXT_S1D_529B"] = "O FAST SHIP S.S.\nAQUA segue para\vCIDADE DE OLIVINE.\fVamos anunciar\nassim que a gente\vchegar.",
  ["TEXT_S1D_52F9"] = "├ë tu cabaña.\fSi tu POKéMON\nestán heridos, duerman en la cama.\festo sanará\nellos.",
  ["TEXT_S1D_534F"] = "├ë tu cabaña.\ftu puedes sanar\nTu POKéMON durmiendo en la cama.\fel barco llega\nmientras estás durmiendo.",
  ["TEXT_S1D_53C0"] = "Cada pasajero\nEste es un entrenador.\festan todos locos\npara luchar en las cabañas.",
  ["TEXT_S1D_5412"] = "¡Nuestro! Lo siento.\n¡Tenía prisa!\fmi nieta es\nperdido!\fella es solo una\nniña pequeña. Si la ves por favor\n¡házmelo saber!",
  ["TEXT_S1D_548D"] = "O FAST SHIP S.S.\nAQUA chegou em\vCIDADE DE OLIVINE.",
  ["TEXT_S1D_54BE"] = "O FAST SHIP S.S.\nAQUA chegou em\vCIDADE DE\vVERMILION.",
  ["TEXT_S1D_567B"] = "entrenadores de\nJOHTO puede luchar con\nLÍDERES DE GIMNASIO KANTO.",
  ["TEXT_S1D_56F7"] = "un dia gano\n¡tú!",
  ["TEXT_S1D_574B"] = "LILY es genial,\npero MARÍA es la mejor!\n¡Quiero conocer estaciones de radio JOHTO!",
  ["TEXT_S1D_57D4"] = "Será que tem\nalguma montanha\fboa para escalar\nem KANTO?",
  ["TEXT_S1D_5812"] = "├ë, yo soy\nmarinero si.\fyo no estaba\nholgazaneando!\fEsta cabaña fue\nvacío, ¡así que solo tomé una siesta!\f¡Ah, no importa!\n¡Luchemos!",
  ["TEXT_S1D_5897"] = "Desculpe! A culpa\né toda minha!",
  ["TEXT_S1D_58B1"] = "Ser marinheiro é\ntrabalho pesado.\vServiço braçal.\v├ë exaustivo!",
  ["TEXT_S1D_5937"] = "Me rindo. hijo,\nno es necesario buscarlo. olvidar\nesto!",
  ["TEXT_S1D_5996"] = "encontré una moneda\nhermoso aquí.\fAlguien debe tener\nperdido...",
  ["TEXT_S1D_5B52"] = "Creo que el fuego es\ndébil en el mar.\f¿No hace la diferencia?\n¿Grave?",
  ["TEXT_S1D_5BD5"] = "Dá para achar um\nmonte de POKéMON\vnas árvores!",
  ["TEXT_S1D_5C43"] = "un viaje es\nLa mejor manera de superar un corazón roto.\fPero el ENVÍO RÁPIDO es\ndemasiado corto para sufrir.",
  ["TEXT_S1D_5D65"] = "Falando na RADIO\nSTATION, qual é o\fnúmero da sorte\ndesta semana?",
  ["TEXT_S1D_5DA4"] = "Uma cama macia!\nHora de dormir…",
  ["TEXT_S1D_5DC1"] = "Ah, descansado e\nrenovado!",
  ["TEXT_S1D_5DDE"] = "O FAST SHIP S.S.\nAQUA chegou em\vCIDADE DE OLIVINE.",
  ["TEXT_S1D_5E0F"] = "O FAST SHIP S.S.\nAQUA chegou em\vCIDADE DE\vVERMILION.",
  ["TEXT_S1D_6012"] = "Ufa! Obrigado por\nter vindo junto.\fEntreter aquela\nmenininha foi\vexaustivo.",
  ["TEXT_S1D_6064"] = "Gostou da viagem\nno S.S.AQUA?\fEle quase patina\npor cima das\vondas.",
  ["TEXT_S1D_60AE"] = "Hola hijo...\nNo puedo encontrar a mi nieta.\fsi ella esta en\nbarco, está bien.\fPero ¿y si ella se cayera?\nen el mar?\fella es una niña\neléctrico, por lo que puede molestar a alguien\nEstoy angustiado...",
  ["TEXT_S1D_6143"] = "{PLAYER}, ¿verdad? escuché\nque jugaste con mi nieta.\fquiero agradecer\npor eso.",
  ["TEXT_S1D_619B"] = "¡Ya lo sé! quiero eso\n¡guárdalo!",
  ["TEXT_S1D_61BE"] = "Estamos viajando\npelo mundo todo.",
  ["TEXT_S1D_61E0"] = "CAPITÁN, broma\npoco conmigo?\f¡Estoy aburrido!\n¡Quiero jugar!",
  ["TEXT_S1D_621F"] = "¡Ey! tu bromeas\nconmigo?\f…¡Oh!\fEl abuelo├┤ es\npreocupado?\f¡Tengo que irme!\fnecesito encontrar el\nabuela├┤!",
  ["TEXT_S1D_6284"] = "Vov├┤, estou aqui!\nEu brincava\fcom o CAPTAIN e\ncom este moço!",
  ["TEXT_S1D_630D"] = "me divertí mucho\nbromeando!",
  ["TEXT_S1D_635B"] = "tu viajas\n¿solo?\ftu madre no se queda\npreocupado?",
  ["TEXT_S1D_63C2"] = "El bebé es una manera\n¡Es de mala educación llamarnos chicas!",
  ["TEXT_S1D_6428"] = "├Çs vezes crianças\nsão mais espertas\vque adultos!",
  ["TEXT_S1D_6497"] = "Entendi. Dá para\nouvir a rádio de\vJOHTO no navio.",
  ["TEXT_S1D_651C"] = "necesito ir a\nSALÓN POKéMON y hazlos hermosos!",
  ["TEXT_S1D_6596"] = "¡Oh sí! tengo que\nbusca mi POKéMON en DAY-CARE!",
  ["TEXT_S1D_660F"] = "Deberías usar el\nBOLA adecuada para cada situación.",
  ["TEXT_S1D_6645"] = "O FAST SHIP S.S.\nAQUA chegou em\vCIDADE DE\vVERMILION.",
  ["TEXT_S1D_687B"] = "Oye, jovencito. puede\n¿Buscas a mi colega?\fel esta holgazaneando\n¡Ahí fuera, ese holgazán!\fquería ir tras\nsuyo, pero estoy de servicio.",
  ["TEXT_S1D_6907"] = "Ai, caramba…\fO CAPTAIN vai\nficar furioso…",
  ["TEXT_S1D_692E"] = "Valeu, moço!\nDei uma bronca\fboa nele, para\nparar de vadiar!",
  ["TEXT_S1D_696D"] = "Uma menininha?\fAcho que vi ela\npassar por aqui.",
  ["TEXT_S1D_699D"] = "O refeitório é\nlogo ├á frente.\fA escada no fim\nleva ├á cabine do\vCAPTAIN.",
  ["TEXT_S1D_6A38"] = "no creo que funcione\nganar si no lo tomo en serio",
  ["TEXT_S1D_6A99"] = "AZAFRÁN, CELADÓN…\nEscuché que hay muchas ciudades.\nlos grandes en KANTO.",
  ["TEXT_S1D_6B02"] = "Chega de navio\npara mim. Da\fpróxima vez eu vou\nde MAGNET TRAIN.",
  ["TEXT_S1D_6B7A"] = "Recebemos\npassageiros\vdiferentes\fde CIDADE DE\vVERMILION a\vCIDADE DE OLIVINE.",
  ["TEXT_S1D_6C22"] = "Pretendo pescar no\npíer de VERMILION",
  ["TEXT_S1D_6C9E"] = "no pude encontrarlo\nel REY DEL KARATE en JOHTO.\fdicen que el\ntren en alguna cueva por ahí.",
  ["TEXT_S1D_6D5F"] = "¡Ocho INSIGNIAS!\nDemuestran que superaste el\nLÍDERES.\fNo es de extrañar que\n¡eres tan bueno!",
  ["TEXT_S1D_6DE1"] = "Estamos em\nexcursão nas\vRUÍNAS perto de\vVIOLET.",
  ["TEXT_S1D_6E3D"] = "Os rádios captam\nsinais estranhos\vnas RUÍNAS.",
  ["TEXT_S1D_6EB6"] = "Li que existem\nquatro painéis de\vpedra.",
  ["TEXT_S1D_6FAF"] = "O FAST SHIP S.S.\nAQUA vai a KANTO\f├ás segundas e\nsextas.",
  ["TEXT_S1D_701D"] = "O FAST SHIP zarpa\n├ás quartas e aos\vdomingos, toda\vsemana.",
  ["TEXT_S1D_713B"] = "PLAZA MONTE LUNA\nNo tires basura",
  ["TEXT_S1D_71B3"] = "Quando o sol se\np├Áe, os CLEFAIRY\vvêm brincar.",
  ["TEXT_S1E_43D8"] = "O que aconteceu?",
  ["TEXT_S1E_4469"] = "me esfuerzo por\nser lo más destacado de mi clase.",
  ["TEXT_S1E_44D3"] = "¿Cometí un error?\nmi entrenamiento?",
  ["TEXT_S1E_44F0"] = "Talvez eu devesse\ndeixar um no\vDAYCARE. O que eu\vfaço?",
  ["TEXT_S1E_459E"] = "¡Oh, no! yo no\npuedo ganar...",
  ["TEXT_S1E_45B8"] = "tu eres fuerte\ndemasiado para ser mi pareja.",
  ["TEXT_S1E_45E4"] = "¿Quién viene ahí?\n¿Qué estás haciendo?",
  ["TEXT_S1E_4609"] = "eres un chico\nduro.",
  ["TEXT_S1E_4624"] = "├ë, no veo nada\nmal hoy.\fCompórtate y no lo hagas\ncausar problemas.",
  ["TEXT_S1E_466A"] = "Estou de ronda\natrás de gente\vsuspeita.",
  ["TEXT_S1E_46FC"] = "Mi POKEMON lo sabia\nmovimientos que ni siquiera sabía que tenía.\fEsto me confundió\n¡demasiado!",
  ["TEXT_S1E_477F"] = "IRENE: Mi hermana\n¡KATE te atrapará por esto!",
  ["TEXT_S1E_47AD"] = "IRENE: Esta playa\n¿no es genial?\f├ë nuestro refugio\nsecreto!",
  ["TEXT_S1E_4836"] = "JENN: No pienses\n¡demasiado! ¡Mi hermana KATE es una ruda!",
  ["TEXT_S1E_4866"] = "JENN: A luz do sol\ndeixa o corpo\vmais forte.",
  ["TEXT_S1E_48E2"] = "kate: eres fuerte\ndemasiado. No tuve oportunidad.\fAquí. Te lo mereces\nesto.",
  ["TEXT_S1E_492B"] = "KATE: Lamento haber\nsaltó encima.\fnunca esperamos\nque alguien nos encontrara aquí. tu\nnos asustó.",
  ["TEXT_S1E_49A8"] = "ROTA 34\fCIDADE DE\vGOLDENROD\vCIDADE DE AZALEA\fILEX FOREST Em\nalgum ponto",
  ["TEXT_S1E_49ED"] = "TRAINER TIPS\fÁrvores de BERRY\ndão BERRIES novas\vtodo dia.\fAnote que árvore\ndá qual tipo de\vBERRY.",
  ["TEXT_S1E_4A52"] = "GUARDERÍA Creamos el tuyo\n¡POKéMON para ti!",
  ["TEXT_S1E_4FB6"] = "OLMO: {PLAYER}!\n¡Finalmente!\fnecesito preguntarte\nun favor.\festoy haciendo un\nNueva investigación sobre POKéMON.\f¿Quieres\n¿Podrías ayudarme, {PLAYER}?\fYa sabes... estoy escribiendo\nun artículo para presentar en un\ncongreso.\fPero todavía hay\ncosas que no entiendo del todo.\f¡Entonces!\fte quería\ncrear un POKéMON que atrapé recientemente.",
  ["TEXT_S1E_5375"] = "Se um POKéMON\nselvagem aparecer,\vdeixe o seu lutar",
  ["TEXT_S1E_53A7"] = "OLMO: ¡Espera! ¿Adónde vas?",
  ["TEXT_S1E_53C8"] = "ELM: Vai levar o\nCYNDAQUIL, o\vPOKéMON de fogo?",
  ["TEXT_S1E_53F3"] = "ELM: ¿Quieres el\nTOTODILE, ¿el POKéMON de agua?",
  ["TEXT_S1E_541F"] = "ELM: Então gosta\nda CHIKORITA, a\vPOKéMON planta?",
  ["TEXT_S1E_544D"] = "ELM: Pense bem\ncom calma.\fSeu parceiro é\nimportante.",
  ["TEXT_S1E_5487"] = "ELM: Acho esse\num ótimo\vPOKéMON também!",
  ["TEXT_S1E_54C0"] = "MR.POKéMON mora\nperto de\vCHERRYGROVE.\fA próxima cidade.\n├ë quase direto\vdaqui.",
  ["TEXT_S1E_5581"] = "Se seu POKéMON se\nmachucar, cure\fele nesta\nmáquina.",
  ["TEXT_S1E_55DB"] = "{PLAYER}, cuento\ncontigo!",
  ["TEXT_S1E_55F3"] = "{PLAYER} anotou o\ntelefone do ELM.",
  ["TEXT_S1E_560D"] = "MR.POKéMON va a\npor todas partes y encuentra rarezas.\fLástima que sean solo\nraro y poco útil… {PLAYER}, cuento\ncontigo!",
  ["TEXT_S1E_5668"] = "Contém um POKéMON\ncapturado pelo\vPROF.ELM.",
  ["TEXT_S1E_5690"] = "Será que isto faz\no quê?",
  ["TEXT_S1E_56AA"] = "Quer curar seus\nPOKéMON?",
  ["TEXT_S1E_56CD"] = "ELM: {PLAYER}, isto\né terrível…\fAh, sim, qual foi\na descoberta do\vMR.POKéMON?",
  ["TEXT_S1E_5712"] = "{PLAYER} entregou\no OVO MISTERIOSO\vao PROF.ELM.",
  ["TEXT_S1E_5739"] = "ELM: Isto?",
  ["TEXT_S1E_5745"] = "Mas… Será um OVO\nde POKéMON?\fSe for, é um\ngrande achado!",
  ["TEXT_S1E_5780"] = "ELM: ¡¿Qué?!?\fPROF.OAK te dio\n¿Una POKéDEX?\f {PLAYER}, es verdad\n¿de verdad? ¡E-eso es increíble!\fEs genial verlo\nEl potencial de las personas como entrenadores.\fVaya, {PLAYER}. tu\nPodría tener lo necesario para dar la vuelta\nCAMPEÓN.\fparece que tu\nVa muy bien con POKéMON.\fdeberías enfrentar\nel desafío POKéMON GYM.\fEL GIMNASIO más\nCerca se encuentra CIUDAD VIOLETA.",
  ["TEXT_S1E_58CF"] = "… {PLAYER}. oh\nEl camino hacia el campeonato será\nde largo.\fAntes de partir,\nNo olvides hablar con tu madre.",
  ["TEXT_S1E_593C"] = "ELM: ¡No te rindas!\nLlamaré si sé algo sobre\nese HUEVO!",
  ["TEXT_S1E_597D"] = "OLMO: {PLAYER}?\n¿No encontraste a mi asistente?\fél te debía\nentregar el HUEVO al CENTRO POKéMON\nde CIUDAD VIOLETA.\fdebes tener\nlo perdí. Intenta encontrarlo allí.",
  ["TEXT_S1E_5A1B"] = "ELM: Ei, aquele\nOVO mudou algo?",
  ["TEXT_S1E_5A40"] = "{PLAYER}? Pensei\nque o OVO chocou.\fCadê o\nPOKéMON?",
  ["TEXT_S1E_5A72"] = "OLMO: {PLAYER}, usted\n¡es genial!",
  ["TEXT_S1E_5A8B"] = "O quê?\nAquele POKéMON!?!",
  ["TEXT_S1E_5A9F"] = "¡El HUEVO nació!\nEntonces los POKéMON nacen de HUEVOS… No, tal vez no\ntodos ellos.\fVaya, todavía hay\nMucha investigación por delante.",
  ["TEXT_S1E_5B1C"] = "¡Gracias, {PLAYER}!\nTú nos ayudas a descubrir el\nmisterios de pokemon quiero que te quedes\ncon esto como muestra de nuestro agradecimiento",
  ["TEXT_S1E_5B8D"] = "Este es un\nPIEDRA ETERNA.\fCiertas especies de\nPOKéMON evoluciona al alcanzar ciertos\nniveles.\fUN POKÉMON\ntener EVERSTONE no evoluciona.\fDáselo a un POKEMON\nque no quieres evolucionar.",
  ["TEXT_S1E_5C37"] = "ELM: {PLAYER}, eu\nligo se algo\vacontecer.",
  ["TEXT_S1E_5C65"] = "…ai… Aquele\nPOKéMON roubado.\fFico pensando como\nele está.\fDizem que POKéMON\ncriado por gente\fruim fica ruim\ntambém.",
  ["TEXT_S1E_5CD0"] = "ELM: ¡Hola, {PLAYER}!\nGracias a usted, mi investigación\nmuy bien!\fToma esto como\nsigno de mi agradecimiento.",
  ["TEXT_S1E_5D31"] = "MASTER BALL es el\n¡lo mejor de todo!\f├ë la BOLA suprema!\nCaptura cualquier POKéMON sin\nnunca falles.\fsolo se da\nReconocidos investigadores de POKéMON creen que sí\nmejor uso que yo,\n {PLAYER} !",
  ["TEXT_S1E_5DF3"] = "OLMO: {PLAYER}!\n¡Ahí estás!\fllamé porque\nTengo algo para ti.\f¿Vio? ├ë uno\nS.S.BILLETE.\fAhora puedes tomar\nPOKéMON en KANTO.",
  ["TEXT_S1E_5E6F"] = "El barco sale de\nCIUDAD OLIVINA.\fpero tu ya\n¿Sabías que {PLAYER}?\fDespués de todo, eras\na todas partes con tu POKéMON.\fenvía tus saludos\nal PROF.ROBLE!",
  ["TEXT_S1E_5F38"] = "{PLAYER}, quiero\nguarda esto para tu misión",
  ["TEXT_S1E_5F65"] = "Somos solo nosotros dos,\npor eso siempre estamos ocupados.",
  ["TEXT_S1E_5F95"] = "Hubo un ruido\nruidoso afuera... Cuando fuimos a ver,\nde aquí robaron un POKéMON.\f├ë increíble\n¡Que alguien haga esto!\f...oh... ese\nPOKéMON robado.\fsigo pensando como\nlo es.\fDicen pokemon\ncreado por gente mala se vuelve malo\ntambién.",
  ["TEXT_S1E_6078"] = "{PLAYER}!\fUse isto na sua\njornada POKéDEX!",
  ["TEXT_S1E_609A"] = "Para completar el\nPOKéDEX, tienes que atrapar POKéMON Juega POKé BALLS\nen POKéMON salvaje.",
  ["TEXT_S1E_60F0"] = "escuché que robaron\nun POKéMON aquí... estaba cosechando\ninformación con el PROF.ELM.\fAl parecer era un\njoven de largo cabello rojo… ¿Qué?\fpeleaste con un\n¿Entrenador así?\fme pasó a saber\nsu nombre?",
  ["TEXT_S1E_61C0"] = "Certo! Então\n{RIVAL} é o nome.\fObrigado por\najudar na busca!",
  ["TEXT_S1E_61FD"] = "Janela aberta.\fUma brisa gostosa\nentra por ela.",
  ["TEXT_S1E_6231"] = "Ele entrou\npor aqui!",
  ["TEXT_S1E_624C"] = "{PLAYER} abriu um\nlivro.\fDica de viagem 1:\fAperte START para\nabrir o MENU.",
  ["TEXT_S1E_628A"] = "{PLAYER} abriu um\nlivro.\fDica de viagem 2:\fRegistre a viagem\ncom SAVE!",
  ["TEXT_S1E_62C6"] = "{PLAYER} abriu um\nlivro.\fDica de viagem 3:\fAbra a BOLSA e\naperte SELECT para\vmover itens.",
  ["TEXT_S1E_6315"] = "{PLAYER} abrió un\nlibro.\fConsejo de viaje 4: observa los movimientos\nde POKÉMON. Utilice el botón A para\ncambiar de lugar.",
  ["TEXT_S1E_6370"] = "El embalaje de\nmerienda que PROF.\vELM comió está ahí",
  ["TEXT_S1E_63A6"] = "OBSERVA├ç├òES SOBRE\nEVOLU├çÃO POKéMON\f…Está escrito\nna tela…",
  ["TEXT_S1E_6604"] = "¡Ah, {PLAYER}! Nuestro\nvecino, PROF.\fELM, era\nbuscándote.\fdijo que quería\npara que hagas algo por él.\f¡Oh! ¡Casi lo olvido!\nTu EQUIPO POKéMON ha vuelto de\nreparación.\f¡Aquí lo tienes!",
  ["TEXT_S1E_66BD"] = "EQUIPO POKEMON, o\nsólo POKéGEAR.\f├ë esencial si\nQuieres ser un buen entrenador.\fAh, necesito ajustarme\nel día de la semana.\fno puedo olvidar\nde eso!",
  ["TEXT_S1E_6742"] = "Estamos no horário\nde verão agora?",
  ["TEXT_S1E_6763"] = "Vuelve a casa\npara ajustar el reloj a la hora correcta\ndel verano.\fPor cierto, tu\n¿Sabes utilizar el TELÉFONO?",
  ["TEXT_S1E_67CB"] = "No se trata sólo de llamar\nPOKéGEAR y elige el icono\ndesde el TELÉFONO?",
  ["TEXT_S1E_6807"] = "Vou ler as\ninstruç├Áes.\fLigue a POKéGEAR e\nescolha o ícone\vdo TELEFONE.",
  ["TEXT_S1E_6850"] = "los numeros se quedan\nguardado en la memoria ├ë simplemente elija el\nnombre para llamar.\f¡Qué práctico!\n¿no es así?",
  ["TEXT_S1E_68B5"] = "PROF.ELM es\nesperando por ti.\f¡Date prisa, cariño!",
  ["TEXT_S1E_68E5"] = "Entonces, ¿qué fue?\n¿La misión del ELM?\f…Eso parece\nincluso un desafío.\fPero siéntete orgulloso de\nque la gente cuente contigo.",
  ["TEXT_S1E_6957"] = "{PLAYER}, ¡adelante!\festoy contigo\n¡hasta el final!",
  ["TEXT_S1E_697D"] = "Bom dia,\n{PLAYER}!\fEstou de visita!",
  ["TEXT_S1E_6A3A"] = "Prato da mamãe!\fHAMB├ÜRGUER VULCÃO\nDE CINNABAR!",
  ["TEXT_S1E_6A64"] = "A pia está\nimpecável. A mamãe\vgosta dela limpa.",
  ["TEXT_S1E_6A91"] = "Vamos ver o que há\nna geladeira…\fFRESH WATER e uma\nboa LEMONADE!",
  ["TEXT_S1E_6AD0"] = "Passa um filme na\nTV: estrelas no\fcéu e dois\nmeninos no trem…\f├ë melhor eu ir\nandando também!",
  ["TEXT_S1E_6C24"] = "POKEMON HABLAR HACER\nPROF.ROBLE! ¡No te pierdas el próximo!",
  ["TEXT_S1E_6C55"] = "CANAL POKéMON!",
  ["TEXT_S1E_6C64"] = "Aqui é a DJ MARY,\nsua parceira!",
  ["TEXT_S1E_6C84"] = "POKéMON!\nCANAL POKéMON…",
  ["TEXT_S1E_6D2F"] = "PIKACHU é um\nPOKéMON evoluído.\fFiquei espantado\ncom as descobertas\vdo PROF.ELM.\fEle é bem famoso\npela pesquisa da\vevolução.\f…suspiro…\fEu queria poder\nser pesquisador\vcomo ele…",
  ["TEXT_S1E_6DD4"] = "mi hija es\ndecidido a convertirse\nasistente del PROF. OLMO.\fella lo ama demasiado\n¡POKÉMON!\f¡A mí también me encanta!",
  ["TEXT_S1E_6E3B"] = "POKEMON HABLAR HACER\nPROF.ROBLE! ¡No te pierdas el próximo!",
  ["TEXT_S1E_6E6C"] = "CANAL POKéMON!",
  ["TEXT_S1E_6E7B"] = "Aqui é a DJ MARY,\nsua parceira!",
  ["TEXT_S1E_6E9B"] = "POKéMON!\nCANAL POKéMON…",
  ["TEXT_S1E_6EF7"] = "Oi, {PLAYER}! Meu\nmarido vive tão\focupado, e espero\nque ele fique bem\fQuando mergulha na\npesquisa POKéMON,\fele até esquece\nde comer.",
  ["TEXT_S1E_6F6B"] = "Quando eu crescer,\nvou ajudar o meu\vpai!\fVou ser um grande\nprofessor\vPOKéMON!",
  ["TEXT_S1E_701B"] = "POKÉMON. De donde\n¿vienen?\fdonde estan\n¿van?\fpor que nadie\n¿Alguna vez has visto nacer un POKéMON?\f¡Quiero saber! lo haré\ndedicar su vida al estudio de\n¡POKÉMON!\f…Es parte de\nArtículos de investigación de ELM.",
  ["TEXT_S1E_714D"] = "Tus POKéMON son\nun poco cansado.\f├ë Es bueno dejarles\ndescansar.",
  ["TEXT_S1E_718B"] = "¡Listo!\fTus POKéMON son\ncon buena cara!\f¡Avanza!",
  ["TEXT_S1E_71F9"] = "Tem uma coisa\nescrita aqui.\fLer?",
  ["TEXT_S1E_7222"] = "A mis hermanos y\nhermanas: Estamos orgullosos de\natender a los entrenadores POKéMON.\fcuando el entrenador\nHabla contigo, dale algo útil.\fCon amor,\nMÓNICA ¿Continuar leyendo?",
  ["TEXT_S1E_72B9"] = "Segunda, MONICA\nROTA 40\fTerça, TUSCANY\nROTA 29\fQuarta, WESLEY\nLAKE OF RAGE\fQuinta, ARTHUR\nROTA 36\fSexta, FRIEDA\nROTA 32\fSábado, SANTOS\nCIDADE DE\vBLACKTHORN\fDomingo, SUNNY\nROTA 37",
  ["TEXT_S1E_73C6"] = "¿A dónde vas?\ncon POKÉMON?\f¿LIGA POKEMON?\fTus POKéMON son\n¿Lo suficientemente leal como para ganar?\fDéjeme ver...",
  ["TEXT_S1E_742B"] = "¡Oh! Tu POKEMON\nconfía mucho en ti.\f├ë es bueno ver uno\nbuen entrenador.\fTómalo. un regalo\npara el viaje.",
  ["TEXT_S1E_751F"] = "Si no pasa\npara confiar más en ti, tal vez\ndifícil de seguir.\fLa confianza es el vínculo\nque une a POKéMON y entrenadores.",
  ["TEXT_S1E_75C1"] = "no puedo subir\nbarranco.\fPero puedes saltar\ndesde arriba de ellos y corta el camino.",
  ["TEXT_S1E_760D"] = "Diferentes tipos\nde POKéMON aparecen después de aquí.\fSi quieres tomar\ntodos ellos, hay que buscarlos\nen todas partes.",
  ["TEXT_S1F_4005"] = "LIGA POKéMON\fVICTORY ROAD\nENTRADA",
  ["TEXT_S1F_436C"] = "Acho que tenho que\nfazer as coisas\vdireito…",
  ["TEXT_S1F_4410"] = "conozco el\nventajas tipográficas.\fPero solo uso uno\ntipo de POKÉMON.",
  ["TEXT_S1F_4498"] = "Tu POKéMON\nMe gustas más si das uno.\nTrato el pelaje.",
  ["TEXT_S1F_452F"] = "Está fazendo uma\nPOKéDEX? Aqui vai\vuma dica boa.\fO HIKER da ROTA\n33, o ANTHONY, é\vgente boa.\fEle te liga se vir\nalgum POKéMON\vraro.",
  ["TEXT_S1F_45B0"] = "Porta trancada…",
  ["TEXT_S1F_45C3"] = "Porta aberta.",
  ["TEXT_S1F_45D6"] = "A CHAVE DO PORAO\nabriu a porta.",
  ["TEXT_S1F_45F9"] = "¡Bienvenido!\fyo manejo el\n¡SALÓN POKEMON!\fsoy el mayor y\nmejor de los dos HAIRCUT BROTHERS.\f¿Puedo dejar tu\nLindos POKéMON por sólo R$ 500.\fme gustaria\nde esto?",
  ["TEXT_S1F_469A"] = "Qual POKéMON\ndevo arrumar?",
  ["TEXT_S1F_46B8"] = "Certo! Observe\nficar bonito!",
  ["TEXT_S1F_46D8"] = "Pronto! Feito!",
  ["TEXT_S1F_46EA"] = "¿Y eso es todo?\n¡Qué vergüenza!",
  ["TEXT_S1F_4709"] = "necesitas\nmás dinero.",
  ["TEXT_S1F_472B"] = "solo hago uno\ncorte por día.\vHe terminado.",
  ["TEXT_S1F_475C"] = "Bem-vindo ao\nPOKéMON SALON!\fSou o mais jovem\ne menos caro\vdos dois IRTOS\vCABELEIREIROS.\fVou arrumar seu\nPOKéMON por\vapenas R$300.\fComo vai?",
  ["TEXT_S1F_47F1"] = "Certo, qual\nPOKéMON?",
  ["TEXT_S1F_480E"] = "Certo! Vou\ndeixar legal!",
  ["TEXT_S1F_482A"] = "Pronto!\nTudo feito!",
  ["TEXT_S1F_4842"] = "¿No?\n¡Qué vergüenza!",
  ["TEXT_S1F_485B"] = "eres un poco\nsin dinero.",
  ["TEXT_S1F_487B"] = "Faco apenas um\ncorte por dia.\fDesculpe, mas já\nacabei.",
  ["TEXT_S1F_4904"] = "no lo somos\nabierto hoy.",
  ["TEXT_S1F_491A"] = "NO ENTRAR\nMÁS ALLÁ DE ESTE PUNTO",
  ["TEXT_S1F_4E9D"] = "¡Espera un minuto!\fte vi entonces\nTe seguí.\fno necesito\nTe interpones en el camino mientras yo cuido\ndel EQUIPO ROCKET.\f…Espera un minuto.\nMe ganaste antes, ¿no?\fEso fue\nsolo suerte.\fpero pago\nmis deudas!",
  ["TEXT_S1F_4F5D"] = "…Por qué…\n¿Por qué pierdo?\fReuní los POKéMON\nmás fuerte.\fno alivió\nen ritmo.\f¿Por qué pierdo?",
  ["TEXT_S1F_4FC2"] = "…No entiendo… ├ë es verdad lo que\n¿LANCE dijo?\fque no trato bien\n¿EL POKEMON?\fAmor… Confianza… Son exactamente lo que me hace\ndesaparecido?\f¿Lo haré?\nprevenir?\fYo... simplemente no lo hago\nLo entiendo.\fPero no lo hará\ntermina aquí.\fAhora no. no para\nesto.\fno me rendiré\nel sueño de ser el mejor\n¡Maestro POKÉMON!",
  ["TEXT_S1F_5102"] = "Mmm. Este es el\nmi verdadero poder.\fterminaré\nal EQUIPO ROCKET.\fy lo haré\naplastar la LANZA bajo mis pies.",
  ["TEXT_S1F_5176"] = "Fui desafiado\npara uma batalha\vlá embaixo.\f├ë perigoso\nlá. Melhor\vtomar cuidado.",
  ["TEXT_S1F_51D0"] = "Há lojas\nlá embaixo…\fMas também\nhá treinadores.\fTenho medo\nde descer.",
  ["TEXT_S1F_5290"] = "Eu também estou\nconfuso… O botão\fda ponta é o que\nse aperta antes…",
  ["TEXT_S1F_5347"] = "Bien. ¡Un consejo!\fCambiar el orden en\nque presionas.\fcambia la forma\nque las contraventanas se abran y cierren.",
  ["TEXT_S1F_53CF"] = "Roubar e vender!\n├ë o básico do\vcrime, colega!",
  ["TEXT_S1F_545B"] = "SUBTERRÁNEO\n¿ALMACÉN?\f¿Para qué quieres?\nir allí?\fno hay nada ahí\nabajo.",
  ["TEXT_S1F_551F"] = "tienes sangre\nde hielo al pecho del ROCKET.",
  ["TEXT_S1F_5554"] = "Está escrito\nSWITCH 1.",
  ["TEXT_S1F_55E6"] = "Ve a donde tu\nquiero! ¡Añádelo!\v¡No me importa!",
  ["TEXT_S1F_5617"] = "Está DESLIGADO.\nLigar?",
  ["TEXT_S1F_562D"] = "Está LIGADO.\nDesligar?",
  ["TEXT_S1F_5643"] = "Está escrito\nSWITCH 2.",
  ["TEXT_S1F_565A"] = "Está escrito\nSWITCH 3.",
  ["TEXT_S1F_5671"] = "Está escrito\nEMERG├èNCIA.",
  ["TEXT_S1F_57CB"] = "¡Oye chico!\n¡Nos frenas!\fNuestro esquema\nestá trabajando detrás de escena,\ndonde nadie ve!",
  ["TEXT_S1F_582C"] = "pierdo la voluntad\na trabajar si alguien me ve.\fVamos, muchacho,\n¡fuera!",
  ["TEXT_S1F_5875"] = "Oohah! Oohah!\fAs coisas no\nchão são lixo.\fLeve-as se\nquiser!",
  ["TEXT_S1F_5A48"] = "A TEAM ROCKET vai\nseguir em frente,\vesperando a volta\vdo GIOVANNI.\fFaremos o que for\npreciso.",
  ["TEXT_S1F_5B01"] = "Eu perdi…\fPor favor me\nperdoe, GIOVANNI!",
  ["TEXT_S1F_5B8E"] = "Hyuck-hyuck-hyuck!\nFoi demais!\vVou me lembrar!",
  ["TEXT_S1F_5BC6"] = "DIRECTORA: ¿Quién?\n¿Qué? ¿Viniste a rescatarme?\f¡Gracias!\f¡LA TORRE DE RADIO!\fque es\npasando ahí?\fTomado por\n¿EQUIPO COHETE?\fAquí. tomar\nla LLAVE DE LA TARJETA.",
  ["TEXT_S1F_5C5B"] = "DIRECTOR: Use-a\npara abrir as\vpersianas do 3F.",
  ["TEXT_S1F_5C8D"] = "te lo ruego\nayuda.\fno puedo saber\n¿Qué harán si controlan?\nel transmisor.\fellos pueden\nincluso controlar POKéMON con\nuna señal especial Eres el único\nen quien confío.\fPor favor guarda\nla TORRE DE RADIO… Y todo\n¡POKéMON del país!",
  ["TEXT_S1F_5EBD"] = "Hace un tiempo, un\nEl chico del karate quería pelear.\nEra demasiado bueno.\fel nosotros\nse rompió fácilmente.\fel era mas\nfondo diciendo que estaba entrenando. ¿Será\n¿Cómo está él?",
  ["TEXT_S1F_5F97"] = "vine a explorar\nMT.MORTAR, pero me separé de\nmi compañero... Encontraste un\nentrenador que utiliza un SEADRA que\n¿Conoces CASCADA?",
  ["TEXT_S1F_610E"] = "yo soy\ninvestigando MT.MORTAR, pero mi compañero desapareció.\f¿Has visto un\nentrenador que tiene un SLOWPOKE que\n¿Conoces la FORTALEZA?",
  ["TEXT_S1F_624D"] = "¡Ey!\fyo soy kárate\n¡REY!\fyo entreno solo\naquí en la oscuridad!\f¡Tú!\n¡Lucha conmigo!\f¡Hwaaarggh!",
  ["TEXT_S1F_62A9"] = "Waaaarggh!\nFui derrotado!",
  ["TEXT_S1F_62C0"] = "Estoy devastada... Mi entrenamiento\nTodavía no fue suficiente.\fPero la derrota es\nderrota. Lo admito.\fcomo prueba de\nque ganaste te doy una\nLuchador POKéMON.",
  ["TEXT_S1F_6355"] = "{PLAYER} recebeu\nTYROGUE.",
  ["TEXT_S1F_636A"] = "TYROGUE é do\ntipo lutador.\fEle evolui e\nfica mais forte.\fContinue firme\nno treino. Eu\vtambém sigo.\fAdeus!",
  ["TEXT_S1F_63DF"] = "no tienes\nespacio en el equipo!",
  ["TEXT_S1F_65AD"] = "Está cravado\nno gelo.",
  ["TEXT_S1F_66BD"] = "Ao norte de\nLAVENDER fica o\vROCK TUNNEL.\fAtravesse ele pra\nchegar na POWER\vPLANT.",
  ["TEXT_S1F_6710"] = "Hay un programa\nradio que reproduce FLAUTA POKé.\f¿Oh? tu radio\nNecesitas la TARJETA EXPN para conseguirla.",
  ["TEXT_S1F_6779"] = "Si CENTRAL ELÉCTRICA\nno funciona, el TREN MAGNETICO tampoco se mueve... Y también quiere\ndecir que ESTACION DE RADIO no transmite…",
  ["TEXT_S1F_67ED"] = "O DIRECTOR da\nRADIO STATION\vficou bem feliz.\fEle disse que\nvoltaram ao ar\fporque a POWER\nPLANT está\vrodando de novo.",
  ["TEXT_S1F_68F1"] = "El señor Fuji vive.\naquí, pero no en casa.\fEl debe estar en\nCASA DEL ALMA.",
  ["TEXT_S1F_6940"] = "Hay gente de\nCorazón frío que deja caer el POKéMON.\fv├┤ da la bienvenida a la\npersonas pobres sin hogar y los cuida con\ncariño.",
  ["TEXT_S1F_6A4D"] = "LAVENDER é uma\nvila pequena e\fquieta, no pé da\nmontanha.\fFicou um pouco\nmais movimentada\fdesde que a RADIO\nTOWER foi feita.",
  ["TEXT_S1F_6B29"] = "REPELIR es una cosa\nnecesario si vas a explorar un\ncueva.\faunque me gusta\nexplorar, todavía no he estado en todos\nlas cuevas.",
  ["TEXT_S1F_6BAC"] = "Ouvi falar de um\nartesão que\ffaz POKé BALLS sob\nmedida na cidade\fde AZALEA, em\nJOHTO. Eu queria.",
  ["TEXT_S1F_6C53"] = "SEÑOR FUJI: Hola. Mmm... parece que\ntu creas tu POKéMON con amor\ny amabilidad.\f¿Quién ama a POKEMON?\nven aquí para rendir homenaje a aquellos que\nya se han ido.\fdeja el tuyo\ncondolencias a las almas de\nPOKéMON que eran, estoy seguro\nlos hace felices.",
  ["TEXT_S1F_6D4D"] = "Hay otras tumbas\nde POKéMON aquí, creo.\ftiene muchas habitaciones\nen el que solo entra MR.FUJI.",
  ["TEXT_S1F_6DB1"] = "Eu vim com a minha\nmãe ver túmulos\vde POKéMON…",
  ["TEXT_S1F_6DDB"] = "El POKEMON que\nvivía conmigo... los amaba como\nmis nietos...",
  ["TEXT_S1F_6EBF"] = "Bem-vindo!\nFique ├á vontade\fpara olhar tudo\nneste andar.",
  ["TEXT_S1F_6EFA"] = "Lo siento, pero tu\nSólo se puede visitar la planta baja.\fdesde RADIO\nLa TORRE JOHTO fue tomada por un\npandilla, tuvimos que reforzar\nseguridad.",
  ["TEXT_S1F_6F90"] = "Mucha gente aquí\ntrabaja duro en RADIO\nTORRE.\fDeben estar dando\nlo mejor para buenos programas.",
  ["TEXT_S1F_6FFB"] = "¡Ay, no, no!\festamos fuera\naire desde la CENTRAL ELÉCTRICA\ndetenido.\fTodo el esfuerzo de\nAbrir esta radio se convierte en polvo si\nno emitido.\f¡Estoy arruinado!",
  ["TEXT_S1F_70A1"] = "¡Oh! Entonces tu eres\nel {PLAYER} que resolvió el caso\nde CENTRAL ELÉCTRICA?\fGracias a ti, yo\nNo me despidieron.\fEn serio, eres un\nsalvavidas!\fPor favor acepte\nesto como regalo.",
  ["TEXT_S1F_7141"] = "Con esta cosa,\nobtienes los programas\nRadio Kanto.\f¡Jajajajaja!",
  ["TEXT_S1F_7193"] = "¡Hola camarada!\fsoy súper\n¡DIRECTOR DE MÚSICA!\f¿Hay? Tu POKéGEAR\nNo entiendas mis programas.\n¡Qué mala suerte!\fSi toma EXPN\nTARJETA, ¿puedes oírla?\n¡Ve a buscar uno!",
  ["TEXT_S1F_7248"] = "¡Hola camarada!\fsoy súper\n¡DIRECTOR DE MÚSICA!\fsoy responsable\npor las hermosas melodías que van\nal aire.\fNo seas cuadrado.\n¡Pon tu música al aire!",
  ["TEXT_S1F_72E3"] = "1F RECEP├çÃO\n2F VENDAS\v3F PESSOAL\v4F PRODU├çÃO\v5F SALA DO\v   DIRETOR",
  ["TEXT_S1F_732D"] = "Anime seus POKéMON\ncom o som suave\fda POKé FLUTE\nno CANAL 20",
  ["TEXT_S1F_7419"] = "¿Alguna vez has estado en\n¿CIUDAD LAVANDA?\fTiene RADIO\nTORRE muy alta.",
  ["TEXT_S1F_74AF"] = "yo soy el hermano\nLo más nuevo de FISHING GURU.\fveo que tu\nle gusta pescar.\fno tengo ni lo mas minimo\n¡Dudo de eso!\f¿Y ahí? lo se\nTengo razón.",
  ["TEXT_S1F_752F"] = "Esto, esto. como\n¡Pensé!\f¡Aquí, aficionado a la pesca!\nToma esto, es una SUPER ROD.",
  ["TEXT_S1F_757C"] = "Intenta pescar en\ncualquier lugar que tenga agua.\fRecuerda, puedes\natrapa diferentes POKéMON con\nDiferentes VARILLAS.",
  ["TEXT_S1F_75EC"] = "¿Hay? mio\n¿Tus ojos cometieron un error?",
  ["TEXT_S26_40D1"] = "La torre de hojalata es\nprohibido a cualquier persona que no tenga la INSIGNIA\npor ECRUTEAK.\fLo siento, pero tu\ntengo que irme.",
  ["TEXT_S26_4131"] = "A TIN TOWER é\nproibida a quem\fsem a BADGE do\nGINÁSIO daqui.\fAh!\fA BADGE do GINÁSIO\nde ECRUTEAK! Pode\vpassar adiante.",
  ["TEXT_S26_41A4"] = "algo muy\nsucedió algo importante.\fLo siento, pero\nVoy a tener que pedirte que te vayas.\f…lo que calma\nel alma… EL TRIO SABIO dice\ncosas tan dificiles de\nentender…",
  ["TEXT_S26_4250"] = "algo muy\nsucedió algo importante.\fLo siento, pero\nVoy a tener que pedirte que te vayas.\f………… ¡Oh!\fEste sonido es de\n¡CLARA CAMPANA!\f├ë… ¡es sublime!\fNunca escuché un sonido\n¡Qué hermosa antes!\fEl sonido de esa campana\nrefleja el alma de quien lo tiene.\fTú… tal vez puedas\ncruzar la TORRE DE HOJALATA.\fPor favor sigue\nadelante.",
  ["TEXT_S26_437E"] = "Por favor, siga\nem frente.",
  ["TEXT_S26_4391"] = "El sonido de esa campana\nrefleja el alma de quien lo tiene.\fTú… tal vez puedas\ncruzar la TORRE DE HOJALATA.\fPor favor sigue\nadelante.",
  ["TEXT_S26_440B"] = "A TIN TOWER ali\n├á frente tem nove\vandares de beleza\vdivina.\fEla acalma a alma\nde todos que a\vveem.",
  ["TEXT_S26_446F"] = "A TIN TOWER\ntremeu! Um POKéMON\fdeve ter voltado\npro topo!",
  ["TEXT_S26_44AB"] = "Duas torres…\nDois POKéMON…\fMas quando uma\nqueimou, os dois\fPOKéMON voaram\ne nunca voltaram.",
  ["TEXT_S26_462B"] = "Espantoso…\fSUICUNE, ENTEI e\nRAIKOU acordaram\vdo sono deles…\fSerá que a lenda\nestá se tornando\vrealidade?",
  ["TEXT_S26_468B"] = "Entrenamos en\nTORRE QUEMADA, pero nunca escuchamos\nde un agujero que había allí antes. debe tener\nha sido hecho a propósito\npor alguien.",
  ["TEXT_S26_4712"] = "Lata de la torre de hojalata\nser visitado por quienes tengan el BADGE\npor ECRUTEAK.\fSin embargo, ahora que\nSUICUNE, RAIKOU y ENTEI\ndespierto, te lo ruego que no\n¡entra!",
  ["TEXT_S26_47AF"] = "Nós, o TRIO\nSÁBIO, somos os\fprotetores dos\nPOKéMON\vlendários.",
  ["TEXT_S26_4938"] = "Oh, entonces eres tú\nquien dice que vio a SUICUNE, ENTEI y\nRAIKOU mientras dormían?\f¡Increíble!\fCuenta la leyenda que\nno se les puede ver durmiendo…",
  ["TEXT_S26_4A35"] = "En el pasado, hubo\nAquí hay dos torres de nueve pisos.\fLA TORRE DE BRONCE,\n¿Quién dice que se despertó?\nPOKéMON y TIN TOWER, donde POKéMON\ndescansaron.\fLa vista desde arriba\nde las TORRES debe haber sido\nmagnífico.\fEn ese momento, un\nPOKéMON plateado enorme dicen\nque construyó un nido en lo alto del\nTORRE DE LATÓN.\fSin embargo… Hay alrededor de 150\naños, un rayo cayó sobre\nde TORRES.\fella fue tomada\npor llamas que duraron tres días.\funa lluvia\nDe repente el fuego se apagó.\fY así es como\nNació la TORRE QUEMADA.",
  ["TEXT_S26_4C6C"] = "Tú… ├ë o\nentrenador que POKéMON\n¿Los legendarios te esperan?",
  ["TEXT_S26_4ED8"] = "Hola, soy BILL.\n¿Y tú quién eres?\f {PLAYER}, ¿eh?\nLlegaste en buen momento.",
  ["TEXT_S26_4F22"] = "Me acabo de adaptar\nmi CÁPSULA DEL TIEMPO.\fsabes que da\npara intercambiar POKéMON verdad?\fMi CÁPSULA DEL TIEMPO\nse hizo para intercambiar con el\npasado.\fno puedo enviar\nnada que no existiera en\npasado.\fSi es así, la computadora\ndel pasado se rompería.\fEntonces es necesario\nquita todo lo que no tuviste\npasado.\fEn resumen, nada\nnuevo movimiento o nuevo POKéMON en\nCÁPSULA DEL TIEMPO.\fNo te preocupes.\nYa terminé los ajustes.\fMañana el EQUIPO\nLAS CÁPSULAS funcionarán en\nCENTROS POKEMON.\fnecesito volver a\nVARILLA DE ORO para ver a la familia.\f¡Adiós!",
  ["TEXT_S26_5155"] = "O jeito que as\nKIMONO GIRLS\fdançam é\nmaravilhoso. Igual\fao jeito que usam\nos POKéMON delas.",
  ["TEXT_S26_51AA"] = "debe ser\nQuerer luchar contra más gente, ¿verdad?\nParece que hay un lugar donde\nLos entrenadores se unen.\f¿Dónde? Pregunta\nbueno.\f├ë poco después\nde la CIUDAD DE OLIVINO.",
  ["TEXT_S26_5240"] = "MORTY, o LÍDER\ndo GINÁSIO, é tão\vlegal.\fOs POKéMON dele\nsão fortes também",
  ["TEXT_S26_5286"] = "LAKE OF RAGE…\fO aparecimento do\nbando de GYARADOS\fSinto cheiro de\nconspiração. Sei!",
  ["TEXT_S26_533D"] = "esto paso\ncuando era joven.\fEl cielo de repente\nse volvió negro. Un POKEMON gigante\nvolando cubrió el sol.\fQue pokemon\n¿lo fue?\fParecía un pájaro\ny un dragón.",
  ["TEXT_S26_53EC"] = "Será que existe um\nPOKéMON gigante?\fSe ele existe,\ndeve ser forte.",
  ["TEXT_S26_5579"] = "Eu gostei do\nduelo. Queria\vte ver de novo.",
  ["TEXT_S26_560B"] = "O ritmo é\nimportante para\fdançar e para\nPOKéMON.",
  ["TEXT_S26_5688"] = "Coloco uma flor\ndiferente no\vgrampo todo mês.",
  ["TEXT_S26_5714"] = "Entrené mucho y\nPensé que era capaz de luchar. pero\nNo lo creo.",
  ["TEXT_S26_57A8"] = "sigo bailando\nporque hay gente a la que le gusta\nlo que hago.\fmi pokemon\nanimame.",
  ["TEXT_S26_580A"] = "No sólo el KIMONO\nLAS NIÑAS también son grandes bailarinas\nSon buenos en POKéMON.\fSiempre los desafío,\npero nunca dejé ni un rasguño.\nen ellos…",
  ["TEXT_S26_5891"] = "¡Joven! si tu\nderrotar a todas las CHICAS KIMONO, yo\nTe doy un premio.",
  ["TEXT_S26_591A"] = "la forma en que tu\nLuchó, le pareció ver un baile.\ffue una rareza\n¡mira esto!\fte quiero\nquédate con esto.\v¡Sin miedo, acéptalo!",
  ["TEXT_S26_599B"] = "Isto é o SURF.\f├ë um golpe que\ndeixa POKéMON\vnadar na água.",
  ["TEXT_S26_59D5"] = "Queria que meu\nPOKéMON fosse\vtão elegante…",
  ["TEXT_S26_5A0A"] = "RHYDON: Grogoh\ngrugrooh!",
  ["TEXT_S26_5A24"] = "Aquele homem vive\ncom seu RHYDON.\fDiz que quer um\nPOKéMON que saiba\vSURF e dançar.\fSerá que ele quer\nfazer um POKéMON\vde nado\vsincronizado?",
  ["TEXT_S26_5AAA"] = "LAS CHICAS DEL KIMONO\nson tan hermosos… Pero pasan\nmediante una formación rigurosa.\fY también tienen que\naprende costumbres antes de aparecer\nen público.\fPero si amas\nalgo, todo es posible.",
  ["TEXT_S26_5B79"] = "├ë um painel chique\nque é decorado\vcom flores.",
  ["TEXT_S26_5C48"] = "Mi EEVEE se volvió\nun ESPEÓN.\fpero el de mi amigo\nEEVEE se convirtió en un UMBREON.\f¿Por qué sería? nosotros\nAmbos creamos nuestro EEVEE a partir de\nde la misma manera...",
  ["TEXT_S26_5CD5"] = "Se usar REVIVE,\num POKéMON que\fdesmaiou vai\nacordar.",
  ["TEXT_S26_5E65"] = "Me alegro de que hayas venido.\fAquí en ECRUTEAK,\nLos POKéMON siempre han sido venerados.\fDicen que uno\nPOKéMON con los colores del arcoíris\nponerse delante de un entrenador\nrealmente fuerte.\fyo creí\nen esta historia y entrené aquí en\nsecreto toda mi vida.\fPor eso hoy yo\nVeo lo que otros no ven.\fSólo un poco más... Con un poco más,\nVería un futuro donde encontraría la\nPOKéMON con los colores del arcoíris.\f¿Me ayudarás?\npara llegar a ese nivel!",
  ["TEXT_S26_600A"] = "todavía no estoy bien\nsuficiente… Está bien. esto\nLA INSIGNIA es tuya.",
  ["TEXT_S26_6043"] = "{PLAYER} recebeu\na FOGBADGE.",
  ["TEXT_S26_6059"] = "Con FOGBADGE,\nPOKéMON hasta L50 obedecerá\nusted.\fpokemon que saben\nSURF también puede utilizar el movimiento para\nen cualquier momento.\fquiero que te quedes\ncon esto también.",
  ["TEXT_S26_60EC"] = "├ë o SHADOW BALL.\nCausa dano e pode\freduzir a\nSPCL.DEF.\fUse se ele te\nagradar.",
  ["TEXT_S26_6145"] = "Ya veo... Tu viaje ha tomado\nllevarte a lugares muy lejanos.\fY tu fuiste testigo\nmuchas más cosas que yo.\fte envidio\npor eso...",
  ["TEXT_S26_6263"] = "De onde vieram\nos POKéMON?",
  ["TEXT_S26_62B7"] = "Sólo utilizamos el\nPOKEMON FANTASMA Sin ataque\n¡Lo normal puede hacerles daño!",
  ["TEXT_S26_6318"] = "Quem quiser vencer\nmais, vencerá!",
  ["TEXT_S26_638A"] = "Tudo bem. Eu vou\ncontar o segredo\fdo piso\ninvisível.\fO caminho está\nna nossa frente!",
  ["TEXT_S26_63E8"] = "los entrenadores\npor eso tienen motivos secretos.\fSi ganas,\npueden contar secretos profundos\npor ECRUTEAK.",
  ["TEXT_S26_6452"] = "Uf, {PLAYER}. tu\n¡fue genial!\fyo estaba\n¡Acurrucado en un rincón de puro terror!",
  ["TEXT_S26_649C"] = "MORTY, EL LÍDER DE\nGIMNASIO, no lo es.\fLo siento, pero\ntienes que irte.\fRohohoho.",
  ["TEXT_S26_663C"] = "Oh. estas en un\n¿Aventura con tu POKéMON?\fy cual seria\n¿Una aventura sin búsqueda del tesoro?\fT├┤ correcto o no\n¿Estoy en lo cierto?",
  ["TEXT_S26_66B5"] = "¡Excelente! tu\nentender el verdadero espíritu de\naventura.\f¡Me gustó! Luz\nesto contigo.",
  ["TEXT_S26_670E"] = "Hay muchos artículos\nesparcidos por ahí y que no están\nobvio.\fUtilice el BUSCADOR DE ARTÍCULOS\npara comprobar si hay algún objeto en el suelo\ncerca de ti.\fNo muestra el\nlugar exacto, por lo que tendrás que\nbuscar.\f¡Oh! escuché eso\nhay objetos en la TORRE QUEMADA\npor ECRUTEAK.",
  ["TEXT_S26_6805"] = "Ah… Cada um com\nseu gosto, né…",
  ["TEXT_S26_6826"] = "HISTÔRIA DE\nECRUTEAK\fQuer ler?",
  ["TEXT_S26_684C"] = "En ECRUTEAK hubo\ndos torres.\fCada torre fue\nel refugio de los POKéMON voladores.\fPero uno de ellos\nquemado hasta los cimientos.\fLos dos pokemon\nNo han sido vistos desde… ¿Continuar leyendo?",
  ["TEXT_S26_6902"] = "ECRUTEAK también\nEra el hogar de tres POKéMON que corrían.\nalrededor de la ciudad.\fDicen que nacieron\nde agua y relámpagos y\nfuego.\fPero no pudieron\ncontener su excesivo poder.\fPor eso los tres\ncorrió como el viento hacia el\ncampo.",
  ["TEXT_S26_6A7B"] = "AZUL: ¡Oye! De todos modos\nLlegó aquí, ¿verdad?\fno estaba de humor\nen CINNABAR, pero ahora estoy\nlisto para ti.\f...me estas diciendo\n¿Quién le ganó a todo el JOHTO?\f¡Hay! Entonces el\nJOHTO GYMS debe ser débil.\fOye, no te preocupes\ncon esto.\flo sabré si\n¿eres bueno o no luchando con\nusted ahora.\f¿Listo, chico?",
  ["TEXT_S26_6BAE"] = "AZUL: ¿Qué?\f¿Cómo diablos hago?\nperdido para ti?\f… Tsk, está bien…\nToma, toma esto, la EARTHBADGE.",
  ["TEXT_S26_6C0F"] = "{PLAYER} recebeu\na EARTHBADGE.",
  ["TEXT_S26_6C27"] = "AZUL: …Está bien, yo\nMe equivoqué. Realmente eres el hombre.\n├ë buen entrenador.\fpero voy a ganar\ntú un día.\fno lo olvides\nde eso!",
  ["TEXT_S26_6CAB"] = "AZUL: Escucha.\f├ë bueno, no lo haces\nperder hasta que te gane. ¿Entendiste?",
  ["TEXT_S26_6CEE"] = "Hola futuro\n¡CAMPEÓN!\f¿Cómo te va?\nParece que estás empacado.\fEL LÍDER aquí es\nun tipo que peleo con el CAMPEON lo hace\ntres años.\fNo es suave.\fda todo lo que tu\n¡tienes!",
  ["TEXT_S26_6DA0"] = "Hombre, eres fuerte\nde verdad... fue una batalla\ny tanto, aquellos que inspiran. yo lloré\nde emoción.",
  ["TEXT_S26_6E54"] = "piensas mucho\nal nombrar el\n¿Tu POKEMON?\fBuenos apodos\ndejar el intercambio con otros\nmás divertido.",
  ["TEXT_S26_6ECB"] = "São o SPEARY,\num SPEAROW, e o\vRATTEY, RATTATA.",
  ["TEXT_S26_6F7F"] = "Bienvenido ├á\nTRAINER HOUSE, el lugar más nuevo\ny de moda aquí.\facabamos de abrir\npara entrenador.\f¿Puedes enfrentar?\nlo mejor del mejor logotipo\naquí abajo.",
  ["TEXT_S26_7025"] = "VIRIDIAN es el pueblo\nmás cerca de la MESETA ÍNDIGO.\fEllos hicieron este lugar\nporque pasan muchos entrenadores\naqui subiendo a INDIGO\nMESETA.",
  ["TEXT_S26_70B5"] = "Fazem batalhas de\ntreino aqui\vembaixo.\fEu adoraria ver\no quanto um\ftreinador de JOHTO\nbatalha bem.",
  ["TEXT_S26_711D"] = "no creo que funcione\nser CAMPEÓN sin viajar por el mundo\ntodo y luchar con todo tipo\nde personas.\fEL CAMPEÓN\nPALLET viajó a todas las ciudades\ny pueblos de KANTO.",
  ["TEXT_S26_71C9"] = "Uf… estoy dando\nun descanso de las batallas.",
  ["TEXT_S26_71F4"] = "las batallas de\nel entrenamiento se lleva a cabo en la SALA DE ENTRENAMIENTO\naquí abajo.\fBuenos entrenadores\nestán invitados a participar.",
  ["TEXT_S26_725D"] = "No hay reglas ni\nReglamento en partidos de entrenamiento.\nAl igual que las batallas de campo, vale la pena.\n¡todo!",
  ["TEXT_S26_72C1"] = "…O que é isto?\nUm plano de luta?\fA letra parece\nrastro de ONIX…\fEstá totalmente\nilegível…",
  ["TEXT_S26_7420"] = "Oi. Bem-vindo ao\nTRAINING HALL.\fVocê pode batalhar\ncom um treinador\vuma vez por dia.",
  ["TEXT_S26_746A"] = "{RAM:D099} é seu\nadversário hoje.",
  ["TEXT_S26_7487"] = "quieres\nbatalla?",
  ["TEXT_S26_74A2"] = "por favor puedes\nentrar.\fahora puedes\nempezar.",
  ["TEXT_S26_74D6"] = "Lo siento. Sólo el\nLos entrenadores que van a la batalla pueden\nentrar.",
  ["TEXT_S26_751D"] = "lo siento\nseñor.\fseria el segundo\ntiempo hoy. Sólo se permite entrar\nuna vez al día.",
  ["TEXT_S26_7578"] = "Eu perdi…\nDroga…",
  ["TEXT_S26_7587"] = "viajé a\nAquí solo para luchar contra ti.",
  ["TEXT_S26_75F4"] = "O LÍDER daqui\né totalmente\vsensacional.",
  ["TEXT_S26_761A"] = "¿Alguna vez has estado en\n¿CINABAR?\f├ë una buena isla\nal sur de aquí.",
  ["TEXT_S26_76AD"] = "Onde será que está\no LÍDER DE GINÁSIO\vde VIRIDIAN?\fEu queria\ndesafiar ele.",
  ["TEXT_S26_76F5"] = "No hay ENTRENADOR\nde GYM en el GYM aquí.\fEL LÍDER dice que el\nSu política es ganar sin tener\nsubordinado.",
  ["TEXT_S26_776B"] = "Ouvi dizer que o\nGINÁSIO de\vCINNABAR sumiu.\fFico pensando no\nque foi feito do\vBLAINE, o LÍDER.",
  ["TEXT_S26_77C8"] = "mi sueño es convertirme\nLÍDER DE GIMNASIO.",
  ["TEXT_S26_7865"] = "Oi! Nossa, que bom\nver você.\fVocê é a primeira\nvisita que eu\vtenho faz tempo.\fEstou super feliz!\nDeixa eu te dar\vum presentinho.",
  ["TEXT_S26_78E5"] = "Eso es una PEPITA.\fno tengo\nsabiduría para dar, entonces esto será\n¡Hay que servir!",
  ["TEXT_S26_7955"] = "¿Eres {PLAYER}?\fyo trabajo como\nAYUDANTE DEL PROF.OAK.\fno tenía idea\nque vendrías.\fLABORATORIO DEL PROF.OAK\nEstá cerca, en PALLET CITY.",
  ["TEXT_S26_7A29"] = "Sólo pasa el\nEntrenador que ya ha demostrado su valía.",
  ["TEXT_S26_7A5F"] = "No los tienes todos\nel JOHTO INSIGNIA.\fLo siento, pero\nNo puedo dejarte pasar.",
  ["TEXT_S26_7AB4"] = "Oh! As oito\nINSÍGNIAS!\fPor favor, pode\nseguir, senhor!",
  ["TEXT_S26_7AF1"] = "Este camino lleva\na MT.SILVER.\fveras\nPOKéMON fuertes y aterradores allí.",
  ["TEXT_S26_7B37"] = "Indo para a\nPOKéMON LEAGUE?\fOs ELITE FOUR são\ntão fortes que dá\fmedo, e estão\nprontos para você",
  ["TEXT_S27_400E"] = "los marineros\nson generosos.\funo me enseñó\no FUERZA.\fAhora mi POKEMON\nmueve rocas.",
  ["TEXT_S27_4086"] = "Tem uma pessoa\nem CIDADE DE\vCIANWOOD\vatravés do mar.\fEu ouvi ele se\ngabar dos seus\vPOKéMON raros.",
  ["TEXT_S27_41B9"] = "…Gracias por tu\nayuda en LEUCHTTURM... Pero esto es\ndiferente. Por favor permítame\npresente.\fSoy JAZMÍN, LÍDER\nde GIMNASIO. Yo uso el tipo de acero.\f… ¿Conoces el\ntipo de acero?\f├ë un chico que era\ndescubierto muy recientemente.\f…Um… ¿Estamos empezando?",
  ["TEXT_S27_433A"] = "{PLAYER} recebeu\na MINERALBADGE.",
  ["TEXT_S27_4402"] = "JAZMÍN utiliza el\ntipo acero, que es muy reciente.\fcasi no lo sé\nnada sobre él.",
  ["TEXT_S27_4451"] = "Aquilo foi demais\fEntão o tipo aço,\nhein?\fFoi um encontro\nimediato de tipo\vdesconhecido!",
  ["TEXT_S27_44A8"] = "A JASMINE, LÍDER\ndo GINÁSIO, está\vno LIGHTHOUSE.\fEla cuida de um\nPOKéMON doente.\fUm treinador forte\nprecisa ter\vcompaixão.",
  ["TEXT_S27_45A2"] = "Cuando mi POKEMON\ncayó enfermo, el FARMACÉUTICO de\nECRUTEAK me preparó un medicamento.",
  ["TEXT_S27_45F0"] = "RHYDON: Grrugooh!",
  ["TEXT_S27_4643"] = "No caminho para\nCIANWOOD, existem\fHá quatro ilhas\ndesertas.\fCrianças ruins são\nlevadas pras ilhas\vcomo castigo!",
  ["TEXT_S27_46B1"] = "Quando me meto em\nenrascada, papai\vsempre me assusta",
  ["TEXT_S27_4749"] = "OLIVINE fica no\nmar!\fE se fica no mar,\ncom certeza há\vpeixes!\fPesco aqui há\n30 anos.\fQuer encarar o\nmar e pescar\vtambém?",
  ["TEXT_S27_47DB"] = "Ah, hahaha!\nTemos para nós\vum novo pescador!",
  ["TEXT_S27_4807"] = "El pescado no existe.\nsólo en el mar.\f¿A dónde van?\nhay agua.",
  ["TEXT_S27_484C"] = "¿Qué es? tu no\n¿¡Te gusta pescar!?\v¡Increíble!",
  ["TEXT_S27_487F"] = "E aí, como vai?\nPegou uma grande?",
  ["TEXT_S27_48DF"] = "¡Ja! Tu POKEMON\n¡Realmente parecen pesos ligeros!\fno tienen fuerza\npara apartar las rocas.\fToma, usa esto\n¡Y enséñales el movimiento de FUERZA!\fNecesitarás el\nINSIGNIA DE GIMNASIO GOLDENROD para\nusar fuera de la pelea",
  ["TEXT_S27_4965"] = "En el mar, el único\nalgo que cuenta solo puedes contar\ncontigo mismo.\festoy orgulloso de\n¡mi cuerpo curado!",
  ["TEXT_S27_49C5"] = "O cardápio do\nOLIVINE CAFE é\fcheio de comida\nreforçada pros\vSAILORS fort├Áes!",
  ["TEXT_S27_4A09"] = "Sempre que venho\npra esta cidade,\feu sempre visito\no OLIVINE CAFE.\fTudo no cardápio\nme faz sentir\fmais forte. Não\nconsigo parar!",
  ["TEXT_S27_4AD4"] = "Seus POKéMON já\nsabem o golpe pra\fcarregar pessoas\nsobre a água?",
  ["TEXT_S27_4B16"] = "Mi SIN MANTEQUILLA\nVino de mi novio en el extranjero.\fTrajo un CORREO\nque él envió.\f¿Quieres saber qué?\ndecir?\fA ver… ¡No!\n├ë un secreto!",
  ["TEXT_S27_4BDA"] = "De donde eres\n¿lo es?\f¿De NUEVA CIUDAD DE BARK?\fPROF.ELM vive\ncerca de ahí, ¿no?\fllegaste bien\nlejos para llegar.",
  ["TEXT_S27_4D2E"] = "Enferma MOOMOO... Ella necesita\nmuchas BAYAS.",
  ["TEXT_S27_4D5A"] = "Dando comida pra\nMOOMOO!",
  ["TEXT_S27_4D80"] = "O choro é fraco…",
  ["TEXT_S27_4DA2"] = "Dar uma BERRY pra\nMILTANK?",
  ["TEXT_S27_4DBC"] = "{PLAYER} deu uma\nBERRY ├á MILTANK.",
  ["TEXT_S27_4DD8"] = "A MILTANK ficou\nmais saudável!",
  ["TEXT_S27_4DFC"] = "MILTANK ficou\nbem saudável!",
  ["TEXT_S27_4E1B"] = "MILTANK se quedó\nmuy saludable!",
  ["TEXT_S27_4E3C"] = "{PLAYER} no tiene\nBAYAS…",
  ["TEXT_S27_4E4F"] = "{PLAYER} no quiere\nregala una BAYA.\fMILTANK triste.",
  ["TEXT_S27_4F38"] = "MILTANK no\nda leche pero no.\vahora.\fEsta GRANJA aquí\nTiene leche famosa.\fCasi todos\nquiero beber.\fella me da mucho\nleche si le doy muchas BAYAS,\ncreo.",
  ["TEXT_S27_4FE1"] = "¿Te gustó el mío?\n¿LECHE MOOMOO?\f├ë mi orgullo y\nAlegría, hijo.\fDar a POKéMON\npara recuperar PD!\fte veo solo\n┬Ñ500.",
  ["TEXT_S27_505D"] = "Toma!\nBebe e aproveita!",
  ["TEXT_S27_507C"] = "Desculpa, filho.\nSem grana, nada!",
  ["TEXT_S27_509D"] = "Acho que sua\nMOCHILA tá cheia.",
  ["TEXT_S27_50B7"] = "¿No quieres más?\nVuelve más tarde, ¿vale?",
  ["TEXT_S27_50DC"] = "Melhor eu ir\nordenhar.",
  ["TEXT_S27_50F6"] = "nuestra leche va\nIncluso a KANTO.\fEntonces si nuestro\nMILTANK no da leche, nos quedamos\nen problemas.",
  ["TEXT_S27_5156"] = "Tú sanaste nuestro\nMILTANK, cariño.\fAhora es MOOMOO\nLECHE otra vez.\fLlévate un recuerdo\npor tu trabajo.",
  ["TEXT_S27_51C7"] = "eso es lo que\nRONQUIDO.\f├ë un golpe raro\nque solo funciona cuando POKéMON\nestá durmiendo.\fmejor piénsalo\nsobre cómo usarlo, querida.",
  ["TEXT_S27_5303"] = "¡Estoy en shock!\fun chico como tu\nedad, con mirada dura y cabello\nentró hace mucho tiempo.\fMe asustó y\n¡Tomé mi preciado POKéMON!\ftodavía tengo uno,\n¿Pero qué pasa si regresa?\fTe ves fuerte.\n¿Puedes cuidar de mi POKéMON?\npor un tiempo?",
  ["TEXT_S27_53ED"] = "Ah, obrigado!\fCuide bem dele,\npor favor!",
  ["TEXT_S27_541B"] = "{PLAYER} recebeu\num POKéMON.",
  ["TEXT_S27_542F"] = "O time de POKéMON\nestá cheio.",
  ["TEXT_S27_5449"] = "Oh, no... ¿Qué hago?\n¿Qué hago si regresa?",
  ["TEXT_S27_5470"] = "¡Ey! ¿Cómo es el\n¿Mi POKEMON?\fcreo que lo soy\nseguro ahora. ¿Puedes devolverlo?",
  ["TEXT_S27_54B1"] = "Obrigado!",
  ["TEXT_S27_54BD"] = "Oye, ¿no?\ncon mi POKéMON.",
  ["TEXT_S27_54E3"] = "mi pokemon\nte gustó.\fEstá bien, puedes\nQuédate con él.\fPero promete ser\nbien con el!",
  ["TEXT_S27_553F"] = "Ah, no, no...\nEsto es lo mismo que el robo.",
  ["TEXT_S27_556C"] = "Para o POKéMON,\nser feliz é estar\fcom uma pessoa que\ntrata ele bem.",
  ["TEXT_S27_56F9"] = "¡UAHAHAAH!\fEntonces llegaste\n¡nos vemos aquí!\fTe lo advierto:\n¡Soy duro!\fMi POKéMON\n¡Aplasta rocas y rompe huesos!\f¡Solo mira esto!",
  ["TEXT_S27_576F"] = "CHUCK: Urggh!\n…\fOoooarrgh!",
  ["TEXT_S27_578A"] = "¡Listo! miedo\nahora, ¿eh?\f¿Qué?\n¿No tiene nada que ver con POKéMON?\n├ë cierto!\fVamos. nosotros dos\n¡luchemos!",
  ["TEXT_S27_57F6"] = "¿Hay? ¿Qué?\n¿Perdí?\f¡Solo mira esto!\n¡Te mereces el STORMBADGE!",
  ["TEXT_S27_5835"] = "{PLAYER} recebeu\na STORMBADGE.",
  ["TEXT_S27_584D"] = "A STORMBADGE faz\ntodo POKéMON até\fo L70 obedecer,\naté os trocados.\fEla também deixa\nseu POKéMON usar\fFLY fora da\nbatalha.\fTome, fique com\nisto também!",
  ["TEXT_S27_58DA"] = "Ese es el\nPUNZÓN DINÁMICO.\fÉl no siempre\nlo hace bien, pero cuando lo hace bien,\ncausar confusión!",
  ["TEXT_S27_5930"] = "¡UAHAHAAH! me encantó\nBatalla contigo, pero la derrota es\n¡derrota!\fDe ahora en adelante\n¡Entrenaré las 24 horas del día!",
  ["TEXT_S27_59FA"] = "parece que tienes\n¡Un fuerte vínculo con tu POKéMON!",
  ["TEXT_S27_5A61"] = "POKéMON de luta\ntemem os\vpsíquicos…",
  ["TEXT_S27_5AC0"] = "Perdi! Estou\nsem palavras!",
  ["TEXT_S27_5B14"] = "mi pokemon\nperdido... Mi orgullo está roto...",
  ["TEXT_S27_5BED"] = "¿Sabías que\n¿POKEMANÍACO?\fel vive si\nalardeando de su raro POKéMON.",
  ["TEXT_S27_5C33"] = "Os treinadores do\nGINÁSIO daqui são\vuns brutamontes.\fSe eu ficar aqui,\neles podem vir\vpara cima de mim.\fVai uma dica: o\nLÍDER do\fGINÁSIO usa o\ntipo lutador.\fEntão confunda\nele com POKéMON\vpsíquicos.\fAcabe com eles\nantes que usem\fa força\nfísica deles.",
  ["TEXT_S27_5DC5"] = "{PLAYER} ! tu\nganado! ¡Puedes verlo en tu cara!",
  ["TEXT_S27_5ED7"] = "Me encanta mostrar el\nPOKéMON que creé.\n¿No lo haces?\fvoy a entrar\nmuchas batallas para\n¡Muestra mi POKéMON!",
  ["TEXT_S27_5FCD"] = "Tu POKEMON\nse ven bien.\fhay algo\n¿te preocupa?\f… EL POKEMON de\n¿Está LEUCHTTURM en problemas?\f¡Ya lo sé!\fEsto debería\nresolver.",
  ["TEXT_S27_6056"] = "{PLAYER} recebeu\na SECRETPOTION.",
  ["TEXT_S27_6070"] = "Mi SECRETPOCION\nes demasiado fuerte.\fsolo ofrezco uno\nemergencia.",
  ["TEXT_S27_60F9"] = "tienes algunos\nMagnífico POKéMON.\f¿Qué tal una foto?\nrecuerdo?",
  ["TEXT_S27_6142"] = "Certo! Sorria!",
  ["TEXT_S27_6156"] = "Ah, que pena.\nAchei que seria\fuma bela\nlembrança…",
  ["TEXT_S27_61BC"] = "tu viniste de\n¿OLIVINO?\frecuerda los cuatro\nislas que están en el camino?\fescuché eso\nAllí se esconde una criatura marina mítica.",
  ["TEXT_S27_623F"] = "solo escuché eso\npuedes verlo si tienes uno\nALA DE PLATA.\fElla debe tener el\nEl mismo olor que la criatura.",
  ["TEXT_S27_62A9"] = "Os redemoinhos\nperto das ilhas\fdevem ser causados\npela criatura.",
  ["TEXT_S27_65AB"] = "LA TORRE DE BATALLA\nte da la bienvenida!\fpuedo llevarte a\nuna SALA DE BATALLA.",
  ["TEXT_S27_6C09"] = "esperamos servir\ntú otra vez.",
  ["TEXT_S27_6D3C"] = "las reglas de\nTORRE DE BATALLA están escritos aquí.\f¿Leer las reglas?",
  ["TEXT_S27_7264"] = "Destruido por\nprimer oponente en\ntiempo... no soy bueno...",
  ["TEXT_S27_72A4"] = "Tem várias\nBATTLE ROOMS, mas\fvou ganhar todas\nelas!",
  ["TEXT_S27_72E3"] = "├ë muy difícil\nno poder usar artículos durante\nla batalla.\fHaz tu POKEMON\nMantener objetos es la clave para\nganar batallas.",
  ["TEXT_S27_735B"] = "lo estoy intentando\nver hasta dónde puedo llegar usando solo\nInsecto POKéMON.\feso no tiene\nsin fuego POKEMON...",
  ["TEXT_S27_7716"] = "Ir a\n¿TORRE DE BATALLA?\f├ë secreto, pero si\nganas mucho, puedes\nGana regalos especiales.",
  ["TEXT_S27_77C8"] = "Los niveles de\nPOKéMON que quiero usar son todos\ndiferente.\fnecesito entrenar\nellos ahora!",
  ["TEXT_S27_7930"] = "Vaya, la BATALLA\n¡La TORRE es enorme!\fDebe haber muchos\ntipos de POKéMON en su interior!",
  ["TEXT_S27_79DB"] = "Sólo puedes usar\ntres POKÉMON.\f├ë tan difícil\ndecide cuáles tres irán a la batalla...",
  ["TEXT_S27_7A8C"] = "Ja ja, me escapé\nde trabajo.\fno puedo\n¡Ríndete hasta ganar!\ftengo que ganar\ntodo. ¡Tengo que hacerlo!",
  ["TEXT_S27_7AFC"] = "BATTLE TOWER\fEncare o Desafio\nSupremo!",
  ["TEXT_S5D_4000"] = "¡Hola, {PLAYER}!\nNuestras ventas de BICICLETAS fueron\n├¡a las nubes!\fTodo gracias ├á\nTu propaganda, caminando\nen nuestra BICICLETA.\fcomo una manera de\nGracias, quédate con esta BICICLETA.\n¡Gracias de nuevo!",
  ["TEXT_S5D_4F2F"] = "Escucha, el palo\nde mi {RAM:D0AC} tiene un muy\ndelicioso.\fEste aroma abre\nmi apetito!",
  ["TEXT_S5D_7378"] = "{PLAYER}, usted\n¿Escuchaste la noticia?\fCOHETE DEL EQUIPO\ntomó la TORRE DE RADIO DE LA CIUDAD\nDE VARA DE ORO.\fEstará bien\nempleados?",
  ["TEXT_S60_4178"] = "En la LIGA POKéMON,\nserás probado por\nÉLITE CUATRO.\ftengo que ganar\ntodos. Si pierdes, tendrás que\n¡Empieza todo de nuevo!",
  ["TEXT_S60_41F5"] = "Espera ahí.\fte enfrentarás\nel desafío de la LIGA POKéMON\nahora?\festo no lo hará\nsuceder.\fMi súper POKEMON\nbien entrenado terminará\nusted.\f {PLAYER} !\n¡Te reto!",
  ["TEXT_S60_42A4"] = "...Maldita sea...todavía\nNo puedo... yo... necesito\npiensa más en mi POKéMON… ¡Humpf! no lo intentes\nperder!",
  ["TEXT_S60_42FD"] = "…Uf…\nCon mis amigos, seré el\n¡CAMPEÓN!",
  ["TEXT_S60_4335"] = "¡Oh! lo harás\n¿Desafiar a los CUATRO DE ÉLITE? ¿Estás seguro?\n¿Qué está listo?\fSi necesitas\nentrenar más, mi ABRA puede\nayudarte.\fÉl puede TELEPORTARSE\nEstás en casa.\f¿Quieres ir?\n¿a casa ahora?",
  ["TEXT_S60_43E7"] = "Certo, certo.\nImagine a sua casa\vna cabeça…",
  ["TEXT_S60_4411"] = "Certo, certo.\nBoa sorte!",
  ["TEXT_S60_4531"] = "{PLAYER}, bienvenido\n├á LIGA POKéMON.\fdéjame\npresente. Soy VOLUNTAD.\fme entrené en\nmundo entero, dejando mi\npsíquicos fuertes.\fY finalmente fui\naceptado en ELITE CUATRO.\fsolo puedo quedarme\nmejorando!\fPerder no es un\nopción!",
  ["TEXT_S60_462C"] = "Yo... yo no...\nYo creo esto...",
  ["TEXT_S60_4644"] = "Incluso derrotado,\nNo cambiaré mi camino.\fvoy a continuar\nluchando hasta estar arriba\ncada entrenador!\fAhora, {PLAYER},\nsigue adelante y siente la furia\nde la ÉLITE CUATRO.",
  ["TEXT_S60_4793"] = "Fuahahahaha!\fSoy KOGA, dos\nÉLITE CUATRO.\fyo vivo en\n¡Sombras, ninja!\fmi estilo es\nintrincado y te destruirá!\fConfusión, sueño,\nveneno... Prepárate para\n¡Sé víctima de mi técnica!\fFuahahahaha!\fPOKéMON no es sólo\nfuerza bruta, ya verás que\n¡pronto, pronto!",
  ["TEXT_S60_48A9"] = "¡Oh!\n¡Has demostrado tu valía!",
  ["TEXT_S60_48CA"] = "te lo tiré\ntodo lo que pude reunir.\fpero mi esfuerzo\nfalló. Necesito perfeccionar mi oficio.\fIr al siguiente\n¡Haz la habitación y pon a prueba tus fuerzas!",
  ["TEXT_S60_49FE"] = "Soy BRUNO, de\nÉLITE CUATRO.\fyo siempre entreno\nal extremo porque creo en nuestro potencial.\fAsí fue como el\nNos volvimos fuertes. Puedes manejarlo.\nnuestro poder?\f¿Mmm? no veo miedo\nen ti. Parece decidido.\n¡Perfecto!\f¿Listo, {PLAYER}?\nSe inclinará ante nuestro poder\nabrumador!\fRuu ja!",
  ["TEXT_S60_4B23"] = "Por quê? Como a\ngente perdeu?",
  ["TEXT_S60_4B3C"] = "Habiendo perdido, yo\nNo tengo derecho a decir nada... Ve a enfrentarte a tu\n¡Próximo desafío!",
  ["TEXT_S60_4C27"] = "Soy KAREN, de\nÉLITE CUATRO.\f¿Eres {PLAYER}?\nQue divertido.\fme encanta pokemon\nel tipo oscuro.\fcreo que la imagen\nsalvaje y duro de ellos atractivo. y\nson fuertes.\f¿Crees que puedes manejar\nde ellos? Sólo intenta entretenerme.\fVamos.",
  ["TEXT_S60_4CF8"] = "Bien, eres bueno\nlo mismo. Me gusta eso en un entrenador.",
  ["TEXT_S60_4D29"] = "POKÉMON fuerte.\fPOKEMON Débil.\fEso es solo el\nLa percepción egoísta de la gente.\fEntrenador\nla verdad intenta ganar con\ntus favoritos.\fme gusta el tuyo\nestilo. Tú entiendes.\fAdelante, el\nEL CAMPEÓN te espera.",
  ["TEXT_S60_4F67"] = "LANZA: Yo estaba\nesperando por ti.\f {PLAYER} !\fte conocí,\ncon tu talento se acabaría\nllegando a mí.\fno es momento de\npalabras ahora.\fluchemos\npara decidir quien es el mas fuerte\nde nosotros dos.\fcomo el entrenador\nmás poderoso y como CAMPEÓN de\nLIGA POKéMON… YO, LANCE, maestro\nde los dragones, acepto el desafío!",
  ["TEXT_S60_50A4"] = "… Terminó.\fPero es un sentimiento\nextraño.\fno estoy enojado\npor haber perdido.\vYo estoy feliz.\ffeliz de tener\nvisto un gran recién nacido\n¡CAMPEÓN!",
  ["TEXT_S60_5132"] = "…Uf.\frealmente te quedaste\npotente, {PLAYER}.\fTu POKEMON\nrespondió de manera fuerte y\nintacto.\fComo entrenador,\ncrecerás junto con los tuyos\nPOKÉMON.",
  ["TEXT_S60_51DD"] = "MARÍA: ¡Ay no!\n¡Se acabo!\fPROF.ROBLE, si\nno tardes...",
  ["TEXT_S60_521B"] = "PROF.OAK: Oh,\n {PLAYER} !\fHa pasado mucho tiempo.\festas con\ncara grande.\fSu conquista de\n¡La LIGA estuvo fantástica!\fTu dedicación,\nconfianza y amor por tu POKéMON\nellos hicieron eso.\fTu POKEMON\ntambién fueron excelentes.\fporque ellos creyeron\nen ti como entrenador, ellos\npersistió.\fFelicitaciones,\n {PLAYER} !",
  ["TEXT_S60_534B"] = "MARY: Vamos\nentrevistar o novo\vCAMPEÃO!",
  ["TEXT_S60_537B"] = "LANCE: Isto está\nficando barulhento\vdemais…\f{PLAYER}, pode\nvir comigo?",
  ["TEXT_S60_53C5"] = "MARÍA: ¡Oh, espera!\n¡No hicimos la entrevista!",
  ["TEXT_S60_54A6"] = "LANCE: Ha sido mucho.\nHa pasado un tiempo desde que estuve aquí.\f├ë aquí estamos\nhonra a los CAMPEONES DE LA LIGA en todo momento\neternidad.\fPOKÉMON\nTambién entran sus valientes.\fHoy, aquí, el\nVimos surgir un nuevo CAMPEÓN\nde la LIGA, un entrenador que ha\ncompasión y confianza en\ntu POKéMON.\fun entrenador que\nsuperado a través de la perseverancia y\nde determinación.\fEl nuevo CAMPEÓN de\nLIGA, que tiene todo para ser\nuno grande!\f {PLAYER}, déjame\nregistrarte a ti y a tus socios\ncomo CAMPEONES!",
  ["TEXT_S61_40BC"] = "A USINA de KANTO\nfica perto do fim\fda ROTA 9.\nHouve um acidente\fde algum tipo\npor lá.",
  ["TEXT_S61_4144"] = "¿Quieres capturar?\n¿Uno de cada tipo de POKéMON?\fdebe ser un\nTodo un desafío, pero se ve genial.",
  ["TEXT_S61_41A8"] = "EL CABO al norte\nEs un buen lugar para reuniones.\n¡A las chicas les gusta!",
  ["TEXT_S61_41FA"] = "Yo y mi SLOWBRO\n¡Hacemos un dúo increíble!",
  ["TEXT_S61_4229"] = "SLOWBRO, mostre\nseu CONFUSION!",
  ["TEXT_S61_424E"] = "Sou fã da\nMISTY do GINÁSIO\vde CERULEAN.",
  ["TEXT_S61_4275"] = "Vi o cara suspeito\nir pro CABO de\vCERULEAN.",
  ["TEXT_S61_42A9"] = "Aqui havia uma\ncaverna\fcom POKéMON\nhorríveis e\vfortes.",
  ["TEXT_S61_42EE"] = "¿Eh?\fMi BUSCADOR DE ARTÍCULOS\nesta reaccionando...",
  ["TEXT_S61_4312"] = "CIDADE DE CERULEAN\fUma Estranha Aura\nAzul a rodeia.",
  ["TEXT_S61_4345"] = "CIDADE DE CERULEAN\nPOKéMON GYM\vLÍDER: MISTY\fA Sereia\nLevada",
  ["TEXT_S61_4381"] = "Há um aviso…\naqui…\fA BIKE SHOP mudou\npara CIDADE DE\vGOLDENROD em\vJOHTO…",
  ["TEXT_S61_43CC"] = "Há um aviso…\naqui…\fAcabe com os\nladr├Áes e faça da\fcidade um lugar\nmais alegre!\fPOLÍCIA CERULEAN",
  ["TEXT_S61_443B"] = "CERULEAN CAPE\nadiante",
  ["TEXT_S61_4450"] = "Está trancado…",
  ["TEXT_S61_4583"] = "todos los seres\nLos organismos vivos coexisten en cooperación.\fsiempre debemos estar\nagradecido por eso.",
  ["TEXT_S61_45D8"] = "Sólo aquellos que llegan a\nLo mejor es que obtienes un HM.",
  ["TEXT_S61_460A"] = "TORRE DE BROTES fue\nconstruido hace mucho tiempo como un lugar de\nEntrenamiento POKÉMON.",
  ["TEXT_S61_4649"] = "Um BELLSPROUT de\nmais de 30 metros\fDizem que ele\nvirou o pilar\vcentral daqui.",
  ["TEXT_S61_469D"] = "vio el pilar\ntemblando?\fellos estan entrenando\nallá arriba.",
  ["TEXT_S61_46D6"] = "Estatua POKéMON… Parece Mucho\nimponente.",
  ["TEXT_S61_47FF"] = "A coluna flexível\nprotege a TOWER\fmesmo contra\nterremotos.",
  ["TEXT_S61_486F"] = "Intenté copiar el\nmovimientos suaves del BELLSPROUT\npara la batalla... Pero no entrené\nbastante bien.",
  ["TEXT_S61_48C8"] = "Estatua POKéMON… Parece Mucho\nimponente.",
  ["TEXT_S61_4A27"] = "ANCIANO: Eres\nmuy hábil como entrenador.\fComo prometí,\naquí está HM.\fPero quiero decir:\ndebes cuidar bien de tu\nPOKÉMON.\ftu forma de\nluchar es difícil POKéMON no lo son\narmas de guerra...",
  ["TEXT_S61_4AEC"] = "…\n…¡Humf!\fÉl dice el\nANCIANO, pero es débil.\fTiene sentido.\nNunca perdería contra los tontos que\nhablar de ser amable con la gente\nPOKÉMON.\fsolo me importa\nPOKéMON fuertes, que saben ganar.\fno me importa\nPara nada con POKéMON débiles.",
  ["TEXT_S61_4BC8"] = "{RIVAL} usou uma\nCORDA DE FUGA!",
  ["TEXT_S61_4BE0"] = "que bueno de tu parte\n¡Ha llegado!\fLA TORRE DEL BROTE,\nlugar de entrenamiento.\fPersonas y POKEMON\nPon a prueba sus vínculos para construir.\nun futuro juntos.\fyo soy la prueba\nfin.\fDéjame ver\nlos lazos entre usted y su\n¡POKÉMON!",
  ["TEXT_S61_4CB2"] = "Ah, excelente!",
  ["TEXT_S61_4CC2"] = "tu y tu\nPOKéMON no tendrá problemas para usar\neste golpe.\fToma este HM de\nFLASH.",
  ["TEXT_S61_4D13"] = "FLASH ilumina\naté os lugares\vmais escuros.\fMas, para usar\nfora de batalha,\fprecisa do BADGE\nde CIDADE DE\vVIOLET.",
  ["TEXT_S61_4D88"] = "te espero\naprender y crecer a lo largo del viaje.",
  ["TEXT_S61_4DFA"] = "Según Pokémon\nse fortalece, el entrenador también se fortalece.\fNo, espera.\nComo el entrenador consigue\nMás fuerte, el POKéMON también.",
  ["TEXT_S61_4EA4"] = "No falta mucho para\nel ANCIANO.",
  ["TEXT_S61_4F12"] = "Que haya luz\nen tu viaje.",
  ["TEXT_S61_4F37"] = "├ë uma pintura\npoderosa de um\vBELLSPROUT.",
  ["TEXT_S61_4F61"] = "Estatua POKéMON… Parece Mucho\nimponente.",
  ["TEXT_S61_5203"] = "EUSINA: ¡Increíble!\n¡Incluso demasiado!\fnunca he visto uno\nque buena batalla.\fEso fue\nrealmente inspirador.\fSUICUNE fue duro,\npero fuiste aún más sorprendente,\n {PLAYER}.\fEscuché que el poder\nSUICUNE místico invoca un POKéMON\ncolor del arco iris.\fTal vez, sólo tal vez,\n¿Qué pasó hoy? Haz esto.\nAparece POKéMON.\festudiaré más\nlas leyendas.\fgracias por mi\nmuestra esta increíble batalla.\fHasta luego,\n {PLAYER} !",
  ["TEXT_S61_5386"] = "segundo\nla leyenda... Cuando las almas de\nPOKéMON y los humanos se comunican, desde\nDel cielo desciende un POKéMON de colores\ndel arcoiris... ¿Será el\n¿Los POKéMON legendarios nos están poniendo a prueba a los humanos?",
  ["TEXT_S61_5433"] = "Quando a BRASS\nTOWER pegou fogo,\fdisseram que três\nPOKéMON sem nome\fmorreram. Foi\ntrágico.\fPorém…\fUm POKéMON\nde cor arco-íris…\fEm outras\npalavras…\fHO-OH desceu\ndo céu e deu\fnova vida aos\ntrês POKéMON.\fEles são…\fSUICUNE, ENTEI e\nRAIKOU.\f├ë o que\ndizem.",
  ["TEXT_S61_5544"] = "Dicen que ambos\nLas TORRES fueron construidas para\npromover la amistad y la esperanza entre\nPOKéMON y personas.\fEso fue hace 700 años\naños, pero el ideal sigue siendo\nimportante hoy.",
  ["TEXT_S61_55EE"] = "HO-OH parece ter\ndescido\fbem aqui, na TIN\nTOWER!",
  ["TEXT_S61_5629"] = "Isto vai te\nproteger. Pegue.",
  ["TEXT_S61_564A"] = "Agora, vá.",
  ["TEXT_S61_5654"] = "te creo\nestá siendo probado.\fLibera tu mente\nde incertidumbre y seguir adelante.",
  ["TEXT_S61_56A3"] = "Lo sabía.\fte conocí\nIba a ver los POKéMON codificados por colores.\narcoíris, {PLAYER}.\ffue exactamente\ncomo predije.\fpuedo decir eso\nMi investigación no es mala.\fvoy a continuar\nestudiando POKéMON para convertirse en uno\n¡Famoso POKéMANÍACO!",
  ["TEXT_S61_5765"] = "Dizem que os\nPOKéMON lendários\frepresentam três\npoderes…\fO raio que\natingiu a TOWER.\fO fogo que\nqueimou a TOWER.\fE a chuva que\napagou o fogo…",
  ["TEXT_S61_5803"] = "Cuando Pokémon\nSurgieron legendarios… Causaron\nterror en quienes los vieron aparecer.\fY… algunos incluso\nFueron al ataque, en vano.\fPOKÉMON\nLas leyendas, conscientes de su propio poder, huyeron e ignoraron al pueblo asustado.",
  ["TEXT_S61_58D0"] = "Dizem que, dos\nPOKéMON lendários,\fSUICUNE é o mais\npróximo de HO-OH.\fOuvi dizer que\ntambém há um\felo com o POKéMON\nUNOWN.\fO POKéMON UNOWN\ndeve compartilhar\fum vínculo com\no SUICUNE.",
  ["TEXT_S61_5CD9"] = "…… …… …… … Ah, eres tú.\fvine a buscar algunos\nPOKéMON legendarios que dicen eso\nvivir aquí.\fpero no hay nada\n¡aquí!\fNada, después\n¿Trabajar para llegar a este hoyo?\n¡No hay posibilidad!\ftodo es culpa\ntuyo!",
  ["TEXT_S61_5D9B"] = "…¡Humf!\f├ë por eso yo\nOdio pelear con plátanos. no hay\nningún desafío.",
  ["TEXT_S61_5DE2"] = "…Ah, lo que sea.\fnunca lo harías\nlogra atrapar POKéMON legendarios\nlo mismo.",
  ["TEXT_S61_5E2C"] = "…¡Humf!\f├ë por eso yo\nOdio pelear con plátanos. ├ë sólo\npérdida de tiempo.",
  ["TEXT_S61_5ECC"] = "EUSINA: Mi nombre\nEs EUSINA.\fEstoy detrás de uno\nPOKéMON llamado SUICUNE.\f¿Y tú eres…?\f ¿{PLAYER}? placer\npara conocerte!\fEscuché rumores de que\nSUICUNE esta en este QUEMADO\nTORRE, entonces vine a mirar.\fPero ¿dónde estará?\n¿Lo es?",
  ["TEXT_S61_5F99"] = "EUSINE: Ouvi que\nSUICUNE está\fnesta BURNED\nTOWER, então vim\volhar.\fMas onde será que\nele está?",
  ["TEXT_S61_6002"] = "MORTY: O LÍDER DE\nGINÁSIO de\fECRUTEAK precisa\nestudar os\fPOKéMON lendários\n--SUICUNE, ENTEI\fe RAIKOU.\fEUSINE está aqui,\nentão decidi\finvestigar a\nTOWER com ele.",
  ["TEXT_S61_626A"] = "EUSINA: Yo también.\nCavé un hoyo aquí… ¡Me sorprendió!\fSUICUNE pasó\n¡Como una mancha, justo frente a mis ojos!\fDurante diez años yo\npersiguió a SUICUNE, y finalmente\nLogré verlo.\f¡Estoy emocionado!\f {PLAYER}, debo\ntodo esto para ti!\f¡Gracias!\fescuché que el\nPOKEMON legendario de ECRUTEAK\nprobar a los humanos permitiéndoles\nenfoque.\fvoy tras\nSUICUNE.\f {PLAYER}, arriba\n¡un día más!\f¡Adiós!",
  ["TEXT_S62_4005"] = "te estas uniendo\n¿INSIGNIAS DE KANTO?",
  ["TEXT_S62_405A"] = "escuché ese\nUn tipo extraño anda por ahí.\fno lo toleraré\nsi termina siendo un ladrón.",
  ["TEXT_S62_40C3"] = "ya hemos sido victimas\nde ladrones.",
  ["TEXT_S62_414D"] = "mi marido vive\ncontento con los POKéMON que consiguió en los intercambios.",
  ["TEXT_S62_418A"] = "Ah… Que alegria…",
  ["TEXT_S62_4221"] = "Para luchar,\nPrefiero usar POKéMON que creé, incluso si son\nMás débil que un POKEMON\nrecién capturado.",
  ["TEXT_S62_428C"] = "tu luchas por\ncelular?\fSi el tiempo se acaba\ndurante una pelea, espera y verás\nQuien ganó está muy tenso.",
  ["TEXT_S62_42FF"] = "EL TREN IMÁN\nviaja a más de 540 km/h. el lo hará\nde KANTO a JOHTO en casi nada de tiempo\ntiempo.\festo trae\nJOHTO de ti.",
  ["TEXT_S62_44FB"] = "¡Arriba! ¡Lo lamento!\nNo te dolió, ¿vale?\fEstoy muy ocupado.\nNo hay tiempo para charlar contigo.\vMalo para mí si alguien me ve.",
  ["TEXT_S62_4574"] = "¡Oh, no! ¿Has visto\n¡yo! ¡Cometí un gran error!",
  ["TEXT_S62_45A5"] = "¡Eh, tú! olvidar\n¿Quién me vio, vale?\f¿No viste?\nNi siquiera escuchaste nada, ¿vale?\n¡Adiós, muchacho!\f¡Adiós!",
  ["TEXT_S62_4610"] = "Desculpe, saí\npor um tempo.\vMISTY, GYM LEADER",
  ["TEXT_S62_4642"] = "Como a MISTY saiu,\nnós também.\vGYM TRAINERS",
  ["TEXT_S62_4674"] = "MISTY: Yo ya\n¡Me lo esperaba, plaga!\vPuedes tener muchas INSIGNIAS DE GIMNASIO\nJOHTO, pero no me llevarás\n¡tonterías!\vMis POKéMON de agua son\ndur├Áes!",
  ["TEXT_S62_470C"] = "MISTY: Eres\nmuy bien… admito que tu\nEs hábil... Aquí. ├ë un\nINSIGNIA DE CASCADA.",
  ["TEXT_S62_4768"] = "{PLAYER} recebeu\na CASCADEBADGE.",
  ["TEXT_S62_4782"] = "MISTY: Hay\n¿Cuántos entrenadores fuertes hay en JOHTO?\v¿Cómo estás, por cierto?\fvoy a viajar\nun dia y quiero batallar\nbuenos entrenadores.",
  ["TEXT_S62_4856"] = "Vou nadar em\nsilêncio.",
  ["TEXT_S62_48C0"] = "no seas tan\nconfiado en ganar.\fMISTY te atrapará\nsi eres descuidado.",
  ["TEXT_S62_4943"] = "MISTY ha mejorado\nmucho en los últimos años.\fNo descargar el\n¡Guardaos o seréis aplastados!",
  ["TEXT_S62_49A7"] = "E aí, futuro\ncampeão!\fComo a MISTY\nsaiu, fui me\fdivertir também!\nHe-he-he.",
  ["TEXT_S62_49FA"] = "Vaya, lo mostraste\nque duro es.\fComo siempre, fue\n¡Qué gran batalla!",
  ["TEXT_S62_4ACD"] = "veras\nmuchos por ahí en el camino a CAPE\npor CERÚLEO.\fellos quieren ver\n¿Cómo les va frente a los demás?\nentrenadores.",
  ["TEXT_S62_4B46"] = "A MISTY é a única\nna cidade que\fvence os caras\ndo CAPE de\vCERULEAN.",
  ["TEXT_S62_4BF1"] = "UN CENTRO POKEMON\ncerca de una cueva?\feso esta bien\nconveniente.",
  ["TEXT_S62_4C26"] = "EL GERENTE de\nPOWER PLANT quiere encontrar un hombre\ncon buenos POKEMON.\fel necesita\nayuda para recuperar algo\nfue robado.",
  ["TEXT_S62_4C9E"] = "Escuché que EQUIPO\nROCKET reunido en JOHTO,\npero se vino abajo.\fno lo sabia\nnada de eso.",
  ["TEXT_S62_4D0C"] = "Cuando te vayas,\npuedes ver el techo de un\ngran edificio.\fEsto es PODER\nPLANTA.",
  ["TEXT_S62_4EE0"] = "Um ladrão invadiu\na POWER PLANT…\fO que o mundo\nestá virando?",
  ["TEXT_S62_4F22"] = "Me acabo de enterar\npor CERÚLEO.\fAparentemente,\nun chico extraño camina\ndando vueltas.",
  ["TEXT_S62_4F7F"] = "¿Puedo pedir tu\ncooperación?",
  ["TEXT_S62_4FA2"] = "Vamos ter que\nreforçar nossa\vsegurança.",
  ["TEXT_S62_4FCF"] = "alguien tomó\nuna pieza imprescindible para\nel generador.\fSin ello, el\n¡El nuevo generador no funciona!",
  ["TEXT_S62_5038"] = "O gerador está\nligado e no ar.\fEstá gerando\neletricidade!",
  ["TEXT_S62_5079"] = "Esta CENTRAL DE ENERGÍA\nhabía sido abandonado.\fNos reactivamos\nella para darle energía\nTREN IMÁN.",
  ["TEXT_S62_50EF"] = "O gerador está\nrodando de novo!",
  ["TEXT_S62_510E"] = "EL GERENTE de\nLA PLANTA DE ENERGÍA está justo delante.\f¿Pero cómo alguien\nSe rompió el generador, estaba triste y furioso...",
  ["TEXT_S62_517F"] = "Como o gerador\nfoi consertado,\fo MANAGER está\nbem animado.",
  ["TEXT_S62_51C2"] = "EL TREN IMÁN\nconsume mucha electricidad.\fNo camines si\nEl nuevo generador no funciona.",
  ["TEXT_S62_5225"] = "Legal! Podemos\nfinalmente p├┤r o\fMAGNET TRAIN\nde novo no ar!",
  ["TEXT_S62_5264"] = "ADMINISTRADOR: Lo haré\n¡Hacer volar a alguien!\v¿Quién se atreve a estropearme?\ngenerador?\fgasté tanto\n¡tiempo en ello!\fSi lo atrapo,\nel vera lo que es un ZAP\n¡CAÑÓN!",
  ["TEXT_S62_5308"] = "ADMINISTRADOR: No lo haré\n¡perdona no!\fEl culpable puede\nLlorar, pedir perdon, pero aun asi\n¡Lo voy a moler!\f¡Jajajajaja!",
  ["TEXT_S62_536E"] = "DIRECTOR: ¡Ah! ¡Sí!\f├ë la PARTE que\n¡Me faltaba mi querido generador!\v¿Lo encontraste?",
  ["TEXT_S62_53C4"] = "Uau! Valeu!\fTome este TM\ncomo recompensa!",
  ["TEXT_S62_53F4"] = "GERENTE: TM07 es\nmi CAÑÓN ZAP.\f├ë una técnica\npoderoso!\fno es bueno\nexacto, pero da en el clavo!\n¡Golpea fuerte!",
  ["TEXT_S62_5475"] = "MANAGER: Meu\namado gerador!\fContinua soltando\neletricidade!",
  ["TEXT_S62_56CE"] = "¿Mmm? Conozca el\n¿BILL? ├ë mi nieto.\fEl esta en JOHTO\nHace algo con las PC, así que\nYo cuido la casa.",
  ["TEXT_S62_5732"] = "Si tienes esto\nPOKéMON, muéstramelo, ¿por favor?",
  ["TEXT_S62_5760"] = "¿Lo mostrarás?\n¡Qué amable!",
  ["TEXT_S62_5784"] = "¿No lo tiene?\nQué vergüenza…",
  ["TEXT_S62_57E1"] = "Obrigado!\fIsto é uma marca\nde gratidão!",
  ["TEXT_S62_580E"] = "Venha me visitar\noutra hora!",
  ["TEXT_S62_582A"] = "gracias por mi\nmuestra tantos POKéMON lindos.\frealmente me gustó\nlo mismo. Estoy feliz de haber vivido una\nuna vida tan larga.",
  ["TEXT_S62_5891"] = "¿Mmm?\fno es pokemon\nlo que me contaron.",
  ["TEXT_S62_58C0"] = "Mi nieto me factura\nhabló de un POKéMON que tiene\nlengua larga.",
  ["TEXT_S62_58FF"] = "ay mi nieto\nhabló de un POKéMON verde y\nredondo, con hojas en la cabeza.",
  ["TEXT_S62_5953"] = "Conhece o\nPOKéMON que tem\fesfera vermelha\nno corpo?\fSabe, aquele\nque parece uma\vestrela?\fEu ouvi que\nsurge ├á noite.\fEu adoraria\nver ele.",
  ["TEXT_S62_59FE"] = "Bill me dijo\nde un POKéMON muy fiel al\ntu entrenador.\fdicen que saben\nruge muy bien!",
  ["TEXT_S62_5A57"] = "Ouvi falar de um\nPOKéMON fofo que\vtem seis rabos.\fEu adoraria\nabraçar esse\vPOKéMON fofinho!",
  ["TEXT_S62_5AB1"] = "¿Sabes cuál\n¿POKéMON muy famosos?\fPOKÉMON\n¿Cuerpo amarillo y mejillas rojas?\fme encantaría ver\n¿Cómo se ve antes?\n¡evoluciona!",
  ["TEXT_S62_5B6C"] = "Olá!\fO KARATE KING,\nmestre do DOJO,\festá numa caverna\nem JOHTO,\vtreinando.",
  ["TEXT_S62_5BC0"] = "Tudo o que vai\nvolta!",
  ["TEXT_S62_5BE0"] = "Inimigos por\ntodos os lados!",
  ["TEXT_S62_5CDF"] = "SABRINA: Lo sabía\nque vendrías... Hace tres años yo\nTuve una visión de tu llegada.\f¿Quieres el mío?\nINSIGNIAS.\fno me gusta\nluchar, pero es mi deber como LÍDER\ndar INSIGNIAS a quienes lo acrediten\nque sea digno o digno.\fComo quieres,\n¡Mostraré mi poder psíquico!",
  ["TEXT_S62_5DF4"] = "SABRINA: Tuya\npoder… Va mucho más allá\nlo que predije... Quizás no sea así.\nposible predecir completamente lo que\nel futuro depara... Está bien, tú ganas\ny ganó el MARSHBADGE.",
  ["TEXT_S62_5E95"] = "{PLAYER} recebeu\na MARSHBADGE.",
  ["TEXT_S62_5EAD"] = "SABRINA: Un\nMARSHBADGE despierta sus poderes\nsubliminales… Aunque tengo\nNo pude predecir su poder con precisión, de esto estoy seguro.\fte convertirás\n¡un querido y famoso CAMPEÓN!",
  ["TEXT_S62_5F6C"] = "SABRINA: Seu amor\npelos POKéMON\fvenceu o meu\npoder psíquico…\fO poder do amor,\neu acho, também é\fum tipo de poder\npsíquico…",
  ["TEXT_S62_6034"] = "De onde vem a\nsua força?",
  ["TEXT_S62_60A6"] = "te fortaleciste\nalma, no sólo habilidades.",
  ["TEXT_S62_6136"] = "Droga! Esqueci\nque eu previ que\vperderia para ti",
  ["TEXT_S62_61B3"] = "O KARATE KING,\nmestre do\fFIGHTING DOJO, foi\narrasado agora\vpela SABRINA.",
  ["TEXT_S62_6201"] = "Hola futuro\n¡CAMPEÓN!\ftal entrenador\nbueno ya que no lo necesitas\ndime como lidiar con POKéMON\n¿Tipo psíquico?\fespero grande\ncosas tuyas!\f¡Buena suerte!",
  ["TEXT_S62_62A0"] = "Foi mais uma\nbatalha e tanto!",
  ["TEXT_S62_63CC"] = "Tem uma RADIO\nTOWER bem grande\vem LAVENDER.",
  ["TEXT_S62_63F3"] = "quiero quedarme\nmás fuerte, pero aún no lo soy... Tú me enseñas\ncomo, ¿un día?",
  ["TEXT_S62_64A3"] = "¿Cómo son los\n¿CENTROS POKéMON de JOHTO?\f…Está bien, lo entiendo.\fentonces no lo son\nmuy diferentes a los de KANTO.\fentonces puedo ir\na JOHTO sin preocupaciones!",
  ["TEXT_S62_6532"] = "¿Cómo son los\n¿CENTROS POKéMON de JOHTO?\f…Está bien, lo entiendo.\nPara que puedas conectarte con\n¿Gente lejana?\fEntonces preguntaré\npara que mi amigo en JOHTO consiga uno\nMARILL y comercia conmigo!",
  ["TEXT_S62_65D3"] = "por casualidad yo\nPasé por el TÚNEL DE ROCA. Hubo un\nalboroto allí en POWER PLANT.",
  ["TEXT_S62_662E"] = "La cueva se derrumba\ncon facilidad.\fVarias cuevas\ndesaparecido en los últimos años,\ncomo el que está cerca de CERULEAN.\fComo excursionista profesional,\nesto es algo que se sabe.",
  ["TEXT_S62_66C5"] = "A SEDE da SILPH\nCO. e a ESTA├çÃO\fdo MAGNET TRAIN\nsão os lugares\fpara ver em\nSAFFRON.",
  ["TEXT_S62_6798"] = "… … … …¡Lo sé!\f¡Querías esto!",
  ["TEXT_S62_67BB"] = "A TM29 é PSYCHIC.\fEla pode baixar o\nSPECIAL do\valvo.",
  ["TEXT_S62_68A9"] = "Lo siento, pero el\nEl TREN MAGNÉTICO no está funcionando.",
  ["TEXT_S62_68DD"] = "vámonos pronto\npara VARA DE ORO.\flo harás\n¿embarcar?",
  ["TEXT_S62_6917"] = "¿Puedo ver tu\n¿PASE DE FERROCARRIL?\fBien. Ven por\naquí, señor.",
  ["TEXT_S62_6956"] = "Lo siento, pero tu\nNo hay PASO.",
  ["TEXT_S62_6978"] = "Esperamos te ver\nde novo.",
  ["TEXT_S62_6993"] = "Llegamos a\nAZAFRÁN.\fEsperamos verte\notra vez.",
  ["TEXT_S62_69CA"] = "EL TREN IMÁN\nEs un tren super moderno que utiliza\nelectricidad e imanes para alcanzar\na una velocidad increíble.\fPero si no\nhay electricidad...",
  ["TEXT_S62_6A61"] = "Uf… ¿cuántas veces he\nHe estado yendo y viniendo entre KANTO\ny JOHTO?",
  ["TEXT_S62_6AAB"] = "Antes de fazerem\na MAGNET TRAIN\fSTATION, tinha uma\ncasa ali.\fUma menina\nchamada COPYCAT\vmorava lá.",
  ["TEXT_S62_6B20"] = "Hola. ¿Tienes un\n¿PASAR en tren? Yo tengo uno. Todos\nmundo en AZAFRÁN que cabalga sobre IMÁN\nTREN tiene uno.",
  ["TEXT_S62_6C03"] = "Bem-vindo. Este é\no PR├ëDIO da SEDE\vda SILPH CO.",
  ["TEXT_S62_6C36"] = "Sólo empleado\npuedes subir las escaleras.\fPero desde que tu\nvino de muy lejos, toma esto\nrecuerdo.",
  ["TEXT_S62_6CA8"] = "├ë el más\nnuevo de SILPH CO. No está a la venta\nen ninguna parte.",
  ["TEXT_S62_6D34"] = "a mi hija le gusta\nimitar a la gente.\fLa imitación dio\nsu apodo es COPYCAT\naquí en la región.",
  ["TEXT_S62_6D95"] = "mi hija es tan\ncentrado en ella... Ella sólo tiene unos pocos\npocos amigos.",
  ["TEXT_S62_6DD3"] = "ella lo perdió\npequeña la MUÑECA POKé que le regaló un niño\nElla tiene 3 años.\fDesde entonces, ella\nMejoró aún más imitando...",
  ["TEXT_S62_6FDA"] = "{PLAYER}: ¡Hola! tu\n¿Te gusta POKEMON?\f {PLAYER}: Eh, no,\nPregunté.\f {PLAYER}: ¿Eh?\n¡Eres extraño!",
  ["TEXT_S62_7028"] = "COPYCAT: Hum?\nParar de imitar?\fMas esse é o meu\nhobby favorito!",
  ["TEXT_S62_7064"] = "{PLAYER}: ¡Hola!\nEscuché que perdiste tu POKé\nMUÑECA favorita.\f {PLAYER}: Si yo\nEncuéntralo, ¿puedes darme un PASE de tren?\f {PLAYER}: Lo haré\nencuéntralo para ti.\f¿Crees que\n¿Te lo perdiste cuando fuiste a VERMILION CITY?",
  ["TEXT_S62_7116"] = "COPYCAT: ¿Cómo?\fno debería\ndecidir lo que haces?\fpero estoy bien\npreocupada... ¿Y si alguien la encuentra?",
  ["TEXT_S62_717F"] = "COPYCAT: ¡Sí!\n├ë ¡mi MUÑECA POKé de CLEFAIRY!\f¿Viste la lágrima donde\n¿La pierna derecha está cosida? esto es\nla prueba!",
  ["TEXT_S62_71E2"] = "Certo. Aqui está o\nMAGNET TRAIN PASS\vque eu prometi!",
  ["TEXT_S62_7214"] = "COPYCAT: Esse é\no PASS do\vMAGNET TRAIN.\fO homem da\nferrovia me deu\fquando derrubaram\na nossa casa velha\vpara a STATION.",
  ["TEXT_S62_7298"] = "{PLAYER}: ¡Hola!\n¡Muchas gracias por el PASO!\f {PLAYER}: ¿Cómo?\f {PLAYER}: ├ë entonces\n¿Es divertido imitar todo lo que hago?",
  ["TEXT_S62_72F5"] = "COPYCAT: Claro!\n├ë hilário!",
  ["TEXT_S62_7489"] = "ESPELHO, ESPELHO\nMEU, HÁ ALGU├ëM\fMAIS BELA DO QUE\nEU?",
  ["TEXT_S62_74C4"] = "├ë un POKEMON\nraro! ¿Hay?\f├ë solo una muñeca…",
  ["TEXT_S62_7558"] = "Muchas ciudades en\nJOHTO son viejos me encantaría\nvisita!",
  ["TEXT_S62_75BC"] = "Eres de JOHTO,\n¿no es así?\f¿En qué pensaste?\n¿KANTO? ├ë Genial, ¿no estás de acuerdo?",
  ["TEXT_S62_7655"] = "¡iiiaaa!\fsiento un\nSombra siniestra que se cierne sobre ti.\fLleva esto a\nmantenla alejada!",
  ["TEXT_S62_76A7"] = "Estabas en\npeligro de muerte, pero estás protegido.",
  ["TEXT_S62_76DE"] = "a mi abuela le gusta\naleja lo que ella cree que es\nmalos espíritus.\fLo siento si ella\nte asusté.",
  ["TEXT_S63_4042"] = "¿Has visitado el\n¿GIMNASIO DE PEWTER?\fEL LÍDER utiliza\nPOKEMON de piedra.",
  ["TEXT_S63_4080"] = "Por la noche, CLEFAIRY\nven a jugar a MT.MOON.\fPero no todos\nnoche.",
  ["TEXT_S63_40C6"] = "Oh, vienes de\nhasta ahora, de JOHTO?\festo trae\nrecuerdos. Cuando era joven, fui a\nTren JOHTO.\fme recuerdas\nmucho de lo que yo era, tan joven como\nusted.\fquiero que te quedes\ncon un artículo que encontré en JOHTO.",
  ["TEXT_S63_41AA"] = "Ir a lugares\nnovos, conhecer\vgente nova…\fEssa é a alegria\nde viajar.",
  ["TEXT_S63_41FF"] = "CIDADE DE PEWTER\nA Cidade Cinzenta",
  ["TEXT_S63_421E"] = "CIDADE DE PEWTER\nPOKéMON GYM\vLÍDER: BROCK\fO Treinador\nde pedra",
  ["TEXT_S63_425E"] = "Há um aviso…\naqui…\fPEWTER MUSEUM OF\nSCIENCE está\vfechado…",
  ["TEXT_S63_42A9"] = "Hay una advertencia…\nTIENDA DE REGALOS MT.MOON\nya abierto!",
  ["TEXT_S63_42DC"] = "Bem-vindo a\nCIDADE DE PEWTER!",
  ["TEXT_S63_4637"] = "……\n……",
  ["TEXT_S63_463F"] = "……\n……",
  ["TEXT_S63_473F"] = "¡Guau! tu yo\nasustado!\fyo estaba con\nGAFAS NEGRAS, entonces no\nTe noté.\f¿Qué soy yo?\nhaciendo aquí?\fOye, ¿no?\npreocuparse.\fte daré\na BLACKGLASSES, así que olvida que me viste, ¿vale?",
  ["TEXT_S63_480C"] = "BLACKGLASSES\naumenta o poder\vde golpes",
  ["TEXT_S63_49BF"] = "CLARO: lo siento\npor eso.\fToma, acepta esto.\ncomo excusas.",
  ["TEXT_S63_4A0D"] = "Esto contiene\nALIENTO DE DRAGÓN.\fNo, no hay\nnada que ver con mi respiración.\fSi no lo haces\nSi quieres, no es necesario que lo tomes.",
  ["TEXT_S63_4C2E"] = "SANTUÁRIO DRAGÃO\fUm santuário em\nhonra aos POKéMON\fdragão que viveu\nno DRAGON'S DEN.",
  ["TEXT_S63_4C83"] = "…\n¿Qué?  ¿{PLAYER}?\f…No, no lo haré\nbatalla ahora… Mi POKéMON\nno están listos no puedo\nobligarlos ahora.\fnecesito ser\ndisciplinado para convertirse\nel mejor entrenador",
  ["TEXT_S63_4D2D"] = "…\fUfa…\fAprenda a\nse afastar.",
  ["TEXT_S63_4D82"] = "SANTUARIO allí está el\ncasa del MAESTRO de nuestra\nclan de dragones.\fno puedes\n¡entra así!",
  ["TEXT_S63_4E11"] = "Pronto tendré\npermiso de nuestro MAESTRO\nusar arrastrar├Áes.\fcuando esto\npasa, voy a ser entrenador\nadmirable conjunto de dragones y gana el\naprobación de nuestro MAESTRO.",
  ["TEXT_S63_4ED3"] = "fue como pelear\ncontra LANZA.",
  ["TEXT_S63_4F0F"] = "Vamos te\ndenunciar.\fO MESTRE vai\nficar bravo.",
  ["TEXT_S63_4F41"] = "{PLAYER} achou\n{RAM:D099}!",
  ["TEXT_S63_4F51"] = "Pero {PLAYER} \nNo puedo tomar más artículos.",
  ["TEXT_S63_52EA"] = "Mmm… bien por ti\nver aquí.\fNo es necesario\nexplica por qué viniste.\fCLAIR te envió\naquí, ¿verdad?\festa chica da\ntrabajo... lo siento, pero\nTendré que ponerte a prueba.\fNo te preocupes,\nSon sólo unas pocas preguntas.\f¿Listo?",
  ["TEXT_S63_53BC"] = "¿Qué significa POKEMON?\nsignifica para ti?",
  ["TEXT_S63_53D3"] = "O que te ajuda a\nvencer batalhas?",
  ["TEXT_S63_53F3"] = "¿Qué tipo de\nentrenador al que te quieres enfrentar?",
  ["TEXT_S63_5420"] = "O que é mais\nimportante pra\vcriar POKéMON?",
  ["TEXT_S63_544A"] = "POKéMON fortes.\nPOKéMON fracos.\fQual é mais\nimportante?",
  ["TEXT_S63_547C"] = "Um... ya veo... ¿Te importa?\nmucho con POKéMON.\fMuy loable.\fEsta convicción es\n¡Qué importa!\f {PLAYER}, no\nperder esa creencia.\fella te guiará\nIncluso la LIGA POKéMON.",
  ["TEXT_S63_5520"] = "CLARO!\feste niño es\nimpecable, en habilidad y espíritu!\fadmitir la derrota\n¡Y entrega la RISING BADGE!\f...o necesito\n¿Notificar a LANCE sobre esto?",
  ["TEXT_S63_55A3"] = "CLAIR… Reflexiona sobre el\n¿Qué falta en ti y qué es esto?\nel niño tiene.",
  ["TEXT_S63_55E5"] = "Volte quando\nquiser.",
  ["TEXT_S63_5604"] = "Mmm… bien por ti\nver aquí.\ftu llegada es\nmuy oportuno.\ftengo algo\npara ti.\fConsigue este DRATINI\ncomo prueba de que reconocí tu\nvalor.",
  ["TEXT_S63_5697"] = "{PLAYER} recebeu\num DRATINI!",
  ["TEXT_S63_56AC"] = "Hm? Sua equipe\nde POKéMON está\vcheia.",
  ["TEXT_S63_56CA"] = "dragón pokémon\nsimboliza nuestro clan.\fTu demostraste eso\nSe puede confiar en uno.",
  ["TEXT_S63_5724"] = "Parece que CLAIR\naprendí una valiosa lección\ncontigo.\fGracias como abuelo├┤\nella.",
  ["TEXT_S63_5782"] = "Um garoto da sua\nidade está\vtreinando aqui.\fEle é parecido\ncom a CLAIR\fquando jovem. ├ë\num pouco\vpreocupante…",
  ["TEXT_S63_57F6"] = "¿Hay? no entendí\nbueno eso…",
  ["TEXT_S63_5816"] = "¿Qué haces?\n¿De verdad dijiste?",
  ["TEXT_S63_582D"] = "Ah, entendo…",
  ["TEXT_S63_5840"] = "Ha pasado un tiempo desde\nningún entrenador ha ganado lo raro\naprobación de nuestro MAESTRO.\fEn realidad, no\ndesde Maestro LANCE.",
  ["TEXT_S63_58B1"] = "¿Conoces el\n¿Joven Maestro LANCE?\fel parece\nmucho con nuestro MAESTRO cuando era joven.\f├ë cosa\nfamilia.",
  ["TEXT_S63_5916"] = "¿Cómo fue?\fno lo creo\nVale la pena preguntar.\f¿Fallaste?\f…………\f…¿Qué? tu\npasado?",
  ["TEXT_S63_5974"] = "¡No puede ser!",
  ["TEXT_S63_5983"] = "eres tu\nmintiendo!\fYo tampoco\naprobado todavía!",
  ["TEXT_S63_59AE"] = "E-eu entendo…",
  ["TEXT_S63_59BF"] = "Aqui, esta é a\nRISINGBADGE…\fAnda! Pegue logo!",
  ["TEXT_S63_59F2"] = "{PLAYER} recebeu\nRISINGBADGE.",
  ["TEXT_S63_5A0B"] = "RISINGBADGE servirá\nTus POKéMON usan el movimiento.\nescalar cascadas.\fAdemás, todos\nlos POKéMON te reconocerán\ncómo entrenar y obedecer\ntus mandamientos.\fyo también quiero\ntoma esta MT.",
  ["TEXT_S63_5AB4"] = "…………",
  ["TEXT_S63_5B34"] = "Seus POKéMON sabem\ngolpes de HM?\fEsses golpes podem\nser usados mesmo\fse o POKéMON\nestiver desmaiado.",
  ["TEXT_S63_5BEE"] = "O PC do BILL\nguarda até 20\vPOKéMON por BOX.",
  ["TEXT_S63_5C19"] = "¿Conoces el\n¿ALBARICORNIOS?\fAbierto uno, vacío\nadentro y coloque un dispositivo\nespecial.\fEntonces puedes conseguirlo\nPOKéMON con él.\fAntes de POKé\nLAS BOLAS existen, todos las usaban\nALBARICORNIOS.",
  ["TEXT_S63_5D74"] = "Todos os SLOWPOKE\nsumiram\vda cidade.\fO protetor da\nfloresta pode\vestar bravo…\fPode ser mau\nagouro. ├ë melhor\vficar em casa.",
  ["TEXT_S63_5DFD"] = "El lento\nregresaron… Pero mi APRENDIZ\nno regresó de ILEX FOREST.\f¿Dónde estará?\n¿Está suelto?",
  ["TEXT_S63_5E73"] = "Asustaste al\nTEAM ROCKET y se fue solo a ILEX\n¿BOSQUE?\f¡Qué coraje!\nMe gustó. ¡Ven a entrenar con nosotros!",
  ["TEXT_S63_5EE0"] = "¿A dónde fueron?\nel LENTO?\festan bromeando\nen alguna parte?",
  ["TEXT_S63_5F25"] = "Lo siento, lo olvidé\nestar agradecido.\fEsto es CARBON\nque lo hice.\ffuego pokemon\nTe encantará sostener esto.",
  ["TEXT_S63_5F93"] = "El lento\nRegresaste y encontraste a FARFETCH'D.\f¡Tú eres el hombre!\n¡Genial, eh!",
  ["TEXT_S63_5FE5"] = "FARFETCH'D: Kwaa!",
  ["TEXT_S63_604D"] = "No existe un GRAN BALÓN\naquí. Las POKé BALLS tendrán\npara servir.\fOjalá KURT\nHazme unas BOLAS especiales.",
  ["TEXT_S63_60B6"] = "UNA GRAN BOLA es\nMejor atrapar POKéMON que una POKé BOLA.\fPero el ├ace de KURT\nlos tiempos son mejores.",
  ["TEXT_S63_6473"] = "¿Mmm? ¿Quién eres?\f {PLAYER}, ¿verdad? querer\npara que yo haga unas BOLAS?\fLo siento, pero esto\nesperará.\fConozca el EQUIPO\n¿COHETE? Ah, no importa. yo cuento\nde todos modos TEAM ROCKET es\nuna mala pandilla que usa POKéMON para\nel trabajo sucio.\ffue para ellos\nse disolvió hace tres años.\fEn definitiva, están en\nBIEN, cortando SLOWPOKETAILS a\nvender!\fentonces voy allí\n¡Enséñales una dolorosa lección!\fAgárrate fuerte,\n¡LENTO! ¡El viejo KURT se va!",
  ["TEXT_S63_6615"] = "KURT: ¡{PLAYER}!\fte fuiste\ncomo un héroe en el POZO.\f¡Me gustó el estilo!\fseria un honor\nhacer BOLAS para un entrenador\ncomo tú.\f├ë todo lo que tengo\nAhora, pero tómatelo con calma.",
  ["TEXT_S63_66C9"] = "KURT: Eu faço\nBALLS de APRICORN\fColha eles das\nárvores e traga\vaqui.\fEu faço BALLS\ncom eles.",
  ["TEXT_S63_6736"] = "KURT: Tem um\nAPRICORN para mim\fÔtimo! Vou virar\nele numa BALL.",
  ["TEXT_S63_6779"] = "KURT: Va a tomar un\ndía de BOLA.\fVuelve más tarde\npara atrapar.",
  ["TEXT_S63_67BC"] = "KURT: Ah…\nQue decepção.",
  ["TEXT_S63_67D8"] = "KURT: Yo soy\ntrabajando!\v¡No me molestes!",
  ["TEXT_S63_67FB"] = "KURT: Ah, {PLAYER}!\nAcabei de terminar\vsua BALL. Tome!",
  ["TEXT_S63_682A"] = "KURT: Fue muy\nbueno.\fintenta atrapar\nPOKéMON con ella.",
  ["TEXT_S63_6863"] = "KURT: Ahora que\nmi nieta me esta ayudando, yo\ntrabajar mucho más rápido.",
  ["TEXT_S63_68AB"] = "¿Q-qué es esto?\fnunca he visto uno\ncomo estos antes.\fSe parece mucho\nuna POKé BALL, pero parece ser\nalgo más.\fdéjame comprobar\npara ti.",
  ["TEXT_S63_6934"] = "Estou checando\nagora.",
  ["TEXT_S63_6949"] = "Ah-rá! Entendi!\nEntão…",
  ["TEXT_S63_695C"] = "{PLAYER}!\fEssa BALL começou\na tremer enquanto\veu checava.\fDeve ter algo\nnela!",
  ["TEXT_S63_69B5"] = "Os SLOWPOKE se\nforam… Será que\fgente ruim levou\neles?",
  ["TEXT_S63_69F1"] = "O vov├┤ saiu…\nQue solidão…",
  ["TEXT_S63_6A0F"] = "O SLOWPOKE que meu\npai deu voltou!\fA TAIL dele está\ncrescendo!",
  ["TEXT_S63_6A55"] = "mi padre trabaja\nen SILPH, donde estudia POKé BALL.\fme quedo en casa\ncon el abuelo├┤ y SLOWPOKE.",
  ["TEXT_S63_6AB2"] = "ahora ayudo\nabuela├┤!\fHagamos BOLAS\nbien por ti, ¡así que espera!",
  ["TEXT_S63_6B56"] = "SLOWPOKE: …\nBocejo?",
  ["TEXT_S63_6B69"] = "…Um PROF.OAK\njovem?",
  ["TEXT_S63_6B7E"] = "├ë uma estátua do\nprotetor da\vfloresta.",
  ["TEXT_S63_6D0B"] = "¡Tengo errores!\nNunca pierdo cuando se trata de\nEs un POKEMON insecto.\fMi investigación\nconvertirse en la mayor autoridad en\n¡Insecto POKéMON!\fDéjame mostrarte\nque aprendí en mis estudios.",
  ["TEXT_S63_6DAE"] = "¡Guau, increíble!\n¡Eres un experto en POKéMON!\fmi busqueda\nAún no ha terminado.\fEstá bien, ganas\nToma esta INSIGNIA.",
  ["TEXT_S63_6E14"] = "{PLAYER} recebeu\na HIVEBADGE.",
  ["TEXT_S63_6E2B"] = "Conozca el\nventajas de VIHEBADGE?\fCon ella, POKEMON\nhasta L30 te obedecerán.\fpokemon que saben\nCUT podrá utilizar el movimiento fuera del\nbatalla también.\faquí te quiero\nquédate con esto.",
  ["TEXT_S63_6EFA"] = "El TM49 contiene\nCORTADOR DE FURIA.\fSi no cometes errores,\ncada vez se hace más fuerte.\fCuanto más tiempo\nla batalla, mejor se vuelve.\f¿No es genial?\n¡Lo descubrí!",
  ["TEXT_S63_6F98"] = "Los insectos POKéMON son\nprofundo. Hay muchos misterios\npara explorar.\fEstudia el\ntus favoritos.",
  ["TEXT_S63_7053"] = "POKéMON ficam mais\nfortes quando\vevoluem. Sério!",
  ["TEXT_S63_70D3"] = "son tan\nlegal, pero la mayoría\nA las chicas no les gustan los POKEMON insectos.\fNo sé por qué...",
  ["TEXT_S63_717E"] = "Deveria ensinar\na eles melhores\vmovimentos.",
  ["TEXT_S63_71FC"] = "AMY: Eres\nmuy fuerte!",
  ["TEXT_S63_7269"] = "MAYO: Mis errores\nperdido! ¡Qué vergüenza!",
  ["TEXT_S63_7296"] = "¡Oye, retador!\fBUGSY es joven,\npero sabes mucho sobre POKéMON insectos\nde verdad.\fsera dificil\nsin mi consejo.\fVeamos... POKEMON\nA los insectos no les gusta el fuego.\fGolpes voladores\nTambién son súper efectivos.",
  ["TEXT_S63_7359"] = "¡Muy bien! fue un\nhermoso enfrentamiento entre jóvenes\ntalentoso.\fcon gente como\n¡Tú, el futuro de POKéMON es hermoso!",
  ["TEXT_S64_40B0"] = "¡Hola, pequeño! vio\nque eres nuevo en MAHOGANY CITY.\fya que eres nuevo aqui\ntienes que probar un delicioso\n¡RAGECANDYBAR!\fAhora mismo es tuyo\n¡por sólo ┬Ñ300!\v¿Quieres uno?",
  ["TEXT_S64_414A"] = "Ôtimo! Aproveite!",
  ["TEXT_S64_415B"] = "no tienes\ndinero.",
  ["TEXT_S64_4178"] = "Ah, tudo bem…",
  ["TEXT_S64_4188"] = "no tienes\nespacio para esto.",
  ["TEXT_S64_41A6"] = "EL RAGECANDYBAR\nagotado.\fEstoy cerrando.\nNo me molestes, pequeño.",
  ["TEXT_S64_41E5"] = "Vai lá ver o\nGYARADOS em fúria\vno LAKE?",
  ["TEXT_S64_421D"] = "Os MAGIKARP\nvoltaram para o\vLAKE OF RAGE.\fDeve ser uma boa\nnotícia para os\vpescadores de lá.",
  ["TEXT_S64_4276"] = "Desde que llegaste\naquí aprovecha para pasear\npoco.\fIr al norte\ny echa un vistazo al LAGO DE LA RAGE\nahora mismo.",
  ["TEXT_S64_42F2"] = "visita la tienda\nAbuelo. Ella vende cosas que la mayoría\nnadie lo ha hecho.",
  ["TEXT_S64_432E"] = "CIDADE DE MAHOGANY\fBem-vindo ao Lar\ndos Ninjas",
  ["TEXT_S64_435E"] = "Em CIDADE DE\vMAHOGANY,\nProve um\vRAGECANDYBAR!",
  ["TEXT_S64_4391"] = "CIDADE DE MAHOGANY\nGINÁSIO POKéMON\vLÍDER: PRYCE\fO Mestre da\nDureza do Inverno",
  ["TEXT_S64_4790"] = "Espera aí!\nQual é a pressa?",
  ["TEXT_S64_47AB"] = "{PLAYER}, ¿verdad?\nUn chico con gafas estaba mirando\npara ti.\fVe a verlo por ti mismo.\nTe espera en el CENTRO\nPOKÉMON.",
  ["TEXT_S64_48B0"] = "¿Alguna vez has estado en\n¿GIMNASIO POKEMON?\fPuedes probar tu\nPOKéMON y tú mismo allí.\f├ë un rito de\npase para cada entrenador!",
  ["TEXT_S64_4925"] = "tienes bien\nPOKéMON allí.\fdebe ser del entrenamiento\nque les diste por\nCIUDAD VIOLETA.\fla formación en\nEl GYM debe haber ayudado mucho.\nIndudablemente.\fComo recordatorio de\nCIUDAD VIOLETA, toma esto.\fAumenta la fuerza\nde ataques de plantas.",
  ["TEXT_S64_4A15"] = "O que viveu em\nCIDADE DE VIOLET\fdeve ser útil na\nsua jornada.",
  ["TEXT_S64_4A59"] = "¿Qué tal tomar\nEs delicioso y nutritivo.\n¿COLA LENTA?\fPara ti ahora,\n¡solo ┬Ñ1,000,000!\f¡Lo querrás!",
  ["TEXT_S64_4ACF"] = "Tsc! Pensei que\na molecada de hoje\vtinha dinheiro…",
  ["TEXT_S64_4AFC"] = "¿No lo quieres? entonces\nfuera de aquí. X├┤!",
  ["TEXT_S64_4B4E"] = "Calmo, concentrado\nA essência da\fpesca e dos\nPOKéMON é a\vmesma.",
  ["TEXT_S64_4BDA"] = "Tch! Quis apressar\nas coisas…",
  ["TEXT_S64_4BF8"] = "Pescar é paixão\nde uma vida.\fPOKéMON são amigos\nde uma vida!",
  ["TEXT_S64_4DF2"] = "POKÉMON\nLos recién capturados no son rival para los buenos.\ncreado.",
  ["TEXT_S64_4E82"] = "intentaré ser el\nmejor con mis favoritos.\fNo uso los mismos\nPOKéMON fuertes que todos usan.",
  ["TEXT_S64_4F49"] = "O mato está cheio\nde coisa grudenta",
  ["TEXT_S64_4FAA"] = "Si no quieres\nPelea, evita mirar a los ojos.",
  ["TEXT_S64_503E"] = "Ah! Preciso\ndescontar minha\vraiva!",
  ["TEXT_S64_5060"] = "E eu estava numa\nboa conversa.",
  ["TEXT_S64_50D4"] = "Eu devia treinar\nde novo no GINÁSIO\vde CIDADE DE\vVIOLET.",
  ["TEXT_S64_5133"] = "¡GUAUAR!\n¡LA GENTE HUYE CUANDO RUJO! PERO TÚ\n¡VEN DETRÁS!\f¡ESTO ME AGRADE!\n¡AHORA TOMA ESTO!",
  ["TEXT_S64_518C"] = "WROOOAR!\n├ë O ROAR!\fAT├ë POKéMON FOGEM\nDE UM BOM ROAR!",
  ["TEXT_S64_51C1"] = "FRIEDA: Oba!\n├ë sexta-feira!\fSou a FRIEDA de\nsexta!\fPrazer!",
  ["TEXT_S64_5204"] = "Aquí, un VENENO\nBARBA para ti!",
  ["TEXT_S64_5222"] = "FRIEDA: Dê a um\nPOKéMON que tenha\vataques venenosos\fOh!\f├ë cruel!\fVai se espantar\ncom o quanto\vmelhora eles!",
  ["TEXT_S64_529A"] = "FRIEDA: ¡Hola! que\ndía te gusta?\fMe encanta el viernes.\n¡Indudablemente!\f¿No crees?\ngenial también?",
  ["TEXT_S64_52FF"] = "FRIEDA: Hoy no.\n¿Es viernes?\f├ë tan aburrido\ncuando no lo es!",
  ["TEXT_S64_533A"] = "ROTA 32\fCIDADE DE VIOLET\nCIDADE DE AZALEA",
  ["TEXT_S64_535E"] = "RUINS OF ALPH\nENTRADA LESTE",
  ["TEXT_S64_537B"] = "UNION CAVE\nEm frente",
  ["TEXT_S64_5496"] = "estoy pescando\nDUDE, el mayor de los FISHING BROS.\f¿Alguna vez has conocido\n¿El GURU DE LA PESCA en LAKE OF RAGE?\fel sueña con ver\nEl MAGIKARP más grande del mundo.\fSi no te importa,\npuede mostrarle cualquier MAGIKARP\n¿Qué pescas?\fquien te conoce\nconsigue el MAGIKARP de sus sueños.",
  ["TEXT_S64_55A3"] = "├ë uma foto de\ngente pescando…\fParecem estar\nse divertindo…",
  ["TEXT_S64_5620"] = "UN POKEMON es\ndurmiendo frente a la CUEVA DE DIGLETT.\f├ë una oportunidad\nIncreíble de atrapar, pero cómo despertar.\n¿él?",
  ["TEXT_S64_5698"] = "Antes tinha um\nPOKéMON dormindo\fbem na frente da\nDIGLETT'S CAVE.\fMas parece que\nele sumiu.",
  ["TEXT_S64_56FE"] = "O FAST SHIP é um\nótimo lugar para\fachar e enfrentar\ntreinadores.",
  ["TEXT_S64_573B"] = "¿Eh? ¿Tienes algunos\nINSIGNIAS Nunca las he visto.\fAh, lo sé. tu\npillado en JOHTO.",
  ["TEXT_S64_5881"] = "SOY EL PRESIDENTE\ndel CLUB DE FANS DE POKEMON.\fHe creado más de\n150 POKÉMON.\festoy bien\nexigente cuando se trata de POKéMON Viniste solo para\n¿Has oído hablar de mis POKéMON?",
  ["TEXT_S64_5911"] = "¡Excelente!\n¡Así que escucha!\fBueno… mi RAPIDASH\nfavorito… Él… lindo… hermoso…\ninteligente... también... y... increíble... ah... ¿crees?... Demasiado... salvaje... hermoso... amable... ¡Lo amo!\fAbrazo…cuando…\nduerme... cálido... y esponjoso... Ah, y... espectacular... deslumbrante... divino... ¡Ups! ¡Mira la hora!\v¡Te retuve demasiado tiempo!",
  ["TEXT_S64_5A3D"] = "gracias por mi\nescucha. I want you to have this!",
  ["TEXT_S64_5A72"] = "├ë un CARAMELO RARO\nlo que hace a POKéMON más fuerte.\fprefiero irme\nmis fuertes peleando, así que\nQuédate con él.",
  ["TEXT_S64_5AE0"] = "¡Hola, {PLAYER}!\fvino a verme\n¿Eres nuevo en hablar de mi POKéMON?\f¿No? Oh... tuve\nmás historias…",
  ["TEXT_S64_5B38"] = "Que decepção…\fVolte se quiser\nouvir.",
  ["TEXT_S64_5B6D"] = "NUESTRO PRESIDENTE\nHabla demasiado cuando se trata de POKéMON...",
  ["TEXT_S64_5BA0"] = "Eu amo o jeito\nque o CLEFAIRY\fbalança o dedo\nquando vai usar\fMETRONOME.\n├ë tão adorável!",
  ["TEXT_S64_5BFF"] = "Eu amo CLEFAIRY,\nmas nunca peguei\fum. Então me viro\ncom uma\fPOKé DOLL que eu\nachei.",
  ["TEXT_S64_5C5A"] = "Vale, lo entiendo. un\nLa chica que perdió esta MUÑECA sufre… Cierto. tu tomas\nesta MUÑECA POKé volver a\n¿pobrecito?\ftodavía lo hago\namistad con una CLEFAIRY un día.\n¡Ningún problema!",
  ["TEXT_S64_5D0A"] = "{PLAYER} recebeu\nPOKé DOLL.",
  ["TEXT_S64_5D1E"] = "Ya verás. yo\nConseguiré un CLEFAIRY de\namigo la verdad.",
  ["TEXT_S64_5D58"] = "Sua BOLSA está\nlotada.",
  ["TEXT_S64_5D73"] = "mira mi cariño\n¡BAYLEEF!\fLa hoja en la cabeza\n¡El suyo es tan lindo!",
  ["TEXT_S64_5DB1"] = "├ë um CLEFAIRY!\nHã?\fAh, é mesmo. ├ë uma\nPOKé DOLL de\vCLEFAIRY.",
  ["TEXT_S64_5DE9"] = "├ë um CLEFAIRY!\nHã?\fAh, é mesmo. ├ë uma\nPOKé DOLL de\vCLEFAIRY.",
  ["TEXT_S64_5DFC"] = "Vamos ouvir os\noutros treinadores\vcom educação.",
  ["TEXT_S64_5E29"] = "Si alguien se jacta,\n¡Presumir también!",
  ["TEXT_S64_5EC0"] = "¿Conoces el\n¿TREN IMÁN?\f├ë un ferrocarril\nque va a GOLDENROD, JOHTO.",
  ["TEXT_S64_5F16"] = "quiero ir a azafrán\npara ver el TREN IMÁN.",
  ["TEXT_S64_5F8B"] = "COHETE DEL EQUIPO\ndesapareció de KANTO.\feso es todo lo que tengo\nte hace feliz.",
  ["TEXT_S64_5FCA"] = "Estou pensando em\nfazer compras em\vSAFFRON.",
  ["TEXT_S64_6034"] = "Ao longo de anos,\nos DIGLETT cavaram\vum túnel enorme.\fEsse túnel vai\na uma vila longe.",
  ["TEXT_S64_6142"] = "SURGE: Oye, tú\n¡mocoso!\fTengo que admitirlo.\fPuede que no sea mucho\nEs inteligente desafiarme, ¡pero necesitas coraje!\fCuando el tema es\nPOKéMON eléctrico, ¡soy el número uno!\fnunca perdí en\ncampo de batalla.\fte electrocutaré\n¡Tal como lo hice con mis enemigos en la guerra!",
  ["TEXT_S64_6238"] = "OLEADA: ¡Arrrgh!\n¡Eres fuerte!\fBien. tuyo\n¡INSIGNIA DEL TRUENO!",
  ["TEXT_S64_6277"] = "{PLAYER} recebeu\na THUNDERBADGE.",
  ["TEXT_S64_6291"] = "Surge: A\nTHUNDERBADGE aumenta la velocidad.\fConsidere esto como\nprueba de que me ganaste. Usar con\norgullo, ¿oyes?",
  ["TEXT_S64_6303"] = "SURGE: ¡Oye, chico!\n¿Sigues trabajando duro ahí fuera?\fYo y mi POKEMON\n¡nosotros también lo somos!",
  ["TEXT_S64_63B0"] = "cuando yo estaba\nen el ejército, LT.SURGE salvó\nmi vida.",
  ["TEXT_S64_644B"] = "si las trampas\ntrabajado, ya estarías\nfrito…",
  ["TEXT_S64_64D6"] = "Nada que encontrar\npor golpearme.\fLT.SURGE es muy\nduro.",
  ["TEXT_S64_6517"] = "¡Ey! Futuro\n¡CAMPEÓN!\ftuviste suerte\nesta vez.\fLT.SURGE es muy\ncauteloso.\fhay trampas\ntodo el GIMNASIO.\fPero, je, je, el\nlas trampas no están activadas.\fno tendrás\nproblema para llegar a él.",
  ["TEXT_S64_65DF"] = "Ufa! Que combate\neletrizante!\fMe deixou mesmo\nnervoso.",
  ["TEXT_S64_661E"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_S64_66FE"] = "Bienvenido ├á\n¡SAFFRON CITY, hogar del TREN IMÁN!\f…├ë que diría\nnormalmente, pero el TREN MAGNÉTICO\nno está funcionando.\fel no recibe\nelectricidad porque hay algo\nmal con el poder\nPLANTA.",
  ["TEXT_S64_67CB"] = "O MAGNET TRAIN\né a coisa mais\ffamosa de\nSAFFRON.",
  ["TEXT_S64_6DE0"] = "Bienvenido a CABLE\nCOLISEO DEL CLUB.\fAquí luchas\ncon un amigo.\fquieres\nbatalla?",
  ["TEXT_S64_6E3A"] = "Bienvenido a CABLE\nCLUB TRADE CENTER Aquí usted comercia\ntu POKéMON con un amigo.\fquieres\n¿intercambio?",
  ["TEXT_S64_6E9F"] = "Bienvenido a CABLE\nCÁPSULA DEL TIEMPO DEL CLUB Puedes viajar a\nPasa e intercambia tus POKéMON.\f¿Quieres intercambiar?\ncon el pasado?",
  ["TEXT_S64_6F19"] = "tu amigo no\nestá listo.",
  ["TEXT_S64_6F34"] = "Antes de abrir el\nconexión, tienes que guardar.",
  ["TEXT_S64_6F67"] = "Aguarde um pouco.",
  ["TEXT_S64_6F75"] = "A conexão foi\nfechada por falta\vde atividade.\fFale com o seu\namigo e volte\voutra hora.",
  ["TEXT_S64_7029"] = "no puedo llamar\nal pasado aquí.",
  ["TEXT_S64_704A"] = "Las habitaciones no son\ncompatibles.",
  ["TEXT_S64_706B"] = "Pode entrar.",
  ["TEXT_S64_7100"] = "Lo siento, el\nLA CÁPSULA DEL TIEMPO se está ajustando.",
  ["TEXT_S64_712F"] = "Lo siento, el\nLa MÁQUINA DE COMERCIO está en ajuste.",
  ["TEXT_S64_715F"] = "Lo siento, el\nBATTLE MACHINE está en ajuste.",
  ["TEXT_S64_7190"] = "¡Hola! tu eres el\n {PLAYER}, ¿verdad?\ftengo uno\ncosa para ti.",
  ["TEXT_S64_71C4"] = "Aqui está!",
  ["TEXT_S64_71D2"] = "esperamos servir\ntú otra vez.",
  ["TEXT_S64_71EF"] = "Oh, no tienes\nespacio para esto.\fPase cualquier\nCENTRO POKéMON del país para\nrecógelo más tarde.",
  ["TEXT_S64_724D"] = "¿No? eso esta bien\nextraño...",
  ["TEXT_S64_74A0"] = "O seu amigo\nestá pronto.",
  ["TEXT_S64_7521"] = "O seu amigo\nestá pronto.",
  ["TEXT_S64_7591"] = "Estabelecendo\ncomunicação…",
  ["TEXT_S64_7626"] = "Estabelecendo\ncomunicação…",
  ["TEXT_S64_7644"] = "Seus POKéMON\nserão totalmente\vcurados antes\vda batalha.",
  ["TEXT_S65_426B"] = "E uma árvore\nestranha?",
  ["TEXT_S65_4290"] = "{PLAYER} usou o\nSQUIRTBOTTLE.",
  ["TEXT_S65_42AA"] = "el árbol extraño\n¡No me gusta SQUIRTBOTTLE!\fel árbol extraño\natacado!",
  ["TEXT_S65_42F1"] = "soy FLORIA,\nde FLORES!\f¡Escucha, escucha!\fcuando tiré agua\nen ese árbol que se mueve, ella\nsaltó!\ftiene que ser uno\nPOKÉMON.\fApuesto a que ella\nsaldría del disfraz si tomara uno\nbaño!\f¡Ya lo sé! te lo diré\na mi hermana y coger la botella\nde su agua!",
  ["TEXT_S65_446F"] = "¡Oye!\fme rompería\neste árbol con mi puñetazo\ndirecto.\f¡Pero no pude!\n¡Soy un fracaso!",
  ["TEXT_S65_44D0"] = "tomaste\nese árbol?\f¡Impresionado!\nQuiero que tengas esto.",
  ["TEXT_S65_452C"] = "Eso y ROCK SMASH.\nPuedes romper rocas con uno.\nsólo un golpe bien dirigido.\nSi hay piedras en tu camino,\n¡simplemente rómpelos todos!",
  ["TEXT_S65_4626"] = "un arbol\nestá bloqueando el camino a la CIUDAD DE\nVARA DE ORO.\vMe impide comprar.\nAlguien debe actuar.",
  ["TEXT_S65_469E"] = "Aquela árvore\ndesapareceu sem\vrastro.\fAh! Aquela árvore\nera um POKéMON?",
  ["TEXT_S65_471E"] = "yo seria fuerte\nSi pudiera saber cuál es mi oponente\nestá pensando.",
  ["TEXT_S65_4790"] = "Ops! Erro de\ncálculo?",
  ["TEXT_S65_47AA"] = "Droga. Estudio 5\nhoras/día también.\fHay muchas cosas\nque no se puede aprender simplemente leyendo libros.",
  ["TEXT_S65_4800"] = "ARTURO: ¿Quién es?\n¿tú?\fSoy ARTHUR de\nJueves.",
  ["TEXT_S65_482D"] = "Aquí. tu puedes\nQuédate con eso.",
  ["TEXT_S65_4847"] = "ARTURO: UN POKEMON\nque usa movimientos tipo roca\ndeberías quedarte con esto.\nGolpes de piedra.",
  ["TEXT_S65_48AA"] = "ARTHUR: Sou ARTHUR\nde quinta-feira.\fSou o segundo\nde sete crianças.",
  ["TEXT_S65_48F3"] = "ARTUR: Hoy no.\nEs jueves.\vQué decepción.",
  ["TEXT_S65_4924"] = "ROTA 36",
  ["TEXT_S65_492E"] = "RUÍNAS DE ALPH\nENTRADA NORTE",
  ["TEXT_S65_494C"] = "TRAINER TIPS\fStatus de POKéMON\nvariam , mesmo\vdentro da mesma\fespécie. Seus\nstatus podem\fser parecidos. Mas\nas diferenças\fse tornar claras\nconforme crescem.",
  ["TEXT_S65_49EE"] = "TRAINER TIPS\fUse DIG para ir\n├á entrada de\vqualquer lugar.\f├ë conveniente\npara explorar\fcavernas e outros\nlugares assim.",
  ["TEXT_S65_4B45"] = "Uno de la ÉLITE\nCUATRO fue una vez el LÍDER DEL GIMNASIO\nde FUCSIA.",
  ["TEXT_S65_4B83"] = "A filha do KOGA\nvirou o LÍDER do\fGINÁSIO depois\nque ele entrou no\vELITE FOUR.",
  ["TEXT_S65_4BD3"] = "A SAFARI ZONE está\nfechada… Que\fpena, era a\nmaior atração\vde FUCHSIA.",
  ["TEXT_S65_4C22"] = "CIDADE DE FUCHSIA\fVeja! ├ë o Rosa\nda Paixão!",
  ["TEXT_S65_4C4A"] = "CIDADE DE FUCHSIA\nPOKéMON GYM\vLÍDER: JANINE\fA Mestra Ninja\ndos Venenos",
  ["TEXT_S65_4C8B"] = "Há um aviso…\nO ESCRITÔRIO da\fSAFARI ZONE está\nfechado até\vnovo aviso.",
  ["TEXT_S65_4CD5"] = "SAFARI ZONE\nCASA do GUARDIÃO",
  ["TEXT_S65_4CF0"] = "EL GUARDIÁN es\nen el extranjero.\fPor lo tanto, el\nZONA SAFARI está cerrada.",
  ["TEXT_S65_4D37"] = "No tires basura.\fToma tu basura\ncontigo.",
  ["TEXT_S65_4EFA"] = "Soy CLARO. yo soy\nEl mejor maestro de dragones del mundo.\nPuedo rivalizar incluso con los CUATRO\nLIGA POKéMON A LO GRANDE.\n¿Aún quieres desafiarme?\n…Todo está bien.\f¡Vamos!\nComo entrenador, utilizaré el máximo\ncontra oponente!",
  ["TEXT_S65_4FD6"] = "¿Perdí?\fNo lo creo.\nDebe haber un error...",
  ["TEXT_S65_500E"] = "no lo admitiré\nesto.\fPuede que haya sido\nderrotado, pero todavía no lo haces\nestá listo para la LIGA POKéMON.\nLo sé. Deberías hacer el desafío del usuario.\ndragón.\vDetrás de este GYM hay un lugar\nllamada GUARDA DEL DRAGÓN.\nVe y tráeme el COLMILLO DE DRAGÓN\ndel fondo DEN.\festa es la prueba\nser aceptado como un\nverdadero usuario de dragones.\vSi puedo lo acepto\ncomo entrenador.\v¡Hasta entonces, INSIGNIAS!",
  ["TEXT_S65_5196"] = "me dejaste\nesperando!\f¡Tómalo! quédate con\nesto!",
  ["TEXT_S65_51D1"] = "Esto contiene\nALIENTO DE DRAGÓN.\fNo, no hay\nnada que ver con mi respiración.\fSi no lo haces\nSi quieres, no es necesario que lo tomes.",
  ["TEXT_S65_5272"] = "¿Cuál es el problema?\fno va\n¿Para la LIGA POKéMON?\fNo se donde\nquedarse?\fDesde aquí, ve a\nNUEVA CIUDAD DE LA CORTE.\fLuego usa SURF\nal este.\fel camino esta bien\ndifícil.\fNi siquiera pienses en\n¡pierde en la LIGA POKéMON!\fSi pierdo, lo haré\nsentirme aún peor por haber perdido\npara ti!\fda todo lo que tu\ntienes.",
  ["TEXT_S65_53F1"] = "O LANCE disse que\nquer te ver de\vnovo?\fSem chance!",
  ["TEXT_S65_5467"] = "Ahora conozco mi\nlimitaciones.\fgracias por mi\nmostrar!",
  ["TEXT_S65_5516"] = "Drag├Áes são fracos\ncontra movimentos\vde dragão.",
  ["TEXT_S65_5544"] = "¡Ey!\n¡FUTURO CAMPEÓN!\nHa pasado un tiempo desde que empezamos, pero\n¡Ya casi llegamos! ¡Cuenta conmigo!\nCLAIR utiliza dragones míticos y sagrados de tipo dragón.\fno puedes\nles duele fácilmente.\nPero debes saber que son débiles.\ncontra el hielo.",
  ["TEXT_S65_5632"] = "estuviste increíble\nal vencer a CLAIR!\fLo único que falta es el desafío.\nde la LIGA POKEMON.\vEstás en camino a\n¡Conviértete en el CAMPEÓN POKéMON!",
  ["TEXT_S65_57D5"] = "Los miembros de la\nNuestro clan solo usa POKéMON dragón.\ndespués que el MAESTRO lo permita.",
  ["TEXT_S65_5883"] = "Ai… A CLAIR vai\nficar brava…",
  ["TEXT_S65_58A5"] = "O bloco caiu!\npelo buraco!",
  ["TEXT_S65_595C"] = "un clan de\nLos entrenadores que dominan los drags viven aquí en BLACKTHORN.\fPor eso hay\nHay muchas leyendas sobre dragones en esta ciudad.",
  ["TEXT_S65_59EE"] = "DRATINI: Draa!",
  ["TEXT_S65_5A6A"] = "no puedo comprar\nMAX REVIVE, pero restaura todo\nPOKéMON se desmayó Ten cuidado, no\nrestaura PP, TOMAS DE CORRIENTE\nnecesario.",
  ["TEXT_S65_5AE9"] = "MAX REPEL mantiene\nPOKéMON débiles lejos de ti.\fY el más duradero\nde aerosoles REPEL.",
  ["TEXT_S65_5B85"] = "Lá no fundo do\ndistante INDIGO\vPLATEAU fica a\vPOKéMON LEAGUE.\fOuvi dizer que os\nmelhores\ftreinadores do\npaís se reúnem lá.",
  ["TEXT_S65_5BFD"] = "Havia um movimento\nque eu tinha que\fensinar ao meu\nPOKéMON.\fEntão pedi ao\nAPAGADOR DE GOLPES\vesquecer um HM.",
  ["TEXT_S65_5CF5"] = "Eu queria comprar\nlembranças da\fSAFARI ZONE, mas\nestá fechada…",
  ["TEXT_S65_5D36"] = "A neta do WARDEN\nda SAFARI ZONE\vmora aqui\vna cidade.",
  ["TEXT_S65_5F35"] = "Fufufufu... lo siento\ndecepcionarte… ├ë ¡es broma!\f¡Yo soy el verdadero!\fJANINE, de GINÁSIO\nde FUCSIA!",
  ["TEXT_S65_5FA1"] = "JANINE: Eres\nduro. Definitivamente ganaste... Toma, SOULBADGE.\nTómalo.",
  ["TEXT_S65_5FEB"] = "{PLAYER} recebeu\na SOULBADGE.",
  ["TEXT_S65_6002"] = "JANINE: Eres\nmuy fuerte! ¡Tengo un regalo!\f├ë TÓXICO, un veneno\npoderoso que se come el PS\nde la víctima.",
  ["TEXT_S65_6074"] = "janine: lo haré\ndedicarme y mejorar\nmis técnicas.\fquiero mejorar\nque mi padre y que tu!",
  ["TEXT_S65_60E6"] = "¡Fuffufu!\fsoy janine,\nel LÍDER!\f¡No, no lo soy!\n¡Caí, tonto!",
  ["TEXT_S65_6126"] = "Eu te enganei…",
  ["TEXT_S65_6139"] = "como estas\n¿Descubrir quién es el verdadero LÍDER?",
  ["TEXT_S65_6166"] = "Te enganei!\nHahaha!",
  ["TEXT_S65_617B"] = "Oh... perdí...\nNo eres débil...",
  ["TEXT_S65_61BB"] = "¡Soy JANINE!\f¿Cómo lo supiste?\nque yo era real?\f¡Luchemos!",
  ["TEXT_S65_61F1"] = "Droga!\nEu queria ganhar!",
  ["TEXT_S65_620C"] = "debes ser\ncansándose.",
  ["TEXT_S65_6228"] = "Uahahaha!\fPode crer, cara.\nEu sou a JANINE!",
  ["TEXT_S65_624A"] = "mi disfraz era\nperfecto! ¡Droga!",
  ["TEXT_S65_626B"] = "Oye, hombre. mio\nEl disfraz era lindo o no, ¿eh?",
  ["TEXT_S65_6299"] = "Ei, futuro\nCAMPEÃO!\fOpa! Dê uma boa\nolhada em volta.\fOs treinadores são\ntodos iguais ├á\vLÍDER, a JANINE.\fQual deles é a\nJANINE real?",
  ["TEXT_S65_6325"] = "Foi uma batalha\ne tanto, treinador\vde JOHTO!",
  ["TEXT_S65_63C3"] = "Mi abuelo├┤ está en\nla casa de mi hermano BILL, en CERULEAN",
  ["TEXT_S65_63F9"] = "Eu vi uns POKéMON\nestranhos e lentos\vna CYCLING ROAD.",
  ["TEXT_S65_6494"] = "¡Ey! ¿Tienes un\nPOKéDEX de un tipo completamente nuevo.\fEra PROF.ROBLE\n¿Qué te dio?",
  ["TEXT_S65_64DC"] = "Levei um susto\nno GINÁSIO.\fTinha um monte de\nmeninas que eram\vtodas iguais.",
  ["TEXT_S65_652E"] = "Eu sou a JANINE!\nAbracadabra… Puf!",
  ["TEXT_S65_654E"] = "Viu? Agora eu sou\nigualzinha a ela!",
  ["TEXT_S65_65E6"] = "Mi abuelo├┤ es\nGUARDIÁN de ZONA SAFARI.\f¿O fue...? Decidió tomarlo.\nvacaciones y salí\ndel país solo.\fSAFARI abandonado\nZONA así, salida de la nada.",
  ["TEXT_S65_6691"] = "mucha gente se quedo\ndecepcionado con ZONA SAFARI\ncerrado, pero v├┤ es demasiado terco…",
  ["TEXT_S65_66EA"] = "├ë a foto de um\nvelho sorridente\fcercado de\nPOKéMON.",
  ["TEXT_S65_6726"] = "├ë a foto de uma\nplanície enorme\fcom POKéMON raros\nbrincando nela.",
  ["TEXT_S65_67A1"] = "estas haciendo\n¿Una POKéDEX?\fEso es bastante.\n¡No te rindas!",
  ["TEXT_S65_6834"] = "Acabaram as\nPOKé BALLS!\fQuando será que\nchegam mais?",
  ["TEXT_S65_6873"] = "Hay POKé BOLAS en\nabastecerse! ¡Ahora puedo conseguirlo!",
  ["TEXT_S65_68A0"] = "Quando eu andava\nno mato, um\fPOKéMON inseto\nenvenenou o meu!\fEu segui andando,\nmas aí o meu\vPOKéMON desmaiou.\f├ë bom andar com um\nANTIDOTE.",
  ["TEXT_S65_698A"] = "├ë ótimo. Posso\nguardar quantos\fPOKéMON eu quiser,\ne é tudo de graça.",
  ["TEXT_S65_69C8"] = "Aquele PC é livre\npara qualquer\vtreinador usar.",
  ["TEXT_S65_69F1"] = "EL CENTRO DE\nCOMUNICACIÓN Es nuevo ahí arriba.\fPero todavía están\nacabar con él.",
  ["TEXT_S65_6A46"] = "EL CENTRO DE\nCOMUNICACIÓN Es nuevo ahí arriba.\fYa cambié POKéMON\nahí!",
  ["TEXT_S65_6AEA"] = "¿Quieres ver el\nque bueno es como entrenador\nde POKEMON?\f├ë mejor visita\nlos GIMNASIOS por todo JOHTO y\nañadir INSIGNIAS.",
  ["TEXT_S65_6B65"] = "Cuando sea mayor,\n¡Voy a ser LÍDER DE GIMNASIO!\fle puse mi POKéMON\npelear con su amigo y\nponlos duros.",
  ["TEXT_S65_6C0D"] = "Quando eu era\npequeno, eu era um\vtreinador craque!\fVai um conselho:\npegue um monte\vde POKéMON!\fTrate todos eles\ncom bondade!",
  ["TEXT_S65_6CC3"] = "POKéMON ganha\nexperiência em\fbatalha e muda\nde forma.",
  ["TEXT_S65_6CFC"] = "POKéMON muda?\fEu ia levar um\nsusto se mudasse!",
  ["TEXT_S65_6D82"] = "ya sabes pokemon\ncomer BAYAS.\fBueno, mi POKEMON\nSe hizo más fuerte comiendo un BERRY Toma. voy a compartir\nuno contigo!",
  ["TEXT_S65_6DEC"] = "mira los arboles\ndetrás de BAYAS.\vSimplemente caen.",
  ["TEXT_S65_6F66"] = "¡Hola, hola! tu\ndebería ser {PLAYER}.\fPROF.ELM dijo\nque vendrías.",
  ["TEXT_S65_6FA8"] = "Esto es lo que yo\nQuiero que el PROF.ELM lo examine.",
  ["TEXT_S65_6FD2"] = "{PLAYER} recebeu\no MYSTERY EGG.",
  ["TEXT_S65_6FEB"] = "Conheço um casal\nque cuida de um\vDAY-CARE.\fForam eles que me\nderam esse EGG.\fFiquei intrigado,\nentão mandei uma\vcarta ao ELM.\fEm evolução de\nPOKéMON, o ELM\vé a autoridade.",
  ["TEXT_S65_7092"] = "Até o PROF.OAK\naqui reconhece.",
  ["TEXT_S65_70B7"] = "si mi idea\nSi tienes razón, el ELM lo sabrá.",
  ["TEXT_S65_70ED"] = "volverás\nal PROF.ELM?\fAquí. Tu POKEMON\nnecesitan un descanso.",
  ["TEXT_S65_7134"] = "estoy contando\ncontigo!",
  ["TEXT_S65_714A"] = "A vida é uma\ndelícia! Sempre\fnovas descobertas\npara fazer!",
  ["TEXT_S65_7185"] = "ROBLE: ¡Ajá! entonces\n¡Eres {PLAYER}!\f¡Soy ROBLE! uno\ninvestigador.\festaba solo\nvisitando a mi amigo MR.POKéMON.\fescuché que tu\nLe estaba haciendo un favor al PROF.ELM,\ny esperé aquí.\f¡Oh! ¿Qué es esto?\n¡Un POKéMON raro!\fVeamos... Mmmm, ¡lo entiendo!\fentiendo por qué\nPROF.ELM te dio un POKéMON para\nesta tarea.\fPara investigadores\ncomo PROF.ELM y yo, POKéMON somos\nnuestros amigos.\fEl vio que tu\nTrataría a tu POKéMON con amor.\ny cuidado.\f… ¡Ah!\fpareces ser\ndigno de confianza.\f¿Qué hay de ti?\nayudarme?\f¿Vio? Este es el\nversión más reciente de POKéDEX.\fElla graba sola\nlos datos del POKéMON que tienes\nvisto o atrapado.\f├ë una enciclopedia\n¡vanguardia!",
  ["TEXT_S65_73CC"] = "{PLAYER} recebeu\na POKéDEX!",
  ["TEXT_S65_73DE"] = "ve a conocer muchos\ntipos de POKéMON y completa este\n¡POKÉDEX!\fpero me quedé\ndemasiado tiempo.\ftengo que ir a\nVARILLA DE ORO para mi programa.\f {PLAYER}, soy\ncontando contigo!",
  ["TEXT_S65_7476"] = "¿Mmm? ¡Esa ESCALA!\n¿Qué es eso?\v¿GYARADOS rojos?\f¡Esto es raro!\nYo, quiero… {PLAYER}, quiero\ncomerciar conmigo?\fpuedo ofrecer\neste EXP.SHARE que obtuve de OAK.",
  ["TEXT_S65_750D"] = "Qué decepción.\nResulta que esto es bastante raro.",
  ["TEXT_S65_7543"] = "Está cheio de\nrevistas de fora.\fNem dá para ler\nos títulos…",
  ["TEXT_S65_7584"] = "├ë um computador\ngrande. Hum. Está\vquebrado.",
  ["TEXT_S65_75AC"] = "Um monte de moedas\nestranhas!\fTalvez sejam de\noutro país…",
  ["TEXT_S65_763A"] = "Hola hombre!\n¿Has visitado SPROUT TOWER?",
  ["TEXT_S65_7661"] = "Eu vim longe\ndemais. Melhor\vligar para casa!",
  ["TEXT_S66_414D"] = "...dime uno\ncosa.\f├ë es cierto que el\n¿El equipo ROCKET ha vuelto?\f¿Qué? tu\n¿Ganaste? ¡Ja! Deja de mentir.\f¿En serio?\nAsí que veamos cuánto vales.",
  ["TEXT_S66_41E6"] = "…¡Huh! POKÉMON\ninútil!\fEscuche aquí. tu\nSolo gané porque mi POKéMON\neran débiles.",
  ["TEXT_S66_4233"] = "Odio a los débiles.\fPOKÉMON,\nentrenadores. No importa quién o qué.\fMe mantendré fuerte y\nBorra a los débiles del mapa.\fEsto va para el\nCOHETE DEL EQUIPO.\fSe encuentran en\ngrupo.\fPero solos, ellos\nson débiles.\fLos odio a todos.\fmantente fuera del mio\ncamino. Un debilucho como tú solo\nse interpone en el camino.",
  ["TEXT_S66_435B"] = "…¡Humf! yo sabia\nque mentiste.",
  ["TEXT_S66_437B"] = "no es seguro\nentra allí, así que estoy en guardia.\fno soy bueno\n¿Samaritano?",
  ["TEXT_S66_43C7"] = "Conozca el\n¿COLA LENTA?\v¡Dicen que es bueno!\fNo contento con\n¿Se lo he dicho?",
  ["TEXT_S66_441B"] = "El lento\ndesapareció de la ciudad… escuché que las COLAS\nde ellos están a la venta por ahí.",
  ["TEXT_S66_4473"] = "El lento\nregresaron.\fConociéndolos,\nsimplemente estaban tonteando en alguna parte\nesquina.",
  ["TEXT_S66_44CE"] = "vino a preguntarle al\n¿KURT hace unas BOLAS?\fviene mucha gente\nsolo por eso.",
  ["TEXT_S66_451A"] = "Cortado por AZALEA\ny llegas al BOSQUE DE ILEX.\fPero estos árboles\ndelgado lo hace imposible\npase.\fPOKEMON\nCARVOEIRO utiliza CUT en los árboles.",
  ["TEXT_S66_45B0"] = "SLOWPOKE: …\f…… …… ……",
  ["TEXT_S66_45C3"] = "…… ……Bocejo?",
  ["TEXT_S66_45DF"] = "A ILEX FOREST\nestá agitada!\fO que está\nacontecendo?",
  ["TEXT_S66_460B"] = "{PLAYER}, aqui\nestá sua GS BALL\vde volta!",
  ["TEXT_S66_4628"] = "Puedes ver por\n¿Por qué ILEX FOREST está tan ocupado?",
  ["TEXT_S66_465A"] = "CIDADE DE AZALEA\nOnde pessoas e\fPOKéMON vivem em\nfeliz harmonia",
  ["TEXT_S66_4693"] = "CASA DO KURT",
  ["TEXT_S66_46A1"] = "CIDADE DE AZALEA\nGINÁSIO POKéMON\vLÍDER: BUGSY\fA enciclopédia\nambulante de\vPOKéMON inseto",
  ["TEXT_S66_46E7"] = "SLOWPOKE WELL\fTambém chamado de\nPO├çO DA CHUVA.\fO povo daqui crê\nque o bocejo do\vSLOWPOKE dá chuva\fConsta que um\nbocejo dele\fp├┤s fim a uma seca\nhá 400 anos.",
  ["TEXT_S66_478D"] = "HORNO DE CARBÓN",
  ["TEXT_S66_479C"] = "ILEX FOREST\fEntre pelo\nportão.",
  ["TEXT_S66_4A69"] = "Construíram a nova\nRADIO TOWER para\ftrocar a velha,\nque rangia.",
  ["TEXT_S66_4AA9"] = "se que hay uno\nTIENDA DE BICICLETAS nueva, pero no la encuentro\nen ninguna parte.",
  ["TEXT_S66_4AE6"] = "Aquele homem de\npreto se veste\fcomo a TEAM ROCKET\nQue bobagem!",
  ["TEXT_S66_4B2D"] = "El de negro\n¿Fue realmente del TEAM ROCKET? No\n¡Lo creo!",
  ["TEXT_S66_4B73"] = "LA TORRE DE RADIO\nGOLDENROD CITY es una postal.\fellos tienen un\npromoción en curso ahora.\fellos modifican\ntu POKéGEAR, para que pueda girar\nuna radio también.",
  ["TEXT_S66_4C14"] = "Oh, sua POKéGEAR\ntoca rádio agora!",
  ["TEXT_S66_4C36"] = "E-he-he-he…\fLevei bronca\npor brincar no\fsubsolo da\nDEPT.STORE.",
  ["TEXT_S66_4C83"] = "El hombre de ese\nEl hogar evalúa los nombres que le das. Incluso cambia el nombre.\ntu POKéMON.",
  ["TEXT_S66_4CCF"] = "¡Uf! esta ciudad\nEs grande. no se donde esta\nnada.",
  ["TEXT_S66_4D0D"] = "Então esta é a\nRADIO TOWER…",
  ["TEXT_S66_4D2A"] = "¿Qué quieres?\nidiota? ¡Añádelo!",
  ["TEXT_S66_4D4E"] = "Saia do caminho!\nCai fora!",
  ["TEXT_S66_4D6D"] = "Toma la RADIO\nTORRE… ¿Qué? no es de\ntu cuenta!",
  ["TEXT_S66_4DAA"] = "¿POKÉMON? ellos no son\nnada más que herramientas para\nganar dinero!",
  ["TEXT_S66_4DE2"] = "Nuestro sueño pronto\nse hará realidad... Fue una pelea así\nlargo…",
  ["TEXT_S66_4E1F"] = "¡Oye, mocoso! tu\n¡No es de aquí!\v¡Piérdase!",
  ["TEXT_S66_4E4B"] = "Venha provar o\nverdadeiro terror\vda TEAM ROCKET!",
  ["TEXT_S66_4E77"] = "CIDADE DE\nGOLDENROD\vESTA├çÃO",
  ["TEXT_S66_4E8F"] = "CIDADE DE\nGOLDENROD\vRADIO TOWER",
  ["TEXT_S66_4EAB"] = "Tudo em produtos\nPOKéMON!\fCIDADE DE\nGOLDENROD\vDEPT.STORE",
  ["TEXT_S66_4EE4"] = "CIDADE DE\nGOLDENROD\vGINÁSIO POKéMON\vLÍDER: WHITNEY\fA garota\nlinda demais!",
  ["TEXT_S66_4F29"] = "CIUDAD DE\nGOLDENROD La ciudad de la fiesta\nmuy encantador",
  ["TEXT_S66_4F5B"] = "O mundo é uma\nciclovia!\vBIKE SHOP",
  ["TEXT_S66_4F81"] = "Seu parquinho!\fCIDADE DE\nGOLDENROD\vGAME CORNER",
  ["TEXT_S66_4FAE"] = "NAME RATER\fAvalie os apelidos\ndos seus POKéMON",
  ["TEXT_S66_4FD8"] = "ENTRADA DO\nSUBTERR├éNEO",
  ["TEXT_S66_4FEE"] = "ENTRADA DO\nSUBTERR├éNEO",
  ["TEXT_S66_5022"] = "TIENDA DE FLORES\nHermosa y Florida",
  ["TEXT_S66_5042"] = "puedo enseñar\nmovimientos increíbles para tu POKéMON,\nsi quieres.\f¿me quieres?\nenseñar un nuevo movimiento?",
  ["TEXT_S66_5090"] = "Vai custar 4000\nfichas. Tudo bem?",
  ["TEXT_S66_50B4"] = "Ah… Mas eles são\nincríveis…",
  ["TEXT_S66_50CE"] = "¡Jajaja! tu no\n¡te arrepentirás!\f¿Qué golpe debo dar?\n¿enseñar?",
  ["TEXT_S66_5107"] = "Mmmm que pena.\nTendré que sacar dinero de casa...",
  ["TEXT_S66_513A"] = "si entiendes\n¿Qué tiene de sorprendente esto?\nGolpe, ya es un buen entrenador.",
  ["TEXT_S66_518B"] = "Uahahá!\nAté mais, garoto!",
  ["TEXT_S66_51A4"] = "M-mas…",
  ["TEXT_S66_51AC"] = "...no tienes\nBastantes patatas fritas aquí...",
  ["TEXT_S66_538D"] = "Uma menininha\nexpert em imitar\fas pessoas mora\naqui.\fEla imita até quem\nestá\fconversando com\nela. ├ë confuso.",
  ["TEXT_S66_540D"] = "A menina COPYCAT\nparecia triste.\fEla disse que\nperdeu sua POKé\vDOLL,CLEFAIRY.",
  ["TEXT_S66_5460"] = "tu viniste de\nJOHTO?\fpuedes volver\na la casa del TREN MAGNÉTICO.",
  ["TEXT_S66_54AE"] = "tu viniste de\nJOHTO?\f¿Puedes volver?\nsaltando a casa en el TREN IMÁN.",
  ["TEXT_S66_54FE"] = "Fui al gimnasio,\nfin de luchar con los entrenadores... Al final, terminé\nentrando al GIMNASIO vacante en el\nlado.\fVaya, que\n¡no es divertido!",
  ["TEXT_S66_558E"] = "Este es SILPH\nCO., famosa por los productos POKéMON.\fEn el pasado, el\nTEAM ROCKET quería la empresa\npor eso.",
  ["TEXT_S66_55FC"] = "Nhoc… Nhoc…\fOuvi dizer que há\num grande problema\vna USINA.\fNhoc… Nhoc…",
  ["TEXT_S66_564B"] = "Nhoc… Nhoc…\fOuvi dizer que\nhouve um grande\vrolo na USINA.\fNhoc… Nhoc…\nHaaah, que cheio!",
  ["TEXT_S66_56A5"] = "Entrar num beco\npela primeira\fvez me deixa\nmeio ansioso.",
  ["TEXT_S66_56E5"] = "Existe um lugar\nchamado TRAINER\fHOUSE em VIRIDIAN\nonde treinadores\fde todo canto\nse reúnem.",
  ["TEXT_S66_5745"] = "nuestra ciudad era\ncitado en un programa de radio ├ë es bueno escucharlo\nun elogio para tu ciudad, pero es un\nun poco aburrido también.",
  ["TEXT_S66_57B7"] = "CIDADE DE SAFFRON\fA Cidade Dourada\ndo Comércio",
  ["TEXT_S66_57E6"] = "CIDADE DE SAFFRON\nPOKéMON GYM\vLÍDER: SABRINA\fMestra dos POKéMON\nPsíquicos!",
  ["TEXT_S66_5829"] = "Bem-vindos todos!\nFIGHTING DOJO",
  ["TEXT_S66_584A"] = "SILPH CO.\nPR├ëDIO DA SEDE",
  ["TEXT_S66_5865"] = "CASA do\nSR.PSIQUICO",
  ["TEXT_S66_5879"] = "CIDADE DE SAFFRON\nMAGNET TRAIN\vSTATION",
  ["TEXT_S66_599C"] = "Ouvi que apareceu\num GYARADOS\vvermelho no LAKE.\f├ë estranho, pois\naté GYARADOS\fcomuns são raros\nnaquele lago…",
  ["TEXT_S66_5A0E"] = "mi programa\n¿Radio favorita? MÚSICA POKÉMON.",
  ["TEXT_S66_5A3D"] = "Ando ouvindo\nrisadas no\frádio…\n├ë arrepiante.",
  ["TEXT_S66_5B8D"] = "pokémon en vivo\nmuchas cosas en sus vidas, como\ncomo nosotros.\fyo también he visto\ny sufrí mucho en mi vida.\fcomo soy mas\nViejo, déjame mostrarte lo que es.\ftengo pokemon\ndesde antes de ti\nnacer.\fno pierdo\nfácil.\fYo, PRYCE, el\nentrenador de invierno, me voy\nmuestra mi poder",
  ["TEXT_S66_5CB3"] = "Oh, lo soy\nImpresionado contigo.\fcon este deseo\nfuerte, todo lo vencerás\nobstáculos.\fEres digno de esto\n¡INSIGNIA!",
  ["TEXT_S66_5D3B"] = "{PLAYER} recebeu\na GLACIERBADGE.",
  ["TEXT_S66_5D55"] = "Essa BADGE aumenta\nos status SPECIAL\vdos POKéMON.\fEla também deixa\nseu POKéMON usar\vWHIRLPOOL para\vcruzar redemoinho\fE isto… Isto é um\npresente meu!",
  ["TEXT_S66_5DEF"] = "Essa TM contém o\nICY WIND.\fEle causa dano e\nreduz VELOCIDADE.\fEle demonstra\na dureza do\vinverno.",
  ["TEXT_S66_5E59"] = "Cuando el hielo y\nLa nieve se derrite, llega la primavera.\ftu y tu\nPOKéMON permanecerán juntos por muchos\naños todavía.\fvalorar el tiempo\nde ti!",
  ["TEXT_S66_5F2D"] = "Acho que existe um\nmovimento que um\fPOKéMON pode usar\nmesmo congelado.",
  ["TEXT_S66_5FDD"] = "me encanta patinar\ncon mis POKéMON en este GIMNASIO!",
  ["TEXT_S66_6047"] = "O segredo do\npoder de PRYCE…\fEle medita sob\numa cachoeira\fpara fortalecer\nmente e corpo.",
  ["TEXT_S66_6116"] = "sin patinar con\nprecisión, no llegarás muy lejos\nen este GIMNASIO.",
  ["TEXT_S66_618F"] = "no debería haber\nMe jactaba de mi esquí...",
  ["TEXT_S66_61BF"] = "PRYCE es un veterano\ny ha estado entrenando POKéMON durante algunos\n50 años.\fdicen que el es\nbueno para congelar oponentes con\ngolpes de hielo.\fEs decir, tienes\nQue lo derrita con tu ambición\n¡en llamas!",
  ["TEXT_S66_6275"] = "PRYCE es bueno,\n¡pero estás en otro nivel!\ffue una batalla\ncaliente que unió a dos\ngeneraciones!",
  ["TEXT_S66_6362"] = "¿Qué es eso? un\n¿El equipo ROCKET ha vuelto?\fvi algunos hombres\nnegro en LAKE OF RAGE…",
  ["TEXT_S66_63B3"] = "sostengo mi POKEMON\nde evolucionar demasiado pronto.\fles hago aprender\nciertos movimientos antes de dejarlos evolucionar.",
  ["TEXT_S66_6418"] = "POKéMON ficam mais\nfortes ao evoluir\fmas aprendem os\ngolpes bem mais\vdevagar.",
  ["TEXT_S66_64B8"] = "MORTERO DE MONTAJE es\nun laberinto.\fTenga cuidado de no\nperderse allí.",
  ["TEXT_S66_654B"] = "… vagabas mucho\nmuy lejos... Aquí medité.\nDentro de mí, un nuevo poder\ndesperté.\fDéjame dividir\nmi poder con tu POKéMON.\nToma, niña.",
  ["TEXT_S66_65DE"] = "¿Ves esto? ├ë o\n¡PODER OCULTO!\fSe extrae el\nEl poder de ataque de POKéMON.\fRecuerda: el tipo\ny el poder depende del POKéMON que lo utilice.",
  ["TEXT_S66_6673"] = "Estou meditando…",
  ["TEXT_S66_672E"] = "EL LAGO DE LA IRA es\nen realidad un cráter hecho por\nGYARADOS en furia El cráter se llenó\ndel agua de lluvia y así nació\nel LAGO.\f├ë la historia que\nvino del tatarabuelo├┤ del tatarabuelo├┤\nmi abuelo├┤.\fEn el pasado fue\npara pescar animado MAGIKARP\nahí, pero... no entiendo qué\nlo que está pasando.",
  ["TEXT_S66_684D"] = "EL LAGO no es\nnormal desde que esos hombres\nLlegó el negro.",
  ["TEXT_S66_6890"] = "EL LAGO DE LA FURIA\nvolvió a la normalidad.\fEl MAGIKARP\nregresaron.\ftodavía puedo ver\nMi sueño de encontrar el MAGIKARP más grande del mundo.\f¿Tienes una varilla?\nSi es así, por favor ayúdame.",
  ["TEXT_S66_693E"] = "Ah, tienes uno\n¡MAGIKARP! veamos el tamaño\nde este pequeño animal.",
  ["TEXT_S66_6977"] = "¡Guau! Este es\nexcepcional!\fme quito el sombrero\npara ti!\fToma esto de\nrecuerdo!",
  ["TEXT_S66_69C3"] = "El récord es lo que\nimporta.\fConsidere esto\n¡una ventaja!",
  ["TEXT_S66_6A01"] = "¡Guau! Este es\nexcepcional!\f…Ojalá pudiera\nDigo esto, pero he visto uno más grande.\nantes.",
  ["TEXT_S66_6A5C"] = "¿Qué? esto no es\n¡Un MAGIKARP!",
  ["TEXT_S66_6A79"] = "Ah... entonces no lo haces\n¿Tienes uno lo suficientemente bueno?\nLa próxima vez.",
  ["TEXT_S66_6B1F"] = "Sólo aquellos que van a\nLAGO DE FURIA pasó por\nÚltimamente.",
  ["TEXT_S66_6B65"] = "Ninguém mais vai\nao LAKE OF RAGE\vnesses dias.",
  ["TEXT_S66_6CD2"] = "Pare aí, moço!\nmoço!\fO pedágio é ┬Ñ1000\npara passar.",
  ["TEXT_S66_6D0A"] = "Obrigado, senhor!",
  ["TEXT_S66_6D20"] = "Então pague o que\ntiver, por favor.",
  ["TEXT_S66_6D41"] = "Hihihi. Estamos\nenchendo o bolso.\fTodo mundo quer\nver o que rola\fno LAKE OF\nRAGE.",
  ["TEXT_S66_6D9B"] = "fui expulsado de\nmi publicación para los de negro.\fse fueron\nesto al revés.\feso me deja\nincómodo.\v¿Puedes tomarlo?",
  ["TEXT_S66_6E2D"] = "Usa esta puerta\npara no caminar sobre la hierba.",
  ["TEXT_S66_6EC0"] = "¡Ey!\fROJO está fuera\nha pasado mucho tiempo.\fY tampoco\nllamado así que no tengo idea\ndónde está o qué hace.\fdicen sin\nlas noticias son una señal de que las cosas van bien,\nPero me preocupo por él.",
  ["TEXT_S66_6F81"] = "Fico com medo do\nRED se machucar\fou ficar doente,\nmas ele é rapaz.\fTenho orgulho de\nele fazer o que\fquer.",
  ["TEXT_S66_6FE8"] = "Hay programas aquí.\neso no pasa en JOHTO...",
  ["TEXT_S66_7050"] = "{PLAYER} jugó el\nN64.\fMejor ponte en marcha,\n¡no hay tiempo!",
  ["TEXT_S66_7087"] = "Parece que esto\nHace mucho que no se usa...",
  ["TEXT_S66_7130"] = "MARGARITA: ¡Hola! mio\nhermano menor es LÍDER DE GIMNASIO\nde CIUDAD VIRIDIANA.\fpero el se va\nciudad tanto que causa problemas\npara el entrenador.",
  ["TEXT_S66_71B6"] = "MARGARITA: ¡Hola! Llegó\na tiempo. Iba a tomar un té.\f¿me quieres?\nseguir?\fAh, tu pokemon\nestán un poco sucios.\f¿me quieres?\ncepillar uno?",
  ["TEXT_S66_7244"] = "DAISY: Qual deles\neu devo escovar?",
  ["TEXT_S66_7266"] = "DAISY: Certo, vou\ndeixar ele bonito\vnum instante.",
  ["TEXT_S66_72AA"] = "DAISY: ¡Ahí está!\nTodo listo.\f¿Vio? no se quedo\nhermosa, ¿verdad?\f├ë un POKEMON\nmuy lindo.",
  ["TEXT_S66_72FA"] = "DAISY: Eu sempre\ntomo chá\fa esta hora. Venha\nme acompanhar.",
  ["TEXT_S66_7334"] = "DAISY: No quieres\n¿Cepilla ninguno?\fEstá bien, simplemente\nToma té entonces.",
  ["TEXT_S66_7377"] = "MARGARITA: Lo siento.\nNo puedo cepillar un HUEVO.",
  ["TEXT_S66_7427"] = "ROBLE: ¡Oh, {PLAYER}!\nMe alegro que hayas llegado tan lejos\nhasta KANTÓ.\f¿Qué piensas?\nde los entrenadores aquí?\nBastante duro, ¿verdad?",
  ["TEXT_S66_74A2"] = "Como vai a sua\nPOKéDEX?\fVamos ver…",
  ["TEXT_S66_74C8"] = "Se estiver por\nperto, espero que\vvolte a visitar.",
  ["TEXT_S66_76A2"] = "ROBLE: ¿Hmm? tu no\n¿Estás recogiendo las INSIGNIA de aquí?\fLos LÍDERES aquí\nson tan fuertes como los que tu\nGanó en JOHTO.\flo recomiendo\nlos desafías.",
  ["TEXT_S66_773C"] = "ROBLE: Oh, lo eres\nuniéndose a INSIGNIA aquí.\fme imagino que es\ndifícil, pero la experiencia\nayudarte.\fven a verme\ncon todos ellos.\ftengo un regalo\npara ti.\fMantente fuerte,\n {PLAYER} !",
  ["TEXT_S66_77FB"] = "El programa POKéMON\nLA CHARLA DEL PROF no aparece aquí\nen KANTÓ.\f├ë una pena, yo\nquería escuchar.",
  ["TEXT_S66_7859"] = "Gracias a tu\ntrabajo en POKéDEX, la investigación del PROF va\nmuy bien.",
  ["TEXT_S66_78A7"] = "no digas\nnadie, pero POKéMON TALK no es\nvivir.",
  ["TEXT_S66_78EA"] = "Aperte START para\nabrir o MENU.",
  ["TEXT_S66_7909"] = "A opção SAVE está\nno MENU.\fUse de tempos em\ntempos.",
  ["TEXT_S66_7945"] = "no hay nada\naquí dentro...",
  ["TEXT_S66_795E"] = "hay un mensaje\ncorreo electrónico en su PC.\f…PROF.OAK, ¿cómo estás?\ntu búsqueda?\v¿Todo va bien?\fyo sigo\nluchando.\fEscuché rumores de\nque {PLAYER} se está recuperando\nconocido alrededor.\festoy muy feliz\nsaber eso.\fELM, de la CIUDAD DE\nNUEVA CORTEZA 8-)",
  ["TEXT_S67_41E3"] = "eres un\nnuevo entrenador, ¿verdad? ¡Se puede ver!\f¡Todo está bien! Todos\n¡El mundo alguna vez fue un principiante!\fsi quieres puedo\nenseñarte algunas cosas.",
  ["TEXT_S67_426F"] = "Certo, então!\nMe siga!",
  ["TEXT_S67_4285"] = "Este es un CENTRO\nPOKÉMON. Cura a tu POKéMON en uno\ninstantáneo.\fdependerás\nmuchos de ellos, es bueno aprender\nsobre ellos.",
  ["TEXT_S67_4304"] = "Esta es una TIENDA\nPOKÉMON.\fVenden BOLAS a\natrapa POKéMON salvajes y otros\nartículos útiles.",
  ["TEXT_S67_4359"] = "A ROTA 30 fica\npor aqui.\fTreinadores lutam\ncom seus POKéMON\fpreferidos lá.\nVale ver.",
  ["TEXT_S67_43A7"] = "Este es el mar\ncomo ves.\fSolo algunos POKéMON\nse encuentran en el agua.",
  ["TEXT_S67_43EC"] = "Aquí… ├ë ¡mi hogar!\nGracias por la compañía.\fdéjame darte\nun pequeño regalo.",
  ["TEXT_S67_4438"] = "A POKéGEAR de\n{PLAYER} tem MAPA!",
  ["TEXT_S67_4451"] = "POKéGEAR es\nMás útil cuando pones TARJETAS.\fBuena suerte en el tuyo\nviaje!",
  ["TEXT_S67_449F"] = "Oh… ├ë algo que\ngosto de fazer…\fTudo bem. Venha\nquando quiser.",
  ["TEXT_S67_44E2"] = "... atrapaste uno\nPOKéMON en el LABORATORIO.\fQué pérdida.\nQué debilucho.\f…no entendí\n¿Qué dije?\fbueno tengo uno\nPOKÉMON bueno.\fte mostraré\n¡Qué digo!",
  ["TEXT_S67_457F"] = "Hunf. Feliz por\nter ganhado?",
  ["TEXT_S67_459E"] = "…\fMi nombre es ???.\fyo seré el\nEl mejor entrenador POKéMON del mundo.",
  ["TEXT_S67_45E6"] = "Humph. Eso fue\npérdida de tiempo.",
  ["TEXT_S67_4608"] = "…\fMi nombre es ???.\fyo seré el\nEl mejor entrenador POKéMON del mundo.",
  ["TEXT_S67_4650"] = "¿Hablaste con el\n¿Viejo cerca del CENTRO POKéMON?\fPone un MAPA de\nJOHTO en tu POKéGEAR.",
  ["TEXT_S67_46A8"] = "Com POKéMON por\nperto, qualquer\vlugar é bom.",
  ["TEXT_S67_46D6"] = "A casa do\nMR.POKéMON fica\vmais adiante.",
  ["TEXT_S67_4701"] = "luché con el\nautocares de carretera.\fmi pokemon\n¡Perdieron mal!\fnecesito tomarlos\nal CENTRO POKEMON",
  ["TEXT_S67_4766"] = "Un pokémon que\nRecibí un artículo.\fcreo que es\nAGUA MÍSTICA.\fNo lo necesito,\n¿Quieres quedarte?",
  ["TEXT_S67_47C1"] = "Volto a pescar,\nentão.",
  ["TEXT_S67_47E0"] = "CIDADE DE\nCHERRYGROVE\fA cidade das\nflores perfumadas",
  ["TEXT_S67_4815"] = "CASA DO GUIA",
  ["TEXT_S67_4AC4"] = "A música do rádio\nmuda o humor dos\vPOKéMON selvagens",
  ["TEXT_S67_4B47"] = "Fui humilhado\nna frente da minha\vnamorada…",
  ["TEXT_S67_4BBA"] = "Confío más en nosotros\nmi POKéMON que mi novio.",
  ["TEXT_S67_4C21"] = "As BADGES de\nGINÁSIO são lindas\vEu coleciono.",
  ["TEXT_S67_4C87"] = "Algunos Pokémon\nhuyen de inmediato.\fIntenta atraparlos\ncon la BOLA RÁPIDA de KURT.\fSiempre que encuentro uno\nQUÉ ALBARICORNIO, se lo llevaré a KURT.\fÉl hace un POKé\nBOLA hecha a medida.",
  ["TEXT_S67_4D5A"] = "yo deslumbraría\ntú con mi preciado POKéMON.\fpero tu fuerza\n¡Me electrizó!",
  ["TEXT_S67_4DD5"] = "¿Hay? no debería\nMe perdí este...",
  ["TEXT_S67_4DF6"] = "Mi VENONAT ganó\nel concurso de captura de insectos\nen el PARQUE NACIONAL.",
  ["TEXT_S67_4EBC"] = "A POKéMON March\nno rádio atrai\vPOKéMON do mato.",
  ["TEXT_S67_4EEA"] = "O perigo espreita\nna noite!",
  ["TEXT_S67_4F06"] = "Opa!",
  ["TEXT_S67_4F0F"] = "Ya sabes, la noche tiene\nsu entretenimiento también.\fPero no te excedas,\n¿es bueno?",
  ["TEXT_S67_4F56"] = "Tus POKéMON son\nmuy fuerte.\fpuedes ir a\nen cualquier lugar.",
  ["TEXT_S67_4F94"] = "ROTA 35",
  ["TEXT_S67_52D2"] = "Do que mais eu\ngosto além de\vPOKéMON?\fA MARY do rádio.\nDeve ser fofa!",
  ["TEXT_S67_533A"] = "Ay mi pobre\n¡Querido POKEMON!",
  ["TEXT_S67_5359"] = "yo seria feliz\nsimplemente tener un POKéMON raro.",
  ["TEXT_S67_53F8"] = "No hay problema\na la gente le gustan los chicos\ndiferente.\fPOKéMON no es sólo\ntener los más poderosos.",
  ["TEXT_S67_54D3"] = "PELOTA DE SEÑUELO\nKURT es el mejor atrapando POKéMON\nenganchado.\f├ë mucho más\nmás eficaz que una ULTRA BALL.",
  ["TEXT_S67_557E"] = "O que está\nhavendo no LAKE?\fA gente ia\nacampar lá.",
  ["TEXT_S67_5604"] = "Brinquei demais!",
  ["TEXT_S67_5618"] = "estoy en un\npicnic con POKéMON ¿No quieres venir?",
  ["TEXT_S67_567B"] = "ROTA 43\fLAKE OF RAGE\nCIDADE DE MAHOGANY",
  ["TEXT_S67_56A2"] = "ROTA 43\fLAKE OF RAGE\nCIDADE DE MAHOGANY",
  ["TEXT_S67_56C9"] = "TRAINER TIPS\fTodo POKéMON tem\nprós e contras\fconforme o tipo\ndele.\fSe os tipos são\ndiferentes, um de\fnível mais alto\npode até perder.\fAprenda que tipos\nsão fortes e\ffracos contra o\nseu POKéMON.",
  ["TEXT_S67_5A91"] = "Deixa pra\nlá.",
  ["TEXT_S67_5AA8"] = "Aquele POLIWAG\nque escapou…\vEra enorme.\fJuro que tinha uns\n5 metros!",
  ["TEXT_S67_5B6F"] = "Hay 100 victorias\ny 101 derrotas.\fno pelearé\nnuevo tan pronto.",
  ["TEXT_S67_5BDB"] = "¡Uf! eres bueno\nlo mismo.",
  ["TEXT_S67_5BF3"] = "ARTICUNO, ZAPDOS\ne MOLTRES são\fos três POKéMON\npássaro lendários\fMas ouvi que tem\noutros pássaros\vlendários também.",
  ["TEXT_S67_5CFC"] = "├ë importante ter\nconvicção do seu\vlado.",
  ["TEXT_S67_5D7E"] = "Si un POKéMON tiene\ncolores diferentes a lo normal,\nvale más.\f¿Qué? Eso no es\n¿es verdad?",
  ["TEXT_S67_5E66"] = "Guau. tienes\nmuchas INSIGNIAS.\fNo es de extrañar que\nEs tan fuerte.\fmorty\ndel GIMNASIO ECRUTEAK todavía\n¿Estás entrenando?\fÉl me dejó boquiabierto\nfeo.",
  ["TEXT_S67_5F4D"] = "todos mejoramos\npasando por muchas batallas.\fluché mucho\npara convertirme en lo que soy hoy: un\nélite.",
  ["TEXT_S67_5FB3"] = "ROTA 44\nICE PATH a frente",
  ["TEXT_S67_5FCC"] = "ROTA 44\fCIDADE DE MAHOGANY\vCIDADE DE\nBLACKTHORN",
  ["TEXT_S67_6301"] = "Vou voltar para o\nICE PATH de\fBLACKTHORN e\ntreinar mais.",
  ["TEXT_S67_63B1"] = "Guau, como yo\n¡Me encanta PS UP! ¡Mmm!\fsigo bebiendo\nde mis POKéMON!\f¡No puedo controlarme!",
  ["TEXT_S67_6418"] = "Uahahah! Eu sou o\ngrande perdedor!",
  ["TEXT_S67_6434"] = "no soy bueno en\npiensa, ¿sabes?\fAsí que voy a\nrealmente fuerte!",
  ["TEXT_S67_64F1"] = "Lo mejor que\nya me paso fue descubrir el\nPOKÉMON.",
  ["TEXT_S67_65E2"] = "Esto exige medidas\nextremo.\fvoy a\nlas montañas entrenan en soledad.",
  ["TEXT_S67_670D"] = "Te veo crear\nTu POKéMON con cariño.\fEl vínculo que tú\ncrear le ahorrará problemas.",
  ["TEXT_S67_67D1"] = "no estoy a favor\nde golpes demasiado fuertes.\fquiero ganar pero\nTampoco quiero lastimar a POKéMON.",
  ["TEXT_S67_687F"] = "soy muy,\nmuy fuerte!",
  ["TEXT_S67_68FE"] = "ROTA 45\nMONTANHA a frente",
  ["TEXT_S67_6AB4"] = "├Ç noite o mar\nfica preto.\fParece que ele vai\nte engolir.",
  ["TEXT_S67_6B3B"] = "Yo... le pregunté al\nmi novia nada al FUCSIA",
  ["TEXT_S67_6BAD"] = "├ë uma nadada bem\ncurta entre\fFUCHSIA e as\nSEAFOAM ISLANDS…\fPuxa, que homem\ngrande o meu\fnamorado! Banana!",
  ["TEXT_S67_6C7E"] = "puedo ser malo\nnadar, pero me encanta el mar.",
  ["TEXT_S67_6CAF"] = "Desculpe. Esta\nestrada está em\vobras.\fSe quiser chegar\na CINNABAR, é\fmelhor ir pro sul\nde CIDADE DE\vPALLET.",
  ["TEXT_S67_6D24"] = "Estou todo suado.\nHora de nadar!",
  ["TEXT_S67_6D45"] = "quien sabe cuanto\nEs hora de mover esta roca...",
  ["TEXT_S67_6D7D"] = "las obras en\nEl camino está terminado.\fAhora puedo volver\npesca.",
  ["TEXT_S67_6DBC"] = "ROTA 19\fCIDADE DE FUCHSIA\nSEAFOAM ISLANDS",
  ["TEXT_S67_6DE5"] = "Atenção: cuidado\nao nadar até as\vSEAFOAM ISLANDS.\vPOLÍCIA de\fFUCHSIA",
  ["TEXT_S67_7006"] = "MISTY: ¡Ay!\n¿Por qué tuviste que venir?\nahora?\f¿Sabes cómo?\n¿Llaman a gente como tú?\f¡Praga! escuchado\n¿verdad? ¡Praga!\f… …¿Oh? Estas INSIGNIAS\nTienes… ¿Son INSIGNIAS JOHTO?\fSi tienes ocho,\ndebe ser bueno.\fBien, entonces.\nVen al GIMNASIO.\fme encantará\n¡lucha contigo!\fSoy MISTY, la\nLÍDER DE GIMNASIO CERÚLEO.",
  ["TEXT_S67_71B5"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_S67_7208"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_S67_725C"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_S67_72A6"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_S67_72F8"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_S67_735B"] = "Hice lo mejor que pude.\nNada que lamentar.",
  ["TEXT_S67_741A"] = "Lo siento... no lo haré\nhacer más trampa...",
  ["TEXT_S67_743B"] = "te enfrentaste\nuna batalla más de la que esperaba,\npero ganó.\fComo prometí,\nganó un premio.",
  ["TEXT_S67_749D"] = "Pero después de ver\ncomo peleas, quiero ver como\nVoy a salir.\f¿Qué tal eso? déjame\npelear contigo!",
  ["TEXT_S67_74FD"] = "Nunca tive uma\nbatalha tão boa!",
  ["TEXT_S67_7520"] = "fue un gran\nbatalla!\fTú y tu POKEMON\n¡Son realmente fantásticos!",
  ["TEXT_S67_7567"] = "SEA COTTAGE\nBILL'S HOUSE",
  ["TEXT_S68_40F1"] = "Cruzaste el\nmar para llegar?\fdebe haber sido\nbastante difícil.\fseria mucho mas\nfácil si tu POKéMON lo supiera\nusa VOLAR...",
  ["TEXT_S68_4163"] = "pero no puedes\nuse FLY sin la INSIGNIA desde aquí.\fSi gana el LÍDER\ndel GYM de aquí, ven a verme.\ftendré una hermosa\nregalo para ti",
  ["TEXT_S68_41E3"] = "Esta es la INSIGNIA de\n¡GIMNASIO aquí!\fAsí que debes\ntoma este HM.",
  ["TEXT_S68_421D"] = "Enseña VOLAR a tu\nPOKÉMON.\ftu podrás\nvolar a tiempo a cualquier\nlugar ya visitado.",
  ["TEXT_S68_4277"] = "mi marido perdio\npara ti, entonces tienes que entrenar.\fQué bueno, porque\nSe estaba poniendo un poco gordito.",
  ["TEXT_S68_42DF"] = "Se usar o FLY,\ndá para voltar\fpara OLIVINE na\nhora.",
  ["TEXT_S68_4319"] = "As pedras ao norte\nda cidade podem\vser quebradas.\fElas podem estar\nescondendo algo.\fSeu POKéMON pode\nusar ROCK SMASH\vpara quebrar.",
  ["TEXT_S68_4394"] = "O CHUCK, LÍDER do\nGINÁSIO, treina\fcom os POKéMON\nlutadores dele.",
  ["TEXT_S68_4660"] = "CIDADE DE CIANWOOD\fUm Porto Cercado\npor Mares Bravios",
  ["TEXT_S68_468F"] = "CIDADE DE CIANWOOD\nGINÁSIO POKéMON\fLÍDER: CHUCK\fQuem Fala São os\nPunhos Dele",
  ["TEXT_S68_46D6"] = "500 Anos de\nTradição\fCIDADE DE CIANWOOD\nFARMÁCIA\fTire Suas Dúvidas\nsobre Remédios",
  ["TEXT_S68_4725"] = "CIDADE DE CIANWOOD\nEST├ÜDIO DE FOTO\fTire um Retrato\nde Lembrança!",
  ["TEXT_S68_4A6B"] = "Ei!",
  ["TEXT_S68_4A71"] = "saber lo que tu\n¿acabas de hacerlo?\fdiste tu\nprimer paso en KANTO.\fCompruébalo en\nmapa de POKEGEAR",
  ["TEXT_S68_4B0B"] = "si ganas\nEste camino es duro, la verdad lo será.\nrevelado!\fJe, lo siento, solo\nQuería decir algo bonito.",
  ["TEXT_S68_4BAC"] = "Um bom treinador\nreconhece outros\vbons treinadores.",
  ["TEXT_S68_4C19"] = "¡Oh! tu eres\n¡demasiado fuerte!",
  ["TEXT_S68_4C35"] = "eres un chico,\nPero no te pueden subestimar.\nNi de lejos.",
  ["TEXT_S68_4CCE"] = "Analizo POKéMON\nAntes y después de la evolución.\frealmente evolucionar\nhace a POKéMON más fuerte.\fPero las formas\nlos evolucionados también aprenden más tarde.",
  ["TEXT_S68_4DD2"] = "Con tu fuerza,\nLo estás haciendo bien en la LIGA.\f├ë que dices mi\npremonición.",
  ["TEXT_S68_4E3A"] = "Piu!",
  ["TEXT_S68_4E42"] = "BIRD KEEPERS, nós\nimitamos assobios\fpara comandar\nos POKéMON.",
  ["TEXT_S68_4E7F"] = "TOHJO FALLS\fA ligação entre\nKANTO e JOHTO",
  ["TEXT_S68_50A7"] = "POKéMON se\nescondem no mato.\fNunca se sabe\nquando saltam…",
  ["TEXT_S68_50DF"] = "te he visto algunos\nveces. ¿Cuántos POKéMON tienes ya?\n¿entiendo?\f¿Quieres que te lo muestre?\n¿Cómo atrapar POKEMON?",
  ["TEXT_S68_514D"] = "├ë assim que se\nfaz.\fSe enfraquecer\nantes, o POKéMON\vé mais fácil.",
  ["TEXT_S68_5197"] = "Oh. Todo está bien.\fEn definitiva, si quieres\natrapar POKéMON, tienes que\ncaminar mucho.",
  ["TEXT_S68_51E3"] = "¿Hay? ¿me quieres?\n¿Muestra cómo atrapar POKéMON?",
  ["TEXT_S68_5214"] = "Y ahí. como estas\n¿Tu POKEMON?\fsi son débiles\ny sin preparación, mantente fuera del\narbusto.",
  ["TEXT_S68_526C"] = "Viu aqueles\nbarrancos? Dá medo\vpular deles.\fMas dá para ir a\nNEW BARK sem\fpassar pelo\nmato.",
  ["TEXT_S68_52D9"] = "Quis dar uma\npausa, e salvei\fpara guardar meu\nprogresso.",
  ["TEXT_S68_534C"] = "estoy esperando\nPOKéMON que solo aparecen ├á\nnoche.",
  ["TEXT_S68_537C"] = "estoy esperando\nPOKéMON que sólo aparecen de\nmañana.",
  ["TEXT_S68_53B2"] = "TUSCANY: Creio eu\nque esta é a\fprimeira vez que\nnos vemos?\fPermita-me que eu\nme apresente.\fSou TUSCANY, de\nterça-feira.",
  ["TEXT_S68_542F"] = "Como apresentação,\naceite este\fpresente, um\nPINK BOW.",
  ["TEXT_S68_546F"] = "TOSCANA: ¿No lo crees?\n¿Es realmente adorable?\fFortalece\nataques normales.\festoy seguro de que\nserá útil.",
  ["TEXT_S68_54E7"] = "TOSCANA: Saber\nMONICA, ¿mi hermana mayor?\fo mi hermano\n¿El más joven, WESLEY?\fsoy el segundo de\nsiete hijos.",
  ["TEXT_S68_5559"] = "TOSCANA: Hoy no\nEs martes.\vQué vergüenza…",
  ["TEXT_S68_558E"] = "ROTA 29\fCIDADE DE\vCHERRYGROVE\vCIDADE DE NEW BARK",
  ["TEXT_S68_55B9"] = "ROTA 29\fCIDADE DE\vCHERRYGROVE\vCIDADE DE NEW BARK",
  ["TEXT_S68_5806"] = "Vai, RATTATA!\fTACKLE!",
  ["TEXT_S68_581C"] = "O quê? Esta é uma\nbatalha séria!\vMe deixe em paz!",
  ["TEXT_S68_58A2"] = "Ai! Perdi de novo!\nQue droga!",
  ["TEXT_S68_58C2"] = "necesito tener\nmás POKéMON para batallas.\fconseguiré más\nun poco!",
  ["TEXT_S68_597D"] = "Conviértete en un buen\nEntrenar es difícil.\fpelearé\ncon otras personas para mejorar.",
  ["TEXT_S68_5A1C"] = "Fiquei sem POKé\nBALLS enquanto\vcapturava POKéMON\fDevia ter trazido\nmais…",
  ["TEXT_S68_5A6A"] = "A casa do\nMR.POKéMON? Fica\vum pouco adiante.",
  ["TEXT_S68_5A94"] = "Todo mundo se\ndiverte lutando!\vFaça o mesmo!",
  ["TEXT_S68_5AC4"] = "No soy entrenador, pero si miras\nOjos de uno, prepárate.",
  ["TEXT_S68_5B0B"] = "ROTA 30\fCIDADE DE VIOLET\nCIDADE DE\vCHERRYGROVE",
  ["TEXT_S68_5B34"] = "CASA DO MR.POKéMON\nEm frente!",
  ["TEXT_S68_5B55"] = "LAR DE MR.POKéMON",
  ["TEXT_S68_5B66"] = "CONSEJO AL ENTRENADOR No robes POKéMON\nde otros!\fPOKé BALLS sólo si\n¡Juega en POKéMON salvaje!",
  ["TEXT_S68_5F86"] = "tengo la intención de entrenar\nen CIANWOOD CITY para mi POKéMON\naprende a volar.",
  ["TEXT_S68_5FEE"] = "no lo creo\nEstudié mucho.",
  ["TEXT_S68_600E"] = "tengo tantos\npruebas para hacer eso ya queda poco\nhora de POKéMON Entonces, ¿cuándo podrá\nPara jugar me concentro mucho.",
  ["TEXT_S68_60C8"] = "Entendi. Então dá\npara lutar assim.",
  ["TEXT_S68_60EC"] = "yo se de uno\nbueno!\fLa leche de MOOMOO\nFARM es famosa por su sabor.",
  ["TEXT_S68_6185"] = "Quando vejo\nPOKéMON, meus\vnervos se\vacalmam.",
  ["TEXT_S68_620C"] = "Todo tipo de\ngente pelo mundo\fvive feliz com\nos POKéMON.",
  ["TEXT_S68_629A"] = "LA LECHE MOOMOO es buena\npor la belleza y la salud, pero,\nlamentablemente solo venden uno\nbotella a la vez.",
  ["TEXT_S68_62FD"] = "ROTA 38\fCIDADE DE OLIVINE\nCIDADE DE ECRUTEAK",
  ["TEXT_S68_6324"] = "CONSEJOS PARA EL ENTRENADOR Si un POKéMON es\nAl intentar evolucionar, puedes detenerlo.\fPresione el botón B\ndurante la evolución.\fEsto asusta al\nPOKéMON y su evolución.",
  ["TEXT_S68_64E3"] = "No todos\n¿Sueñas con ser algún día rey?",
  ["TEXT_S68_654F"] = "parece que tienes\nmuchos POKéMON, pero PIKACHU aún\nes el mejor.",
  ["TEXT_S68_65DB"] = "Tus POKéMON son\nmuy bien entrenado.",
  ["TEXT_S68_6662"] = "Se escovar eles,\nPOKéMON ficam bem",
  ["TEXT_S68_66C2"] = "El alivio parece\neso nunca cambia.\fPero él cambia,\npoco a poco, con el tiempo.",
  ["TEXT_S68_671C"] = "CONSEJOS DE ENTRENAMIENTO ¡Mira! Justo ahí,\nen el lado izquierdo del poste.",
  ["TEXT_S68_675B"] = "ROTA 13\fNorte: SILENCE\nBRIDGE",
  ["TEXT_S68_677D"] = "Norte: CIDADE DE\nLAVENDER\fOeste: CIDADE DE\nFUCHSIA",
  ["TEXT_S68_6814"] = "NIDORAN, pata!",
  ["TEXT_S68_68D0"] = "BROCK: ├ë raro\nrecibir desafío de entrenador\nViniendo de JOHTO.\fsoy BROCK,\nLÍDER DE PEWTER.\fsoy un experto\nen piedra POKéMON.\fMis POKéMON son\ninmune a la mayoría de los ataques\nfísico. Será difícil causar\nalgún daño.\f¡Venir!",
  ["TEXT_S68_69BB"] = "BROCK: Los ataques\nLas fortalezas de tu POKéMON derrotaron mi defensa... Eres más fuerte.\nde lo que pensaba Adelante,\ntoma las INSIGNIAS.",
  ["TEXT_S68_6A3D"] = "{PLAYER} recebeu\na BOULDERBADGE.",
  ["TEXT_S68_6A57"] = "BROCK: {PLAYER},\ngracias. disfruté luchando\ntú, aunque sea un poco molesto.\fesa insignia de roca\nDejará tu POKéMON quieto\nmás fuerte.",
  ["TEXT_S68_6ADA"] = "BROCK: El mundo está\nenorme. Todavía hay muchos entrenadores.\nfuerte como tú.\fEspera y verás.\nTambién me volveré mucho más fuerte.",
  ["TEXT_S68_6C0F"] = "¡Eh, tú!\n¡Entrenador JOHTO!\fBROCK es duro. ir\ncastigarte si no lo llevas a\nen serio.",
  ["TEXT_S68_6C6E"] = "¡Ey! Futuro\n¡CAMPEÓN!\flo estas haciendo bien\nEstás frente a los LÍDERES de\n¿GIMNASIO KANTO?\fSon personas fuertes y\ndedicado, igual a LÍDERES\npor JOHTO.",
  ["TEXT_S68_6D07"] = "¡Ey! Futuro\n¡CAMPEÓN!\fEL GIMNASIO no te da\ntomó trabajo.\fla forma en que tu\ntomar el mando fue inspirador.\nLo digo en serio.",
  ["TEXT_S68_6DD8"] = "¡Ey! mira el mio\n¡GYARADOS!\fLo crié desde\nMAGIKARP. no puedo creerlo\nqué fuerte se volvió.",
  ["TEXT_S68_6E3A"] = "Teve um velho\nestranho que\vvendia MAGIKARP.\fEle dizia que os\nMAGIKARP do\fLAKE OF RAGE eram\nexcelentes.",
  ["TEXT_S68_6F01"] = "…├ë, y el GIMNASIO\nde CINNABAR se ha ido. me quedé\nmuy asombrado.\f…¿Sí? estoy en\nteléfono.\v¡Salir!",
  ["TEXT_S68_6F75"] = "Casi todos los POKEMON\nle da sueño si escucha uno\nJIGGLYPUFF canta Tiene varios movimientos\nque sólo se puede utilizar mientras el\nPOKEMON duerme.",
  ["TEXT_S68_705F"] = "Gosto de cochilar\ncom o rádio ligado\v…Zzzz…",
  ["TEXT_S69_4105"] = "ECRUTEAK ya tenía\ndos torres: una al este y\notro al oeste.",
  ["TEXT_S69_4147"] = "Ah, jovencito.\n¿Aprendiste a bailar como el\n¿CHICAS KIMONOS?\fSi vas a BAILAR\nTEATRO de ellos, un viejo extraño\nTe doy algo genial, según he oído.",
  ["TEXT_S69_41DB"] = "Vou treinar lá no\nDANCE THEATER.\fQuer vir junto\ncomigo?",
  ["TEXT_S69_421A"] = "La torre que se encontraba\naquí… dijo mi abuela\nque era mucho mayor.",
  ["TEXT_S69_4269"] = "Três POKéMON\ngrandes fugiram\vcada um para um\vlado. O que eram\veles?",
  ["TEXT_S69_42AC"] = "escuché un rumor\nsobre FARO OLIVINO.\fEL POKEMON que\nsirve de faro y enfermó.\nParece que están en problemas.",
  ["TEXT_S69_4325"] = "POKEMON\nEL FARO OLIVINO fue sanado.\fLos barcos ahora pueden\nsalir al mar por la noche en paz.",
  ["TEXT_S69_4386"] = "escuché que pokemon\nestán alborotados en LAKE OF RAGE. yo\nQuería ver eso.",
  ["TEXT_S69_43CB"] = "hay mucho\nhace mucho tiempo… Esta torre\nse incendió.\fTres POKEMON sin\nnombre murió.\fUN POKÉMON\nEl arco iris descendió del cielo y el\nresucitado… ├ë una leyenda\ntransmitido por los LÍDERES DE\nGIMNASIO ECRUTEAK.\f¿I?\fyo era un\nentrenador durante mucho tiempo.\v¡Rohoho!",
  ["TEXT_S69_44D1"] = "CIDADE DE ECRUTEAK\nCidade Histórica\fOnde o Passado\nEncontra o Hoje",
  ["TEXT_S69_4513"] = "TIN TOWER\fDizem que um\nPOKéMON lendário\vpousa aqui.",
  ["TEXT_S69_4548"] = "CIDADE DE ECRUTEAK\nGINÁSIO POKéMON\vLÍDER: MORTY\fO Vidente Místico\ndo Futuro",
  ["TEXT_S69_458C"] = "ECRUTEAK DANCE\nTHEATER",
  ["TEXT_S69_45A4"] = "TORRE QUEMADA Fue destruida por\nun fuego misterioso.\fmantente alejado porque\nno es seguro.",
  ["TEXT_S69_477A"] = "Lo lamento.\fNuestro LÍDER es\nentrenando en la cueva de allí.\fno tengo idea\n¿Cuándo regresará nuestro LÍDER?",
  ["TEXT_S69_47F3"] = "Nuestro LÍDER es\nesperando por ti.\fSin embargo, sería\nimposible para un entrenador ordinario\nganar.",
  ["TEXT_S69_4865"] = "tu derrotaste\nnuestro LÍDER?\v¡Eso es increíble!\fCon tu poder,\ndebes tener éxito en\nLIGA POKEMON.",
  ["TEXT_S69_48C3"] = "Sólo los usuarios de\nEl dragón puede entrenar aquí.\nPor favor vete.",
  ["TEXT_S69_48FB"] = "Al igual que CLAIR, el\nmaestro dragón, te permití\npuedes entrar.",
  ["TEXT_S69_494A"] = "mi radio es\nroto?\vSólo esta señal.",
  ["TEXT_S69_4983"] = "¡Arooo! tu en\nmi cabeza!\f¿Hae? estoy escuchando\nmi radio!",
  ["TEXT_S69_49BD"] = "tu lo haras\n¿Tu POKéMON olvida movimientos?",
  ["TEXT_S69_49F1"] = "Todos os mestres\nde dragão vêm da\vCIDADE DE\vBLACKTHORN.",
  ["TEXT_S69_4A27"] = "SANTOS: …\f├ë sábado…\fSou SANTOS\ndo sábado…",
  ["TEXT_S69_4A57"] = "Guárdalo…",
  ["TEXT_S69_4A6B"] = "SANTOS: …\fSPELL TAG…\fGolpes do tipo\nfantasma ficam\fmais fortes…\nVai te assustar…",
  ["TEXT_S69_4AB6"] = "SANTOS: …Hasta luego\nSábado... no lo tendré\nmás regalos...",
  ["TEXT_S69_4B00"] = "SANTOS: Hoy no.\nEs sábado...",
  ["TEXT_S69_4B1E"] = "Vaya, viniste\npor ICE PATH?\fdebes ser\n¡un entrenador!",
  ["TEXT_S69_4B67"] = "CIDADE DE\nBLACKTHORN\fUm Refugio\nMontanhoso",
  ["TEXT_S69_4B91"] = "CIDADE DE\nBLACKTHORN\vPOKéMON GYM\vLÍDER: CLAIR\fA Abencoadora\nDragão",
  ["TEXT_S69_4BD9"] = "CASA DO\nAPAGADOR GOLPES",
  ["TEXT_S69_4BEF"] = "DRAGON'S DEN\nA FRENTE",
  ["TEXT_S69_4C03"] = "TRAINER TIPS\fUm POKéMON\nsegurando uma\fMIRACLEBERRY\ncura qualquer\vproblema status.",
  ["TEXT_S69_4F08"] = "sera dificil\nganar en la LIGA.\vNecesito entrenar más.\nEscuché que ELITE CUATRO es\nmás duro que los LÍDERES de\nGIMNASIO.",
  ["TEXT_S69_4FC7"] = "Aaah! A vida é\ntão difícil!",
  ["TEXT_S69_4FE4"] = "Para chegar ├á\nLEAGUE POKéMON,\ftem que atravessar\na VICTORY ROAD.\fMas a VICTORY ROAD\né difícil.\fQuase ninguém\nvai lá!",
  ["TEXT_S69_50D7"] = "Eu derrotei\noito LÍDERES,\fentão estava\nconfiante.\fVou ter que\nme esforçar mais.",
  ["TEXT_S69_51BF"] = "POKEMON no lo son\nherramientas de guerra.",
  ["TEXT_S69_51D9"] = "POKÉMON son\nsocios valiosos para toda la vida.",
  ["TEXT_S69_5278"] = "Personas y POKEMON\ncrecer a partir de sus experiencias.\fNo te quedes quieto\ny acomodado.",
  ["TEXT_S69_5326"] = "como pescar,\nen POKéMON todo se pierde si\nte rindes.",
  ["TEXT_S69_5364"] = "ROTA 26\fPOKéMON LEAGUE\nRECEPTION GATE",
  ["TEXT_S69_5413"] = "ROTA 28",
  ["TEXT_S69_55FF"] = "DARK CAVE…\fSe um POKéMON\npudesse iluminar,\veu exploraria.",
  ["TEXT_S69_5668"] = "Aaaah…",
  ["TEXT_S69_5671"] = "puedes atrapar\nPOKéMON aunque tengas seis.\nSi atrapas uno, va al tuyo.\nCAJA automáticamente.",
  ["TEXT_S69_56D9"] = "… Hnnn… ¿Eh?\fCaminé demasiado hoy\nBuscando POKÉMON.\fMe duelen los pies y\nTengo sueño... Si fuera un\nPOKéMON salvaje, sería fácil… …Zzzz…",
  ["TEXT_S69_5761"] = "…Zzzz… ¿Eh?\f¿Qué es eso? tiene\nENVIARME POR CORREO?",
  ["TEXT_S69_5790"] = "{PLAYER} entregou\no POKéMON que\vsegurava a MAIL.",
  ["TEXT_S69_57BA"] = "Veamos… …DARK CAVE toma\nel otro camino… Es bueno saberlo\nde eso.\fGracias por\ntrae esto.\fmi amigo es la gente\nbueno, ¡y tú también!\fquiero hacer algo\n¡Bien a cambio también!\f¡Ya lo sé! quiero eso\n¡guárdalo!",
  ["TEXT_S69_5896"] = "TM50 es PESADILLA.\f├ë un golpe cruel\nque lentamente roe el PS de un enemigo\ndormido.\fOoh…\nQue miedo... no quiero serlo\npesadillas.",
  ["TEXT_S69_5921"] = "Este CORREO no es\npara mi.",
  ["TEXT_S69_5939"] = "¿Por qué esto?\n¿POKEMON es raro?\fel no tiene\nCORREO ninguno.",
  ["TEXT_S69_5972"] = "¿Qué? tu no\n¿Quieres algo?",
  ["TEXT_S69_5991"] = "si tomo esto\nPOKéMON de ti, ¿qué usarás?\nen batalla?",
  ["TEXT_S69_59D5"] = "Achei um bom\nPOKéMON na DARK\vCAVE.\fVou criar ele\npara encarar o\vFALKNER.\fEle é o líder do\nGINÁSIO de VIOLET",
  ["TEXT_S69_5A45"] = "ROTA 31\fCIDADE DE VIOLET\nCIDADE DE\vCHERRYGROVE",
  ["TEXT_S69_5A6E"] = "DARK CAVE",
  ["TEXT_S69_5C4D"] = "Mis POKéMON eran\ncapturado y criado en el extranjero.\fson mios\ncompañeros en largos viajes.",
  ["TEXT_S69_5CF8"] = "no escucharé\n¡alardeas!\fNosotros POKé FANS\nTenemos una regla de no escuchar\notros se jactan",
  ["TEXT_S69_5DB2"] = "¿Sabes acerca de\n¿Bebé POKEMON?\fApuesto que lo son\n¡demasiado lindo!",
  ["TEXT_S69_5E57"] = "Sabe como POKéMON\ntêm habilidades\vdiferentes?\fPessoas são assim\ntambém. Cada uma\ftem um potencial\ndiferente.",
  ["TEXT_S69_5EE8"] = "Llegaste a\nmomento adecuado.\fLuchemos.",
  ["TEXT_S69_5FE3"] = "ROTA 39\fCIDADE DE OLIVINE\nCIDADE DE ECRUTEAK",
  ["TEXT_S69_600A"] = "MOOMOO FARM Prueba Nuestra Leche\nFresco y Sabroso",
  ["TEXT_S69_6036"] = "TRAINER TIPS\fUse HEADBUTT nas\nárvores para\vderrubar POKéMON.\fTipos diferentes\nde POKéMON caem\vdas árvores.\fUse HEADBUTT em\ntoda árvore!",
  ["TEXT_S69_6282"] = "CIDADE DE CIANWOOD\nfica bem longe\vdaqui.",
  ["TEXT_S69_62FA"] = "Nadar exercita\no corpo inteiro.\v├ë saudável.",
  ["TEXT_S69_637B"] = "Yo diría que nado\nmejor que tú.\v├ë ¡eso es!",
  ["TEXT_S69_63F5"] = "Enquanto eu boio\nassim, as ondas\vme levam.",
  ["TEXT_S69_6429"] = "Incluso no\nMirando desde aquí, CIANWOOD es\nen el otro lado",
  ["TEXT_S69_646A"] = "Hm! Tem um prédio\ngrande ├á frente!\fO que é aquilo?",
  ["TEXT_S69_649B"] = "¡Mmm! Mira estos\nentrenadores serios que llegan en masa.\f¿Qué? ¿Qué?",
  ["TEXT_S69_64E6"] = "vine en barco a\nOLIVINE, para ver las vistas y disfrutar\nel medio ambiente.\fComo es un puerto,\nEs muy diferente a una gran ciudad.",
  ["TEXT_S69_6564"] = "ha sido a\n¿TORRE DE BATALLA?\fcreo que muchos\nentrenadores fuertes ya se han reunido\nallí.\fPero con tantos\nINSIGNIAS que tienes, no deberías ir\nno está mal.",
  ["TEXT_S69_6606"] = "MONICA: Prazer, eu\nsou a MONICA de\fsegunda.",
  ["TEXT_S69_6636"] = "Como señal de\namistad, un regalo para ti!",
  ["TEXT_S69_666C"] = "MONICA: ├ë um\nitem que aumenta\fo poder de golpes\nde voar.\fEquipe um POKéMON\npássaro com\vesse item.",
  ["TEXT_S69_66DC"] = "MÓNICA: Mía\nhermanos y hermanas están dispersos\nalrededor.\fIntenta encontrarlos\n¡todos!",
  ["TEXT_S69_6737"] = "mónica: creo\nHoy no es lunes. Triste…",
  ["TEXT_S69_6767"] = "ROTA 40\fCIDADE DE CIANWOOD\nCIDADE DE OLIVINE",
  ["TEXT_S69_696E"] = "no es relajante\n¿flotar así?\v¿Bien?",
  ["TEXT_S69_69D4"] = "├ë hasta ahora hasta\nMADERA DE CIAN.\fPero volvamos a\nOLIVINE tampoco es fácil.\f¿Qué debo hacer?",
  ["TEXT_S69_6AA4"] = "Era uma noite\nescura e de\ftempestade… Eu vi\num POKéMON gigante\vvoando das ilhas.\fEle espalhava\npenas das asas\vprateadas dele.",
  ["TEXT_S69_6B6C"] = "Las cadenas no\nDéjame llegar a esa isla.",
  ["TEXT_S69_6BED"] = "Um segredo das\nWHIRL ISLANDS…\fLá dentro é\nescuro total!",
  ["TEXT_S69_6C7F"] = "Dizem que tem um\nPOKéMON enorme lá\vno fundo das\vWHIRL ISLANDS.\fO que será que\npode ser?",
  ["TEXT_S69_6D11"] = "No tenía un\n¿Canción sobre un chico de LAPRAS?",
  ["TEXT_S69_6D79"] = "Quemaduras de sol\nEs malo para la piel.\fpero no uso\nprotectora.\fno voy a contaminar\nel agua.",
  ["TEXT_S69_6E58"] = "Ouvi rugidos lá\ndo fundo das\vISLANDS.",
  ["TEXT_S69_6EC2"] = "Os cardumes de\nSTARYU acendem\vao mesmo tempo.\f├ë tão bonito que\nchega a assustar.",
  ["TEXT_S69_704C"] = "no tengo\npaciencia para pescar...",
  ["TEXT_S69_70D4"] = "¿Alguna vez has escuchado el\n¿Radios KANTO?\fLa variedad aquí\nEs bueno.",
  ["TEXT_S69_716D"] = "creo que el\nla electricidad es lo mas importante\nde nuestros días.\fSi no fuera así,\nnadie hubiera hecho tanto\nderrochar cuando la PLANTA DE ENERGÍA\ndetenido de una vez por todas.",
  ["TEXT_S69_7238"] = "El tirón de ti\nsiente en la VARILLA cuando enganchas una\nPOKéMON… ├ë el mejor\nsentimiento por un pescador como yo.",
  ["TEXT_S69_72A0"] = "ROTA 12\fNORTE: CIDADE DE\nLAVENDER",
  ["TEXT_S69_72C1"] = "ÁREA de PESCA",
  ["TEXT_S6A_40F7"] = "Uau, sua POKéGEAR\né incrível!\fFoi sua mãe quem\nlhe deu ela?",
  ["TEXT_S6A_4134"] = "Espere, {PLAYER}!",
  ["TEXT_S6A_413E"] = "¿Qué piensas?\n¿Qué estás haciendo?",
  ["TEXT_S6A_415E"] = "├ Es peligroso salir\n¡sin un POKEMON!\fPOKEMON salvaje\nsaltar de los arbustos en el camino a\nla siguiente ciudad.",
  ["TEXT_S6A_41C4"] = "Oh! Seu POKéMON\né adorável!\vQueria ter um!",
  ["TEXT_S6A_41F2"] = "¡Hola, {PLAYER}!\n¿Salir de nuevo?\fdeberías advertir\ntu madre cuando te vayas.",
  ["TEXT_S6A_4236"] = "llama a tu madre\nen POKéGEAR para contarte cómo\nse va.",
  ["TEXT_S6A_4274"] = "Ei, {PLAYER}!\fSoube que o PROF.\nELM descobriu\vnovos POKéMON.",
  ["TEXT_S6A_42A6"] = "…… Entonces este es el\nEl famoso POKéMON LABORATORIO de ELM…",
  ["TEXT_S6A_42CD"] = "...¿Qué eres?\nmirando?",
  ["TEXT_S6A_42E8"] = "CIDADE DE NEW BARK\fA cidade onde\nos ventos do\vrecomeço sopram",
  ["TEXT_S6A_4328"] = "Casa de {PLAYER}",
  ["TEXT_S6A_4332"] = "LAB POKéMON ELM",
  ["TEXT_S6A_4340"] = "CASA DO ELM",
  ["TEXT_S6A_4473"] = "¡Hola!\n¿Eres entrenador?\fLucha con LÍDER,\nganarte?",
  ["TEXT_S6A_44AC"] = "¡Oh, la la!\n¡Muy bueno de verdad!",
  ["TEXT_S6A_44CB"] = "├¿En serio? entonces\n¡Estudia debes!\v¡Sígueme!",
  ["TEXT_S6A_44F9"] = "Aquí, maestro, yo\nYo lo soy. ¡Es bueno que estudies aquí!",
  ["TEXT_S6A_4529"] = "dicen que aparecen\nfantasmas en SPROUT TOWER.\fDijeron que los ataques\nLos normales no atrapan fantasmas.\nNada en absoluto.",
  ["TEXT_S6A_4593"] = "Oye tu eres\nEntrenador POKEMON Si vences al LÍDER\nde GYM aquí, estará listo\n¡de verdad!",
  ["TEXT_S6A_45EF"] = "FALKNER, do\nGINÁSIO POKéMON\fde VIOLET, é um\nótimo treinador!\fEle herdou o\nginásio do pai\fe fez um belo\ntrabalho nele.",
  ["TEXT_S6A_4665"] = "Vi un árbol que\n¡adelante!\fSi tocas,\n¡Se retuerce y baila! ¡Legal!",
  ["TEXT_S6A_46B2"] = "CIDADE DE VIOLET\fA cidade dos\naromas de outrora",
  ["TEXT_S6A_46DC"] = "CIDADE DE VIOLET\nGINÁSIO POKéMON\vLÍDER: FALKNER\fO elegante mestre\ndo tipo voador",
  ["TEXT_S6A_4724"] = "SPROUT TOWER\fConheça o caminho\ndos POKéMON",
  ["TEXT_S6A_474D"] = "ACADEMIA POKéMON\nDO EARL",
  ["TEXT_S6A_48FA"] = "… ¿Tú otra vez?\fNo es necesario entrar\nen p├onic. no pierdo el tiempo con\nPlátanos como tú. Hablando de débiles,\nel LIDER aquí en el GYM no es\nestá aquí.\fdicen que es\ncuidando a un POKéMON enfermo en\nFARO.\f¡Huh! ¡Bu-hu-hu!\n├ë ¡simplemente suelta los POKéMON enfermos!\fUn POKéMON que no\n¡Puedes luchar por nada!\f¿Por qué no\n¿Vas a entrenar en FARO?\fVamos. tal vez tu\n¡Hazlo un poco menos débil!",
  ["TEXT_S6A_4A58"] = "Caminos oscuros\nSon peligrosos por la noche.\fPero en la oscuridad\nnoche completa, el mar esta en calma\n¡Más traicionero!\fSin luz del faro\nde FARO a guía, barco\nninguno navega.",
  ["TEXT_S6A_4B04"] = "Esta cosa que\nLo tienes, es un POKéGEAR, ¿verdad? Vaya, qué genial.",
  ["TEXT_S6A_4B41"] = "Vaya, tienes un\n¡POKÉDEX!\festo es\nsimplemente demasiado.",
  ["TEXT_S6A_4B71"] = "Olá, rapazinho!\nO mar é doce!\fCante comigo!\nEi-├┤! Puxa a corda\vcom força!…",
  ["TEXT_S6A_4BD0"] = "CIDADE DE OLIVINE\fO Porto Mais Perto\nde Outras Terras",
  ["TEXT_S6A_4C00"] = "OLIVINE PORT\nPÍER DO FAST SHIP",
  ["TEXT_S6A_4C1D"] = "CIDADE DE OLIVINE\nGINÁSIO POKéMON\vLÍDER: JASMINE\fA Garota Blindada\nda Defesa",
  ["TEXT_S6A_4C60"] = "OLIVINE LIGHTHOUSE\nTambém Conhecido\vpor GLITTER",
  ["TEXT_S6A_4C99"] = "BATTLE TOWER AQUI\nAbrindo Agora!",
  ["TEXT_S6A_4E62"] = "ana: sé lo que\nmi hermana y mis POKéMON son\npensando.",
  ["TEXT_S6A_4EEC"] = "ANNE: Sentimos o\nmesmo que os\vnossos POKéMON.",
  ["TEXT_S6A_4F80"] = "Fazer o POKéMON\ndormir ou deixar\vele paralisado são\vboas técnicas.",
  ["TEXT_S6A_4FC8"] = "SUNNY: Oi!\fEu sou o SUNNY de\nsábado, ou seja,\vhoje é sábado!",
  ["TEXT_S6A_5004"] = "me dijeron que\n¡Te doy esto si te veo!",
  ["TEXT_S6A_502F"] = "me dijeron que\n¡Te doy esto si te veo!",
  ["TEXT_S6A_505A"] = "SUNNY: Eso... Um... ...¿Qué fue eso... ...Ah! ¡Lo recordé!\nUn POKéMON que tiene movimientos\nLos dispositivos eléctricos deben aguantar.\nMi hermana MONICA dijo que aumenta\n¡Los golpes eléctricos!",
  ["TEXT_S6A_50FC"] = "SOLEADO: Mío\nmis hermanas y mis hermanos son MONICA, TUSCANY, WESLEY, ARTHUR, FRIEDA y SANTOS. ellos son\ntodos mayores",
  ["TEXT_S6A_516E"] = "SOLEADO: Hoy no\n¿Es sábado?\vMmm… ¡lo olvidé!",
  ["TEXT_S6A_5197"] = "ROTA 37",
  ["TEXT_S6A_5393"] = "¿Qué? Eso no es\neso es correcto.",
  ["TEXT_S6A_53AB"] = "quiero girar el\nEntrenador CAMPEÓN con POKéMON\nque pesqué.\f├ë la mejor parte\n¡a pescar!",
  ["TEXT_S6A_543F"] = "perder parece\npoco si nos fijamos en\ncielo enorme!",
  ["TEXT_S6A_54D6"] = "estas haciendo\n¿Una POKéDEX?\fVaya, debes saberlo\n¡Algunos POKéMON muy raros!\f¿Puedo ver?\n¿Por favor?",
  ["TEXT_S6A_5537"] = "ROTA 42\fCIDADE DE ECRUTEAK\nCIDADE DE MAHOGANY",
  ["TEXT_S6A_555F"] = "MOUNT MORTAR\fWATERFALL CAVE\nInterior",
  ["TEXT_S6A_5580"] = "MOUNT MORTAR\fWATERFALL CAVE\nInterior",
  ["TEXT_S6A_55A1"] = "ROTA 42\fCIDADE DE ECRUTEAK\nCIDADE DE MAHOGANY",
  ["TEXT_S6A_57E8"] = "Acabou. Tudo bem.\nNós HIKERS somos\vassim mesmo.",
  ["TEXT_S6A_5851"] = "di lo mejor de mi\ny no fue suficiente.\fNo hay excusa, yo\nAdmito que perdí.",
  ["TEXT_S6A_58BB"] = "Ah, droga!",
  ["TEXT_S6A_58C6"] = "he estado en muchos\nGIMNASIOS, pero el de GOLDENROD es el\nmi favorito.\fel esta lleno de\nhermosas flores!",
  ["TEXT_S6A_59BE"] = "ROTA 46\nMONTANHA a frente",
  ["TEXT_S6A_5AA5"] = "¡Oye chico! ya terminé\ntomar un café muy fuerte y estoy\n¡Conectado al 220!\fnecesito hablar\n¡Con alguien y servirás!\fPuede que no lo parezca,\npero yo era un experto en capturar\nPOKÉMON.\f¿Me crees?",
  ["TEXT_S6A_5B6F"] = "Bien, bien. si, yo\nera alguien fuera de lo común, puedo\ndecir!",
  ["TEXT_S6A_5BB7"] = "O quê? Seu\nmoleque!\fSe eu fosse um\npouco mais jovem,\feu te mostraria\numa ou duas. Tsc!",
  ["TEXT_S6A_5C11"] = "Este GIMNASIO no\nhabía un LÍDER hasta hace poco.\fun chico de\nPALLET se convirtió en LÍDER, pero vive\nfuera.",
  ["TEXT_S6A_5C7E"] = "Vai encarar o\nLÍDER?\fBoa sorte.\nVai precisar.",
  ["TEXT_S6A_5CC4"] = "¡Bostezo!\fdebí haber dormido\nal sol.\f…tuve un sueño\ncon un DROWZEE comiéndose mi sueño.\nExtraño, ¿verdad?\f¿Hay?\n¿Qué es esto?\fDe donde vino\nesta MT?\f¡Qué siniestro!\nAquí puedes quedarte con este MT.",
  ["TEXT_S6A_5D86"] = "A MT42 contém\nDREAM EATER…\f…Zzzzz…",
  ["TEXT_S6A_5DAA"] = "escuché que hay\nmuchos objetos en el suelo\nBOSQUE VIRIDIANO.",
  ["TEXT_S6A_5DEF"] = "CIUDAD VIRIDIANA El Paraíso Verde\nEterno",
  ["TEXT_S6A_5E1B"] = "CIDADE DE VIRIDIAN\nPOKéMON GYM\vLÍDER: …\fO resto do texto\nestá ilegível…",
  ["TEXT_S6A_5E60"] = "Bem-vindo a\nCIDADE DE\vVIRIDIAN,\fa Porta de Entrada\nda INDIGO PLATEAU",
  ["TEXT_S6A_5E99"] = "TRAINER HOUSE\fO Clube das Lutas\nentre Treinadores",
  ["TEXT_S6A_5F7D"] = "Este POLIIRA es\nmi compañero.\falgún día\nEvoluciona a POKéMON rana.",
  ["TEXT_S6A_5FDE"] = "lo perdí de nuevo\nmáquina tragamonedas… Ahora las chicas\ntambién jugar.\fdeberías dar\nuna mirada.",
  ["TEXT_S6A_6043"] = "Grimer tiene\napareció mucho.\fVi el lago en\nfrente a la casa?\fGrimer vive allí.\nahora.\f¿De dónde vinieron?\nEste es un problema grave…",
  ["TEXT_S6A_60DC"] = "¡Nihihi! esto\n¡El GIMNASIO es genial!\fSólo entra chica\n¡aquí!",
  ["TEXT_S6A_6115"] = "Quer saber um\nsegredo?\fA CELADON MANSION\ntem uma porta\vsecreta.",
  ["TEXT_S6A_6155"] = "esta pasando algo\nConcurso de comida en restaurante.\fsolo verlos\ncomiendo, ya me siento hinchada…",
  ["TEXT_S6A_61BD"] = "DEPARTAMENTO DE CELADÓN.\nTIENDA tiene la mayor y mejor selección.\nde bienes.\fSi no encuentras\nAhí no lo encuentras por ningún lado.\nVaya... parezco un vendedor.\ntienda.",
  ["TEXT_S6A_6306"] = "De olhar pro chão\nenquanto\fandava, fiquei\ntonto.",
  ["TEXT_S6A_6340"] = "CIDADE DE CELADON\fA Cidade dos\nSonhos Coloridos",
  ["TEXT_S6A_6369"] = "CIDADE DE CELADON\nPOKéMON GYM\vLÍDER: ERIKA\fA Princesa que\nama a Natureza",
  ["TEXT_S6A_63A9"] = "Encuentra todo\nque necesitas en el DEPARTAMENTO CELADON.",
  ["TEXT_S6A_63D4"] = "CELADON MANSION",
  ["TEXT_S6A_63E5"] = "A diversão de\ntodos,CELADON GAME\vCORNER",
  ["TEXT_S6A_6418"] = "DICAS de TREINO\fGUARD SPEC.\nprotege POKéMON\fcontra ataques\nSPECIAL, como\vfogo e água.\fCompre seus itens\nna CELADON DEPT.\vSTORE!",
  ["TEXT_S6A_660D"] = "antes de girar\nmaestro, se me olvidó mucho\ncosa.",
  ["TEXT_S6A_66CA"] = "Estudar é\nimportante, mas se\vexercitar também.",
  ["TEXT_S6A_6740"] = "mi madre si\nMe preocupa mucho tengo que llamar\ntodo el tiempo.",
  ["TEXT_S6A_67BC"] = "¡Sayonara! ya terminé\npara aprender esto en clase de japonés",
  ["TEXT_S6A_684A"] = "Me cansé de caminar.\nNecesito un descanso.",
  ["TEXT_S6A_68B0"] = "Se POKéMON fosse\nmatéria na escola,\veu era o melhor!",
  ["TEXT_S6A_68E3"] = "ROTA 15\fCIDADE DE FUCHSIA\nCIDADE DE LAVENDER",
  ["TEXT_S6A_6A15"] = "VERMILION PORT é\na porta marítima\vde KANTO.\fNavios de luxo\ndo mundo todo\vaportam aqui.",
  ["TEXT_S6A_6A6F"] = "mi pokemon es\npreparando el terreno para la obra.\fpero no tengo\ndinero para empezar...",
  ["TEXT_S6A_6AE2"] = "Um MACHOP rosna\nenquanto pisa o\vchão para\vaplainar.",
  ["TEXT_S6A_6B1A"] = "Há oito GINÁSIOS\nem KANTO.\fAquele prédio\ngrande é o GINÁSIO\vde VERMILION.",
  ["TEXT_S6A_6B64"] = "SNORLAX ronca\ntranquilamente…",
  ["TEXT_S6A_6B84"] = "Colocaram a\nPOKéGEAR perto do\vSNORLAX dormindo…\f…\fSNORLAX acordou!",
  ["TEXT_S6A_6BC8"] = "Entrenadores\nPersonas capacitadas se reúnen en KANTO.\nLOS LÍDERES son fuertes y no lo son.\nfácil de vencer.",
  ["TEXT_S6A_6C2B"] = "empezaste a\n¿Coleccionar INSIGNIAS KANTO?\f¿No crees?\n¿Que los entrenadores aquí son fuertes?",
  ["TEXT_S6A_6C88"] = "creo que tu\npronto terminará con la conquista\nde GIMNASIOS KANTO.\nAvísame si lo pillas a las ocho",
  ["TEXT_S6A_6CF3"] = "¡Felicidades!\fTomaste el\nINSIGNIAS KANTO.\ftengo un premio\npara ti.",
  ["TEXT_S6A_6D4A"] = "Uma variedade\nde tipos POKéMON\fte dá vantagem\nna batalha.\fTenho certeza\nque as GYM BADGES\vde KANTO ajudam.",
  ["TEXT_S6A_6DB9"] = "CIDADE DE\nVERMILION\fO Porto dos\nBelos P├┤r do Sol",
  ["TEXT_S6A_6DE7"] = "CIDADE DE\nVERMILION\vPOKéMON GYM\vLÍDER: LT.SURGE\fO Americano\nRel├ómpago",
  ["TEXT_S6A_6E28"] = "POKéMON FAN CLUB\fTodos os Fãs de\nPOKéMON",
  ["TEXT_S6A_6E4E"] = "CAVERNA DIGLETT",
  ["TEXT_S6A_6E5E"] = "VERMILION PORT\nENTRADA",
  ["TEXT_S6A_6FD9"] = "Mi POKéMON\nse lastimó antes de unirse a ROCK\nTÚNEL.\f├ë mejor toma\nllévalos al CENTRO POKéMON ahora.",
  ["TEXT_S6A_707C"] = "A gente assa um\nmonte de doces\fe divide com todo\nmundo. ├ë delícia!",
  ["TEXT_S6A_70F6"] = "Lo siento. tu no\ntiró basura. Fue mi error.",
  ["TEXT_S6A_715F"] = "Ahorra energía\nes importante, pero el medio ambiente es\naún más.",
  ["TEXT_S6A_7210"] = "La batalla es una\ncuestión de enfoque.",
  ["TEXT_S6A_7278"] = "A POWER PLANT fica\ndo outro lado de\vum riacho.",
  ["TEXT_S6A_72A2"] = "ROTA 9\fCIDADE DE CERULEAN\nROCK TUNNEL",
  ["TEXT_S6A_7335"] = "O BLAINE, do\nCINNABAR GYM,\fparece morar\nsozinho na caverna\fdas SEAFOAM\nISLANDS…",
  ["TEXT_S6A_737F"] = "ha pasado un año\ndesde que el volcán entró en erupción",
  ["TEXT_S6A_740A"] = "O vulcão de\nCINNABAR estourou\fEle jogou pedras\nque fecharam a\vROTA 19 de vez.\fFico pensando se\no povo de CINNABAR\vestá a salvo…",
  ["TEXT_S6A_748A"] = "Nenhum morador de\nCINNABAR se feriu\fcom a erupção.\nQue ótimo!",
  ["TEXT_S6A_7548"] = "BLAINE: ¡Guau!\fMi gimnasio en\nCINABAR ardía.\fYo y mi POKEMON\ndel fuego nos quedamos sin hogar para\ncausa del volcán.\fBuaaa!\fPero estoy de vuelta activo\ncomo LÍDER DE GIMNASIO aquí en\ncueva.\fsi me ganas\nTe doy una INSIGNIA.\f¡Hay! mejor tomar\n¡QUEMA Y SANA!",
  ["TEXT_S6A_7646"] = "BLAINE: Demasiado.\nEstoy agotado... Tú ganaste el\n¡INSIGNIA DEL VOLCÁN!",
  ["TEXT_S6A_7683"] = "{PLAYER} recebeu\na VOLCANOBADGE.",
  ["TEXT_S6A_769D"] = "BLAINE: Perdí.\nEsta vez, pero ganaré.\nsiguiente.\fcuando rehago\nmi GIMNASIO, en CINNABAR,\ntendremos una revancha.",
  ["TEXT_S6A_771C"] = "BLAINE: Mío.\nlos POKéMON de fuego serán aún más\nfuerte. ¡Mirar!",
  ["TEXT_S6A_7759"] = "¡Y ahí!\f…¿Eh? ¿Ya terminó?\ntan rapido?\f¡Lo siento, hombre!\fEL GIMNASIO\nCINNABAR desapareció, así que no lo sabía.\ndonde encontrarte.\fpero tu eres\nmuy fuerte, incluso sin mi consejo.\n¡Ya lo sabía!",
  ["TEXT_S6A_7806"] = "Un gimnasio puede\nestar en cualquier lugar, siempre y cuando\nel LÍDER esté ahí. no necesito\nedificio.",
  ["TEXT_S6B_4130"] = "¡Guau, muchacho! tu\nhay más gasolina.",
  ["TEXT_S6B_4153"] = "Nós HIKERS somos\nmelhores nas\vmontanhas.",
  ["TEXT_S6B_41E7"] = "Ufa, ufa…\fFinalmente saí\ndaquela caverna.\fEra bem maior do\nque eu esperava.\fFiquei cansado\ndemais pra\vexplorar tudo\fentão vim pra\nfora.",
  ["TEXT_S6B_4279"] = "ROTA 33",
  ["TEXT_S6B_434D"] = "Vou procurar\nPOKéMON inseto\vmais fortes.",
  ["TEXT_S6B_43CF"] = "realmente arde\ncuando te duchas.",
  ["TEXT_S6B_4423"] = "insecto pokemon\naplastar como un animal de peluche\ncuando les aprietas la barriga.\fMe encanta como ellos\nson!",
  ["TEXT_S6B_447A"] = "ROTA 2\fCIDADE DE VIRIDIAN\nCIDADE DE PEWTER",
  ["TEXT_S6B_449F"] = "CAVERNA DIGLETT",
  ["TEXT_S6B_45D7"] = "Para treinadores,\né lei que a gente\fbatalhe sempre que\nse encontra.",
  ["TEXT_S6B_4640"] = "Eres fuerte.\fPuedes ver eso\nentrenado mucho.",
  ["TEXT_S6B_4675"] = "ROTA 1\fCIDADE DE PALLET\nCIDADE DE VIRIDIAN",
  ["TEXT_S6B_46E7"] = "yo también creo\nPOKÉMON.\fEllos sirven como\nmis guardias",
  ["TEXT_S6B_4720"] = "La tecnología es\nincreible!\f¿Puedes intercambiar?\nPOKéMON en el tiempo como correo electrónico.",
  ["TEXT_S6B_476B"] = "CIDADE DE PALLET\fUm lugar sereno,\nde paz e pureza",
  ["TEXT_S6B_479D"] = "CASA do RED",
  ["TEXT_S6B_47AA"] = "LABORATÔRIO de\nPESQUISA do OAK",
  ["TEXT_S6B_47C1"] = "CASA do BLUE",
  ["TEXT_S6B_4873"] = "Esse cara metido\nestava no vulcão\vde CINNABAR.",
  ["TEXT_S6B_48F1"] = "Tenho que tomar\ncuidado com as\vmanchas do sol.",
  ["TEXT_S6B_495C"] = "Vou voltar a\npescar…",
  ["TEXT_S6B_49D2"] = "¿Quién eres?\fBueno, es obvio\nque eres entrenador… Mi nombre es AZUL.\fUna vez fui el\nCAMPEÓN, aunque fue por\npoco tiempo… ese ROJO\nvencerme... De todos modos, ¿qué\nquieres? ¿Quieres desafiarme o\n¿qué?\f...odio decir,\nPero no tengo ganas de pelear\nahora.\fmira tu\nalrededor… Entra un volcán\nestallando, y de repente, un\nla ciudad desaparece.\fpodemos ganar\ny perder en peleas POKéMON. pero\nsi la naturaleza se mueve, morimos\nen un segundo.\f… ├ë tan pronto como\nlas cosas están... Pero de todos modos, todavía\nSoy entrenador.\fsi veo uno\nBuen oponente, me dan ganas de pelear.\nSi quieres, acércate al VIRIDIAN GYM. voy a ir a ti\ncara.",
  ["TEXT_S6B_4C73"] = "Há um aviso…\naqui…\fO GINÁSIO de\nCINNABAR mudou\vpara as ILHAS\vSEAFOAM.\fBLAINE",
  ["TEXT_S6B_4CC2"] = "CINNABAR ISLAND\fA Cidade Fogo de\nDesejo Ardente",
  ["TEXT_S6B_4D93"] = "Ejercicios de natación\ntodo el cuerpo.\flo hace muy bien\npara ti.",
  ["TEXT_S6B_4E15"] = "SURF ya no es el\nUn solo golpe de HM que sirve en el agua.",
  ["TEXT_S6B_4E8B"] = "Além do mar, eu\ntambém nado em\vlagos e rios.",
  ["TEXT_S6B_4EC2"] = "O que este cartaz\ndiz?\fCINNABAR GYM\nLÍDER: BLAINE",
  ["TEXT_S6B_4FA5"] = "que fuerte eres\nDebe ser divertido luchar.",
  ["TEXT_S6B_500D"] = "Si no tienes\nuna BICICLETA, no se puede utilizar la\natajo.",
  ["TEXT_S6B_5051"] = "ROTA 18\fCIDADE DE CELADON\nCIDADE DE FUCHSIA",
  ["TEXT_S6B_513B"] = "No pienses,\n¡JOHTO niño!",
  ["TEXT_S6B_5196"] = "me veo genial\npero soy débil y luego no soy nada.\ftengo que entrenar\nmás…",
  ["TEXT_S6B_5225"] = "Andar sem as mãos\né considerado bom\vna CYCLING ROAD.",
  ["TEXT_S6B_5293"] = "Direção imprudente\ncausa acidente!\vVá com calma!",
  ["TEXT_S6B_532F"] = "CYCLING ROAD\fDescida livre\naté o fim!",
  ["TEXT_S6B_5388"] = "¿Qué advertencia es esta?\f…los entrenadores\ngente maleducada ha luchado en\nCAMINO SUBTERRÁNEO.\fdebido a la\nDebido a las quejas de los vecinos, el CAMINO SUBTERRÁNEO fue cerrado indefinidamente.\fPOLICÍA DE CELADÓN",
  ["TEXT_S6B_5456"] = "Está trancado…",
  ["TEXT_S6B_5508"] = "SQUIRTLE,\nCHARMANDER e\vBULBASAUR…\fAcho que é uma boa\nmistura.",
  ["TEXT_S6B_55A4"] = "¿Tienes POKEMON?\nConoces la estafa FLY, ¿no? que\nenvidia.",
  ["TEXT_S6B_5660"] = "si hubiera uno\nmanera fácil de saber de dónde saqué mi POKéMON...",
  ["TEXT_S6B_5702"] = "Que prédio é\nesse, hein?\f├ë a TORRE de\nRÁDIO de KANTO.",
  ["TEXT_S6B_573A"] = "KANTO tiene mucho\nprograma de radio",
  ["TEXT_S6B_575C"] = "As pessoas vêm de\nlonge para\fhomenagear as\nalmas dos\vPOKéMON.",
  ["TEXT_S6B_57AC"] = "necesitas\nuna FLAUTA POKé para despertar a POKéMON. Todos\n¡El entrenador lo sabe!",
  ["TEXT_S6B_57F7"] = "CIDADE DE LAVENDER\fA Cidade Nobre\nRoxa",
  ["TEXT_S6B_581C"] = "RÁDIO KANTO\nSTATION\fSeus Programas\nFavoritos no Ar\v24 Horas!",
  ["TEXT_S6B_5861"] = "LAVENDER VOLUNTEER\nPOKéMON",
  ["TEXT_S6B_5880"] = "SOUL HOUSE\fQue as Almas dos\nPOKéMON",
  ["TEXT_S6B_5957"] = "A estrada está\nfechada até que\fo problema na\nUSINA se resolva.",
  ["TEXT_S6B_599B"] = "UNDERGROUND PATH\fCIDADE DE\vCERULEAN\vCIDADE DE\vVERMILION",
  ["TEXT_S6B_59FF"] = "mira que lindo\n¡Mi PHANPY es!\fno es lindo\n¿Suficiente para derretir tu corazón?",
  ["TEXT_S6B_5A88"] = "mira que lindo\nmi TEDDIURSA es!\fno es lindo\n¿Suficiente para derretir tu corazón?",
  ["TEXT_S6B_5B22"] = "A estrada está\nfechada até que\fo problema na\nUSINA se resolva.",
  ["TEXT_S6B_5B66"] = "UNDERGROUND PATH\fCIDADE DE\vCERULEAN\vCIDADE DE\vVERMILION",
  ["TEXT_S6B_5B97"] = "O que é isto?\fCasa ├á venda…\nNinguém mora aí.",
  ["TEXT_S6B_5C2E"] = "¡Oye, muchacho! yo\ndel TEAM ROCKET ¡Soy como un chico!\fDe otro pais\n¡Vine, entrenador número uno, yo!\fPensé, si\nparada de energía, gran p├onic\n¡Fuera de aquí gente!\fmi secreto\n¡La misión es, así que no hablo!\f¡Pero! si luchas\ngolpéame, soy un hombre y mi\ncuento secreto.\f¡Oye chico!\n¡Comienza la batalla!",
  ["TEXT_S6B_5D67"] = "¡Ay! No, no,\n¡No, no me creo!\fmuy fuerte\n¡tú lo eres! ¡No te soporto!",
  ["TEXT_S6B_5DC0"] = "DE ACUERDO. Dile a mi\nLo haré en secreto.\fPIEZAS DE LA MÁQUINA\nrobé del gimnasio\nCERÚLEO se escondió.\fEn el agua tengo pus.\nBuscar en medio del agua\ndel GIMNASIO.\fchico, pero\n¡no me olvides!\fGana de ti\nSe va el EQUIPO ROCKET. Por JOHTO\nmis amigos vendrán. y el\n¡La venganza vendrá!",
  ["TEXT_S6B_5EE1"] = "…\f¿Qué? EL EQUIPO\n¿Adiós COHETE? Se acabó\n¿dijiste?\f¡Oh, no! que\n¿Qué hago conmigo mismo ahora?",
  ["TEXT_S6B_5FF7"] = "Quando chove, é\ndifícil dar a\vpartida…",
  ["TEXT_S6B_6051"] = "Te veías bien.\festaba asustado de\nenfrentarte...",
  ["TEXT_S6B_60A9"] = "llevo pantalones cortos\ntodo el año.\f├ë mi regla\nde la moda.",
  ["TEXT_S6B_6118"] = "El mayor escupidor\nde fuego de KANTO soy yo.\fPero no es el mejor\nentrenador…",
  ["TEXT_S6B_6163"] = "MT.MOON SQUARE ├ë simplemente sube al\nescaleras.",
  ["TEXT_S6B_6258"] = "Se tem um POKéMON\nespecífico que\vquer treinar,\fponha ele na\nfrente e troque\vna hora.\f├ë assim que\nse faz.",
  ["TEXT_S6B_6320"] = "Escuché que CLEFAIRY\naparecer en MT.MOON.\fPero ¿dónde estará?\n¿lo son?",
  ["TEXT_S6B_6369"] = "……Vou treinar\nmais um pouco…",
  ["TEXT_S6B_6384"] = "MT.MOON SQUARE ├ë simplemente sube al\nescaleras.",
  ["TEXT_S6B_643B"] = "A alergia está me\nfazendo espirrar!\vAtchiiim!",
  ["TEXT_S6B_64A9"] = "mira lo que tu\nhice con POKéMON no lo haré\nolvídate de eso...",
  ["TEXT_S6B_64DC"] = "ROTA 10\fCIDADE DE CERULEAN\nCIDADE DE LAVENDER",
  ["TEXT_S6B_653A"] = "INDIGO PLATEAU\fO Objetivo Final\ndos Treinadores!\fLIGA POKéMON HQ",
  ["TEXT_S6B_65A0"] = "Entrenadores que\nbuscar poder subir al MT.SILVER a pesar\nde los muchos peligros… Con tu POKéMON\nde confianza, deben sentir que\npuedes ir a cualquier parte...",
  ["TEXT_S6B_6682"] = "Ay dios mío.\nMe encontraste.\fPor favor no\ndíselo a cualquiera.\fte doy esto\npara guardar el secreto. ¿Sí?",
  ["TEXT_S6B_66F0"] = "├ë difícil serlo\ncelebridad.\fdondequiera que yo\nVamos, persígueme.\fsolo queria\nquédate en paz...",
  ["TEXT_S6C_4000"] = "Bom dia!\nBem-vindo ao nosso\vCENTRO POKéMON.",
  ["TEXT_S6C_402B"] = "Olá!\nBem-vindo ao nosso\vCENTRO POKéMON.",
  ["TEXT_S6C_404F"] = "Boa noite!\nSaiu tarde, hein?\fBem-vindo ao nosso\nCENTRO POKéMON.",
  ["TEXT_S6C_417A"] = "Podemos curar seus\nPOKéMON até a\vsaúde perfeita.\fCuramos os seus\nPOKéMON?",
  ["TEXT_S6C_41BD"] = "Está bien, puedo ver\n¿Tu POKEMON?",
  ["TEXT_S6C_41D7"] = "gracias por\nespera.\fTus POKéMON son\ncurado.",
  ["TEXT_S6C_420B"] = "Esperamos te ver\nde novo.",
  ["TEXT_S6C_4241"] = "Tu POKEMON\nparece estar infectado por\ndiminutas formas de vida.\fTus POKéMON son\nsano y lucir bien.\fPero no podemos\nno decir nada más en un POKéMON\nCENTRO.",
  ["TEXT_S6C_435A"] = "Está cheia de\nlivros difíceis.",
  ["TEXT_S6C_4378"] = "Uma coleção\ninteira de livros\vde POKéMON!",
  ["TEXT_S6C_43A3"] = "Revistas de\nPOKéMON… POKéMON\vPAL,\fPOKéMON HANDBOOK,\nPOKéMON GRAPH…",
  ["TEXT_S6C_43D9"] = "JURAMENTO ROCKET\f¡Robar POKéMON\npor dinero!\f¡Explotar POKéMON\npor dinero!\f¡Los POKéMON existen\npara la gloria del\vTEAM ROCKET!",
  ["TEXT_S6C_4448"] = "¿Qué es esto?\f¡Ah, es un\nincensario!",
  ["TEXT_S6C_4472"] = "¡Un montón de\nproductos de\vPOKéMON!",
  ["TEXT_S6C_448D"] = "Es el MAPA del PUEBLO.",
  ["TEXT_S6C_44A0"] = "¡Mi reflejo!\n¡Qué guay!",
  ["TEXT_S6C_44BE"] = "Es una TV.",
  ["TEXT_S6C_44C9"] = "DIARIO POKéMON\nPÁGINA PRINCIPAL…\fNo se ha\nactualizado…",
  ["TEXT_S6C_4526"] = "Aquí dentro no\nhay nada…",
  ["TEXT_S6C_457F"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_S6C_459C"] = "Todo tuyo\nPOKéMON Necesita TIENDA POKéMON",
  ["TEXT_S6C_45BF"] = "Juzguemos ahora\nel POKéMON que atrapaste.\f……\n…… Ya hemos elegido el\nganadores!\f¿Estás listo?\npara esto?",
  ["TEXT_S6C_465B"] = "Volte para o\npróximo Concurso!",
  ["TEXT_S6C_4681"] = "Todos os outros\nganham uma BERRY\vde consolação!",
  ["TEXT_S6C_46B7"] = "Esperamos que vá\nmelhor na próxima",
  ["TEXT_S6C_46D9"] = "Vamos devolver o\nPOKéMON que\fguardamos.\nAqui está!",
  ["TEXT_S6C_470D"] = "Seu grupo está\ncheio, então o\fPOKéMON foi para\na BOX do BILL.",
  ["TEXT_S6C_477F"] = "Bem-vindo ao\nGAME CORNER.",
  ["TEXT_S6C_479C"] = "Necesito chips\njuego?\fOh, no tienes\nun MONEDEROS para ellos.",
  ["TEXT_S6C_47E3"] = "Precisa de umas\nfichas de jogo?\fSão ┬Ñ1000 por\n50 fichas. Quer\vcomprar?",
  ["TEXT_S6C_4830"] = "Obrigado!\nAqui, 50 fichas.",
  ["TEXT_S6C_484F"] = "¡Gracias! aquí\nhay 500 fichas.",
  ["TEXT_S6C_486F"] = "no tienes\ndinero.",
  ["TEXT_S6C_488C"] = "Opa! Sua COIN\nCASE está cheia.",
  ["TEXT_S6C_48AD"] = "Sem fichas hoje?\nVolte sempre!",
  ["TEXT_S6C_48CC"] = "Ué? Sua BOLSA está\ncheia.\fVamos guardar isto\npor hoje, então\fvolte quando tiver\nespaço para ele.",
  ["TEXT_S6C_492A"] = "¡Guau! tu y tu\n¡Los POKéMON están muy unidos!",
  ["TEXT_S6C_4954"] = "POKéMON se vuelven más\namigos si pasas tiempo\ncon ellos.",
  ["TEXT_S6C_4989"] = "no domesticaste\ntu POKéMON.\fSi no está bien,\nél se enfurruña.",
  ["TEXT_S6C_6054"] = "MT.SILVER",
  ["TEXT_S6C_6086"] = "KANTO POWER PLANT",
  ["TEXT_S6D_4000"] = "Al├┤?\fAh, oi, {PLAYER}!\nTrabalhando duro?",
  ["TEXT_S6D_4150"] = "eso se ve bien\ndifícil.\fPero, {PLAYER}, yo\nSé que estás decidido. ir\nestar bien, ¿verdad?",
  ["TEXT_S6D_41EA"] = "├ë importante\nguardar dinheiro.",
  ["TEXT_S6D_420D"] = "Ah, {PLAYER},\nNo te guardas nada.\n¿Quieres ahorrar?",
  ["TEXT_S6D_4289"] = "Certo. Eu guardo\nseu dinheiro.",
  ["TEXT_S6D_42C0"] = "{PLAYER}, continue\nassim! Estou\vtorcendo, filho!",
  ["TEXT_S6D_42EA"] = "¿Al├┤?\f¡Hola, {PLAYER}!\n¿No estaba esperando el PROF.ELM?",
  ["TEXT_S6D_431D"] = "¿Al├┤?\f¡Hola, {PLAYER}!\nEstás en una misión PROF.\n¿OLMO? ¡Comportarse!",
  ["TEXT_S6D_435F"] = "¿Al├┤?\f¡Hola, {PLAYER}! sí\nHas terminado tu mensaje, vuelve\nvete a casa, hijo.",
  ["TEXT_S6D_43A1"] = "¿Al├┤?\f…… {PLAYER} ?\nPROF.ELM me dijo que estabas\nen un largo viaje desearía que lo hubieras hecho\nme dijo… ¿Y el dinero?\n¿Me lo quedo?",
  ["TEXT_S6D_4427"] = "Bom dia!\fAqui é o SERVI├çO\nDE ADMINISTRA├çÃO\fDO SISTEMA DE\nARMAZENAMENTO.",
  ["TEXT_S6D_4470"] = "Boa tarde!\fAqui é o SERVI├çO\nDE ADMINISTRA├çÃO\fDO SISTEMA DE\nARMAZENAMENTO.",
  ["TEXT_S6D_44B5"] = "Boa noite!\fAqui é o SERVI├çO\nDE ADMINISTRA├çÃO\fDO SISTEMA DE\nARMAZENAMENTO.",
  ["TEXT_S6D_44FE"] = "¿Quién habla?\f {PLAYER}, ¿eres tú?\nSólo un segundo… ……\n……",
  ["TEXT_S6D_45ED"] = "Gracias por\nespera!\f {PLAYER}, tu CAJA\n¡Está lleno!\ftendrás que cambiar\nBOX si quieres conseguir más\nPOKÉMON.",
  ["TEXT_S6D_4652"] = "Hola, ¿{PLAYER}?\n¡Soy yo, BILL!\fGracias por usar\nel SISTEMA DE ALMACENAMIENTO.\fEl ultimo pokemon\nque enviaste llenó tu BOX.\ftendrás que cambiar\nBOX si quieres conseguir más\nPOKÉMON.\f¡Hasta luego!",
  ["TEXT_S6D_46FC"] = "Al├┤, {PLAYER}?\fno lo intentes\nexagerar.\fCura a tu POKEMON\ncada vez que se lastiman.",
  ["TEXT_S6D_4749"] = "Al├┤, {PLAYER}?\fEncontrou o MR.\nPOKéMON? Ôtimo!\vVolte em paz!",
  ["TEXT_S6D_4784"] = "¿{PLAYER}? yo soy\nmuy molesto.\frobaron uno\nPOKéMON desde aquí.\f¿Cómo lo hace alguien?\nalgo asi?",
  ["TEXT_S6D_47D5"] = "Al├┤, {PLAYER}?\fEstamos checando o\nEGG. Ele parece\fmesmo ser um\nEGG de POKéMON.",
  ["TEXT_S6D_481C"] = "Al├┤, {PLAYER}?\fViu meu\nassisten-te? Ele\vestá no\fCENTRO POKéMON de\nCIDADE DE VIOLET.",
  ["TEXT_S6D_4868"] = "Al├┤, {PLAYER}?\fComo está o EGG?\nMudou algo?\fSe acontecer algo,\npor favor ligue.",
  ["TEXT_S6D_48BB"] = "Al├┤, {PLAYER}?\nComo está o EGG?\fO quê? Chocou?\nUau! Que tipo de\vPOKéMON é?\fVenha me mostrar\nagora!",
  ["TEXT_S6D_491F"] = "Al├┤, {PLAYER}?\fAcabei de fazer\numa descoberta.\fO tempo que um\nEGG leva para\fchocar depende do\nPOKéMON.",
  ["TEXT_S6D_4982"] = "Al├┤, {PLAYER}?\ftodavía es un\nMisterio que golpea a un POKéMON\nsorprendido, ya sabes.\fnosotros somos\ninvestigando esto ahora.",
  ["TEXT_S6D_49E7"] = "Al├┤, {PLAYER}?\fdescubrí algo\nextraño.\fParece que hay\nalgo llamado POKéRUS que\ninfecta a POKEMON.\fSí, es como un\nvirus, por eso se llama POKéRUS.\fSe multiplica\nrápidamente e infecta a otros POKéMON.\nPero eso es todo.\fNo parece funcionar\nnada y desaparece con el tiempo\nsolo.\fno creo que lo sea\nnada de qué preocuparse. ¡Adiós!",
  ["TEXT_S6D_4B17"] = "¿A-al├┤?  ¿{PLAYER}?\n├ë un desastre!\fOh, um, sí\nterrible!\f¿Qué debo hacer?\nEso... Oh no... Por favor vuelve.\n¡por aquí ahora!",
  ["TEXT_S6D_4B87"] = "Al├┤, {PLAYER}?\nDescubrimos algo sobre el\n¡HUEVO!\fmi asistente\nestá en el CENTRO POKEMON DE LA CIUDAD\nDE VIOLETA. ¿Puedes hablar con él?",
  ["TEXT_S6D_4C06"] = "{PLAYER}, como\n¿van las cosas?\fLlamé porque hay\nalgo extraño le pasa a la\ntransmisiones.\festaban hablando\ndel EQUIPO ROCKET.\f {PLAYER}, usted\n¿Sabes algo?\fEQUIPO\n¿ROCKET ha vuelto?\fNo, eso no puede\nser verdad.\fPerdón por molestar\n¡Cuídate!",
  ["TEXT_S6D_4D09"] = "Al├┤, {PLAYER}?\ftengo algo\naquí para ti.\f¿Puedes dar un\npasado en el LAB?\f¡Hasta luego!",
  ["TEXT_SAFARI_ZONE_WARDENS_HOME_BG_001"] = "..Mi abuelo├┤ es\nGUARDIÁN de ZONA SAFARI.\f¿O fue...? Decidió tomarlo.\nvacaciones y salí\ndel país solo.\fSAFARI abandonado\nZONA así, salida de la nada.",
  ["TEXT_SAFARI_ZONE_WARDENS_HOME_BG_002"] = "..Mi abuelo├┤ es\nGUARDIÁN de ZONA SAFARI.\f¿O fue...? Decidió tomarlo.\nvacaciones y salí\ndel país solo.\fSAFARI abandonado\nZONA así, salida de la nada.",
  ["TEXT_SAFARI_ZONE_WARDENS_HOME_BG_003"] = "├ë a foto de um\nvelho sorridente\fcercado de\nPOKéMON.",
  ["TEXT_SAFARI_ZONE_WARDENS_HOME_BG_004"] = "├ë a foto de uma\nplanície enorme\fcom POKéMON raros\nbrincando nela.",
  ["TEXT_SAFARI_ZONE_WARDENS_HOME_OBJ_001"] = "Mi abuelo├┤ es\nGUARDIÁN de ZONA SAFARI.\f¿O fue...? Decidió tomarlo.\nvacaciones y salí\ndel país solo.\fSAFARI abandonado\nZONA así, salida de la nada.",
  ["TEXT_SAFFRON_CITY_BG_008"] = ".................Uma menininha\nexpert em imitar\fas pessoas mora\naqui.\fEla imita até quem\nestá\fconversando com\nela. ├ë confuso.",
  ["TEXT_SAFFRON_CITY_OBJ_001"] = "Uma menininha\nexpert em imitar\fas pessoas mora\naqui.\fEla imita até quem\nestá\fconversando com\nela. ├ë confuso.",
  ["TEXT_SAFFRON_CITY_OBJ_002"] = "\npor brincar no\vporão da\vDEPT.STORE.",
  ["TEXT_SAFFRON_CITY_OBJ_003"] = "Fui al gimnasio,\nfin de luchar con los entrenadores... Al final, terminé\nentrando al GIMNASIO vacante en el\nlado.\fVaya, que\n¡no es divertido!",
  ["TEXT_SAFFRON_CITY_OBJ_004"] = "Este es SILPH\nCO., famosa por los productos POKéMON.\fEn el pasado, el\nTEAM ROCKET quería la empresa\npor eso.",
  ["TEXT_SAFFRON_CITY_OBJ_005"] = "Nhoc… Nhoc…\fOuvi dizer que há\num grande problema\vna USINA.\fNhoc… Nhoc…",
  ["TEXT_SAFFRON_CITY_OBJ_006"] = "Entrar num beco\npela primeira\fvez me deixa\nmeio ansioso.",
  ["TEXT_SAFFRON_CITY_OBJ_007"] = "Existe um lugar\nchamado TRAINER\fHOUSE em VIRIDIAN\nonde treinadores\fde todo canto\nse reúnem.",
  ["TEXT_SAFFRON_CITY_OBJ_008"] = "nuestra ciudad era\ncitado en un programa de radio ├ë es bueno escucharlo\nun elogio para tu ciudad, pero es un\nun poco aburrido también.",
  ["TEXT_SAFFRON_GYM_OBJ_001"] = "SABRINA: Lo sabía\nque vendrías... Hace tres años yo\nTuve una visión de tu llegada.\f¿Quieres el mío?\nINSIGNIAS.\fno me gusta\nluchar, pero es mi deber como LÍDER\ndar INSIGNIAS a quienes lo acrediten\nque sea digno o digno.\fComo quieres,\n¡Mostraré mi poder psíquico!",
  ["TEXT_SAFFRON_GYM_OBJ_002"] = "De onde vem a\nsua força?",
  ["TEXT_SAFFRON_GYM_OBJ_002_AFTER"] = "De onde vem a\nsua força?",
  ["TEXT_SAFFRON_GYM_OBJ_002_BEATEN"] = "Forte…\nForte demais…",
  ["TEXT_SAFFRON_GYM_OBJ_002_SEEN"] = "La fuerza de todos\nque ganaste ven a mi!",
  ["TEXT_SAFFRON_GYM_OBJ_003"] = "te fortaleciste\nalma, no sólo habilidades.",
  ["TEXT_SAFFRON_GYM_OBJ_003_AFTER"] = "te fortaleciste\nalma, no sólo habilidades.",
  ["TEXT_SAFFRON_GYM_OBJ_003_BEATEN"] = "Sua alma tem mais\nforça que a minha",
  ["TEXT_SAFFRON_GYM_OBJ_003_SEEN"] = "O poder psíquico\né o poder da sua\valma.",
  ["TEXT_SAFFRON_GYM_OBJ_004"] = "Droga! Esqueci\nque eu previ que\vperderia para ti",
  ["TEXT_SAFFRON_GYM_OBJ_004_AFTER"] = "Droga! Esqueci\nque eu previ que\vperderia para ti",
  ["TEXT_SAFFRON_GYM_OBJ_004_BEATEN"] = "Mesmo te lendo,\neu perdi…",
  ["TEXT_SAFFRON_GYM_OBJ_004_SEEN"] = "Fufufufu…\nVejo com clareza.\fEu enxergo\nna sua alma!",
  ["TEXT_SAFFRON_GYM_OBJ_005"] = "O KARATE KING,\nmestre do\fFIGHTING DOJO, foi\narrasado agora\vpela SABRINA.",
  ["TEXT_SAFFRON_GYM_OBJ_005_AFTER"] = "O KARATE KING,\nmestre do\fFIGHTING DOJO, foi\narrasado agora\vpela SABRINA.",
  ["TEXT_SAFFRON_GYM_OBJ_005_BEATEN"] = "No tuve oportunidad...",
  ["TEXT_SAFFRON_GYM_OBJ_005_SEEN"] = "EL DOJO DE LUCHA\nAl lado alguna vez estuvo el GIMNASIO aquí.",
  ["TEXT_SAFFRON_GYM_OBJ_006"] = "Hola futuro\n¡CAMPEÓN!\ftal entrenador\nbueno ya que no lo necesitas\ndime como lidiar con POKéMON\n¿Tipo psíquico?\fespero grande\ncosas tuyas!\f¡Buena suerte!",
  ["TEXT_SAFFRON_MAGNET_TRAIN_STATION_OBJ_001"] = "Lo siento, pero el\nEl TREN MAGNÉTICO no está funcionando.",
  ["TEXT_SAFFRON_MAGNET_TRAIN_STATION_OBJ_002"] = "EL TREN IMÁN\nEs un tren super moderno que utiliza\nelectricidad e imanes para alcanzar\na una velocidad increíble.\fPero si no\nhay electricidad...",
  ["TEXT_SAFFRON_MAGNET_TRAIN_STATION_OBJ_003"] = "Antes de fazerem\na MAGNET TRAIN\fSTATION, tinha uma\ncasa ali.\fUma menina\nchamada COPYCAT\vmorava lá.",
  ["TEXT_SAFFRON_MAGNET_TRAIN_STATION_OBJ_004"] = "Hola. ¿Tienes un\n¿PASAR en tren? Yo tengo uno. Todos\nmundo en AZAFRÁN que cabalga sobre IMÁN\nTREN tiene uno.",
  ["TEXT_SAFFRON_MART_OBJ_001"] = "Tem uma RADIO\nTOWER bem grande\vem LAVENDER.",
  ["TEXT_SAFFRON_MART_OBJ_002"] = "Tem uma RADIO\nTOWER bem grande\vem LAVENDER.",
  ["TEXT_SAFFRON_POKECENTER1_F_OBJ_001"] = "¿Cómo son los\n¿CENTROS POKéMON de JOHTO?\f…Está bien, lo entiendo.\fentonces no lo son\nmuy diferentes a los de KANTO.\fentonces puedo ir\na JOHTO sin preocupaciones!",
  ["TEXT_SAFFRON_POKECENTER1_F_OBJ_002"] = "¿Cómo son los\n¿CENTROS POKéMON de JOHTO?\f…Está bien, lo entiendo.\fentonces no lo son\nmuy diferentes a los de KANTO.\fentonces puedo ir\na JOHTO sin preocupaciones!",
  ["TEXT_SAFFRON_POKECENTER1_F_OBJ_003"] = "por casualidad yo\nPasé por el TÚNEL DE ROCA. Hubo un\nalboroto allí en POWER PLANT.",
  ["TEXT_SEAFOAM_GYM_OBJ_001"] = "BLAINE: ¡Guau!\fMi gimnasio en\nCINABAR ardía.\fYo y mi POKEMON\ndel fuego nos quedamos sin hogar para\ncausa del volcán.\fBuaaa!\fPero estoy de vuelta activo\ncomo LÍDER DE GIMNASIO aquí en\ncueva.\fsi me ganas\nTe doy una INSIGNIA.\f¡Hay! mejor tomar\n¡QUEMA Y SANA!",
  ["TEXT_SEAFOAM_GYM_OBJ_002"] = "¡Y ahí!\f…¿Eh? ¿Ya terminó?\ntan rapido?\f¡Lo siento, hombre!\fEL GIMNASIO\nCINNABAR desapareció, así que no lo sabía.\ndonde encontrarte.\fpero tu eres\nmuy fuerte, incluso sin mi consejo.\n¡Ya lo sabía!",
  ["TEXT_SILPH_CO1_F_OBJ_001"] = "Bem-vindo. Este é\no PR├ëDIO da SEDE\vda SILPH CO.",
  ["TEXT_SILPH_CO1_F_OBJ_002"] = "Sólo empleado\npuedes subir las escaleras.\fPero desde que tu\nvino de muy lejos, toma esto\nrecuerdo.",
  ["TEXT_SILVER_CAVE_OUTSIDE_BG_001"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_SILVER_CAVE_OUTSIDE_BG_002"] = "MT.SILVER",
  ["TEXT_SILVER_CAVE_POKECENTER1_F_OBJ_001"] = "Entrenadores que\nbuscar poder subir al MT.SILVER a pesar\nde los muchos peligros… Con tu POKéMON\nde confianza, deben sentir que\npuedes ir a cualquier parte...",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_001"] = "si, venimos\ncortando la cola del SLOWPOKE y\nvendiéndolos.\fTodo lo que hacemos\nEs con fines de lucro.\f¡Así es!\nSomos TEAM ROCKET y lo hacemos\ntodo por dinero!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_001_AFTER"] = "si, venimos\ncortando la cola del SLOWPOKE y\nvendiéndolos.\fTodo lo que hacemos\nEs con fines de lucro.\f¡Así es!\nSomos TEAM ROCKET y lo hacemos\ntodo por dinero!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_001_BEATEN"] = "¡Argh! hoy NO es\nmi dia!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_001_SEEN"] = "¡Droga! yo estaba\nen guardia allí arriba cuando un\ngritó el viejo.\fMe asusté mucho\nque me caí aquí.\fcreo que lo haré\n¡Descarga mi ira contra ti!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_002"] = "├ë, a TEAM ROCKET\nfoi desfeita\vhá três anos.\fMas continuamos\ncom as atividades\vescondidos.\fAgora divirta-se\nvendo a gente\vaprontar!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_002_AFTER"] = "├ë, a TEAM ROCKET\nfoi desfeita\vhá três anos.\fMas continuamos\ncom as atividades\vescondidos.\fAgora divirta-se\nvendo a gente\vaprontar!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_002_BEATEN"] = "Lo hiciste bien hoy\nmocoso, ¡pero espera el próximo!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_002_SEEN"] = "¿Qué deseas?\fSi molestas al\nNuestro trabajo, ¡no habrá piedad!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_003"] = "A gente precisa da\ngrana, mas vender\vSLOWPOKETAILS?\f├ë duro ser um\nROCKET GRUNT!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_003_AFTER"] = "A gente precisa da\ngrana, mas vender\vSLOWPOKETAILS?\f├ë duro ser um\nROCKET GRUNT!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_003_BEATEN"] = "Simplesmente…\nForte demais…",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_003_SEEN"] = "Parar de tirar\nSLOWPOKETAILS?\fSe obedecêssemos,\na fama da TEAM\vROCKET acabava!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_004"] = "SLOWPOKETAILS\ncrescem rápido!\fQual o problema\nde vender elas?",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_004_AFTER"] = "SLOWPOKETAILS\ncrescem rápido!\fQual o problema\nde vender elas?",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_004_BEATEN"] = "Seu pirralho!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_004_SEEN"] = "Parar as TAILS?\f├ë, tente vencer\ntodos nós então!",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_005"] = "Um SLOWPOKE com a\nTAIL cortada…\fHã? Tem uma MAIL.\nLer?",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_006"] = "Um SLOWPOKE com a\nTAIL cortada…",
  ["TEXT_SLOWPOKE_WELL_B1_F_OBJ_007"] = "KURT: Hola,\n {PLAYER} !\fLos guardias allí\nHuyeron cuando grité.\fPero luego me caí\nbueno aquí abajo.\fgolpeé la espalda\nduro y ahora no puedo caminar ¡Maldita sea! si yo\nestuvieran bien, POKéMON habría dado\nel cambio... Oh, no hay\nmanera.\f {PLAYER}, muestra el\n¡Dales tu coraje en mi lugar!",
  ["TEXT_SLOWPOKE_WELL_B2_F_OBJ_001"] = "Espero o momento\nde evolução do\vSLOWPOKE.\fPelas minhas\nobservaç├Áes,\vdescobri algo.\fUm SLOWPOKE com\numa KING'S ROCK\fé mordido por\num SHELLDER.\fAqui, vou te\ndar uma KING'S\vROCK.",
  ["TEXT_SOUL_HOUSE_OBJ_001"] = "SEÑOR FUJI: Hola. Mmm... parece que\ntu creas tu POKéMON con amor\ny amabilidad.\f¿Quién ama a POKEMON?\nven aquí para rendir homenaje a aquellos que\nya se han ido.\fdeja el tuyo\ncondolencias a las almas de\nPOKéMON que eran, estoy seguro\nlos hace felices.",
  ["TEXT_SOUL_HOUSE_OBJ_002"] = "Hay otras tumbas\nde POKéMON aquí, creo.\ftiene muchas habitaciones\nen el que solo entra MR.FUJI.",
  ["TEXT_SOUL_HOUSE_OBJ_003"] = "Eu vim com a minha\nmãe ver túmulos\vde POKéMON…",
  ["TEXT_SPROUT_TOWER1_F_OBJ_001"] = "Sólo aquellos que llegan a\nLo mejor es que obtienes un HM.",
  ["TEXT_SPROUT_TOWER1_F_OBJ_002"] = "TORRE DE BROTES fue\nconstruido hace mucho tiempo como un lugar de\nEntrenamiento POKÉMON.",
  ["TEXT_SPROUT_TOWER1_F_OBJ_003"] = "Um BELLSPROUT de\nmais de 30 metros\fDizem que ele\nvirou o pilar\vcentral daqui.",
  ["TEXT_SPROUT_TOWER1_F_OBJ_004"] = "vio el pilar\ntemblando?\fellos estan entrenando\nallá arriba.",
  ["TEXT_SPROUT_TOWER1_F_OBJ_005"] = "todos los seres\nLos organismos vivos coexisten en cooperación.\fsiempre debemos estar\nagradecido por eso.",
  ["TEXT_SPROUT_TOWER1_F_OBJ_005_AFTER"] = "todos los seres\nLos organismos vivos coexisten en cooperación.\fsiempre debemos estar\nagradecido por eso.",
  ["TEXT_SPROUT_TOWER1_F_OBJ_005_BEATEN"] = "O-obrigado!",
  ["TEXT_SPROUT_TOWER1_F_OBJ_005_SEEN"] = "nosotros miramos\nesta torre.\fAquí expresamos\nNuestro agradecimiento para honrar a todos los POKéMON.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_001"] = "A coluna flexível\nprotege a TOWER\fmesmo contra\nterremotos.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_001_AFTER"] = "A coluna flexível\nprotege a TOWER\fmesmo contra\nterremotos.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_001_BEATEN"] = "Lutei duro, mas\nsou fraco demais.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_001_SEEN"] = "No importa como\nluchemos, la TORRE seguirá fuerte.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_002"] = "Intenté copiar el\nmovimientos suaves del BELLSPROUT\npara la batalla... Pero no entrené\nbastante bien.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_002_AFTER"] = "Intenté copiar el\nmovimientos suaves del BELLSPROUT\npara la batalla... Pero no entrené\nbastante bien.",
  ["TEXT_SPROUT_TOWER2_F_OBJ_002_BEATEN"] = "Ah, sou fraco!",
  ["TEXT_SPROUT_TOWER2_F_OBJ_002_SEEN"] = "…Balance como\nfolhas ao vento…",
  ["TEXT_SPROUT_TOWER3_F_OBJ_001"] = "Según Pokémon\nse fortalece, el entrenador también se fortalece.\fNo, espera.\nComo el entrenador consigue\nMás fuerte, el POKéMON también.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_001_AFTER"] = "Según Pokémon\nse fortalece, el entrenador también se fortalece.\fNo, espera.\nComo el entrenador consigue\nMás fuerte, el POKéMON también.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_001_BEATEN"] = "mi entrenamiento es\nincompleto…",
  ["TEXT_SPROUT_TOWER3_F_OBJ_001_SEEN"] = "Treino para achar\niluminação nos\vPOKéMON!",
  ["TEXT_SPROUT_TOWER3_F_OBJ_002"] = "No falta mucho para\nel ANCIANO.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_002_AFTER"] = "No falta mucho para\nel ANCIANO.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_002_BEATEN"] = "Sim, a sua\nconfiança é real!",
  ["TEXT_SPROUT_TOWER3_F_OBJ_002_SEEN"] = "Déjame ver el\ncuánto confías en tu POKéMON.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_003"] = "que bueno de tu parte\n¡Ha llegado!\fLA TORRE DEL BROTE,\nlugar de entrenamiento.\fPersonas y POKEMON\nPon a prueba sus vínculos para construir.\nun futuro juntos.\fyo soy la prueba\nfin.\fDéjame ver\nlos lazos entre usted y su\n¡POKÉMON!",
  ["TEXT_SPROUT_TOWER3_F_OBJ_004"] = "Que haya luz\nen tu viaje.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_004_AFTER"] = "Que haya luz\nen tu viaje.",
  ["TEXT_SPROUT_TOWER3_F_OBJ_004_BEATEN"] = "├ë mi cabeza\n¡lo cual es brillante!",
  ["TEXT_SPROUT_TOWER3_F_OBJ_004_SEEN"] = "O HM do ELDER\nilumina até a\vescuridão total.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_001"] = "Um botão secreto!\nMelhor apertar.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_002"] = "├ë una estatua de\nPERSA… Sus ojos son\nmuy brillante.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_003"] = "├ë una estatua de\nPERSA… Sus ojos son\nmuy brillante.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_004"] = "├ë una estatua de\nPERSA… Sus ojos son\nmuy brillante.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_005"] = "├ë una estatua de\nPERSA… Sus ojos son\nmuy brillante.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_006"] = "├ë una estatua de\nPERSA… Sus ojos son\nmuy brillante.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_007"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_BG_008"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_002"] = "Bum!",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_002_AFTER"] = "Ni siquiera se donde\nlas trampas son.\ftendrás que\nreúne coraje y camina.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_002_BEATEN"] = "Bum!",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_002_SEEN"] = "Heheh. Está se\nachando sortudo?\fVai lá, dê mais\num passo.\fTemos armadilhas\npostas no chão!",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_003"] = "Él está bien. lo haré\ncontar un secreto desde su escondite.\fque en el suelo hay\nen la parte delantera hay un panel de salto. Si lo pisas,\nserá enviado de regreso a\nentrada.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_003_AFTER"] = "Él está bien. lo haré\ncontar un secreto desde su escondite.\fque en el suelo hay\nen la parte delantera hay un panel de salto. Si lo pisas,\nserá enviado de regreso a\nentrada.",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_003_BEATEN"] = "Entendi…",
  ["TEXT_TEAM_ROCKET_BASE_B1_F_OBJ_003_SEEN"] = "Esto fue una vez un\nEl escondite ninja tiene trampas.\npara confundir a los atacantes.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_001"] = "A porta fechou…\fPrecisa de senha\npara abrir.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_002"] = "A porta fechou…\fPrecisa de senha\npara abrir.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_003"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_004"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_005"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_006"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_007"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_008"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_009"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_010"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_011"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_012"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_013"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_014"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_015"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_016"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_017"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_018"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_019"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_020"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_021"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_BG_022"] = "├ë el transmisor\nradio que esta enviando la señal\nsiniestro.\festa funcionando\na todo vapor.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_011"] = "Je, solo soy uno\ngruñido.\fno se el\ncontraseña. Tu mala suerte.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_011_AFTER"] = "Je, solo soy uno\ngruñido.\fno se el\ncontraseña. Tu mala suerte.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_011_BEATEN"] = "Quê? Eu perdi?",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_011_SEEN"] = "la puerta no\nabierto?\fPor qué, por supuesto.\nNecesitas una contraseña que sólo\nEl EQUIPO ROCKET lo sabe.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_012"] = "Eu apanhei de uma\ncriança na última\vmissão também.\fQuando a gente\nestava roubando\fPOKéMON, um garoto\nruivo de olhar\fmau me\narrasou…",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_012_AFTER"] = "Eu apanhei de uma\ncriança na última\vmissão também.\fQuando a gente\nestava roubando\fPOKéMON, um garoto\nruivo de olhar\fmau me\narrasou…",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_012_BEATEN"] = "Eu sabia que\nperderia…",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_012_SEEN"] = "Ah, ¿un niño?\nNo me gusta, pero tengo que hacerlo.\neliminarte.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_013"] = "Je, solo el jefe\nSabe la contraseña de esa puerta.\f¿Dónde está el jefe?\nCualquier cosa. Ve a buscar por ti mismo.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_013_AFTER"] = "Je, solo el jefe\nSabe la contraseña de esa puerta.\f¿Dónde está el jefe?\nCualquier cosa. Ve a buscar por ti mismo.",
  ["TEXT_TEAM_ROCKET_BASE_B2_F_OBJ_013_SEEN"] = "Seu pestinha\ninsuportável!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_001"] = "A porta fechou…\fPrecisa de duas\nsenhas para abrir",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_002"] = "A porta fechou…\fPrecisa de duas\nsenhas para abrir",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_003"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_004"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_005"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_006"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_007"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_008"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_009"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_BG_010"] = "JURAMENTO ROCKET\fRoubar POKéMON\npor lucro!\fExplorar POKéMON\npor lucro!\fPOKéMON existem\npara a glória da\vTEAM ROCKET!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_001"] = "LANZA: Necesidad\ndos contraseñas para entrar a la habitación\ndel jefe.\fsolo unos pocos\nROCKETS conoce estas contraseñas.\fEse COHETE de ahí\ntuvo la amabilidad de decírmelo.\f {PLAYER}, vamos\nbuscar contraseñas.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_003"] = "MURKROW: A senha\né…\fSALVE GIOVANNI.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_004"] = "la contraseña de la sala\nEl nombre del jefe es SLOWPOKETAIL.\fPero no sirve de nada\nsi no tiene ambas contraseñas.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_004_AFTER"] = "la contraseña de la sala\nEl nombre del jefe es SLOWPOKETAIL.\fPero no sirve de nada\nsi no tiene ambas contraseñas.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_004_BEATEN"] = "Está bem. Pare.\nEu conto.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_004_SEEN"] = "Se eu sei a\nsenha?\fTalvez.\fMas nenhum fracote\nvai conseguir!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_005"] = "O que é isto?\fAh, é um\nincensário!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_005_AFTER"] = "Ruarrr-rarr-rarr!\fA senha da sala\ndo chefe…\fAhn…, eu acho que\né RATICATE TAIL.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_005_BEATEN"] = "¡Ruarrr-rarr-rarr!\n¡Eres bueno!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_005_SEEN"] = "¡Ruarrr-rarr-rarr!\ftu eres yo\ndesafiante?\f¡Ja! estas loco,\n¡pero ten coraje!\f¡Eso es lo que me gusta!\fSi me ganas, yo\nTe diré una contraseña para la sala.\ndel jefe!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_006"] = "una señal de radio\neso vuelve loco a POKéMON… Mi experimento es\nun éxito total.\fmi ascenso\nestá garantizado.\fEsta derrota no\nno significa nada.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_006_AFTER"] = "una señal de radio\neso vuelve loco a POKéMON… Mi experimento es\nun éxito total.\fmi ascenso\nestá garantizado.\fEsta derrota no\nno significa nada.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_006_BEATEN"] = "Um mero erro de\ntática me custou…",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_006_SEEN"] = "trabajé en\nSILPH, pero ahora lidero la investigación\ndel EQUIPO ROCKET.\fun niño entrometido\ncómo necesitas ser castigado.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_007"] = "Si aumentamos la\nintensidad de la señal de radio para\nTransmitir lejos... Sólo estoy pensando en ello ahora.\nanimame!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_007_AFTER"] = "Si aumentamos la\nintensidad de la señal de radio para\nTransmitir lejos... Sólo estoy pensando en ello ahora.\nanimame!",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_007_BEATEN"] = "el pensamiento es mio\nfuerte, no pelees.",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_007_SEEN"] = "No me importa si el\nPOKéMON sufre la experiencia",
  ["TEXT_TEAM_ROCKET_BASE_B3_F_OBJ_008"] = "Urrggh… O cara\nde capa é\vforte demais…",
  ["TEXT_TIME_CAPSULE_BG_001"] = "O seu amigo\nestá pronto.",
  ["TEXT_TIME_CAPSULE_BG_002"] = "O seu amigo\nestá pronto.",
  ["TEXT_TIME_CAPSULE_OBJ_001"] = "O seu amigo\nestá pronto.",
  ["TEXT_TIME_CAPSULE_OBJ_002"] = "O seu amigo\nestá pronto.",
  ["TEXT_TIN_TOWER1_F_OBJ_004"] = "Lo sabía.\fte conocí\nIba a ver los POKéMON codificados por colores.\narcoíris, {PLAYER}.\ffue exactamente\ncomo predije.\fpuedo decir eso\nMi investigación no es mala.\fvoy a continuar\nestudiando POKéMON para convertirse en uno\n¡Famoso POKéMANÍACO!",
  ["TEXT_TIN_TOWER1_F_OBJ_005"] = "segundo\nla leyenda... Cuando las almas de\nPOKéMON y los humanos se comunican, desde\nDel cielo desciende un POKéMON de colores\ndel arcoiris... ¿Será el\n¿Los POKéMON legendarios nos están poniendo a prueba a los humanos?",
  ["TEXT_TIN_TOWER1_F_OBJ_006"] = "Quando a BRASS\nTOWER pegou fogo,\fdisseram que três\nPOKéMON sem nome\fmorreram. Foi\ntrágico.\fPorém…\fUm POKéMON\nde cor arco-íris…\fEm outras\npalavras…\fHO-OH desceu\ndo céu e deu\fnova vida aos\ntrês POKéMON.\fEles são…\fSUICUNE, ENTEI e\nRAIKOU.\f├ë o que\ndizem.",
  ["TEXT_TIN_TOWER1_F_OBJ_007"] = "Dicen que ambos\nLas TORRES fueron construidas para\npromover la amistad y la esperanza entre\nPOKéMON y personas.\fEso fue hace 700 años\naños, pero el ideal sigue siendo\nimportante hoy.",
  ["TEXT_TIN_TOWER1_F_OBJ_008"] = "HO-OH parece ter\ndescido\fbem aqui, na TIN\nTOWER!",
  ["TEXT_TIN_TOWER1_F_OBJ_009"] = "Isto vai te\nproteger. Pegue.",
  ["TEXT_TIN_TOWER1_F_OBJ_010"] = "own,\fdisseram que três\nPOKéMON sem nome\fmorreram. Foi\ntrágico.\fPorém…\fUm POKéMON\nde cor arco-íris…\fEm outras\npalavras…\fHO-OH desceu\ndo céu e deu\fnova vida aos\ntrês POKéMON.\fEles são…\fSUICUNE, ENTEI e\nRAIKOU.\f├ë o que\ndizem.",
  ["TEXT_TRADE_CENTER_BG_001"] = "O seu amigo\nestá pronto.",
  ["TEXT_TRADE_CENTER_BG_002"] = "O seu amigo\nestá pronto.",
  ["TEXT_TRADE_CENTER_OBJ_001"] = "O seu amigo\nestá pronto.",
  ["TEXT_TRADE_CENTER_OBJ_002"] = "O seu amigo\nestá pronto.",
  ["TEXT_TRAINER_HOUSE1_F_OBJ_001"] = "Bienvenido ├á\nTRAINER HOUSE, el lugar más nuevo\ny de moda aquí.\facabamos de abrir\npara entrenador.\f¿Puedes enfrentar?\nlo mejor del mejor logotipo\naquí abajo.",
  ["TEXT_TRAINER_HOUSE1_F_OBJ_002"] = "VIRIDIAN es el pueblo\nmás cerca de la MESETA ÍNDIGO.\fEllos hicieron este lugar\nporque pasan muchos entrenadores\naqui subiendo a INDIGO\nMESETA.",
  ["TEXT_TRAINER_HOUSE1_F_OBJ_003"] = "Fazem batalhas de\ntreino aqui\vembaixo.\fEu adoraria ver\no quanto um\ftreinador de JOHTO\nbatalha bem.",
  ["TEXT_TRAINER_HOUSE1_F_OBJ_004"] = "no creo que funcione\nser CAMPEÓN sin viajar por el mundo\ntodo y luchar con todo tipo\nde personas.\fEL CAMPEÓN\nPALLET viajó a todas las ciudades\ny pueblos de KANTO.",
  ["TEXT_TRAINER_HOUSE1_F_OBJ_005"] = "Uf… estoy dando\nun descanso de las batallas.",
  ["TEXT_UNION_CAVE1_F_OBJ_001"] = "Fui enganado e\ncomprei um\vSLOWPOKETAIL.\fTenho pena desse\ncoitado.",
  ["TEXT_UNION_CAVE1_F_OBJ_001_AFTER"] = "Fui enganado e\ncomprei um\vSLOWPOKETAIL.\fTenho pena desse\ncoitado.",
  ["TEXT_UNION_CAVE1_F_OBJ_001_BEATEN"] = "Uau! Fui derrotado\nfeio!",
  ["TEXT_UNION_CAVE1_F_OBJ_001_SEEN"] = "¡Guau! que\nsorpresa!\fno esperaba ver\n¡nadie aquí!",
  ["TEXT_UNION_CAVE1_F_OBJ_002"] = "Todos los viernes,\npuedes escuchar los rugidos de POKéMON\ndesde el fondo de la cueva.",
  ["TEXT_UNION_CAVE1_F_OBJ_002_AFTER"] = "Todos los viernes,\npuedes escuchar los rugidos de POKéMON\ndesde el fondo de la cueva.",
  ["TEXT_UNION_CAVE1_F_OBJ_002_BEATEN"] = "Puaj. mi pobre\nPOKÉMON…",
  ["TEXT_UNION_CAVE1_F_OBJ_002_SEEN"] = "camino por todos lados\nsale buscando POKéMON.\ftu también lo eres\nbuscando?\fentonces tu eres mia\nrival de colección!",
  ["TEXT_UNION_CAVE1_F_OBJ_003"] = "¡Muy bien entonces!\nDecidí.\fno me voy de aquí\n¡Hasta que mis POKéMON sean fuertes!",
  ["TEXT_UNION_CAVE1_F_OBJ_003_AFTER"] = "¡Muy bien entonces!\nDecidí.\fno me voy de aquí\n¡Hasta que mis POKéMON sean fuertes!",
  ["TEXT_UNION_CAVE1_F_OBJ_003_BEATEN"] = "Ah, ah, ah!",
  ["TEXT_UNION_CAVE1_F_OBJ_003_SEEN"] = "tu vas\npara AZALEA, ¿no?\fA ver si mi\nPOKéMON cree que eres lo suficientemente bueno para luchar.",
  ["TEXT_UNION_CAVE1_F_OBJ_004"] = "├ë o fogo do meu\nPOKéMON que acende\vesta caverna.",
  ["TEXT_UNION_CAVE1_F_OBJ_004_AFTER"] = "├ë o fogo do meu\nPOKéMON que acende\vesta caverna.",
  ["TEXT_UNION_CAVE1_F_OBJ_004_SEEN"] = "Con luz, cueva\nno asusta.\fSi eres fuerte,\nLos POKéMON tampoco dan miedo.",
  ["TEXT_UNION_CAVE1_F_OBJ_005"] = "No fim de semana\ndá para ouvir\frugidos estranhos\nlá no fundo.",
  ["TEXT_UNION_CAVE1_F_OBJ_005_AFTER"] = "No fim de semana\ndá para ouvir\frugidos estranhos\nlá no fundo.",
  ["TEXT_UNION_CAVE1_F_OBJ_005_BEATEN"] = "Me estraguei!",
  ["TEXT_UNION_CAVE1_F_OBJ_005_SEEN"] = "EL SUPERSONICO de\nZUBAT sigue dejándome confundido.\festo me irrita\nmucho por cierto!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_001"] = "he estado perdido\nmucho tiempo... no me importa\nQuédate aquí, ¡pero qué hambre!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_001_AFTER"] = "he estado perdido\nmucho tiempo... no me importa\nQuédate aquí, ¡pero qué hambre!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_001_BEATEN"] = "Uuurgh…",
  ["TEXT_UNION_CAVE_B1_F_OBJ_001_SEEN"] = "Ha pasado un tiempo desde\nNo vi a nadie más.\fNo seas tímido.\n¡Luchemos!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_002"] = "Vivo aquí.\fTambién puedes,\nsi quieres.\fTiene espacio para\nsobras, ya sabes.",
  ["TEXT_UNION_CAVE_B1_F_OBJ_002_AFTER"] = "Vivo aquí.\fTambién puedes,\nsi quieres.\fTiene espacio para\nsobras, ya sabes.",
  ["TEXT_UNION_CAVE_B1_F_OBJ_002_BEATEN"] = "¡Jajajaja! tu eres\n¡maldita sea!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_002_SEEN"] = "¡Échale un vistazo!\n¡Una visita!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_003"] = "solo yo y los mios\nPOKÉMON. Estoy loco de alegría.",
  ["TEXT_UNION_CAVE_B1_F_OBJ_003_AFTER"] = "solo yo y los mios\nPOKÉMON. Estoy loco de alegría.",
  ["TEXT_UNION_CAVE_B1_F_OBJ_003_BEATEN"] = "Vai…\nVai embora!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_003_SEEN"] = "Quem está aí?\fDeixe eu e meus\nPOKéMON em paz!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_004"] = "Debo reunirme y\ncompartir lo que descubrí.\fQuién sabe, tal vez me quede\nfamoso como PROF.ELM.",
  ["TEXT_UNION_CAVE_B1_F_OBJ_004_AFTER"] = "Debo reunirme y\ncompartir lo que descubrí.\fQuién sabe, tal vez me quede\nfamoso como PROF.ELM.",
  ["TEXT_UNION_CAVE_B1_F_OBJ_004_BEATEN"] = "usted demostró\n¡sobre mí!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_004_SEEN"] = "Vim de tão longe\npara fazer minha\vpesquisa POKéMON.\fDeixe eu mostrar\no que descobri\vnuma luta real!",
  ["TEXT_UNION_CAVE_B1_F_OBJ_006"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_UNION_CAVE_B2_F_OBJ_001"] = "Tu estilo POKEMON\nEs impresionante y colorido, sí.\ftu solo lo harás\nmejorar!",
  ["TEXT_UNION_CAVE_B2_F_OBJ_001_AFTER"] = "Tu estilo POKEMON\nEs impresionante y colorido, sí.\ftu solo lo harás\nmejorar!",
  ["TEXT_UNION_CAVE_B2_F_OBJ_001_BEATEN"] = "¿Tienes un\nestilo brillante!",
  ["TEXT_UNION_CAVE_B2_F_OBJ_001_SEEN"] = "hay dos\ntipos de personas.\fLos que tienen estilo,\ny los que no.\f¿Qué tipo de\npersona eres tu?",
  ["TEXT_UNION_CAVE_B2_F_OBJ_002"] = "Vou treinar\nsozinho até eu\vmelhorar.",
  ["TEXT_UNION_CAVE_B2_F_OBJ_002_AFTER"] = "Vou treinar\nsozinho até eu\vmelhorar.",
  ["TEXT_UNION_CAVE_B2_F_OBJ_002_BEATEN"] = "¡Ah, no! tu eres\ndemasiado bueno.",
  ["TEXT_UNION_CAVE_B2_F_OBJ_002_SEEN"] = "Estou treinando.\nTopa uma partida?",
  ["TEXT_UNION_CAVE_B2_F_OBJ_003"] = "Uma vez por semana\num POKéMON vem\vaté a beira.\fEu queria ver\nesse POKéMON…",
  ["TEXT_UNION_CAVE_B2_F_OBJ_003_AFTER"] = "Uma vez por semana\num POKéMON vem\vaté a beira.\fEu queria ver\nesse POKéMON…",
  ["TEXT_UNION_CAVE_B2_F_OBJ_003_BEATEN"] = "Prefiro fazer\ncarinho neles!",
  ["TEXT_UNION_CAVE_B2_F_OBJ_003_SEEN"] = "Se o POKéMON que\neu gosto estivesse\vlá, eu iria.\f├ë o que um\ntreinador faz.",
  ["TEXT_UNION_CAVE_B2_F_OBJ_006"] = "Tu estilo POKEMON\nEs impresionante y colorido, sí.\ftu solo lo harás\nmejorar!",
  ["TEXT_VERMILION_CITY_OBJ_001"] = "VERMILION PORT é\na porta marítima\vde KANTO.\fNavios de luxo\ndo mundo todo\vaportam aqui.",
  ["TEXT_VERMILION_CITY_OBJ_002"] = "mi pokemon es\npreparando el terreno para la obra.\fpero no tengo\ndinero para empezar...",
  ["TEXT_VERMILION_CITY_OBJ_004"] = "Há oito GINÁSIOS\nem KANTO.\fAquele prédio\ngrande é o GINÁSIO\vde VERMILION.",
  ["TEXT_VERMILION_CITY_OBJ_005"] = "SNORLAX ronca\ntranquilamente…",
  ["TEXT_VERMILION_CITY_OBJ_006"] = "Entrenadores\nPersonas capacitadas se reúnen en KANTO.\nLOS LÍDERES son fuertes y no lo son.\nfácil de vencer.",
  ["TEXT_VERMILION_FISHING_SPEECH_HOUSE_BG_001"] = "{RIVAL} d..ESTOY PESCANDO\nDUDE, el mayor de los FISHING BROS.\f¿Alguna vez has conocido\n¿El GURU DE LA PESCA en LAKE OF RAGE?\fel sueña con ver\nEl MAGIKARP más grande del mundo.\fSi no te importa,\npuede mostrarle cualquier MAGIKARP\n¿Qué pescas?\fquien te conoce\nconsigue el MAGIKARP de sus sueños.",
  ["TEXT_VERMILION_FISHING_SPEECH_HOUSE_OBJ_001"] = "estoy pescando\nGURU, el mayor de los FISHING BROS.\f¿Sabes por casualidad\nel PESCADOR WILTON? el pesca\nen la RUTA 44. Me llamó con\nun consejo increíble.\fGracias a él, yo\nCogí un montón de POKEMON raros.\n¡Qué día fue ese!",
  ["TEXT_VERMILION_GYM_BG_001"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_002"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_003"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_004"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_005"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_006"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_007"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_008"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_009"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_010"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_011"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_012"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_013"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_014"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_BG_015"] = "¡Nada! solo hay basura\naquí.",
  ["TEXT_VERMILION_GYM_OBJ_001"] = "SURGE: Oye, tú\n¡mocoso!\fTengo que admitirlo.\fPuede que no sea mucho\nEs inteligente desafiarme, ¡pero necesitas coraje!\fCuando el tema es\nPOKéMON eléctrico, ¡soy el número uno!\fnunca perdí en\ncampo de batalla.\fte electrocutaré\n¡Tal como lo hice con mis enemigos en la guerra!",
  ["TEXT_VERMILION_GYM_OBJ_002"] = "cuando yo estaba\nen el ejército, LT.SURGE salvó\nmi vida.",
  ["TEXT_VERMILION_GYM_OBJ_002_AFTER"] = "cuando yo estaba\nen el ejército, LT.SURGE salvó\nmi vida.",
  ["TEXT_VERMILION_GYM_OBJ_002_BEATEN"] = "Desculpe, falhei\ncom o LT.SURGE,\vsenhor!",
  ["TEXT_VERMILION_GYM_OBJ_002_SEEN"] = "vino a derrotar al\n¿LT.AUMENTACIÓN?\fNo mientras yo\nestán aquí!",
  ["TEXT_VERMILION_GYM_OBJ_003"] = "si las trampas\ntrabajado, ya estarías\nfrito…",
  ["TEXT_VERMILION_GYM_OBJ_003_AFTER"] = "si las trampas\ntrabajado, ya estarías\nfrito…",
  ["TEXT_VERMILION_GYM_OBJ_003_BEATEN"] = "Ooh, que choque!",
  ["TEXT_VERMILION_GYM_OBJ_003_SEEN"] = "LT.SURGE viu meu\npotencial com\fPOKéMON\nelétricos.\fAcha que vai me\nvencer?",
  ["TEXT_VERMILION_GYM_OBJ_004"] = "Nada que encontrar\npor golpearme.\fLT.SURGE es muy\nduro.",
  ["TEXT_VERMILION_GYM_OBJ_004_AFTER"] = "Nada que encontrar\npor golpearme.\fLT.SURGE es muy\nduro.",
  ["TEXT_VERMILION_GYM_OBJ_004_BEATEN"] = "Gwaaah!\nFui superado…",
  ["TEXT_VERMILION_GYM_OBJ_004_SEEN"] = "Vou te derrubar!\nPrepare-se para\vlevar um choque!",
  ["TEXT_VERMILION_GYM_OBJ_005"] = "¡Ey! Futuro\n¡CAMPEÓN!\ftuviste suerte\nesta vez.\fLT.SURGE es muy\ncauteloso.\fhay trampas\ntodo el GIMNASIO.\fPero, je, je, el\nlas trampas no están activadas.\fno tendrás\nproblema para llegar a él.",
  ["TEXT_VERMILION_MAGNET_TRAIN_SPEECH_HOUSE_BG_001"] = "..¿Conoces el\n¿TREN IMÁN?\f├ë un ferrocarril\nque va a GOLDENROD, JOHTO.",
  ["TEXT_VERMILION_MAGNET_TRAIN_SPEECH_HOUSE_BG_002"] = "..¿Conoces el\n¿TREN IMÁN?\f├ë un ferrocarril\nque va a GOLDENROD, JOHTO.",
  ["TEXT_VERMILION_MAGNET_TRAIN_SPEECH_HOUSE_OBJ_001"] = "¿Conoces el\n¿TREN IMÁN?\f├ë un ferrocarril\nque va a GOLDENROD, JOHTO.",
  ["TEXT_VERMILION_MAGNET_TRAIN_SPEECH_HOUSE_OBJ_002"] = "quiero ir a azafrán\npara ver el TREN IMÁN.",
  ["TEXT_VERMILION_MART_OBJ_001"] = "COHETE DEL EQUIPO\ndesapareció de KANTO.\feso es todo lo que tengo\nte hace feliz.",
  ["TEXT_VERMILION_POKECENTER1_F_OBJ_001"] = "UN POKEMON es\ndurmiendo frente a la CUEVA DE DIGLETT.\f├ë una oportunidad\nIncreíble de atrapar, pero cómo despertar.\n¿él?",
  ["TEXT_VERMILION_POKECENTER1_F_OBJ_002"] = "UN POKEMON es\ndurmiendo frente a la CUEVA DE DIGLETT.\f├ë una oportunidad\nIncreíble de atrapar, pero cómo despertar.\n¿él?",
  ["TEXT_VERMILION_POKECENTER1_F_OBJ_003"] = "O FAST SHIP é um\nótimo lugar para\fachar e enfrentar\ntreinadores.",
  ["TEXT_VERMILION_POKECENTER1_F_OBJ_004"] = "¿Eh? ¿Tienes algunos\nINSIGNIAS Nunca las he visto.\fAh, lo sé. tu\npillado en JOHTO.",
  ["TEXT_VERMILION_PORT_OBJ_001"] = "Vamos partir logo.\nPor favor, suba\va bordo.",
  ["TEXT_VERMILION_PORT_OBJ_002"] = "Bem-vindo ao FAST\nSHIP S.S.AQUA.\fVai embarcar\nhoje?",
  ["TEXT_VERMILION_PORT_OBJ_003"] = "tu viniste de\nJOHTO?\fDicen que muchos\nPOKéMON raros viven allí.",
  ["TEXT_VICTORY_ROAD_GATE_OBJ_001"] = "Sólo pasa el\nEntrenador que ya ha demostrado su valía.",
  ["TEXT_VICTORY_ROAD_GATE_OBJ_002"] = "Este camino lleva\na MT.SILVER.\fveras\nPOKéMON fuertes y aterradores allí.",
  ["TEXT_VICTORY_ROAD_GATE_OBJ_003"] = "yendo a\n¿LIGA POKEMON?\fÉLITE CUATRO son\ntan fuerte que da miedo, y son\nlisto para ti",
  ["TEXT_VIOLET_CITY_OBJ_001"] = "¡Hola!\n¿Eres entrenador?\fLucha con LÍDER,\nganarte?",
  ["TEXT_VIOLET_CITY_OBJ_002"] = "dicen que aparecen\nfantasmas en SPROUT TOWER.\fDijeron que los ataques\nLos normales no atrapan fantasmas.\nNada en absoluto.",
  ["TEXT_VIOLET_CITY_OBJ_003"] = "Oye tu eres\nEntrenador POKEMON Si vences al LÍDER\nde GYM aquí, estará listo\n¡de verdad!",
  ["TEXT_VIOLET_CITY_OBJ_004"] = "FALKNER, do\nGINÁSIO POKéMON\fde VIOLET, é um\nótimo treinador!\fEle herdou o\nginásio do pai\fe fez um belo\ntrabalho nele.",
  ["TEXT_VIOLET_CITY_OBJ_005"] = "Vi un árbol que\n¡adelante!\fSi tocas,\n¡Se retuerce y baila! ¡Legal!",
  ["TEXT_VIOLET_GYM_OBJ_001"] = "Soy FALKNER, líder\ndel GIMNASIO POKEMON DE VIOLET!\fdicen que puede\ncortarle las alas a los POKEMON voladores\ncon una descarga eléctrica… no permitiré\n¡Qué insulto a los pájaros POKéMON!\fte mostraré el\nverdadero poder de lo magnífico\n¡Pájaros POKEMON!",
  ["TEXT_VIOLET_GYM_OBJ_002"] = "el talento de\n¡FALKNER es real!\fno te sientas solo\n¡Porque me ganó!",
  ["TEXT_VIOLET_GYM_OBJ_002_AFTER"] = "el talento de\n¡FALKNER es real!\fno te sientas solo\n¡Porque me ganó!",
  ["TEXT_VIOLET_GYM_OBJ_002_BEATEN"] = "Aaah!",
  ["TEXT_VIOLET_GYM_OBJ_002_SEEN"] = "A palavra de\nordem é raça!\fO pessoal aqui\ntreina noite e\fdia para virar\nmestre de POKéMON\fvoador. Venha!",
  ["TEXT_VIOLET_GYM_OBJ_003"] = "Que vergonha,\nperder para um\vnovato…",
  ["TEXT_VIOLET_GYM_OBJ_003_AFTER"] = "Que vergonha,\nperder para um\vnovato…",
  ["TEXT_VIOLET_GYM_OBJ_003_BEATEN"] = "esto no puede\nsea verdad!",
  ["TEXT_VIOLET_GYM_OBJ_003_SEEN"] = "Déjame ver si\n¡eres lo suficientemente bueno!",
  ["TEXT_VIOLET_GYM_OBJ_004"] = "¡Ey! no lo soy\nentrenador, pero te doy un consejo!\f¡Créeme!\nSi crees, el sueño de ser\nsucede el campeón.\f¿Lo crees?\nAsí que escucha.\fEl tipo de planta es\ndébil contra el tipo volador. No\nolvídalo.",
  ["TEXT_VIOLET_KYLES_HOUSE_OBJ_001"] = "POKEMON cambió\ncrece rápido.\fPero sin el GYM\nINSIGNIA cierto, ellos pueden\ndesobedecerte.",
  ["TEXT_VIOLET_MART_OBJ_001"] = "cuando tomas\nun nuevo POKéMON, es débil.\fPero con el tiempo\nél se volverá fuerte.\f├ë importante\ntrata a los POKéMON con cariño.",
  ["TEXT_VIOLET_NICKNAME_SPEECH_HOUSE_OBJ_001"] = "Ela usa os nomes\ndas suas comidas\vpreferidas.\fNos apelidos\nque ela dá aos\vPOKéMON, digo.",
  ["TEXT_VIOLET_NICKNAME_SPEECH_HOUSE_OBJ_002"] = "Llamo a mi PIDGEY\npor FRESA!",
  ["TEXT_VIOLET_NICKNAME_SPEECH_HOUSE_OBJ_003"] = "STRAWBERRY:Pijji!",
  ["TEXT_VIOLET_POKECENTER1_F_OBJ_001"] = "{PLAYER}, ¿cuánto?\ntiempo.\fPROF.ELM preguntó\npara poder encontrarte.\fel tiene otro\npor favor pregunte.\f¿Tomarías el\n¿HUEVO POKEMON?",
  ["TEXT_VIOLET_POKECENTER1_F_OBJ_002"] = "Um cara chamado\nBILL fez o sistema\vde POKéMON do PC.",
  ["TEXT_VIOLET_POKECENTER1_F_OBJ_003"] = "Foi há mais ou\nmenos três anos.\fA TEAM ROCKET\nfazia maldades\vcom POKéMON.\fMas a justiça\nvenceu: um garoto\vacabou com eles.",
  ["TEXT_VIOLET_POKECENTER1_F_OBJ_004"] = "POKÉMON son\ninteligente.\fno obedecer\nun entrenador al que no respetan.\nSin las INSIGNIAS DE GIMNASIO adecuadas, simplemente\nactúan como quieren.",
  ["TEXT_VIOLET_POKECENTER1_F_OBJ_005"] = "{PLAYER}, ¿cuánto?\ntiempo.\fPROF.ELM preguntó\npara poder encontrarte.\fel tiene otro\npor favor pregunte.\f¿Tomarías el\n¿HUEVO POKEMON?",
  ["TEXT_VIRIDIAN_CITY_BG_006"] = "................. ¡Oye, muchacho! ya terminé\ntomar un café muy fuerte y estoy\n¡Conectado al 220!\fnecesito hablar\n¡Con alguien y servirás!\fPuede que no lo parezca,\npero yo era un experto en capturar\nPOKÉMON.\f¿Me crees?",
  ["TEXT_VIRIDIAN_CITY_OBJ_001"] = "¡Oye chico! ya terminé\ntomar un café muy fuerte y estoy\n¡Conectado al 220!\fnecesito hablar\n¡Con alguien y servirás!\fPuede que no lo parezca,\npero yo era un experto en capturar\nPOKÉMON.\f¿Me crees?",
  ["TEXT_VIRIDIAN_CITY_OBJ_002"] = "Este GIMNASIO no\nhabía un LÍDER hasta hace poco.\fun chico de\nPALLET se convirtió en LÍDER, pero vive\nfuera.",
  ["TEXT_VIRIDIAN_CITY_OBJ_003"] = "¡Bostezo!\fdebí haber dormido\nal sol.\f…tuve un sueño\ncon un DROWZEE comiéndose mi sueño.\nExtraño, ¿verdad?\f¿Hay?\n¿Qué es esto?\fDe donde vino\nesta MT?\f¡Qué siniestro!\nAquí puedes quedarte con este MT.",
  ["TEXT_VIRIDIAN_CITY_OBJ_004"] = "escuché que hay\nmuchos objetos en el suelo\nBOSQUE VIRIDIANO.",
  ["TEXT_VIRIDIAN_GYM_OBJ_001"] = "AZUL: ¡Oye! De todos modos\nLlegó aquí, ¿verdad?\fno estaba de humor\nen CINNABAR, pero ahora estoy\nlisto para ti.\f...me estas diciendo\n¿Quién le ganó a todo el JOHTO?\f¡Hay! Entonces el\nJOHTO GYMS debe ser débil.\fOye, no te preocupes\ncon esto.\flo sabré si\n¿eres bueno o no luchando con\nusted ahora.\f¿Listo, chico?",
  ["TEXT_VIRIDIAN_GYM_OBJ_002"] = "Hola futuro\n¡CAMPEÓN!\f¿Cómo te va?\nParece que estás empacado.\fEL LÍDER aquí es\nun tipo que peleo con el CAMPEON lo hace\ntres años.\fNo es suave.\fda todo lo que tu\n¡tienes!",
  ["TEXT_VIRIDIAN_MART_OBJ_001"] = "O LÍDER daqui\né totalmente\vsensacional.",
  ["TEXT_VIRIDIAN_NICKNAME_SPEECH_HOUSE_OBJ_001"] = "piensas mucho\nal nombrar el\n¿Tu POKEMON?\fBuenos apodos\ndejar el intercambio con otros\nmás divertido.",
  ["TEXT_VIRIDIAN_NICKNAME_SPEECH_HOUSE_OBJ_002"] = "São o SPEARY,\num SPEAROW, e o\vRATTEY, RATTATA.",
  ["TEXT_VIRIDIAN_POKECENTER1_F_OBJ_001"] = "Onde será que está\no LÍDER DE GINÁSIO\vde VIRIDIAN?\fEu queria\ndesafiar ele.",
  ["TEXT_VIRIDIAN_POKECENTER1_F_OBJ_002"] = "Onde será que está\no LÍDER DE GINÁSIO\vde VIRIDIAN?\fEu queria\ndesafiar ele.",
  ["TEXT_VIRIDIAN_POKECENTER1_F_OBJ_003"] = "Ouvi dizer que o\nGINÁSIO de\vCINNABAR sumiu.\fFico pensando no\nque foi feito do\vBLAINE, o LÍDER.",
  ["TEXT_WHIRL_ISLAND_B1_F_OBJ_006"] = "Cure Seus POKéMON!\nCENTRO POKéMON",
  ["TEXT_WILLS_ROOM_OBJ_001"] = "{PLAYER}, bienvenido\n├á LIGA POKéMON.\fdéjame\npresente. Soy VOLUNTAD.\fme entrené en\nmundo entero, dejando mi\npsíquicos fuertes.\fY finalmente fui\naceptado en ELITE CUATRO.\fsolo puedo quedarme\nmejorando!\fPerder no es un\nopción!",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_001"] = "Espantoso…\fSUICUNE, ENTEI e\nRAIKOU acordaram\vdo sono deles…\fSerá que a lenda\nestá se tornando\vrealidade?",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_002"] = "Entrenamos en\nTORRE QUEMADA, pero nunca escuchamos\nde un agujero que había allí antes. debe tener\nha sido hecho a propósito\npor alguien.",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_003"] = "Nós, o TRIO\nSÁBIO, somos os\fprotetores dos\nPOKéMON\vlendários.",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_004"] = "Oh, entonces eres tú\nquien dice que vio a SUICUNE, ENTEI y\nRAIKOU mientras dormían?\f¡Increíble!\fCuenta la leyenda que\nno se les puede ver durmiendo…",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_004_AFTER"] = "Oh, entonces eres tú\nquien dice que vio a SUICUNE, ENTEI y\nRAIKOU mientras dormían?\f¡Increíble!\fCuenta la leyenda que\nno se les puede ver durmiendo…",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_004_BEATEN"] = "Mais forte do\nque pensamos?\vTalvez…",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_004_SEEN"] = "Cuenta la leyenda que,\ncuando aparece un entrenador\ncapaz de tocar las almas de\nPOKéMON, un POKéMON parece detenerse\nEste autocar será probado en TIN\nTORRE.\fLa leyenda es\nse hizo realidad!\fel legendario\n¡Llegó POKEMON SUICUNE!\fNosotros, el TRÍO\nWISE, ¡probemos si mereces participar!",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_005"] = "En el pasado, hubo\nAquí hay dos torres de nueve pisos.\fLA TORRE DE BRONCE,\n¿Quién dice que se despertó?\nPOKéMON y TIN TOWER, donde POKéMON\ndescansaron.\fLa vista desde arriba\nde las TORRES debe haber sido\nmagnífico.\fEn ese momento, un\nPOKéMON plateado enorme dicen\nque construyó un nido en lo alto del\nTORRE DE LATÓN.\fSin embargo… Hay alrededor de 150\naños, un rayo cayó sobre\nde TORRES.\fella fue tomada\npor llamas que duraron tres días.\funa lluvia\nDe repente el fuego se apagó.\fY así es como\nNació la TORRE QUEMADA.",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_005_AFTER"] = "En el pasado, hubo\nAquí hay dos torres de nueve pisos.\fLA TORRE DE BRONCE,\n¿Quién dice que se despertó?\nPOKéMON y TIN TOWER, donde POKéMON\ndescansaron.\fLa vista desde arriba\nde las TORRES debe haber sido\nmagnífico.\fEn ese momento, un\nPOKéMON plateado enorme dicen\nque construyó un nido en lo alto del\nTORRE DE LATÓN.\fSin embargo… Hay alrededor de 150\naños, un rayo cayó sobre\nde TORRES.\fella fue tomada\npor llamas que duraron tres días.\funa lluvia\nDe repente el fuego se apagó.\fY así es como\nNació la TORRE QUEMADA.",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_005_BEATEN"] = "…Vou te contar\na verdade…",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_005_SEEN"] = "se puede confiar\ncon la verdad?\fnecesito confirmar\nsu mérito.",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_006"] = "Forte demais!\nPor quê?",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_006_AFTER"] = "Tú… ├ë o\nentrenador que POKéMON\n¿Los legendarios te esperan?",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_006_BEATEN"] = "Forte demais!\nPor quê?",
  ["TEXT_WISE_TRIOS_ROOM_OBJ_006_SEEN"] = "Deixe-me ver\nseu poder!",
  ["TVText"] = "Es una TV.",
  ["TakeChikoritaText"] = "ELM: ¿Quieres a\nCHIKORITA, el POKéMON\vplanta?",
  ["TakeCyndaquilText"] = "ELM: ¿Quieres a\nCYNDAQUIL, el POKéMON\vde fuego?",
  ["TakeTotodileText"] = "ELM: ¿Quieres a\nTOTODILE, el POKéMON\vde agua?",
  ["TeacherColetteAfterBattleText"] = "Antes de ser maestra,\nsolía olvidarme\fde muchas\ncosas.",
  ["TeacherHillaryAfterBattleText"] = "Es importante estudiar,\npero hacer deporte\vtambién.",
  ["TeacherHillaryBeatenText"] = "No quería\nperder…",
  ["TeacherHillarySeenText"] = "Creo que si hace\nsol, los niños\fdeberían estar\njugando en el\vpatio en lugar\fde estar en\nclase.",
  ["TeacherShirleyAfterBattleText"] = "Vamos de excursión\na las RUINAS de\vlas afueras de\vCIUDAD MALVA.",
  ["TeacherShirleySeenText"] = "¡No toques a\nmis alumnos!",
  ["TeacherText_CrunchCrunch"] = "¡Ñam, ñam!",
  ["TeacherText_KeepEating"] = "¡Ñam, ñam! ¡Sigo\fcomiendo!",
  ["TeacherText_MoreChef"] = "¡Más, JEFE!",
  ["TeacherText_NoCoinCase"] = "Aquí nadie te va\na dar un MONEDERO.\fMejor que lo busques\nen JOHTO.",
  ["TeamRocketBaseB1FSecretSwitchText"] = "¡Un botón secreto!\nMejor pulsarlo.",
  ["TeamRocketBaseB1FSecurityCameraText"] = "Es una estatua de\nPERSIAN… Sus ojos\ftienen un brillo\nextraño.",
  ["TeamRocketBaseB1FSwitchOffText"] = "El interruptor\nestá apagado.",
  ["TeamRocketBaseB3FLockedDoorNeedsPasswordText"] = "La puerta está cerrada…\fNecesitas dos\ncontraseñas.",
  ["TeamRocketBaseB3FLockedDoorOpenSesameText"] = "La puerta está cerrada…\f{PLAYER} introdujo\ndos contraseñas.\f¡Puerta abierta!",
  ["TeamRocketBaseB3FRocketText"] = "¡Urrgg…! El chico\nde la capa es\vmuy fuerte…",
  ["TeamRocketOathText"] = "VOTOS TEAM ROCKET\fRobar POKéMON para\nenriquecernos. Explotarlos\fpara enriquecernos.\n¡Todo POKéMON\fexiste para\ngloria del TEAM\vROCKET!",
  ["TeleportGuyNoText"] = "Vale, vale. ¡Que\ntengas suerte!",
  ["TeleportGuyText1"] = "¿Qué? ¿Vas a desafiar\nal ALTO MANDO?\f¿Seguro que quieres\nhacerlo? Si necesitas\fentrenarte más,\nmi ABRA te puede\fayudar. ABRA\nte puede TELETRANSPORTAR.\f¿Te gustaría\nvolver\fa casa?\n",
  ["TeleportGuyYesText"] = "Vale. Concéntrate\nen la imagen\vde tu casa…",
  ["Text_BattleReceptionistIntro"] = "Éste es el COLISEO\ndel CLUB DEL CABLE.\fPuedes luchar con\nun/a amigo/a aquí.\f¿Quieres luchar\nahora?",
  ["Text_BattleRoomClosed"] = "Lo siento. Estamos\najustando la MÁQUINA\vDE LUCHA.",
  ["Text_CallMomOnGear"] = "Llama a tu madre\ncon el POKéGEAR\fy cuéntale cómo\nte va.",
  ["Text_CantLinkToThePast"] = "Aquí no puedes conectarte\ncon el pasado.",
  ["Text_CharcoalMasterIntro"] = "¡Ah! ¡Mi FARFETCH'D!\f¿Lo encontraste\npara nosotros?\fSin su ayuda, no\npodríamos CORTAR\fárboles para hacer\ncarbón vegetal.\f¡Gracias! ¿Cómo\fpodría agradecértelo…?\n¡Ya sé!\fCoge esto.\n",
  ["Text_CharcoalMasterOutro"] = "Es la MO CORTE.\n¡Enséñasela a un\fPOKéMON para cortar\narbustos! Pero\fnecesitarás la\nMEDALLA del GIMNASIO\fAZALEA para\nusarla.",
  ["Text_CharcoalMasterTalkAfter"] = "¿Quieres que te\nenseñe a trabajar\fcon el carbón?\n¡En diez años\fserás imparable!\n",
  ["Text_ClairIsBeaten"] = "¿Has vencido a\nDÉBORA? ¡Impresionante!\vNunca oí que\fperdiera contra\nnadie, excepto\fcontra\nLANCE.",
  ["Text_ClairIsIn"] = "DÉBORA, la LÍDER\ndel GIMNASIO, te\fespera. Aunque,\na alguien como\ftú le será imposible\nganar.",
  ["Text_ClairIsOut"] = "Lo siento. DÉBORA, la\fLÍDER del GIMNASIO,\nestá en la GUARIDA DRAGÓN,\vdetrás del GIMNASIO.\fNo tengo ni idea\nde cuándo volverá\vnuestra LÍDER.",
  ["Text_EarlAsksIfYouBeatFalkner"] = "¡Hola! ¿Entrenas\nPOKéMON? ¿Has ganado\fal LÍDER del\nGIMNASIO?",
  ["Text_ElmDiscoveredNewMon"] = "¡Hola, {PLAYER}! Dicen\fque el PROF. ELM\nha descubierto nuevos\vPOKéMON.",
  ["Text_FollowEarl"] = "¿Es verdad? ¡Pues\ntú estudiarás!\v¡Sígueme!",
  ["Text_GearIsImpressive"] = "¡Uau! ¡Tu POKéGEAR\nes impresionante!\f¿Te la ha dado\ntu madre?",
  ["Text_GrampsLookingForYou"] = "El abuelo te estaba\nbuscando.",
  ["Text_HeadbuttIntro"] = "¿Que qué hago? Agitar\flos árboles con GOLPE\nCABEZA. Es muy\fdivertido. ¡Toma,\npruébalo!",
  ["Text_HeadbuttOutro"] = "Agita los árboles\ncon GOLPE CABEZA.\vA veces caen POKéMON\vdormidos.",
  ["Text_HereTeacherIAm"] = "El profesor soy yo.\n¡Bien está que\vaquí estudies!",
  ["Text_IlexForestShrine"] = "SANTUARIO del\nENCINAR… Construido\fen honor del\nguardián del\vbosque…",
  ["Text_IncompatibleRooms"] = "Tu amigo/a eligió una\nsala distinta.",
  ["Text_ItsDangerousToGoAlone"] = "es peligroso salir\n¡peca un POKEMON!\vDe camino a la siguiente ciudad\nencontrarás POKéMON guardados.",
  ["Text_ItsTheMissingPokemon"] = "¡Es el POKéMON\nperdido!",
  ["Text_Kwaaaa"] = "FARFETCH'D: ¡Farf!",
  ["Text_LinkTimedOut"] = "La conexión se ha\ninterrumpido por\vinactividad. Habla\fcon tu amigo/a\ny vuelve cuando\vquieras.",
  ["Text_MillionDollarSlowpokeTail"] = "¿Te gustaría tener\nesta sabrosa y\fnutritiva COLASLOWPOKE?\n¡Sólo te costará\f1.000.000¥!\n¡Te gustará!\f",
  ["Text_MustSaveGame"] = "Antes de conectar\nlas consolas, guarda\vel juego.",
  ["Text_MysteryGiftDeliveryGuy_HereYouGo"] = "¡Aquí tienes!",
  ["Text_MysteryGiftDeliveryGuy_Intro"] = "¡Hola! Tú eres {PLAYER},\n¿no? ¿Quieres recoger\flo que tengo\npara ti?",
  ["Text_MysteryGiftDeliveryGuy_NoRoom"] = "¡Oh! No tienes espacio\npara esto. Para\fen cualquier CENTRO\nPOKéMON del país\fy podrás recogerlo.\n",
  ["Text_MysteryGiftDeliveryGuy_Outro"] = "Esperamos poder ayudarte\nde nuevo.",
  ["Text_MysteryGiftDeliveryGuy_SaidNo"] = "¿No? Es muy\nextraño…",
  ["Text_NoRoomForDragonFang"] = "Pero {PLAYER}\nno puede llevar\vmás cosas.",
  ["Text_PleaseComeIn"] = "Entra, por favor.",
  ["Text_PleaseComeInDuplicate"] = "Pode entrar.",
  ["Text_PleaseWait"] = "Espera, por favor.",
  ["Text_ReceivedEarthBadge"] = "{PLAYER} recibió la\nMEDALLA TIERRA.",
  ["Text_ReceivedFogBadge"] = "{PLAYER} recibió la\nMEDALLA NIEBLA.",
  ["Text_ReceivedGlacierBadge"] = "{PLAYER} recibió la\nMEDALLA GLACIAR.",
  ["Text_ReceivedHiveBadge"] = "{PLAYER} recibió la\nMEDALLA COLMENA.",
  ["Text_ReceivedMineralBadge"] = "{PLAYER} recibió la\nMEDALLA MINERAL.",
  ["Text_ReceivedSoulBadge"] = "{PLAYER} recibió\nla MEDALLA ALMA.",
  ["Text_RefusedToBuySlowpokeTail"] = "¿No la quieres?\nPues lárgate.",
  ["Text_RoarIntro"] = "¡GRRRRRR! ¡TODOS\nHUYEN CUANDO RUJO!\f¡PERO TÚ HAS\nVENIDO! ¡ESO\fME GUSTA! ¡TOMA\nESTO!",
  ["Text_RoarOutro"] = "¡GRRRRRR! ¡ES RUGIDO!\nHASTA LOS POKéMON\fHUYEN CON UN\nRUGIDO.",
  ["Text_Route31CantTakeLastMon"] = "Si te quito ese\nPOKéMON, ¿qué\fvas a usar en\nlos combates?",
  ["Text_Route31DeclinedToHandOverMail"] = "¿Qué? ¿No quieres\nnada?",
  ["Text_Route31DescribeNightmare"] = "MT50 es PESADILLA.\fEs un movimiento\nterrible que reduce\flos PS de un rival\ndormido. ¡Ooooh…!\f¡Qué miedo…!\nNo me gustan\flas pesadillas.\n",
  ["Text_Route31HandOverMailMon"] = "{PLAYER} entregó\nel POKéMON que lleva\vla CARTA.",
  ["Text_Route31MissingMail"] = "¿Por qué es espe-\ncial este POKéMON?\fNo tiene ninguna\nCARTA.",
  ["Text_Route31ReadingMail"] = "Veamos… La C.\fOSCURA lleva\na otro camino.\fEs bueno saberlo.\nGracias por traerme\festo. Mi amigo\nes un buen chico.\f¡Tú también\neres increíble!\v¡Me gustaría\fdevolverte\nel favor!\v¡Ya sé!\f¡Toma\nesto!",
  ["Text_Route31SleepyMan"] = "¡Arg…! ¿Eh? Hoy\fhe caminado mucho\nbuscando POKéMON.\vMe duelen los\fpies y tengo sueño…\nSi fuera un\fPOKéMON salvaje,\nsería fácil\vatraparme…\f¡Zzzz…!",
  ["Text_Route31SleepyManGotMail"] = "Zzzz… ¿Eh? ¿Qué\fes eso? ¿Una CARTA\npara mí?",
  ["Text_Route31WrongMail"] = "Esta CARTA no\nes para mí.",
  ["Text_TellMomIfLeaving"] = "¡Hola, {PLAYER}!\n¿Te vas otra vez?\fDeberías avisar\na tu madre de\vque te vas.",
  ["Text_ThisIsABigBattle"] = "¿Qué? ¡Es un gran\ncombate! ¡Déjame\ven paz!",
  ["Text_ThoughtKidsWereLoaded"] = "¡Vaya! Pensaba que los\nniños de hoy en día\vestaban forrados…",
  ["Text_TimeCapsuleClosed"] = "Lo siento. Estamos\narreglando la CÁPSULA\vDEL TIEMPO.",
  ["Text_TimeCapsuleReceptionistIntro"] = "Ésta es la CÁPSULA\nDEL TIEMPO del CLUB\fDEL CABLE. Puedes\nviajar al pasado y\vcambiar tu POKéMON.\f¿Quieres viajar\nen el tiempo?",
  ["Text_TradeReceptionistIntro"] = "Éste es el CENTRO\nDE CAMBIO del CLUB\fDEL CABLE. Puedes\ncambiar un POKéMON\vaquí con un/a amigo/a.\f¿Quieres intercambiar?\n",
  ["Text_TradeRoomClosed"] = "Lo siento. Estamos\najustando la MÁQUINA\vDE CAMBIO.",
  ["Text_UseTackle"] = "¡Ve, RATTATA!\f¡PLACAJE!",
  ["Text_VeryNiceIndeed"] = "¡Oh, la, la!\n¡Muy bien!",
  ["Text_WaitPlayer"] = "¡Espera, {PLAYER}!",
  ["Text_WhatDoYouThinkYoureDoing"] = "¿Qué crees que estás\nhaciendo?",
  ["Text_YourMonIsAdorable"] = "¡Oh, tu POKéMON es\nadorable! ¡Ojalá\vtuviera yo uno!",
  ["TimeCapsuleFriendScript.FriendReadyText"] = "O seu amigo\nestá pronto.",
  ["TinTower1FEusineHoOhText"] = "Lo sabía.\fte conocí\nIba a ver los POKéMON codificados por colores.\narcoíris, {PLAYER}.\ffue exactamente\ncomo predije.\fpuedo decir eso\nMi investigación no es mala.\fvoy a continuar\nestudiando POKéMON para convertirse en uno\n¡Famoso POKéMANÍACO!",
  ["TinTower1FEusineSuicuneText"] = "EUSINA: ¡Increíble!\n¡Incluso demasiado!\fnunca he visto uno\nque buena batalla.\fEso fue\nrealmente inspirador.\fSUICUNE fue duro,\npero fuiste aún más sorprendente,\n {PLAYER}.\fEscuché que el poder\nSUICUNE místico invoca un POKéMON\ncolor del arco iris.\fTal vez, sólo tal vez,\n¿Qué pasó hoy? Haz esto.\nAparece POKéMON.\festudiaré más\nlas leyendas.\fgracias por mi\nmuestra esta increíble batalla.\fHasta luego,\n {PLAYER} !",
  ["TinTower1FSage1Text"] = "De acuerdo con la leyenda…\nCuando las almas de\flos POKéMON y los\nhumanos se unan, descenderá\fde los cielos un\nPOKéMON con los\fcolores del arco\niris… ¿Quiere eso\fdecir que el POKéMON\nlegendario está\vprobando a los\vhumanos?",
  ["TinTower1FSage2Text"] = "Se dice que, cuando\nla TORRE LATÓN se Quemó, tres\nPOKéMON perecieron anónimos. Fue\nuna tragedia.\fSin embargo… Un POKéMON con ellos\ncolores del arco iris... y más\npalabras… HO-OH descendió de\nel cielo y les devolvió la vida\ntres POKÉMON.\fHijo… SUICUNE, ENTEI y RAIKOU.\neso es lo que\ndecir...",
  ["TinTower1FSage3Text"] = "Se dice que las\ndos TORRES fueron\fconstruidas para\nfomentar la amistad\fentre los POKéMON\ny la gente. Eso\vocurrió hace\f700 años, pero\nla idea se\fmantiene\nintacta.",
  ["TinTower1FSage4Text1"] = "¡Parece que HO-OH\nse ha posado\fsobre la TORRE\nHOJALATA!",
  ["TinTower1FSage4Text2"] = "Se dice que los\nPOKéMON legenda-\frios encarnan tres\npoderes… El rayo\fque alcanzó la\nTORRE… El fuego\fque quemó la TORRE…\nY la lluvia\fque apagó dicho\nfuego…",
  ["TinTower1FSage5Text1"] = "Esto te protegerá.\nCógelo.",
  ["TinTower1FSage5Text2"] = "En marcha.",
  ["TinTower1FSage5Text3"] = "cuando aparecieron\nel POKéMON legendario… Infundió terror en aquellos\nque llegó su ascensión. Y… Algunos incluso atacaron en vano. Los\nPOKÉMON LEGENDARIOS, conocedores de su\npropio poder, huyeron y abandonaron al pueblo, asustados.",
  ["TinTower1FSage6Text1"] = "Creo que te están\nprobando. Libera\vtu mente de\fla incertidumbre\ny avanza.\v",
  ["TinTower1FSage6Text2"] = "De los POKéMON legendarios,\nse dice que SUICUNE\fes el más cercano\na HO-OH. Además,\fhe oído que también\npuede haber una\fconexión con los\nPOKéMON UNOWN. Los\fPOKéMON UNOWN deben\nde tener un lazo\fde unión con\nSUICUNE.",
  ["TinTowerSignText"] = "TORRE HOJALATA\fAquí duerme\nun POKéMON legendario.\v",
  ["TohjoFallsSignText"] = "CATARATAS TOHJO\fLa conexión entre\nKANTO y JOHTO",
  ["TradeCenterFriendReadyText"] = "O seu amigo\nestá pronto.",
  ["TrainerGruntM1WhenTalkText"] = "Sí, el TEAM ROCKET\nse separó hace tres\vaños. Pero seguimos\fclandestinamente\ncon nuestras actividades.\v¡Diviértete\fahora con\nnuestras fechorías!\v",
  ["TrainerHouse1FCooltrainerFText"] = "Aquí abajo tienen\nlugar combates de\ventrenamiento. Me\fencantaría ver lo\nbien que luchan\flos entrenadores\nde JOHTO.",
  ["TrainerHouse1FCooltrainerMText"] = "La CIUDAD VERDE es\nla más cercana a\vla MESETA AÑIL. Construyeron\feste lugar debido\nal gran número\fde entrenadores\nque pasaban de\fcamino a la MESETA\nAÑIL.",
  ["TrainerHouse1FGentlemanText"] = "¡Ah…! Estoy descansando\nde los combates\vPOKéMON.",
  ["TrainerHouse1FReceptionistText"] = "Bienvenidos a la\nCASA DEL ENTRENADOR,\fel lugar más popular\nde CIUDAD VERDE.\fEs sólo para entrenadores.\nPuedes luchar\fcontra los mejores\nentrenadores\fen el piso\nde abajo.",
  ["TrainerHouse1FYoungsterText"] = "No podrás ganar\nel CAMPEONATO si\fno luchas con toda\nla gente que encuen-\ftres por ahí.\nEl CAMPEÓN de\fPALETA viajó\npor las ciudades\fy pueblos\nde KANTO.",
  ["TrainerHouseB1FAskWantToBattleText"] = "¿Quieres\nluchar?",
  ["TrainerHouseB1FCalBeatenText"] = "He perdido…\n¡Qué pena…!",
  ["TrainerHouseB1FCalBeforeText"] = "He viajado hasta\naquí sólo para luchar\vcontra ti.",
  ["TrainerHouseB1FGoRightInText"] = "Entra, por favor.\nPuedes empezar\fahora mismo.\n",
  ["TrainerHouseB1FIntroText"] = "Bienvenidos al HALL\nDE ENTRENAMIENTO.\fPuedes luchar\ncon un entrenador\vcada día.",
  ["TrainerHouseB1FPleaseComeAgainText"] = "Lo siento. Sólo\npueden entrar\faquellos que van\na luchar.",
  ["TrainerHouseB1FSecondChallengeDeniedText"] = "Lo siento, joven.\nÉsta es la segunda\fvez que viene\nhoy. Sólo se puede\fentrar una vez\nal día.",
  ["TrainerHouseB1FYourOpponentIsText"] = "será hoy tu\nrival.",
  ["TrainerHouseIllegibleText"] = "¿Qué es esto? ¿Una\nestrategia? Esta\fletra se parece\na las huellas\fde ONIX… ¡Es\nilegible…!",
  ["TrainerHouseSign1Text"] = "Los combates de entrenamiento\nse celebran en\fHALL DE ENTRENAMIENTO.\nLos entrenadores\fmás hábiles\nestán invitados.\v",
  ["TrainerHouseSign2Text"] = "No existen reglas\nsobre los combates\fde prueba. Al igual\nque en los combates\freales, aquí\nvale todo.",
  ["TrainerHouseSignText"] = "CASA DEL ENTRENADOR\fClub de Mejores\nEntrenadores",
  ["TrashCanText"] = "Aquí dentro no hay nada… Un POKéMON podría\nmoverla. Un POKéMON podría romperla.",
  ["TuscanyGaveGiftText"] = "MARTA: ¿No crees\nque es adorable?\vFortalece los movimientos\fde tipo normal.\nSeguro que\fte será muy\nútil.",
  ["TuscanyGivesGiftText"] = "Como presentación,\npor favor, toma\feste regalo: un\nLAZO ROSA.",
  ["TuscanyNotTuesdayText"] = "MARTA: Hoy no\nes martes. ¡Qué\vpena…!",
  ["TuscanyTuesdayText"] = "MARTA: ¿Has visto\na LUNA, mi hermana\vmayor? ¿O a mi\fhermano pequeño,\nMIGUEL? Soy la\fsegunda de siete\nhermanos.",
  ["TwinsAmyandmay1AfterBattleText"] = "AMY: ¡Eres muy\nfuerte!",
  ["TwinsAmyandmay1BeatenText"] = "AMY-MAY: ¡Oh,\nmadre mía!",
  ["TwinsAmyandmay1SeenText"] = "AMY: ¡Hola! ¿Estás\nretando al LÍDER?\v¡No puede ser!",
  ["TwinsAmyandmay2AfterBattleText"] = "MAY: Han perdido\nnuestros POKéMON.\v¡Qué lástima!",
  ["TwinsAmyandmay2BeatenText"] = "AMY-MAY: ¡Oh,\nmadre mía!",
  ["TwinsAmyandmay2SeenText"] = "MAY: ¿Quieres ver\nal LÍDER? ¡Antes\vvamos nosotras!",
  ["TwinsAnnandanne1AfterBattleText"] = "ANA: Sé lo que\nestán pensando\fmi hermana y\nmis POKéMON.",
  ["TwinsAnnandanne1BeatenText"] = "ANA-ANY: Nnn… Demasiado\nfuerte.",
  ["TwinsAnnandanne2AfterBattleText"] = "ANY: Sentimos lo\nmismo que nuestros\vPOKéMON.",
  ["TwinsAnnandanne2BeatenText"] = "ANA-ANY: Nnn… Demasiado\nfuerte.",
  ["TwinsAnnandanne2SeenText"] = "ANY: ¡ANA y yo\nestamos en esto\vjuntas!",
  ["TwinsJoAndZoe1AfterBattleText"] = "¡ERIKA te lo\nhará pagar!",
  ["TwinsJoAndZoe1SeenText"] = "¡Te enseñaremos los movimientos\nPOKéMON que nos\venseñó ERIKA!",
  ["TwinsJoAndZoe2AfterBattleText"] = "¡ERIKA es mucho, mucho\nmás fuerte!",
  ["TwinsJoAndZoe2BeatenText"] = "No podíamos ganar…",
  ["TwinsJoAndZoe2SeenText"] = "¡Vamos a proteger\na ERIKA!",
  ["TwinsMegandpeg1AfterBattleText"] = "¡No deberías llamar\nnenas a las\vchicas!",
  ["TwinsMegandpeg1SeenText"] = "¿Crees que soy\nuna nena? ¡No\ves justo!",
  ["TwinsMegandpeg2AfterBattleText"] = "A veces, los niños\nson más listos que\vlos adultos.",
  ["TwinsMegandpeg2SeenText"] = "¡No soy una nena! ¡Y\fno deberías llamar\nasí a una dama!",
  ["UndergroundRivalAfterText"] = "…No entiendo… ├ë es verdad lo que\n¿LANCE dijo?\fque no trato bien\n¿EL POKEMON?\fAmor… Confianza… Son exactamente lo que me hace\ndesaparecido?\f¿Lo haré?\nprevenir?\fYo... simplemente no lo hago\nLo entiendo.\fPero no lo hará\ntermina aquí.\fAhora no. no para\nesto.\fno me rendiré\nel sueño de ser el mejor\n¡Maestro POKÉMON!",
  ["UndergroundRivalBeforeText"] = "¡Espera un minuto!\fte vi entonces\nTe seguí.\fno necesito\nTe interpones en el camino mientras yo cuido\ndel EQUIPO ROCKET.\f…Espera un minuto.\nMe ganaste antes, ¿no?\fEso fue\nsolo suerte.\fpero pago\nmis deudas!",
  ["UndergroundRivalLossText"] = "Mmm. Este es el\nmi verdadero poder.\fterminaré\nal EQUIPO ROCKET.\fy lo haré\naplastar la LANZA bajo mis pies.",
  ["UndergroundRivalWinText"] = "…Por qué…\n¿Por qué pierdo?\fReuní los POKéMON\nmás fuerte.\fno alivió\nen ritmo.\f¿Por qué pierdo?",
  ["UnusedBugCatchingContestExplanationText"] = "El concurso de captura\nde Bichos es los martes, jueves y sábados.\nSólo ganarás un premio por participar,\nCampana con la que también caerás\nla criatura POKéMON que tienes cuando\nterminar.",
  ["UseSquirtbottleText"] = "Un árbol extraño. ¿Usas\nla REGADERA?",
  ["UsedSquirtbottleText"] = "{PLAYER} usó\nla REGADERA.",
  ["VermilionCityBadgeGuyAllBadgesText"] = "¡Enhorabuena! Tienes\ftodas las MEDALLAS\nde KANTO. Te recompensaré\fpor tu esfuerzo.\n",
  ["VermilionCityBadgeGuyBattleEdgeText"] = "Llevar distintos\ntipos de POKéMON\fte debería ayudar\nen el combate. Seguro\fque las MEDALLAS\nde KANTO te\vayudarán.",
  ["VermilionCityBadgeGuyMostBadgesText"] = "Supongo que pronto\nhabrás conseguido\ftodas las MEDALLAS\nde KANTO. Cuando\ftengas las ocho\nMEDALLAS,\vdímelo.",
  ["VermilionCityBadgeGuySomeBadgesText"] = "¿Has conseguido ya\nalguna MEDALLA de\vGIMNASIO de KANTO?\f¿A que los entrenadores\nde KANTO son\vmuy fuertes?",
  ["VermilionCityBadgeGuyTrainerText"] = "Los entrenadores expertos\nse reúnen en KANTO.\fLos LÍDERES de GIMNASIO\nson muy fuertes.\fNo serán fáciles\nde vencer.",
  ["VermilionCityDiglettsCaveSignText"] = "CUEVA DIGLETT",
  ["VermilionCityPortSignText"] = "ENTRADA AL PUERTO\nCARMÍN",
  ["VermilionCityRadioNearSnorlaxText"] = "El POKéGEAR está\ncerca del SNORLAX\vdormido. …\f¡SNORLAX se\fdespertó!",
  ["VermilionCitySignText"] = "CIUDAD CARMÍN\nEl puerto de\flos ocasos\nexquisitos",
  ["VermilionCitySnorlaxSleepingText"] = "SNORLAX duerme\nplácidamente…",
  ["VermilionCitySuperNerdText"] = "En KANTO hay ocho\nGIMNASIOS. Ese gran\fedificio es el GIMNASIO\nPOKéMON de CIUDAD\vCARMÍN.",
  ["VermilionCityTeacherText"] = "CIUDAD CARMÍN es el\npuerto más importante\vde KANTO. En él atracan\flujosos transatlánticos\nde todo el\vmundo.",
  ["VermilionDiglettsCaveSpeechHouseGentlemanText"] = "Durante años, DIGLETT\nha estado excavando\vun gran túnel. El\ftúnel lleva a una\nciudad lejana.",
  ["VermilionGymGuideText"] = "¡Ey! Futuro\n¡CAMPEÓN!\ftuviste suerte\nesta vez.\fLT.SURGE es muy\ncauteloso.\fhay trampas\ntodo el GIMNASIO.\fPero, je, je, el\nlas trampas no están activadas.\fno tendrás\nproblema para llegar a él.",
  ["VermilionGymGuideWinText"] = "Ufa! Que combate\neletrizante!\fMe deixou mesmo\nnervoso.",
  ["VermilionGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE\vCIUDAD CARMÍN:\vLT. SURGE\fEl rayo americano\n",
  ["VermilionGymTrashCanText"] = "¡Bah! Aquí sólo\nhay basura.",
  ["VermilionMachopOwnerText"] = "Mi POKéMON está\npreparando el\vterreno donde\vedificar. Pero\fno tengo dinero\npara el proyecto…\v",
  ["VermilionMachopText2"] = "Un MACHOP gruñe\nmientras\vpisotea el\vsuelo.",
  ["VermilionMagnetTrainSpeechHousePokefanFText"] = "¿Has oído hablar\ndel MAGNETOTRÉN?\fEs un tren que va\nhasta CIUDAD TRIGAL,\ven JOHTO.",
  ["VermilionMagnetTrainSpeechHouseYoungsterText"] = "Quiero ir a CIUDAD\nAZAFRÁN para ver\vel MAGNETOTRÉN.",
  ["VermilionMartBeautyText"] = "Estou pensando em\nfazer compras em\vSAFFRON.",
  ["VermilionMartSuperNerdText"] = "El TEAM ROCKET ya\nno está en KANTO.\fEso es lo que me hace\nse siente mejor.",
  ["VermilionPokecenter1FBugCatcherText"] = "Tienes algunas MEDALLAS\nque no había visto\vnunca. ¡Claro!\fLas has ganado\nen JOHTO.",
  ["VermilionPokecenter1FFishingGuruText"] = "Hay un POKéMON dormido\ndelante de la CUEVA\vDIGLETT. ¡El momento\fideal para atraparlo!\n¿Pero cómo\flo despertaremos?\n",
  ["VermilionPokecenter1FFishingGuruText_FoughtSnorlax"] = "Antes había un POKéMON\ndurmiendo delante\fde la CUEVA de\nDIGLETT. Pero\fparece que ha\ndesaparecido.",
  ["VermilionPokecenter1FSailorText"] = "El FERRY es un buen\nlugar para luchar\fy conocer entrenadores.\n",
  ["VermilionPortAskBoardingText"] = "Éste es el FERRY\nS.S. AQUA.\f¿Vas a embarcar\nhoy?",
  ["VermilionPortAskTicketText"] = "¿Puedo ver tu\nTICKET BARCO?",
  ["VermilionPortCantBoardText"] = "Lo siento. No puedes\nembarcar.",
  ["VermilionPortComeAgainText"] = "¡Esperamos volver\na verte!",
  ["VermilionPortDepartingText"] = "El barco va a zarpar.\nPor favor, sube\va bordo.",
  ["VermilionPortNoTicketText"] = "{PLAYER} intenta\nenseñar el TICKET\vBARCO… ¡Pero no\flo tiene! ¡Lo\fsiento! Sólo puedes\nsubir si tienes\fun TICKET\nBARCO.",
  ["VermilionPortPassageTeacherText"] = "El FERRY sale\nsiempre los miércoles\vy los domingos.\v",
  ["VermilionPortSSTicketText"] = "{PLAYER} enseña\nel TICKET BARCO.\fMuy bien. ¡Gracias,\njoven!",
  ["VermilionPortSailSundayText"] = "El FERRY zarpará\nel domingo.",
  ["VermilionPortSailWednesdayText"] = "O FAST SHIP zarpa\nna quarta-feira.",
  ["VermilionPortSuperNerdText"] = "¿Vienes de JOHTO?\nDicen que allí\fviven muchos\nPOKéMON\vraros.",
  ["VictoryRoadEntranceSignText"] = "LIGA POKéMON\fENTRADA A CALLE\nVICTORIA",
  ["VictoryRoadGateEightBadgesText"] = "¡Oh! ¡Las ocho MEDALLAS\nde JOHTO! ¡Le\fruego que pase,\npor favor!",
  ["VictoryRoadGateLeftBlackBeltText"] = "Este camino lleva\na MT. PLATEADO.\fAllí verás a unos\nPOKéMON fuertes\vy terribles.",
  ["VictoryRoadGateNotEnoughBadgesText"] = "No tienes todas\nlas MEDALLAS\vde JOHTO. Lo\fsiento, pero\nno puedo dejarte\vpasar.",
  ["VictoryRoadGateOfficerText"] = "Sólo pueden pasar los\nentrenadores que demuestren\vsu valía.",
  ["VictoryRoadGateRightBlackBeltText"] = "Vas a la LIGA POKéMON,\n¿verdad? El ALTO\fMANDO es tan fuerte\nque da miedo.\f¡Están esperándote!\n",
  ["VictoryRoadRivalAfterText"] = "Sigo queriendo\nser el mejor entrenador…\vDescubriré por\fqué no puedo\nganar y ser más\ffuerte… Te desafiaré\nen cuanto lo\fsepa. Y te\naplastaré con\ftodo mi poder.\nHasta entonces,\v¡sigue\fentrenando!\n",
  ["VictoryRoadRivalBeforeText"] = "Espera. ¿Vas a\fparticipar en\nla LIGA POKéMON?\vNo me hagas reír.\fEres mucho más\ndébil que yo,\fporque ya no soy\nel mismo de antes.\f¡Ahora tengo\nlos mejores\fPOKéMON y los\nmás fuertes!\f¡Soy invencible!\n¡{PLAYER}!\f¡Yo te desafío!\n",
  ["VictoryRoadRivalDefeatText"] = "He perdido… Hice\ftodo lo que pude…\nLo que tú tienes\fy yo no tengo…\nEmpiezo a entender\flo que me dijo\naquel maestro\fde dragones…\n",
  ["VictoryRoadRivalVictoryText"] = "¡Bah! Después\fde todo, no hay\nnada mejor que\vel poder. No\fnecesito nada\nmás.",
  ["VioletCityElmsAideFullPartyText"] = "¡Oh, no! No puedes\nllevar más POKéMON.\vEsperaré aquí\fa que le hagas\nsitio al\vHUEVO.",
  ["VioletCityGrampsText"] = "¡PEGASO, del GIMNASIO\nPOKéMON de CIUDAD\fMALVA, es magnífico!\nHeredó el gimnasio\fde su padre\ny ha hecho\fun gran trabajo.\n",
  ["VioletCityLassText"] = "Dicen que en la\nTORRE BELLSPROUT\vhay fantasmas. Y\fque los POKéMON\nde tipo normal\fno afectan a los\nfantasmas.",
  ["VioletCitySignText"] = "CIUDAD MALVA La ciudad\fde los aromas\nnostálgicos",
  ["VioletCitySuperNerdText"] = "¿Entrenas POKéMON?\n¡Si ganas a este\fLÍDER de GIMNASIO,\nestarás en\fel camino del\néxito!",
  ["VioletCityYoungsterText"] = "¡He visto un árbol\nque se mueve! ¡Si\flo tocas, se retuerce\ny baila! ¡Es\vgenial!",
  ["VioletGymGuideText"] = "¡Ey! no lo soy\nentrenador, pero te doy un consejo!\f¡Créeme!\nSi crees, el sueño de ser\nsucede el campeón.\f¿Lo crees?\nAsí que escucha.\fEl tipo de planta es\ndébil contra el tipo volador. No\nolvídalo.",
  ["VioletGymGuideWinText"] = "¡Buena batalla!\nSigue así y serás CAMPEÓN\n¡en un abrir y cerrar de ojos!",
  ["VioletGymSignText"] = "LÍDER DEL GIMNASIO POKéMON\nDE CIUDAD MALVA: PEGASO\vEl elegante maestro\fde los POKéMON\nvoladores",
  ["VioletKylesHousePokefanMText"] = "Los POKéMON que\nse intercambian\vcrecen rápido. Pero,\fsi no tienes la\nMEDALLA adecuada,\fpodrían desobedecerte.\n",
  ["VioletMartCooltrainerMText"] = "Los POKéMON pueden\nir equipados con objetos\vcomo POCIÓN y ANTÍDOTO.\fPero parece que\nno saben usar los\fobjetos hechos\npor el hombre.",
  ["VioletMartGrannyText"] = "Cuando atrapas un\nPOKéMON, puede estar\vdébil. Pero éste\fcrecerá y se hará\nmás fuerte. Es\vimportante tratar\fa todos los POKéMON\ncon mucho\vcariño.",
  ["VioletNicknameSpeechHouseBirdText"] = "FRESITA: ¡Pidgey!",
  ["VioletNicknameSpeechHouseLassText"] = "¡A mi PIDGEY le\nllamo FRESITA!",
  ["VioletNicknameSpeechHouseTeacherText"] = "Usa los nombres\nde sus comidas\vfavoritas. Quiero\fdecir, como\nmotes para sus\vPOKéMON.",
  ["VioletPokecenter1FGameboyKidText"] = "Un tal BILL creó\nel Sistema de\vAlmacenamiento\vde POKéMON.",
  ["VioletPokecenter1FGentlemanText"] = "Fue hace unos tres\naños. El TEAM ROCKET\fquería hacer daño\na los POKéMON.\vPero prevaleció\fla justicia y\nun niño acabó\vcon ellos.",
  ["VioletPokecenter1FYoungsterText"] = "Los POKéMON son\nlistos y no obedecen\fa quien no respetan.\nSin las MEDALLAS\fnecesarias,\nharán lo que\fellos quieran.\n",
  ["VioletPokecenterElmsAideAskEggText"] = "{PLAYER}, ¿tomas\nel HUEVO?",
  ["VioletPokecenterElmsAideFavorText"] = "{PLAYER}, cuánto\ntiempo. El PROF.\fELM me pidió que\nte buscara. Tiene\fque pedirte otro\nfavor. ¿Puedes\fllevar el HUEVO\nPOKéMON?",
  ["VioletPokecenterElmsAideGiveEggText"] = "Descubrimos que el POKéMON\nno saldrá hasta que\fno haya crecido dentro\ndel HUEVO. Además,\ftiene que ir acompañado\nde POKéMON activos.\v{PLAYER}, eres la\fúnica persona en\nla que podemos confiar.\v¡Por favor, llama\fal PROF. ELM cuando\neclosione\vel HUEVO!",
  ["VioletPokecenterElmsAideRefuseText"] = "Pero… El PROF. ELM\npreguntó por ti.",
  ["ViridianCityCoffeeGrampsBelievedText"] = "Muy bien. Sí, yo\nera algo fuera de\flo normal. ¡Déjame\ncontártelo!",
  ["ViridianCityCoffeeGrampsDoubtedText"] = "¿Qué? ¡Serás insolente!\nSi fuera un poco\fmás joven, te\nenseñaría un\fpar de cosas.\n¡Vaya!",
  ["ViridianCityCoffeeGrampsQuestionText"] = "¡Hola! ¡Me acabo\nde tomar un café\fdoble y estoy como\nuna moto! ¡Tengo\fque hablar con alguien,\nasí que te toca\va ti! Puede que\fahora no lo parezca,\npero yo era un\fexperto atrapando\nPOKéMON. ¿Me\fcrees?",
  ["ViridianCityDreamEaterFisherGotDreamEaterText"] = "MT42 contiene\nCOME SUEÑOS…\f¡Zzzzz…!",
  ["ViridianCityDreamEaterFisherText"] = "¡Qué sueño! Me\fhabré quedado dormido\nal sol. He soñado\fque un DROWZEE\nse comía mi sueño.\fEs raro, ¿verdad?\n¿Eh? ¿Qué es\festo? ¿De dónde\nha salido esta\fMT? ¡Esto\nes muy misterioso!\fAquí tienes\nesta\vMT.",
  ["ViridianCityGrampsNearGymBlueReturnedText"] = "¿Vas a enfrentarte\nal LÍDER? ¡Buena\fsuerte! ¡La vas\na necesitar!",
  ["ViridianCityGrampsNearGymText"] = "Este GIMNASIO no\nha tenido LÍDER hasta\vhace poco. Un joven\fde PUEBLO PALETA\nse convirtió en\fLÍDER pero viaja\nmucho.",
  ["ViridianCitySignText"] = "CIUDAD VERDE Paraíso para siempre\nverde",
  ["ViridianCityWelcomeSignText"] = "Ésta es la\nCIUDAD VERDE,\vla entrada\fa la MESETA\nAÑIL",
  ["ViridianCityYoungsterText"] = "Dicen que en el\nsuelo del BOSQUE\fVERDE hay muchos\nobjetos.",
  ["ViridianGymGuideText"] = "Hola futuro\n¡CAMPEÓN!\f¿Cómo te va?\nParece que estás empacado.\fEL LÍDER aquí es\nun tipo que peleo con el CAMPEON lo hace\ntres años.\fNo es suave.\fda todo lo que tu\n¡tienes!",
  ["ViridianGymGuideWinText"] = "Hombre, eres fuerte\nde verdad... fue una batalla\ny tanto, aquellos que inspiran. yo lloré\nde emoción.",
  ["ViridianGymSignText"] = "LÍDER DEL GIMNASIO\nPOKéMON DE CIUDAD\vVERDE:… El resto\fdel texto es\nilegible…",
  ["ViridianMartCooltrainerMText"] = "¿Has estado en\nISLA CANELA?\fEstá yendo hacia\nel sur.",
  ["ViridianMartLassText"] = "El LÍDER de este\nGIMNASIO es\vgenial.",
  ["ViridianNicknameSpeechHouseLassText"] = "Son SPEARY, un SPEAROW,\ny RATTEY, un\vRATTATA.",
  ["ViridianNicknameSpeechHousePokefanMText"] = "¿Dedicas mucho\ntiempo a pensar\fen nombres para\ntus POKéMON? Es\fmás divertido intercambiarlos\nsi les pones\fbuenos\nmotes.",
  ["ViridianPokecenter1FBugCatcherText"] = "Mi sueño es ser LÍDER\nde GIMNASIO.",
  ["ViridianPokecenter1FCooltrainerFText"] = "Dicen que el GIMNASIO\nde ISLA CANELA está\vdestruido. Me pregunto\fqué habrá sido\nde BLAINE,\vsu LÍDER.",
  ["ViridianPokecenter1FCooltrainerMText"] = "¿Dónde estará el\nLÍDER del GIMNASIO\vde CIUDAD VERDE?\fQuería desafiarle.\n",
  ["ViridianPokecenter1FCooltrainerMText_BlueReturned"] = "No hay ningún ENTRENADOR\nen el GIMNASIO de\vCIUDAD VERDE. El\fLÍDER dice que\nsu política es\fganar sin tener\nsubordinados.",
  ["VolunteerPokemonHouseSignText"] = "CASA POKéMON DE VOLUNTARIOS\nDE PUEBLO LAVANDA",
  ["WardenPhotoText"] = "Es una foto de\nun anciano sonriente\frodeado de\nPOKéMON.",
  ["WardensGranddaughterText1"] = "Mi abuelo es el\nGUARDA de la ZONA\vSAFARI. Al menos\flo era… Decidió\firse de vacaciones\ny se fue al extranjero\fél solo. Así\nfue como dejó\fde ocuparse\nde la ZONA\vSAFARI.",
  ["WardensGranddaughterText2"] = "Mucha gente se enfadó\ncuando cerraron\fla ZONA SAFARI,\npero el abuelo\ves terco.",
  ["WardensHomeSignText"] = "CASA DEL GUARDA DE\nLA ZONA SAFARI",
  ["WesleyGaveGiftText"] = "MIGUEL: CINTURÓN NEGRO\npotencia los ataques\vde lucha.",
  ["WesleyGivesGiftText"] = "Encantado de conocerte.\nToma un recuerdo.\v",
  ["WesleyNotWednesdayText"] = "MIGUEL: Hoy no\nes miércoles.\v¡Qué pena!",
  ["WesleyWednesdayText"] = "MIGUEL: Si me has\nencontrado, habrás\fvisto a mis hermanos.\n¿O es que\fhas tenido\nsuerte?",
  ["WhitneyAttractText"] = "¡Es ATRACCIÓN!\nUtiliza todo el\fencanto de un\nPOKéMON. ¿No\fes perfecto para\nuna monada\vcomo yo?",
  ["WhitneyBeforeText"] = "¡Hola! Soy BLANCA.\f¡Todos jugaban a\nPOKéMON, así que\vyo también! ¡Los\fPOKéMON son muy\nmonos! ¿Quieres\fluchar? ¡Te lo\nadvierto! ¡Soy\vmuy buena!",
  ["WhitneyGoodCryText"] = "¡Ah, menuda llorera!\n¡Vuelve cuando\fquieras!\n¡Adiós!",
  ["WhitneyPlainBadgeText"] = "Con MED. PLANICIE\nlos POKéMON podrán\fusar FUERZA fuera\ndel combate. Además,\faumentará la\nVELOCIDAD de\vtus POKéMON.\f¡Ah, toma esto\ntambién!",
  ["WhitneyShouldntBeSoSeriousText"] = "¡Ayy…! ¡Uaaaaaaa!\f¡Qué mal! ¡No\ndeberías ser\fasí! ¡Sí, tú!\n¡Te lo digo\va ti!",
  ["WhitneyWhatDoYouWantText"] = "¡Sniff…! ¿Qué quieres?\f¿Una MEDALLA?\n¡Ah, sí! Se me\folvidaba. Toma\nla MEDALLA\vPLANICIE.",
  ["WhitneyYouMeanieText"] = "¡Uaaaaa! ¡Uaaaaa!\f¡Buaa, buaa…!\f¡Eres cruel!\n",
  ["WillScript_WillBeatenText"] = "No… Esto es…\nincreíble…",
  ["WillScript_WillBeforeText"] = "Bienvenidos a la\nLIGA POKéMON. Permíteme\fque me presente.\nMe llamo MENTO.\vMe he entrenado\fpor todo el mundo\npara mejorar a\fmis POKéMON psíquicos.\nY, por fin, me\fhan aceptado\nen el ALTO MANDO.\v¡Sólo puedo\fseguir mejorando!\n¡Es imposible\fque pierda!\n",
  ["WillScript_WillDefeatText"] = "Aunque haya perdi-\ndo, no cambiaré\vmis planes. ¡Seguiré\fluchando hasta\nser el mejor de\ftodos los entrenadores!\nY ahora {PLAYER},\fexperimenta\ntoda la fuerza\fdel ALTO\nMANDO.",
  ["WindowText"] = "¡Mi reflejo!\n¡Qué guay!",
  ["WiseTriosRoomSage1Text"] = "Asombroso… SUICUNE,\fENTEI y RAIKOU\nhan salido de\vsu letargo…\f¿Se hará realidad\nla leyenda?\v",
  ["WiseTriosRoomSage2Text"] = "Nos entrenamos en\nTORRE QUEMADA, pero\fnunca oímos hablar\nde que hubiera\fningún agujero.\nAlguien lo debió\fde hacer a\npropósito.",
  ["WiseTriosRoomSage3BlocksExitText"] = "Sólo pueden entrar\nen la TORRE HOJALATA\faquellos que lleven\nla MEDALLA del GIMNASIO\fIRIS. ¡Aunque, ahora\nque SUICUNE, RAIKOU\fy ENTEI han des-\npertado, te pido\fque te abstengas\nde entrar!",
  ["WiseTriosRoomSage3Text"] = "Nosotros, el TRÍO\nDE SABIOS, somos\flos protectores\ndel POKéMON\vlegendario.",
  ["YoungsterAlbertAfterText"] = "intentaré ser él\nmejor con mis favoritos. No uso los mismos\nPOKéMON que todos.",
  ["YoungsterAlbertSeenText"] = "No te había\nvisto antes.\f¿Te crees muy\nfuerte?",
  ["YoungsterGordonAfterText"] = "En la hierba hay\ncosas pegajosas.",
  ["YoungsterGordonBeatenText"] = "¡Maldición! Creía\nque podía ganar.",
  ["YoungsterGordonSeenText"] = "¡He encontrado\nPOKéMON muy buenos\ven la hierba!\f¡Creo que me\nservirán!",
  ["YoungsterIanAfterText"] = "Estoy esforzándome\npara ser el mejor\vde mi clase.",
  ["YoungsterIanBeatenText"] = "¡No! Hay mejores\nentrenadores…\v",
  ["YoungsterIanSeenText"] = "Soy el mejor de mi\nclase en POKéMON.",
  ["YoungsterJasonAfterBattleText"] = "Voy a capturar\nmás POKéMON en\vla hierba.",
  ["YoungsterJasonBeatenText"] = "¡Ayyyy! ¡Me\nhan pisado!",
  ["YoungsterJasonSeenText"] = "Cuando llevo pantalones\ncortos por la hierba,\fme pican las\npiernas.",
  ["YoungsterJimmyAfterBattleText"] = "Siempre llevo pantalones\ncortos. Ésa\fes mi forma\nde vestir.",
  ["YoungsterJimmySeenText"] = "¡Puedo correr como\nel viento!",
  ["YoungsterJoey1AfterText"] = "¿Debo tener más POKéMON\npara poder luchar mejor?\v¡No! ¡Continuaré\fsólo con éste, pase\nlo que pase!",
  ["YoungsterJoey1BeatenText"] = "¡Argh! ¡He perdido\nde nuevo!",
  ["YoungsterJoey1SeenText"] = "Perdí, así que\nestoy buscando\vmás POKéMON. ¡Espera!\f¡Pareces débil!\n¡Venga, luchemos!\v",
  ["YoungsterMikeyAfterText"] = "Es muy duro llegar\na ser un buen entrenador.\vTengo que luchar\fcontra más\ngente para\vmejorar.",
  ["YoungsterMikeyBeatenText"] = "¡Qué extraño! ¡Creí\nque ganaría!",
  ["YoungsterMikeySeenText"] = "Entrenas POKéMON,\n¿verdad? ¡Pues\fentonces luchemos!\n",
  ["YoungsterOwenAfterBattleText"] = "He luchado\ncon honor.\fNo me avergüenzo.\n",
  ["YoungsterOwenBeatenText"] = "¿Qué? ¿Cómo ha podido\nocurrir?",
  ["YoungsterSamuelAfterText"] = "Voy a entrenarme\nmucho más. Después\fde todo, intento\nser un LÍDER\vde GIMNASIO.",
  ["YoungsterSamuelBeatenText"] = "¡Me han\nderrotado!\v",
  ["YoungsterWarrenAfterBattleText"] = "Parecías fuerte.\fMe daba miedo\ndesafiarte…",
  ["YoungsterWarrenSeenText"] = "¡Mmm…! No sé\nqué hacer…",
  ["YourFriendIsNotReadyText"] = "Tu amigo/a no está\npreparado/a.",
  ["_HaveNoRoomText"] = "no tienes\nespacio para esto.",
  ["_HeyItsFruitText"] = "¡Eh! ¡Es\n{RAM:wStringBuffer3}!",
  ["_LookTownMapText"] = "Es el MAPA del PUEBLO.",
  ["_MartNoMoneyText"] = "No tienes\ndinero.",
  ["_NotEnoughMoneyText"] = "No tienes\ndinero.",
  ["_ObtainedFruitText"] = "¡Has conseguido\n{RAM:wStringBuffer3}!",
  ["_PhoneThankYouText"] = "¡Gracias!",
}
